{% doc %}
  @prompt
    Create menu items for my products I want them listed in black curved rectangles with white text listed as follows. Clothing, Sunglasses, Beanies, Trinkets, Extras
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-menu-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-product-menu__container-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.gap }}px;
    justify-content: {{ block.settings.alignment }};
    padding: {{ block.settings.padding }}px 0;
  }

  .ai-product-menu__item-{{ ai_gen_id }} {
    background-color: {{ block.settings.item_bg_color }};
    color: {{ block.settings.item_text_color }};
    padding: {{ block.settings.item_padding_vertical }}px {{ block.settings.item_padding_horizontal }}px;
    border-radius: {{ block.settings.border_radius }}px;
    text-decoration: none;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    transition: all 0.3s ease;
    display: inline-block;
    text-align: center;
    min-width: {{ block.settings.min_width }}px;
  }

  .ai-product-menu__item-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.item_hover_bg_color }};
    color: {{ block.settings.item_hover_text_color }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 749px) {
    .ai-product-menu__container-{{ ai_gen_id }} {
      justify-content: {{ block.settings.mobile_alignment }};
    }

    .ai-product-menu__item-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
      padding: {{ block.settings.item_padding_vertical | times: 0.9 }}px {{ block.settings.item_padding_horizontal | times: 0.9 }}px;
    }
  }
{% endstyle %}

<product-menu-{{ ai_gen_id }} class="ai-product-menu-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <nav class="ai-product-menu__container-{{ ai_gen_id }}">
    {% if block.settings.item_1_text != blank %}
      <a href="{{ block.settings.item_1_link }}" class="ai-product-menu__item-{{ ai_gen_id }}">
        {{ block.settings.item_1_text }}
      </a>
    {% endif %}

    {% if block.settings.item_2_text != blank %}
      <a href="{{ block.settings.item_2_link }}" class="ai-product-menu__item-{{ ai_gen_id }}">
        {{ block.settings.item_2_text }}
      </a>
    {% endif %}

    {% if block.settings.item_3_text != blank %}
      <a href="{{ block.settings.item_3_link }}" class="ai-product-menu__item-{{ ai_gen_id }}">
        {{ block.settings.item_3_text }}
      </a>
    {% endif %}

    {% if block.settings.item_4_text != blank %}
      <a href="{{ block.settings.item_4_link }}" class="ai-product-menu__item-{{ ai_gen_id }}">
        {{ block.settings.item_4_text }}
      </a>
    {% endif %}

    {% if block.settings.item_5_text != blank %}
      <a href="{{ block.settings.item_5_link }}" class="ai-product-menu__item-{{ ai_gen_id }}">
        {{ block.settings.item_5_text }}
      </a>
    {% endif %}
  </nav>
</product-menu-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductMenu{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const links = this.querySelectorAll('.ai-product-menu__item-{{ ai_gen_id }}');
        links.forEach(link => {
          if (!link.getAttribute('aria-label')) {
            link.setAttribute('aria-label', link.textContent.trim());
          }
        });
      }
    }

    customElements.define('product-menu-{{ ai_gen_id }}', ProductMenu{{ ai_gen_id }});
  })();
</script>


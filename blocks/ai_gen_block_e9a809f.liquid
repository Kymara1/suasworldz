{% doc %}
  @prompt
    Create menu items for my bodycare products I want them listed in black curved rectangles with white text listed as follows. Women and a cute sub menu listing Perfume, Body scrub, Body Creme, Body Oil, Body Wash, Cleansing Bars and then mens listed as - Cologne, Exfoliating Body Wash, Body Oil, Body Creme, Cleansing bars, Just create these as menu items - Perfume, Cologne, Body Scrubs, Body Wash, Body Creme, Cleansing Bar, Body Oil
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bodycare-menu-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 20px;
  }

  .ai-bodycare-menu__container-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.item_spacing }}px;
    justify-content: {{ block.settings.alignment }};
    max-width: 100%;
  }

  .ai-bodycare-menu__item-{{ ai_gen_id }} {
    background-color: {{ block.settings.item_bg_color }};
    color: {{ block.settings.item_text_color }};
    padding: {{ block.settings.item_padding_vertical }}px {{ block.settings.item_padding_horizontal }}px;
    border-radius: {{ block.settings.border_radius }}px;
    text-decoration: none;
    font-size: {{ block.settings.font_size }}px;
    font-weight: 500;
    transition: all 0.3s ease;
    display: inline-block;
    text-align: center;
    min-width: {{ block.settings.min_width }}px;
  }

  .ai-bodycare-menu__item-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.item_hover_bg_color }};
    color: {{ block.settings.item_hover_text_color }};
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
  }

  @media screen and (max-width: 749px) {
    .ai-bodycare-menu__container-{{ ai_gen_id }} {
      justify-content: center;
    }

    .ai-bodycare-menu__item-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
      min-width: auto;
      flex: 1 1 auto;
    }
  }
{% endstyle %}

<bodycare-menu-{{ ai_gen_id }}
  class="ai-bodycare-menu-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <nav class="ai-bodycare-menu__container-{{ ai_gen_id }}">
    {% if block.settings.show_perfume %}
      <a
        href="{{ block.settings.perfume_link }}"
        class="ai-bodycare-menu__item-{{ ai_gen_id }}"
      >
        {{ block.settings.perfume_text }}
      </a>
    {% endif %}

    {% if block.settings.show_cologne %}
      <a
        href="{{ block.settings.cologne_link }}"
        class="ai-bodycare-menu__item-{{ ai_gen_id }}"
      >
        {{ block.settings.cologne_text }}
      </a>
    {% endif %}

    {% if block.settings.show_body_scrubs %}
      <a
        href="{{ block.settings.body_scrubs_link }}"
        class="ai-bodycare-menu__item-{{ ai_gen_id }}"
      >
        {{ block.settings.body_scrubs_text }}
      </a>
    {% endif %}

    {% if block.settings.show_body_wash %}
      <a
        href="{{ block.settings.body_wash_link }}"
        class="ai-bodycare-menu__item-{{ ai_gen_id }}"
      >
        {{ block.settings.body_wash_text }}
      </a>
    {% endif %}

    {% if block.settings.show_body_creme %}
      <a
        href="{{ block.settings.body_creme_link }}"
        class="ai-bodycare-menu__item-{{ ai_gen_id }}"
      >
        {{ block.settings.body_creme_text }}
      </a>
    {% endif %}

    {% if block.settings.show_cleansing_bar %}
      <a
        href="{{ block.settings.cleansing_bar_link }}"
        class="ai-bodycare-menu__item-{{ ai_gen_id }}"
      >
        {{ block.settings.cleansing_bar_text }}
      </a>
    {% endif %}

    {% if block.settings.show_body_oil %}
      <a
        href="{{ block.settings.body_oil_link }}"
        class="ai-bodycare-menu__item-{{ ai_gen_id }}"
      >
        {{ block.settings.body_oil_text }}
      </a>
    {% endif %}
  </nav>
</bodycare-menu-{{ ai_gen_id }}>

<script>
  (function() {
    class BodycareMenu{{ai_gen_id}} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const links = this.querySelectorAll('.ai-bodycare-menu__item-{{ ai_gen_id }}');
        links.forEach(link => {
          link.setAttribute('role', 'menuitem');
        });
      }
    }

    customElements.define('bodycare-menu-{{ ai_gen_id }}', BodycareMenu{{ai_gen_id}});
  })();
</script>


{% doc %}
  @prompt
    Create menu items for my bodycare products I want them listed in black curved rectangles with white text listed as follows. Women and a cute sub menu listing Perfume, Body scrub, Body Creme, Body Oil, Body Wash, Cleansing Bars and then mens listed as - Cologne, Exfoliating Body Wash, Body Oil, Body Creme, Cleansing bars, Just create these as menu items - Perfume, Cologne, Body Scrubs, Body Wash, Body Creme, Cleansing Bar
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-menu-items-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 20px;
  }

  .ai-menu-items__container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    flex-wrap: wrap;
    justify-content: {{ block.settings.alignment }};
  }

  .ai-menu-items__item-{{ ai_gen_id }} {
    background-color: {{ block.settings.item_bg_color }};
    color: {{ block.settings.item_text_color }};
    padding: {{ block.settings.item_padding_vertical }}px {{ block.settings.item_padding_horizontal }}px;
    border-radius: {{ block.settings.border_radius }}px;
    text-decoration: none;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    transition: background-color 0.3s ease;
    display: inline-block;
    text-align: center;
    min-width: {{ block.settings.item_min_width }}px;
  }

  .ai-menu-items__item-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.item_hover_bg_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-menu-items__container-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: stretch;
    }

    .ai-menu-items__item-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-menu-items-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <nav class="ai-menu-items__container-{{ ai_gen_id }}" aria-label="Product categories">
    <a href="{{ block.settings.perfume_link }}" class="ai-menu-items__item-{{ ai_gen_id }}">
      Perfume
    </a>
    <a href="{{ block.settings.cologne_link }}" class="ai-menu-items__item-{{ ai_gen_id }}">
      Cologne
    </a>
    <a href="{{ block.settings.body_scrubs_link }}" class="ai-menu-items__item-{{ ai_gen_id }}">
      Body Scrubs
    </a>
    <a href="{{ block.settings.body_wash_link }}" class="ai-menu-items__item-{{ ai_gen_id }}">
      Body Wash
    </a>
    <a href="{{ block.settings.body_creme_link }}" class="ai-menu-items__item-{{ ai_gen_id }}">
      Body Creme
    </a>
    <a href="{{ block.settings.cleansing_bar_link }}" class="ai-menu-items__item-{{ ai_gen_id }}">
      Cleansing Bar
    </a>
  </nav>
</div>

{% schema %}
{
  "name": "Product menu items",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Menu links"
    },
    {
      "type": "url",
      "id": "perfume_link",
      "label": "Perfume link"
    },
    {
      "type": "url",
      "id": "cologne_link",
      "label": "Cologne link"
    },
    {
      "type": "url",
      "id": "body_scrubs_link",
      "label": "Body scrubs link"
    },
    {
      "type": "url",
      "id": "body_wash_link",
      "label": "Body wash link"
    },
    {
      "type": "url",
      "id": "body_creme_link",
      "label": "Body creme link"
    },
    {
      "type": "url",
      "id": "cleansing_bar_link",
      "label": "Cleansing bar link"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "item_bg_color",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "item_hover_bg_color",
      "label": "Hover background",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "item_text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "item_padding_vertical",
      "label": "Vertical padding",
      "min": 8,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "item_padding_horizontal",
      "label": "Horizontal padding",
      "min": 15,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "item_min_width",
      "label": "Minimum width",
      "min": 100,
      "max": 250,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between items",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Product menu items"
    }
  ]
}
{% endschema %}

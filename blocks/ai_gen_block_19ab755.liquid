{% doc %}
  @prompt
    Create menu items for my home care products I want them listed in black curved rectangles with white text listed as follows. Candles, Everything Mist 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-menu-items-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-menu-items__container-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.gap }}px;
    justify-content: {{ block.settings.alignment }};
    width: 100%;
  }

  .ai-menu-items__item-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    border-radius: {{ block.settings.border_radius }}px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-menu-items__item-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.hover_background_color }};
    color: {{ block.settings.hover_text_color }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 749px) {
    .ai-menu-items__container-{{ ai_gen_id }} {
      justify-content: center;
    }

    .ai-menu-items__item-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
      padding: {{ block.settings.padding_vertical | times: 0.9 }}px {{ block.settings.padding_horizontal | times: 0.9 }}px;
    }
  }
{% endstyle %}

<menu-items-{{ ai_gen_id }} class="ai-menu-items-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-menu-items__container-{{ ai_gen_id }}">
    {% if block.settings.item_1_enabled and block.settings.item_1_text != blank %}
      <a href="{{ block.settings.item_1_link }}" class="ai-menu-items__item-{{ ai_gen_id }}">
        {{ block.settings.item_1_text }}
      </a>
    {% endif %}

    {% if block.settings.item_2_enabled and block.settings.item_2_text != blank %}
      <a href="{{ block.settings.item_2_link }}" class="ai-menu-items__item-{{ ai_gen_id }}">
        {{ block.settings.item_2_text }}
      </a>
    {% endif %}

    {% if block.settings.item_3_enabled %}
      <a href="{{ block.settings.item_3_link }}" class="ai-menu-items__item-{{ ai_gen_id }}">
        {{ block.settings.item_3_text }}
      </a>
    {% endif %}

    {% if block.settings.item_4_enabled %}
      <a href="{{ block.settings.item_4_link }}" class="ai-menu-items__item-{{ ai_gen_id }}">
        {{ block.settings.item_4_text }}
      </a>
    {% endif %}

    {% if block.settings.item_5_enabled %}
      <a href="{{ block.settings.item_5_link }}" class="ai-menu-items__item-{{ ai_gen_id }}">
        {{ block.settings.item_5_text }}
      </a>
    {% endif %}
  </div>
</menu-items-{{ ai_gen_id }}>

<script>
  (function() {
    class MenuItems{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.items = this.querySelectorAll('.ai-menu-items__item-{{ ai_gen_id }}');
      }
    }

    customElements.define('menu-items-{{ ai_gen_id }}', MenuItems{{ ai_gen_id }});
  })();
</script>


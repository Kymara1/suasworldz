{% doc %}
  @prompt
    I want to create a menu under my logo
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-navigation-menu-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.vertical_padding }}px 0;
    border-top: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-navigation-menu__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-navigation-menu__list-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.alignment }};
    align-items: center;
    gap: {{ block.settings.item_spacing }}px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .ai-navigation-menu__item-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-navigation-menu__link-{{ ai_gen_id }} {
    display: block;
    color: {{ block.settings.text_color }};
    text-decoration: none;
    font-family: {{ settings.typography--accent.family }}, {{ settings.typography--accent.fallback_families }};
    font-weight: {{ settings.typography--accent.weight }};
    font-size: {{ block.settings.font_size }}px;
    padding: {{ block.settings.link_padding }}px;
    transition: color 0.3s ease;
    {% if block.settings.text_transform == 'uppercase' %}
      text-transform: uppercase;
    {% elsif block.settings.text_transform == 'capitalize' %}
      text-transform: capitalize;
    {% endif %}
  }

  .ai-navigation-menu__link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.hover_color }};
  }

  .ai-navigation-menu__link-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.hover_color }};
    outline-offset: 2px;
  }

  {% if block.settings.show_underline %}
    .ai-navigation-menu__link-{{ ai_gen_id }}::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      width: 0;
      height: 2px;
      background-color: {{ block.settings.hover_color }};
      transition: all 0.3s ease;
      transform: translateX(-50%);
    }

    .ai-navigation-menu__link-{{ ai_gen_id }}:hover::after {
      width: 100%;
    }
  {% endif %}

  @media screen and (max-width: 768px) {
    .ai-navigation-menu__list-{{ ai_gen_id }} {
      justify-content: center;
      gap: {{ block.settings.item_spacing | times: 0.7 }}px;
    }

    .ai-navigation-menu__link-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
      padding: {{ block.settings.link_padding | times: 0.8 }}px;
    }
  }

 @media screen and (max-width: 480px) {
  .ai-navigation-menu__list-{{ ai_gen_id }} {
    flex-direction: row;        /* horizontal */
    flex-wrap: nowrap;          /* keep on one line */
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.item_spacing | times: 0.5 }}px;
  }
  .ai-navigation-menu__list-{{ ai_gen_id }} li { 
    display: inline-flex; 
    white-space: nowrap;        /* prevent line break inside links */
  }
  .ai-navigation-menu__container-{{ ai_gen_id }} { padding: 0 15px; }
}


    .ai-navigation-menu__container-{{ ai_gen_id }} {
      padding: 0 15px;
    }
  }
{% endstyle %}

<nav class="ai-navigation-menu-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-navigation-menu__container-{{ ai_gen_id }}">
    <ul class="ai-navigation-menu__list-{{ ai_gen_id }}">
      {% for i in (1..8) %}
        {% liquid
          assign link_key = 'menu_link_' | append: i
          assign label_key = 'menu_label_' | append: i
          assign link_url = block.settings[link_key]
          assign link_label = block.settings[label_key]
        %}
        
        {% if link_label != blank %}
          <li class="ai-navigation-menu__item-{{ ai_gen_id }}">
            <a 
              href="{{ link_url | default: '#' }}" 
              class="ai-navigation-menu__link-{{ ai_gen_id }}"
            >
              {{ link_label }}
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</nav>


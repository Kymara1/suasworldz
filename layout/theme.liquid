<!doctype html>
<html class="no-js flexbox-gap" lang="{{ request.locale.iso_code }}" dir="ltr">
  <head>
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <meta name="theme-color" content="#ffffff">
    {% render 'pagefly-head' %}
    <!-- Maker Theme - Version 7.3.0 by Troop Themes - https://troopthemes.com/ -->

    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <link rel="preconnect" href="https://cdn.shopify.com">
    <link rel="preconnect" href="https://fonts.shopifycdn.com">
    <link rel="preconnect" href="https://monorail-edge.shopifysvc.com">

    <link rel="preload" href="{{ 'theme--critical.css' | asset_url }}" as="style">
    <link rel="preload" href="{{ 'theme--async.css' | asset_url }}" as="style">
    <link rel="preload" href="{{ 'lazysizes.min.js' | asset_url }}" as="script">
    <link rel="preload" href="{{ 'theme.js' | asset_url }}" as="script">

    {%- if canonical_url != blank -%}
      <link rel="canonical" href="{{ canonical_url }}">
    {%- endif -%}

    {% if settings.favicon != null %}
      <link rel="shortcut icon" href="{{ settings.favicon | img_url: '32x' }}" type="image/png">
      <link rel="apple-touch-icon" href="{{ settings.favicon | img_url: '180x' }}">
    {% endif %}

    {% if request.page_type == 'index' %}
      <title>{{ page_title }}</title>
    {% else %}
      <title>{{ page_title }} | {{ shop.name }}</title>
    {% endif %}

    {%- liquid
      render 'social-meta-tags'
      render 'css-typography'
      render 'css-colors'
      render 'js-variables'
    -%}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');

      if (window.location.pathname === '/collections/home-care' || window.location.pathname === '/pages/home-care-products') {
        window.location.replace('/pages/home-products');
      }

      function onLoadStylesheet() {
        const link = document.querySelector(`link[href="${theme.assets.stylesheet}"]`);
        link.loaded = true;
        link.dispatchEvent(new Event('load'));
      }

      function libraryLoader(name, url, callback) {
        if (theme.libraries[name] === undefined) {
          theme.libraries[name] = 'requested';
          const script = document.createElement('script');
          script.src = url;
          script.onload = () => {
            theme.libraries[name] = 'loaded';
            if (callback) callback();
          };
          document.body.appendChild(script);
        } else if (callback && theme.libraries[name] === 'loaded') {
          callback();
        }
      }
    </script>

    <noscript>
      <link href="{{ 'theme--async.css' | asset_url }}" rel="stylesheet">
    </noscript>

    <link href="{{ 'theme--critical.css' | asset_url }}" rel="stylesheet" media="all">
    <link href="{{ 'theme--async.css' | asset_url }}" rel="stylesheet" media="print" onload="this.media='all';onLoadStylesheet()">

    {% render 'custom-styles' %}
    <style id="suas-product-inline-fixes">
      html body.template--product .radios--input,
      html body.template--product input.radios--input,
      html body.template--product .radios--main input[type="radio"] {
        position: absolute !important;
        width: 1px !important;
        height: 1px !important;
        opacity: 0 !important;
        appearance: none !important;
        -webkit-appearance: none !important;
        border: 0 !important;
        box-shadow: none !important;
        outline: 0 !important;
        clip: rect(0 0 0 0) !important;
        clip-path: inset(50%) !important;
        overflow: hidden !important;
        pointer-events: none !important;
      }
      html body.template--product .radios--main,
      html body.template--product .radios--value-button,
      html body.template--product .radios--value-button div {
        outline: 0 !important;
      }
      html body.template--product .radios--value-button,
      html body.template--product .radios--value-button div {
        border-radius: 999px !important;
      }
    </style>

    <script src="{{ 'lazysizes.min.js' | asset_url }}" async="async"></script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {% if settings['product--quick-add-enabled'] %}
      <script src="{{ 'product-price.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'product-options.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'product-buy-buttons.js' | asset_url }}" defer="defer"></script>
    {% endif %}

    {% if request.page_type contains 'customers' %}
      <script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer="defer"></script>
      <script src="{{ 'customer_area.js' | shopify_asset_url }}" defer="defer"></script>
    {% endif %}

    {% include 'buddha-megamenu' %}
    {{ content_for_header }}

    {% render 'qikify-apps' %}

    {% if content_for_header contains 'rio.pwztag.com' -%}
      {%- render 'productwiz-rio', product: product, shop: shop, installGuard: true -%}
    {%- endif %}

    {% render 'edt_p' %}
    {% render 'shogun-head' %}
    {% render 'custom-styles' %}
    {% render 'suas-control-panel-mobile-fix' %}
    {{ 'custom.css' | asset_url | stylesheet_tag }}
    {{ 'suas-desktop-fit.css' | asset_url | stylesheet_tag }}
    {{ 'suas-product-final.css' | asset_url | stylesheet_tag }}
    {{ 'suas-product-live-fix.css' | asset_url | stylesheet_tag }}
    {% render 'suas-booking-polish' %}
  </head>

  <body
    class="template--{{ template | split: '.' | first | remove: '_' | replace: '/', '--' }} page--{{ page_title | handle }}{% if customer %} customer-logged-in{% endif %}"
    data-theme-id="765"
    data-theme-name="Maker"
    data-theme-version="7.3.0"
    data-tabbing="false"
  >
    <a data-item="a11y-button" href="#main-content">
      {{ 'general.a11y.skip_main' | t }}
    </a>

    {% unless request.page_type == 'password' %}
      {% section 'suas-lovable-frame' %}
    {% endunless %}
    {% render 'suas-cart-button' %}

    <div class="off-canvas--viewport" data-js-class="OffCanvas" data-off-canvas--state="closed">
      <div class="off-canvas--overlay" data-js-class="Transition"></div>
      <div aria-label="{{ 'general.a11y.close' | t }}" data-js-class="Transition" data-off-canvas--close>
        {% render 'icons', icon: 'cross' %}
      </div>

      <div class="off-canvas--main-content">
        {% section 'announcement' %}
        {% section 'header' %}

        <main class="layout--main-content" id="main-content">
          {{ content_for_layout }}
        </main>

        {% section 'footer' %}
      </div>

      <div class="off-canvas--right-sidebar" data-active="cart" data-js-class="Transition">
        <div class="off-canvas--focus-trigger" tabindex="0"></div>

        {%- liquid
          if request.page_type == 'product'
            echo '<div class="off-canvas--container" data-view="pickup"></div>'
          endif

          if request.page_type == 'collection' or request.page_type == 'search'
            echo '<div class="off-canvas--container" data-view="filter"></div>'
          endif

          if settings['product--quick-add-enabled']
            echo '<div class="off-canvas--container" data-view="product-form"></div>'
          endif

          if settings['cart--type'] == 'drawer' or settings['product--quick-add-enabled']
            echo '<div class="off-canvas--container" data-view="cart">'
            render 'cart', view: 'mobile', is_drawer: true
            echo '</div>'
          endif
        -%}

        <div class="off-canvas--focus-trigger" tabindex="0"></div>
      </div>

      <div class="off-canvas--left-sidebar" data-active="menu" data-js-class="Transition">
        <div class="off-canvas--focus-trigger" tabindex="0"></div>
        <div class="off-canvas--container" data-view="menu">
          {% render 'mobile-nav' %}
        </div>
        <div class="off-canvas--focus-trigger" tabindex="0"></div>
      </div>
    </div>

    {%- liquid
      if settings['popup--enabled']
        render 'popup', component: 'main'
      endif

      render 'search', view: 'modal'
      render 'modal'
      render 'feedback-bar'
    -%}

    <script>
      (function () {
        if (!document.body || !document.body.classList.contains('template--product')) return;

        function cleanVariantLabel(text) {
          var source = String(text || '').replace(/\s+/g, ' ').trim();
          var sizeMatch = source.match(/(\d+(?:\.\d+)?)\s*(?:f\s*l\s*)?o\s*z/i);
          if (sizeMatch) {
            return sizeMatch[1].replace(/\.0$/, '') + ' Oz';
          }
          return source.replace(/\bFL\s*OZ\b/ig, 'Oz').replace(/\bFl\s*Oz\b/g, 'Oz').replace(/\bfl\s*oz\b/g, 'Oz');
        }

        function cleanProductOptionCircles() {
          document.querySelectorAll('.radios--value-button').forEach(function (button) {
            var label = cleanVariantLabel(button.getAttribute('aria-label') || button.textContent);
            var target = button.querySelector('div') || button;
            if (label && target.textContent.trim() !== label) {
              target.textContent = label;
            }
            if (label) {
              button.setAttribute('aria-label', label);
              button.setAttribute('title', label);
            }
          });
        }

        function polishProductPage() {
          cleanProductOptionCircles();
        }

        polishProductPage();
        document.addEventListener('DOMContentLoaded', polishProductPage);
        window.addEventListener('load', polishProductPage);
        setTimeout(polishProductPage, 400);
        setTimeout(polishProductPage, 1200);

        var observer = new MutationObserver(function () {
          polishProductPage();
        });
        observer.observe(document.documentElement, { childList: true, subtree: true });
      })();
    </script>

    <style id="suas-mobile-menu-uniform">
      @media only screen and (max-width: 1023px) {
        html body .suas-frame .suas-side-nav,
        html body.template--product .suas-frame .suas-side-nav,
        html body.template--product .suas-side-nav {
          display: grid !important;
          grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
          grid-auto-rows: 44px !important;
          align-items: start !important;
          gap: 6px !important;
          overflow: visible !important;
          padding: 0 0 8px !important;
          position: relative !important;
        }
        html body .suas-frame .suas-side-nav > .suas-side-link,
        html body .suas-frame .suas-side-nav > .suas-side-dropdown,
        html body.template--product .suas-frame .suas-side-nav > .suas-side-link,
        html body.template--product .suas-frame .suas-side-nav > .suas-side-dropdown {
          grid-column: span 1 !important;
          width: 100% !important;
          min-width: 0 !important;
          max-width: none !important;
          height: 44px !important;
          margin: 0 !important;
          align-self: start !important;
          flex: none !important;
        }
        html body .suas-frame .suas-side-link,
        html body .suas-frame .suas-side-dropdown > summary.suas-side-link,
        html body.template--product .suas-frame .suas-side-link,
        html body.template--product .suas-frame .suas-side-dropdown > summary.suas-side-link {
          width: 100% !important;
          min-width: 0 !important;
          max-width: 100% !important;
          height: 44px !important;
          min-height: 44px !important;
          max-height: 44px !important;
          margin: 0 !important;
          display: flex !important;
          flex-direction: column !important;
          align-items: center !important;
          justify-content: center !important;
        }
        html body .suas-frame .suas-side-dropdown,
        html body .suas-frame .suas-side-dropdown[open],
        html body.template--product .suas-frame .suas-side-dropdown,
        html body.template--product .suas-frame .suas-side-dropdown[open] {
          position: static !important;
          min-width: 0 !important;
          width: 100% !important;
          max-width: none !important;
          height: 44px !important;
          overflow: visible !important;
        }
        html body .suas-frame .suas-side-label,
        html body.template--product .suas-frame .suas-side-label {
          display: block !important;
          font-size: .68rem !important;
          line-height: .95 !important;
          white-space: nowrap !important;
          max-width: 100% !important;
        }
      }
    </style>
    {{ '//cdn.shopify.com/s/files/1/0194/1736/6592/t/1/assets/booster-page-speed-optimizer.js?23' | script_tag }}
    {% render 'hextom_fsb_main', product: product, customer: customer %}
    <script src="//code.tidio.co/yi2efwcyp4seqmcpmlw5twampktjzvxl.js" async></script>
    <link rel="stylesheet" href="https://gravity-software.com/js/shopify/rondell/jquery.rondellf85.css?v=123">
  </body>
</html>
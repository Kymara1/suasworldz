<section class="suas-formula-builder" id="build-a-fragrance" aria-label="Build a fragrance">
  <style>
    @font-face { font-family:'Casual Human'; src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype'); font-display:swap; }
    .suas-formula-builder { --ink:#111; --cream:#fffaf5; --blush:#ffe8ef; --pink:#ff9fc2; --lime:#d9ff78; --blue:#c9e7ff; --yellow:#fff3a6; color:var(--ink); background:radial-gradient(circle at 8% 12%,rgba(255,159,194,.34),transparent 24%),radial-gradient(circle at 92% 24%,rgba(217,255,120,.38),transparent 24%),linear-gradient(180deg,#fff 0%,#fffaf5 100%); padding:clamp(54px,7vw,96px) 0; font-family:Futura,'Futura PT',Arial,sans-serif; scroll-margin-top:80px; }
    .suas-formula-builder * { box-sizing:border-box; }
    .suas-formula-wrap { width:min(1220px,calc(100vw - 28px)); margin:0 auto; }
    .suas-formula-head { text-align:center; margin-bottom:36px; }
    .suas-formula-head p { margin:0 0 12px; font-size:11px; letter-spacing:.36em; text-transform:uppercase; color:rgba(17,17,17,.5); }
    .suas-formula-head h2 { margin:0; font-family:'Casual Human',Futura,Arial,sans-serif; font-size:clamp(3.6rem,8vw,8rem); font-weight:400; line-height:.9; text-transform:lowercase; }
    .suas-builder-grid { display:grid; grid-template-columns:minmax(0,1.25fr) minmax(320px,.75fr); gap:24px; align-items:start; }
    .suas-builder-panel { border:2px solid var(--ink); border-radius:28px; background:rgba(255,255,255,.78); box-shadow:0 8px 0 var(--ink); padding:clamp(20px,3vw,30px); }
    .suas-builder-label { display:block; margin:0 0 10px; font-size:11px; letter-spacing:.24em; text-transform:uppercase; color:rgba(17,17,17,.55); }
    .suas-size-row { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; margin-bottom:28px; }
    .suas-size-btn,.suas-note-btn { border:2px solid var(--ink); color:var(--ink); cursor:pointer; text-align:left; transition:transform 140ms ease,box-shadow 140ms ease,background 140ms ease; }
    .suas-size-btn { min-height:118px; border-radius:22px; background:#fff; padding:16px; box-shadow:0 5px 0 var(--ink); }
    .suas-size-btn[aria-pressed='true'] { background:var(--lime); transform:translateY(2px); box-shadow:0 3px 0 var(--ink); }
    .suas-size-btn strong { display:block; font-family:'Casual Human',Futura,Arial,sans-serif; font-size:1.6rem; line-height:.95; text-transform:lowercase; }
    .suas-size-btn span { display:block; margin-top:10px; font-size:12px; line-height:1.35; font-weight:700; color:rgba(17,17,17,.62); }
    .suas-note-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px; }
    .suas-note-btn { min-height:126px; border-radius:22px; padding:14px; background:var(--note-bg,#fff); box-shadow:0 4px 0 var(--ink); display:flex; flex-direction:column; justify-content:end; }
    .suas-note-btn[aria-pressed='true'] { outline:4px solid rgba(255,159,194,.55); transform:translateY(2px); box-shadow:0 2px 0 var(--ink); }
    .suas-note-btn strong { font-family:'Casual Human',Futura,Arial,sans-serif; font-size:1.45rem; font-weight:400; line-height:.96; text-transform:lowercase; }
    .suas-note-btn small { margin-top:9px; font-size:10px; letter-spacing:.16em; text-transform:uppercase; opacity:.62; }
    .suas-preview-card { position:sticky; top:86px; }
    .suas-bottle-preview { display:grid; place-items:center; min-height:320px; margin-bottom:20px; border-radius:24px; background:linear-gradient(180deg,rgba(255,255,255,.88),rgba(255,232,239,.44)),var(--blend-bg,#fff); border:1px solid rgba(17,17,17,.12); }
    .suas-bottle-svg { width:min(220px,70%); height:auto; overflow:visible; }
    .suas-formula-input { width:100%; height:54px; border:2px solid var(--ink); border-radius:999px; background:#fff; padding:0 18px; font-family:'Casual Human',Futura,Arial,sans-serif; font-size:1.5rem; text-align:center; letter-spacing:0; outline:0; }
    .suas-picked { display:flex; flex-wrap:wrap; gap:8px; justify-content:center; min-height:36px; margin:18px 0; }
    .suas-chip { border:1px solid rgba(17,17,17,.2); border-radius:999px; background:#fff; padding:7px 11px; font-size:12px; font-weight:800; text-transform:lowercase; }
    .suas-builder-actions { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
    .suas-builder-action { min-height:50px; border:2px solid var(--ink); border-radius:999px; background:#fff; color:var(--ink); cursor:pointer; font-family:'Casual Human',Futura,Arial,sans-serif; font-size:1.2rem; text-transform:lowercase; box-shadow:0 4px 0 var(--ink); }
    .suas-builder-action[data-fill='ink'] { background:var(--ink); color:#fff; }
    .suas-builder-toast { margin-top:14px; text-align:center; font-size:12px; font-weight:800; color:rgba(17,17,17,.58); }
    @media (max-width:980px){ .suas-builder-grid{grid-template-columns:1fr;} .suas-preview-card{position:static;} }
    @media (max-width:680px){ .suas-size-row{grid-template-columns:1fr;} .suas-note-grid{grid-template-columns:repeat(2,minmax(0,1fr));} .suas-builder-actions{grid-template-columns:1fr;} }
  </style>
  <div class="suas-formula-wrap"><div class="suas-formula-head"><p>formula station / experiment 001</p><h2>build a fragrance.</h2></div><div class="suas-builder-grid" data-suas-builder><div class="suas-builder-panel"><span class="suas-builder-label">choose your lab session</span><div class="suas-size-row"><button class="suas-size-btn" type="button" data-size="15mL Travel EDP" data-price="$30" data-max="2" aria-pressed="true"><strong>15mL travel</strong><span>Eau de parfum. Up to 2 notes. Add a second 15mL for $15.</span></button><button class="suas-size-btn" type="button" data-size="30mL EDP" data-price="$45" data-max="3" aria-pressed="false"><strong>30mL perfume</strong><span>Eau de parfum. Up to 3 notes for the full lab session.</span></button><button class="suas-size-btn" type="button" data-size="Combo Sesh" data-price="$60" data-max="3" aria-pressed="false"><strong>combo sesh</strong><span>15mL perfume plus 1 oz body oil. Build both around one vibe.</span></button></div><span class="suas-builder-label">tap notes to add</span><div class="suas-note-grid">
    <button class="suas-note-btn" type="button" data-note="vanilla" style="--note-bg:#f3dcc4;"><strong>vanilla</strong><small>gourmand</small></button><button class="suas-note-btn" type="button" data-note="amber" style="--note-bg:#e8d0b8;"><strong>amber</strong><small>warm</small></button><button class="suas-note-btn" type="button" data-note="soft musk" style="--note-bg:#e6f5ff;"><strong>soft musk</strong><small>clean</small></button><button class="suas-note-btn" type="button" data-note="honey" style="--note-bg:#fff3a6;"><strong>honey</strong><small>sweet</small></button><button class="suas-note-btn" type="button" data-note="strawberry" style="--note-bg:#ffd5dc;"><strong>strawberry</strong><small>fruity</small></button><button class="suas-note-btn" type="button" data-note="coconut" style="--note-bg:#ffe2b8;"><strong>coconut</strong><small>tropical</small></button><button class="suas-note-btn" type="button" data-note="linen" style="--note-bg:#dceefb;"><strong>linen</strong><small>clean</small></button><button class="suas-note-btn" type="button" data-note="floral" style="--note-bg:#fbd6ea;"><strong>floral</strong><small>floral</small></button><button class="suas-note-btn" type="button" data-note="mango" style="--note-bg:#ffe0ad;"><strong>mango</strong><small>tropical</small></button><button class="suas-note-btn" type="button" data-note="blueberry" style="--note-bg:#d7d4ff;"><strong>blueberry</strong><small>fruity</small></button><button class="suas-note-btn" type="button" data-note="marshmallow" style="--note-bg:#fff0f7;"><strong>marshmallow</strong><small>sweet</small></button><button class="suas-note-btn" type="button" data-note="woods" style="--note-bg:#d9c7b3;"><strong>woods</strong><small>woody</small></button>
    </div></div><aside class="suas-builder-panel suas-preview-card"><span class="suas-builder-label">fragrance preview</span><div class="suas-bottle-preview" data-preview><svg class="suas-bottle-svg" viewBox="0 0 220 320" role="img" aria-label="Bottle preview"><defs><clipPath id="suas-liquid-clip"><rect x="52" y="92" width="116" height="178" rx="18"></rect></clipPath></defs><rect x="86" y="24" width="48" height="28" rx="4" fill="#111"></rect><rect x="92" y="52" width="36" height="18" rx="3" fill="#282828"></rect><rect x="52" y="76" width="116" height="206" rx="18" fill="#fff" stroke="#111" stroke-width="3"></rect><rect data-liquid x="52" y="164" width="116" height="106" rx="18" fill="#ffe8ef" clip-path="url(#suas-liquid-clip)"></rect><rect x="70" y="178" width="80" height="58" rx="6" fill="#fff" stroke="#111"></rect><text data-bottle-name x="110" y="206" text-anchor="middle" style="font-family:'Casual Human',Futura,Arial,sans-serif;font-size:18px;fill:#111;">untitled</text><text data-bottle-type x="110" y="222" text-anchor="middle" style="font-family:Futura,Arial,sans-serif;font-size:7px;letter-spacing:1.5px;text-transform:uppercase;fill:#111;">15mL Travel EDP</text></svg></div><input class="suas-formula-input" data-name-input type="text" maxlength="38" placeholder="blend name"><div class="suas-picked" data-picked><span class="suas-chip">tap notes to start</span></div><p class="suas-builder-toast" data-status>15mL Travel EDP / $30 / up to 2 notes</p><div class="suas-builder-actions"><button class="suas-builder-action" type="button" data-reset>start over</button><button class="suas-builder-action" type="button" data-fill="ink" data-copy>copy fragrance</button></div></aside></div></div>
  <script>(()=>{const root=document.currentScript.closest('.suas-formula-builder');if(!root||root.dataset.ready==='true')return;root.dataset.ready='true';const sizeButtons=[...root.querySelectorAll('[data-size]')],noteButtons=[...root.querySelectorAll('[data-note]')],pickedEl=root.querySelector('[data-picked]'),statusEl=root.querySelector('[data-status]'),nameInput=root.querySelector('[data-name-input]'),bottleName=root.querySelector('[data-bottle-name]'),bottleType=root.querySelector('[data-bottle-type]'),liquid=root.querySelector('[data-liquid]'),preview=root.querySelector('[data-preview]'),reset=root.querySelector('[data-reset]'),copy=root.querySelector('[data-copy]');let max=2,size='15mL Travel EDP',price='$30',notes=[];const colors=['#ffe8ef','#d9ff78','#c9e7ff','#fff3a6','#eee6ff'];function draw(){noteButtons.forEach(b=>b.setAttribute('aria-pressed',notes.includes(b.dataset.note)?'true':'false'));pickedEl.innerHTML=notes.length?notes.map(n=>`<span class="suas-chip">${n}</span>`).join(''):'<span class="suas-chip">tap notes to start</span>';const blendName=nameInput.value.trim()||'untitled';bottleName.textContent=blendName.toLowerCase();bottleType.textContent=size;statusEl.textContent=`${size} / ${price} / ${notes.length}/${max} notes`;liquid.setAttribute('fill',colors[Math.max(notes.length-1,0)]||'#ffe8ef');preview.style.setProperty('--blend-bg',`linear-gradient(180deg,${colors.slice(0,Math.max(notes.length,1)).join(',')})`)}sizeButtons.forEach(button=>button.addEventListener('click',()=>{sizeButtons.forEach(btn=>btn.setAttribute('aria-pressed','false'));button.setAttribute('aria-pressed','true');max=Number(button.dataset.max||2);size=button.dataset.size||size;price=button.dataset.price||price;notes=notes.slice(0,max);draw()}));noteButtons.forEach(button=>button.addEventListener('click',()=>{const note=button.dataset.note;if(!note)return;if(notes.includes(note)){notes=notes.filter(item=>item!==note)}else if(notes.length<max){notes=[...notes,note]}else{statusEl.textContent=`remove one note first. ${size} allows ${max}.`}draw()}));nameInput.addEventListener('input',draw);reset.addEventListener('click',()=>{notes=[];nameInput.value='';draw()});copy.addEventListener('click',async()=>{const text=`SUAS fragrance: ${nameInput.value.trim()||'untitled'} / ${size} / ${notes.join(' + ')||'no notes yet'} / ${price}`;try{await navigator.clipboard.writeText(text);statusEl.textContent='fragrance copied.'}catch{statusEl.textContent=text}});draw()})();</script>
</section>
{% schema %}{"name":"SUAS Formula Builder","settings":[],"presets":[{"name":"SUAS Formula Builder"}]}{% endschema %}

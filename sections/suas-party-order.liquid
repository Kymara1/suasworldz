<section class="suas-party-os" aria-label="Party order form">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}
    .suas-party-os{--ink:#101010;--navy:#07162e;--lime:#d9ff78;--hot:#ff9bc4;--pink:#ffd8e8;--blue:#1e6ad4;--sky:#4eb8ea;--cream:#f4ecd4;color:var(--ink);font-family:Tahoma,Futura,Arial,sans-serif;padding:52px 14px 48px;min-height:calc(100vh - 36px);background:linear-gradient(180deg,#3aa4e0 0%,#8ed0ef 36%,#d7ecc8 58%,#6aae3e 78%,#3d7c22 100%)}
    .suas-party-os *{box-sizing:border-box}
    .suas-party-sheet{width:min(1080px,100%);margin:0 auto;border:3px solid var(--navy);background:linear-gradient(180deg,#0a1a36,#10264a);box-shadow:8px 10px 0 #101010;overflow:hidden}
    .suas-party-titlebar{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px;min-height:34px;padding:6px 10px;background:linear-gradient(180deg,#1c3f78,#0d2448);color:#fff}
    .suas-party-orb{width:18px;height:18px;border-radius:999px;background:radial-gradient(circle at 30% 30%,#fff,#d9ff78 42%,#101010);border:1.5px solid #fff}
    .suas-party-titlebar b{font:900 11px/1 Tahoma,Arial,sans-serif;letter-spacing:.18em}
    .suas-party-winbtns{display:flex;gap:4px}
    .suas-party-winbtns i{display:block;width:16px;height:14px;border:1.5px solid #fff;background:#cdeeff;font-style:normal}
    .suas-party-winbtns i:nth-child(3){background:#ff5f57}
    .suas-party-hero{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:end;padding:10px 16px 14px;color:#fff}
    .suas-party-hero p{margin:0 0 6px;font:900 13px/1 Tahoma,Arial,sans-serif;letter-spacing:.02em}
    .suas-party-hero h1{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(2.4rem,6vw,4.4rem);line-height:.82;color:var(--lime);text-transform:uppercase;font-weight:400}
    .suas-party-mark{width:92px;height:92px;object-fit:contain;filter:drop-shadow(0 2px 0 #000)}
    .suas-party-mark-fallback{width:88px;height:88px;display:grid;place-items:center;border:3px solid #fff;border-radius:999px;background:var(--lime);color:var(--navy);font-family:'Casual Human',Futura,Arial,sans-serif;font-size:3.2rem;line-height:.8}
    .suas-party-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:0 12px 12px;background:rgba(7,22,46,.18)}
    .suas-party-win{border:2.5px solid var(--ink);background:var(--cream);box-shadow:4px 5px 0 #101010;min-width:0}
    .suas-party-bar{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:30px;padding:5px 8px;color:#fff;font:900 11px/1 Tahoma,Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase}
    .suas-party-bar span{display:flex;gap:3px}
    .suas-party-bar i{width:14px;height:12px;border:1.5px solid #fff;background:rgba(255,255,255,.35);font-style:normal}
    .suas-party-body{display:grid;gap:10px;padding:12px}
    .suas-party-field{display:grid;grid-template-columns:minmax(7.5rem,34%) 1fr;gap:8px;align-items:center}
    .suas-party-field.is-stack{grid-template-columns:1fr;align-items:stretch}
    .suas-party-os label{font:900 12px/1.2 Tahoma,Arial,sans-serif}
    .suas-party-os input[type='text'],
    .suas-party-os input[type='email'],
    .suas-party-os input[type='tel'],
    .suas-party-os input[type='date'],
    .suas-party-os input[type='number'],
    .suas-party-os textarea{width:100%;min-height:40px;border:2px solid var(--ink);background:#fff;padding:8px 10px;font:800 16px/1.2 Tahoma,Arial,sans-serif;color:var(--ink)}
    .suas-party-os textarea{min-height:72px;resize:vertical}
    .suas-party-os input:focus,
    .suas-party-os textarea:focus{outline:3px solid var(--ink);outline-offset:2px}
    .suas-party-hint{margin:0;font:700 11px/1.3 Tahoma,Arial,sans-serif;color:rgba(16,16,16,.7)}
    .suas-party-packs{display:grid;gap:8px}
    .suas-party-pack{display:grid;grid-template-columns:28px 1fr auto;gap:10px;align-items:center;min-height:44px;padding:8px 10px;border:2px solid transparent;cursor:pointer}
    .suas-party-pack:has(input:checked){border-color:var(--ink);background:#fff;box-shadow:0 3px 0 var(--ink)}
    .suas-party-pack input{width:18px;height:18px;accent-color:#101010}
    .suas-party-pack b{font:900 15px/1.1 Tahoma,Arial,sans-serif}
    .suas-party-pack em{font:900 22px/1 Tahoma,Arial,sans-serif;font-style:normal;white-space:nowrap}
    .suas-party-pack small{display:block;font:800 10px/1 Tahoma,Arial,sans-serif;letter-spacing:.04em;text-transform:uppercase}
    .suas-party-note{margin:4px 0 0;padding:8px 10px;border:2px solid var(--ink);background:var(--hot);font:800 13px/1.25 Tahoma,Arial,sans-serif}
    .suas-party-yesno{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center}
    .suas-party-yesno label{display:inline-flex;align-items:center;gap:8px;min-height:40px;font-weight:900}
    .suas-party-yesno input{width:18px;height:18px}
    .suas-party-task{display:flex;align-items:center;gap:10px;min-height:36px;padding:6px 10px;background:linear-gradient(180deg,#2f7adf,#1a4ea8);color:#fff}
    .suas-party-start{min-height:40px;padding:0 16px;border:2px solid #101010;border-radius:4px 12px 12px 4px;background:linear-gradient(180deg,#b6ff57,#5bb000);color:#101010;font:900 16px/1 Tahoma,Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;box-shadow:0 2px 0 #101010}
    .suas-party-task em{font:800 12px/1 Tahoma,Arial,sans-serif;font-style:normal;opacity:.9}
    .suas-party-task b{margin-left:auto;font:900 11px/1 Tahoma,Arial,sans-serif;letter-spacing:.16em}
    .suas-party-flash{grid-column:1/-1;padding:12px;border:2px solid var(--ink);background:var(--lime);font:900 14px/1.35 Tahoma,Arial,sans-serif}
    .suas-party-flash.is-bad{background:var(--pink)}
    .suas-party-field-error{margin:0;color:#8a1024;font:800 12px/1.3 Tahoma,Arial,sans-serif}
    @media(max-width:900px){
      .suas-party-os{padding:18px 10px 36px}
      .suas-party-grid,.suas-party-field{grid-template-columns:1fr}
      .suas-party-hero{grid-template-columns:1fr;padding-bottom:8px}
      .suas-party-mark,.suas-party-mark-fallback{width:64px;height:64px;font-size:2.2rem}
    }
  </style>

  <div class="suas-party-sheet">
    <div class="suas-party-titlebar">
      <span class="suas-party-orb" aria-hidden="true"></span>
      <b>SUAS.OS</b>
      <span class="suas-party-winbtns" aria-hidden="true"><i></i><i></i><i></i></span>
    </div>
    <header class="suas-party-hero">
      <div>
        <h1>party order form.</h1>
        <p>private celebrations at the perfume bar.</p>
      </div>
      <span class="suas-party-mark-fallback" aria-hidden="true">S.</span>
    </header>

    {% form 'contact', class: 'suas-party-form', id: 'suas-party-form' %}
      {% if form.posted_successfully? %}
        <p class="suas-party-flash" role="status">Party request sent. We will review it and send an invoice if the date is open.</p>
      {% endif %}
      {% if form.errors %}
        <div class="suas-party-flash is-bad" role="alert">{{ form.errors | default_errors }}</div>
      {% endif %}
      <input type="hidden" name="contact[subject]" value="Party booking request">

      <div class="suas-party-grid">
        <section class="suas-party-win">
          <div class="suas-party-bar" style="background:#d6c21a"><b>S 1. Client information</b><span aria-hidden="true"><i></i><i></i><i></i></span></div>
          <div class="suas-party-body">
            <div class="suas-party-field">
              <label for="party-name">Full Name:</label>
              <input id="party-name" type="text" name="contact[name]" autocomplete="name" required>
            </div>
            <div class="suas-party-field">
              <label for="party-phone">Phone Number:</label>
              <input id="party-phone" type="tel" name="contact[phone]" autocomplete="tel" required>
            </div>
            <div class="suas-party-field">
              <label for="party-email">Email Address:</label>
              <input id="party-email" type="email" name="contact[email]" autocomplete="email" required>
            </div>
            <div class="suas-party-field">
              <label for="party-ig">Instagram / Preferred Contact:</label>
              <input id="party-ig" type="text" name="contact[Instagram]" autocomplete="off">
            </div>
          </div>
        </section>

        <section class="suas-party-win">
          <div class="suas-party-bar" style="background:#e23d8a"><b>S 2. Party details</b><span aria-hidden="true"><i></i><i></i><i></i></span></div>
          <div class="suas-party-body">
            <div class="suas-party-field">
              <label for="party-date">Event Date:</label>
              <input id="party-date" type="date" name="contact[Event date]" required>
            </div>
            <div class="suas-party-field">
              <label for="party-time">Preferred Party Time:</label>
              <input id="party-time" type="text" name="contact[Preferred time]" placeholder="ex. 2:00 PM">
            </div>
            <div class="suas-party-field">
              <label for="party-guests">Guest Count:</label>
              <input id="party-guests" type="number" name="contact[Guest count]" min="1" max="12" inputmode="numeric" required>
            </div>
            <div class="suas-party-field">
              <label for="party-occasion">Occasion:</label>
              <input id="party-occasion" type="text" name="contact[Occasion]" placeholder="Birthday, Girls' Day, Team Celebration">
            </div>
            <div class="suas-party-field">
              <label for="party-ages">Guest Age Range (if relevant):</label>
              <input id="party-ages" type="text" name="contact[Age range]">
            </div>
            <div class="suas-party-field is-stack">
              <label for="party-notes">Notes / Special Requests:</label>
              <textarea id="party-notes" name="contact[body]"></textarea>
            </div>
          </div>
        </section>

        <section class="suas-party-win">
          <div class="suas-party-bar" style="background:#1e6ad4"><b>S 3. Package selection</b><span aria-hidden="true"><i></i><i></i><i></i></span></div>
          <div class="suas-party-body">
            <div class="suas-party-packs" role="radiogroup" aria-label="Package selection">
              <label class="suas-party-pack">
                <input class="party-pack" type="radio" name="contact[Package]" value="Self-Guided Party Pack — $65/person" data-rate="65" required>
                <span><b>Self-Guided Party Pack</b></span>
                <em>$65 <small>per person</small></em>
              </label>
              <label class="suas-party-pack">
                <input class="party-pack" type="radio" name="contact[Package]" value="Party Session — $95/guest" data-rate="95">
                <span><b>Party Session</b></span>
                <em>$95 <small>per guest</small></em>
              </label>
              <label class="suas-party-pack">
                <input class="party-pack" type="radio" name="contact[Package]" value="Deluxe Party — $145/person" data-rate="145">
                <span><b>Deluxe Party</b></span>
                <em>$145 <small>per person</small></em>
              </label>
              <label class="suas-party-pack">
                <input class="party-pack" type="radio" name="contact[Package]" value="Signature Collection — $165/person" data-rate="165">
                <span><b>Signature Collection</b></span>
                <em>$165 <small>per person</small></em>
              </label>
            </div>
            <p class="suas-party-note">All parties are 90 minutes. The Lab is completely closed off during your reserved time slot.</p>
          </div>
        </section>

        <section class="suas-party-win">
          <div class="suas-party-bar" style="background:#1e6ad4"><b>S 4. Food + extras</b><span aria-hidden="true"><i></i><i></i><i></i></span></div>
          <div class="suas-party-body">
            <div class="suas-party-yesno">
              <span>Bringing food?</span>
              <label><input type="radio" name="contact[Food]" value="Yes"> Yes</label>
              <label><input type="radio" name="contact[Food]" value="No" checked> No</label>
            </div>
            <div class="suas-party-yesno">
              <span>Bringing cake?</span>
              <label><input type="radio" name="contact[Cake]" value="Yes"> Yes</label>
              <label><input type="radio" name="contact[Cake]" value="No" checked> No</label>
            </div>
          </div>
        </section>
      </div>

      <div class="suas-party-task">
        <button class="suas-party-start" type="submit">Start</button>
        <em>party.exe</em>
        <label for="party-total" style="margin-left:auto;font:800 11px/1 Tahoma,Arial,sans-serif;letter-spacing:.04em">Est.</label>
        <input id="party-total" type="text" name="contact[Estimated total]" value="$0.00" aria-live="polite" style="width:7.5rem;min-height:32px;border:2px solid #101010;background:#fff;color:#101010;font:900 14px/1 Tahoma,Arial,sans-serif;padding:4px 8px">
        <b>SUAS.OS</b>
      </div>
    {% endform %}
  </div>
  <script>
    (function () {
      var form = document.getElementById('suas-party-form');
      if (!form) return;
      var guests = document.getElementById('party-guests');
      var total = document.getElementById('party-total');
      var notes = document.getElementById('party-notes');
      function money(n) { return '$' + (Math.max(0, Number(n) || 0)).toFixed(2); }
      function rate() {
        var pack = form.querySelector('.party-pack:checked');
        if (!pack) return 0;
        var fromData = Number(pack.getAttribute('data-rate'));
        if (fromData) return fromData;
        var match = String(pack.value).match(/\$(\d+)/);
        return match ? Number(match[1]) : 0;
      }
      function refreshTotal() {
        if (!total) return;
        total.value = money(rate() * (Number(guests && guests.value) || 0));
      }
      form.addEventListener('change', refreshTotal);
      form.addEventListener('input', refreshTotal);
      form.addEventListener('submit', function () {
        refreshTotal();
        if (!notes || !total) return;
        var line = 'Estimated total: ' + total.value;
        if (notes.value.indexOf('Estimated total:') === -1) {
          notes.value = notes.value.trim() ? notes.value.trim() + '\n' + line : line;
        }
      });
      refreshTotal();
    })();
  </script>
</section>
{% schema %}
{
  "name": "SUAS Party Order",
  "settings": [],
  "presets": [{ "name": "SUAS Party Order" }]
}
{% endschema %}

<section class="suas-party-os" aria-label="Party order form">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}
    .suas-party-os{--ink:#101010;--navy:#07162e;--lime:#d9ff78;--hot:#ff9bc4;--pink:#ffd8e8;--blue:#1e6ad4;--sky:#4eb8ea;--cream:#f4ecd4;color:var(--ink);font-family:Tahoma,Futura,Arial,sans-serif;padding:52px 14px 48px;min-height:calc(100vh - 36px);background:linear-gradient(180deg,#3aa4e0 0%,#8ed0ef 36%,#d7ecc8 58%,#6aae3e 78%,#3d7c22 100%)}
    .suas-party-os *{box-sizing:border-box}
    .suas-party-sheet{width:min(1080px,100%);margin:0 auto;border:3px solid var(--navy);background:linear-gradient(180deg,#0a1a36,#10264a);box-shadow:8px 10px 0 #101010;overflow:hidden}
    .suas-party-titlebar{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px;min-height:34px;padding:6px 10px;background:linear-gradient(180deg,#1c3f78,#0d2448);color:#fff}
    .suas-party-orb{width:18px;height:18px;border-radius:999px;background:radial-gradient(circle at 30% 30%,#fff,#d9ff78 42%,#101010);border:1.5px solid #fff}
    .suas-party-titlebar b{font:900 11px/1 Tahoma,Arial,sans-serif;letter-spacing:.18em}
    .suas-party-winbtns{display:flex;gap:4px}
    .suas-party-winbtns i{display:block;width:16px;height:14px;border:1.5px solid #fff;background:#cdeeff;font-style:normal}
    .suas-party-winbtns i:nth-child(3){background:#ff5f57}
    .suas-party-hero{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:end;padding:10px 16px 14px;color:#fff}
    .suas-party-hero p{margin:0 0 6px;font:900 13px/1 Tahoma,Arial,sans-serif;letter-spacing:.02em}
    .suas-party-hero h1{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(2.4rem,6vw,4.4rem);line-height:.82;color:var(--lime);text-transform:uppercase;font-weight:400}
    .suas-party-mark{width:92px;height:92px;object-fit:contain;filter:drop-shadow(0 2px 0 #000)}
    .suas-party-mark-fallback{width:88px;height:88px;display:grid;place-items:center;border:3px solid #fff;border-radius:999px;background:var(--lime);color:var(--navy);font-family:'Casual Human',Futura,Arial,sans-serif;font-size:3.2rem;line-height:.8}
    .suas-party-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:0 12px 12px;background:rgba(7,22,46,.18)}
    .suas-party-grid > .suas-party-win:last-child{grid-column:1 / -1}
    .suas-party-win{border:2.5px solid var(--ink);background:var(--cream);box-shadow:4px 5px 0 #101010;min-width:0}
    .suas-party-bar{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:30px;padding:5px 8px;color:#fff;font:900 11px/1 Tahoma,Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase}
    .suas-party-bar span{display:flex;gap:3px}
    .suas-party-bar i{width:14px;height:12px;border:1.5px solid #fff;background:rgba(255,255,255,.35);font-style:normal}
    .suas-party-body{display:grid;gap:10px;padding:12px}
    .suas-party-field{display:grid;grid-template-columns:minmax(7.5rem,34%) 1fr;gap:8px;align-items:center}
    .suas-party-field.is-stack{grid-template-columns:1fr;align-items:stretch}
    .suas-party-os label{font:900 12px/1.2 Tahoma,Arial,sans-serif}
    .suas-party-os input[type='text'],
    .suas-party-os input[type='email'],
    .suas-party-os input[type='tel'],
    .suas-party-os input[type='date'],
    .suas-party-os input[type='number'],
    .suas-party-os textarea{width:100%;min-height:40px;border:2px solid var(--ink);background:#fff;padding:8px 10px;font:800 16px/1.2 Tahoma,Arial,sans-serif;color:var(--ink)}
    .suas-party-os input[readonly]{background:var(--lime);letter-spacing:.06em}
    .suas-party-inv-row{display:flex;gap:8px;align-items:stretch}
    .suas-party-copy{min-height:40px;padding:0 12px;border:2px solid var(--ink);background:#fff;font:900 11px/1 Tahoma,Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;white-space:nowrap}
    .suas-party-os textarea{min-height:72px;resize:vertical}
    .suas-party-os input:focus,
    .suas-party-os textarea:focus{outline:3px solid var(--ink);outline-offset:2px}
    .suas-party-hint{margin:0;font:700 11px/1.3 Tahoma,Arial,sans-serif;color:rgba(16,16,16,.7)}
    .suas-party-packs{display:grid;gap:8px}
    .suas-party-pack{display:grid;grid-template-columns:28px 1fr auto;gap:10px;align-items:center;min-height:44px;padding:8px 10px;border:2px solid transparent;cursor:pointer}
    .suas-party-pack:has(input:checked){border-color:var(--ink);background:#fff;box-shadow:0 3px 0 var(--ink)}
    .suas-party-pack input{width:18px;height:18px;accent-color:#101010}
    .suas-party-pack b{font:900 15px/1.1 Tahoma,Arial,sans-serif}
    .suas-party-pack em{font:900 22px/1 Tahoma,Arial,sans-serif;font-style:normal;white-space:nowrap}
    .suas-party-pack small{display:block;font:800 10px/1 Tahoma,Arial,sans-serif;letter-spacing:.04em;text-transform:uppercase}
    .suas-party-note{margin:4px 0 0;padding:8px 10px;border:2px solid var(--ink);background:var(--hot);font:800 13px/1.25 Tahoma,Arial,sans-serif}
    .suas-party-yesno{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center}
    .suas-party-yesno label{display:inline-flex;align-items:center;gap:8px;min-height:40px;font-weight:900}
    .suas-party-yesno input{width:18px;height:18px}
    .suas-party-task{display:flex;align-items:center;gap:10px;min-height:36px;padding:6px 10px;background:linear-gradient(180deg,#2f7adf,#1a4ea8);color:#fff}
    .suas-party-start{min-height:40px;padding:0 16px;border:2px solid #101010;border-radius:4px 12px 12px 4px;background:linear-gradient(180deg,#b6ff57,#5bb000);color:#101010;font:900 16px/1 Tahoma,Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;box-shadow:0 2px 0 #101010}
    .suas-party-task em{font:800 12px/1 Tahoma,Arial,sans-serif;font-style:normal;opacity:.9}
    .suas-party-task b{margin-left:auto;font:900 11px/1 Tahoma,Arial,sans-serif;letter-spacing:.16em}
    .suas-party-flash{grid-column:1/-1;padding:12px;border:2px solid var(--ink);background:var(--lime);font:900 14px/1.35 Tahoma,Arial,sans-serif}
    .suas-party-flash.is-bad{background:var(--pink)}
    .suas-party-field-error{margin:0;color:#8a1024;font:800 12px/1.3 Tahoma,Arial,sans-serif}
    @media(max-width:900px){
      .suas-party-os{padding:18px 10px 36px}
      .suas-party-grid,.suas-party-field{grid-template-columns:1fr}
      .suas-party-hero{grid-template-columns:1fr;padding-bottom:8px}
      .suas-party-mark,.suas-party-mark-fallback{width:64px;height:64px;font-size:2.2rem}
    }
  </style>

  <div class="suas-party-sheet">
    <div class="suas-party-titlebar">
      <span class="suas-party-orb" aria-hidden="true"></span>
      <b>SUAS.OS</b>
      <span class="suas-party-winbtns" aria-hidden="true"><i></i><i></i><i></i></span>
    </div>
    <header class="suas-party-hero">
      <div>
        <h1>party order form.</h1>
        <p>private celebrations at the perfume bar.</p>
      </div>
    </header>

    {%- capture party_invoice_no -%}SUAS-{{ 'now' | date: '%Y%m%d' }}-{{ 'now' | date: '%H%M' }}{%- endcapture -%}
    {% form 'contact', class: 'suas-party-form', id: 'suas-party-form' %}
      {% if form.posted_successfully? %}
        <p class="suas-party-flash" role="status">Party request sent. Invoice <b id="party-invoice-flash">{{ party_invoice_no }}</b>. We will review it and send that invoice if the date is open.</p>
      {% endif %}
      {% if form.errors %}
        <div class="suas-party-flash is-bad" role="alert">{{ form.errors | default_errors }}</div>
      {% endif %}
      <input type="hidden" name="contact[subject]" id="party-subject" value="Party booking {{ party_invoice_no }}">

      <div class="suas-party-grid">
        <section class="suas-party-win">
          <div class="suas-party-bar" style="background:#d6c21a"><b>S 1. Client information</b><span aria-hidden="true"><i></i><i></i><i></i></span></div>
          <div class="suas-party-body">
            <div class="suas-party-field">
              <label for="party-name">Full Name:</label>
              <input id="party-name" type="text" name="contact[name]" autocomplete="name" required>
            </div>
            <div class="suas-party-field">
              <label for="party-phone">Phone Number:</label>
              <input id="party-phone" type="tel" name="contact[phone]" autocomplete="tel" required>
            </div>
            <div class="suas-party-field">
              <label for="party-email">Email Address:</label>
              <input id="party-email" type="email" name="contact[email]" autocomplete="email" required>
            </div>
            <div class="suas-party-field">
              <label for="party-invoice-no">Invoice #</label>
              <span class="suas-party-inv-row">
                <input id="party-invoice-no" type="text" name="contact[Invoice number]" value="{{ party_invoice_no }}" readonly required>
                <button class="suas-party-copy" type="button" id="party-invoice-copy">copy</button>
              </span>
            </div>
            <div class="suas-party-field">
              <label for="party-ig">Instagram / Preferred Contact:</label>
              <input id="party-ig" type="text" name="contact[Instagram]" autocomplete="off">
            </div>
          </div>
        </section>

        <section class="suas-party-win">
          <div class="suas-party-bar" style="background:#e23d8a"><b>S 2. Party details</b><span aria-hidden="true"><i></i><i></i><i></i></span></div>
          <div class="suas-party-body">
            <div class="suas-party-field">
              <label for="party-date">Event Date:</label>
              <input id="party-date" type="date" name="contact[Event date]" required>
            </div>
            <div class="suas-party-field">
              <label for="party-time">Preferred Party Time:</label>
              <input id="party-time" type="text" name="contact[Preferred time]" placeholder="ex. 2:00 PM">
            </div>
            <div class="suas-party-field">
              <label for="party-guests">Guest Count:</label>
              <input id="party-guests" type="number" name="contact[Guest count]" min="1" max="14" inputmode="numeric" required>
            </div>
            <p class="suas-party-hint" id="party-guest-hint">Max 14. Charm Bar add-on is $45 per person.</p>
            <div class="suas-party-field">
              <label for="party-occasion">Occasion:</label>
              <input id="party-occasion" type="text" name="contact[Occasion]" placeholder="Birthday, Girls' Day, Team Celebration">
            </div>
            <div class="suas-party-field">
              <label for="party-ages">Guest Age Range (if relevant):</label>
              <input id="party-ages" type="text" name="contact[Age range]">
            </div>
            <div class="suas-party-field is-stack">
              <label for="party-notes">Notes / Special Requests:</label>
              <textarea id="party-notes" name="contact[body]">Invoice {{ party_invoice_no }}</textarea>
            </div>
          </div>
        </section>

        <section class="suas-party-win">
          <div class="suas-party-bar" style="background:#1e6ad4"><b>S 3. Package selection</b><span aria-hidden="true"><i></i><i></i><i></i></span></div>
          <div class="suas-party-body">
            <div class="suas-party-packs" role="radiogroup" aria-label="Package selection">
              <label class="suas-party-pack">
                <input class="party-pack" type="radio" name="contact[Package]" value="Self-Guided Party Pack — $65/person" data-rate="65" required>
                <span><b>Self-Guided Party Pack</b></span>
                <em>$65 <small>per person</small></em>
              </label>
              <label class="suas-party-pack">
                <input class="party-pack" type="radio" name="contact[Package]" value="Party Session — $115/guest" data-rate="115">
                <span><b>Party Session</b></span>
                <em>$115 <small>per guest</small></em>
              </label>
              <label class="suas-party-pack">
                <input class="party-pack" type="radio" name="contact[Package]" value="Deluxe Party — $145/person" data-rate="145">
                <span><b>Deluxe Party</b></span>
                <em>$145 <small>per person</small></em>
              </label>
              <label class="suas-party-pack">
                <input class="party-pack" type="radio" name="contact[Package]" value="Signature Collection — $165/person" data-rate="165">
                <span><b>Signature Collection</b></span>
                <em>$165 <small>per person</small></em>
              </label>
              <label class="suas-party-pack">
                <input class="party-pack" type="radio" name="contact[Package]" value="Charm Bar Party — $50/person · 1 hour" data-rate="50" data-charm-only="true">
                <span><b>Charm Bar Party</b><small>Lab closed 1 hour</small></span>
                <em>$50 <small>per person</small></em>
              </label>
            </div>
            <label class="suas-party-pack" id="party-charm-addon-row">
              <input id="party-charm-addon" type="checkbox" name="contact[Charm Bar add-on]" value="Yes — $45/person">
              <span><b>Add Charm Bar</b><small>$45 per person on a Lab package</small></span>
              <em>$45 <small>add-on</small></em>
            </label>
            <input type="hidden" id="party-charm-addon-off" name="contact[Charm Bar add-on]" value="No">
            <p class="suas-party-note" id="party-duration-note">Lab parties are 90 minutes. The Lab is completely closed off during your reserved time slot. A 50% deposit is due at booking to hold the date. The remaining balance is due 48 hours before the party. Cancellations within 72 hours of the invoice are refundable; after that the deposit is non-refundable.</p>
          </div>
        </section>

        <section class="suas-party-win">
          <div class="suas-party-bar" style="background:#1e6ad4"><b>S 4. Food + extras</b><span aria-hidden="true"><i></i><i></i><i></i></span></div>
          <div class="suas-party-body">
            <div class="suas-party-yesno">
              <span>Bringing food?</span>
              <label><input type="radio" name="contact[Food]" value="Yes"> Yes</label>
              <label><input type="radio" name="contact[Food]" value="No" checked> No</label>
            </div>
            <div class="suas-party-yesno">
              <span>Bringing cake?</span>
              <label><input type="radio" name="contact[Cake]" value="Yes"> Yes</label>
              <label><input type="radio" name="contact[Cake]" value="No" checked> No</label>
            </div>
          </div>
        </section>

        <section class="suas-party-win">
          <div class="suas-party-bar" style="background:#5bb000"><b>S 5. Deposit payment</b><span aria-hidden="true"><i></i><i></i><i></i></span></div>
          <div class="suas-party-body">
            <p class="suas-party-hint">How should we invoice the 50% deposit? The date is held when that payment lands.</p>
            <div class="suas-party-packs" role="radiogroup" aria-label="Deposit payment method">
              <label class="suas-party-pack">
                <input type="radio" name="contact[Deposit payment]" value="Venmo" required>
                <span><b>Venmo</b></span>
              </label>
              <label class="suas-party-pack">
                <input type="radio" name="contact[Deposit payment]" value="Zelle">
                <span><b>Zelle</b></span>
              </label>
              <label class="suas-party-pack">
                <input type="radio" name="contact[Deposit payment]" value="Cash App">
                <span><b>Cash App</b></span>
              </label>
              <label class="suas-party-pack">
                <input type="radio" name="contact[Deposit payment]" value="Card / Shopify invoice" data-party-card="true">
                <span><b>Card</b><small>pay deposit at checkout</small></span>
              </label>
            </div>
            <p class="suas-party-hint" id="party-deposit-hint">Deposit due now: $0.00 · remaining 48 hours before: $0.00</p>
          </div>
        </section>
      </div>

      <div class="suas-party-task">
        <button class="suas-party-start" type="submit">Start</button>
        <em>party.exe</em>
        <label for="party-total" style="margin-left:auto;font:800 11px/1 Tahoma,Arial,sans-serif;letter-spacing:.04em">Est.</label>
        <input id="party-total" type="text" name="contact[Estimated total]" value="$0.00" aria-live="polite" style="width:7.5rem;min-height:32px;border:2px solid #101010;background:#fff;color:#101010;font:900 14px/1 Tahoma,Arial,sans-serif;padding:4px 8px">
        <input type="hidden" id="party-deposit" name="contact[Estimated deposit]" value="$0.00">
        <input type="hidden" id="party-remain" name="contact[Estimated remaining]" value="$0.00">
        <b>SUAS.OS</b>
      </div>
    {% endform %}
  </div>
  {%- liquid
    assign suas_deposit_dollar = nil
    assign suas_deposit_cent = nil
    assign suas_deposit_product = all_products['lab-party-deposit']
    if suas_deposit_product
      for v in suas_deposit_product.variants
        if v.title contains 'Dollar'
          assign suas_deposit_dollar = v.id
        endif
        if v.title contains 'Cent'
          assign suas_deposit_cent = v.id
        endif
      endfor
    endif
  -%}
  <script>
    (function () {
      var form = document.getElementById('suas-party-form');
      if (!form) return;
      var dollarId = {{ suas_deposit_dollar | json }};
      var centId = {{ suas_deposit_cent | json }};
      var guests = document.getElementById('party-guests');
      var total = document.getElementById('party-total');
      var notes = document.getElementById('party-notes');
      var charmAddon = document.getElementById('party-charm-addon');
      var charmAddonOff = document.getElementById('party-charm-addon-off');
      var charmAddonRow = document.getElementById('party-charm-addon-row');
      var durationNote = document.getElementById('party-duration-note');
      var guestHint = document.getElementById('party-guest-hint');
      function money(n) { return '$' + (Math.max(0, Number(n) || 0)).toFixed(2); }
      function selectedPack() {
        return form.querySelector('.party-pack:checked');
      }
      function isCharmOnly() {
        var pack = selectedPack();
        return !!(pack && pack.getAttribute('data-charm-only') === 'true');
      }
      function guestMax() {
        return 14;
      }
      function rate() {
        var pack = selectedPack();
        if (!pack) return 0;
        var fromData = Number(pack.getAttribute('data-rate'));
        if (fromData) return fromData;
        var match = String(pack.value).match(/\$(\d+)/);
        return match ? Number(match[1]) : 0;
      }
      function addonRate() {
        if (isCharmOnly()) return 0;
        return charmAddon && charmAddon.checked ? 45 : 0;
      }
      function guestCount() {
        return Number(guests && guests.value) || 0;
      }
      function fullTotal() {
        return (rate() + addonRate()) * guestCount();
      }
      var deposit = document.getElementById('party-deposit');
      var remain = document.getElementById('party-remain');
      var depositHint = document.getElementById('party-deposit-hint');
      function syncCharmAddon() {
        var charmOnly = isCharmOnly();
        var max = guestMax();
        if (guests) {
          guests.max = String(max);
          if (Number(guests.value) > max) guests.value = String(max);
        }
        if (charmAddonRow) charmAddonRow.style.display = charmOnly ? 'none' : '';
        if (charmOnly && charmAddon) charmAddon.checked = false;
        if (charmAddonOff) charmAddonOff.disabled = !!(charmAddon && charmAddon.checked);
        if (durationNote) {
          durationNote.textContent = charmOnly
            ? 'Charm Bar parties are 1 hour. The Lab is closed for that hour. A 50% deposit is due at booking to hold the date. The remaining balance is due 48 hours before the party. Cancellations within 72 hours of the invoice are refundable; after that the deposit is non-refundable.'
            : 'Lab parties are 90 minutes. The Lab is completely closed off during your reserved time slot. Charm Bar add-on is $45 per person. A 50% deposit is due at booking to hold the date. The remaining balance is due 48 hours before the party. Cancellations within 72 hours of the invoice are refundable; after that the deposit is non-refundable.';
        }
        if (guestHint) guestHint.textContent = charmOnly ? 'Max 14. Charm Bar party books the Lab for 1 hour.' : 'Max 14. Charm Bar add-on is $45 per person.';
      }
      function refreshTotal() {
        syncCharmAddon();
        var full = fullTotal();
        var half = Math.round(full * 50) / 100;
        if (total) total.value = money(full);
        if (deposit) deposit.value = money(half);
        if (remain) remain.value = money(full - half);
        if (depositHint) depositHint.textContent = 'Deposit due now: ' + money(half) + ' · remaining 48 hours before: ' + money(full - half);
      }
      function makeInvoiceNo() {
        var d = new Date();
        var ymd = d.getFullYear() + String(d.getMonth() + 1).padStart(2, '0') + String(d.getDate()).padStart(2, '0');
        var rand = (Math.random().toString(36).replace(/[^a-z0-9]/g, '') + Date.now().toString(36)).slice(0, 4).toUpperCase();
        return 'SUAS-' + ymd + '-' + rand;
      }
      function setInvoiceNo(num) {
        var inv = document.getElementById('party-invoice-no');
        var sub = document.getElementById('party-subject');
        if (inv) inv.value = num;
        if (sub) sub.value = 'Party booking ' + num;
        if (notes && notes.value.replace(/\s/g, '') === '') notes.value = 'Invoice ' + num;
        else if (notes) {
          notes.value = notes.value.replace(/^Invoice\s+SUAS-\d{8}-[A-Z0-9]+\s*/i, '').replace(/^\s+/, '');
          if (notes.value.indexOf('Invoice ') !== 0) notes.value = 'Invoice ' + num + (notes.value ? '\n' + notes.value : '');
        }
      }
      var pendingKey = 'suas-party-invoice-pending';
      var sentKey = 'suas-party-invoice-sent';
      var flash = document.getElementById('party-invoice-flash');
      if (flash) {
        try {
          var sent = sessionStorage.getItem(sentKey) || sessionStorage.getItem(pendingKey);
          if (sent) flash.textContent = sent;
          sessionStorage.removeItem(pendingKey);
          sessionStorage.removeItem(sentKey);
        } catch (e) {}
        setInvoiceNo(makeInvoiceNo());
      } else {
        var existing = '';
        try { existing = sessionStorage.getItem(pendingKey) || ''; } catch (e) {}
        if (!/^SUAS-\d{8}-[A-Z0-9]{4}$/.test(existing)) existing = makeInvoiceNo();
        try { sessionStorage.setItem(pendingKey, existing); } catch (e) {}
        setInvoiceNo(existing);
      }
      function isCardMethod(method) {
        return method && /card|shopify/i.test(method.value);
      }
      function stampNotes(num) {
        var method = form.querySelector('input[name="contact[Deposit payment]"]:checked');
        if (!notes || !total) return method;
        var line = 'Estimated total: ' + total.value + ' · deposit now: ' + (deposit ? deposit.value : '') + ' · remaining: ' + (remain ? remain.value : '') + (method ? ' · deposit method: ' + method.value : '');
        if (notes.value.indexOf('Estimated total:') === -1) {
          notes.value = notes.value.trim() + '\n' + line;
        }
        return method;
      }
      function addDepositToCart(num) {
        if (!dollarId && !centId) return Promise.resolve();
        var full = fullTotal();
        var half = Math.round(full * 50) / 100;
        var cents = Math.round(half * 100);
        if (cents < 1) return Promise.resolve();
        var dollars = Math.floor(cents / 100);
        var leftover = cents % 100;
        var pack = selectedPack();
        var props = {
          'Invoice': num,
          'Type': '50% Lab party deposit',
          'Event date': (document.getElementById('party-date') || {}).value || '',
          'Time': (document.getElementById('party-time') || {}).value || '',
          'Guests': String(guests && guests.value ? guests.value : ''),
          'Package': pack ? pack.value : '',
          'Charm Bar': isCharmOnly() ? 'Charm Bar Party — $50/person · 1 hour' : (addonRate() ? 'Yes — $45/person add-on' : 'No'),
          'Deposit': money(half)
        };
        var items = [];
        if (dollars && dollarId) items.push({ id: dollarId, quantity: dollars, properties: props });
        if (leftover && centId) items.push({ id: centId, quantity: leftover, properties: props });
        if (!items.length) return Promise.resolve();
        return fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ items: items })
        }).then(function (res) {
          if (!res.ok) throw new Error('cart');
        });
      }
      form.addEventListener('change', function () {
        refreshTotal();
        var method = form.querySelector('input[name="contact[Deposit payment]"]:checked');
        if (depositHint && isCardMethod(method)) {
          depositHint.textContent = 'Card: after you send this request, checkout opens for the ' + (deposit ? deposit.value : '') + ' deposit. Remaining is due 48 hours before.';
        }
      });
      form.addEventListener('input', refreshTotal);
      form.addEventListener('submit', function (event) {
        refreshTotal();
        var inv = document.getElementById('party-invoice-no');
        var num = inv && inv.value ? inv.value : makeInvoiceNo();
        setInvoiceNo(num);
        try {
          sessionStorage.setItem(pendingKey, num);
          sessionStorage.setItem(sentKey, num);
        } catch (e) {}
        var method = stampNotes(num);
        if (form.getAttribute('data-deposit-ready') === '1') return;
        if (!isCardMethod(method)) return;
        event.preventDefault();
        var start = form.querySelector('.suas-party-start');
        if (start) { start.disabled = true; start.textContent = 'Adding deposit…'; }
        addDepositToCart(num).then(function () {
          try { sessionStorage.setItem('suas-party-card-checkout', '1'); } catch (e) {}
          form.setAttribute('data-deposit-ready', '1');
          form.submit();
        }).catch(function () {
          form.setAttribute('data-deposit-ready', '1');
          form.submit();
        });
      });
      if (flash) {
        try {
          if (sessionStorage.getItem('suas-party-card-checkout') === '1') {
            sessionStorage.removeItem('suas-party-card-checkout');
            flash.parentNode && (flash.textContent = (flash.textContent || 'Request sent.') + ' Pay the deposit at checkout to hold the date.');
            window.location.assign('/checkout');
          }
        } catch (e) {}
      }
      refreshTotal();
      var copyBtn = document.getElementById('party-invoice-copy');
      if (copyBtn) {
        copyBtn.addEventListener('click', function () {
          var inv = document.getElementById('party-invoice-no');
          var num = inv ? inv.value : '';
          if (!num || !navigator.clipboard) return;
          navigator.clipboard.writeText(num).then(function () { copyBtn.textContent = 'copied'; });
        });
      }
    })();
  </script>
</section>

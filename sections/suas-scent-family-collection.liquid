<section class="suas-scent-family-collection" aria-label="{{ collection.title | escape }}">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}
    .suas-scent-family-collection{--ink:#101010;--paper:#fbfaf7;--lime:#d9ff78;color:var(--ink);background:var(--paper);padding:clamp(20px,4vw,48px) clamp(12px,3vw,36px) 64px;font-family:Futura,'Futura PT',Arial,sans-serif}
    .suas-scent-family-collection *{box-sizing:border-box}
    .suas-scent-family-inner{width:min(1160px,100%);margin:0 auto}
    .suas-scent-family-head{display:flex;align-items:end;justify-content:space-between;gap:12px;flex-wrap:wrap;margin:0 0 18px}
    .suas-scent-family-head a{color:var(--ink);font-size:11px;font-weight:900;letter-spacing:.12em;text-transform:uppercase;text-decoration:none}
    .suas-scent-family-head h1{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(2.8rem,8vw,5.6rem);line-height:.78;text-transform:lowercase}
    .suas-scent-family-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
    .suas-scent-family-card{display:grid;border:2px solid var(--ink);border-radius:22px;background:#fff;box-shadow:5px 6px 0 var(--ink);overflow:hidden;color:inherit;text-decoration:none}
    .suas-scent-family-card img{display:block;width:100%;aspect-ratio:1;object-fit:cover;background:#f4f1ea}
    .suas-scent-family-card span{display:block;padding:12px 14px 14px;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(1.6rem,3vw,2.4rem);line-height:.86;text-transform:lowercase}
    .suas-scent-family-card em{display:block;margin-top:6px;font-style:normal;font-family:Futura,'Futura PT',Arial,sans-serif;font-size:12px;font-weight:800;letter-spacing:.04em}
    @media(min-width:1024px){.template--collection .off-canvas--main-content{margin-left:220px!important;width:calc(100% - 220px)!important}}
    @media(max-width:820px){.suas-scent-family-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(max-width:520px){.suas-scent-family-grid{grid-template-columns:1fr}}
  </style>
  <div class="suas-scent-family-inner">
    <header class="suas-scent-family-head">
      <h1>{{ collection.title | downcase }}.</h1>
      <a href="/pages/scent-profile">all families</a>
    </header>
    <div class="suas-scent-family-grid">
      {% for product in collection.products %}
        <a class="suas-scent-family-card" href="{{ product.url }}">
          {% if product.featured_image %}
            {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}
          {% endif %}
          <span>{{ product.title | downcase }}<em>{{ product.price | money }}</em></span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "SUAS Scent Family",
  "settings": [],
  "presets": [{ "name": "SUAS Scent Family" }]
}
{% endschema %}

<section class="suas-men-world" aria-label="SUAS Men">
  {% render 'suas-men-chrome' %}
  <style>
    .suas-men-world{display:grid;place-items:center;color:#fff;background:linear-gradient(rgba(255,255,255,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.08) 1px,transparent 1px),#000;background-size:22px 22px,22px 22px,auto;font-family:Futura,'Futura PT',Arial,sans-serif;padding:28px 16px;min-height:calc(100vh - 36px)}
    .suas-men-world *{box-sizing:border-box}
    .suas-men-world a{color:inherit}
    .suas-men-font{font-family:'Casual Human',Futura,Arial,sans-serif!important;letter-spacing:0!important}
    .suas-men-mono{font-family:Futura,'Futura PT',Arial,sans-serif;font-size:10px;letter-spacing:.16em;text-transform:uppercase;font-weight:900}
    .suas-men-win{width:min(420px,100%);border:2px solid #fff;border-radius:22px;background:#000;box-shadow:5px 6px 0 #fff;overflow:hidden}
    .suas-men-bar{min-height:40px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:8px;padding:7px 12px;border-bottom:2px solid #fff}
    .suas-men-dots{display:flex;gap:6px}
    .suas-men-dot{width:10px;height:10px;border-radius:999px;border:1.5px solid #fff}
    .suas-men-dot.is-on{background:#fff}
    .suas-men-bar b{text-align:center;font-size:11px;letter-spacing:.18em}
    .suas-men-exit{color:#fff;text-decoration:none;font-size:9px;letter-spacing:.14em}
    .suas-men-body{display:flex;flex-direction:column;gap:10px;padding:14px 14px 16px}
    .suas-men-body small{display:block;text-align:center}
    .suas-men-body h1{margin:0;text-align:center;font-size:clamp(2.1rem,6vw,2.8rem);line-height:.8;text-transform:lowercase}
    .suas-men-chips{display:grid;grid-template-columns:1fr 1fr;gap:7px}
    .suas-men-chips a{min-height:36px;display:inline-flex;align-items:center;justify-content:center;padding:6px 8px;border:1.75px solid #fff;border-radius:999px;background:#000;color:#fff;box-shadow:0 2px 0 #fff;text-decoration:none;text-align:center;font-size:10px;font-weight:900;letter-spacing:.06em;text-transform:uppercase}
    .suas-men-chips a:hover{transform:translateY(1px);box-shadow:0 1px 0 #fff;color:#fff}
    @media(max-width:560px){
      .suas-men-world{padding:18px 12px}
      .suas-men-win{border-radius:18px}
      .suas-men-body h1{font-size:clamp(1.7rem,8vw,2.2rem)}
      .suas-men-chips a{min-height:32px;font-size:9px}
    }
  </style>
  <article class="suas-men-win">
    <div class="suas-men-bar">
      <div class="suas-men-dots" aria-hidden="true"><span class="suas-men-dot is-on"></span><span class="suas-men-dot"></span><span class="suas-men-dot"></span></div>
      <b class="suas-men-mono">the rack</b>
      <a class="suas-men-exit suas-men-mono" href="/">exit</a>
    </div>
    <div class="suas-men-body">
      <small class="suas-men-mono">suas men</small>
      <h1 class="suas-men-font">the rack</h1>
      <div class="suas-men-chips">
        <a href="/collections/cologne">Cologne</a>
        <a href="/collections/m-eau-de-parfum">Parfum</a>
        <a href="/collections/m-body-oil">Body oil</a>
        <a href="/collections/m-butter-creme">Butter creme</a>
        <a href="/collections/m-body-wash">Body wash</a>
        <a href="/collections/beard">Beard</a>
      </div>
    </div>
  </article>
</section>
{% schema %}
{
  "name": "SUAS Men World",
  "settings": [],
  "presets": [{"name": "SUAS Men World"}]
}
{% endschema %}

<section class="suas-men-world" aria-label="SUAS Men">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
    html.suas-men,
    html.suas-halloween.suas-men{background:#000!important}
    html.suas-men body,
    html.suas-halloween.suas-men body{background:#000!important;color:#fff}
    html.suas-men .suas-side-rail,
    html.suas-halloween.suas-men .suas-side-rail{background:#000!important;border-right:1px solid #fff!important;color:#fff!important;box-shadow:none!important}
    html.suas-men .suas-side-head,
    html.suas-men .suas-side-brand,
    html.suas-men .suas-side-kicker,
    html.suas-men .suas-side-link,
    html.suas-men .suas-side-label,
    html.suas-men .suas-side-num,
    html.suas-men .suas-side-status,
    html.suas-men .suas-side-status b,
    html.suas-men .suas-side-status span,
    html.suas-men .suas-side-foot a,
    html.suas-men .suas-side-foot span{color:#fff!important}
    html.suas-men .suas-side-kicker,
    html.suas-halloween.suas-men .suas-side-kicker{border-top-color:#fff!important;color:rgba(255,255,255,.55)!important}
    html.suas-men .suas-side-orb,
    html.suas-halloween.suas-men .suas-side-orb{background:#fff!important;box-shadow:none!important;filter:none!important}
    html.suas-men .suas-side-link:hover,
    html.suas-men .suas-side-link.is-active,
    html.suas-halloween.suas-men .suas-side-link.is-active{background:#fff!important;color:#000!important}
    html.suas-men .suas-side-link.is-active .suas-side-label,
    html.suas-men .suas-side-link.is-active .suas-side-num,
    html.suas-men .suas-side-link:hover .suas-side-label{color:#000!important}
    html.suas-men .suas-side-icon{border-color:#fff!important;background:#111!important;color:#fff!important;box-shadow:none!important}
    html.suas-men .suas-side-link.is-active .suas-side-icon,
    html.suas-men .suas-side-link:hover .suas-side-icon{background:#000!important;color:#fff!important;border-color:#000!important}
    html.suas-men .suas-panel-submenu{background:#000!important;border-color:#fff!important}
    html.suas-men .suas-panel-submenu a,
    html.suas-halloween.suas-men .suas-panel-submenu a{background:#000!important;color:#fff!important;border-color:#fff!important;box-shadow:0 2px 0 #fff!important}
    html.suas-men .suas-side-status,
    html.suas-halloween.suas-men .suas-side-status{background:#111!important;box-shadow:none!important}
    html.suas-men .suas-side-status-dot,
    html.suas-halloween.suas-men .suas-side-status-dot{background:#fff!important;box-shadow:none!important}
    html.suas-men .suas-frame-marquee,
    html.suas-halloween.suas-men .suas-frame-marquee{background:#000!important;color:#fff!important;border-bottom:1px solid #fff!important}
    html.suas-men .suas-mobile-bar{background:#000!important;color:#fff!important;border-color:#fff!important}
    html.suas-men .suas-panel-toggle{color:#fff!important;border-color:#fff!important;background:#000!important}
    .suas-men-world{color:#fff;background:linear-gradient(rgba(255,255,255,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.08) 1px,transparent 1px),#000;background-size:22px 22px,22px 22px,auto;font-family:Futura,'Futura PT',Arial,sans-serif;padding:18px 0 36px;min-height:70vh}
    .suas-men-world *{box-sizing:border-box}
    .suas-men-world a{color:inherit}
    .suas-men-font{font-family:'Casual Human',Futura,Arial,sans-serif!important;letter-spacing:0!important}
    .suas-men-mono{font-family:Futura,'Futura PT',Arial,sans-serif;font-size:10px;letter-spacing:.16em;text-transform:uppercase;font-weight:900}
    .suas-men-wrap{width:min(1080px,calc(100vw - 24px));margin:0 auto}
    .suas-men-win{border:2px solid #fff;border-radius:20px;background:#000;box-shadow:5px 6px 0 #fff;overflow:hidden}
    .suas-men-bar{min-height:42px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px;padding:8px 14px;border-bottom:2px solid #fff;background:#000;color:#fff}
    .suas-men-dots{display:flex;gap:6px}
    .suas-men-dot{width:10px;height:10px;border-radius:999px;border:1.5px solid #fff;background:transparent}
    .suas-men-dot.is-on{background:#fff}
    .suas-men-bar b{text-align:center;font-size:11px;letter-spacing:.2em}
    .suas-men-exit{color:#fff;text-decoration:none;font-size:9px;letter-spacing:.14em}
    .suas-men-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;padding:12px}
    .suas-men-tile{display:flex;flex-direction:column;gap:7px;padding:10px;border:2px solid #fff;border-radius:14px;background:#000;color:#fff;text-decoration:none}
    .suas-men-tile img,.suas-men-blank{display:block;width:100%;aspect-ratio:1;object-fit:contain;border:1.5px solid #fff;border-radius:10px;background:#111}
    .suas-men-tile b{font-size:.9rem;line-height:.95;text-transform:lowercase;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .suas-men-tile span{opacity:.8}
    @media(max-width:700px){.suas-men-grid{grid-template-columns:1fr 1fr;gap:8px;padding:10px}}
  </style>
  {% liquid
    assign rack = collections['masculine']
    if rack == blank or rack.products_count == 0
      assign rack = collections['cologne']
    endif
    if rack == blank or rack.products_count == 0
      assign rack = collections['m-eau-de-parfum']
    endif
  %}
  <div class="suas-men-wrap">
    <div class="suas-men-win">
      <div class="suas-men-bar">
        <div class="suas-men-dots" aria-hidden="true"><span class="suas-men-dot is-on"></span><span class="suas-men-dot"></span><span class="suas-men-dot"></span></div>
        <b class="suas-men-mono">the rack</b>
        <a class="suas-men-exit suas-men-mono" href="/">exit</a>
      </div>
      <div class="suas-men-grid">
        {% assign rack_shown = 0 %}
        {% if rack != blank %}
          {% for product in rack.products limit: 8 %}
            {% unless product.handle contains 'lab-session' or product.handle contains 'charm-bar' %}
              {% assign rack_shown = rack_shown | plus: 1 %}
              <a class="suas-men-tile" href="{{ product.url }}">
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}
                {% else %}
                  <div class="suas-men-blank"></div>
                {% endif %}
                <b class="suas-men-font">{{ product.title }}</b>
                <span class="suas-men-mono">{{ product.price | money }}</span>
              </a>
            {% endunless %}
          {% endfor %}
        {% endif %}
        {% if rack_shown == 0 %}
          <a class="suas-men-tile" href="/collections/masculine"><div class="suas-men-blank"></div><b class="suas-men-font">open masculine</b></a>
        {% endif %}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "SUAS Men World",
  "settings": [],
  "presets": [{"name": "SUAS Men World"}]
}
{% endschema %}

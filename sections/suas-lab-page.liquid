<section class="suas-lab-page" aria-label="The Lab">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}.suas-lab-page{--ink:#111;--cream:#fffaf5;--blush:#ffe8ef;--pink:#ff9fc2;--lime:#d9ff78;--blue:#c9e7ff;--lav:#dccbff;color:var(--ink);background:radial-gradient(circle at 14% 12%,rgba(217,255,120,.34),transparent 24%),radial-gradient(circle at 84% 28%,rgba(201,231,255,.44),transparent 25%),linear-gradient(180deg,#fff 0%,#fffaf5 100%);overflow:hidden;font-family:Futura,'Futura PT',Arial,sans-serif}.suas-lab-page *{box-sizing:border-box}.suas-lab-wrap{width:min(1040px,calc(100vw - 40px));margin:0 auto}.suas-lab-hero{position:relative;min-height:520px;display:grid;place-items:center;text-align:center;padding:clamp(42px,5vw,72px) 0 44px}.suas-lab-hero:before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(17,17,17,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(17,17,17,.055) 1px,transparent 1px);background-size:38px 38px;pointer-events:none}.suas-lab-copy{position:relative;z-index:1}.suas-lab-kicker{margin:0 0 18px;font-size:10px;letter-spacing:.42em;text-transform:uppercase;color:rgba(17,17,17,.45)}.suas-lab-title{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(3.2rem,7.2vw,7rem);font-weight:400;line-height:.88;letter-spacing:0;text-transform:uppercase}.suas-lab-subtitle{width:min(760px,100%);margin:24px auto 0;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(1rem,2vw,1.5rem);line-height:1.22;color:rgba(17,17,17,.62);text-transform:uppercase}.suas-lab-floater{display:none!important}.suas-lab-steps{position:relative;z-index:1;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-top:42px}.suas-lab-step{min-height:108px;border-radius:22px;border:2px solid rgba(17,17,17,.08);background:rgba(255,255,255,.72);box-shadow:0 14px 34px rgba(17,17,17,.07);padding:18px;text-align:left}.suas-lab-step b{display:block;margin-bottom:18px;font-size:10px;letter-spacing:.34em;text-transform:uppercase;color:rgba(17,17,17,.5)}.suas-lab-step span{display:block;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(1.05rem,1.45vw,1.42rem);line-height:1;text-transform:uppercase}.suas-lab-cta-row{display:flex;flex-wrap:wrap;justify-content:center;gap:14px;margin-top:34px}.suas-lab-cta{display:inline-flex;align-items:center;justify-content:center;min-height:52px;min-width:218px;border:3px solid var(--ink);border-radius:999px;background:linear-gradient(180deg,#ffd4e5 0%,#ff9fc2 100%);color:var(--ink);font-family:'Casual Human',Futura,Arial,sans-serif;font-size:1.12rem;text-decoration:none;text-transform:uppercase;box-shadow:0 6px 0 var(--ink),0 14px 26px rgba(255,159,194,.34);transition:transform 160ms ease,box-shadow 160ms ease}.suas-lab-cta[data-light]{background:linear-gradient(180deg,#fff 0%,#d9ff78 140%)}.suas-lab-cta:hover{color:var(--ink);transform:translateY(3px);box-shadow:0 3px 0 var(--ink),0 10px 20px rgba(255,159,194,.32)}.suas-lab-menu{padding:42px 0 58px;border-top:2px solid var(--ink);background:#fff}.suas-lab-menu h2{margin:0 0 20px;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(2.45rem,4.7vw,4.8rem);font-weight:400;line-height:.9;text-transform:lowercase}.suas-session-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;align-items:stretch}.suas-session{min-height:260px;border:2px solid var(--ink);border-radius:22px;padding:18px;background:var(--card-bg);box-shadow:0 7px 0 var(--ink);display:flex;flex-direction:column;justify-content:space-between;gap:16px}.suas-session h3{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(1.35rem,2vw,2rem);font-weight:400;line-height:.94;text-transform:uppercase}.suas-session p{margin:12px 0;font-size:12px;line-height:1.38;font-weight:800;color:rgba(17,17,17,.68)}.suas-session em{display:inline-flex;width:fit-content;max-width:100%;align-items:center;justify-content:center;margin:6px 0 10px;border:2px solid var(--ink);border-radius:999px;padding:6px 9px 5px;background:rgba(255,255,255,.72);box-shadow:0 3px 0 rgba(17,17,17,.18);font-size:8px;line-height:1.15;font-style:normal;font-weight:900;letter-spacing:.04em;text-align:center;text-transform:uppercase}.suas-price{display:block;margin-top:auto;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(1.62rem,2.25vw,2.15rem);line-height:.95}@media(max-width:980px){.suas-session-grid{grid-template-columns:1fr}.suas-lab-hero{min-height:auto}.suas-lab-steps{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:620px){.suas-lab-wrap{width:min(100% - 24px,520px)}.suas-lab-kicker{letter-spacing:.28em}.suas-lab-title{font-size:clamp(3.2rem,16vw,5.6rem)}.suas-lab-steps{grid-template-columns:1fr}.suas-session{min-height:0}.suas-lab-cta{width:100%;min-width:0}}
  </style>
  <div class="suas-lab-hero"><div class="suas-lab-wrap suas-lab-copy"><p class="suas-lab-kicker">{{ section.settings.kicker }}</p><h1 class="suas-lab-title">{{ section.settings.heading }}</h1><p class="suas-lab-subtitle">{{ section.settings.copy }}</p><div class="suas-lab-steps"><div class="suas-lab-step"><b>Step 01</b><span>choose session</span></div><div class="suas-lab-step"><b>Step 02</b><span>pick notes</span></div><div class="suas-lab-step"><b>Step 03</b><span>mix formula</span></div><div class="suas-lab-step"><b>Step 04</b><span>bottle it</span></div></div><div class="suas-lab-cta-row"><a class="suas-lab-cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a><a class="suas-lab-cta" data-light href="/pages/bookings">book a session</a></div></div></div>
  <div class="suas-lab-menu"><div class="suas-lab-wrap"><h2>choose your experiment.</h2><div class="suas-session-grid"><article class="suas-session" style="--card-bg:#ffe8ef"><div><h3>Self-Guided Perfume Experiment</h3><p>Create a 30 mL eau de parfum at your own pace. Choose your notes, mix, bottle, label, and decorate.</p><em>15 mL add-on: +$15</em></div><strong class="suas-price">$35</strong></article><article class="suas-session" style="--card-bg:#c9e7ff"><div><h3>Guided Lab Session</h3><p>Classroom-style guided 30 mL perfume experiment with hands-on instruction. Add 1 oz body oil or 4 oz butter creme for +$20 each.</p><em>appointment only</em></div><strong class="suas-price">$85 per person</strong></article><article class="suas-session" style="--card-bg:#d9ff78"><div><h3>Deluxe Lab Session</h3><p>Create your signature collection: 30 mL perfume, 1 oz body oil, and 4 oz butter creme in one guided experience.</p><em>signature collection</em></div><strong class="suas-price">$140</strong></article></div></div></div>
</section>
{% schema %}{"name":"SUAS Lab Page","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"the lab / experiment 001"},{"type":"text","id":"heading","label":"Heading","default":"mix your own signature scent."},{"type":"textarea","id":"copy","label":"Copy","default":"Pick your session, choose your notes, name it, bottle it, and wear the good one for real."},{"type":"text","id":"cta_label","label":"Button label","default":"enter the lab"},{"type":"url","id":"cta_link","label":"Button link"}],"presets":[{"name":"SUAS Lab Page"}]}{% endschema %}

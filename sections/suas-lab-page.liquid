<section class="suas-lab-page" aria-label="The Lab">
  <style>
    @font-face { font-family:'Casual Human'; src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype'); font-display:swap; }
    .suas-lab-page { --ink:#111; --cream:#fffaf5; --blush:#ffe8ef; --pink:#ff9fc2; --lime:#d9ff78; --blue:#c9e7ff; color:var(--ink); background:radial-gradient(circle at 14% 12%,rgba(217,255,120,.34),transparent 24%),radial-gradient(circle at 84% 28%,rgba(201,231,255,.44),transparent 25%),linear-gradient(180deg,#fff 0%,#fffaf5 100%); overflow:hidden; font-family:Futura,'Futura PT',Arial,sans-serif; }
    .suas-lab-page * { box-sizing:border-box; }
    .suas-lab-wrap { width:min(1180px,calc(100vw - 28px)); margin:0 auto; }
    .suas-lab-hero { position:relative; min-height:720px; display:grid; place-items:center; text-align:center; padding:clamp(64px,8vw,110px) 0 56px; }
    .suas-lab-hero:before { content:''; position:absolute; inset:0; background-image:linear-gradient(rgba(17,17,17,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(17,17,17,.055) 1px,transparent 1px); background-size:38px 38px; pointer-events:none; }
    .suas-lab-copy { position:relative; z-index:1; }
    .suas-lab-kicker { margin:0 0 28px; font-size:11px; letter-spacing:.45em; text-transform:uppercase; color:rgba(17,17,17,.45); }
    .suas-lab-title { margin:0; font-family:'Casual Human',Futura,Arial,sans-serif; font-size:clamp(4.2rem,11vw,10.4rem); font-weight:400; line-height:.88; letter-spacing:0; text-transform:uppercase; }
    .suas-lab-subtitle { width:min(860px,100%); margin:36px auto 0; font-family:'Casual Human',Futura,Arial,sans-serif; font-size:clamp(1.2rem,2.8vw,2rem); line-height:1.22; color:rgba(17,17,17,.62); text-transform:uppercase; }
    .suas-lab-floater { position:absolute; border:2px solid var(--ink); box-shadow:0 10px 24px rgba(17,17,17,.16); pointer-events:none; }
    .suas-lab-floater[data-shape='tube'] { width:76px; height:178px; right:7%; top:5%; border-radius:999px; background:linear-gradient(180deg,#d9ff78 0%,#a9e85f 100%); transform:rotate(-38deg); }
    .suas-lab-floater[data-shape='orb'] { width:104px; height:104px; left:6%; bottom:8%; border-radius:50% 50% 18% 18%; background:linear-gradient(160deg,#c9e7ff 0%,#eefbff 72%); }
    .suas-lab-steps { position:relative; z-index:1; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:18px; margin-top:70px; }
    .suas-lab-step { min-height:132px; border-radius:28px; border:2px solid rgba(17,17,17,.08); background:rgba(255,255,255,.72); box-shadow:0 18px 44px rgba(17,17,17,.08); padding:22px; text-align:left; }
    .suas-lab-step b { display:block; margin-bottom:26px; font-size:12px; letter-spacing:.36em; text-transform:uppercase; color:rgba(17,17,17,.5); }
    .suas-lab-step span { display:block; font-family:'Casual Human',Futura,Arial,sans-serif; font-size:clamp(1.3rem,2vw,2rem); line-height:1; text-transform:uppercase; }
    .suas-lab-cta { display:inline-flex; align-items:center; justify-content:center; min-height:66px; min-width:270px; margin-top:52px; border:3px solid var(--ink); border-radius:999px; background:linear-gradient(180deg,#ffd4e5 0%,#ff9fc2 100%); color:var(--ink); font-family:'Casual Human',Futura,Arial,sans-serif; font-size:1.55rem; text-decoration:none; text-transform:uppercase; box-shadow:0 7px 0 var(--ink),0 18px 34px rgba(255,159,194,.38); transition:transform 160ms ease,box-shadow 160ms ease; }
    .suas-lab-cta:hover { color:var(--ink); transform:translateY(3px); box-shadow:0 4px 0 var(--ink),0 12px 24px rgba(255,159,194,.36); }
    .suas-lab-menu { padding:clamp(52px,7vw,92px) 0; border-top:2px solid var(--ink); background:#fff; }
    .suas-lab-menu h2 { margin:0 0 24px; font-family:'Casual Human',Futura,Arial,sans-serif; font-size:clamp(3rem,7vw,7rem); font-weight:400; line-height:.9; text-transform:lowercase; }
    .suas-session-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; }
    .suas-session { min-height:270px; border:2px solid var(--ink); border-radius:26px; padding:24px; background:var(--card-bg); box-shadow:0 8px 0 var(--ink); display:flex; flex-direction:column; justify-content:space-between; }
    .suas-session h3 { margin:0; font-family:'Casual Human',Futura,Arial,sans-serif; font-size:clamp(2rem,3.2vw,3.2rem); font-weight:400; line-height:.92; text-transform:uppercase; }
    .suas-session p { margin:18px 0; font-size:15px; line-height:1.5; font-weight:700; color:rgba(17,17,17,.68); }
    .suas-price { font-family:'Casual Human',Futura,Arial,sans-serif; font-size:2.4rem; line-height:1; }
    @media (max-width:900px){ .suas-lab-hero{min-height:auto;} .suas-lab-steps,.suas-session-grid{grid-template-columns:repeat(2,minmax(0,1fr));} }
    @media (max-width:620px){ .suas-lab-kicker{letter-spacing:.28em;} .suas-lab-title{font-size:clamp(3.4rem,18vw,6rem);} .suas-lab-steps,.suas-session-grid{grid-template-columns:1fr;} .suas-lab-floater{opacity:.35;} }
  </style>
  <div class="suas-lab-hero"><span class="suas-lab-floater" data-shape="tube"></span><span class="suas-lab-floater" data-shape="orb"></span><div class="suas-lab-wrap suas-lab-copy"><p class="suas-lab-kicker">{{ section.settings.kicker }}</p><h1 class="suas-lab-title">{{ section.settings.heading }}</h1><p class="suas-lab-subtitle">{{ section.settings.copy }}</p><div class="suas-lab-steps"><div class="suas-lab-step"><b>Step 01</b><span>choose size</span></div><div class="suas-lab-step"><b>Step 02</b><span>add notes</span></div><div class="suas-lab-step"><b>Step 03</b><span>mix formula</span></div><div class="suas-lab-step"><b>Step 04</b><span>bottle it</span></div></div><a class="suas-lab-cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a></div></div>
  <div class="suas-lab-menu"><div class="suas-lab-wrap"><h2>choose your session.</h2><div class="suas-session-grid"><article class="suas-session" style="--card-bg:#ffe8ef;"><div><h3>mini lab session</h3><p>15 mL eau de parfum. Choose up to 2 scent notes. Add a second 15 mL for $15.</p></div><strong class="suas-price">$30</strong></article><article class="suas-session" style="--card-bg:#d9ff78;"><div><h3>30 mL lab session</h3><p>30 mL eau de parfum. Choose up to 3 scent notes, blend at the station, then label and decorate.</p></div><strong class="suas-price">$45</strong></article><article class="suas-session" style="--card-bg:#c9e7ff;"><div><h3>combo sesh</h3><p>15 mL eau de parfum plus 1 oz body oil. Build the scent, bottle the formula, and leave with both.</p></div><strong class="suas-price">$60</strong></article></div></div></div>
</section>
{% schema %}{"name":"SUAS Lab Page","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"the lab / experiment 001"},{"type":"text","id":"heading","label":"Heading","default":"mix your own signature scent."},{"type":"textarea","id":"copy","label":"Copy","default":"Pick your session, choose your notes, name it, bottle it, and wear the good one for real."},{"type":"text","id":"cta_label","label":"Button label","default":"enter the lab"},{"type":"url","id":"cta_link","label":"Button link"}],"presets":[{"name":"SUAS Lab Page"}]}{% endschema %}

<section class="suas-story-page suas-os-page" aria-label="Who are we">
  {% render 'suas-os-page-chrome' %}
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}
    .suas-story-page.suas-os-page{--ink:#101010;--navy:#07162e;--cream:#f4ecd4;--pink:#ffd8e8;--hot:#ff9bc4;--blue:#1e6ad4;--lime:#d9ff78;--sun:#fff1a8;--lav:#e4d5ff;color:var(--ink);font-family:Tahoma,Futura,Arial,sans-serif}
    .suas-story-page a{color:inherit;text-decoration:none}
    .suas-story-hero{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:end;padding:10px 16px 14px;color:#fff}
    .suas-story-hero p{margin:0 0 6px;font:900 13px/1 Tahoma,Arial,sans-serif;letter-spacing:.02em}
    .suas-story-title{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(2.2rem,5vw,3.6rem);line-height:.86;color:var(--lime);text-transform:uppercase;font-weight:400}
    .suas-story-lede{margin:8px 0 0;max-width:62ch;font:800 14px/1.45 Tahoma,Arial,sans-serif;color:rgba(255,255,255,.86)}
    .suas-story-mark{width:72px;height:72px;display:grid;place-items:center;border:3px solid #fff;border-radius:999px;background:var(--lime);color:var(--navy);font-family:'Casual Human',Futura,Arial,sans-serif;font-size:2.6rem;line-height:.8}
    .suas-story-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:0 12px 12px;background:rgba(7,22,46,.18)}
    .suas-story-win{border:2.5px solid var(--ink);background:var(--cream);box-shadow:4px 5px 0 #101010;min-width:0}
    .suas-story-bar{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:30px;padding:5px 8px;color:#fff;font:900 11px/1 Tahoma,Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase}
    .suas-story-bar span{display:flex;gap:3px}
    .suas-story-bar i{width:14px;height:12px;border:1.5px solid #fff;background:rgba(255,255,255,.35);font-style:normal}
    .suas-story-body{display:grid;gap:10px;padding:12px}
    .suas-story-win h2{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(1.5rem,3vw,2.2rem);line-height:.9;font-weight:400;text-transform:lowercase}
    .suas-story-win p{margin:0;font:800 13px/1.45 Tahoma,Arial,sans-serif;color:rgba(16,16,16,.78)}
    .suas-story-pills{display:flex;flex-wrap:wrap;gap:8px}
    .suas-story-pill{display:inline-flex;align-items:center;min-height:32px;padding:6px 10px;border:2px solid var(--ink);background:#fff;font:900 10px/1 Tahoma,Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase}
    .suas-story-cta{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:0 16px;border:2px solid #101010;border-radius:4px 12px 12px 4px;background:linear-gradient(180deg,#b6ff57,#5bb000);color:#101010;font:900 14px/1 Tahoma,Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase;box-shadow:0 2px 0 #101010;width:fit-content}
    .suas-story-hours{display:grid;gap:6px;margin:0;padding:0;list-style:none}
    .suas-story-hours li{display:flex;justify-content:space-between;gap:10px;padding:8px 10px;border:2px solid var(--ink);background:#fff;font:800 12px/1.3 Tahoma,Arial,sans-serif}
    .suas-story-launch{display:grid;grid-template-columns:1fr 1fr;gap:8px}
    .suas-story-tile{min-height:72px;display:flex;flex-direction:column;justify-content:center;padding:10px;border:2px solid var(--ink);background:#fff;box-shadow:3px 3px 0 var(--ink)}
    .suas-story-tile strong{font-family:'Casual Human',Futura,Arial,sans-serif;font-size:1.2rem;line-height:.9;font-weight:400;text-transform:lowercase}
    .suas-story-tile span{margin-top:4px;font:900 9px/1 Tahoma,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase;opacity:.62}
    @media(max-width:900px){
      .suas-story-hero,.suas-story-grid{grid-template-columns:1fr}
      .suas-story-mark{width:56px;height:56px;font-size:2rem}
    }
    @media(max-width:560px){.suas-story-launch{grid-template-columns:1fr}}
  </style>

  <div class="suas-os-sheet">
    <div class="suas-os-titlebar"><span class="suas-os-orb" aria-hidden="true"></span><b>WHO.EXE</b><span class="suas-os-winbtns" aria-hidden="true"><i></i><i></i><i></i></span></div>
    <header class="suas-story-hero">
      <div>
        <h1 class="suas-story-title">who are we?</h1>
        <p class="suas-story-lede">SUAS is Shut Up &amp; Smell. a gastonia scent studio for people who like their self care loud, a little rude, and not beige. we mix it in the lab. you take it home on your skin.</p>
      </div>
      <span class="suas-story-mark" aria-hidden="true">S.</span>
    </header>

    <div class="suas-story-grid">
      <article class="suas-story-win">
        <div class="suas-story-bar" style="background:#d6c21a"><b>S 1. the short version</b><span aria-hidden="true"><i></i><i></i><i></i></span></div>
        <div class="suas-story-body">
          <h2>handmade. loud. not beige.</h2>
          <p>we make fragrance, body care, home scent, and tiny mood experiments by hand. the store is part shop, part lab, part place to remember that smelling good is an activity.</p>
          <p>come in for your favorites. book a seat and mix something custom. or wander until a scent chooses you. no spa voice. no quiet luxury. just jars with an S. on them.</p>
        </div>
      </article>
      <article class="suas-story-win">
        <div class="suas-story-bar" style="background:#e23d8a"><b>S 2. what we’re about</b><span aria-hidden="true"><i></i><i></i><i></i></span></div>
        <div class="suas-story-body">
          <h2>soft skin. good stories.</h2>
          <p>playful formulas. scent memories you can wear, spray, burn, gift, or keep. if it looks like a nightstand still life, you walked into the wrong shop.</p>
          <div class="suas-story-pills">
            <span class="suas-story-pill">handmade</span>
            <span class="suas-story-pill">gastonia grown</span>
            <span class="suas-story-pill">fragrance first</span>
            <span class="suas-story-pill">a little weird</span>
          </div>
        </div>
      </article>
      <article class="suas-story-win">
        <div class="suas-story-bar" style="background:#1e6ad4"><b>S 3. the lab</b><span aria-hidden="true"><i></i><i></i><i></i></span></div>
        <div class="suas-story-body">
          <h2>twelve seats. thu–sun.</h2>
          <p>mix a perfume, a roll-on, a body oil, whatever the station is running. guided class if you want a babysitter. self-guided if you already know you’re trouble.</p>
          <p>bookings start november 14. walk-ins welcome in self-guided hours if a station is free.</p>
          <a class="suas-story-cta" href="/pages/bookings">book the lab</a>
        </div>
      </article>
      <article class="suas-story-win">
        <div class="suas-story-bar" style="background:#1e6ad4"><b>S 4. gastonia</b><span aria-hidden="true"><i></i><i></i><i></i></span></div>
        <div class="suas-story-body">
          <h2>not a moodboard.</h2>
          <p>188 w franklin blvd, gastonia, nc 28052. real street. real jars. closed monday–wednesday so we can make the stuff you keep asking for.</p>
          <a class="suas-story-cta" href="/pages/visit-us">visit us</a>
        </div>
      </article>
      <article class="suas-story-win">
        <div class="suas-story-bar" style="background:#5bb000"><b>S 5. lab hours</b><span aria-hidden="true"><i></i><i></i><i></i></span></div>
        <div class="suas-story-body">
          <ul class="suas-story-hours">
            <li><span>mon–wed</span><span>closed / make days</span></li>
            <li><span>thu–fri</span><span>self-guided 1–5 · guided 6–7:15</span></li>
            <li><span>saturday</span><span>self-guided 1–4 · guided 4:30 or 6:00</span></li>
            <li><span>sunday</span><span>self-guided 1–4 · no guided class</span></li>
          </ul>
        </div>
      </article>
      <article class="suas-story-win">
        <div class="suas-story-bar" style="background:#101010"><b>S 6. quick launch</b><span aria-hidden="true"><i></i><i></i><i></i></span></div>
        <div class="suas-story-body">
          <div class="suas-story-launch">
            <a class="suas-story-tile" href="/pages/bookings"><strong>book the lab</strong><span>pay to hold a seat</span></a>
            <a class="suas-story-tile" href="/pages/visit-us"><strong>visit us</strong><span>franklin blvd</span></a>
            <a class="suas-story-tile" href="/pages/scent-profile"><strong>scent profile</strong><span>shop by smell</span></a>
            <a class="suas-story-tile" href="/collections/all"><strong>shop</strong><span>grab a jar</span></a>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>
{% schema %}{"name":"SUAS Who We Are","settings":[],"presets":[{"name":"SUAS Who We Are"}]}{% endschema %}

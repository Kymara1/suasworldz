<section class="suas-story-page" aria-label="Who are we">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}
    .suas-story-page{--ink:#101010;--cream:#fbfaf7;--pink:#ffd8e8;--hot:#ff9bc4;--blue:#cdeeff;--lime:#d9ff78;--sun:#fff1a8;--lav:#e4d5ff;min-height:86vh;padding:18px 14px 72px;color:var(--ink);background:linear-gradient(rgba(16,16,16,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.035) 1px,transparent 1px),radial-gradient(circle at 8% 12%,rgba(255,216,232,.55),transparent 28%),radial-gradient(circle at 92% 8%,rgba(217,255,120,.32),transparent 24%),var(--cream);background-size:22px 22px,22px 22px,auto,auto,auto;font-family:Futura,'Futura PT',Arial,sans-serif}
    .suas-story-page *{box-sizing:border-box}
    .suas-story-page a{color:inherit;text-decoration:none}
    .suas-story-inner{width:min(1180px,100%);margin:0 auto}
    .suas-story-kicker,.suas-story-win-title,.suas-story-live,.suas-story-tile span,.suas-story-cta{font:900 10px/1 Futura,Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase}
    .suas-story-title,.suas-story-card h2,.suas-story-tile strong{font-family:'Casual Human',Futura,Arial,sans-serif!important;font-weight:400!important;letter-spacing:0!important}
    .suas-story-hero{margin-bottom:16px}
    .suas-story-kicker{color:rgba(16,16,16,.48)}
    .suas-story-title{margin:10px 0 14px;font-size:clamp(4.2rem,11vw,9rem);line-height:.8;text-transform:lowercase}
    .suas-story-lede{max-width:70ch;margin:0;font:800 clamp(1rem,1.6vw,1.22rem)/1.45 Futura,Arial,sans-serif;color:rgba(16,16,16,.66)}
    .suas-story-win{border:2px solid var(--ink);border-radius:24px;background:rgba(255,255,255,.93);box-shadow:5px 6px 0 var(--ink);overflow:hidden}
    .suas-story-winbar{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px;min-height:42px;padding:8px 14px;border-bottom:2px solid var(--ink);background:linear-gradient(180deg,#fff,#e8edf3)}
    .suas-story-dots{display:flex;gap:7px}
    .suas-story-dot{width:11px;height:11px;border-radius:999px;background:var(--dot)}
    .suas-story-win-title{text-align:center}
    .suas-story-live{display:inline-flex;align-items:center;gap:6px}
    .suas-story-live b{width:8px;height:8px;border-radius:999px;background:#28c840;box-shadow:0 0 0 4px rgba(40,200,64,.18)}
    .suas-story-body{padding:clamp(16px,2.4vw,26px)}
    .suas-story-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:14px;margin-top:14px}
    .suas-story-card{border:2px solid var(--ink);border-radius:22px;background:rgba(255,255,255,.9);box-shadow:4px 5px 0 var(--ink);padding:clamp(16px,2.2vw,24px)}
    .suas-story-card.lime{background:linear-gradient(160deg,#fff 0%,var(--lime) 140%)}
    .suas-story-card.pink{background:linear-gradient(160deg,#fff 0%,var(--pink) 140%)}
    .suas-story-card.blue{background:linear-gradient(160deg,#fff 0%,var(--blue) 140%)}
    .suas-story-card.sun{background:linear-gradient(160deg,#fff 0%,var(--sun) 140%)}
    .suas-story-card h2{margin:0 0 12px;font-size:clamp(2.1rem,4.4vw,3.6rem);line-height:.88;text-transform:lowercase}
    .suas-story-card p{margin:0 0 12px;font:800 14px/1.5 Futura,Arial,sans-serif;color:rgba(16,16,16,.68)}
    .suas-story-card p:last-child{margin-bottom:0}
    .suas-story-pills{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
    .suas-story-pill{display:inline-flex;align-items:center;min-height:36px;padding:6px 12px;border:2px solid var(--ink);border-radius:999px;background:var(--pink);box-shadow:0 3px 0 var(--ink);font:900 10px/1 Futura,Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase}
    .suas-story-pill:nth-child(2n){background:var(--lime)}
    .suas-story-pill:nth-child(3n){background:var(--blue)}
    .suas-story-pill:nth-child(4n){background:var(--sun)}
    .suas-story-mid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(260px,.85fr);gap:14px;margin-top:14px;align-items:start}
    .suas-story-launch{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .suas-story-tile{min-height:88px;display:flex;flex-direction:column;justify-content:center;padding:14px;border:1.75px solid var(--ink);border-radius:18px;background:var(--tile,#ffd8e8);box-shadow:0 4px 0 var(--ink)}
    .suas-story-tile:hover{transform:translateY(2px);box-shadow:0 2px 0 var(--ink)}
    .suas-story-tile strong{font-size:1.45rem;line-height:.9;text-transform:lowercase}
    .suas-story-tile span{margin-top:6px;opacity:.72}
    .suas-story-cta{display:inline-flex;align-items:center;justify-content:center;min-height:42px;margin-top:12px;padding:10px 16px;border:2px solid var(--ink);border-radius:999px;background:var(--ink);color:#fff;box-shadow:0 4px 0 var(--hot)}
    .suas-story-hours{display:grid;gap:8px;margin:0;padding:0;list-style:none}
    .suas-story-hours li{display:flex;justify-content:space-between;gap:10px;padding:10px 12px;border:1.5px solid var(--ink);border-radius:16px;background:#fff;font:800 12px/1.3 Futura,Arial,sans-serif}
    @media(max-width:900px){.suas-story-grid,.suas-story-mid{grid-template-columns:1fr}.suas-story-live{display:none}}
    @media(max-width:560px){.suas-story-title{font-size:clamp(3.4rem,16vw,5.2rem)}.suas-story-launch{grid-template-columns:1fr}}
  </style>

  <div class="suas-story-inner">
    <p class="suas-story-kicker">suas.os / about</p>
    <h1 class="suas-story-title">who are we?</h1>
    <p class="suas-story-lede">SUAS is Shut Up &amp; Smell. a gastonia scent studio for people who like their self care loud, a little rude, and not beige. we mix it in the lab. you take it home on your skin.</p>

    <div class="suas-story-grid">
      <article class="suas-story-card">
        <h2>the short version.</h2>
        <p>we make fragrance, body care, home scent, and tiny mood experiments by hand. the store is part shop, part lab, part place to remember that smelling good is an activity.</p>
        <p>come in for your favorites. book a seat and mix something custom. or wander until a scent chooses you. we support all three methods. no spa voice. no quiet luxury. just jars with an S. on them.</p>
      </article>
      <article class="suas-story-card blue">
        <h2>what we’re about.</h2>
        <p>playful formulas. soft skin. good stories. scent memories you can wear, spray, burn, gift, or keep all to yourself. if it looks like a nightstand still life, you walked into the wrong shop.</p>
        <div class="suas-story-pills">
          <span class="suas-story-pill">handmade</span>
          <span class="suas-story-pill">gastonia grown</span>
          <span class="suas-story-pill">fragrance first</span>
          <span class="suas-story-pill">a little weird</span>
        </div>
      </article>
    </div>

    <div class="suas-story-grid">
      <article class="suas-story-card lime">
        <h2>the lab.</h2>
        <p>twelve seats. thursday through sunday. mix a perfume, a roll-on, a body oil, whatever the station is running. guided class if you want a babysitter. self-guided if you already know you’re trouble.</p>
        <p>bookings start november 14. walk-ins welcome in self-guided hours if a station is free.</p>
        <a class="suas-story-cta" href="/pages/bookings">book the lab</a>
      </article>
      <article class="suas-story-card pink">
        <h2>gastonia. not a moodboard.</h2>
        <p>188 w franklin blvd, gastonia, nc 28052. real street. real jars. if you need a map, hit visit us. if you need a scent lane, hit scent profile.</p>
        <p>closed monday–wednesday so we can make the stuff you keep asking for.</p>
        <a class="suas-story-cta" href="/pages/visit-us">visit us</a>
      </article>
    </div>

    <div class="suas-story-mid">
      <article class="suas-story-win">
        <div class="suas-story-winbar">
          <div class="suas-story-dots">
            <span class="suas-story-dot" style="--dot:#ff5f57"></span>
            <span class="suas-story-dot" style="--dot:#febc2e"></span>
            <span class="suas-story-dot" style="--dot:#28c840"></span>
          </div>
          <span class="suas-story-win-title">LAB.HOURS</span>
          <span class="suas-story-live"><b></b>OPEN</span>
        </div>
        <div class="suas-story-body">
          <ul class="suas-story-hours">
            <li><span>mon–wed</span><span>closed / make days</span></li>
            <li><span>thu–fri</span><span>self-guided 1–5 · guided 6–7:15</span></li>
            <li><span>saturday</span><span>self-guided 1–4 · guided 4:30 or 6:00</span></li>
            <li><span>sunday</span><span>self-guided 1–4 · no guided class</span></li>
          </ul>
        </div>
      </article>

      <aside class="suas-story-win">
        <div class="suas-story-winbar">
          <div class="suas-story-dots">
            <span class="suas-story-dot" style="--dot:#ff5f57"></span>
            <span class="suas-story-dot" style="--dot:#febc2e"></span>
            <span class="suas-story-dot" style="--dot:#28c840"></span>
          </div>
          <span class="suas-story-win-title">QUICK.LAUNCH</span>
          <span class="suas-story-live"><b></b>GO</span>
        </div>
        <div class="suas-story-body">
          <div class="suas-story-launch">
            <a class="suas-story-tile" style="--tile:#ff9bc4" href="/pages/bookings"><strong>book the lab</strong><span>reserve a seat</span></a>
            <a class="suas-story-tile" style="--tile:#d9ff78" href="/pages/visit-us"><strong>visit us</strong><span>franklin blvd</span></a>
            <a class="suas-story-tile" style="--tile:#cdeeff" href="/pages/scent-profile"><strong>scent profile</strong><span>shop by smell</span></a>
            <a class="suas-story-tile" style="--tile:#fff1a8" href="/collections/all"><strong>shop</strong><span>grab a jar</span></a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>
{% schema %}{"name":"SUAS Who We Are","settings":[],"presets":[{"name":"SUAS Who We Are"}]}{% endschema %}

<style>
  body.template--cart .layout--main-content {
    padding-top: clamp(32px, 4vw, 52px) !important;
  }

  body.template--cart .cart--root[data-is-drawer="false"] {
    padding-top: clamp(30px, 3vw, 44px) !important;
    overflow: visible !important;
  }

  body.template--cart .cart--root[data-is-drawer="false"] .cart--header {
    display: grid !important;
    justify-items: center !important;
    margin: 0 0 24px !important;
    padding: 0 !important;
    overflow: visible !important;
  }

  body.template--cart .cart--root[data-is-drawer="false"] .cart--title {
    display: block !important;
    margin: 0 auto !important;
    max-width: 100% !important;
    font-size: clamp(1.85rem, 3.15vw, 3.05rem) !important;
    line-height: 1 !important;
    transform: none !important;
    overflow: visible !important;
  }

  body.template--cart .cart--root[data-is-drawer="false"] .cart--title:after {
    margin-top: 8px !important;
    padding: 5px 10px 4px !important;
    font-size: 8px !important;
    line-height: 1 !important;
    transform: none !important;
  }

  body.template--cart .cart--root[data-is-drawer="false"][data-view="desktop"] .cart--item {
    display: grid !important;
    grid-template-columns: 100px minmax(0, 1fr) 116px 132px 132px !important;
    gap: 18px !important;
    align-items: start !important;
    position: relative !important;
  }

  body.template--cart .cart--root[data-is-drawer="false"][data-view="desktop"] .cart--item--title {
    min-width: 0 !important;
    overflow-wrap: anywhere !important;
  }

  body.template--cart .cart--root[data-is-drawer="false"][data-view="desktop"] .cart--item--price {
    grid-column: 3 !important;
    justify-self: end !important;
    text-align: right !important;
  }

  body.template--cart .cart--root[data-is-drawer="false"][data-view="desktop"] .cart--item--quantity {
    grid-column: 4 !important;
    justify-self: end !important;
    text-align: center !important;
  }

  body.template--cart .cart--root[data-is-drawer="false"][data-view="desktop"] .cart--item--total {
    grid-column: 5 !important;
    grid-row: 1 !important;
    align-self: start !important;
    justify-self: end !important;
    margin: 0 !important;
    padding: 0 !important;
    text-align: right !important;
    white-space: nowrap !important;
  }

  body.template--cart .cart--root[data-is-drawer="false"][data-view="desktop"] .cart--item--total .money {
    display: inline-block !important;
    min-width: max-content !important;
  }

  body.template--cart .cart--root[data-is-drawer="false"][data-view="mobile"] .cart--item--price {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    gap: 12px !important;
  }

  body.template--cart .cart--root[data-is-drawer="false"][data-view="mobile"] .cart--item--total {
    margin-left: auto !important;
    text-align: right !important;
    white-space: nowrap !important;
  }

  @media (max-width: 980px) {
    body.template--cart .cart--root[data-is-drawer="false"][data-view="desktop"] {
      display: none !important;
    }
  }

  @media (max-width: 749px) {
    body.template--cart .layout--main-content {
      padding-top: 16px !important;
    }

    body.template--cart .cart--root[data-is-drawer="false"] {
      padding-top: 22px !important;
    }

    body.template--cart .cart--root[data-is-drawer="false"] .cart--header {
      margin-bottom: 18px !important;
    }

    body.template--cart .cart--root[data-is-drawer="false"] .cart--title {
      font-size: clamp(1.65rem, 9vw, 2.45rem) !important;
    }
  }
</style>

{%- liquid
  render 'cart', view: 'desktop'
  render 'cart', view: 'mobile'
-%}

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
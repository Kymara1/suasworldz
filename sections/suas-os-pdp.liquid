<section class="suas-os-pdp" data-suas-os-pdp>
  <style>
    html body.template--product .suas-station-desk{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(400px,.9fr);gap:18px}
    html body.template--product .suas-station-media,html body.template--product .suas-station-buy{min-height:620px;border:2px solid #101010;border-radius:24px;background:#fff;box-shadow:8px 9px 0 #101010;overflow:hidden}
    html body.template--product .suas-station-stage{min-height:540px;display:grid;place-items:center;padding:22px}
    html body.template--product .suas-station-photo{display:block;width:100%;height:auto;max-height:min(72vh,680px);object-fit:contain}
    html body.template--product .product-page--content,html body.template--product .suas-station-gravity-media{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
    @media(max-width:1023px){
      html body.template--product .suas-station-desk{grid-template-columns:1fr}
      html body.template--product .suas-station-media,html body.template--product .suas-station-buy{min-height:0}
      html body.template--product .suas-station-stage{min-height:280px}
    }
  </style>
</section>
{% schema %}
{"name":"SUAS OS product page","settings":[],"presets":[{"name":"SUAS OS product page"}]}
{% endschema %}

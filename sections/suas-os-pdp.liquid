<section class="suas-os-pdp" data-suas-os-pdp>
  <style>
    html body.template--product .suas-station-desk{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1.05fr) minmax(260px,.92fr);gap:0;align-items:stretch}
    html body.template--product .suas-station-media,html body.template--product .suas-station-buy{min-height:0;border:0;border-radius:0;background:transparent;box-shadow:none;overflow:visible}
    html body.template--product .product-page--content,html body.template--product .suas-station-gravity-media{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
    @media(max-width:1023px){
      html body.template--product .suas-station-desk{grid-template-columns:1fr}
    }
  </style>
</section>
{% schema %}
{"name":"SUAS OS product page","settings":[],"presets":[{"name":"SUAS OS product page"}]}
{% endschema %}

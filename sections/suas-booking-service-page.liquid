<section class="suas-service-page" style="--accent:{{ section.settings.accent }};">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
    .suas-service-page{--ink:#101010;color:var(--ink);padding:clamp(22px,4vw,56px) 14px 64px;background:radial-gradient(circle at 8% 8%,rgba(255,196,220,.3),transparent 25%),radial-gradient(circle at 92% 14%,rgba(217,255,120,.28),transparent 27%),#fffdf9;font-family:Futura,'Futura PT',Arial,sans-serif}
    .suas-service-wrap{width:min(1040px,100%);margin:auto}
    .suas-service-hero,.suas-service-card,.suas-service-content{border:2px solid var(--ink);box-shadow:0 6px 0 var(--ink);background:#fff;border-radius:18px}
    .suas-service-hero{padding:clamp(20px,4vw,44px);background:linear-gradient(135deg,#fff 0 58%,var(--accent) 145%)}
    .suas-service-kicker,.suas-service-button{font-size:10px;font-weight:900;letter-spacing:.16em;text-transform:uppercase}
    .suas-service-title,.suas-service-card h2{font-family:'Casual Human',Futura,Arial,sans-serif;font-weight:400;letter-spacing:0}
    .suas-service-title{max-width:820px;margin:10px 0 12px;font-size:clamp(2.6rem,7vw,5.8rem);line-height:.86;text-transform:uppercase}
    .suas-service-intro{max-width:700px;font-size:clamp(.95rem,1.7vw,1.15rem);line-height:1.45;font-weight:700}
    .suas-service-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}
    .suas-service-button{display:inline-flex;min-height:44px;align-items:center;justify-content:center;padding:11px 18px;border:2px solid var(--ink);border-radius:999px;box-shadow:0 4px 0 var(--ink);background:var(--accent);color:var(--ink);text-decoration:none}
    .suas-service-button.is-secondary{background:#fff}
    .suas-service-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:20px}
    .suas-service-card{min-height:190px;padding:20px;background:var(--card,#fff)}
    .suas-service-card h2{margin:0 0 10px;font-size:clamp(1.7rem,3vw,2.35rem);line-height:.92;text-transform:uppercase}
    .suas-service-card .rte{font-size:.9rem;line-height:1.45;font-weight:700}
    .suas-service-content{margin-top:20px;padding:20px}
    .suas-service-content:empty{display:none}
    @media(max-width:720px){.suas-service-page{padding:16px 10px 44px}.suas-service-hero{padding:18px}.suas-service-title{font-size:clamp(2.5rem,14vw,4rem)}.suas-service-grid{grid-template-columns:1fr;gap:12px}.suas-service-card{min-height:0;padding:17px}.suas-service-actions{display:grid;grid-template-columns:1fr}.suas-service-button{width:100%}}
  </style>
  <div class="suas-service-wrap">
    <header class="suas-service-hero">
      <div class="suas-service-kicker">{{ section.settings.kicker }}</div>
      <h1 class="suas-service-title">{{ section.settings.heading }}</h1>
      <div class="suas-service-intro rte">{{ section.settings.intro }}</div>
      <div class="suas-service-actions">
        {% if section.settings.primary_label != blank %}<a class="suas-service-button" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>{% endif %}
        {% if section.settings.secondary_label != blank %}<a class="suas-service-button is-secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>{% endif %}
      </div>
    </header>
    {% if section.blocks.size > 0 %}<div class="suas-service-grid">{% for block in section.blocks %}<article class="suas-service-card" style="--card:{{ block.settings.color }};" {{ block.shopify_attributes }}><h2>{{ block.settings.title }}</h2><div class="rte">{{ block.settings.copy }}</div></article>{% endfor %}</div>{% endif %}
    {% if page.content != blank %}<div class="suas-service-content rte">{{ page.content }}</div>{% endif %}
  </div>
</section>
{% schema %}
{"name":"SUAS Booking Service","settings":[{"type":"text","id":"kicker","label":"Eyebrow","default":"bookings / experience"},{"type":"text","id":"heading","label":"Heading","default":"make it a moment."},{"type":"richtext","id":"intro","label":"Introduction","default":"<p>Add the details customers need before they book.</p>"},{"type":"color","id":"accent","label":"Accent color","default":"#ffc4dc"},{"type":"text","id":"primary_label","label":"Primary button label","default":"start planning"},{"type":"url","id":"primary_link","label":"Primary button link"},{"type":"text","id":"secondary_label","label":"Secondary button label","default":"contact suas"},{"type":"url","id":"secondary_link","label":"Secondary button link"}],"blocks":[{"type":"detail","name":"Detail card","settings":[{"type":"text","id":"title","label":"Title","default":"good to know"},{"type":"richtext","id":"copy","label":"Copy","default":"<p>Add timing, pricing, group size, or what is included.</p>"},{"type":"color","id":"color","label":"Card color","default":"#fff2a9"}]}],"presets":[{"name":"SUAS Booking Service","blocks":[{"type":"detail"},{"type":"detail"},{"type":"detail"}]}]}
{% endschema %}
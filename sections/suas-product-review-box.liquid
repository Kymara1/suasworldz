<section class="suas-product-review-box" aria-label="Leave a product review">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
    .suas-product-gallery-arrow{position:absolute;top:50%;z-index:5;display:grid;place-items:center;width:32px;height:32px;border:2px solid #101010;border-radius:999px;background:#fff;color:#101010;box-shadow:0 3px 0 #101010;font:900 17px/1 Futura,Arial,sans-serif;cursor:pointer;transform:translateY(-50%)}
    .suas-product-gallery-arrow[data-dir='prev']{left:8px}.suas-product-gallery-arrow[data-dir='next']{right:8px}
    .suas-product-gallery-count{position:absolute;left:50%;bottom:8px;z-index:5;transform:translateX(-50%);padding:5px 9px;border:1.5px solid #101010;border-radius:999px;background:#d9ff78;box-shadow:0 2px 0 #101010;font:900 8px/1 Futura,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase}
    .suas-product-review-box{--ink:#101010;--pink:#ffd8e8;--lime:#d9ff78;--yellow:#fff1a8;padding:clamp(16px,2.2vw,24px) 12px;color:var(--ink);font-family:Futura,Arial,sans-serif}
    .suas-prb-card{position:relative;width:min(720px,100%);margin:0 auto;border:2px solid var(--ink);border-radius:22px;background:radial-gradient(circle at 12% 18%,rgba(205,238,255,.75),transparent 34%),linear-gradient(135deg,#fff 0%,var(--pink) 150%);box-shadow:5px 6px 0 var(--ink);padding:clamp(14px,1.8vw,20px)}
    .suas-prb-card h2{margin:0 0 11px;font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:clamp(1.55rem,3.2vw,2.5rem);font-weight:400!important;line-height:.9;text-transform:lowercase}
    .suas-prb-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
    .suas-prb-card label{display:grid;gap:5px;font:900 8px/1 Futura,Arial,sans-serif;letter-spacing:.15em;text-transform:uppercase;color:rgba(16,16,16,.55)}
    .suas-prb-card input,.suas-prb-card select,.suas-prb-card textarea{width:100%;min-height:38px;border:1.5px solid rgba(16,16,16,.28);border-radius:13px;background:#fff;padding:8px 10px;font:800 12px/1.25 Futura,Arial,sans-serif}
    .suas-prb-card textarea{grid-column:1/-1;min-height:70px}
    .suas-prb-button{grid-column:1/-1;min-height:39px;border:2px solid var(--ink);border-radius:999px;background:var(--lime);box-shadow:0 4px 0 var(--ink);font:900 9px/1 Futura,Arial,sans-serif;letter-spacing:.15em;text-transform:uppercase;cursor:pointer}
    .suas-prb-note{display:inline-flex;margin:10px 0 0;padding:7px 10px;border:1px solid rgba(16,16,16,.15);border-radius:999px;background:rgba(255,255,255,.72);font:800 9.5px/1.25 Futura,Arial,sans-serif}
    @media(max-width:820px){.suas-prb-grid{grid-template-columns:1fr}}
  </style>
  {% capture gallery_json %}[
    {%- assign image_count = 0 -%}
    {%- for media in product.media -%}{%- if media.media_type == 'image' -%}{%- if image_count > 0 -%},{%- endif -%}{"src":"{{ media.preview_image | image_url: width: 1100 }}","alt":{{ media.alt | default: product.title | json }}}{%- assign image_count = image_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
  ]{% endcapture %}
  <script type="application/json" data-suas-product-gallery-data>{{ gallery_json | strip }}</script>
  <div class="suas-prb-card"><h2>review {{ product.title | default: 'this product' }}.</h2><form data-suas-product-review-form><div class="suas-prb-grid"><label>your name<input name="name" required></label><label>rating out of 5<select name="rating" aria-label="Rating out of 5"><option value="5">5 of 5</option><option value="4">4 of 5</option><option value="3">3 of 5</option></select></label><label>what did it smell or feel like?<textarea name="review" required placeholder="loud, soft, lasted all day..."></textarea></label><button class="suas-prb-button" type="submit">submit product review</button></div><p class="suas-prb-note">Saved here first. Connect the review app to publish it live.</p></form></div>
  <script>(()=>{const section=document.currentScript.closest('.suas-product-review-box');const form=section?.querySelector('[data-suas-product-review-form]');const galleryData=section?.querySelector('[data-suas-product-gallery-data]');let gallery=[];try{gallery=JSON.parse(galleryData?.textContent||'[]')}catch{}const mediaBox=document.querySelector('.template--product [data-suas-station-media]')||document.querySelector('.template--product .product-page--featured-media');const image=mediaBox?.querySelector('[data-suas-station-photo]')||mediaBox?.querySelector('img');if(mediaBox&&image&&gallery.length>1&&!mediaBox.dataset.suasGalleryReady){mediaBox.dataset.suasGalleryReady='true';let index=0;const count=document.createElement('div');count.className='suas-product-gallery-count';const setImage=()=>{const item=gallery[index];image.src=item.src;image.srcset='';image.alt=item.alt||'';count.textContent=`${index+1} / ${gallery.length}`};['prev','next'].forEach(dir=>{const button=document.createElement('button');button.type='button';button.className='suas-product-gallery-arrow';button.dataset.dir=dir;button.setAttribute('aria-label',dir==='prev'?'Previous product photo':'Next product photo');button.textContent=dir==='prev'?'‹':'›';button.addEventListener('click',event=>{event.preventDefault();event.stopPropagation();index=(index+(dir==='prev'?-1:1)+gallery.length)%gallery.length;setImage()});mediaBox.appendChild(button)});mediaBox.appendChild(count);mediaBox.querySelectorAll('.modal--link,a').forEach(link=>link.addEventListener('click',event=>event.preventDefault(),true));setImage()}if(form){form.addEventListener('submit',event=>{event.preventDefault();const data=Object.fromEntries(new FormData(form).entries());const key='suasProductPageReviews';const saved=JSON.parse(localStorage.getItem(key)||'[]');saved.unshift({...data,product:'{{ product.handle }}',createdAt:new Date().toISOString()});localStorage.setItem(key,JSON.stringify(saved.slice(0,30)));section.querySelector('.suas-prb-note').textContent='Review saved here. Thank you.';form.reset()})}})();</script>
</section>
{% schema %}{"name":"SUAS Product Review Box","settings":[],"presets":[{"name":"SUAS Product Review Box"}]}{% endschema %}

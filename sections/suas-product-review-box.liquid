<section class="suas-product-review-box" aria-label="Leave a product review">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}.template--product .layout--main-content{padding:clamp(10px,1.6vw,20px) 10px 28px!important}.template--product .product-page--root,.template--product .product-page--container{width:min(820px,calc(100vw - 22px))!important;margin-inline:auto!important}.template--product .product-page--top-panel{display:grid!important;grid-template-columns:minmax(220px,.8fr) minmax(240px,.82fr)!important;gap:14px!important;align-items:start!important}.template--product .product-page--featured-media,.template--product .product-page--featured-blocks{padding:13px!important;border:2px solid #101010!important;border-radius:22px!important;box-shadow:5px 6px 0 #101010!important;background:rgba(255,255,255,.92)!important;min-height:0!important}.template--product .product-page--featured-media{position:relative!important;display:grid!important;place-items:center!important;width:100%!important;max-width:330px!important;aspect-ratio:1/1!important;max-height:330px!important;margin-inline:auto!important;overflow:hidden!important}.template--product .product-page--featured-media .modal--link{cursor:default!important}.template--product .product-page--featured-media img{width:100%!important;height:100%!important;max-height:276px!important;object-fit:contain!important;border-radius:18px!important}.template--product .product-page--featured-blocks{max-width:360px!important;margin-inline:auto!important}.template--product .product-page--heading,.template--product .product-page--heading *,.template--product h1{font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:clamp(1.45rem,2.65vw,2.35rem)!important;font-weight:400!important;line-height:.9!important;letter-spacing:0!important}.template--product .product-page--block{margin-bottom:8px!important}.template--product .product-price--root,.template--product .product-price--root *{font-size:clamp(.95rem,1.25vw,1.15rem)!important;font-weight:900!important}.template--product .shopify-payment-terms,.template--product .shopify-payment-terms *{font-size:10.5px!important;line-height:1.25!important}.template--product .product-page--button-container button,.template--product .product-page--button-container .shopify-payment-button__button{min-height:38px!important;border-radius:999px!important;font-size:9.5px!important;letter-spacing:.14em!important}.template--product .product-page--description,.template--product .collapsible-tab--content{max-height:136px!important;overflow:auto!important;margin-top:7px!important;padding:9px 11px!important;border:1.5px dashed rgba(16,16,16,.18)!important;border-radius:14px!important;background:linear-gradient(135deg,#fffaf5,#fff)!important}.template--product .product-page--description,.template--product .product-page--description *,.template--product .collapsible-tab--content,.template--product .collapsible-tab--content *{font-size:11px!important;line-height:1.32!important}.template--product .collapsible-tab--root,.template--product [data-block-type='collapsible-tab']{border-top:1px dashed rgba(16,16,16,.18)!important}.template--product .variant-selector--root,.template--product .radios--container,.template--product .product-options--root{font-size:10.5px!important}.template--product .shopify-app-block,.template--product [id*='asrv'],.template--product [class*='asrv']{font-family:Futura,Arial,sans-serif!important}.template--product .shopify-app-block{width:min(680px,calc(100vw - 24px))!important;min-height:0!important;margin:16px auto!important;padding:13px!important;border:2px solid #101010!important;border-radius:21px!important;background:linear-gradient(135deg,#fff,#ffd8e8 145%)!important;box-shadow:5px 6px 0 #101010!important;overflow:hidden!important}.template--product .shopify-app-block button{border-radius:999px!important;background:#101010!important;color:#fff!important}.suas-product-gallery-arrow{position:absolute;top:50%;z-index:5;display:grid;place-items:center;width:32px;height:32px;border:2px solid #101010;border-radius:999px;background:#fff;color:#101010;box-shadow:0 3px 0 #101010;font:900 17px/1 Futura,Arial,sans-serif;cursor:pointer;transform:translateY(-50%);transition:transform 160ms ease,box-shadow 160ms ease}.suas-product-gallery-arrow:hover{transform:translateY(calc(-50% + 2px));box-shadow:0 1px 0 #101010}.suas-product-gallery-arrow[data-dir='prev']{left:8px}.suas-product-gallery-arrow[data-dir='next']{right:8px}.suas-product-gallery-count{position:absolute;left:50%;bottom:8px;z-index:5;transform:translateX(-50%);padding:5px 9px;border:1.5px solid #101010;border-radius:999px;background:#d9ff78;box-shadow:0 2px 0 #101010;font:900 8px/1 Futura,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase}.suas-product-review-box{--ink:#101010;--pink:#ffd8e8;--lime:#d9ff78;--blue:#cdeeff;--yellow:#fff1a8;padding:clamp(16px,2.2vw,24px) 12px;background:transparent;color:var(--ink);font-family:Futura,Arial,sans-serif}.suas-prb-card{position:relative;width:min(620px,100%);margin:0 auto;border:2px solid var(--ink);border-radius:22px;background:radial-gradient(circle at 12% 18%,rgba(205,238,255,.75),transparent 34%),linear-gradient(135deg,#fff 0%,var(--pink) 150%);box-shadow:5px 6px 0 var(--ink);padding:clamp(14px,1.8vw,20px)}.suas-prb-card:before{content:'tell the shelf what happened';position:absolute;right:16px;top:-13px;padding:6px 10px;border:1.5px solid var(--ink);border-radius:999px;background:var(--yellow);box-shadow:0 3px 0 var(--ink);font:900 8px/1 Futura,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase}.suas-prb-card h2{margin:0 0 11px;font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:clamp(1.55rem,3.2vw,2.5rem);font-weight:400!important;line-height:.9;text-transform:lowercase}.suas-prb-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.suas-prb-card label{display:grid;gap:5px;font:900 8px/1 Futura,Arial,sans-serif;letter-spacing:.15em;text-transform:uppercase;color:rgba(16,16,16,.55)}.suas-prb-card input,.suas-prb-card select,.suas-prb-card textarea{width:100%;min-height:38px;border:1.5px solid rgba(16,16,16,.28);border-radius:13px;background:#fff;padding:8px 10px;color:var(--ink);font:800 12px/1.25 Futura,Arial,sans-serif}.suas-prb-card textarea{grid-column:1/-1;min-height:70px;resize:vertical}.suas-prb-button{grid-column:1/-1;min-height:39px;border:2px solid var(--ink);border-radius:999px;background:var(--lime);box-shadow:0 4px 0 var(--ink);font:900 9px/1 Futura,Arial,sans-serif;letter-spacing:.15em;text-transform:uppercase;cursor:pointer}.suas-prb-note{display:inline-flex;margin:10px 0 0;padding:7px 10px;border:1px solid rgba(16,16,16,.15);border-radius:999px;background:rgba(255,255,255,.72);font:800 9.5px/1.25 Futura,Arial,sans-serif;color:rgba(16,16,16,.52)}@media(max-width:820px){.template--product .layout--main-content{padding:8px 8px 24px!important}.template--product .product-page--top-panel{grid-template-columns:1fr!important;gap:12px!important}.template--product .product-page--featured-media{max-width:270px!important;max-height:270px!important;aspect-ratio:1/1!important}.template--product .product-page--featured-media img{max-height:224px!important}.template--product .product-page--featured-blocks{max-width:330px!important}.template--product .product-page--heading,.template--product .product-page--heading *,.template--product h1{font-size:clamp(1.45rem,8vw,2.25rem)!important}.template--product .product-page--description,.template--product .collapsible-tab--content{max-height:128px!important}.template--product .shopify-app-block{width:min(330px,calc(100vw - 18px))!important}.suas-prb-grid{grid-template-columns:1fr}.suas-prb-card{border-radius:20px;box-shadow:4px 5px 0 var(--ink)}.suas-prb-card:before{position:static;display:inline-flex;margin-bottom:9px}}
  </style>
  {% capture gallery_json %}[
    {%- assign image_count = 0 -%}
    {%- for media in product.media -%}{%- if media.media_type == 'image' -%}{%- if image_count > 0 -%},{%- endif -%}{"src":"{{ media.preview_image | image_url: width: 1100 }}","alt":{{ media.alt | default: product.title | json }}}{%- assign image_count = image_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
  ]{% endcapture %}
  <script type="application/json" data-suas-product-gallery-data>{{ gallery_json | strip }}</script>
  <div class="suas-prb-card"><h2>review {{ product.title | default: 'this product' }}.</h2><form data-suas-product-review-form><div class="suas-prb-grid"><label>your name<input name="name" required></label><label>rating<select name="rating"><option>★★★★★</option><option>★★★★☆</option><option>★★★☆☆</option></select></label><textarea name="review" required placeholder="What did it smell or feel like?"></textarea><button class="suas-prb-button" type="submit">submit product review</button></div><p class="suas-prb-note">Saved here first. Connect the review app to publish it live.</p></form></div>
  <script>(()=>{const section=document.currentScript.closest('.suas-product-review-box');const form=section?.querySelector('[data-suas-product-review-form]');const galleryData=section?.querySelector('[data-suas-product-gallery-data]');let gallery=[];try{gallery=JSON.parse(galleryData?.textContent||'[]')}catch{}const mediaBox=document.querySelector('.template--product .product-page--featured-media');const image=mediaBox?.querySelector('img');if(mediaBox&&image&&gallery.length>1&&!mediaBox.dataset.suasGalleryReady){mediaBox.dataset.suasGalleryReady='true';let index=0;const count=document.createElement('div');count.className='suas-product-gallery-count';const setImage=()=>{const item=gallery[index];image.src=item.src;image.srcset='';image.alt=item.alt||'';count.textContent=`${index+1} / ${gallery.length}`};['prev','next'].forEach(dir=>{const button=document.createElement('button');button.type='button';button.className='suas-product-gallery-arrow';button.dataset.dir=dir;button.setAttribute('aria-label',dir==='prev'?'Previous product photo':'Next product photo');button.textContent=dir==='prev'?'‹':'›';button.addEventListener('click',event=>{event.preventDefault();event.stopPropagation();index=(index+(dir==='prev'?-1:1)+gallery.length)%gallery.length;setImage()});mediaBox.appendChild(button)});mediaBox.appendChild(count);mediaBox.querySelectorAll('.modal--link,a').forEach(link=>link.addEventListener('click',event=>event.preventDefault(),true));setImage()}if(form){form.addEventListener('submit',event=>{event.preventDefault();const data=Object.fromEntries(new FormData(form).entries());const key='suasProductPageReviews';const saved=JSON.parse(localStorage.getItem(key)||'[]');saved.unshift({...data,product:'{{ product.handle }}',createdAt:new Date().toISOString()});localStorage.setItem(key,JSON.stringify(saved.slice(0,30)));section.querySelector('.suas-prb-note').textContent='Review saved here. Thank you.';form.reset()})}})();</script>
</section>
{% schema %}{"name":"SUAS Product Review Box","settings":[],"presets":[{"name":"SUAS Product Review Box"}]}{% endschema %}

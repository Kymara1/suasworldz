<section class="suas-product-review-box" aria-label="Leave a product review">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
    .template--product .product-page--root,.template--product .product-page--container{width:min(980px,calc(100vw - 28px))!important;margin-inline:auto!important}.template--product .layout--main-content{padding:clamp(18px,3vw,34px) 14px 42px!important}.template--product .product-page--top-panel{display:grid!important;grid-template-columns:minmax(280px,.9fr) minmax(280px,.95fr)!important;gap:24px!important;align-items:start!important}.template--product .product-page--featured-media,.template--product .product-page--featured-blocks{padding:18px!important;border-radius:24px!important;min-height:0!important}.template--product .product-page--featured-media{position:relative!important;display:grid!important;place-items:center!important;aspect-ratio:1/1!important;max-height:480px!important}.template--product .product-page--featured-media .modal--link{cursor:default!important}.template--product .product-page--featured-media img{width:100%!important;height:100%!important;max-height:420px!important;object-fit:contain!important;border-radius:18px!important}.template--product .product-page--heading,.template--product .product-page--heading *,.template--product h1{font-size:clamp(2.25rem,4.4vw,4.1rem)!important;line-height:.9!important}.template--product .product-page--block{margin-bottom:14px!important}.template--product .product-page--description,.template--product .product-page--description *,.template--product .collapsible-tab--content,.template--product .collapsible-tab--content *{font-size:13px!important;line-height:1.45!important}.template--product .product-page--description,.template--product .collapsible-tab--content{max-height:240px!important;overflow:auto!important;padding-right:8px!important}.template--product .collapsible-tab--root,.template--product [data-block-type='collapsible-tab']{border-top:1px dashed rgba(16,16,16,.22)!important}.suas-product-gallery-arrow{position:absolute;top:50%;z-index:5;display:grid;place-items:center;width:38px;height:38px;border:2px solid #101010;border-radius:999px;background:#fff;color:#101010;box-shadow:0 4px 0 #101010;font:900 18px/1 Futura,Arial,sans-serif;cursor:pointer;transform:translateY(-50%);transition:transform 160ms ease,box-shadow 160ms ease}.suas-product-gallery-arrow:hover{transform:translateY(calc(-50% + 2px));box-shadow:0 2px 0 #101010}.suas-product-gallery-arrow[data-dir='prev']{left:10px}.suas-product-gallery-arrow[data-dir='next']{right:10px}.suas-product-gallery-count{position:absolute;left:50%;bottom:10px;z-index:5;transform:translateX(-50%);padding:5px 10px;border:1.5px solid #101010;border-radius:999px;background:#d9ff78;box-shadow:0 2px 0 #101010;font:900 10px/1 Futura,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase}.suas-product-review-box{--ink:#101010;--pink:#ffd8e8;--lime:#d9ff78;--blue:#cdeeff;padding:clamp(20px,3vw,34px) 18px;background:#fbfaf7;color:var(--ink);font-family:Futura,Arial,sans-serif}.suas-prb-card{width:min(820px,100%);margin:0 auto;border:2px solid var(--ink);border-radius:24px;background:linear-gradient(135deg,#fff 0%,var(--pink) 150%);box-shadow:6px 7px 0 var(--ink);padding:clamp(16px,2.5vw,26px)}.suas-prb-card h2{margin:0 0 14px;font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:clamp(2.3rem,4.8vw,4rem);font-weight:400!important;line-height:.88;text-transform:lowercase}.suas-prb-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.suas-prb-card label{display:grid;gap:6px;font:900 10px/1 Futura,Arial,sans-serif;letter-spacing:.15em;text-transform:uppercase;color:rgba(16,16,16,.58)}.suas-prb-card input,.suas-prb-card select,.suas-prb-card textarea{width:100%;min-height:44px;border:1.5px solid rgba(16,16,16,.28);border-radius:14px;background:#fff;padding:10px 12px;color:var(--ink);font:800 14px/1.25 Futura,Arial,sans-serif}.suas-prb-card textarea{grid-column:1/-1;min-height:86px;resize:vertical}.suas-prb-button{grid-column:1/-1;min-height:46px;border:2px solid var(--ink);border-radius:999px;background:var(--lime);box-shadow:0 4px 0 var(--ink);font:900 11px/1 Futura,Arial,sans-serif;letter-spacing:.15em;text-transform:uppercase;cursor:pointer}.suas-prb-note{margin:12px 0 0;font:800 12px/1.4 Futura,Arial,sans-serif;color:rgba(16,16,16,.56)}@media(max-width:820px){.template--product .product-page--top-panel{grid-template-columns:1fr!important;gap:14px!important}.template--product .product-page--featured-media{max-height:none!important;aspect-ratio:1/1!important}.template--product .product-page--featured-media img{max-height:70vw!important}.template--product .product-page--heading,.template--product .product-page--heading *,.template--product h1{font-size:clamp(2.15rem,12vw,3.9rem)!important}.template--product .product-page--description,.template--product .collapsible-tab--content{max-height:210px!important}.suas-prb-grid{grid-template-columns:1fr}.suas-prb-card{border-radius:22px;box-shadow:5px 6px 0 var(--ink)}}
  </style>
  {% capture gallery_json %}[
    {%- assign image_count = 0 -%}
    {%- for media in product.media -%}
      {%- if media.media_type == 'image' -%}
        {%- if image_count > 0 -%},{%- endif -%}
        {"src":"{{ media | image_url: width: 1100 }}","alt":{{ media.alt | default: product.title | json }}}
        {%- assign image_count = image_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  ]{% endcapture %}
  <script type="application/json" data-suas-product-gallery-data>{{ gallery_json | strip }}</script>
  <div class="suas-prb-card"><h2>review {{ product.title | default: 'this product' }}.</h2><form data-suas-product-review-form><div class="suas-prb-grid"><label>your name<input name="name" required></label><label>rating<select name="rating"><option>★★★★★</option><option>★★★★☆</option><option>★★★☆☆</option></select></label><textarea name="review" required placeholder="What did it smell/feel/give?"></textarea><button class="suas-prb-button" type="submit">submit product review</button></div><p class="suas-prb-note">This saves on this browser for now. For public product reviews, use the AfterShip Reviews widget below.</p></form></div>
  <script>(()=>{const section=document.currentScript.closest('.suas-product-review-box');const form=section?.querySelector('[data-suas-product-review-form]');const galleryData=section?.querySelector('[data-suas-product-gallery-data]');let gallery=[];try{gallery=JSON.parse(galleryData?.textContent||'[]')}catch{}const mediaBox=document.querySelector('.template--product .product-page--featured-media');const image=mediaBox?.querySelector('img');if(mediaBox&&image&&gallery.length>1&&!mediaBox.dataset.suasGalleryReady){mediaBox.dataset.suasGalleryReady='true';let index=Math.max(0,gallery.findIndex(item=>image.currentSrc&&image.currentSrc.includes(item.src.split('?')[0].split('/').pop())));if(index<0)index=0;const count=document.createElement('div');count.className='suas-product-gallery-count';const setImage=()=>{const item=gallery[index];image.src=item.src;image.srcset='';image.alt=item.alt||'';count.textContent=`${index+1} / ${gallery.length}`};['prev','next'].forEach(dir=>{const button=document.createElement('button');button.type='button';button.className='suas-product-gallery-arrow';button.dataset.dir=dir;button.setAttribute('aria-label',dir==='prev'?'Previous product photo':'Next product photo');button.textContent=dir==='prev'?'‹':'›';button.addEventListener('click',event=>{event.preventDefault();event.stopPropagation();index=(index+(dir==='prev'?-1:1)+gallery.length)%gallery.length;setImage()});mediaBox.appendChild(button)});mediaBox.appendChild(count);mediaBox.querySelectorAll('.modal--link').forEach(link=>link.addEventListener('click',event=>event.preventDefault()));setImage()}if(form){form.addEventListener('submit',event=>{event.preventDefault();const data=Object.fromEntries(new FormData(form).entries());const key='suasProductPageReviews';const saved=JSON.parse(localStorage.getItem(key)||'[]');saved.unshift({...data,product:'{{ product.handle }}',createdAt:new Date().toISOString()});localStorage.setItem(key,JSON.stringify(saved.slice(0,30)));section.querySelector('.suas-prb-note').textContent='Review saved on this browser. Thank you.';form.reset()})}})();</script>
</section>
{% schema %}{"name":"SUAS Product Review Box","settings":[],"presets":[{"name":"SUAS Product Review Box"}]}{% endschema %}

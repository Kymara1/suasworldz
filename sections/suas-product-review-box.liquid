<section class="suas-product-review-box" aria-label="Leave a product review">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}.suas-product-review-box{--ink:#101010;--pink:#ffd8e8;--lime:#d9ff78;--blue:#cdeeff;padding:clamp(22px,4vw,42px) 18px;background:#fbfaf7;color:var(--ink);font-family:Futura,Arial,sans-serif}.suas-prb-card{width:min(860px,100%);margin:0 auto;border:2px solid var(--ink);border-radius:28px;background:linear-gradient(135deg,#fff 0%,var(--pink) 150%);box-shadow:7px 8px 0 var(--ink);padding:clamp(18px,3vw,30px)}.suas-prb-card h2{margin:0 0 14px;font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:clamp(2.8rem,6vw,5.2rem);font-weight:400!important;line-height:.86;text-transform:lowercase}.suas-prb-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.suas-prb-card label{display:grid;gap:6px;font:900 10px/1 Futura,Arial,sans-serif;letter-spacing:.15em;text-transform:uppercase;color:rgba(16,16,16,.58)}.suas-prb-card input,.suas-prb-card select,.suas-prb-card textarea{width:100%;min-height:46px;border:1.5px solid rgba(16,16,16,.28);border-radius:16px;background:#fff;padding:11px 13px;color:var(--ink);font:800 14px/1.25 Futura,Arial,sans-serif}.suas-prb-card textarea{grid-column:1/-1;min-height:92px;resize:vertical}.suas-prb-button{grid-column:1/-1;min-height:48px;border:2px solid var(--ink);border-radius:999px;background:var(--lime);box-shadow:0 4px 0 var(--ink);font:900 11px/1 Futura,Arial,sans-serif;letter-spacing:.15em;text-transform:uppercase;cursor:pointer}.suas-prb-note{margin:12px 0 0;font:800 12px/1.4 Futura,Arial,sans-serif;color:rgba(16,16,16,.56)}@media(max-width:700px){.suas-prb-grid{grid-template-columns:1fr}.suas-prb-card{border-radius:22px;box-shadow:5px 6px 0 var(--ink)}}
  </style>
  <div class="suas-prb-card"><h2>review {{ product.title | default: 'this product' }}.</h2><form data-suas-product-review-form><div class="suas-prb-grid"><label>your name<input name="name" required></label><label>rating<select name="rating"><option>★★★★★</option><option>★★★★☆</option><option>★★★☆☆</option></select></label><textarea name="review" required placeholder="What did it smell/feel/give?"></textarea><button class="suas-prb-button" type="submit">submit product review</button></div><p class="suas-prb-note">This saves on this browser for now. For public product reviews, use the AfterShip Reviews widget below.</p></form></div>
  <script>(()=>{const section=document.currentScript.closest('.suas-product-review-box');const form=section?.querySelector('[data-suas-product-review-form]');if(!form)return;form.addEventListener('submit',event=>{event.preventDefault();const data=Object.fromEntries(new FormData(form).entries());const key='suasProductPageReviews';const saved=JSON.parse(localStorage.getItem(key)||'[]');saved.unshift({...data,product:'{{ product.handle }}',createdAt:new Date().toISOString()});localStorage.setItem(key,JSON.stringify(saved.slice(0,30)));section.querySelector('.suas-prb-note').textContent='Review saved on this browser. Thank you.';form.reset()})})();</script>
</section>
{% schema %}{"name":"SUAS Product Review Box","settings":[],"presets":[{"name":"SUAS Product Review Box"}]}{% endschema %}

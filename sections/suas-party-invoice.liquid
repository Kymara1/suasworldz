{%- liquid
  assign customer_view = section.settings.customer_view
  assign suas_deposit_dollar = nil
  assign suas_deposit_cent = nil
  assign suas_deposit_product = all_products['lab-party-deposit']
  if suas_deposit_product
    for v in suas_deposit_product.variants
      if v.title contains 'Dollar'
        assign suas_deposit_dollar = v.id
      endif
      if v.title contains 'Cent'
        assign suas_deposit_cent = v.id
      endif
    endfor
  endif
  assign given = cart.attributes.suas_staff_pin | strip
  assign pin = section.settings.staff_pin | strip
  assign unlocked = false
  assign pin_wrong = false
  if customer_view
    assign unlocked = true
  endif
  if customer and customer.tags contains 'suas-staff'
    assign unlocked = true
  endif
  if pin != blank and given != blank and given == pin
    assign unlocked = true
  endif
  if pin != blank and given != blank and given != pin
    assign pin_wrong = true
  endif
-%}
<section class="suas-invoice-desk{% if customer_view %} is-view{% endif %}" aria-label="{% if customer_view %}Party invoice{% else %}Staff party invoice{% endif %}">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-weight:400;font-display:swap}
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}
    .suas-invoice-desk{--ink:#101010;--navy:#07162e;--lime:#d9ff78;--hot:#ff9bc4;--pink:#ffd8e8;--blue:#c9e7ff;--cream:#f4ecd4;color:var(--ink);font-family:Tahoma,Futura,Arial,sans-serif;min-height:100vh;padding:28px 14px 48px;background:linear-gradient(180deg,#6ec4e8 0%,#9bd6ef 42%,#cfeef8 100%)}
    .suas-invoice-desk *{box-sizing:border-box}
    .suas-invoice-desk .toolbar{width:min(820px,100%);margin:0 auto 12px;display:flex;flex-wrap:wrap;gap:8px;align-items:center}
    .suas-invoice-desk .toolbar button,.suas-invoice-desk .gate-go{min-height:40px;padding:0 16px;border:2px solid #101010;border-radius:999px;background:var(--lime);color:#101010;font:900 11px/1 Tahoma,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;box-shadow:0 3px 0 #101010}
    .suas-invoice-desk .toolbar button.ghost{background:#fff}
    .suas-invoice-desk .toolbar button.is-mail{background:var(--hot)}
    .suas-invoice-desk .toolbar em{font:800 11px/1.3 Tahoma,Arial,sans-serif;font-style:normal;opacity:.7}
    .suas-invoice-desk .toolbar .mail-status{flex:1 1 100%;margin:0;font:800 12px/1.35 Tahoma,Arial,sans-serif}
    .suas-invoice-desk .inv-row{display:flex;gap:8px;align-items:stretch}
    .suas-invoice-desk .inv-row input{flex:1}
    .suas-invoice-desk .inv-row button{min-height:40px;padding:0 12px;border:2px solid #101010;background:#fff;font:900 11px/1 Tahoma,Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;white-space:nowrap}
    .suas-invoice-desk.is-view .toolbar .staff-only{display:none}
    .suas-invoice-desk.is-view input,.suas-invoice-desk.is-view select,.suas-invoice-desk.is-view textarea{border-color:transparent;background:transparent;pointer-events:none}
    .suas-invoice-desk .sheet{width:min(820px,100%);margin:0 auto;overflow:hidden;border:4px solid #101010;border-radius:32px;background:#0b1a36;box-shadow:8px 10px 0 #101010}
    .suas-invoice-desk .titlebar{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px;min-height:38px;padding:7px 12px;background:#101010;color:var(--lime)}
    .suas-invoice-desk .orb{width:16px;height:16px;border:2px solid #fff;border-radius:999px;background:radial-gradient(circle at 32% 28%,#fff 0 28%,#d9ff78 42%,#7adf3a 100%);box-shadow:0 0 0 1px #101010}
    .suas-invoice-desk .titlebar b{font:900 11px/1 Tahoma,Arial,sans-serif;letter-spacing:.18em;text-align:center}
    .suas-invoice-desk .winbtns{display:flex;gap:6px}
    .suas-invoice-desk .winbtns i{display:block;width:12px;height:12px;border:2px solid #fff;border-radius:999px;background:#ff5f57;font-style:normal;box-shadow:0 0 0 1px #101010}
    .suas-invoice-desk .winbtns i:nth-child(2){background:#febc2e}
    .suas-invoice-desk .winbtns i:nth-child(3){background:#28c840}
    .suas-invoice-desk .hero{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:end;padding:16px 22px 8px;color:#fff}
    .suas-invoice-desk h1{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(2.2rem,6vw,3.6rem);line-height:.86;font-weight:400;color:var(--lime);text-transform:uppercase}
    .suas-invoice-desk .hero p{margin:8px 0 0;font:800 12px/1.4 Tahoma,Arial,sans-serif;color:#f4ecd4;max-width:48ch}
    .suas-invoice-desk .mark{width:72px;height:72px;display:grid;place-items:center;border:3px solid #fff;border-radius:999px;background:var(--lime);color:var(--navy);font-family:'Casual Human',Futura,Arial,sans-serif;font-size:2.6rem;line-height:.8}
    .suas-invoice-desk .body{display:grid;gap:12px;padding:8px 16px 18px}
    .suas-invoice-desk .row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .suas-invoice-desk .win{border:2.5px solid #101010;background:var(--cream);box-shadow:4px 5px 0 #101010}
    .suas-invoice-desk .bar{display:flex;align-items:center;justify-content:space-between;min-height:28px;padding:5px 8px;color:#fff;font:900 10px/1 Tahoma,Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase}
    .suas-invoice-desk .bar span{display:flex;gap:4px}
    .suas-invoice-desk .bar i{width:10px;height:10px;border:1.5px solid #fff;border-radius:999px;background:#fff;font-style:normal}
    .suas-invoice-desk .pad{display:grid;gap:8px;padding:12px}
    .suas-invoice-desk label{display:grid;gap:4px;font:900 10px/1 Tahoma,Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase}
    .suas-invoice-desk input,.suas-invoice-desk select,.suas-invoice-desk textarea{width:100%;min-height:40px;border:2px solid #101010;background:#fff;padding:8px 10px;font:800 15px/1.2 Tahoma,Arial,sans-serif;color:#101010}
    .suas-invoice-desk textarea{min-height:72px;resize:vertical}
    .suas-invoice-desk .line{display:grid;grid-template-columns:1.4fr .6fr .5fr .6fr;gap:6px;align-items:end}
    .suas-invoice-desk .rules{border:2.5px solid #101010;background:var(--lime);box-shadow:4px 5px 0 #101010}
    .suas-invoice-desk .rules .pad{gap:10px}
    .suas-invoice-desk .rules h2{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(1.5rem,3.4vw,2.1rem);font-weight:400;line-height:.9;text-transform:lowercase}
    .suas-invoice-desk .rules ol{margin:0;padding:0 0 0 1.25rem;display:grid;gap:10px;font:800 14px/1.4 Tahoma,Arial,sans-serif}
    .suas-invoice-desk .pay{display:grid;grid-template-columns:1fr 1fr;gap:8px}
    .suas-invoice-desk .total{display:flex;justify-content:space-between;align-items:center;padding:10px 12px;border:2.5px solid #101010;background:#fff;box-shadow:3px 4px 0 #101010}
    .suas-invoice-desk .total.is-now{background:var(--hot)}
    .suas-invoice-desk .total.is-later{background:var(--blue)}
    .suas-invoice-desk .total.is-all{background:var(--lime);grid-column:1/-1}
    .suas-invoice-desk .total b{font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(1.2rem,2.6vw,1.7rem);font-weight:400;line-height:.9;text-transform:lowercase}
    .suas-invoice-desk .total strong{font:900 20px/1 Tahoma,Arial,sans-serif}
    .suas-invoice-desk .total small{display:block;margin-top:4px;font:800 10px/1.2 Tahoma,Arial,sans-serif;letter-spacing:.04em;text-transform:uppercase}
    .suas-invoice-desk .note{margin:0;font:800 11px/1.35 Tahoma,Arial,sans-serif}
    .suas-invoice-desk .foot{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:8px 16px 16px;color:#d9ff78;font:900 10px/1 Tahoma,Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}
    .suas-invoice-desk .gate-copy{margin:0;color:#f4ecd4;font:800 14px/1.45 Tahoma,Arial,sans-serif}
    @media(max-width:700px){.suas-invoice-desk .row,.suas-invoice-desk .line,.suas-invoice-desk .hero,.suas-invoice-desk .pay{grid-template-columns:1fr}.suas-invoice-desk .mark{width:56px;height:56px;font-size:2rem}}
    @media print{
      .suas-invoice-desk{background:#fff;padding:0}
      .suas-invoice-desk .toolbar,.suas-invoice-desk .mail-status{display:none!important}
      .suas-invoice-desk .sheet{width:100%;border-radius:0;box-shadow:none}
      .suas-invoice-desk input,.suas-invoice-desk select,.suas-invoice-desk textarea{border-color:transparent;background:transparent;padding-left:0}
    }
  </style>

  {% unless unlocked %}
    <article class="sheet">
      <div class="titlebar"><span class="orb" aria-hidden="true"></span><b>STAFF.LOCK</b><span class="winbtns" aria-hidden="true"><i></i><i></i><i></i></span></div>
      <header class="hero">
        <div>
          <h1>staff only.</h1>
          {% if pin == blank %}
            <p class="gate-copy">Set a Staff PIN on this section in the theme editor, then come back.</p>
          {% else %}
            <p class="gate-copy">Enter your PIN to open the party invoice. This page is not in the menu.</p>
          {% endif %}
        </div>
        <span class="mark" aria-hidden="true">S.</span>
      </header>
      <div class="body">
        <section class="win">
          <div class="bar" style="background:#101010">unlock<span aria-hidden="true"><i></i><i></i><i></i></span></div>
          <div class="pad">
            {% if pin != blank %}
              {% if pin_wrong %}
                <p class="note">That PIN did not match. Try again.</p>
              {% endif %}
              <form id="suas-invoice-gate" method="post" action="{{ routes.cart_url }}/update">
                <label>staff pin<input type="password" name="attributes[suas_staff_pin]" autocomplete="current-password" required></label>
                <input type="hidden" name="return_to" value="{{ page.url }}">
                <button class="gate-go" type="submit">open invoice</button>
              </form>
              <script>
                (function () {
                  var form = document.getElementById('suas-invoice-gate');
                  if (!form) return;
                  form.addEventListener('submit', function (event) {
                    event.preventDefault();
                    var pin = form.querySelector('input[type="password"]').value;
                    fetch('/cart/update.js', {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({ attributes: { suas_staff_pin: pin } })
                    }).then(function () { window.location = {{ page.url | json }}; });
                  });
                })();
              </script>
            {% endif %}
          </div>
        </section>
      </div>
      <div class="foot"><span>suas.os</span><span>not for customers</span></div>
    </article>
  {% else %}
  <div class="toolbar">
    {% unless customer_view %}
    <button type="button" class="is-mail" id="sendBtn">email invoice</button>
    <button type="button" class="ghost" id="clearBtn">clear fields</button>
    <form method="post" action="{{ routes.cart_url }}/update" style="margin:0" class="staff-only">
      <input type="hidden" name="attributes[suas_staff_pin]" value="">
      <input type="hidden" name="return_to" value="{{ page.url }}">
      <button type="submit" class="ghost">lock</button>
    </form>
    {% endunless %}
    <button type="button" id="printBtn">save as pdf</button>
    {% unless customer_view %}
    <em>email invoice copies a suas.os picture. gmail opens — click the message and press ctrl+v so the window is the email.</em>
    <p class="mail-status" id="mailStatus" hidden></p>
    {% else %}
    <em>your suas.os party invoice. pay the deposit to hold the date.</em>
    {% endunless %}
  </div>
  <article class="sheet" aria-label="SUAS party invoice">
    <div class="titlebar"><span class="orb" aria-hidden="true"></span><b>INVOICE.EXE</b><span class="winbtns" aria-hidden="true"><i></i><i></i><i></i></span></div>
    <header class="hero">
      <div>
        <h1>party invoice.</h1>
        <p>Private 90-minute Lab. The date is held when the 50% deposit is paid.</p>
      </div>
      <span class="mark" aria-hidden="true">S.</span>
    </header>
    <div class="body">
      <section class="rules" aria-label="party rules">
        <div class="bar" style="background:#101010">read this first<span aria-hidden="true"><i></i><i></i><i></i></span></div>
        <div class="pad">
          <h2>deposit + cancel rules.</h2>
          <ol>
            <li>A 50% deposit is due at booking. That payment holds your Lab date.</li>
            <li>The remaining balance is due 48 hours before the party begins.</li>
            <li>Cancellations within 72 hours of this invoice are refundable. After that, the deposit is non-refundable.</li>
            <li>Pay using the method listed below. Include the invoice number in the memo so we can match it.</li>
          </ol>
        </div>
      </section>
      <section class="win">
        <div class="bar" style="background:#5bb000">how to pay<span aria-hidden="true"><i></i><i></i><i></i></span></div>
        <div class="pad">
          <div class="row">
            <label>method
              <select id="payMethod">
                <option value="">Select</option>
                <option>Venmo</option>
                <option>Zelle</option>
                <option>Cash App</option>
                <option>Card / Shopify invoice</option>
              </select>
            </label>
            <label>send to / handle<input id="payHandle" placeholder="@suas or phone / email"></label>
          </div>
          <label>memo (auto from invoice #)<input id="payMemo" placeholder="invoice number"></label>
          <p class="note">Fill method and handle before you send. We do not mark the date held until the deposit lands.</p>
        </div>
      </section>
      <div class="row">
        <section class="win">
          <div class="bar" style="background:#d6c21a">bill to<span aria-hidden="true"><i></i><i></i><i></i></span></div>
          <div class="pad">
            <label>name<input id="name" autocomplete="name"></label>
            <label>email from booking<input id="email" type="email" placeholder="paste from the party email" required></label>
            <label>phone<input id="phone" type="tel"></label>
          </div>
        </section>
        <section class="win">
          <div class="bar" style="background:#e23d8a">file<span aria-hidden="true"><i></i><i></i><i></i></span></div>
          <div class="pad">
            <label>invoice # from booking
              <span class="inv-row">
                <input id="invoiceNo" placeholder="SUAS-YYYYMMDD-XXXX" autocomplete="off" spellcheck="false">
                {% unless customer_view %}<button type="button" id="pasteInvBtn">paste</button>{% endunless %}
              </span>
            </label>
            <label>issued<input id="issued" type="date"></label>
            <label>deposit due<input id="due" type="date"></label>
            <label>balance due<input id="balanceDue" type="date" readonly></label>
          </div>
        </section>
      </div>
      <section class="win">
        <div class="bar" style="background:#1e6ad4">the party<span aria-hidden="true"><i></i><i></i><i></i></span></div>
        <div class="pad">
          <div class="row">
            <label>event date<input id="eventDate" type="date"></label>
            <label>time<input id="time" placeholder="2:00 PM"></label>
          </div>
          <div class="row">
            <label>guests (max 14)<input id="guests" type="number" min="1" max="14" value="1"></label>
            <label>occasion<input id="occasion" placeholder="birthday / girls day"></label>
          </div>
          <div class="line">
            <label>package
              <select id="pack">
                <option value="65">Self-Guided Party Pack — $65/person</option>
                <option value="115" selected>Party Session — $115/guest</option>
                <option value="145">Deluxe Party — $145/person</option>
                <option value="165">Signature Collection — $165/person</option>
                <option value="50">Charm Bar Party — $50/person · 1 hour · Lab closed</option>
              </select>
            </label>
            <label>rate<input id="rate" readonly></label>
            <label>qty<input id="qty" readonly></label>
            <label>line<input id="line" readonly></label>
          </div>
          <label>charm bar add-on
            <select id="charmAddon">
              <option value="0">None</option>
              <option value="45">Charm Bar add-on — $45/person</option>
            </select>
          </label>
          <div class="row">
            <label>food<select id="food"><option>No</option><option>Yes</option></select></label>
            <label>cake<select id="cake"><option>No</option><option>Yes</option></select></label>
          </div>
          <label>notes<textarea id="notes" placeholder="allergies, playlist, extra time, whatever they asked."></textarea></label>
          <div class="pay">
            <div class="total is-now"><div><b>deposit due now</b><small>50% · holds the date</small></div><strong id="deposit">$0.00</strong></div>
            <div class="total is-later"><div><b>remaining</b><small>due 48 hours before start</small></div><strong id="remain">$0.00</strong></div>
            <div class="total is-all"><b>booking total</b><strong id="total">$0.00</strong></div>
          </div>
          <p class="note" id="durationNote">90 minutes. The Lab is closed to walk-ins for this slot. Cancellations within 72 hours of this invoice are refundable; after that, the deposit is non-refundable. SUAS · 188 W Franklin Blvd, Gastonia, NC 28052</p>
        </div>
      </section>
    </div>
    <div class="foot"><span>suas.os</span><span>shut up &amp; smell</span></div>
  </article>
  <script>
    (function () {
      var customerView = {{ section.settings.customer_view | json }};
      var dollarId = {{ suas_deposit_dollar | json }};
      var centId = {{ suas_deposit_cent | json }};
      var shopOrigin = {{ request.origin | json }};
      var ids = ['name','email','phone','invoiceNo','issued','due','balanceDue','eventDate','time','guests','occasion','pack','charmAddon','food','cake','notes','payMethod','payHandle','payMemo'];
      var guests = document.getElementById('guests');
      var pack = document.getElementById('pack');
      var rate = document.getElementById('rate');
      var qty = document.getElementById('qty');
      var line = document.getElementById('line');
      var total = document.getElementById('total');
      var deposit = document.getElementById('deposit');
      var remain = document.getElementById('remain');
      function money(n){ return '$' + (Math.max(0, Number(n) || 0)).toFixed(2); }
      function ymd(d){
        return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
      }
      function stamp(){
        var d = new Date();
        if (!document.getElementById('issued').value) document.getElementById('issued').value = ymd(d);
        if (!document.getElementById('due').value) document.getElementById('due').value = ymd(d);
      }
      function val(id){
        var el = document.getElementById(id);
        return el ? String(el.value || '').trim() : '';
      }
      function pickInvoice(text){
        var m = String(text || '').toUpperCase().match(/SUAS-\d{8}-[A-Z0-9]+/);
        return m ? m[0] : String(text || '').trim();
      }
      function packLabel(){
        var opt = pack.options[pack.selectedIndex];
        var text = opt ? opt.text : '';
        var addon = document.getElementById('charmAddon');
        if (addon && Number(addon.value) > 0 && Number(pack.value) !== 50) {
          text += ' + Charm Bar add-on $45/person';
        }
        return text;
      }
      function isCharmOnly(){ return Number(pack.value) === 50; }
      function durationLine(){
        if (isCharmOnly()) return '1 hour Charm Bar. The Lab is closed for that hour.';
        return '90 minutes. The Lab is closed to walk-ins for your slot.';
      }
      function decodePayload(raw){
        var s = String(raw || '').replace(/-/g,'+').replace(/_/g,'/');
        while (s.length % 4) s += '=';
        return JSON.parse(decodeURIComponent(escape(atob(s))));
      }
      function applyData(data){
        if (!data) return;
        if (data.number && !data.invoiceNo) data.invoiceNo = data.number;
        ids.forEach(function(id){ if (data[id] != null && document.getElementById(id)) document.getElementById(id).value = data[id]; });
      }
      function say(msg, ok){
        var status = document.getElementById('mailStatus');
        if (!status) return;
        status.hidden = false;
        status.textContent = msg;
        status.style.color = ok ? '#07162e' : '#7a1028';
      }
      function invoiceFileName(ext){
        var num = pickInvoice(val('invoiceNo')) || 'invoice';
        return 'SUAS-' + num.replace(/^SUAS-/i, '') + (ext || '.pdf');
      }
      function dash(v){ return v ? String(v) : '—'; }
      function roundRect(ctx, x, y, w, h, r){
        ctx.beginPath();
        ctx.moveTo(x + r, y);
        ctx.arcTo(x + w, y, x + w, y + h, r);
        ctx.arcTo(x + w, y + h, x, y + h, r);
        ctx.arcTo(x, y + h, x, y, r);
        ctx.arcTo(x, y, x + w, y, r);
        ctx.closePath();
      }
      function wrapText(ctx, text, maxW){
        var words = String(text || '').split(/\s+/);
        var lines = [];
        var line = '';
        words.forEach(function(word){
          var next = line ? line + ' ' + word : word;
          if (ctx.measureText(next).width > maxW && line) {
            lines.push(line);
            line = word;
          } else line = next;
        });
        if (line) lines.push(line);
        return lines;
      }
      function paintInvoice(){
        var W = 720, H = 900, dpr = 2;
        var canvas = document.createElement('canvas');
        canvas.width = W * dpr;
        canvas.height = H * dpr;
        var ctx = canvas.getContext('2d');
        ctx.scale(dpr, dpr);
        var num = pickInvoice(val('invoiceNo')) || '—';
        var pay = val('payMethod');
        var handle = val('payHandle');
        var payLine = pay ? (pay + (handle ? '  ' + handle : '')) : '—';
        var sky = ctx.createLinearGradient(0, 0, 0, H);
        sky.addColorStop(0, '#6ec4e8');
        sky.addColorStop(1, '#9bd6ef');
        ctx.fillStyle = sky;
        ctx.fillRect(0, 0, W, H);
        roundRect(ctx, 22, 22, 676, 856, 24);
        ctx.fillStyle = '#0b1a36';
        ctx.fill();
        ctx.lineWidth = 4;
        ctx.strokeStyle = '#101010';
        ctx.stroke();
        ctx.fillStyle = '#101010';
        ctx.fillRect(22, 22, 676, 38);
        ctx.fillStyle = '#d9ff78';
        ctx.font = '900 13px Tahoma, Arial, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('INVOICE.EXE', W / 2, 47);
        ctx.textAlign = 'left';
        ctx.font = '400 40px Tahoma, Arial, sans-serif';
        ctx.fillText('party invoice.', 42, 102);
        ctx.fillStyle = '#f4ecd4';
        ctx.font = '800 13px Tahoma, Arial, sans-serif';
        ctx.fillText(isCharmOnly() ? 'private 1-hour charm bar. deposit holds the date.' : 'private 90-minute lab. deposit holds the date.', 42, 124);
        ctx.beginPath();
        ctx.arc(652, 100, 26, 0, Math.PI * 2);
        ctx.fillStyle = '#d9ff78';
        ctx.fill();
        ctx.lineWidth = 3;
        ctx.strokeStyle = '#fff';
        ctx.stroke();
        ctx.fillStyle = '#07162e';
        ctx.font = '700 22px Tahoma, Arial, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('S.', 652, 108);
        ctx.textAlign = 'left';
        function panel(x, y, w, h, title, fill, head){
          ctx.fillStyle = fill;
          ctx.strokeStyle = '#101010';
          ctx.lineWidth = 2.5;
          ctx.fillRect(x, y, w, h);
          ctx.strokeRect(x, y, w, h);
          ctx.fillStyle = head;
          ctx.fillRect(x, y, w, 22);
          ctx.fillStyle = '#fff';
          ctx.font = '900 10px Tahoma, Arial, sans-serif';
          ctx.fillText(title.toUpperCase(), x + 10, y + 15);
        }
        function kv(x, y, label, value, maxW){
          ctx.fillStyle = 'rgba(16,16,16,.55)';
          ctx.font = '900 9px Tahoma, Arial, sans-serif';
          ctx.fillText(String(label).toUpperCase(), x, y);
          ctx.fillStyle = '#101010';
          ctx.font = '800 14px Tahoma, Arial, sans-serif';
          var lines = wrapText(ctx, dash(value), maxW);
          lines.forEach(function(line, i){ ctx.fillText(line, x, y + 16 + i * 16); });
          return y + 16 + lines.length * 16;
        }
        panel(42, 142, 636, 78, 'read this first', '#d9ff78', '#101010');
        ctx.fillStyle = '#101010';
        ctx.font = '800 13px Tahoma, Arial, sans-serif';
        wrapText(ctx, '50% deposit due now holds the date. remaining due 48 hours before start. cancel within 72 hours of this invoice: refundable. after that, no. memo ' + num + '.', 612).forEach(function(line, i){
          ctx.fillText(line, 54, 186 + i * 16);
        });
        panel(42, 232, 308, 128, 'bill to', '#f4ecd4', '#d6c21a');
        kv(54, 268, 'name', val('name'), 280);
        kv(54, 304, 'email', val('email'), 280);
        kv(54, 340, 'phone', val('phone'), 280);
        panel(362, 232, 316, 128, 'file', '#f4ecd4', '#e23d8a');
        kv(374, 268, 'invoice #', num, 288);
        kv(374, 304, 'issued', val('issued'), 288);
        kv(374, 340, 'deposit / balance', dash(val('due')) + '  /  ' + dash(val('balanceDue')), 288);
        panel(42, 372, 636, 72, 'how to pay', '#f4ecd4', '#5bb000');
        kv(54, 408, 'method', payLine, 360);
        kv(430, 408, 'memo', val('payMemo') || num, 230);
        panel(42, 456, 636, 352, 'the party', '#f4ecd4', '#1e6ad4');
        kv(54, 492, 'when', [val('eventDate'), val('time')].filter(Boolean).join('  ·  '), 600);
        kv(54, 528, 'guests / occasion', dash(val('guests') || '1') + ' guests' + (val('occasion') ? '  ·  ' + val('occasion') : ''), 600);
        kv(54, 564, 'package', packLabel(), 600);
        kv(54, 600, 'food / cake', dash(val('food')) + '  /  ' + dash(val('cake')), 600);
        function tot(x, y, w, label, amount, fill){
          ctx.fillStyle = fill;
          ctx.strokeStyle = '#101010';
          ctx.lineWidth = 2.5;
          ctx.fillRect(x, y, w, 48);
          ctx.strokeRect(x, y, w, 48);
          ctx.fillStyle = '#101010';
          ctx.font = '900 9px Tahoma, Arial, sans-serif';
          ctx.fillText(label.toUpperCase(), x + 10, y + 16);
          ctx.font = '800 16px Tahoma, Arial, sans-serif';
          ctx.textAlign = 'right';
          ctx.fillText(dash(amount), x + w - 10, y + 36);
          ctx.textAlign = 'left';
        }
        tot(54, 640, 196, 'deposit due now', deposit.textContent, '#ff9bc4');
        tot(262, 640, 196, 'remaining', remain.textContent, '#c9e7ff');
        tot(470, 640, 192, 'booking total', total.textContent, '#d9ff78');
        ctx.fillStyle = '#d9ff78';
        ctx.font = '900 11px Tahoma, Arial, sans-serif';
        ctx.fillText('SUAS.OS', 42, 848);
        ctx.textAlign = 'right';
        ctx.fillText('188 W FRANKLIN BLVD · GASTONIA', 678, 848);
        ctx.textAlign = 'left';
        return canvas;
      }
      function canvasPngBlob(){
        return new Promise(function(resolve, reject){
          paintInvoice().toBlob(function(blob){
            if (!blob) reject(new Error('png'));
            else resolve(blob);
          }, 'image/png');
        });
      }
      function loadJsPdf(){
        return new Promise(function(resolve, reject){
          if (window.jspdf && window.jspdf.jsPDF) { resolve(); return; }
          var s = document.createElement('script');
          s.src = 'https://cdn.jsdelivr.net/npm/jspdf@2.5.2/dist/jspdf.umd.min.js';
          s.onload = function(){ resolve(); };
          s.onerror = function(){ reject(new Error('pdf')); };
          document.head.appendChild(s);
        });
      }
      function makePdfBlob(){
        var filename = invoiceFileName('.pdf');
        var canvas = paintInvoice();
        return loadJsPdf().then(function(){
          var doc = new window.jspdf.jsPDF({ unit: 'pt', format: 'letter' });
          var img = canvas.toDataURL('image/png');
          var pageW = 612, margin = 16, w = pageW - margin * 2;
          var h = w * (canvas.height / canvas.width);
          doc.addImage(img, 'PNG', margin, margin, w, Math.min(h, 792 - margin * 2));
          var blob = doc.output('blob');
          blob.name = filename;
          return blob;
        });
      }
      function downloadBlob(blob, filename){
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = filename || 'SUAS-invoice.pdf';
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(function(){ URL.revokeObjectURL(url); }, 2000);
      }
      function esc(s){
        return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      }
      function prettyName(s){
        var t = String(s || '').trim().replace(/\s+/g, ' ');
        if (!t) return 'there';
        return t.split(' ').map(function(w){
          return w.charAt(0).toUpperCase() + w.slice(1).toLowerCase();
        }).join(' ');
      }
      function longDate(iso){
        if (!iso) return 'TBD';
        var p = String(iso).split('-');
        if (p.length !== 3) return iso;
        var months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
        return months[Number(p[1]) - 1] + ' ' + Number(p[2]) + ', ' + p[0];
      }
      function invoiceMail(){
        var to = val('email');
        var num = pickInvoice(val('invoiceNo'));
        if (!to || to.indexOf('@') < 1) {
          say('Paste the booking email in bill to, then send.');
          document.getElementById('email').focus();
          return null;
        }
        if (!num) {
          say('Paste the invoice number from the booking email.');
          document.getElementById('invoiceNo').focus();
          return null;
        }
        document.getElementById('invoiceNo').value = num;
        var who = prettyName(val('name'));
        var pay = val('payMethod');
        var handle = val('payHandle');
        var isCard = /card|shopify/i.test(pay);
        var payUrl = (function () {
          var cents = Math.round(Number(String(deposit.textContent || '0').replace(/[^0-9.]/g, '')) * 100);
          var dollars = Math.floor(cents / 100);
          var leftover = cents % 100;
          var parts = [];
          if (dollars && dollarId) parts.push(dollarId + ':' + dollars);
          if (leftover && centId) parts.push(centId + ':' + leftover);
          if (!parts.length) return '';
          return (shopOrigin || '') + '/cart/' + parts.join(',');
        })();
        var when = [longDate(val('eventDate')), val('time')].filter(Boolean).join(' at ');
        var occ = val('occasion');
        var guestsN = val('guests') || '1';
        var foodCake = (val('food') || 'No') + ' food / ' + (val('cake') || 'No') + ' cake';
        var payBlock;
        if (isCard) {
          payBlock = [
            'You chose card. Pay the ' + deposit.textContent + ' deposit at Shopify checkout to hold your date:',
            payUrl || 'I will send you a checkout link for the deposit.',
            'I will email a second Shopify invoice for the remaining ' + remain.textContent + ' when that balance is due (48 hours before the party).'
          ].join('\n');
        } else {
          payBlock = [
            'Please pay the deposit by ' + (pay || 'the method on your invoice') + (handle ? ' to ' + handle : '') + '.',
            'Put ' + num + ' in the memo so we can match it. Your date is held when the deposit lands.'
          ].join('\n');
        }
        var body = [
          'Hi ' + who + ',',
          '',
          'Thank you for booking a private Lab party with SUAS. Here is invoice ' + num + '.',
          '',
          when + ' · ' + guestsN + ' guests' + (occ ? ' · ' + occ : ''),
          packLabel(),
          durationLine() + ' Bringing: ' + foodCake + '.',
          '',
          'Booking total: ' + total.textContent,
          'Deposit due now (50%, holds your date): ' + deposit.textContent + ' · due ' + longDate(val('due')),
          'Remaining balance: ' + remain.textContent + ' · due 48 hours before the party (' + longDate(val('balanceDue')) + ')',
          '',
          payBlock,
          '',
          'Cancellations within 72 hours of this invoice are refundable. After that, the deposit is non-refundable.',
          '',
          'SUAS.OS',
          '188 W Franklin Blvd',
          'Gastonia, NC 28052'
        ].join('\n');
        return {
          to: to,
          subject: 'Your SUAS party invoice — ' + num,
          body: body,
          filename: invoiceFileName('.png')
        };
      }
      function openGmail(mail){
        window.open(
          'https://mail.google.com/mail/?view=cm&fs=1&to=' + encodeURIComponent(mail.to) +
          '&su=' + encodeURIComponent(mail.subject) +
          '&body=' + encodeURIComponent(mail.body),
          '_blank',
          'noopener'
        );
      }
      function copyInvoicePicture(png){
        if (!navigator.clipboard || !window.ClipboardItem) return Promise.reject();
        return navigator.clipboard.write([new ClipboardItem({ 'image/png': png })]);
      }
      function sendPdf(){
        var mail = invoiceMail();
        if (!mail) return;
        say('Painting the suas.os invoice as a picture…', true);
        canvasPngBlob().then(function(png){
          downloadBlob(png, mail.filename);
          return copyInvoicePicture(png).catch(function(){ return null; }).then(function(copied){
            openGmail(mail);
            if (copied === null) {
              say('Picture saved as ' + mail.filename + '. Drag it into the gmail window if paste is blocked.', true);
            } else {
              say('Picture copied. In gmail: click the message, press ctrl+v, then send to ' + mail.to + '.', true);
            }
          });
        }).catch(function(){
          openGmail(mail);
          say('Could not build the picture. Use save as pdf and attach that instead.', false);
        });
      }
      function calc(){
        var charmOnly = isCharmOnly();
        var max = 14;
        var n = Math.max(1, Math.min(max, Number(guests.value) || 1));
        guests.value = n;
        guests.max = String(max);
        var addonEl = document.getElementById('charmAddon');
        if (charmOnly && addonEl) addonEl.value = '0';
        if (addonEl) addonEl.disabled = charmOnly;
        var r = Number(pack.value) || 0;
        var addon = charmOnly ? 0 : (addonEl ? Number(addonEl.value) || 0 : 0);
        var full = (r + addon) * n;
        var half = Math.round(full * 50) / 100;
        rate.value = money(r + addon);
        qty.value = n;
        line.value = money(full);
        total.textContent = money(full);
        deposit.textContent = money(half);
        remain.textContent = money(full - half);
        var durationNote = document.getElementById('durationNote');
        if (durationNote) {
          durationNote.textContent = durationLine() + ' Cancellations within 72 hours of this invoice are refundable; after that, the deposit is non-refundable. SUAS · 188 W Franklin Blvd, Gastonia, NC 28052';
        }
        var event = document.getElementById('eventDate').value;
        if (event) {
          var when = new Date(event + 'T12:00:00');
          when.setDate(when.getDate() - 2);
          document.getElementById('balanceDue').value = ymd(when);
        }
        var memo = document.getElementById('payMemo');
        var num = pickInvoice(val('invoiceNo'));
        if (num && document.getElementById('invoiceNo')) document.getElementById('invoiceNo').value = num;
        if (memo && (!memo.value || /^SUAS-/i.test(memo.value))) memo.value = num;
      }
      function save(){
        if (customerView) return;
        var data = {};
        ids.forEach(function(id){ var el = document.getElementById(id); if (el) data[id] = el.value; });
        try { localStorage.setItem('suas-party-invoice', JSON.stringify(data)); } catch (e) {}
      }
      function load(){
        try {
          var data = JSON.parse(localStorage.getItem('suas-party-invoice') || '{}');
          applyData(data);
        } catch (e) {}
      }
      if (customerView) {
        try {
          var hash = window.location.hash.replace(/^#/, '');
          if (hash) applyData(decodePayload(hash));
        } catch (e) {}
      } else {
        stamp();
        load();
      }
      calc();
      document.querySelector('.suas-invoice-desk .sheet').addEventListener('input', function(){ calc(); save(); });
      document.querySelector('.suas-invoice-desk .sheet').addEventListener('change', function(){ calc(); save(); });
      var inv = document.getElementById('invoiceNo');
      if (inv) {
        inv.addEventListener('paste', function (event) {
          var text = (event.clipboardData || window.clipboardData).getData('text');
          var picked = pickInvoice(text);
          if (picked) {
            event.preventDefault();
            inv.value = picked;
            calc();
            save();
          }
        });
      }
      var pasteBtn = document.getElementById('pasteInvBtn');
      if (pasteBtn && navigator.clipboard && navigator.clipboard.readText) {
        pasteBtn.addEventListener('click', function () {
          navigator.clipboard.readText().then(function (text) {
            var picked = pickInvoice(text);
            if (!picked) { say('No SUAS invoice number on the clipboard.'); return; }
            inv.value = picked;
            calc();
            save();
            say('Invoice ' + picked + ' pasted.', true);
          }).catch(function () { say('Allow clipboard access, or paste with Ctrl+V in the invoice # box.'); });
        });
      }
      document.getElementById('printBtn').addEventListener('click', function(){
        say('Putting the invoice together as a pdf…', true);
        makePdfBlob().then(function(blob){
          downloadBlob(blob, invoiceFileName());
          say('PDF saved. That file is the whole invoice.', true);
        }).catch(function(){ window.print(); });
      });
      var sendBtn = document.getElementById('sendBtn');
      var clearBtn = document.getElementById('clearBtn');
      if (sendBtn) sendBtn.addEventListener('click', sendPdf);
      if (clearBtn) clearBtn.addEventListener('click', function(){
        ids.forEach(function(id){ var el = document.getElementById(id); if (el) el.value = ''; });
        guests.value = 1;
        pack.value = '115';
        var addonEl = document.getElementById('charmAddon');
        if (addonEl) addonEl.value = '0';
        document.getElementById('food').value = 'No';
        document.getElementById('cake').value = 'No';
        stamp();
        calc();
        save();
      });
    })();
  </script>
  {% endunless %}
</section>
{% schema %}
{
  "name": "SUAS Staff Invoice",
  "settings": [
    {
      "type": "text",
      "id": "staff_pin",
      "label": "Staff PIN",
      "info": "Required to open /pages/staff-invoice. Not listed in the menu. Do not share."
    },
    {
      "type": "checkbox",
      "id": "customer_view",
      "label": "Customer view",
      "default": false,
      "info": "No PIN. Fills from the emailed invoice link."
    }
  ]
}
{% endschema %}

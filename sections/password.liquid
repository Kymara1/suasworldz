<section class="suas-password-page" aria-label="Store password">
  <style>
    @font-face {
      font-family: 'Casual Human';
      src: url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');
      font-display: swap;
    }

    @font-face {
      font-family: 'Casual Human';
      src: url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');
      font-weight: 700;
      font-display: swap;
    }

    html,
    body,
    .template--password,
    .layout--main-content {
      min-height: 100%;
      margin: 0;
      background: #000 !important;
    }

    body.template--password #shopify-section-announcement,
    body.template--password #shopify-section-header,
    body.template--password #shopify-section-footer,
    body.template--password .announcement--root,
    body.template--password .header--root,
    body.template--password .site-header,
    body.template--password .footer--root,
    body.template--password footer {
      display: none !important;
    }

    .suas-password-page {
      min-height: 100vh;
      min-height: 100svh;
      display: grid;
      place-items: center;
      background: #000;
      color: #fff;
      padding: 26px;
      font-family: 'Casual Human', Futura, Arial, sans-serif;
    }

    .suas-password-inner {
      width: min(520px, 100%);
      display: grid;
      justify-items: center;
      text-align: center;
    }

    .suas-password-logo {
      width: clamp(92px, 11vw, 126px);
      height: clamp(92px, 11vw, 126px);
      object-fit: contain;
      margin-bottom: clamp(34px, 5vw, 56px);
      animation: suas-logo-breathe 5.8s ease-in-out infinite;
    }

    .suas-password-title {
      margin: 0;
      color: #fff;
      font-family: 'Casual Human', Futura, Arial, sans-serif;
      font-size: clamp(2.15rem, 4.8vw, 3.75rem);
      font-weight: 700;
      line-height: 0.95;
      letter-spacing: 0;
      text-transform: uppercase;
      white-space: nowrap;
      animation: suas-password-pulse 5.4s ease-in-out infinite;
    }

    .suas-password-prompt {
      margin: 20px 0 34px;
      color: #ffe8ef;
      font-family: 'Casual Human', Futura, Arial, sans-serif;
      font-weight: 700;
      font-size: clamp(1rem, 2.4vw, 1.55rem);
      line-height: 1;
      text-transform: uppercase;
      text-shadow: 0 0 12px rgba(255, 232, 239, 0.22);
    }

    @keyframes suas-password-pulse {
      0%,
      100% {
        opacity: 0.76;
      }
      50% {
        opacity: 1;
      }
    }

    @keyframes suas-logo-breathe {
      0%,
      100% {
        opacity: 0.78;
        transform: translateY(0) scale(0.98);
      }
      50% {
        opacity: 1;
        transform: translateY(-4px) scale(1);
      }
    }

    .suas-password-form {
      width: min(480px, 100%);
    }

    .suas-password-input {
      width: 100%;
      height: 58px;
      border: 2px solid #fff;
      border-radius: 999px;
      outline: 0;
      background: #000;
      color: #fff;
      padding: 0 26px;
      text-align: center;
      font-family: 'Casual Human', Futura, Arial, sans-serif;
      font-size: clamp(0.95rem, 2.2vw, 1.2rem);
      letter-spacing: 0;
      box-shadow: 0 0 28px rgba(255, 255, 255, 0.12);
    }

    .suas-password-input::placeholder {
      color: rgba(255, 255, 255, 0.56);
      opacity: 1;
      text-transform: uppercase;
    }

    .suas-password-button {
      width: 100%;
      height: 58px;
      margin-top: 12px;
      border: 0;
      border-radius: 999px;
      background: #fff;
      color: #000;
      font-family: 'Casual Human', Futura, Arial, sans-serif;
      font-size: clamp(0.95rem, 2vw, 1.18rem);
      line-height: 1;
      text-transform: uppercase;
      cursor: pointer;
      box-shadow: 0 0 34px rgba(255, 255, 255, 0.15);
      transition: background 160ms ease, transform 160ms ease;
    }

    .suas-password-button:hover {
      background: #ffe8ef;
      transform: translateY(-1px);
    }

    .suas-password-error {
      margin: 0 0 18px;
      color: #ffe8ef;
      font-family: Futura, 'Futura PT', Arial, sans-serif;
      font-size: 13px;
      line-height: 1.4;
    }

    .suas-password-label {
      display: block;
      height: 1px;
      width: 1px;
      overflow: hidden;
      clip: rect(1px, 1px, 1px, 1px);
      white-space: nowrap;
    }

    @media (max-width: 560px) {
      .suas-password-page {
        padding: 22px;
      }

      .suas-password-logo {
        margin-bottom: 32px;
      }

      .suas-password-title {
        white-space: normal;
      }

      .suas-password-prompt {
        margin-bottom: 34px;
      }

      .suas-password-input,
      .suas-password-button {
        height: 54px;
      }
    }
  </style>

  <div class="suas-password-inner">
    <img class="suas-password-logo" src="{{ 'suas-logo.png' | asset_url }}" alt="{{ shop.name | escape }}">
    <h1 class="suas-password-title">SUAS 2.0 IS LOADING</h1>
    <p class="suas-password-prompt">ENTER THE PASSWORD &#9825;</p>

    <div class="suas-password-form">
      {% form 'storefront_password', id: 'password_form' %}
        {% if form.errors %}
          <div class="suas-password-error">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <label class="suas-password-label" for="password">Password</label>
        <input
          class="suas-password-input"
          type="password"
          id="password"
          name="password"
          placeholder="PASSWORD"
          autocomplete="current-password"
        >
        <button class="suas-password-button" type="submit">ENTER &#10022;</button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": []
}
{% endschema %}

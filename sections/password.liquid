{%- liquid
  assign login_button_t = "general.password.login_button" | t
-%}

<section class="suas-password-page" aria-label="Store password">
  <style>
    @font-face {
      font-family: 'Casual Human';
      src: url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');
      font-display: swap;
    }

    html,
    body,
    .template--password,
    .layout--main-content {
      min-height: 100%;
      margin: 0;
      background: #000 !important;
    }

    .suas-password-page {
      min-height: 100vh;
      min-height: 100svh;
      display: grid;
      place-items: center;
      background: #000;
      color: #fff;
      padding: 28px;
      font-family: Futura, 'Futura PT', Arial, sans-serif;
    }

    .suas-password-inner {
      width: min(680px, 100%);
      display: grid;
      justify-items: center;
      gap: 28px;
      text-align: center;
    }

    .suas-password-title {
      margin: 0;
      color: #fff;
      font-family: 'Casual Human', Futura, Arial, sans-serif;
      font-size: clamp(4.5rem, 16vw, 12rem);
      font-weight: 400;
      line-height: 0.82;
      letter-spacing: 0;
      animation: suas-password-pulse 4.8s ease-in-out infinite;
    }

    @keyframes suas-password-pulse {
      0%,
      100% {
        opacity: 0.42;
        filter: blur(0.2px);
      }
      50% {
        opacity: 1;
        filter: blur(0);
      }
    }

    .suas-password-form {
      width: min(520px, 100%);
    }

    .suas-password-pill {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 10px;
      min-height: 58px;
      border: 2px solid #fff;
      border-radius: 999px;
      background: #fff;
      padding: 7px 8px 7px 22px;
      box-shadow: 0 0 38px rgba(255, 255, 255, 0.16);
    }

    .suas-password-pill input {
      width: 100%;
      min-width: 0;
      border: 0;
      outline: 0;
      background: transparent;
      color: #000;
      font: 700 16px/1 Futura, 'Futura PT', Arial, sans-serif;
      letter-spacing: 0;
    }

    .suas-password-pill input::placeholder {
      color: rgba(0, 0, 0, 0.48);
      opacity: 1;
    }

    .suas-password-pill button {
      min-height: 42px;
      border: 0;
      border-radius: 999px;
      background: #000;
      color: #fff;
      padding: 0 18px;
      font: 800 13px/1 Futura, 'Futura PT', Arial, sans-serif;
      text-transform: lowercase;
      cursor: pointer;
    }

    .suas-password-pill button:hover {
      background: #ffe8ef;
      color: #000;
    }

    .suas-password-error {
      margin: 0 0 14px;
      color: #ffe8ef;
      font: 700 13px/1.4 Futura, 'Futura PT', Arial, sans-serif;
    }

    .suas-password-label {
      display: block;
      height: 1px;
      width: 1px;
      overflow: hidden;
      clip: rect(1px, 1px, 1px, 1px);
      white-space: nowrap;
    }

    @media (max-width: 520px) {
      .suas-password-inner {
        gap: 22px;
      }

      .suas-password-pill {
        grid-template-columns: 1fr;
        border-radius: 28px;
        padding: 16px;
      }

      .suas-password-pill input {
        text-align: center;
      }

      .suas-password-pill button {
        width: 100%;
      }
    }
  </style>

  <div class="suas-password-inner">
    <h1 class="suas-password-title">Suas 2.0</h1>

    <div class="suas-password-form">
      {% form 'storefront_password', id: 'password_form' %}
        {% if form.errors %}
          <div class="suas-password-error">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <label class="suas-password-label" for="password">Password</label>
        <div class="suas-password-pill">
          <input
            type="password"
            id="password"
            name="password"
            placeholder="password"
            autocomplete="current-password"
          >
          <button type="submit">{{ login_button_t | default: 'enter' }}</button>
        </div>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": []
}
{% endschema %}

{% render 'suas-os-account-styles' %}
<section class="suas-os-account" aria-label="Reset password">
  <div class="suas-os-wrap">
    {% render 'suas-os-account-mark' %}
    <article class="suas-os-win">
      <div class="suas-os-winbar">
        <div class="suas-os-dots">
          <span class="suas-os-dot" style="--dot:#ff5f57"></span>
          <span class="suas-os-dot" style="--dot:#febc2e"></span>
          <span class="suas-os-dot" style="--dot:#28c840"></span>
        </div>
        <span class="suas-os-wintitle suas-mono">ACCOUNT.RESET</span>
        <span class="suas-os-live suas-mono"><b></b>SECURE</span>
      </div>
      <div class="suas-os-body">
        <p class="suas-os-kicker">suas.os / security</p>
        <h1 class="suas-os-title suas-font">new password.</h1>
        <p class="suas-os-copy">pick something you’ll remember when you’re in the Lab.</p>
        {% form 'reset_customer_password' %}
          <div class="suas-os-errors">{{ form.errors | default_errors }}</div>
          <div class="suas-os-form">
            <div class="suas-os-field"><label for="customer_password">password</label><input id="customer_password" type="password" name="customer[password]" autocomplete="new-password" required></div>
            <div class="suas-os-field"><label for="customer_password_confirmation">confirm password</label><input id="customer_password_confirmation" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
            <button class="suas-os-btn is-dark" type="submit">save password</button>
          </div>
        {% endform %}
      </div>
    </article>
  </div>
</section>

<section id="suas-reviews" class="suas-reviews" data-suas-skip-local-form aria-label="SUAS smell reports">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}
    .suas-reviews{--ink:#101010;--paper:#fbfaf7;--pink:#ffd8e8;--hot:#ff9bc4;--blue:#cdeeff;--lime:#d9ff78;--yellow:#fff1a8;--lav:#e4d5ff;color:var(--ink);background:linear-gradient(rgba(16,16,16,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.035) 1px,transparent 1px),radial-gradient(circle at 10% 8%,rgba(255,216,232,.7),transparent 28%),radial-gradient(circle at 92% 18%,rgba(217,255,120,.34),transparent 26%),var(--paper);background-size:22px 22px,22px 22px,auto,auto,auto;font-family:Futura,'Futura PT',Arial,sans-serif;overflow:visible;padding:8px 0 36px}
    .suas-reviews *{box-sizing:border-box}
    .suas-reviews a{color:inherit}
    .suas-reviews-wrap{width:min(1180px,calc(100vw - 24px));margin:0 auto;display:grid;gap:14px}
    .suas-rev-win{border:2px solid var(--ink);border-radius:26px;background:rgba(255,255,255,.94);box-shadow:6px 7px 0 var(--ink);overflow:hidden}
    .suas-rev-bar{display:flex;align-items:center;gap:7px;min-height:38px;padding:8px 13px;border-bottom:2px solid var(--ink);background:linear-gradient(180deg,#fff,#edf0f5)}
    .suas-rev-dot{width:10px;height:10px;border-radius:999px;background:var(--dot)}
    .suas-rev-chip{margin-left:auto;padding:6px 10px;border:1.5px solid var(--ink);border-radius:999px;background:var(--yellow);box-shadow:0 2px 0 var(--ink);font:900 8px/1 Futura,Arial,sans-serif;letter-spacing:.13em;text-transform:uppercase}
    .suas-rev-hero{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(220px,.8fr);gap:16px;padding:clamp(16px,2.4vw,26px);background:radial-gradient(circle at 12% 20%,rgba(255,216,232,.9),transparent 42%),radial-gradient(circle at 88% 80%,rgba(205,238,255,.7),transparent 38%),#fff}
    .suas-rev-hero h1{margin:0 0 8px;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(2.6rem,7vw,4.8rem);line-height:.82;text-transform:lowercase;font-weight:400}
    .suas-rev-hero p{margin:0 0 16px;max-width:42ch;font-size:14px;font-weight:800;line-height:1.4}
    .suas-rev-actions{display:flex;flex-wrap:wrap;gap:8px}
    .suas-rev-btn{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:10px 16px;border:2px solid var(--ink);border-radius:999px;background:var(--pink);box-shadow:0 4px 0 var(--ink);text-decoration:none;font:900 10px/1 Futura,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;color:var(--ink)}
    .suas-rev-btn[data-lime]{background:var(--lime)}
    .suas-rev-btn:hover{color:var(--ink);transform:translateY(2px);box-shadow:0 2px 0 var(--ink)}
    .suas-rev-side{display:grid;gap:8px;align-content:start}
    .suas-rev-stat{padding:14px 12px;border:2px solid var(--ink);border-radius:18px;background:var(--lime);box-shadow:3px 4px 0 var(--ink)}
    .suas-rev-stat b{display:block;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:1.8rem;line-height:.9;font-weight:400;text-transform:lowercase}
    .suas-rev-stat span{display:block;margin-top:4px;font-size:9px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}
    .suas-rev-steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;padding:14px}
    .suas-rev-step{min-height:120px;padding:14px;border:2px solid var(--ink);border-radius:20px;box-shadow:3px 4px 0 var(--ink)}
    .suas-rev-step:nth-child(1){background:var(--pink)}
    .suas-rev-step:nth-child(2){background:var(--lime)}
    .suas-rev-step:nth-child(3){background:var(--blue)}
    .suas-rev-step em{display:block;margin-bottom:8px;font-style:normal;font-size:10px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}
    .suas-rev-step strong{display:block;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(1.35rem,3vw,1.9rem);line-height:.88;font-weight:400;text-transform:lowercase}
    .suas-rev-body{padding:14px}
    .suas-rev-launch{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
    .suas-rev-product{display:grid;grid-template-rows:auto 1fr auto;gap:8px;min-width:0;padding:10px;border:2px solid var(--ink);border-radius:20px;background:#fff;box-shadow:3px 4px 0 var(--ink);text-decoration:none;color:var(--ink)}
    .suas-rev-product:nth-child(3n+1){background:#fff6fb}
    .suas-rev-product:nth-child(3n+2){background:#f4ffe8}
    .suas-rev-product:nth-child(3n){background:#f3fbff}
    .suas-rev-product img,.suas-rev-fallback{width:100%;aspect-ratio:1;object-fit:contain;border:1.5px solid var(--ink);border-radius:14px;background:#fff}
    .suas-rev-fallback{display:grid;place-items:center;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:2rem}
    .suas-rev-product b{font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(1.05rem,2.2vw,1.35rem);line-height:.9;font-weight:400;text-transform:lowercase}
    .suas-rev-product span{font-size:9px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}
    .suas-rev-feed{padding:14px;min-height:220px}
    .suas-rev-empty{padding:28px 16px;border:2px solid var(--ink);border-radius:22px;background:radial-gradient(circle at 16% 18%,rgba(255,216,232,.9),transparent 46%),#fff7fb;box-shadow:4px 5px 0 var(--ink);text-align:center}
    .suas-rev-empty[hidden]{display:none!important}
    .suas-rev-empty h3{margin:0 0 8px;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(1.8rem,4.6vw,2.8rem);line-height:.88;font-weight:400;text-transform:lowercase}
    .suas-rev-empty p{margin:0 auto 14px;max-width:36ch;font-size:13px;font-weight:800;line-height:1.4}
    .suas-rev-feed .jdgm-widget{width:100%;min-height:0}
    .suas-rev-feed .jdgm-all-reviews-widget,
    .suas-rev-feed .jdgm-all-reviews-widget-v2025{border:0!important;background:transparent!important}
    .suas-rev-feed .jdgm-rev{border:2px solid var(--ink)!important;border-radius:18px!important;background:#fff1a8!important;box-shadow:3px 4px 0 var(--ink)!important;padding:14px!important;color:var(--ink)!important;margin:0 0 12px!important}
    .suas-rev-feed :is(.jdgm-write-rev-link,.jdgm-btn){min-height:42px!important;border:2px solid var(--ink)!important;border-radius:999px!important;background:var(--pink)!important;color:var(--ink)!important;box-shadow:0 4px 0 var(--ink)!important;font:900 10px/1 Futura,Arial,sans-serif!important;letter-spacing:.12em!important;text-transform:uppercase!important;text-decoration:none!important}
    .suas-rev-feed :is(.jdgm-powered,.jdgm-branding,a[href*='://judge.me'],a[href*='judgeme.com']){display:none!important}
    @media(max-width:820px){
      .suas-rev-hero,.suas-rev-steps,.suas-rev-launch{grid-template-columns:1fr}
      .suas-rev-actions,.suas-rev-btn{width:100%}
    }
    @media(max-width:560px){
      .suas-reviews-wrap{width:calc(100vw - 14px)}
      .suas-rev-win{border-radius:18px;box-shadow:4px 5px 0 var(--ink)}
      .suas-rev-launch{grid-template-columns:repeat(2,minmax(0,1fr))}
    }
  </style>
  {% liquid
    assign launch = collections['best-sellers']
    if launch == blank or launch.products_count == 0
      assign launch = collections['new-arrivals']
    endif
    if launch == blank or launch.products_count == 0
      assign launch = collections['butter-creme']
    endif
  %}
  <div class="suas-reviews-wrap">
    <div class="suas-rev-win">
      <div class="suas-rev-bar">
        <span class="suas-rev-dot" style="--dot:#ff5f57"></span>
        <span class="suas-rev-dot" style="--dot:#febc2e"></span>
        <span class="suas-rev-dot" style="--dot:#28c840"></span>
        <span class="suas-rev-chip">smell.log / live</span>
      </div>
      <div class="suas-rev-hero">
        <div>
          <h1>every smell report.</h1>
          <p>This page is the feed. To leave a review, pick the product you used. The form lives on that product page.</p>
          <div class="suas-rev-actions">
            <button class="suas-rev-btn" type="button" data-suas-review-open-picker>review a product</button>
            <a class="suas-rev-btn" data-lime href="#suas-live-feed">all reviews</a>
          </div>
        </div>
        <div class="suas-rev-side">
          <div class="suas-rev-stat"><b>pick a scent</b><span>then write how it wore</span></div>
          <div class="suas-rev-stat" style="background:var(--blue)"><b>keep it honest</b><span>pretty, weird, all of it</span></div>
        </div>
      </div>
    </div>

    <div class="suas-rev-win">
      <div class="suas-rev-bar">
        <span class="suas-rev-dot" style="--dot:#ff5f57"></span>
        <span class="suas-rev-dot" style="--dot:#febc2e"></span>
        <span class="suas-rev-dot" style="--dot:#28c840"></span>
        <span class="suas-rev-chip">how it works</span>
      </div>
      <div class="suas-rev-steps">
        <article class="suas-rev-step"><em>01</em><strong>pick the product you actually used.</strong></article>
        <article class="suas-rev-step"><em>02</em><strong>say how it smelled on you, not the bottle.</strong></article>
        <article class="suas-rev-step"><em>03</em><strong>it posts for the next person shopping.</strong></article>
      </div>
    </div>

    <div class="suas-rev-win">
      <div class="suas-rev-bar">
        <span class="suas-rev-dot" style="--dot:#ff5f57"></span>
        <span class="suas-rev-dot" style="--dot:#febc2e"></span>
        <span class="suas-rev-dot" style="--dot:#28c840"></span>
        <span class="suas-rev-chip">start here</span>
      </div>
      <div class="suas-rev-body">
        <div class="suas-rev-launch">
          {% if launch != blank and launch.products_count > 0 %}
            {% for product in launch.products limit: 6 %}
              <a class="suas-rev-product" href="{{ product.url }}?showWriteReviews=true#suas-simple-review">
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: product.title }}
                {% else %}
                  <div class="suas-rev-fallback">s.</div>
                {% endif %}
                <b>{{ product.title | split: '✿' | first | strip }}</b>
                {% render 'product-rating', product: product %}
                <span>write this report →</span>
              </a>
            {% endfor %}
          {% else %}
            <button class="suas-rev-btn" type="button" data-suas-review-open-picker>search every product</button>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="suas-rev-win" id="suas-live-feed">
      <div class="suas-rev-bar">
        <span class="suas-rev-dot" style="--dot:#ff5f57"></span>
        <span class="suas-rev-dot" style="--dot:#febc2e"></span>
        <span class="suas-rev-dot" style="--dot:#28c840"></span>
        <span class="suas-rev-chip">live feed</span>
      </div>
      <div class="suas-rev-feed" data-suas-real-feed>
        <div class="suas-rev-empty" data-suas-feed-empty>
          <h3>waiting on real notes.</h3>
          <p>When a customer review goes live, it shows up here.</p>
          <button class="suas-rev-btn" type="button" data-suas-review-open-picker>be first</button>
        </div>
        {% assign has_legacy_all = false %}
        {% if shop.metafields.judgeme.all_reviews_header.size > 20 %}{% assign has_legacy_all = true %}{% endif %}
        <div id="judgeme_all_reviews_page" class="jdgm-widget jdgm-all-reviews-widget-v2025" data-widget="all-reviews-v2025" data-auto-install="false" data-entry-point="all_reviews_widget_v2025.js" data-entry-key="all-reviews-widget-v2025/main.js">
          {% if has_legacy_all %}
            <div class="jdgm-legacy-widget-content" style="display:none;">
              <article class="jdgm-widget jdgm-all-reviews-widget">
                {{ shop.metafields.judgeme.all_reviews_header }}
                <div class="jdgm-all-reviews__body">
                  {% assign prefix = 'all_reviews_' %}
                  {% for count in (0..200) %}
                    {% assign metafield_key = prefix | append: count %}
                    {% assign current_metafield = shop.metafields.judgeme[metafield_key] %}
                    {% unless current_metafield %}{% break %}{% endunless %}
                    {{ current_metafield }}
                  {% endfor %}
                </div>
              </article>
            </div>
          {% endif %}
        </div>
        {% if shop.metafields.judgeme.all_reviews_widget_v2025_data %}
          <script>window.jdgm=window.jdgm||{};jdgm.data=jdgm.data||{};jdgm.data.allReviewsWidgetV2025={{ shop.metafields.judgeme.all_reviews_widget_v2025_data }};</script>
        {% endif %}
      </div>
    </div>
  </div>
  {% render 'suas-review-product-picker' %}
  <script>
    (function () {
      var slot = document.querySelector('[data-suas-real-feed]');
      var empty = document.querySelector('[data-suas-feed-empty]');
      if (!slot) return;
      function grab() {
        var node = document.getElementById('judgeme_all_reviews_page') || document.querySelector('.jdgm-all-reviews-widget-v2025, .jdgm-all-reviews-widget');
        if (!node || slot.contains(node)) return node;
        slot.appendChild(node);
        return node;
      }
      function hasReviews(node) {
        if (!node) return false;
        var text = (node.innerText || '').replace(/\s+/g, ' ').toLowerCase();
        if (!text || /no reviews yet|be the first to write/.test(text)) return false;
        return node.querySelectorAll('.jdgm-rev, article, [class*="review-card"]').length > 0 || text.length > 90;
      }
      function sync() {
        var node = grab();
        if (empty) empty.hidden = hasReviews(node);
      }
      sync();
      var ticks = 0;
      var timer = setInterval(function () {
        sync();
        if (++ticks > 24) clearInterval(timer);
      }, 500);
    })();
  </script>
</section>
{% schema %}{"name":"SUAS reviews","settings":[{"type":"text","id":"heading","label":"Heading","default":"reviews from real ones."}],"presets":[{"name":"SUAS reviews"}]}{% endschema %}

<section id="suas-reviews" class="suas-reviews" data-suas-review-form-ready="true" aria-label="SUAS reviews chat">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}@font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}
    .suas-reviews{--ink:#101010;--paper:#fbfaf7;--pink:#ffd8e8;--blue:#cdeeff;--lime:#d9ff78;--yellow:#fff1a8;--lav:#e4d5ff;color:var(--ink);background:radial-gradient(circle at 12% 12%,rgba(255,216,232,.52),transparent 28%),radial-gradient(circle at 88% 76%,rgba(217,255,120,.26),transparent 30%),var(--paper);font-family:Futura,'Futura PT',Arial,sans-serif;overflow:hidden}.suas-reviews *{box-sizing:border-box}.suas-reviews-wrap{width:min(1120px,calc(100vw - 24px));margin:0 auto;padding:clamp(22px,3.2vw,38px) 0}.suas-reviews-head{text-align:center;margin-bottom:14px}.suas-reviews-head p{display:none}.suas-reviews-head h2{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:clamp(2rem,4vw,3.35rem);font-weight:400!important;line-height:.9;letter-spacing:0;text-transform:lowercase}.suas-chat-shell{display:grid;grid-template-columns:minmax(0,1fr) minmax(230px,286px);gap:18px;align-items:start}.suas-chat-window{border:2px solid var(--ink);border-radius:24px;background:rgba(255,255,255,.95);box-shadow:5px 6px 0 var(--ink);overflow:hidden}.suas-chat-bar{display:flex;align-items:center;gap:7px;min-height:34px;padding:7px 12px;border-bottom:1.5px solid rgba(16,16,16,.16);background:linear-gradient(180deg,#fff,#edf0f5)}.suas-chat-dot{width:10px;height:10px;border-radius:999px;background:var(--dot);flex:0 0 auto}.suas-chat-title{margin-left:auto;padding:6px 9px;border:1.5px solid var(--ink);border-radius:999px;background:var(--yellow);box-shadow:0 2px 0 var(--ink);font:900 8px/1 Futura,Arial,sans-serif;letter-spacing:.13em;text-transform:uppercase;color:var(--ink)}.suas-chat-filters{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;padding:10px 12px;border-bottom:1.5px solid rgba(16,16,16,.16);background:rgba(255,255,255,.8)}.suas-chat-filters label{display:grid;gap:4px;font:900 7px/1 Futura,Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:rgba(16,16,16,.55)}.suas-chat-filters select{width:100%;min-height:31px;border:1.5px solid var(--ink);border-radius:999px;background:#fff;color:var(--ink);padding:5px 9px;font:900 10px/1 Futura,Arial,sans-serif;text-transform:uppercase}.suas-chat-feed{height:560px;overflow-y:auto;padding:18px 16px 22px;display:flex!important;flex-direction:column!important;gap:16px!important;scroll-behavior:smooth;background:linear-gradient(rgba(16,16,16,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.025) 1px,transparent 1px),#fff;background-size:18px 18px}.suas-chat-feed::-webkit-scrollbar{width:10px}.suas-chat-feed::-webkit-scrollbar-thumb{border:2px solid #fff;border-radius:999px;background:#101010}.suas-chat-message{all:unset;display:flex!important;width:100%;cursor:pointer;color:var(--ink)}.suas-chat-message:nth-child(even){justify-content:flex-end}.suas-chat-bubble{width:min(82%,560px);min-width:250px;border:2px solid var(--ink);border-radius:22px 22px 22px 8px;background:var(--tone);box-shadow:4px 5px 0 var(--ink);padding:13px 14px;color:var(--ink);font-weight:800;font-size:13px;line-height:1.38;transition:transform 160ms ease,box-shadow 160ms ease}.suas-chat-message:nth-child(even) .suas-chat-bubble{border-radius:22px 22px 8px 22px;background:linear-gradient(135deg,var(--tone),#fff 175%)}.suas-chat-message:hover .suas-chat-bubble,.suas-chat-message.is-selected .suas-chat-bubble{transform:translateY(-2px);box-shadow:5px 7px 0 var(--ink)}.suas-chat-meta{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-bottom:8px}.suas-chat-name{font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:1.05rem;line-height:.9;text-transform:lowercase;color:var(--ink);letter-spacing:0}.suas-chat-pill,.suas-chat-type{display:inline-flex;align-items:center;min-height:20px;padding:4px 8px;border:1.5px solid var(--ink);border-radius:999px;background:#fff;box-shadow:0 2px 0 var(--ink);font:900 8px/1 Futura,Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:var(--ink)}.suas-chat-type{border-color:rgba(16,16,16,.18);box-shadow:none;opacity:.72}.suas-chat-bubble strong{display:block;margin-bottom:5px;font-size:11px;letter-spacing:.05em;text-transform:uppercase}.suas-chat-actions{display:flex;gap:8px;align-items:center;margin-top:10px}.suas-like-button{border:1.5px solid var(--ink);border-radius:999px;background:#fff;color:var(--ink);padding:6px 9px;box-shadow:0 2px 0 var(--ink);font:900 8px/1 Futura,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase;cursor:pointer}.suas-like-button.is-liked{background:var(--lime)}.suas-review-empty{display:none;place-items:center;min-height:180px;border:1.5px dashed rgba(16,16,16,.24);border-radius:18px;background:rgba(255,255,255,.72);font:900 10px/1.3 Futura,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:rgba(16,16,16,.52)}.suas-chat-feed.is-empty .suas-review-empty{display:grid}.suas-review-form-card{border:2px solid var(--ink);border-radius:22px;background:linear-gradient(140deg,#fff 0%,var(--pink) 150%);box-shadow:5px 6px 0 var(--ink);padding:14px}.suas-review-form-card h3{margin:0 0 12px;font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:clamp(1.45rem,2.5vw,2rem);font-weight:400!important;line-height:.92;text-transform:lowercase}.suas-review-form-card label,.suas-review-rating-label{display:grid;gap:5px;margin-bottom:9px;font:900 8px/1 Futura,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:rgba(16,16,16,.58)}.suas-review-form-card input,.suas-review-form-card select,.suas-review-form-card textarea{width:100%;min-height:36px;border:1.5px solid rgba(16,16,16,.28);border-radius:13px;background:#fff;padding:8px 10px;color:var(--ink);font:800 12px/1.25 Futura,Arial,sans-serif}.suas-review-form-card textarea{min-height:96px;resize:vertical}.suas-review-stars{display:grid;grid-template-columns:repeat(5,1fr);gap:5px}.suas-review-stars input{position:absolute;opacity:0;pointer-events:none}.suas-review-stars span{display:grid;place-items:center;min-height:34px;border:1.5px solid var(--ink);border-radius:999px;background:#fff;box-shadow:0 2px 0 var(--ink);font:900 14px/1 Futura,Arial,sans-serif;color:var(--ink);cursor:pointer}.suas-review-stars input:checked+span,.suas-review-stars label:hover span{background:var(--lime)}.suas-review-submit-button{width:100%;min-height:39px;margin-top:5px;border:2px solid var(--ink);border-radius:999px;background:var(--lime);color:var(--ink);box-shadow:0 4px 0 var(--ink);font:900 9px/1 Futura,Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase;cursor:pointer}.suas-review-save-note{margin:9px 0 0;font:800 9px/1.3 Futura,Arial,sans-serif;color:rgba(16,16,16,.52)}.suas-review-modal{position:fixed;inset:0;z-index:9999;display:none;align-items:center;justify-content:center;padding:18px;background:rgba(16,16,16,.42);backdrop-filter:blur(3px)}.suas-review-modal.is-open{display:flex}.suas-review-modal-card{width:min(520px,100%);border:2px solid var(--ink);border-radius:24px;background:var(--modal-tone,#ffd8e8);box-shadow:7px 8px 0 var(--ink);padding:18px;color:var(--ink)}.suas-review-modal-top{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;margin-bottom:10px}.suas-review-modal h3{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:clamp(1.8rem,6vw,2.8rem);font-weight:400;line-height:.9;text-transform:lowercase}.suas-review-modal-close{border:2px solid var(--ink);border-radius:999px;background:#fff;width:34px;height:34px;box-shadow:0 3px 0 var(--ink);font:900 16px/1 Futura,Arial,sans-serif;cursor:pointer}.suas-review-modal-product{margin:6px 0 10px;font:900 11px/1.3 Futura,Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase}.suas-review-modal-message{margin:0 0 14px;font:800 16px/1.4 Futura,Arial,sans-serif}.suas-review-widget{display:none}@media(max-width:860px){.suas-chat-shell{grid-template-columns:1fr;gap:13px}.suas-chat-feed{height:500px;padding:14px;gap:13px!important}.suas-chat-bubble{width:min(90%,520px);min-width:0}.suas-review-form-card{border-radius:21px;box-shadow:4px 5px 0 var(--ink)}}@media(max-width:520px){.suas-reviews-wrap{width:min(390px,calc(100vw - 14px));padding:20px 0}.suas-reviews-head h2{font-size:clamp(1.9rem,10vw,3rem)}.suas-chat-window{border-radius:19px;box-shadow:4px 5px 0 var(--ink)}.suas-chat-title{font-size:6.5px;letter-spacing:.08em;padding:5px 7px}.suas-chat-filters{grid-template-columns:1fr;gap:7px;padding:9px}.suas-chat-feed{height:460px;padding:10px;gap:12px!important}.suas-chat-bubble{width:94%;font-size:11px;line-height:1.34;padding:11px;border-radius:17px 17px 17px 6px}.suas-chat-message:nth-child(even) .suas-chat-bubble{border-radius:17px 17px 6px 17px}.suas-chat-name{font-size:.9rem}.suas-chat-pill,.suas-chat-type{min-height:18px;font-size:6.5px;padding:3px 6px}.suas-review-form-card{padding:12px}.suas-review-form-card input,.suas-review-form-card select,.suas-review-form-card textarea{font-size:11px}}
  </style>
  <div class="suas-reviews-wrap"><div class="suas-reviews-head"><p>reviews / live chat</p><h2>{{ section.settings.heading }}</h2></div><div class="suas-chat-shell"><div class="suas-chat-window"><div class="suas-chat-bar"><span class="suas-chat-dot" style="--dot:#ff5f57"></span><span class="suas-chat-dot" style="--dot:#febc2e"></span><span class="suas-chat-dot" style="--dot:#28c840"></span><span class="suas-chat-title">tap + like</span></div><div class="suas-chat-filters" data-suas-review-filters><label>sort<select data-review-sort><option value="relevant">Most relevant</option><option value="highest">Highest ratings</option><option value="lowest">Lowest ratings</option><option value="liked">Most liked</option><option value="newest">Newest</option></select></label><label>type<select data-review-type><option value="all">All reviews</option><option value="lab">Lab experience</option><option value="product">Product reviews</option></select></label><label>product<select data-review-category><option value="all">Everything</option></select></label></div><div class="suas-chat-feed" data-suas-chat-feed><div class="suas-review-empty">No reviews found for this filter.</div></div></div><form class="suas-review-form-card" data-suas-review-form><h3>leave a review.</h3><label>review type<select name="type"><option value="product">Product Review</option><option value="lab">Lab Experience</option></select></label><label>product or service<input name="category" list="suas-review-options" required placeholder="Poppy, Body Oil, Deluxe Lab..."></label><datalist id="suas-review-options"><option value="Self-Guided Perfume Experiment"><option value="Guided Lab Session"><option value="Deluxe Lab Session"><option value="Nectar"><option value="Poppy"><option value="Tonic"><option value="Butter Creme"><option value="Body Oil"><option value="Everything Mist"></datalist><label>review title<input name="title" required placeholder="Short and sweet"></label><label>your name<input name="name" required placeholder="Your name"></label><div class="suas-review-rating-label">rating<div class="suas-review-stars" role="radiogroup" aria-label="Rating"><label><input type="radio" name="rating" value="1" required><span>1</span></label><label><input type="radio" name="rating" value="2"><span>2</span></label><label><input type="radio" name="rating" value="3"><span>3</span></label><label><input type="radio" name="rating" value="4"><span>4</span></label><label><input type="radio" name="rating" value="5" checked><span>5</span></label></div></div><label>review<textarea name="review" required placeholder="Tell us what you loved, what you tried, or what we should know."></textarea></label><button class="suas-review-submit-button" type="submit">post review</button><p class="suas-review-save-note">Posts show here first. Judge.me or another review app can publish them for everybody.</p></form></div><div class="suas-review-widget">{% render 'asrv-all-reviews-widget' %}</div></div><div class="suas-review-modal" data-suas-review-modal aria-hidden="true"><div class="suas-review-modal-card"><div class="suas-review-modal-top"><h3 data-suas-review-modal-name>review.</h3><button class="suas-review-modal-close" type="button" data-suas-review-close aria-label="Close review">x</button></div><div class="suas-chat-meta"><span class="suas-chat-pill" data-suas-review-modal-stars>*****</span><span class="suas-chat-type" data-suas-review-modal-type>lab</span></div><div class="suas-review-modal-product" data-suas-review-modal-product></div><p class="suas-review-modal-message" data-suas-review-modal-message></p><button class="suas-like-button" type="button" data-suas-review-modal-like>like 0</button></div></div>
  <script>(()=>{const section=document.currentScript.closest('.suas-reviews');if(!section||section.dataset.chatReady==='true')return;section.dataset.chatReady='true';const feed=section.querySelector('[data-suas-chat-feed]'),form=section.querySelector('[data-suas-review-form]'),modal=section.querySelector('[data-suas-review-modal]'),sortSelect=section.querySelector('[data-review-sort]'),typeSelect=section.querySelector('[data-review-type]'),categorySelect=section.querySelector('[data-review-category]');const tones=['#ffd8e8','#cdeeff','#d9ff78','#fff1a8','#e4d5ff','#ffc7dc'];let messages=[{type:'lab',category:'Self-Guided Perfume Experiment',title:'Made my own scent',name:'Jalen',rating:'5',review:'I made a scent that actually smelled like me. The whole process was cute and easy.',likes:7,created:5},{type:'product',category:'Poppy',title:'Pink in the best way',name:'Jamie',rating:'5',review:'Sweet and nostalgic but grown. Poppy is pink in the best way.',likes:4,created:4},{type:'lab',category:'Deluxe Lab Session',title:'Loved the setup',name:'Katrina',rating:'5',review:'The guided class made me feel like I knew what I was doing. Loved the whole setup.',likes:9,created:3},{type:'product',category:'Butter Creme',title:'Soft skin',name:'Sherry',rating:'5',review:'Soft skin and good scent. That is the whole review.',likes:6,created:2},{type:'product',category:'Tonic',title:'Fresh reset',name:'Maya',rating:'5',review:'Fresh, clean, minty, and different. Tonic is that reset button scent.',likes:5,created:1}];try{messages=[...JSON.parse(localStorage.getItem('suasReviewMessages')||'[]'),...messages].slice(0,40)}catch{}let selected=0;let liked={};try{liked=JSON.parse(localStorage.getItem('suasLikedReviews')||'{}')}catch{}function stars(n){return '*'.repeat(Math.max(1,Math.min(5,Number(n)||5)))}function esc(value){return String(value||'').replace(/[&<>"]/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[char]))}function keyFor(item,index){return `${item.name}-${item.category}-${item.created||index}`}function likeCount(item,index){return (Number(item.likes)||0)+(liked[keyFor(item,index)]?1:0)}function currentItems(){let items=messages.map((item,index)=>({...item,_index:index}));const type=typeSelect.value,category=categorySelect.value,sort=sortSelect.value;if(type!=='all')items=items.filter(item=>item.type===type);if(category!=='all')items=items.filter(item=>item.category===category);if(sort==='highest')items.sort((a,b)=>Number(b.rating)-Number(a.rating));else if(sort==='lowest')items.sort((a,b)=>Number(a.rating)-Number(b.rating));else if(sort==='liked')items.sort((a,b)=>likeCount(b,b._index)-likeCount(a,a._index));else if(sort==='newest')items.sort((a,b)=>(Number(b.created)||0)-(Number(a.created)||0));else items.sort((a,b)=>(Number(b.rating)*2+likeCount(b,b._index))-(Number(a.rating)*2+likeCount(a,a._index)));return items}function fillCategories(){const value=categorySelect.value;const cats=[...new Set(messages.map(item=>item.category).filter(Boolean))].sort();categorySelect.innerHTML='<option value="all">Everything</option>'+cats.map(cat=>`<option value="${esc(cat)}">${esc(cat)}</option>`).join('');if([...categorySelect.options].some(opt=>opt.value===value))categorySelect.value=value}function render(){fillCategories();const items=currentItems();feed.classList.toggle('is-empty',items.length===0);feed.querySelectorAll('.suas-chat-message').forEach(node=>node.remove());items.forEach(item=>{const index=item._index,key=keyFor(item,index),count=likeCount(item,index);const button=document.createElement('button');button.type='button';button.className=`suas-chat-message ${index===selected?'is-selected':''}`;button.dataset.index=index;button.style.setProperty('--tone',tones[index%tones.length]);button.innerHTML=`<div class="suas-chat-bubble"><div class="suas-chat-meta"><span class="suas-chat-name">${esc(item.name||'guest')}</span><span class="suas-chat-pill">${stars(item.rating)}</span><span class="suas-chat-type">${item.type==='product'?'product':'lab'}</span></div><strong>${esc(item.category)}${item.title?' / '+esc(item.title):''}</strong>${esc(item.review)}<div class="suas-chat-actions"><span class="suas-like-button ${liked[key]?'is-liked':''}" data-like="${index}">like ${count}</span></div></div>`;feed.appendChild(button)})}function openModal(index){selected=index;const item=messages[index];if(!item)return;const key=keyFor(item,index);modal.style.setProperty('--modal-tone',tones[index%tones.length]);modal.querySelector('[data-suas-review-modal-name]').textContent=item.name||'guest';modal.querySelector('[data-suas-review-modal-stars]').textContent=stars(item.rating);modal.querySelector('[data-suas-review-modal-type]').textContent=item.type==='product'?'product':'lab';modal.querySelector('[data-suas-review-modal-product]').textContent=`${item.category||''}${item.title?' / '+item.title:''}`;modal.querySelector('[data-suas-review-modal-message]').textContent=item.review||'';const like=modal.querySelector('[data-suas-review-modal-like]');like.textContent=`like ${likeCount(item,index)}`;like.classList.toggle('is-liked',!!liked[key]);like.dataset.index=index;modal.classList.add('is-open');modal.setAttribute('aria-hidden','false');render()}function closeModal(){modal.classList.remove('is-open');modal.setAttribute('aria-hidden','true')}feed.addEventListener('click',event=>{const msg=event.target.closest('.suas-chat-message');if(!msg)return;const index=Number(msg.dataset.index)||0;if(event.target.closest('[data-like]')){const key=keyFor(messages[index],index);liked[key]=!liked[key];localStorage.setItem('suasLikedReviews',JSON.stringify(liked));render();return}openModal(index)});[sortSelect,typeSelect,categorySelect].forEach(select=>select.addEventListener('change',render));modal.addEventListener('click',event=>{if(event.target===modal||event.target.closest('[data-suas-review-close]'))closeModal();const like=event.target.closest('[data-suas-review-modal-like]');if(like){const index=Number(like.dataset.index)||0,key=keyFor(messages[index],index);liked[key]=!liked[key];localStorage.setItem('suasLikedReviews',JSON.stringify(liked));openModal(index)}});document.addEventListener('keydown',event=>{if(event.key==='Escape')closeModal()});form.addEventListener('submit',event=>{event.preventDefault();if(!form.reportValidity())return;const data=Object.fromEntries(new FormData(form).entries());messages.unshift({...data,likes:0,created:Date.now()});messages=messages.slice(0,40);localStorage.setItem('suasReviewMessages',JSON.stringify(messages.slice(0,25)));selected=0;render();feed.scrollTop=0;form.querySelector('.suas-review-save-note').textContent='Posted into the chat on this browser.';form.reset();form.querySelector('input[name="rating"][value="5"]').checked=true});render()})();</script>
</section>
{% schema %}{"name":"SUAS Reviews","settings":[{"type":"text","id":"heading","label":"Heading","default":"reviews from real ones"}],"presets":[{"name":"SUAS Reviews"}]}{% endschema %}

<section class="suas-reviews" data-suas-review-form-ready="true" aria-label="SUAS reviews chat">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}
    .suas-reviews{--ink:#101010;--paper:#fbfaf7;--pink:#ffd8e8;--blue:#cdeeff;--lime:#d9ff78;--yellow:#fff1a8;color:var(--ink);background:radial-gradient(circle at 12% 12%,rgba(255,216,232,.52),transparent 28%),radial-gradient(circle at 88% 76%,rgba(217,255,120,.26),transparent 30%),var(--paper);font-family:Futura,'Futura PT',Arial,sans-serif;overflow:hidden}.suas-reviews *{box-sizing:border-box}.suas-reviews-wrap{width:min(1080px,calc(100vw - 24px));margin:0 auto;padding:clamp(40px,6vw,78px) 0}.suas-reviews-head{text-align:center;margin-bottom:24px}.suas-reviews-head p{margin:0 0 7px;font:900 clamp(.9rem,1.3vw,1.1rem)/1 Futura,Arial,sans-serif;letter-spacing:.28em;text-transform:uppercase;color:rgba(16,16,16,.45)}.suas-reviews-head h2{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:clamp(3.4rem,7.4vw,7rem);font-weight:400!important;line-height:.84;letter-spacing:0;text-transform:lowercase}.suas-reviews-hint{margin-top:13px;font-weight:800;color:rgba(16,16,16,.55);text-transform:lowercase}.suas-chat-shell{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.42fr);gap:18px;align-items:start}.suas-chat-window{position:relative;min-height:520px;border:2px solid var(--ink);border-radius:30px;background:rgba(255,255,255,.84);box-shadow:8px 9px 0 var(--ink);overflow:hidden}.suas-chat-bar{display:flex;align-items:center;gap:8px;min-height:44px;padding:10px 16px;border-bottom:1.5px solid rgba(16,16,16,.16);background:linear-gradient(180deg,#fff,#edf0f5)}.suas-chat-dot{width:12px;height:12px;border-radius:999px;background:var(--dot)}.suas-chat-title{margin-left:auto;font:900 10px/1 Futura,Arial,sans-serif;letter-spacing:.22em;text-transform:uppercase;color:rgba(16,16,16,.48)}.suas-chat-feed{height:476px;overflow:hidden;padding:20px 18px 26px;display:flex;flex-direction:column;gap:12px}.suas-chat-message{max-width:min(86%,680px);display:grid;gap:5px;align-self:flex-start;opacity:.22;transform:translateY(12px) scale(.98);transition:opacity .45s ease,transform .45s ease}.suas-chat-message.is-live{opacity:1;transform:none}.suas-chat-message:nth-child(even){align-self:flex-end}.suas-chat-meta{display:flex;align-items:center;gap:8px;font:900 10px/1 Futura,Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:rgba(16,16,16,.55)}.suas-chat-pill{display:inline-flex;align-items:center;min-height:23px;padding:5px 9px;border:1.5px solid var(--ink);border-radius:999px;background:var(--tone);box-shadow:0 2px 0 var(--ink);color:var(--ink)}.suas-chat-bubble{border:2px solid var(--ink);border-radius:24px 24px 24px 6px;background:var(--tone);box-shadow:4px 5px 0 var(--ink);padding:14px 16px;color:var(--ink);font-weight:800;line-height:1.48}.suas-chat-message:nth-child(even) .suas-chat-bubble{border-radius:24px 24px 6px 24px}.suas-chat-name{font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:1.45rem;line-height:.9;text-transform:lowercase;color:var(--ink)}.suas-review-form-card{border:2px solid var(--ink);border-radius:30px;background:linear-gradient(140deg,#fff 0%,var(--pink) 150%);box-shadow:8px 9px 0 var(--ink);padding:22px}.suas-review-form-card h3{margin:0 0 16px;font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:clamp(2.5rem,5vw,4rem);font-weight:400!important;line-height:.88;text-transform:lowercase}.suas-review-form-card label{display:grid;gap:6px;margin-bottom:10px;font:900 10px/1 Futura,Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:rgba(16,16,16,.58)}.suas-review-form-card input,.suas-review-form-card select,.suas-review-form-card textarea{width:100%;min-height:46px;border:1.5px solid rgba(16,16,16,.28);border-radius:16px;background:#fff;padding:11px 13px;color:var(--ink);font:800 14px/1.25 Futura,Arial,sans-serif}.suas-review-form-card textarea{min-height:96px;resize:vertical}.suas-review-submit-button{width:100%;min-height:48px;margin-top:8px;border:2px solid var(--ink);border-radius:999px;background:var(--lime);color:var(--ink);box-shadow:0 4px 0 var(--ink);font:900 11px/1 Futura,Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;cursor:pointer}.suas-review-save-note{margin:12px 0 0;font:800 12px/1.45 Futura,Arial,sans-serif;color:rgba(16,16,16,.58)}.suas-review-widget{display:none}@media(max-width:860px){.suas-chat-shell{grid-template-columns:1fr}.suas-chat-window{min-height:430px}.suas-chat-feed{height:386px;padding:16px 12px 22px}.suas-chat-message{max-width:92%}.suas-review-form-card{border-radius:24px;box-shadow:5px 6px 0 var(--ink)}}
  </style>
  <div class="suas-reviews-wrap">
    <div class="suas-reviews-head"><p>incoming love notes +</p><h2>{{ section.settings.heading }}</h2><div class="suas-reviews-hint">new notes roll in like a little group chat</div></div>
    <div class="suas-chat-shell">
      <div class="suas-chat-window"><div class="suas-chat-bar"><span class="suas-chat-dot" style="--dot:#ff5f57"></span><span class="suas-chat-dot" style="--dot:#febc2e"></span><span class="suas-chat-dot" style="--dot:#28c840"></span><span class="suas-chat-title">suas reviews live</span></div><div class="suas-chat-feed" data-suas-chat-feed></div></div>
      <form class="suas-review-form-card" data-suas-review-form><h3>leave a note.</h3><label>review type<select name="type"><option value="lab">Lab Experience</option><option value="product">Product Review</option></select></label><label>category<select name="category" data-suas-review-category></select></label><label>your name<input name="name" required placeholder="Kymara"></label><label>rating<select name="rating"><option value="*****">5 stars</option><option value="****">4 stars</option><option value="***">3 stars</option></select></label><label>message<textarea name="review" required placeholder="Tell us what you loved"></textarea></label><button class="suas-review-submit-button" type="submit">send review</button><p class="suas-review-save-note">Right now this posts into the live page chat on this device. To publish reviews store-wide, connect this to AfterShip Reviews or a Shopify backend.</p></form>
    </div>
    <div class="suas-review-widget">{% render 'asrv-all-reviews-widget' %}</div>
  </div>
  <script>
    (()=>{const section=document.currentScript.closest('.suas-reviews');if(!section||section.dataset.chatReady==='true')return;section.dataset.chatReady='true';const feed=section.querySelector('[data-suas-chat-feed]'),form=section.querySelector('[data-suas-review-form]'),category=section.querySelector('[data-suas-review-category]');const labOptions=['Lab Session: Body Oil','Lab Session: Eau De Parfum','Combo Session','Deluxe Lab Session','The Lab'];const productOptions=['Nectar','Good Girl','Tonic','Haze','Ember','Crimson','Butter Creme','Body Oil','Everything Mist','Candles'];const tones=['#ffd8e8','#cdeeff','#d9ff78','#fff1a8','#e4d5ff','#ffc7dc'];let messages=[{type:'lab',category:'Lab Session: Eau De Parfum',name:'Jalen',rating:'*****',review:'I made a scent that actually smelled like me. The whole process was cute and easy.'},{type:'product',category:'Nectar',name:'Jamie',rating:'*****',review:'Nectar is juicy, bright, and not too sweet. Immediate compliment getter.'},{type:'lab',category:'Combo Session',name:'Staci',rating:'*****',review:'Perfume and body oil together was the move. I left smelling expensive.'},{type:'product',category:'Tonic',name:'Maya',rating:'*****',review:'Fresh, clean, minty, and different. Tonic is that reset button scent.'},{type:'lab',category:'Deluxe Lab Session',name:'Katrina',rating:'*****',review:'The guided class made me feel like I knew what I was doing. Loved the whole setup.'},{type:'product',category:'Butter Creme',name:'Sherry',rating:'*****',review:'Soft skin and good scent. That is the whole review.'}];try{messages=[...JSON.parse(localStorage.getItem('suasReviewMessages')||'[]'),...messages].slice(0,18)}catch{}let liveIndex=0;function setCategories(){const opts=form.elements.type.value==='product'?productOptions:labOptions;category.innerHTML=opts.map(item=>`<option>${item}</option>`).join('')}function render(){feed.innerHTML=messages.map((item,index)=>`<article class="suas-chat-message ${index===liveIndex?'is-live':''}" style="--tone:${tones[index%tones.length]}"><div class="suas-chat-meta"><span class="suas-chat-name">${item.name||'guest'}</span><span class="suas-chat-pill">${item.rating||'*****'}</span><span>${item.type==='product'?'product':'lab'}</span></div><div class="suas-chat-bubble"><strong>${item.category}</strong><br>${item.review}</div></article>`).join('')}function tick(){liveIndex=(liveIndex+1)%messages.length;render()}setCategories();render();let timer=setInterval(tick,2600);form.elements.type.addEventListener('change',setCategories);form.addEventListener('submit',event=>{event.preventDefault();const data=Object.fromEntries(new FormData(form).entries());messages.unshift(data);messages=messages.slice(0,18);localStorage.setItem('suasReviewMessages',JSON.stringify(messages.slice(0,12)));liveIndex=0;render();clearInterval(timer);timer=setInterval(tick,2600);form.querySelector('.suas-review-save-note').textContent='Your review just joined the chat on this device.';form.reset();setCategories()})})();
  </script>
</section>
{% schema %}{"name":"SUAS Reviews","settings":[{"type":"text","id":"heading","label":"Heading","default":"reviews from real ones"}],"presets":[{"name":"SUAS Reviews"}]}{% endschema %}

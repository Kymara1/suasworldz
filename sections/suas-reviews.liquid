<section class="suas-reviews" data-suas-review-form-ready="true" aria-label="SUAS reviews chat">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}@font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}
    .suas-reviews{--ink:#101010;--paper:#fbfaf7;--pink:#ffd8e8;--blue:#cdeeff;--lime:#d9ff78;--yellow:#fff1a8;--lav:#e4d5ff;color:var(--ink);background:radial-gradient(circle at 12% 12%,rgba(255,216,232,.52),transparent 28%),radial-gradient(circle at 88% 76%,rgba(217,255,120,.26),transparent 30%),var(--paper);font-family:Futura,'Futura PT',Arial,sans-serif;overflow:hidden}.suas-reviews *{box-sizing:border-box}.suas-reviews-wrap{width:min(980px,calc(100vw - 24px));margin:0 auto;padding:clamp(30px,4vw,50px) 0}.suas-reviews-head{text-align:center;margin-bottom:16px}.suas-reviews-head p{display:none}.suas-reviews-head h2{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:clamp(2.55rem,5vw,4.6rem);font-weight:400!important;line-height:.9;letter-spacing:0;text-transform:lowercase}.suas-chat-shell{display:grid;grid-template-columns:minmax(0,1fr) minmax(250px,310px);gap:14px;align-items:start}.suas-chat-window{border:2px solid var(--ink);border-radius:24px;background:rgba(255,255,255,.9);box-shadow:6px 7px 0 var(--ink);overflow:hidden}.suas-chat-bar{display:flex;align-items:center;gap:8px;min-height:39px;padding:9px 14px;border-bottom:1.5px solid rgba(16,16,16,.16);background:linear-gradient(180deg,#fff,#edf0f5)}.suas-chat-dot{width:12px;height:12px;border-radius:999px;background:var(--dot);flex:0 0 auto}.suas-chat-title{margin-left:auto;padding:6px 9px;border:1.5px solid var(--ink);border-radius:999px;background:var(--yellow);box-shadow:0 2px 0 var(--ink);font:900 8.5px/1 Futura,Arial,sans-serif;letter-spacing:.15em;text-transform:uppercase;color:var(--ink)}.suas-chat-feed{height:392px;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:10px;scroll-behavior:smooth}.suas-chat-feed::-webkit-scrollbar{width:10px}.suas-chat-feed::-webkit-scrollbar-thumb{border:2px solid #fff;border-radius:999px;background:#101010}.suas-chat-message{position:relative;width:100%;display:grid;grid-template-columns:40px minmax(0,1fr);gap:9px;align-items:start;border:0;background:transparent;text-align:left;color:var(--ink);cursor:pointer;padding:0;margin:0}.suas-chat-message:before{content:attr(data-initial);width:40px;height:40px;display:grid;place-items:center;border:1.5px solid var(--ink);border-radius:999px;background:var(--tone);box-shadow:0 3px 0 var(--ink);font-family:'Casual Human',Futura,Arial,sans-serif;font-size:1.35rem;text-transform:lowercase}.suas-chat-body{min-width:0}.suas-chat-meta{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin:0 0 5px;font:900 8.5px/1 Futura,Arial,sans-serif;letter-spacing:.11em;text-transform:uppercase;color:var(--ink)}.suas-chat-name{font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:1.15rem;line-height:.9;text-transform:lowercase;color:var(--ink);letter-spacing:0}.suas-chat-pill{display:inline-flex;align-items:center;min-height:19px;padding:4px 7px;border:1.5px solid var(--ink);border-radius:999px;background:#fff;box-shadow:0 2px 0 var(--ink);color:var(--ink);letter-spacing:.02em}.suas-chat-type{opacity:.6}.suas-chat-bubble{border:2px solid var(--ink);border-radius:20px 20px 20px 6px;background:var(--tone);box-shadow:3px 4px 0 var(--ink);padding:11px 12px;color:var(--ink);font-weight:800;font-size:12.5px;line-height:1.36;transition:transform 160ms ease,box-shadow 160ms ease}.suas-chat-message:nth-child(even) .suas-chat-bubble{border-radius:20px 20px 6px 20px;background:linear-gradient(135deg,var(--tone),#fff 170%)}.suas-chat-message:hover .suas-chat-bubble,.suas-chat-message.is-selected .suas-chat-bubble{transform:translateY(-2px);box-shadow:4px 6px 0 var(--ink)}.suas-chat-bubble strong{display:block;margin-bottom:3px;font-size:11px;letter-spacing:.04em;text-transform:uppercase}.suas-chat-actions{display:flex;gap:8px;align-items:center;margin-top:8px}.suas-like-button{border:1.5px solid var(--ink);border-radius:999px;background:#fff;color:var(--ink);padding:5px 9px;box-shadow:0 2px 0 var(--ink);font:900 8.5px/1 Futura,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase;cursor:pointer}.suas-like-button.is-liked{background:var(--lime)}.suas-review-form-card{border:2px solid var(--ink);border-radius:23px;background:linear-gradient(140deg,#fff 0%,var(--pink) 150%);box-shadow:6px 7px 0 var(--ink);padding:16px}.suas-review-form-card h3{margin:0 0 12px;font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:clamp(1.95rem,3.5vw,2.7rem);font-weight:400!important;line-height:.9;text-transform:lowercase}.suas-review-form-card label{display:grid;gap:6px;margin-bottom:9px;font:900 9px/1 Futura,Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:rgba(16,16,16,.58)}.suas-review-form-card input,.suas-review-form-card select,.suas-review-form-card textarea{width:100%;min-height:40px;border:1.5px solid rgba(16,16,16,.28);border-radius:14px;background:#fff;padding:9px 11px;color:var(--ink);font:800 12.5px/1.25 Futura,Arial,sans-serif}.suas-review-form-card textarea{min-height:76px;resize:vertical}.suas-review-submit-button{width:100%;min-height:42px;margin-top:6px;border:2px solid var(--ink);border-radius:999px;background:var(--lime);color:var(--ink);box-shadow:0 4px 0 var(--ink);font:900 10px/1 Futura,Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase;cursor:pointer}.suas-review-save-note{margin:10px 0 0;font:800 10px/1.35 Futura,Arial,sans-serif;color:rgba(16,16,16,.52)}.suas-review-widget{display:none}@media(max-width:860px){.suas-chat-shell{grid-template-columns:1fr}.suas-chat-feed{height:360px;padding:12px}.suas-review-form-card{border-radius:22px;box-shadow:5px 6px 0 var(--ink)}}@media(max-width:520px){.suas-reviews-wrap{width:min(390px,calc(100vw - 20px));padding:26px 0}.suas-reviews-head h2{font-size:clamp(2.25rem,13vw,3.7rem)}.suas-chat-title{font-size:7.5px;letter-spacing:.12em}.suas-chat-feed{height:330px}.suas-chat-message{grid-template-columns:34px minmax(0,1fr);gap:8px}.suas-chat-message:before{width:34px;height:34px;font-size:1.12rem}.suas-chat-bubble{font-size:11.5px;padding:10px}.suas-chat-meta{gap:5px}.suas-chat-name{font-size:1rem}}
  </style>
  <div class="suas-reviews-wrap"><div class="suas-reviews-head"><p>reviews / live chat</p><h2>{{ section.settings.heading }}</h2></div><div class="suas-chat-shell"><div class="suas-chat-window"><div class="suas-chat-bar"><span class="suas-chat-dot" style="--dot:#ff5f57"></span><span class="suas-chat-dot" style="--dot:#febc2e"></span><span class="suas-chat-dot" style="--dot:#28c840"></span><span class="suas-chat-title">tap / like / scroll</span></div><div class="suas-chat-feed" data-suas-chat-feed></div></div><form class="suas-review-form-card" data-suas-review-form><h3>review.</h3><label>review type<select name="type"><option value="lab">Lab Experience</option><option value="product">Product Review</option></select></label><label>experience or product<input name="category" list="suas-review-options" required placeholder="Type product or experiment"></label><datalist id="suas-review-options"><option value="Self-Guided Perfume Experiment"><option value="Guided Lab Session"><option value="Deluxe Lab Session"><option value="Nectar"><option value="Poppy"><option value="Tonic"><option value="Butter Creme"><option value="Body Oil"><option value="Everything Mist"></datalist><label>your name<input name="name" required placeholder="Your name"></label><label>rating<select name="rating"><option value="5">5 stars</option><option value="4">4 stars</option><option value="3">3 stars</option></select></label><label>message<textarea name="review" required placeholder="Drop the review"></textarea></label><button class="suas-review-submit-button" type="submit">post to chat</button><p class="suas-review-save-note">Posts show here first. A review app/backend publishes them for everybody.</p></form></div><div class="suas-review-widget">{% render 'asrv-all-reviews-widget' %}</div></div>
  <script>(()=>{const section=document.currentScript.closest('.suas-reviews');if(!section||section.dataset.chatReady==='true')return;section.dataset.chatReady='true';const feed=section.querySelector('[data-suas-chat-feed]'),form=section.querySelector('[data-suas-review-form]');const tones=['#ffd8e8','#cdeeff','#d9ff78','#fff1a8','#e4d5ff','#ffc7dc'];let messages=[{type:'lab',category:'Self-Guided Perfume Experiment',name:'Jalen',rating:'5',review:'I made a scent that actually smelled like me. The whole process was cute and easy.',likes:7},{type:'product',category:'Poppy',name:'Jamie',rating:'5',review:'Sweet and nostalgic but grown. Poppy is pink in the best way.',likes:4},{type:'lab',category:'Deluxe Lab Session',name:'Katrina',rating:'5',review:'The guided class made me feel like I knew what I was doing. Loved the whole setup.',likes:9},{type:'product',category:'Butter Creme',name:'Sherry',rating:'5',review:'Soft skin and good scent. That is the whole review.',likes:6},{type:'product',category:'Tonic',name:'Maya',rating:'5',review:'Fresh, clean, minty, and different. Tonic is that reset button scent.',likes:5}];try{messages=[...JSON.parse(localStorage.getItem('suasReviewMessages')||'[]'),...messages].slice(0,30)}catch{}let selected=0;let liked=JSON.parse(localStorage.getItem('suasLikedReviews')||'{}');function stars(n){return '★'.repeat(Number(n)||5)}function esc(value){return String(value||'').replace(/[&<>"]/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[char]))}function keyFor(item,index){return `${item.name}-${item.category}-${index}`}function initialFor(item){const value=String(item.name||'s').trim();return esc(value.slice(0,1)||'s')}function render(){feed.innerHTML=messages.map((item,index)=>{const key=keyFor(item,index);const count=(Number(item.likes)||0)+(liked[key]?1:0);return `<button type="button" class="suas-chat-message ${index===selected?'is-selected':''}" data-index="${index}" data-initial="${initialFor(item)}" style="--tone:${tones[index%tones.length]}"><div class="suas-chat-body"><div class="suas-chat-meta"><span class="suas-chat-name">${esc(item.name||'guest')}</span><span class="suas-chat-pill">${stars(item.rating)}</span><span class="suas-chat-type">${item.type==='product'?'product':'lab'}</span></div><div class="suas-chat-bubble"><strong>${esc(item.category)}</strong>${esc(item.review)}<div class="suas-chat-actions"><span class="suas-like-button ${liked[key]?'is-liked':''}" data-like="${index}">like ${count}</span></div></div></div></button>`}).join('')}feed.addEventListener('click',event=>{const msg=event.target.closest('.suas-chat-message');if(!msg)return;selected=Number(msg.dataset.index)||0;if(event.target.closest('[data-like]')){const key=keyFor(messages[selected],selected);liked[key]=!liked[key];localStorage.setItem('suasLikedReviews',JSON.stringify(liked))}render()});form.addEventListener('submit',event=>{event.preventDefault();const data=Object.fromEntries(new FormData(form).entries());messages.unshift({...data,likes:0});messages=messages.slice(0,30);localStorage.setItem('suasReviewMessages',JSON.stringify(messages.slice(0,20)));selected=0;render();feed.scrollTop=0;form.querySelector('.suas-review-save-note').textContent='Posted into the chat on this browser.';form.reset()});render()})();</script>
</section>
{% schema %}{"name":"SUAS Reviews","settings":[{"type":"text","id":"heading","label":"Heading","default":"reviews from real ones"}],"presets":[{"name":"SUAS Reviews"}]}{% endschema %}
<section id="suas-reviews" class="suas-reviews" aria-label="SUAS reviews">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}
    .suas-reviews{--ink:#101010;--paper:#fbfaf7;--pink:#ffd8e8;--hot:#ff9bc4;--blue:#cdeeff;--lime:#d9ff78;--yellow:#fff1a8;--lav:#e4d5ff;color:var(--ink);background:linear-gradient(rgba(16,16,16,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.035) 1px,transparent 1px),radial-gradient(circle at 12% 12%,rgba(255,216,232,.58),transparent 28%),radial-gradient(circle at 88% 76%,rgba(217,255,120,.32),transparent 30%),var(--paper);background-size:22px 22px,22px 22px,auto,auto,auto;font-family:Futura,'Futura PT',Arial,sans-serif;overflow:hidden}
    .suas-reviews *{box-sizing:border-box}
    .suas-reviews-wrap{width:min(1160px,calc(100vw - 24px));margin:0 auto;padding:clamp(10px,2vw,22px) 0 28px}
    .suas-reviews-head{display:none}
    .suas-review-window{border:2px solid var(--ink);border-radius:26px;background:rgba(255,255,255,.96);box-shadow:7px 8px 0 var(--ink);overflow:hidden}
    .suas-review-bar{display:flex;align-items:center;gap:7px;min-height:38px;padding:8px 13px;border-bottom:2px solid var(--ink);background:linear-gradient(180deg,#fff,#edf0f5)}
    .suas-review-dot{width:10px;height:10px;border-radius:999px;background:var(--dot);flex:0 0 auto}
    .suas-review-title{margin-left:auto;padding:6px 10px;border:1.5px solid var(--ink);border-radius:999px;background:var(--yellow);box-shadow:0 2px 0 var(--ink);font:900 8px/1 Futura,Arial,sans-serif;letter-spacing:.13em;text-transform:uppercase;color:var(--ink)}
    .suas-judgeme-host{position:relative;min-height:0;padding:clamp(12px,2vw,18px);background:linear-gradient(rgba(16,16,16,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.025) 1px,transparent 1px),linear-gradient(135deg,rgba(255,216,232,.42),rgba(217,255,120,.22));background-size:18px 18px,18px 18px,auto}
    .suas-review-status{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:10px;align-items:center;margin-bottom:12px;padding:12px 14px;border:2px solid var(--ink);border-radius:20px;background:var(--pink);box-shadow:3px 4px 0 var(--ink)}
    .suas-review-status h3{margin:0 0 4px;font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:clamp(1.6rem,3.4vw,2.4rem);font-weight:400!important;line-height:.86;text-transform:lowercase;color:var(--ink)}
    .suas-review-status p{margin:0;font-size:12px;font-weight:900;letter-spacing:.07em;text-transform:uppercase;color:var(--ink)}
    .suas-review-status .suas-review-shop{min-width:132px;background:var(--yellow)}
    .suas-review-score{display:grid;place-items:center;min-width:88px;min-height:72px;border:2px solid var(--ink);border-radius:18px;background:var(--lime);box-shadow:3px 4px 0 var(--ink);text-align:center}
    .suas-review-score strong{display:block;font-size:2rem;line-height:1;font-weight:900;color:var(--ink)}
    .suas-review-score span{display:block;margin-top:4px;font-size:9px;font-weight:900;letter-spacing:.1em;text-transform:uppercase;color:var(--ink)}
    .suas-judge-panel{border:0;border-radius:0;background:transparent;box-shadow:none;padding:0;overflow:visible;min-height:0}
    .suas-judge-panel .jdgm-carousel-title-and-link,
    .suas-judge-panel :is(.jdgm-carousel-left,.jdgm-carousel-right,.jdgm-prev,.jdgm-next,.jdgm-dot,.jdgm-paginate,[class*='arrow'],.jdgm-carousel__arrows){display:none!important}
    .suas-judge-panel :is(.jdgm-carousel,.jdgm-carousel-wrapper,.jdgm-rev-widg__reviews,.jdgm-carousel-inner,.jdgm-hist-content,.jdgm-carousel-wrapper__inner){display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:12px!important;width:100%!important;max-width:none!important;height:auto!important;min-height:0!important;float:none!important;overflow:visible!important;transform:none!important;position:static!important}
    .suas-judge-panel :is(.jdgm-carousel-item,.jdgm-rev,.jdgm-rev-widg__reviews .jdgm-rev){display:flex!important;flex-direction:column!important;width:auto!important;max-width:none!important;min-width:0!important;height:auto!important;min-height:0!important;float:none!important;margin:0!important;left:auto!important;right:auto!important;top:auto!important;position:static!important;opacity:1!important;visibility:visible!important;transform:none!important;border:2px solid var(--ink)!important;border-radius:22px!important;background:var(--review-tone,#fff1a8)!important;box-shadow:4px 5px 0 var(--ink)!important;color:var(--ink)!important;padding:16px!important}
    .suas-judge-panel :is(.jdgm-carousel-item:nth-child(4n+1),.jdgm-rev:nth-child(4n+1)){--review-tone:#fff1a8}
    .suas-judge-panel :is(.jdgm-carousel-item:nth-child(4n+2),.jdgm-rev:nth-child(4n+2)){--review-tone:#cdeeff}
    .suas-judge-panel :is(.jdgm-carousel-item:nth-child(4n+3),.jdgm-rev:nth-child(4n+3)){--review-tone:#ffd8e8}
    .suas-judge-panel :is(.jdgm-carousel-item:nth-child(4n),.jdgm-rev:nth-child(4n)){--review-tone:#d9ff78}
    .suas-judge-panel :is(.jdgm-star,.jdgm-star:before,.jdgm-all-reviews-rating,.jdgm-all-reviews-rating:before){color:var(--ink)!important}
    .suas-judge-panel :is(.jdgm-carousel-item__review-title,.jdgm-rev__title,.jdgm-rev__author){font-family:Futura,'Futura PT',Arial,sans-serif!important;font-weight:900!important;letter-spacing:.06em!important;text-transform:uppercase!important;color:var(--ink)!important}
    .suas-judge-panel :is(.jdgm-carousel-item__review-body,.jdgm-rev__body){font-family:Futura,'Futura PT',Arial,sans-serif!important;font-weight:700!important;color:#303030!important;line-height:1.45!important}
    .suas-judge-panel :is(button,a[role='button'],input[type='submit'],.jdgm-write-rev-link,.jdgm-btn){min-height:40px!important;border:2px solid var(--ink)!important;border-radius:999px!important;background:var(--pink)!important;color:var(--ink)!important;box-shadow:0 4px 0 var(--ink)!important;font-family:Futura,'Futura PT',Arial,sans-serif!important;font-weight:900!important;letter-spacing:.08em!important;text-transform:uppercase!important;transition:transform 160ms ease,box-shadow 160ms ease!important;text-decoration:none!important}
    .suas-judge-panel :is(button,a[role='button'],input[type='submit'],.jdgm-write-rev-link,.jdgm-btn):hover{transform:translateY(2px)!important;box-shadow:0 2px 0 var(--ink)!important}
    .suas-judge-empty{padding:28px 18px;border:2px solid var(--ink);border-radius:22px;background:radial-gradient(circle at 14% 20%,rgba(255,216,232,.9),transparent 44%),#fff7fb;box-shadow:4px 5px 0 var(--ink);color:var(--ink);font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(1.6rem,4vw,2.4rem);line-height:.9;text-transform:lowercase;text-align:center}
    .suas-aftership-note{display:none!important}
    .suas-review-shop{display:inline-flex;align-items:center;justify-content:center;min-height:36px;padding:8px 13px;border:2px solid var(--ink);border-radius:999px;background:var(--pink);box-shadow:0 3px 0 var(--ink);color:var(--ink);text-decoration:none;font-size:9px;font-weight:900;letter-spacing:.12em;text-transform:uppercase;cursor:pointer}
    .suas-review-shop:hover{color:var(--ink);transform:translateY(1px);box-shadow:0 2px 0 var(--ink)}
    .shopify-section:has(.suas-reviews)~.shopify-section:has(.apps--root){display:none!important}
    @media(max-width:820px){.suas-judge-panel :is(.jdgm-carousel,.jdgm-carousel-wrapper,.jdgm-rev-widg__reviews,.jdgm-carousel-inner){grid-template-columns:1fr!important}}
    @media(max-width:600px){.suas-reviews-wrap{width:calc(100vw - 14px);padding:14px 0 22px}.suas-review-window{border-radius:19px;box-shadow:4px 5px 0 var(--ink)}.suas-judgeme-host{padding:9px}.suas-review-status{grid-template-columns:1fr;border-radius:18px}.suas-review-score{width:100%;min-height:64px}.suas-review-shop{width:100%}}
  </style>
  {% assign jm_reviews_count = shop.metafields.judgeme.all_reviews_count | default: 0 | plus: 0 %}
  {% assign jm_rating = shop.metafields.judgeme.all_reviews_rating | default: 0 | plus: 0 %}
  {% assign jm_carousel = shop.metafields.judgeme.featured_carousel %}
  <div class="suas-reviews-wrap">
    <div class="suas-reviews-head"><h2>{{ section.settings.heading }}</h2></div>
    <div class="suas-review-window">
      <div class="suas-review-bar">
        <span class="suas-review-dot" style="--dot:#ff5f57"></span>
        <span class="suas-review-dot" style="--dot:#febc2e"></span>
        <span class="suas-review-dot" style="--dot:#28c840"></span>
        <span class="suas-review-title">reviews from real ones</span>
      </div>
      <div class="suas-judgeme-host" data-suas-judge-host>
        <div class="suas-review-status">
          <div>
            <h3>smell reports</h3>
            <p>verified notes from real SUAS customers.</p>
          </div>
          <div class="suas-review-score" aria-label="{{ jm_rating | round: 1 }} out of 5 stars from {{ jm_reviews_count }} reviews">
            <strong>{{ jm_rating | round: 1 }}</strong>
            <span>{{ jm_reviews_count }} reviews</span>
          </div>
          <button class="suas-review-shop" type="button" data-suas-review-open-picker>leave a review</button>
        </div>
        <div class="suas-judge-panel">
          {% if jm_carousel != blank %}
            <div class="jdgm-carousel-wrapper">
              <div class="jdgm-carousel-title-and-link">
                <h2 class="jdgm-carousel-title">Let customers speak for us</h2>
                <span class="jdgm-all-reviews-rating-wrapper" href="javascript:void(0)">
                  <span style="display:block" data-score="{{ jm_rating }}" class="jdgm-all-reviews-rating" aria-label="{{ jm_rating }} stars" tabindex="0" role="img"></span>
                  <span style="display:block" class="jdgm-carousel-number-of-reviews" data-number-of-reviews="{{ jm_reviews_count }}">from {{ jm_reviews_count }} reviews</span>
                </span>
              </div>
              {{ jm_carousel }}
            </div>
          {% else %}
            <div class="suas-judge-empty">nobody's spilled yet.</div>
          {% endif %}
        </div>
      </div>
      <div class="suas-aftership-note">
        <span>Reviews from real ones.</span>
        <button class="suas-review-shop" type="button" data-suas-review-open-picker>review a product</button>
      </div>
    </div>
  </div>
  {% render 'suas-review-product-picker' %}
  <script>
    (() => {
      const section = document.currentScript.closest('.suas-reviews');
      const host = section && section.querySelector('[data-suas-judge-host]');
      if (!host || host.dataset.suasReady === 'true') return;
      host.dataset.suasReady = 'true';
      const force = () => {
        host.querySelectorAll('.jdgm-carousel,.jdgm-carousel-wrapper,.jdgm-rev-widg__reviews,.jdgm-carousel-inner,.jdgm-carousel-wrapper__inner').forEach((el) => {
          el.style.setProperty('display','grid','important');
          el.style.setProperty('grid-template-columns','repeat(2,minmax(0,1fr))','important');
          el.style.setProperty('gap','12px','important');
          el.style.setProperty('height','auto','important');
          el.style.setProperty('min-height','0','important');
          el.style.setProperty('overflow','visible','important');
          el.style.setProperty('transform','none','important');
          el.style.setProperty('position','static','important');
        });
        host.querySelectorAll('.jdgm-carousel-item,.jdgm-rev').forEach((el) => {
          el.style.setProperty('display','flex','important');
          el.style.setProperty('position','static','important');
          el.style.setProperty('transform','none','important');
          el.style.setProperty('opacity','1','important');
          el.style.setProperty('visibility','visible','important');
          el.style.setProperty('width','auto','important');
          el.style.setProperty('height','auto','important');
          el.style.setProperty('left','auto','important');
        });
        host.querySelectorAll('.jdgm-carousel-left,.jdgm-carousel-right,.jdgm-prev,.jdgm-next,.jdgm-dot,.jdgm-paginate,[class*="arrow"]').forEach((el) => {
          el.style.setProperty('display','none','important');
        });
        if (window.matchMedia('(max-width: 820px)').matches) {
          host.querySelectorAll('.jdgm-carousel,.jdgm-carousel-wrapper,.jdgm-carousel-inner').forEach((el) => {
            el.style.setProperty('grid-template-columns','1fr','important');
          });
        }
      };
      force();
      new MutationObserver(force).observe(host,{childList:true,subtree:true});
    })();
  </script>
</section>
{% schema %}{"name":"SUAS reviews","settings":[{"type":"text","id":"heading","label":"Heading","default":"reviews from real ones."}],"presets":[{"name":"SUAS reviews"}]}{% endschema %}

<section id="suas-reviews" class="suas-reviews" aria-label="SUAS reviews">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}
    .suas-reviews{--ink:#101010;--paper:#fbfaf7;--pink:#ffd8e8;--hot:#ff9bc4;--blue:#cdeeff;--lime:#d9ff78;--yellow:#fff1a8;--lav:#e4d5ff;color:var(--ink);background:linear-gradient(rgba(16,16,16,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.035) 1px,transparent 1px),radial-gradient(circle at 12% 12%,rgba(255,216,232,.58),transparent 28%),radial-gradient(circle at 88% 76%,rgba(217,255,120,.32),transparent 30%),var(--paper);background-size:22px 22px,22px 22px,auto,auto,auto;font-family:Futura,'Futura PT',Arial,sans-serif;overflow:hidden}
    .suas-reviews *{box-sizing:border-box}
    .suas-reviews-wrap{width:min(1160px,calc(100vw - 24px));margin:0 auto;padding:clamp(24px,3.8vw,48px) 0}
    .suas-reviews-head{text-align:center;margin-bottom:16px}
    .suas-reviews-head h2{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:clamp(2.7rem,6vw,5.25rem);font-weight:400!important;line-height:.84;letter-spacing:0;text-transform:lowercase}
    .suas-review-window{border:2px solid var(--ink);border-radius:26px;background:rgba(255,255,255,.96);box-shadow:7px 8px 0 var(--ink);overflow:hidden}
    .suas-review-bar{display:flex;align-items:center;gap:7px;min-height:38px;padding:8px 13px;border-bottom:2px solid var(--ink);background:linear-gradient(180deg,#fff,#edf0f5)}
    .suas-review-dot{width:10px;height:10px;border-radius:999px;background:var(--dot);flex:0 0 auto}
    .suas-review-title{margin-left:auto;padding:6px 10px;border:1.5px solid var(--ink);border-radius:999px;background:var(--yellow);box-shadow:0 2px 0 var(--ink);font:900 8px/1 Futura,Arial,sans-serif;letter-spacing:.13em;text-transform:uppercase;color:var(--ink)}
    .suas-aftership-host{position:relative;min-height:420px;padding:clamp(12px,2vw,22px);background:linear-gradient(rgba(16,16,16,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.025) 1px,transparent 1px),linear-gradient(135deg,rgba(255,216,232,.3),rgba(217,255,120,.18));background-size:18px 18px,18px 18px,auto}
    .suas-aftership-loading{display:grid;place-items:center;min-height:220px;border:1.5px dashed rgba(16,16,16,.28);border-radius:22px;background:rgba(255,255,255,.72);color:rgba(16,16,16,.58);font-size:11px;font-weight:900;letter-spacing:.14em;text-transform:uppercase;text-align:center}
    .suas-aftership-host:has(#aftership_reviews_all_reviews_widget_production:not(:empty)) .suas-aftership-loading{display:none}
    .suas-aftership-host #aftership_reviews_all_reviews_widget_production{width:100%;min-height:320px}
    .suas-aftership-host #aftership_reviews_all_reviews_widget_production>div{background:transparent!important}
    .suas-aftership-host :is(h1,h2,h3,h4,[class*='title' i],[class*='heading' i]){font-family:'Casual Human',Futura,Arial,sans-serif!important;font-weight:400!important;letter-spacing:0!important;color:var(--ink)!important;text-transform:lowercase!important}
    .suas-aftership-host :is(h1,h2){font-size:clamp(1.9rem,4vw,3.2rem)!important;line-height:.92!important}
    .suas-aftership-host :is(button,a[role='button'],input[type='submit']){min-height:40px!important;border:2px solid var(--ink)!important;border-radius:999px!important;background:var(--pink)!important;color:var(--ink)!important;box-shadow:0 4px 0 var(--ink)!important;font-family:Futura,'Futura PT',Arial,sans-serif!important;font-weight:900!important;letter-spacing:.08em!important;text-transform:uppercase!important;transition:transform 160ms ease,box-shadow 160ms ease!important}
    .suas-aftership-host :is(button,a[role='button'],input[type='submit']):hover{transform:translateY(2px)!important;box-shadow:0 2px 0 var(--ink)!important}
    .suas-aftership-host :is(select,input:not([type='submit']),textarea){border:1.5px solid var(--ink)!important;border-radius:14px!important;background:#fff!important;color:var(--ink)!important;font-family:Futura,'Futura PT',Arial,sans-serif!important;font-weight:800!important}
    .suas-aftership-host :is([class*='tab' i],[class*='filter' i],[class*='sort' i]){border-color:rgba(16,16,16,.22)!important;border-radius:999px!important;font-family:Futura,'Futura PT',Arial,sans-serif!important;font-weight:900!important}
    .suas-aftership-host :is([class*='review-item' i],[class*='review_item' i],[class*='review-card' i],[class*='review_card' i],article){margin-block:12px!important;border:2px solid var(--ink)!important;border-radius:22px!important;background:var(--review-tone,#ffd8e8)!important;box-shadow:4px 5px 0 var(--ink)!important;padding:15px!important;color:var(--ink)!important}
    .suas-aftership-host :is([class*='review-list' i],[class*='review_list' i])>*:nth-child(4n+1){--review-tone:#ffd8e8}
    .suas-aftership-host :is([class*='review-list' i],[class*='review_list' i])>*:nth-child(4n+2){--review-tone:#cdeeff}
    .suas-aftership-host :is([class*='review-list' i],[class*='review_list' i])>*:nth-child(4n+3){--review-tone:#d9ff78}
    .suas-aftership-host :is([class*='review-list' i],[class*='review_list' i])>*:nth-child(4n){--review-tone:#fff1a8}
    .suas-aftership-host :is([class*='star' i],[aria-label*='star' i],svg){color:var(--ink)!important;fill:var(--ink)!important}
    .suas-aftership-host :is([class*='summary' i],[class*='header' i]){background:linear-gradient(135deg,rgba(255,216,232,.6),rgba(217,255,120,.35))!important;border-radius:22px!important;padding:16px!important}
    .suas-aftership-note{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 16px;border-top:2px solid var(--ink);background:#fff}
    .suas-aftership-note span{font-size:10px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}
    .suas-review-shop{display:inline-flex;align-items:center;justify-content:center;min-height:36px;padding:8px 13px;border:2px solid var(--ink);border-radius:999px;background:var(--pink);box-shadow:0 3px 0 var(--ink);color:var(--ink);text-decoration:none;font-size:9px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}
    .suas-review-shop:hover{color:var(--ink);transform:translateY(1px);box-shadow:0 2px 0 var(--ink)}
    @media(max-width:600px){.suas-reviews-wrap{width:calc(100vw - 14px);padding:22px 0}.suas-review-window{border-radius:19px;box-shadow:4px 5px 0 var(--ink)}.suas-aftership-host{min-height:300px;padding:8px}.suas-aftership-host #aftership_reviews_all_reviews_widget_production{min-height:260px}.suas-aftership-host :is(h1,h2){font-size:1.85rem!important}.suas-aftership-host :is([class*='summary' i],[class*='header' i]){padding:11px!important}.suas-aftership-host :is([class*='review-item' i],[class*='review_item' i],[class*='review-card' i],[class*='review_card' i],article){border-radius:16px!important;padding:11px!important;box-shadow:3px 4px 0 var(--ink)!important}.suas-aftership-note{align-items:stretch;flex-direction:column;padding:10px}.suas-review-shop{width:100%}}
  </style>
  <div class="suas-reviews-wrap">
    <div class="suas-reviews-head"><h2>{{ section.settings.heading }}</h2></div>
    <div class="suas-review-window">
      <div class="suas-review-bar">
        <span class="suas-review-dot" style="--dot:#ff5f57"></span>
        <span class="suas-review-dot" style="--dot:#febc2e"></span>
        <span class="suas-review-dot" style="--dot:#28c840"></span>
        <span class="suas-review-title">review feed / suas.os skin</span>
      </div>
      <div class="suas-aftership-host" data-suas-aftership-host>
        <div class="suas-aftership-loading">reviews loading</div>
        {% render 'asrv-all-reviews-widget' %}
      </div>
      <div class="suas-aftership-note">
        <span>Reviews from real ones.</span>
        <a class="suas-review-shop" href="/collections/all">review a product</a>
      </div>
    </div>
  </div>
  <script>
    (() => {
      const section = document.currentScript.closest('.suas-reviews');
      const host = section && section.querySelector('[data-suas-aftership-host]');
      if (!host || host.dataset.suasReady === 'true') return;
      host.dataset.suasReady = 'true';
      const force = () => {
        host.querySelectorAll('h1,h2,h3,h4,[class*="title" i],[class*="heading" i]').forEach((el) => {
          el.style.setProperty('font-family', "'Casual Human', Futura, Arial, sans-serif", 'important');
          el.style.setProperty('font-weight', '400', 'important');
          el.style.setProperty('letter-spacing', '0', 'important');
          el.style.setProperty('color', '#101010', 'important');
        });
        host.querySelectorAll('button,a[role="button"],input[type="submit"]').forEach((el) => {
          el.style.setProperty('border', '2px solid #101010', 'important');
          el.style.setProperty('border-radius', '999px', 'important');
          el.style.setProperty('background', '#ffd8e8', 'important');
          el.style.setProperty('color', '#101010', 'important');
          el.style.setProperty('box-shadow', '0 4px 0 #101010', 'important');
          el.style.setProperty('font-weight', '900', 'important');
          el.style.setProperty('text-transform', 'uppercase', 'important');
        });
      };
      force();
      new MutationObserver(force).observe(host,{childList:true,subtree:true});
    })();
  </script>
</section>
{% schema %}{"name":"SUAS reviews","settings":[{"type":"text","id":"heading","label":"Heading","default":"reviews from real ones."}],"presets":[{"name":"SUAS reviews"}]}{% endschema %}

<section class="suas-reviews" aria-label="SUAS reviews">
  <style>
    @font-face {
      font-family: 'Casual Human';
      src: url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');
      font-display: swap;
    }

    @font-face {
      font-family: 'Casual Human';
      src: url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');
      font-weight: 700;
      font-display: swap;
    }

    .suas-reviews {
      --ink: #101010;
      --soft: #fbfaf8;
      --pink: #ffc3d7;
      --hot: #ff6e9f;
      --lime: #f0ff81;
      color: var(--ink);
      background: var(--soft);
      overflow: hidden;
      font-family: Futura, 'Futura PT', Arial, sans-serif;
    }

    .suas-reviews * { box-sizing: border-box; }

    .suas-reviews-wrap {
      position: relative;
      width: min(1230px, calc(100vw - 22px));
      min-height: 690px;
      margin: 0 auto;
      padding: clamp(48px, 6vw, 74px) 0 clamp(46px, 6vw, 84px);
    }

    .suas-reviews-head {
      position: relative;
      z-index: 2;
      text-align: center;
      margin-bottom: 26px;
    }

    .suas-reviews-head p {
      margin: 0 0 8px;
      font-family: 'Casual Human', Futura, Arial, sans-serif;
      font-weight: 700;
      font-size: clamp(1.2rem, 2vw, 2rem);
      color: #eceb60;
      transform: rotate(-8deg);
      text-transform: uppercase;
    }

    .suas-reviews-head h2 {
      margin: 0;
      font-family: 'Casual Human', Futura, Arial, sans-serif;
      font-size: clamp(3.2rem, 7vw, 6.9rem);
      font-weight: 700;
      line-height: 0.88;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .suas-reviews-hint {
      margin: 18px 0 0;
      font-size: 13px;
      color: rgba(16, 16, 16, 0.48);
      text-transform: lowercase;
    }

    .suas-review-scene {
      position: relative;
      min-height: 470px;
      margin-top: 26px;
    }

    .suas-review-bubble {
      position: absolute;
      width: var(--size);
      height: var(--size);
      left: var(--left);
      top: var(--top);
      display: grid;
      place-items: center;
      border: 3px solid var(--ink);
      border-radius: 999px;
      background: var(--bubble-bg, var(--pink));
      color: var(--ink);
      box-shadow: 6px 7px 0 rgba(16, 16, 16, 0.92);
      text-align: center;
      padding: 18px;
      appearance: none;
      cursor: pointer;
      animation: suas-review-drift var(--speed, 5s) ease-in-out infinite alternate;
      transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
    }

    .suas-review-bubble:hover,
    .suas-review-bubble.is-active {
      background: #ff85ad;
      transform: translateY(-10px) scale(1.035) rotate(var(--tilt, -2deg));
      box-shadow: 4px 5px 0 rgba(16, 16, 16, 0.92);
      z-index: 4;
    }

    .suas-review-bubble b {
      display: block;
      margin-bottom: 8px;
      font-family: Futura, 'Futura PT', Arial, sans-serif;
      font-size: clamp(12px, 1.2vw, 17px);
      letter-spacing: 0.12em;
      line-height: 1;
    }

    .suas-review-bubble span {
      display: block;
      font-family: 'Casual Human', Futura, Arial, sans-serif;
      font-weight: 700;
      font-size: clamp(1.05rem, 1.85vw, 1.75rem);
      line-height: 0.9;
      text-transform: uppercase;
    }

    .suas-review-bubble em {
      display: block;
      margin-top: 8px;
      font-size: 11px;
      line-height: 1;
      font-style: normal;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      opacity: 0.5;
    }

    @keyframes suas-review-drift {
      from { translate: 0 0; rotate: -2deg; }
      to { translate: 0 -18px; rotate: 2deg; }
    }

    .suas-review-note {
      position: absolute;
      left: 50%;
      bottom: 18px;
      z-index: 5;
      width: min(330px, 86vw);
      min-height: 54px;
      display: grid;
      place-items: center;
      transform: translateX(-50%);
      border: 0;
      border-radius: 999px;
      background: var(--ink);
      color: #fff;
      padding: 13px 26px;
      box-shadow: 0 8px 18px rgba(16, 16, 16, 0.18);
    }

    .suas-review-note p {
      margin: 0;
      font-family: 'Casual Human', Futura, Arial, sans-serif;
      font-weight: 700;
      font-size: clamp(1.1rem, 1.8vw, 1.55rem);
      line-height: 1;
      text-transform: uppercase;
      text-align: center;
    }

    .suas-review-note strong {
      display: none;
    }

    .suas-review-widget {
      display: none;
    }

    .suas-review-widget:empty:after {
      content: "AfterShip reviews can load here once the app widget is active.";
      display: block;
      text-align: center;
      font-weight: 800;
      color: rgba(16, 16, 16, 0.58);
    }

    @media (max-width: 820px) {
      .suas-reviews-wrap {
        min-height: 0;
      }

      .suas-review-scene {
        min-height: 560px;
        margin-inline: -12px;
        display: block;
      }

      .suas-review-bubble {
        width: calc(var(--mobile-size, var(--size)) * 0.82);
        height: calc(var(--mobile-size, var(--size)) * 0.82);
        left: var(--mobile-left, var(--left));
        top: var(--mobile-top, var(--top));
      }

      .suas-review-note {
        bottom: 12px;
      }
    }

    @media (max-width: 520px) {
      .suas-review-scene {
        min-height: 520px;
      }
    }
  </style>

  <div class="suas-reviews-wrap">
    <div class="suas-reviews-head">
      <p>they said it best +</p>
      <h2>{{ section.settings.heading }}</h2>
      <div class="suas-reviews-hint">tap a bubble to read</div>
    </div>

    <div class="suas-review-scene">
      <button class="suas-review-bubble is-active" type="button" style="--size: 126px; --left: 0%; --top: 44px; --mobile-size: 112px; --mobile-left: 1%; --mobile-top: 28px; --bubble-bg: #ff6e9f; --speed: 4.4s; --tilt: -4deg;" data-review="read review +" data-name="Jamie">
        <span><b>&#9733;&#9733;&#9733;&#9733;&#9733;</b>jamie</span><em>poppy</em>
      </button>
      <button class="suas-review-bubble" type="button" style="--size: 188px; --left: 11%; --top: 128px; --mobile-size: 172px; --mobile-left: 13%; --mobile-top: 116px; --bubble-bg: #ffc3d7; --speed: 5.1s; --tilt: 2deg;" data-review="body oil lasts all day +" data-name="Jalen">
        <span><b>&#9733;&#9733;&#9733;&#9733;&#9733;</b>jalen</span>
      </button>
      <button class="suas-review-bubble" type="button" style="--size: 222px; --left: 26%; --top: 198px; --mobile-size: 198px; --mobile-left: 30%; --mobile-top: 214px; --bubble-bg: #ffc3d7; --speed: 5.8s; --tilt: -1deg;" data-review="the lab was a whole memory +" data-name="Staci">
        <span><b>&#9733;&#9733;&#9733;&#9733;&#9733;</b>staci</span>
      </button>
      <button class="suas-review-bubble" type="button" style="--size: 244px; --left: 42%; --top: 250px; --mobile-size: 214px; --mobile-left: 9%; --mobile-top: 304px; --bubble-bg: #ffc3d7; --speed: 5.4s; --tilt: 3deg;" data-review="nobody else smells like me +" data-name="Jess">
        <span><b>&#9733;&#9733;&#9733;&#9733;&#9733;</b>jess</span>
      </button>
      <button class="suas-review-bubble" type="button" style="--size: 142px; --left: 55%; --top: 247px; --mobile-size: 134px; --mobile-left: 56%; --mobile-top: 328px; --bubble-bg: #ffc3d7; --speed: 4.8s; --tilt: -2deg;" data-review="cute store cute everything +" data-name="Katrina">
        <span><b>&#9733;&#9733;&#9733;&#9733;&#9733;</b>katrina</span>
      </button>
      <button class="suas-review-bubble" type="button" style="--size: 176px; --left: 72%; --top: 210px; --mobile-size: 154px; --mobile-left: 55%; --mobile-top: 148px; --bubble-bg: #ffc3d7; --speed: 5.2s; --tilt: 2deg;" data-review="my new self-care stop +" data-name="Sherry">
        <span><b>&#9733;&#9733;&#9733;&#9733;&#9733;</b>sherry</span>
      </button>

      <div class="suas-review-note" aria-live="polite">
        <p data-suas-review-text>read review +</p>
        <strong data-suas-review-name>Jamie</strong>
      </div>
    </div>

    <div class="suas-review-widget">
      {% render 'asrv-all-reviews-widget' %}
    </div>
  </div>

  <script>
    (() => {
      const section = document.currentScript.closest('.suas-reviews');
      if (!section) return;
      const text = section.querySelector('[data-suas-review-text]');
      const name = section.querySelector('[data-suas-review-name]');
      const bubbles = section.querySelectorAll('.suas-review-bubble');
      bubbles.forEach((bubble) => {
        bubble.addEventListener('click', () => {
          bubbles.forEach((item) => item.classList.remove('is-active'));
          bubble.classList.add('is-active');
          if (text) text.textContent = bubble.dataset.review || '';
          if (name) name.textContent = bubble.dataset.name || '';
        });
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "SUAS Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "reviews from real ones"
    }
  ],
  "presets": [
    {
      "name": "SUAS Reviews"
    }
  ]
}
{% endschema %}

<section class="suas-reviews" data-suas-review-form-ready="true" aria-label="SUAS reviews chat">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}@font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}.suas-reviews{--ink:#101010;--paper:#fbfaf7;--pink:#ffd8e8;--blue:#cdeeff;--lime:#d9ff78;--yellow:#fff1a8;color:var(--ink);background:radial-gradient(circle at 12% 12%,rgba(255,216,232,.52),transparent 28%),radial-gradient(circle at 88% 76%,rgba(217,255,120,.26),transparent 30%),var(--paper);font-family:Futura,'Futura PT',Arial,sans-serif;overflow:hidden}.suas-reviews *{box-sizing:border-box}.suas-reviews-wrap{width:min(1080px,calc(100vw - 24px));margin:0 auto;padding:clamp(38px,5vw,64px) 0}.suas-reviews-head{text-align:center;margin-bottom:20px}.suas-reviews-head p{margin:0 0 7px;font:900 clamp(.85rem,1.1vw,1rem)/1 Futura,Arial,sans-serif;letter-spacing:.24em;text-transform:uppercase;color:rgba(16,16,16,.45)}.suas-reviews-head h2{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:clamp(3.2rem,6.7vw,6.2rem);font-weight:400!important;line-height:.84;letter-spacing:0;text-transform:lowercase}.suas-chat-shell{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.42fr);gap:18px;align-items:start}.suas-chat-window{border:2px solid var(--ink);border-radius:28px;background:rgba(255,255,255,.86);box-shadow:8px 9px 0 var(--ink);overflow:hidden}.suas-chat-bar{display:flex;align-items:center;gap:8px;min-height:42px;padding:10px 16px;border-bottom:1.5px solid rgba(16,16,16,.16);background:linear-gradient(180deg,#fff,#edf0f5)}.suas-chat-dot{width:12px;height:12px;border-radius:999px;background:var(--dot)}.suas-chat-title{margin-left:auto;font:900 10px/1 Futura,Arial,sans-serif;letter-spacing:.2em;text-transform:uppercase;color:rgba(16,16,16,.48)}.suas-chat-feed{height:470px;overflow-y:auto;padding:18px 16px 24px;display:flex;flex-direction:column;gap:12px;scroll-behavior:smooth}.suas-chat-feed::-webkit-scrollbar{width:10px}.suas-chat-feed::-webkit-scrollbar-thumb{border:2px solid #fff;border-radius:999px;background:#101010}.suas-chat-message{max-width:min(88%,690px);display:grid;gap:5px;align-self:flex-start;border:0;background:transparent;text-align:left;color:var(--ink);cursor:pointer}.suas-chat-message:nth-child(even){align-self:flex-end}.suas-chat-meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font:900 10px/1 Futura,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:rgba(16,16,16,.55)}.suas-chat-pill{display:inline-flex;align-items:center;min-height:23px;padding:5px 9px;border:1.5px solid var(--ink);border-radius:999px;background:var(--tone);box-shadow:0 2px 0 var(--ink);color:var(--ink)}.suas-chat-bubble{border:2px solid var(--ink);border-radius:24px 24px 24px 6px;background:var(--tone);box-shadow:4px 5px 0 var(--ink);padding:14px 16px;color:var(--ink);font-weight:800;line-height:1.48;transition:transform 160ms ease}.suas-chat-message:nth-child(even) .suas-chat-bubble{border-radius:24px 24px 6px 24px}.suas-chat-message:hover .suas-chat-bubble,.suas-chat-message.is-selected .suas-chat-bubble{transform:translateY(-2px)}.suas-chat-name{font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:1.45rem;line-height:.9;text-transform:lowercase;color:var(--ink)}.suas-chat-actions{display:flex;gap:8px;align-items:center;margin-top:7px}.suas-like-button{border:1.5px solid var(--ink);border-radius:999px;background:#fff;color:var(--ink);padding:5px 9px;box-shadow:0 2px 0 var(--ink);font:900 10px/1 Futura,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase;cursor:pointer}.suas-like-button.is-liked{background:var(--lime)}.suas-review-form-card{border:2px solid var(--ink);border-radius:28px;background:linear-gradient(140deg,#fff 0%,var(--pink) 150%);box-shadow:8px 9px 0 var(--ink);padding:20px}.suas-review-form-card h3{margin:0 0 16px;font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:clamp(2.4rem,4.7vw,3.8rem);font-weight:400!important;line-height:.88;text-transform:lowercase}.suas-review-form-card label{display:grid;gap:6px;margin-bottom:10px;font:900 10px/1 Futura,Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:rgba(16,16,16,.58)}.suas-review-form-card input,.suas-review-form-card select,.suas-review-form-card textarea{width:100%;min-height:44px;border:1.5px solid rgba(16,16,16,.28);border-radius:16px;background:#fff;padding:10px 12px;color:var(--ink);font:800 14px/1.25 Futura,Arial,sans-serif}.suas-review-form-card textarea{min-height:88px;resize:vertical}.suas-review-submit-button{width:100%;min-height:46px;margin-top:8px;border:2px solid var(--ink);border-radius:999px;background:var(--lime);color:var(--ink);box-shadow:0 4px 0 var(--ink);font:900 11px/1 Futura,Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase;cursor:pointer}.suas-review-save-note{margin:12px 0 0;font:800 11px/1.4 Futura,Arial,sans-serif;color:rgba(16,16,16,.56)}.suas-review-widget{display:none}@media(max-width:860px){.suas-chat-shell{grid-template-columns:1fr}.suas-chat-feed{height:390px;padding:14px 12px 20px}.suas-chat-message{max-width:94%}.suas-review-form-card{border-radius:22px;box-shadow:5px 6px 0 var(--ink)}}
  </style>
  <div class="suas-reviews-wrap"><div class="suas-reviews-head"><p>reviews / live chat</p><h2>{{ section.settings.heading }}</h2></div><div class="suas-chat-shell"><div class="suas-chat-window"><div class="suas-chat-bar"><span class="suas-chat-dot" style="--dot:#ff5f57"></span><span class="suas-chat-dot" style="--dot:#febc2e"></span><span class="suas-chat-dot" style="--dot:#28c840"></span><span class="suas-chat-title">click a review + like it</span></div><div class="suas-chat-feed" data-suas-chat-feed></div></div><form class="suas-review-form-card" data-suas-review-form><h3>review.</h3><label>review type<select name="type"><option value="lab">Lab Experience</option><option value="product">Product Review</option></select></label><label>experience or product<input name="category" list="suas-review-options" required placeholder="Type product or choose a Lab experience"><datalist id="suas-review-options"><option value="Self-Guided Perfume Experiment"><option value="Guided Lab Session"><option value="Deluxe Lab Session"><option value="Nectar"><option value="Poppy"><option value="Tonic"><option value="Butter Creme"><option value="Body Oil"><option value="Everything Mist"></datalist></label><label>your name<input name="name" required placeholder="Your name"></label><label>rating<select name="rating"><option value="5">5 stars</option><option value="4">4 stars</option><option value="3">3 stars</option></select></label><label>message<textarea name="review" required placeholder="Drop the review"></textarea></label><button class="suas-review-submit-button" type="submit">post to chat</button><p class="suas-review-save-note">Posts show in this browser. Real published reviews still need the review app/backend connection.</p></form></div><div class="suas-review-widget">{% render 'asrv-all-reviews-widget' %}</div></div>
  <script>(()=>{const section=document.currentScript.closest('.suas-reviews');if(!section||section.dataset.chatReady==='true')return;section.dataset.chatReady='true';const feed=section.querySelector('[data-suas-chat-feed]'),form=section.querySelector('[data-suas-review-form]');const tones=['#ffd8e8','#cdeeff','#d9ff78','#fff1a8','#e4d5ff','#ffc7dc'];let messages=[{type:'lab',category:'Self-Guided Perfume Experiment',name:'Jalen',rating:'5',review:'I made a scent that actually smelled like me. The whole process was cute and easy.',likes:7},{type:'product',category:'Poppy',name:'Jamie',rating:'5',review:'Sweet and nostalgic but grown. Poppy is pink in the best way.',likes:4},{type:'lab',category:'Deluxe Lab Session',name:'Katrina',rating:'5',review:'The guided class made me feel like I knew what I was doing. Loved the whole setup.',likes:9},{type:'product',category:'Butter Creme',name:'Sherry',rating:'5',review:'Soft skin and good scent. That is the whole review.',likes:6},{type:'product',category:'Tonic',name:'Maya',rating:'5',review:'Fresh, clean, minty, and different. Tonic is that reset button scent.',likes:5}];try{messages=[...JSON.parse(localStorage.getItem('suasReviewMessages')||'[]'),...messages].slice(0,30)}catch{}let selected=0;let liked=JSON.parse(localStorage.getItem('suasLikedReviews')||'{}');function stars(n){return '★'.repeat(Number(n)||5)}function keyFor(item,index){return `${item.name}-${item.category}-${index}`}function render(){feed.innerHTML=messages.map((item,index)=>{const key=keyFor(item,index);const count=(Number(item.likes)||0)+(liked[key]?1:0);return `<button type="button" class="suas-chat-message ${index===selected?'is-selected':''}" data-index="${index}" style="--tone:${tones[index%tones.length]}"><div class="suas-chat-meta"><span class="suas-chat-name">${item.name||'guest'}</span><span class="suas-chat-pill">${stars(item.rating)}</span><span>${item.type==='product'?'product':'lab'}</span></div><div class="suas-chat-bubble"><strong>${item.category}</strong><br>${item.review}<div class="suas-chat-actions"><span class="suas-like-button ${liked[key]?'is-liked':''}" data-like="${index}">like ${count}</span></div></div></button>`}).join('')}feed.addEventListener('click',event=>{const like=event.target.closest('[data-like]');const msg=event.target.closest('.suas-chat-message');if(!msg)return;selected=Number(msg.dataset.index)||0;if(like){const key=keyFor(messages[selected],selected);liked[key]=!liked[key];localStorage.setItem('suasLikedReviews',JSON.stringify(liked))}render()});form.addEventListener('submit',event=>{event.preventDefault();const data=Object.fromEntries(new FormData(form).entries());messages.unshift({...data,likes:0});messages=messages.slice(0,30);localStorage.setItem('suasReviewMessages',JSON.stringify(messages.slice(0,20)));selected=0;render();feed.scrollTop=0;form.querySelector('.suas-review-save-note').textContent='Posted into the chat on this browser.';form.reset()});render()})();</script>
</section>
{% schema %}{"name":"SUAS Reviews","settings":[{"type":"text","id":"heading","label":"Heading","default":"reviews from real ones"}],"presets":[{"name":"SUAS Reviews"}]}{% endschema %}

<section class="suas-reviews" aria-label="SUAS reviews">
  <style>
    @font-face {
      font-family: 'Casual Human';
      src: url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');
      font-display: swap;
    }

    @font-face {
      font-family: 'Casual Human';
      src: url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');
      font-weight: 700;
      font-display: swap;
    }

    .suas-reviews {
      --ink: #101010;
      --paper: #fbfaf7;
      --soft-yellow: #f3ef62;
      color: var(--ink);
      background: var(--paper);
      overflow: hidden;
      font-family: Futura, 'Futura PT', Arial, sans-serif;
    }

    .suas-reviews * { box-sizing: border-box; }

    .suas-reviews-wrap {
      position: relative;
      width: min(1120px, calc(100vw - 22px));
      min-height: 650px;
      margin: 0 auto;
      padding: clamp(34px, 5vw, 52px) 0 clamp(44px, 6vw, 78px);
    }

    .suas-reviews-head {
      position: relative;
      z-index: 3;
      text-align: center;
      margin-bottom: 18px;
    }

    .suas-reviews-head p {
      margin: 0 0 7px;
      font-family: 'Casual Human', Futura, Arial, sans-serif;
      font-weight: 700 !important;
      font-size: clamp(1rem, 1.45vw, 1.35rem);
      color: var(--soft-yellow);
      transform: rotate(-8deg) translateY(8px);
      text-transform: uppercase;
    }

    .suas-reviews-head h2 {
      margin: 0;
      font-family: 'Casual Human', Futura, Arial, sans-serif;
      font-size: clamp(3.1rem, 6.2vw, 5.9rem);
      font-weight: 400 !important;
      line-height: 0.86;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .suas-reviews-hint {
      margin: 18px 0 0;
      font-size: 13px;
      color: rgba(16, 16, 16, 0.48);
      text-transform: lowercase;
    }

    .suas-review-scene {
      position: relative;
      min-height: 420px;
      margin-top: 20px;
    }

    .suas-review-bubble {
      position: absolute;
      width: var(--size);
      height: var(--size);
      left: var(--left);
      top: var(--top);
      display: grid;
      place-items: center;
      border: 2px solid var(--ink);
      border-radius: 999px;
      background: var(--bubble-bg) !important;
      color: var(--ink) !important;
      box-shadow: 5px 6px 0 rgba(16, 16, 16, 0.9);
      text-align: center;
      padding: 16px;
      appearance: none;
      cursor: pointer;
      transform: translate3d(0, 0, 0) rotate(var(--base-tilt, -2deg));
      animation: suas-review-float var(--speed, 5s) ease-in-out infinite alternate;
      transition: box-shadow 170ms ease, filter 170ms ease;
      will-change: transform;
    }

    .suas-review-bubble:hover,
    .suas-review-bubble:focus-visible,
    .suas-review-bubble.is-active {
      filter: saturate(1.08) brightness(1.02);
      box-shadow: 3px 4px 0 rgba(16, 16, 16, 0.92);
      outline: none;
      z-index: 5;
    }

    .suas-review-bubble.is-active {
      animation-duration: calc(var(--speed, 5s) * 0.78);
    }

    .suas-review-bubble b {
      display: block;
      margin-bottom: 7px;
      font-family: Futura, 'Futura PT', Arial, sans-serif;
      font-size: clamp(12px, 1.1vw, 16px);
      letter-spacing: 0.08em;
      line-height: 1;
    }

    .suas-review-bubble span {
      display: block;
      font-family: 'Casual Human', Futura, Arial, sans-serif;
      font-weight: 400 !important;
      font-size: clamp(1.05rem, 1.7vw, 1.6rem);
      line-height: 0.9;
      text-transform: uppercase;
    }

    .suas-review-bubble em {
      display: block;
      margin-top: 8px;
      font-size: 10px;
      line-height: 1;
      font-style: normal;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      opacity: 0.62;
    }

    @keyframes suas-review-float {
      0% { transform: translate3d(0, 0, 0) rotate(var(--base-tilt, -2deg)); }
      50% { transform: translate3d(10px, -14px, 0) rotate(var(--float-tilt, 2deg)); }
      100% { transform: translate3d(-4px, -24px, 0) rotate(var(--end-tilt, -1deg)); }
    }

    .suas-review-read-pill {
      position: absolute;
      left: 50%;
      bottom: 8px;
      z-index: 6;
      min-height: 54px;
      transform: translateX(-50%);
      border: 0;
      border-radius: 999px;
      background: var(--ink);
      color: #fff;
      padding: 13px 36px;
      box-shadow: 0 8px 18px rgba(16, 16, 16, 0.18);
      font-family: 'Casual Human', Futura, Arial, sans-serif;
      font-size: clamp(1.1rem, 1.7vw, 1.45rem);
      line-height: 1;
      text-transform: uppercase;
      white-space: nowrap;
      cursor: pointer;
    }

    .suas-review-modal {
      --review-color: #ff9f3d;
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: grid;
      place-items: center;
      padding: 20px;
      background: rgba(16, 16, 16, 0.46);
      backdrop-filter: blur(8px);
    }

    .suas-review-modal[hidden] {
      display: none !important;
    }

    .suas-review-card {
      width: min(510px, 94vw);
      position: relative;
      border: 2px solid var(--ink);
      border-radius: 30px;
      background:
        radial-gradient(circle at 14% 18%, color-mix(in srgb, var(--review-color) 70%, white 30%), transparent 34%),
        radial-gradient(circle at 88% 10%, rgba(240, 255, 129, 0.38), transparent 34%),
        #fff;
      box-shadow: 8px 9px 0 var(--ink), 0 22px 42px rgba(16, 16, 16, 0.22);
      padding: clamp(24px, 5vw, 36px);
      text-align: center;
      animation: suas-review-pop 180ms ease-out both;
    }

    @keyframes suas-review-pop {
      from { opacity: 0; transform: translateY(12px) scale(0.96) rotate(-1deg); }
      to { opacity: 1; transform: none; }
    }

    .suas-review-close {
      position: absolute;
      top: 14px;
      right: 14px;
      width: 36px;
      height: 36px;
      display: grid;
      place-items: center;
      border: 2px solid var(--ink);
      border-radius: 999px;
      background: #fff;
      color: var(--ink);
      box-shadow: 0 3px 0 var(--ink);
      cursor: pointer;
      font: 900 17px/1 Futura, Arial, sans-serif;
    }

    .suas-review-product {
      display: inline-flex;
      min-height: 42px;
      align-items: center;
      justify-content: center;
      border: 2px solid var(--ink);
      border-radius: 999px;
      padding: 9px 18px;
      background: var(--review-color);
      color: var(--ink);
      box-shadow: 0 4px 0 var(--ink);
      font-family: 'Casual Human', Futura, Arial, sans-serif;
      font-size: clamp(1.2rem, 4vw, 1.8rem);
      font-weight: 400;
      line-height: 1;
      text-transform: uppercase;
    }

    .suas-review-stars {
      margin: 24px 0 10px;
      font-size: 17px;
      letter-spacing: 0.12em;
    }

    .suas-review-name {
      margin: 0;
      font-family: 'Casual Human', Futura, Arial, sans-serif;
      font-size: clamp(2.1rem, 7vw, 3.4rem);
      font-weight: 400 !important;
      line-height: 0.9;
      text-transform: uppercase;
    }

    .suas-review-copy {
      margin: 20px auto 0;
      max-width: 390px;
      font-size: clamp(1rem, 2.4vw, 1.18rem);
      line-height: 1.55;
      font-weight: 800;
      color: rgba(16, 16, 16, 0.68);
    }

    .suas-review-widget {
      display: none;
    }

    @supports not (background: color-mix(in srgb, red, white)) {
      .suas-review-card {
        background:
          radial-gradient(circle at 14% 18%, rgba(255, 213, 176, 0.86), transparent 34%),
          radial-gradient(circle at 88% 10%, rgba(240, 255, 129, 0.38), transparent 34%),
          #fff;
      }
    }

    @media (max-width: 820px) {
      .suas-reviews-wrap {
        min-height: 0;
        padding-bottom: 54px;
      }

      .suas-review-scene {
        min-height: 575px;
        margin-inline: -12px;
      }

      .suas-review-bubble {
        width: calc(var(--mobile-size, var(--size)) * 0.84);
        height: calc(var(--mobile-size, var(--size)) * 0.84);
        left: var(--mobile-left, var(--left));
        top: var(--mobile-top, var(--top));
        padding: 12px;
        box-shadow: 4px 5px 0 rgba(16, 16, 16, 0.9);
      }

      .suas-review-read-pill {
        bottom: 6px;
      }
    }

    @media (max-width: 520px) {
      .suas-review-scene {
        min-height: 545px;
      }

      .suas-reviews-head h2 {
        font-size: clamp(2.75rem, 15vw, 4.2rem);
      }
    }
  </style>

  <div class="suas-reviews-wrap">
    <div class="suas-reviews-head">
      <p>they said it best +</p>
      <h2>{{ section.settings.heading }}</h2>
      <div class="suas-reviews-hint">tap a bubble to read</div>
    </div>

    <div class="suas-review-scene">
      <button class="suas-review-bubble is-active" type="button" style="--size: 142px; --left: 0%; --top: 34px; --mobile-size: 128px; --mobile-left: 2%; --mobile-top: 32px; --bubble-bg: #ff9f3d; --speed: 4.2s; --base-tilt: -5deg; --float-tilt: 2deg; --end-tilt: -1deg;" data-name="Jamie" data-product="Nectar" data-color="#ff9f3d" data-review="Nectar is juicy and bright without being too sweet. It gives passionfruit, pineapple, and sunshine in a bottle.">
        <span><b>&#9733;&#9733;&#9733;&#9733;&#9733;</b>jamie</span><em>nectar</em>
      </button>
      <button class="suas-review-bubble" type="button" style="--size: 180px; --left: 12%; --top: 118px; --mobile-size: 166px; --mobile-left: 14%; --mobile-top: 120px; --bubble-bg: #ff9bc4; --speed: 5.1s; --base-tilt: 3deg; --float-tilt: -2deg; --end-tilt: 1deg;" data-name="Jalen" data-product="Good Girl" data-color="#ff9bc4" data-review="Good Girl smells sweet, feminine, and addictive. It is soft but people still notice it.">
        <span><b>&#9733;&#9733;&#9733;&#9733;&#9733;</b>jalen</span><em>good girl</em>
      </button>
      <button class="suas-review-bubble" type="button" style="--size: 204px; --left: 25%; --top: 174px; --mobile-size: 190px; --mobile-left: 31%; --mobile-top: 214px; --bubble-bg: #9dd7ff; --speed: 5.6s; --base-tilt: -1deg; --float-tilt: 2deg; --end-tilt: -3deg;" data-name="Staci" data-product="Tonic" data-color="#9dd7ff" data-review="Tonic is fresh citrus and minty in the best way. It smells clean, awake, and different.">
        <span><b>&#9733;&#9733;&#9733;&#9733;&#9733;</b>staci</span><em>tonic</em>
      </button>
      <button class="suas-review-bubble" type="button" style="--size: 224px; --left: 38%; --top: 216px; --mobile-size: 210px; --mobile-left: 8%; --mobile-top: 306px; --bubble-bg: #c7b5ff; --speed: 5.3s; --base-tilt: 4deg; --float-tilt: -2deg; --end-tilt: 2deg;" data-name="Jess" data-product="Haze" data-color="#c7b5ff" data-review="Haze is dreamy and comforting. It feels soft, cozy, and like something I want on my hoodie.">
        <span><b>&#9733;&#9733;&#9733;&#9733;&#9733;</b>jess</span><em>haze</em>
      </button>
      <button class="suas-review-bubble" type="button" style="--size: 142px; --left: 53%; --top: 248px; --mobile-size: 132px; --mobile-left: 57%; --mobile-top: 330px; --bubble-bg: #d49a56; --speed: 4.7s; --base-tilt: -3deg; --float-tilt: 2deg; --end-tilt: -1deg;" data-name="Katrina" data-product="Ember" data-color="#d49a56" data-review="Ember is warm vanilla but not basic. It smells grown, magnetic, and expensive.">
        <span><b>&#9733;&#9733;&#9733;&#9733;&#9733;</b>katrina</span><em>ember</em>
      </button>
      <button class="suas-review-bubble" type="button" style="--size: 176px; --left: 68%; --top: 206px; --mobile-size: 154px; --mobile-left: 57%; --mobile-top: 150px; --bubble-bg: #ff6b6b; --speed: 5.2s; --base-tilt: 2deg; --float-tilt: -2deg; --end-tilt: 3deg;" data-name="Sherry" data-product="Crimson" data-color="#ff6b6b" data-review="Crimson is bold and sweet. It is tempting in that one-more-spray kind of way.">
        <span><b>&#9733;&#9733;&#9733;&#9733;&#9733;</b>sherry</span><em>crimson</em>
      </button>

      <button class="suas-review-read-pill" type="button" data-suas-open-active-review>read review +</button>
    </div>

    <div class="suas-review-modal" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="suas-review-modal-name">
      <div class="suas-review-card">
        <button class="suas-review-close" type="button" aria-label="Close review">x</button>
        <div class="suas-review-product" data-suas-modal-product>Nectar</div>
        <div class="suas-review-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <h3 class="suas-review-name" id="suas-review-modal-name" data-suas-modal-name>Jamie</h3>
        <p class="suas-review-copy" data-suas-modal-review>Nectar is juicy and bright without being too sweet. It gives passionfruit, pineapple, and sunshine in a bottle.</p>
      </div>
    </div>

    <div class="suas-review-widget">
      {% render 'asrv-all-reviews-widget' %}
    </div>
  </div>

  <script>
    (() => {
      const section = document.currentScript.closest('.suas-reviews');
      if (!section) return;

      const bubbles = Array.from(section.querySelectorAll('.suas-review-bubble'));
      const modal = section.querySelector('.suas-review-modal');
      const modalProduct = section.querySelector('[data-suas-modal-product]');
      const modalName = section.querySelector('[data-suas-modal-name]');
      const modalReview = section.querySelector('[data-suas-modal-review]');
      const closeButton = section.querySelector('.suas-review-close');
      const openActiveButton = section.querySelector('[data-suas-open-active-review]');
      let activeBubble = section.querySelector('.suas-review-bubble.is-active') || bubbles[0];

      function setActive(bubble) {
        if (!bubble) return;
        activeBubble = bubble;
        bubbles.forEach((item) => item.classList.toggle('is-active', item === bubble));
      }

      function applyReviewColor(bubble) {
        if (!modal || !bubble) return;
        modal.style.setProperty('--review-color', bubble.dataset.color || '#ff9f3d');
      }

      function openReview(bubble) {
        setActive(bubble);
        applyReviewColor(bubble);
        if (!modal || !bubble) return;
        if (modalProduct) modalProduct.textContent = bubble.dataset.product || 'SUAS';
        if (modalName) modalName.textContent = bubble.dataset.name || 'review';
        if (modalReview) modalReview.textContent = bubble.dataset.review || '';
        modal.hidden = false;
        modal.setAttribute('aria-hidden', 'false');
        if (closeButton) closeButton.focus({ preventScroll: true });
      }

      function closeReview() {
        if (!modal) return;
        modal.hidden = true;
        modal.setAttribute('aria-hidden', 'true');
        if (activeBubble) activeBubble.focus({ preventScroll: true });
      }

      bubbles.forEach((bubble) => {
        bubble.addEventListener('click', () => openReview(bubble));
        bubble.addEventListener('mouseenter', () => {
          setActive(bubble);
          applyReviewColor(bubble);
        });
        bubble.addEventListener('focus', () => {
          setActive(bubble);
          applyReviewColor(bubble);
        });
      });

      applyReviewColor(activeBubble);

      if (openActiveButton) {
        openActiveButton.addEventListener('click', () => openReview(activeBubble));
      }

      if (closeButton) closeButton.addEventListener('click', closeReview);
      if (modal) {
        modal.addEventListener('click', (event) => {
          if (event.target === modal) closeReview();
        });
      }

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && modal && !modal.hidden) closeReview();
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "SUAS Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "reviews from real ones"
    }
  ],
  "presets": [
    {
      "name": "SUAS Reviews"
    }
  ]
}
{% endschema %}

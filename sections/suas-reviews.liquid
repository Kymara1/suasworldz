<section id="suas-reviews" class="suas-reviews" aria-label="SUAS reviews">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}
    .suas-reviews{--ink:#101010;--paper:#fbfaf7;--pink:#ffd8e8;--lime:#d9ff78;--yellow:#fff1a8;color:var(--ink);background:radial-gradient(circle at 12% 12%,rgba(255,216,232,.52),transparent 28%),radial-gradient(circle at 88% 76%,rgba(217,255,120,.26),transparent 30%),var(--paper);font-family:Futura,'Futura PT',Arial,sans-serif;overflow:hidden}
    .suas-reviews *{box-sizing:border-box}
    .suas-reviews-wrap{width:min(1120px,calc(100vw - 24px));margin:0 auto;padding:clamp(24px,3.5vw,42px) 0}
    .suas-reviews-head{text-align:center;margin-bottom:16px}
    .suas-reviews-head h2{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:clamp(2rem,4vw,3.35rem);font-weight:400!important;line-height:.9;letter-spacing:0;text-transform:lowercase}
    .suas-review-window{border:2px solid var(--ink);border-radius:24px;background:rgba(255,255,255,.96);box-shadow:6px 7px 0 var(--ink);overflow:hidden}
    .suas-review-bar{display:flex;align-items:center;gap:7px;min-height:36px;padding:7px 12px;border-bottom:1.5px solid rgba(16,16,16,.16);background:linear-gradient(180deg,#fff,#edf0f5)}
    .suas-review-dot{width:10px;height:10px;border-radius:999px;background:var(--dot);flex:0 0 auto}
    .suas-review-title{margin-left:auto;padding:6px 10px;border:1.5px solid var(--ink);border-radius:999px;background:var(--yellow);box-shadow:0 2px 0 var(--ink);font:900 8px/1 Futura,Arial,sans-serif;letter-spacing:.13em;text-transform:uppercase;color:var(--ink)}
    .suas-aftership-host{min-height:330px;padding:20px;background:linear-gradient(rgba(16,16,16,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.025) 1px,transparent 1px),linear-gradient(135deg,rgba(255,216,232,.28),rgba(217,255,120,.2));background-size:18px 18px,18px 18px,auto}
    .suas-aftership-host #aftership_reviews_all_reviews_widget_production{width:100%;min-height:290px}
    .suas-aftership-host #aftership_reviews_all_reviews_widget_production>div{background:transparent!important}
    .suas-aftership-host :is(h1,h2,h3,h4,[class*="title" i]){font-family:'Casual Human',Futura,Arial,sans-serif!important;font-weight:400!important;letter-spacing:0!important;color:var(--ink)!important}
    .suas-aftership-host :is(h1,h2){font-size:clamp(1.8rem,4vw,3rem)!important;line-height:.92!important}
    .suas-aftership-host :is(button,a[role="button"]){min-height:40px!important;border:2px solid var(--ink)!important;border-radius:999px!important;background:var(--pink)!important;color:var(--ink)!important;box-shadow:0 4px 0 var(--ink)!important;font-family:Futura,'Futura PT',Arial,sans-serif!important;font-weight:900!important;letter-spacing:.08em!important;text-transform:uppercase!important;transition:transform 160ms ease,box-shadow 160ms ease!important}
    .suas-aftership-host :is(button,a[role="button"]):hover{transform:translateY(2px)!important;box-shadow:0 2px 0 var(--ink)!important}
    .suas-aftership-host :is(select,input,textarea){border:1.5px solid var(--ink)!important;border-radius:14px!important;background:#fff!important;color:var(--ink)!important;font-family:Futura,'Futura PT',Arial,sans-serif!important}
    .suas-aftership-host :is([class*="tab" i],[class*="filter" i],[class*="sort" i]){border-color:rgba(16,16,16,.2)!important}
    .suas-aftership-host :is([class*="review-item" i],[class*="review_item" i],[class*="review-card" i],[class*="review_card" i],article){margin-block:12px!important;border:2px solid var(--ink)!important;border-radius:20px!important;background:var(--review-tone,#ffd8e8)!important;box-shadow:4px 5px 0 var(--ink)!important;padding:15px!important}
    .suas-aftership-host :is([class*="review-list" i],[class*="review_list" i])>*:nth-child(4n+1){--review-tone:#ffd8e8}
    .suas-aftership-host :is([class*="review-list" i],[class*="review_list" i])>*:nth-child(4n+2){--review-tone:#cdeeff}
    .suas-aftership-host :is([class*="review-list" i],[class*="review_list" i])>*:nth-child(4n+3){--review-tone:#d9ff78}
    .suas-aftership-host :is([class*="review-list" i],[class*="review_list" i])>*:nth-child(4n){--review-tone:#fff1a8}
    .suas-aftership-host :is([class*="star" i],[aria-label*="star" i]){color:var(--ink)!important}
    .suas-aftership-host :is([class*="modal" i],[role="dialog"]){border-radius:24px!important}
    .suas-aftership-host :is([class*="summary" i],[class*="header" i]){background:linear-gradient(135deg,rgba(255,216,232,.5),rgba(217,255,120,.35))!important;border-radius:20px!important;padding:16px!important}
    .suas-aftership-note{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 16px;border-top:1.5px solid rgba(16,16,16,.16);background:#fff}
    .suas-aftership-note span{font-size:10px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}
    .suas-review-shop{display:inline-flex;align-items:center;justify-content:center;min-height:36px;padding:8px 13px;border:2px solid var(--ink);border-radius:999px;background:var(--pink);box-shadow:0 3px 0 var(--ink);color:var(--ink);text-decoration:none;font-size:9px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}
    .suas-review-shop:hover{color:var(--ink);transform:translateY(1px);box-shadow:0 2px 0 var(--ink)}
    @media(max-width:600px){.suas-reviews-wrap{width:calc(100vw - 14px);padding:22px 0}.suas-review-window{border-radius:19px;box-shadow:4px 5px 0 var(--ink)}.suas-aftership-host{min-height:260px;padding:8px}.suas-aftership-host #aftership_reviews_all_reviews_widget_production{min-height:240px}.suas-aftership-host :is(h1,h2){font-size:1.85rem!important}.suas-aftership-host :is([class*="summary" i],[class*="header" i]){padding:11px!important}.suas-aftership-host :is([class*="review-item" i],[class*="review_item" i],[class*="review-card" i],[class*="review_card" i],article){border-radius:16px!important;padding:11px!important;box-shadow:3px 4px 0 var(--ink)!important}.suas-aftership-note{align-items:stretch;flex-direction:column;padding:10px}.suas-review-shop{width:100%}}
  </style>
  <div class="suas-reviews-wrap">
    <div class="suas-reviews-head"><h2>{{ section.settings.heading }}</h2></div>
    <div class="suas-review-window">
      <div class="suas-review-bar">
        <span class="suas-review-dot" style="--dot:#ff5f57"></span>
        <span class="suas-review-dot" style="--dot:#febc2e"></span>
        <span class="suas-review-dot" style="--dot:#28c840"></span>
        <span class="suas-review-title">verified smell reports</span>
      </div>
      <div class="suas-aftership-host">{% render 'asrv-all-reviews-widget' %}</div>
      <div class="suas-aftership-note">
        <span>Reviews are stored and managed in AfterShip.</span>
        <a class="suas-review-shop" href="/collections/all">review a product</a>
      </div>
    </div>
  </div>
  <script>
    (() => {
      try {
        localStorage.removeItem('suasReviewMessages');
        localStorage.removeItem('suasLikedReviews');
      } catch (error) {}

      const section = document.currentScript.closest('.suas-reviews');
      const host = section && section.querySelector('.suas-aftership-host');
      if (!host || host.dataset.suasForced === 'true') return;
      host.dataset.suasForced = 'true';

      const ink = '#101010';
      const casual = "'Casual Human', Futura, Arial, sans-serif";
      const futura = "Futura, 'Futura PT', Arial, sans-serif";
      const tones = ['#ffd8e8', '#cdeeff', '#d9ff78', '#fff1a8', '#e4d5ff'];

      const force = (element, styles) => {
        if (!element || !element.style) return;
        Object.entries(styles).forEach(([property, value]) => {
          element.style.setProperty(property, value, 'important');
        });
      };

      const collectRoots = (start) => {
        const roots = [start];
        const walk = (root) => {
          root.querySelectorAll('*').forEach((element) => {
            if (element.shadowRoot && !roots.includes(element.shadowRoot)) {
              roots.push(element.shadowRoot);
              walk(element.shadowRoot);
            }
          });
        };
        walk(start);
        return roots;
      };

      const decorateRoot = (root) => {
        root.querySelectorAll('h1,h2,h3,h4').forEach((heading) => force(heading, {
          'font-family': casual,
          'font-weight': '400',
          'letter-spacing': '0',
          'line-height': '.95',
          'color': ink
        }));

        root.querySelectorAll('button,a[role="button"],input[type="submit"]').forEach((button) => force(button, {
          'min-height': '40px',
          'border': '2px solid ' + ink,
          'border-radius': '999px',
          'background': '#ffd8e8',
          'color': ink,
          'box-shadow': '0 4px 0 ' + ink,
          'font-family': futura,
          'font-weight': '900',
          'letter-spacing': '.07em',
          'text-transform': 'uppercase'
        }));

        root.querySelectorAll('select,input:not([type="submit"]),textarea').forEach((field) => force(field, {
          'border': '1.5px solid ' + ink,
          'border-radius': '14px',
          'background': '#ffffff',
          'color': ink,
          'font-family': futura
        }));

        const all = [...root.querySelectorAll('*')];
        const summaryText = all.find((element) => {
          const text = (element.textContent || '').trim().toLowerCase();
          return text.includes('customer reviews') && text.length < 600 && element.children.length > 1;
        });
        if (summaryText) {
          let summary = summaryText;
          while (summary.parentElement && summary.parentElement !== root && summary.parentElement.textContent.length < 900) {
            summary = summary.parentElement;
          }
          force(summary, {
            'border': '2px solid ' + ink,
            'border-radius': '22px',
            'background': 'linear-gradient(135deg,#ffd8e8,#d9ff78)',
            'box-shadow': '4px 5px 0 ' + ink,
            'padding': '18px'
          });
        }

        const cards = all.filter((element) => {
          const name = String(element.className || '');
          return /review[-_ ]?(item|card|content)|reviewItem|ReviewCard/i.test(name);
        });
        const uniqueCards = cards.filter((card) => !cards.some((other) => other !== card && card.contains(other)));
        uniqueCards.forEach((card, index) => force(card, {
          '--suas-tone': tones[index % tones.length],
          'margin': '12px 0',
          'border': '2px solid ' + ink,
          'border-radius': '20px',
          'background': tones[index % tones.length],
          'box-shadow': '4px 5px 0 ' + ink,
          'padding': '15px'
        }));

        root.querySelectorAll('[role="dialog"],[class*="modal" i]').forEach((dialog) => {
          if (!/write a review|review our store/i.test(dialog.textContent || '')) return;
          force(dialog, {
            'border': '2px solid ' + ink,
            'border-radius': '24px',
            'background': 'linear-gradient(145deg,#fff,#ffd8e8)',
            'box-shadow': '7px 8px 0 ' + ink,
            'font-family': futura
          });
        });
      };

      const decorate = () => {
        collectRoots(host).forEach(decorateRoot);
        document.querySelectorAll('[role="dialog"],[class*="modal" i]').forEach((dialog) => {
          if (!/write a review|review our store/i.test(dialog.textContent || '')) return;
          decorateRoot(dialog);
          force(dialog, {
            'border': '2px solid ' + ink,
            'border-radius': '24px',
            'background': 'linear-gradient(145deg,#fff,#ffd8e8)',
            'box-shadow': '7px 8px 0 ' + ink
          });
        });
        host.querySelectorAll('iframe').forEach((frame) => {
          try {
            if (frame.contentDocument) collectRoots(frame.contentDocument).forEach(decorateRoot);
          } catch (error) {}
        });
      };

      const observer = new MutationObserver(decorate);
      observer.observe(document.body, { childList: true, subtree: true });
      decorate();
      [300, 800, 1600, 3000, 5000, 8000].forEach((delay) => setTimeout(decorate, delay));
    })();
  </script>
</section>
{% schema %}{"name":"SUAS Reviews","settings":[{"type":"text","id":"heading","label":"Heading","default":"reviews from real ones"}],"presets":[{"name":"SUAS Reviews"}]}{% endschema %}
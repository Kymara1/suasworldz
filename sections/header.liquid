{%- liquid
  comment
    Translations
  endcomment

  assign search_t = 'general.search.search' | t
  assign cart_title_t = 'cart.title' | t

  comment
    Variables
  endcomment

  assign menu = section.settings.menu
  assign logo = section.settings.logo
  assign logo_height = section.settings['logo-height-range']
  assign show_search = settings['search--show-in-header']
  assign cart_type = settings['cart--type']
-%}

<header
  class="header--root"
  data-section-id="{{ section.id }}"
  data-section-type="header"
  data-js-class="Header"
  {% if logo and logo_height <= 45 %}
    data-header-logo-type="inline"
  {% elsif logo %}
    data-header-logo-type="overflowing"
  {% endif %}
>
  <noscript>
    <div class="header--container">
      <div class="header--center">
        {% if request.page_type == 'index' %}
          <h1 class="header--logo">
            {% render 'logo', logo: logo, height_range: logo_height %}
          </h1>
        {% else %}
          <div class="header--logo">
            {% render 'logo', logo: logo, height_range: logo_height %}
          </div>
        {% endif %}

        {% render 'suas-cute-menu' %}
      </div>
      <div class="header--right-side" data-item="nav-text">
        {% if show_search %}
          <div class="header--search">
            <a href="{{ routes.search_url }}">{{ search_t }}</a>
          </div>
        {% endif %}

        {% render 'login' %}

        <div class="cart-link" data-item="nav-text">
          <a href="{{ routes.cart_url }}">{{ cart_title_t }}</a>
        </div>
      </div>
    </div>
  </noscript>

  <div class="header--y-menu-for-off-canvas" style="display:none;">
    {% render 'y-menu', handle: menu %}
  </div>

  <div class="header--container">
    <div class="header--center">
      {% if request.page_type == 'index' %}
        <h1 class="header--logo">
          {% render 'logo', logo: logo, height_range: logo_height %}
        </h1>
      {% else %}
        <div class="header--logo">
          {% render 'logo', logo: logo, height_range: logo_height %}
        </div>
      {% endif %}
      {% render 'suas-cute-menu' %}
    </div>

    <div class="header--right-side" data-item="nav-text">
      {% if show_search %}
        <div class="header--search">
          <a href="{{ routes.search_url }}">{{ search_t }}</a>
        </div>
      {% endif %}

      {% render 'login' %}
      {% render 'popup', component: 'link' %}

      <div class="cart-link">
        <a
          {% if cart_type == 'drawer' %}
            data-off-canvas--open="right-sidebar"
            data-off-canvas--view="cart"
            aria-haspopup="menu"
            href="#"
          {% else %}
            href="{{ routes.cart_url }}"
          {% endif %}
        >
          {{ cart_title_t }}&nbsp;
          <span class="header--cart-number" data-item-count="{{ cart.item_count }}">
            (<span class="cart--external--total-items">{{ cart.item_count }}</span>)
          </span>
        </a>
      </div>

      <a
        class="header--cart-count"
        data-item="nav-text"
        {% if cart_type == 'drawer' %}
          data-off-canvas--open="right-sidebar"
          data-off-canvas--view="cart"
          aria-haspopup="menu"
          href="#"
        {% else %}
          href="{{ routes.cart_url }}"
        {% endif %}
      >
        <span class="cart--external--total-items">
          {{ cart.item_count }}
        </span>
      </a>

      <div
        tabindex="0"
        data-off-canvas--open="left-sidebar"
        aria-haspopup="menu"
      >
        {% render 'icons', icon: 'menu' %}
      </div>
    </div>
  </div>

  {% render 'custom-styles' %}
<style>
@font-face {
  font-family: 'Casual Human';
  src: url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');
  font-display: swap;
}

.header--root {
  border-bottom: 2px solid #111;
  background: #fffaf5;
}

.header--container {
  min-height: 58px;
  position: relative;
}

.header--center {
  flex: 1 1 auto;
  gap: clamp(18px, 4vw, 56px);
  justify-content: center !important;
  text-align: center;
}

.header--logo {
  position: absolute;
  left: clamp(14px, 3vw, 34px);
  top: 50%;
  transform: translateY(-50%);
  margin: 0 !important;
  z-index: 2;
}

.suas-cute-menu,
.suas-cute-menu ul {
  margin: 0;
  padding: 0;
  list-style: none;
}

.suas-cute-menu > ul {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(10px, 2vw, 24px);
  width: 100%;
}

.suas-menu-item {
  position: relative;
}

.suas-cute-menu a {
  display: inline-flex;
  align-items: center;
  min-height: 34px;
  padding: 8px 12px;
  border: 2px solid transparent;
  border-radius: 999px;
  color: #111;
  font-family: 'Casual Human', Futura, Arial, sans-serif;
  font-size: clamp(1.02rem, 1.4vw, 1.42rem);
  line-height: 0.95;
  letter-spacing: 0;
  text-decoration: none;
  text-transform: lowercase;
  white-space: nowrap;
}

.header--root .suas-cute-menu,
.header--root .suas-cute-menu a {
  font-family: 'Casual Human', Futura, Arial, sans-serif !important;
}

.suas-menu-item > a:after {
  content: "";
  width: 7px;
  height: 7px;
  margin-left: 9px;
  border-right: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  transform: translateY(-2px) rotate(45deg);
}

.suas-menu-leaf > a:after,
.suas-menu-nested > a:after {
  display: none;
}

.suas-cute-menu a:hover,
.suas-menu-item:focus-within > a {
  border-color: #111;
  background: #ffe8ef;
  color: #111;
}

.suas-submenu {
  position: absolute;
  z-index: 30;
  left: 50%;
  top: calc(100% + 8px);
  min-width: 240px;
  transform: translateX(-50%) translateY(8px);
  border: 2px solid #111;
  border-radius: 18px;
  background: #fff;
  padding: 8px;
  box-shadow: 0 8px 0 #111;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 140ms ease, transform 140ms ease, visibility 140ms ease;
}

.suas-menu-item:hover > .suas-submenu,
.suas-menu-item:focus-within > .suas-submenu {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: translateX(-50%) translateY(0);
}

.suas-submenu a {
  width: 100%;
  justify-content: flex-start;
  border-radius: 12px;
  color: #111;
  font-size: 1.08rem;
}

.suas-submenu a:hover,
.suas-submenu .suas-menu-item:focus-within > a {
  background: #ffe8ef;
  color: #111;
  border-color: #111;
}

.suas-menu-nested > .suas-submenu {
  left: calc(100% + 10px);
  top: 0;
  transform: translateX(8px);
}

.suas-menu-nested:hover > .suas-submenu,
.suas-menu-nested:focus-within > .suas-submenu {
  transform: translateX(0);
}

.header--right-side a,
.header--search a,
.cart-link a {
  font-family: 'Casual Human', Futura, Arial, sans-serif;
  letter-spacing: 0;
  text-transform: lowercase;
}

@media (max-width: 900px) {
  .suas-cute-menu > ul {
    justify-content: flex-start;
    overflow-x: auto;
    max-width: calc(100vw - 150px);
    padding: 4px 0;
  }

  .suas-cute-menu a {
    font-size: 1rem;
  }

  .suas-submenu {
    left: 0;
    transform: translateY(8px);
  }

  .suas-menu-item:hover > .suas-submenu,
  .suas-menu-item:focus-within > .suas-submenu {
    transform: translateY(0);
  }
}
</style>

</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "label": "Custom logo height",
      "id": "logo-height-range",
      "type": "range",
      "min": 15,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 35,
      "info": "This is referring to the natural height and should be half the height of the image you uploaded to ensure it stays sharp on retina screens."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}

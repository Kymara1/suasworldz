layer:nth-child(2){background:linear-gradient(145deg,#fff,var(--pink))}.suas-note-layer:nth-child(3){background:linear-gradient(145deg,#fff,var(--lav))}.suas-note-layer b{font-family:'Casual Human',Futura,Arial,sans-serif;font-size:2.1rem;line-height:.9}.suas-note-layer span{font-size:12px;font-weight:850;line-height:1.45;color:rgba(16,16,16,.7)}.suas-profiles-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-bottom:clamp(30px,5vw,54px)}.suas-profile-card{position:relative;display:grid;grid-template-columns:minmax(0,1fr) 168px;gap:16px;min-height:320px;padding:clamp(18px,3vw,28px);background:linear-gradient(145deg,#fff,var(--profile-tint,var(--pink)))}.suas-profile-card h2{margin:8px 0 10px;font-size:clamp(3rem,5.3vw,5rem);line-height:.82}.suas-profile-card p{margin:0;color:rgba(16,16,16,.64);font-weight:800;line-height:1.45}.suas-note-list{display:flex;flex-wrap:wrap;gap:7px;margin:16px 0}.suas-note-list span{border:1.5px solid var(--ink);border-radius:999px;background:#fff;padding:7px 9px;font-size:10px;font-weight:900}.suas-product-links{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}.suas-product-links a{min-height:34px;padding:8px 11px;background:#fff;font-size:9px;box-shadow:0 3px 0 var(--ink)}.suas-profile-art{position:relative;min-height:220px;border:2px solid var(--ink);border-radius:24px;background:linear-gradient(145deg,var(--profile-dark,#111),var(--profile-tint,var(--pink)));overflow:hidden;box-shadow:inset 0 0 0 1px rgba(255,255,255,.3)}.suas-profile-art i,.suas-profile-art b,.suas-profile-art em,.suas-profile-art strong{position:absolute;display:block}.art-fruit i{left:20px;top:26px;width:76px;height:76px;border:5px solid var(--ink);border-radius:50%;background:radial-gradient(circle at 33% 28%,#fff5b8 0 13px,transparent 14px),#ff8c31}.art-fruit b{right:18px;bottom:30px;width:86px;height:86px;border:5px solid var(--ink);border-radius:50%;background:#c44887}.art-fruit em{right:60px;top:36px;width:44px;height:18px;border-radius:50% 0 50% 0;background:#39a85a;transform:rotate(-28deg)}.art-floral i,.art-clean i{left:28px;top:34px;width:82px;height:82px;border-radius:50%;background:radial-gradient(circle at 50% 50%,#f3bc37 0 12px,transparent 13px),radial-gradient(ellipse at 50% 8%,#fff 0 17px,transparent 18px),radial-gradient(ellipse at 92% 50%,#fff 0 17px,transparent 18px),radial-gradient(ellipse at 50% 92%,#fff 0 17px,transparent 18px),radial-gradient(ellipse at 8% 50%,#fff 0 17px,transparent 18px)}.art-floral b{right:26px;bottom:32px;width:90px;height:90px;border:5px solid var(--ink);border-radius:50%;background:conic-gradient(#ff5d8e,#b31545,#ffd1de,#ff5d8e)}.art-gourmand i,.art-gourmand b{width:20px;height:108px;border:5px solid var(--ink);border-radius:999px;background:#382012;transform:rotate(30deg)}.art-gourmand i{left:46px;top:36px}.art-gourmand b{left:92px;top:50px;transform:rotate(42deg)}.art-gourmand em{right:24px;bottom:34px;width:92px;height:72px;border:5px solid var(--ink);border-radius:40%;background:linear-gradient(135deg,#8d3e14,#ffba49);clip-path:polygon(12% 16%,65% 0,100% 28%,78% 100%,18% 82%)}.art-wood i,.art-wood b,.art-wood em{width:30px;height:130px;border:5px solid var(--ink);border-radius:16px;background:repeating-linear-gradient(100deg,#5c3219 0 9px,#d19b61 10px 17px)}.art-wood i{left:38px;top:34px;transform:rotate(25deg)}.art-wood b{left:95px;top:42px;transform:rotate(44deg)}.art-wood em{right:38px;bottom:30px;transform:rotate(70deg)}.art-clean{background:linear-gradient(145deg,#f8f4ee,#cdeeff)}.art-clean b{right:18px;bottom:34px;width:94px;height:60px;border-radius:50%;background:#fff;box-shadow:-30px -8px 0 #f4f2ff,-66px 4px 0 #fff}.art-herbal i,.art-herbal b,.art-herbal em{width:74px;height:36px;border:5px solid var(--ink);border-radius:50% 0 50% 0;background:#42b56d}.art-herbal i{left:30px;top:50px;transform:rotate(-24deg)}.art-herbal b{right:28px;top:88px;transform:rotate(22deg);background:#2d8b50}.art-herbal em{left:70px;bottom:34px;transform:rotate(12deg);background:#9be48e}.suas-format-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:16px}.suas-format-heading h2{margin:0;font-size:clamp(3.4rem,7vw,6.4rem);line-height:.82}.suas-format-heading p{max-width:520px;margin:0;color:rgba(16,16,16,.64);font-weight:800;line-height:1.5}.suas-formats-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.suas-format-card{display:grid;gap:12px;min-height:220px;padding:18px;background:linear-gradient(145deg,#fff,var(--format-tint,var(--blue)))}.suas-format-card h3{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(2rem,3vw,3rem);line-height:.9}.suas-format-card p{margin:0;color:rgba(16,16,16,.64);font-size:13px;font-weight:800;line-height:1.45}.suas-format-card a{align-self:end;background:#fff;box-shadow:0 3px 0 var(--ink);font-size:9px}.suas-profile-footer{margin-top:clamp(28px,5vw,56px);border:2px solid var(--ink);border-radius:28px;background:#101010;color:#fff;box-shadow:7px 8px 0 var(--ink);padding:clamp(22px,4vw,40px);text-align:center}.suas-profile-footer h2{margin:0 0 10px;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(3rem,6vw,5.4rem);line-height:.86}.suas-profile-footer p{max-width:680px;margin:0 auto 20px;color:rgba(255,255,255,.74);font-weight:800;line-height:1.5}.suas-profile-footer a{display:inline-flex;min-height:44px;align-items:center;justify-content:center;border:2px solid #fff;border-radius:999px;background:var(--lime);box-shadow:0 4px 0 #fff;color:var(--ink);padding:11px 18px;text-decoration:none;font-size:10px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}@media(min-width:1024px){.template--page--scent-profile .off-canvas--main-content{margin-left:220px!important;width:calc(100% - 220px)!important}}@media(max-width:980px){.suas-profile-hero,.suas-note-system{grid-template-columns:1fr}.suas-note-system-copy{border-right:0;border-bottom:2px solid var(--ink)}.suas-profiles-grid{grid-template-columns:1fr}.suas-formats-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:640px){.suas-scent-profile-page{padding:24px 10px 44px}.suas-profile-title{font-size:clamp(4rem,20vw,6rem)}.suas-profile-card{grid-template-columns:1fr}.suas-profile-art{min-height:180px;order:-1}.suas-note-pyramid,.suas-formats-grid{grid-template-columns:1fr}.suas-format-heading{display:grid}.suas-profile-actions a{width:100%}}
  </style>

  <div class="suas-scent-profile-inner">
    <header class="suas-profile-hero">
      <div class="suas-profile-window">
        <div class="suas-window-bar"><i></i><i></i><i></i><b>SCENT PROFILE / 001</b></div>
        <div class="suas-profile-hero-copy">
          <span class="suas-profile-kicker">SUAS.OS / scent map</span>
          <h1 class="suas-profile-title">choose your scent profile.</h1>
          <p>Shop by how you want the product to feel: bright, soft, sweet, clean, dark, warm, or weird-cute. Each profile shows the notes, the mood, and the product formats that make the most sense for that scent family.</p>
          <div class="suas-profile-actions"><a href="#profile-grid">Browse profiles</a><a href="#product-formats">Shop by product type</a></div>
        </div>
      </div>
      <aside class="suas-profile-quiz">
        <div><span class="suas-profile-kicker">quick guide</span><h3>not sure where to start?</h3><p>Pick the words that sound most like you. If you want clean and soft, start with Fresh Skin. If you want loud and sweet, start with Gourmand. If you want sexy and grounded, start with Amber Woods.</p></div>
        <div class="suas-profile-pills"><span>sweet</span><span>clean</span><span>floral</span><span>fruity</span><span>woody</span><span>spicy</span><span>soft</span><span>dark</span></div>
      </aside>
    </header>

    <section class="suas-note-system" aria-label="How scent notes work">
      <div class="suas-note-system-copy"><small>how to read a scent</small><h2>top, heart, base.</h2><p>Top notes hit first. Heart notes become the personality. Base notes are what stay on skin, clothes, rooms, and memory.</p></div>
      <div class="suas-note-pyramid">
        <article class="suas-note-layer"><small>01 / top</small><b>first impression</b><span>citrus, bright fruit, mint, airy sparkle</span></article>
        <article class="suas-note-layer"><small>02 / heart</small><b>the body</b><span>florals, juicy fruit, herbs, creamy notes</span></article>
        <article class="suas-note-layer"><small>03 / base</small><b>the trail</b><span>vanilla, musk, amber, woods, caramel, resin</span></article>
      </div>
    </section>

    <section id="profile-grid" class="suas-profiles-grid" aria-label="Scent profiles">
      <article class="suas-profile-card" style="--profile-tint:#ffd8e8;--profile-dark:#ff7fae"><div><small>profile 01</small><h2>Flirty Fruit</h2><p>Juicy, bright, and playful. The scent profile for people who want their products to feel colorful, edible, and a little unserious.</p><div class="suas-note-list"><span>Peach</span><span>Plum</span><span>Strawberry</span><span>Pear</span><span>Mandarin</span></div><div class="suas-product-links"><a href="/search?q=fruit">Shop fruit</a><a href="/collections/body-oil">Body Oil</a><a href="/collections/everything-mist">Mist</a></div></div><div class="suas-profile-art art-fruit" aria-hidden="true"><i></i><b></b><em></em></div></article>
      <article class="suas-profile-card" style="--profile-tint:#fff0a8;--profile-dark:#ffb74d"><div><small>profile 02</small><h2>Gourmand</h2><p>Warm, sweet, creamy, delicious. For vanilla people, caramel people, coconut people, and anybody who wants to smell edible.</p><div class="suas-note-list"><span>Vanilla</span><span>Caramel</span><span>Coconut</span><span>Tonka Bean</span><span>Amber</span></div><div class="suas-product-links"><a href="/search?q=vanilla">Shop sweet</a><a href="/collections/butter-creme">Butter Creme</a><a href="/collections/candles">Candles</a></div></div><div class="suas-profile-art art-gourmand" aria-hidden="true"><i></i><b></b><em></em></div></article>
      <article class="suas-profile-card" style="--profile-tint:#e2d7ff;--profile-dark:#b29bff"><div><small>profile 03</small><h2>Soft Floral</h2><p>Pretty, petal-soft, romantic, and clean enough to wear every day. Floral without feeling old or powdery.</p><div class="suas-note-list"><span>Jasmine</span><span>Rose</span><span>Lavender</span><span>Orange Blossom</span><span>Musk</span></div><div class="suas-product-links"><a href="/search?q=floral">Shop floral</a><a href="/collections/body-wash">Body Wash</a><a href="/collections/body-jelly">Body Jelly</a></div></div><div class="suas-profile-art art-floral" aria-hidden="true"><i></i><b></b><em></em></div></article>
      <article class="suas-profile-card" style="--profile-tint:#cdeeff;--profile-dark:#9fd9ff"><div><small>profile 04</small><h2>Fresh Skin</h2><p>Clean, airy, musky, soft. This profile wears close and feels like fresh laundry, warm skin, and a reset.</p><div class="suas-note-list"><span>Musk</span><span>Bergamot</span><span>Lemon</span><span>Mint</span><span>Jasmine</span></div><div class="suas-product-links"><a href="/search?q=musk">Shop fresh</a><a href="/collections/cleansing-bar">Cleansing Bar</a><a href="/collections/everything-mist">Mist</a></div></div><div class="suas-profile-art art-clean" aria-hidden="true"><i></i><b></b><em></em></div></article>
      <article class="suas-profile-card" style="--profile-tint:#d9ff78;--profile-dark:#6c4a24"><div><small>profile 05</small><h2>Amber Woods</h2><p>Grounded, warm, smooth, and a little mysterious. Best for people who like a scent that lasts and feels expensive.</p><div class="suas-note-list"><span>Amber</span><span>Sandalwood</span><span>Cedarwood</span><span>Patchouli</span><span>Vetiver</span></div><div class="suas-product-links"><a href="/search?q=amber">Shop amber</a><a href="/collections/candles">Candles</a><a href="/collections/burnt-oils">Burnt Oils</a></div></div><div class="suas-profile-art art-wood" aria-hidden="true"><i></i><b></b><em></em></div></article>
      <article class="suas-profile-card" style="--profile-tint:#c8ffd9;--profile-dark:#4bb96f"><div><small>profile 06</small><h2>Green Weird</h2><p>Fresh herbs, earthy leaves, cool air, and odd little twists. For the people who like the scent that makes someone ask questions.</p><div class="suas-note-list"><span>Mint</span><span>Patchouli</span><span>Vetiver</span><span>Pink Pepper</span><span>Bergamot</span></div><div class="suas-product-links"><a href="/search?q=green">Shop green</a><a href="/collections/oddities">Oddities</a><a href="/collections/body-scrub">Body Scrub</a></div></div><div class="suas-profile-art art-herbal" aria-hidden="true"><i></i><b></b><em></em></div></article>
    </section>

    <section id="product-formats" aria-label="Product formats">
      <div class="suas-format-heading"><h2>pick the format.</h2><p>The same scent profile can feel different depending on the product. Body products wear close. Mists travel. Candles and burnt oils fill the room.</p></div>
      <div class="suas-formats-grid">
        <article class="suas-format-card" style="--format-tint:#ffd8e8"><small>skin</small><h3>Body Oil</h3><p>Glossy, soft, and close to the body. Best for gourmand, fruit, musk, amber.</p><a href="/collections/body-oil">Shop Body Oil</a></article>
        <article class="suas-format-card" style="--format-tint:#fff0a8"><small>cream</small><h3>Butter Creme</h3><p>Rich and cozy. Makes sweet, creamy, floral, and soft profiles feel plush.</p><a href="/collections/butter-creme">Shop Butter Creme</a></article>
        <article class="suas-format-card" style="--format-tint:#cdeeff"><small>fresh</small><h3>Everything Mist</h3><p>Easy all-over scent for skin, clothes, linens, car, and room refreshes.</p><a href="/collections/everything-mist">Shop Mist</a></article>
        <article class="suas-format-card" style="--format-tint:#d9ff78"><small>home</small><h3>Candles + Burnt Oils</h3><p>Room-filling scent. Best for amber woods, gourmand, citrus, herb, and oddities.</p><a href="/pages/home-care-products">Shop Home</a></article>
        <article class="suas-format-card" style="--format-tint:#e2d7ff"><small>polish</small><h3>Body Scrub</h3><p>Bright scent payoff in the shower. Fruit, citrus, green, and sweet profiles shine.</p><a href="/collections/body-scrub">Shop Scrub</a></article>
        <article class="suas-format-card" style="--format-tint:#ffd8e8"><small>soft wash</small><h3>Body Jelly</h3><p>Playful texture with a clean scent finish. Great for soft floral and fruit.</p><a href="/collections/body-jelly">Shop Body Jelly</a></article>
        <article class="suas-format-card" style="--format-tint:#cdeeff"><small>daily</small><h3>Body Wash</h3><p>Start the routine with the scent profile before layering oil or creme.</p><a href="/collections/body-wash">Shop Body Wash</a></article>
        <article class="suas-format-card" style="--format-tint:#fff0a8"><small>bar</small><h3>Cleansing Bar</h3><p>A simple daily reset. Best for clean, floral, citrus, and soft skin profiles.</p><a href="/collections/cleansing-bar">Shop Bars</a></article>
      </div>
    </section>

    <footer class="suas-profile-footer"><h2>want your own formula?</h2><p>Book the lab and build a scent profile from scratch. You choose the notes, product format, and label name.</p><a href="/pages/the-lab">Book The Lab</a></footer>
  </div>
</section>

<section class="suas-scent-profile-page" aria-label="Scent families">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}
    .suas-scent-profile-page{--ink:#101010;--paper:#fbfaf7;color:var(--ink);background:var(--paper);padding:clamp(24px,4vw,56px) clamp(12px,3vw,36px) 64px;font-family:Futura,'Futura PT',Arial,sans-serif}
    .suas-scent-profile-page *{box-sizing:border-box}
    .suas-scent-profile-inner{width:min(1160px,100%);margin:0 auto}
    .suas-families-head{margin:0 0 18px}
    .suas-families-head h1{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(3.4rem,9vw,7rem);line-height:.78;text-transform:lowercase}
    .suas-families-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
    .suas-family{display:grid;border:2px solid var(--ink);border-radius:28px;background:#fff;box-shadow:7px 8px 0 var(--ink);overflow:hidden;color:inherit;text-decoration:none}
    .suas-family b{display:block;padding:14px 16px 8px;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(2.4rem,5vw,4.2rem);line-height:.82;font-weight:700;text-transform:lowercase}
    .suas-family-shots{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;padding:0 10px 10px}
    .suas-family-shots img{display:block;width:100%;aspect-ratio:1;object-fit:cover;border:2px solid var(--ink);border-radius:16px;background:#f4f1ea}
    .suas-family-shots.is-three{grid-template-columns:repeat(3,minmax(0,1fr))}
    @media(min-width:1024px){.template--page--scent-profile .off-canvas--main-content{margin-left:220px!important;width:calc(100% - 220px)!important}}
    @media(max-width:720px){.suas-families-grid{grid-template-columns:1fr}.suas-family-shots.is-three{grid-template-columns:repeat(2,minmax(0,1fr))}}
  </style>

  <div class="suas-scent-profile-inner">
    <header class="suas-families-head">
      <h1>scent families.</h1>
    </header>

    <div class="suas-families-grid">
      <a class="suas-family" href="/search?q=fruit">
        <b>fruit</b>
        <div class="suas-family-shots">
          <img src="{{ 'note-goodgirl-pear.png' | asset_url }}" alt="" width="800" height="800" loading="lazy">
          <img src="{{ 'note-pineapple.png' | asset_url }}" alt="" width="800" height="800" loading="lazy">
          <img src="{{ 'note-passionfruit.png' | asset_url }}" alt="" width="800" height="800" loading="lazy">
          <img src="{{ 'note-blackberry.png' | asset_url }}" alt="" width="800" height="800" loading="lazy">
        </div>
      </a>

      <a class="suas-family" href="/search?q=floral">
        <b>floral</b>
        <div class="suas-family-shots">
          <img src="{{ 'note-jasmine.png' | asset_url }}" alt="" width="800" height="800" loading="lazy">
          <img src="{{ 'note-poppy-cosmos.png' | asset_url }}" alt="" width="800" height="800" loading="lazy">
          <img src="{{ 'note-petals.png' | asset_url }}" alt="" width="800" height="800" loading="lazy">
          <img src="{{ 'note-wildflower.png' | asset_url }}" alt="" width="800" height="800" loading="lazy">
        </div>
      </a>

      <a class="suas-family" href="/search?q=gourmand">
        <b>gourmand</b>
        <div class="suas-family-shots">
          <img src="{{ 'note-poppy-gum.png' | asset_url }}" alt="" width="800" height="800" loading="lazy">
          <img src="{{ 'note-coconut.png' | asset_url }}" alt="" width="800" height="800" loading="lazy">
          <img src="{{ 'note-poppy-bubbles.png' | asset_url }}" alt="" width="800" height="800" loading="lazy">
          <img src="{{ 'note-passionfruit-swirl.png' | asset_url }}" alt="" width="800" height="800" loading="lazy">
        </div>
      </a>

      <a class="suas-family" href="/search?q=green">
        <b>green</b>
        <div class="suas-family-shots is-three">
          <img src="{{ 'note-sage-mint.png' | asset_url }}" alt="" width="800" height="800" loading="lazy">
          <img src="{{ 'note-tonic-mojito.png' | asset_url }}" alt="" width="800" height="800" loading="lazy">
          <img src="{{ 'note-blackberry.png' | asset_url }}" alt="" width="800" height="800" loading="lazy">
        </div>
      </a>

      <a class="suas-family" href="/search?q=sparkle">
        <b>sparkle</b>
        <div class="suas-family-shots">
          <img src="{{ 'note-sunshine.png' | asset_url }}" alt="" width="800" height="800" loading="lazy">
          <img src="{{ 'note-poppy-bouquet.png' | asset_url }}" alt="" width="800" height="800" loading="lazy">
          <img src="{{ 'note-poppy-cosmos.png' | asset_url }}" alt="" width="800" height="800" loading="lazy">
          <img src="{{ 'note-pineapple-slices.png' | asset_url }}" alt="" width="800" height="800" loading="lazy">
        </div>
      </a>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "SUAS Scent Profile Page",
  "settings": [],
  "presets": [{ "name": "SUAS Scent Profile Page" }]
}
{% endschema %}

<section class="suas-scent-profile-page" aria-label="SUAS scent profile guide">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}
    .suas-scent-profile-page{--ink:#101010;--paper:#fbfaf7;--lime:#d9ff78;color:var(--ink);background:var(--paper);padding:clamp(28px,5vw,64px) clamp(12px,3vw,40px) 72px;font-family:Futura,'Futura PT',Arial,sans-serif}
    .suas-scent-profile-page *{box-sizing:border-box}
    .suas-scent-profile-inner{width:min(1160px,100%);margin:0 auto}
    .suas-profile-hero{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(260px,.9fr);gap:16px;margin-bottom:22px}
    .suas-profile-window,.suas-profile-card,.suas-note-system,.suas-format-card{border:2px solid var(--ink);border-radius:28px;background:#fff;box-shadow:7px 8px 0 var(--ink);overflow:hidden}
    .suas-window-bar{display:flex;align-items:center;gap:8px;min-height:40px;border-bottom:2px solid var(--ink);background:#e9eef2;padding:10px 16px}
    .suas-window-bar i{width:13px;height:13px;border-radius:50%;background:#ff5f57}
    .suas-window-bar i:nth-child(2){background:#ffbd2e}
    .suas-window-bar i:nth-child(3){background:#28c840}
    .suas-window-bar b{margin-left:auto;font-size:10px;font-weight:900;letter-spacing:.18em}
    .suas-profile-hero-copy{padding:clamp(22px,4vw,40px)}
    .suas-profile-kicker,.suas-profile-card small,.suas-note-system small,.suas-format-card small{font-size:10px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}
    .suas-profile-title,.suas-profile-card h2,.suas-note-system h2,.suas-format-heading h2,.suas-profile-footer h2{font-family:'Casual Human',Futura,Arial,sans-serif;font-weight:700;letter-spacing:0;text-transform:lowercase}
    .suas-profile-title{margin:12px 0 16px;font-size:clamp(3.8rem,10vw,7.6rem);line-height:.78}
    .suas-profile-hero-copy p,.suas-profile-card p,.suas-note-system p,.suas-format-heading p,.suas-format-card p{margin:0;color:rgba(16,16,16,.66);font-size:15px;font-weight:800;line-height:1.45}
    .suas-profile-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}
    .suas-profile-actions a,.suas-profile-card a,.suas-format-card a,.suas-profile-footer a{display:inline-flex;align-items:center;justify-content:center;min-height:42px;border:2px solid var(--ink);border-radius:999px;background:var(--lime);box-shadow:0 4px 0 var(--ink);color:var(--ink);padding:10px 16px;text-decoration:none;font-size:10px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}
    .suas-hero-photo{min-height:280px}
    .suas-hero-photo img{display:block;width:100%;height:100%;object-fit:cover;min-height:280px}
    .suas-note-system{display:grid;grid-template-columns:.7fr 1.3fr;margin-bottom:22px}
    .suas-note-system-copy{padding:clamp(20px,3vw,32px);border-right:2px solid var(--ink)}
    .suas-note-system h2{margin:8px 0 10px;font-size:clamp(2.6rem,5vw,4.6rem);line-height:.82}
    .suas-note-pyramid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:14px}
    .suas-note-layer{margin:0;border:2px solid var(--ink);border-radius:20px;overflow:hidden;background:#fff;box-shadow:0 4px 0 var(--ink)}
    .suas-note-layer img{display:block;width:100%;aspect-ratio:1;object-fit:cover}
    .suas-note-layer figcaption{padding:10px 12px 12px}
    .suas-note-layer b{display:block;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:1.6rem;line-height:.9}
    .suas-note-layer span{display:block;margin-top:4px;font-size:11px;font-weight:800;color:rgba(16,16,16,.62)}
    .suas-profiles-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-bottom:28px}
    .suas-profile-card{padding:0}
    .suas-profile-card .copy{padding:clamp(16px,3vw,24px)}
    .suas-profile-card h2{margin:8px 0 8px;font-size:clamp(2.6rem,4.8vw,4.4rem);line-height:.82}
    .suas-note-mosaic{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;padding:10px;background:#f4f1ea;border-top:2px solid var(--ink)}
    .suas-note-mosaic img{display:block;width:100%;aspect-ratio:1;object-fit:cover;border:2px solid var(--ink);border-radius:16px;background:#fff}
    .suas-note-mosaic.is-three{grid-template-columns:repeat(3,minmax(0,1fr))}
    .suas-product-links{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
    .suas-product-links a{min-height:34px;padding:8px 11px;background:#fff;font-size:9px;box-shadow:0 3px 0 var(--ink)}
    .suas-format-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin:0 0 14px}
    .suas-format-heading h2{margin:0;font-size:clamp(2.8rem,6vw,5.2rem);line-height:.82}
    .suas-formats-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
    .suas-format-card{padding:16px}
    .suas-format-card h3{margin:8px 0;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(1.8rem,3vw,2.6rem);line-height:.9;text-transform:lowercase}
    .suas-format-card a{align-self:start;background:#fff;box-shadow:0 3px 0 var(--ink);font-size:9px;margin-top:12px}
    .suas-profile-footer{margin-top:28px;border:2px solid var(--ink);border-radius:28px;background:#101010;color:#fff;box-shadow:7px 8px 0 var(--ink);padding:clamp(22px,4vw,40px);text-align:center}
    .suas-profile-footer h2{margin:0 0 10px;font-size:clamp(2.6rem,5vw,4.6rem);line-height:.86}
    .suas-profile-footer p{max-width:640px;margin:0 auto 18px;color:rgba(255,255,255,.74);font-weight:800}
    .suas-profile-footer a{background:var(--lime);color:var(--ink);border-color:#fff;box-shadow:0 4px 0 #fff}
    @media(min-width:1024px){.template--page--scent-profile .off-canvas--main-content{margin-left:220px!important;width:calc(100% - 220px)!important}}
    @media(max-width:980px){
      .suas-profile-hero,.suas-note-system{grid-template-columns:1fr}
      .suas-note-system-copy{border-right:0;border-bottom:2px solid var(--ink)}
      .suas-profiles-grid{grid-template-columns:1fr}
      .suas-formats-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
    }
    @media(max-width:640px){
      .suas-note-pyramid,.suas-formats-grid,.suas-note-mosaic.is-three{grid-template-columns:1fr 1fr}
      .suas-format-heading{display:grid}
      .suas-profile-actions a{width:100%}
    }
  </style>

  <div class="suas-scent-profile-inner">
    <header class="suas-profile-hero">
      <div class="suas-profile-window">
        <div class="suas-window-bar"><i></i><i></i><i></i><b>SCENT PROFILE / 001</b></div>
        <div class="suas-profile-hero-copy">
          <span class="suas-profile-kicker">SUAS.OS / the actual scents</span>
          <h1 class="suas-profile-title">choose your scent profile.</h1>
          <p>not a moodboard. these are the notes already in the jars. tap the one that smells like you, then shop it or book the lab and remix it downtown.</p>
          <div class="suas-profile-actions">
            <a href="#profile-grid">the scents</a>
            <a href="/pages/bookings">book the lab</a>
          </div>
        </div>
      </div>
      <div class="suas-profile-window suas-hero-photo">
        <div class="suas-window-bar"><i></i><i></i><i></i><b>THE.BAR / GASTONIA</b></div>
        <img src="{{ 'suas-fragrance-bar.jpg' | asset_url }}" alt="SUAS fragrance bar in downtown Gastonia" width="900" height="900">
      </div>
    </header>

    <section class="suas-note-system" aria-label="How scent notes work">
      <div class="suas-note-system-copy">
        <small>how to read a scent</small>
        <h2>top, heart, base.</h2>
        <p>same photos as the product pages. top hits first. heart is the personality. base is what stays.</p>
      </div>
      <div class="suas-note-pyramid">
        <figure class="suas-note-layer">
          <img src="{{ 'note-goodgirl-pear.png' | asset_url }}" alt="pear" width="800" height="800" loading="lazy">
          <figcaption><b>top</b><span>pear. first bite.</span></figcaption>
        </figure>
        <figure class="suas-note-layer">
          <img src="{{ 'note-jasmine.png' | asset_url }}" alt="jasmine" width="800" height="800" loading="lazy">
          <figcaption><b>heart</b><span>jasmine. the body.</span></figcaption>
        </figure>
        <figure class="suas-note-layer">
          <img src="{{ 'note-coconut.png' | asset_url }}" alt="coconut" width="800" height="800" loading="lazy">
          <figcaption><b>base</b><span>coconut. the trail.</span></figcaption>
        </figure>
      </div>
    </section>

    <section id="profile-grid" class="suas-profiles-grid" aria-label="Scent profiles">
      <article class="suas-profile-card">
        <div class="copy">
          <small>01 / poppy</small>
          <h2>poppy.</h2>
          <p>pink gum, cosmos, sparkle bouquet, blossom bubbles. loud, sweet, unserious on purpose.</p>
          <div class="suas-product-links">
            <a href="/products/poppy">shop poppy</a>
            <a href="/collections/butter-creme">butter creme</a>
          </div>
        </div>
        <div class="suas-note-mosaic">
          <img src="{{ 'note-poppy-gum.png' | asset_url }}" alt="pink gum" width="800" height="800" loading="lazy">
          <img src="{{ 'note-poppy-cosmos.png' | asset_url }}" alt="cosmos" width="800" height="800" loading="lazy">
          <img src="{{ 'note-poppy-bouquet.png' | asset_url }}" alt="sparkle bouquet" width="800" height="800" loading="lazy">
          <img src="{{ 'note-poppy-bubbles.png' | asset_url }}" alt="blossom bubbles" width="800" height="800" loading="lazy">
        </div>
      </article>

      <article class="suas-profile-card">
        <div class="copy">
          <small>02 / tonic</small>
          <h2>tonic.</h2>
          <p>blackberry, crushed mint, mojito. cold, green, a little mean in a good way.</p>
          <div class="suas-product-links">
            <a href="/products/tonic-butter-creme">shop tonic</a>
            <a href="/collections/butter-creme">butter creme</a>
          </div>
        </div>
        <div class="suas-note-mosaic is-three">
          <img src="{{ 'note-blackberry.png' | asset_url }}" alt="blackberry" width="800" height="800" loading="lazy">
          <img src="{{ 'note-sage-mint.png' | asset_url }}" alt="crushed mint" width="800" height="800" loading="lazy">
          <img src="{{ 'note-tonic-mojito.png' | asset_url }}" alt="mojito" width="800" height="800" loading="lazy">
        </div>
      </article>

      <article class="suas-profile-card">
        <div class="copy">
          <small>03 / nectar</small>
          <h2>nectar.</h2>
          <p>pineapple, passionfruit, juice, pulp. sticky tropical. not a stock fruit bowl.</p>
          <div class="suas-product-links">
            <a href="/products/nectar-butter-creme-copy">shop nectar</a>
            <a href="/collections/butter-creme">butter creme</a>
          </div>
        </div>
        <div class="suas-note-mosaic">
          <img src="{{ 'note-pineapple.png' | asset_url }}" alt="pineapple" width="800" height="800" loading="lazy">
          <img src="{{ 'note-passionfruit.png' | asset_url }}" alt="passionfruit" width="800" height="800" loading="lazy">
          <img src="{{ 'note-pineapple-slices.png' | asset_url }}" alt="pineapple juice" width="800" height="800" loading="lazy">
          <img src="{{ 'note-passionfruit-swirl.png' | asset_url }}" alt="passionfruit pulp" width="800" height="800" loading="lazy">
        </div>
      </article>

      <article class="suas-profile-card">
        <div class="copy">
          <small>04 / good girl</small>
          <h2>good girl.</h2>
          <p>pear, jasmine, coconut. pretty until it isn't. that's the point.</p>
          <div class="suas-product-links">
            <a href="/products/good-girl-butter-creme-2">shop good girl</a>
            <a href="/collections/butter-creme">butter creme</a>
          </div>
        </div>
        <div class="suas-note-mosaic is-three">
          <img src="{{ 'note-goodgirl-pear.png' | asset_url }}" alt="pear" width="800" height="800" loading="lazy">
          <img src="{{ 'note-jasmine.png' | asset_url }}" alt="jasmine" width="800" height="800" loading="lazy">
          <img src="{{ 'note-coconut.png' | asset_url }}" alt="coconut" width="800" height="800" loading="lazy">
        </div>
      </article>

      <article class="suas-profile-card">
        <div class="copy">
          <small>05 / haze</small>
          <h2>haze.</h2>
          <p>wildflower, fresh petals, soft sunshine. field, not florist.</p>
          <div class="suas-product-links">
            <a href="/products/haze-butter-creme">shop haze</a>
            <a href="/collections/butter-creme">butter creme</a>
          </div>
        </div>
        <div class="suas-note-mosaic is-three">
          <img src="{{ 'note-wildflower.png' | asset_url }}" alt="wildflower bouquet" width="800" height="800" loading="lazy">
          <img src="{{ 'note-petals.png' | asset_url }}" alt="fresh petals" width="800" height="800" loading="lazy">
          <img src="{{ 'note-sunshine.png' | asset_url }}" alt="soft sunshine" width="800" height="800" loading="lazy">
        </div>
      </article>
    </section>

    <section id="product-formats" aria-label="Product formats">
      <div class="suas-format-heading">
        <h2>pick the format.</h2>
        <p>same scent, different vehicle. cream stays. mist travels. lab bottles it downtown.</p>
      </div>
      <div class="suas-formats-grid">
        <article class="suas-format-card"><small>cream</small><h3>butter creme</h3><p>the five live scents above, in the jar.</p><a href="/collections/butter-creme">shop butter creme</a></article>
        <article class="suas-format-card"><small>skin</small><h3>body oil</h3><p>mix it in the lab if you want it on skin, not in a tub.</p><a href="/pages/bookings">book a lab oil</a></article>
        <article class="suas-format-card"><small>bottle</small><h3>perfume</h3><p>self-guided eau de parfum at the bar. thu-sun.</p><a href="/products/lab-session-eau-de-parfum">book perfume</a></article>
        <article class="suas-format-card"><small>lab</small><h3>build yours</h3><p>walk the wall. tap notes. leave with a formula that is actually yours.</p><a href="/pages/the-lab">the lab walkthrough</a></article>
      </div>
    </section>

    <footer class="suas-profile-footer">
      <h2>want your own formula?</h2>
      <p>book the lab. pick the notes off the wall. bottle it. no catalog scent required.</p>
      <a href="/pages/bookings">book the lab</a>
    </footer>
  </div>
</section>
{% schema %}
{
  "name": "SUAS Scent Profile Page",
  "settings": [],
  "presets": [{ "name": "SUAS Scent Profile Page" }]
}
{% endschema %}

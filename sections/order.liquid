{% render 'suas-os-account-styles' %}
{% if customer %}
<script>window.location.replace('/pages/account#order-{{ order.id }}');</script>
<meta http-equiv="refresh" content="0;url=/pages/account#order-{{ order.id }}">
{% endif %}
<section class="suas-os-account" aria-label="SUAS order">
  <div class="suas-os-wrap is-wide">
    {% render 'suas-os-account-mark' %}
    <div class="suas-os-mid">
      <article class="suas-os-win">
        <div class="suas-os-winbar">
          <div class="suas-os-dots">
            <span class="suas-os-dot" style="--dot:#ff5f57"></span>
            <span class="suas-os-dot" style="--dot:#febc2e"></span>
            <span class="suas-os-dot" style="--dot:#28c840"></span>
          </div>
          <span class="suas-os-wintitle suas-mono">ORDER.FILE</span>
          <span class="suas-os-live suas-mono"><b></b>IN</span>
        </div>
        <div class="suas-os-body">
          {% render 'suas-os-order-card', order: order %}
          <a class="suas-os-btn is-dark" href="/pages/account#orders">open SUAS account</a>
        </div>
      </article>
      {% render 'suas-os-account-launch', current: 'orders' %}
    </div>
  </div>
</section>

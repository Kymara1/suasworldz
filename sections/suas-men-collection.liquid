<section class="suas-men-collection" aria-label="{{ collection.title | escape }}">
  {% render 'suas-men-chrome' %}
  <style>
    .suas-men-collection{display:grid;place-items:start center;color:#fff;background:linear-gradient(rgba(255,255,255,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.08) 1px,transparent 1px),#000;background-size:26px 26px,26px 26px,auto;font-family:Futura,'Futura PT',Arial,sans-serif;padding:32px 20px 48px;min-height:calc(100vh - 36px)}
    .suas-men-collection *{box-sizing:border-box}
    .suas-men-collection a{color:inherit}
    .suas-men-font{font-family:'Casual Human',Futura,Arial,sans-serif!important;letter-spacing:0!important}
    .suas-men-mono{font-family:Futura,'Futura PT',Arial,sans-serif;font-size:12px;letter-spacing:.16em;text-transform:uppercase;font-weight:900}
    .suas-men-win{width:min(1280px,100%);border:2px solid #fff;border-radius:26px;background:#000;box-shadow:6px 7px 0 #fff;overflow:hidden}
    .suas-men-bar{min-height:48px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px;padding:10px 16px;border-bottom:2px solid #fff}
    .suas-men-dots{display:flex;gap:7px}
    .suas-men-dot{width:12px;height:12px;border-radius:999px;border:1.5px solid #fff}
    .suas-men-dot.is-on{background:#fff}
    .suas-men-bar b{text-align:center;font-size:13px;letter-spacing:.18em}
    .suas-men-exit{color:#fff;text-decoration:none;font-size:11px;letter-spacing:.14em}
    .suas-men-body{display:flex;flex-direction:column;gap:18px;padding:22px}
    .suas-men-body h1{margin:0;text-align:center;font-size:clamp(2.6rem,6vw,3.8rem);line-height:.82;text-transform:lowercase}
    .suas-men-chips{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}
    .suas-men-chips a{min-height:44px;display:inline-flex;align-items:center;justify-content:center;padding:8px 12px;border:2px solid #fff;border-radius:999px;background:#000;color:#fff;box-shadow:0 3px 0 #fff;text-decoration:none;text-align:center;font-size:12px;font-weight:900;letter-spacing:.06em;text-transform:uppercase}
    .suas-men-chips a.is-on{background:#fff;color:#000}
    .suas-men-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
    .suas-men-tile{display:flex;flex-direction:column;gap:10px;padding:12px;border:2px solid #fff;border-radius:16px;text-decoration:none;min-width:0}
    .suas-men-shot{display:block;width:100%;aspect-ratio:1/1;overflow:hidden;border:1.5px solid #fff;border-radius:12px;background:#111}
    .suas-men-shot img,.suas-men-blank{display:block;width:100%;height:100%!important;aspect-ratio:1/1;object-fit:contain;object-position:center;border:0;border-radius:0;background:#111;padding:7%;box-sizing:border-box;transform:none}
    .suas-men-tile b{font-size:clamp(1.15rem,1.8vw,1.55rem);line-height:.95;text-transform:lowercase;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .suas-men-tile .suas-men-mono{font-size:12px}
    .suas-men-empty{margin:0;text-align:center;font-size:15px;font-weight:800;opacity:.7}
    .suas-men-pages{display:flex;justify-content:center;gap:10px}
    .suas-men-pages a,.suas-men-pages span{min-height:38px;display:inline-flex;align-items:center;padding:0 14px;border:1.5px solid #fff;border-radius:999px;text-decoration:none;font-size:12px;font-weight:900}
    @media(max-width:900px){
      .suas-men-chips{grid-template-columns:repeat(3,minmax(0,1fr))}
    }
    @media(max-width:700px){
      .suas-men-collection{padding:10px 8px 24px}
      .suas-men-chips{grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}
      .suas-men-chips a{min-height:36px;font-size:9px;padding:5px 4px;letter-spacing:.04em}
      .suas-men-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
      .suas-men-win{width:100%;border-radius:18px;box-shadow:5px 6px 0 #fff}
      .suas-men-body{padding:14px;gap:12px}
      .suas-men-body h1{font-size:clamp(2.4rem,11vw,3.2rem)}
      .suas-men-tile{padding:10px;gap:8px;border-radius:14px;border-width:2px}
      .suas-men-shot{border-radius:12px;border-width:1.5px}
      .suas-men-shot img,.suas-men-blank{padding:8%;transform:none}
      .suas-men-tile b{font-size:1.25rem;line-height:1;-webkit-line-clamp:2}
      .suas-men-tile .suas-men-mono{font-size:12px;letter-spacing:.12em}
    }
  </style>
  {% paginate collection.products by 24 %}
  <article class="suas-men-win">
    <div class="suas-men-bar">
      <div class="suas-men-dots" aria-hidden="true"><span class="suas-men-dot is-on"></span><span class="suas-men-dot"></span><span class="suas-men-dot"></span></div>
      <b class="suas-men-mono">suas men</b>
      <a class="suas-men-exit suas-men-mono" href="/pages/suas-men">back</a>
    </div>
    <div class="suas-men-body">
      <h1 class="suas-men-font">{% if collection.handle == 'masculine' %}the rack{% else %}{{ collection.title }}{% endif %}</h1>
      <div class="suas-men-chips">
        <a href="/collections/cologne"{% if collection.handle == 'cologne' %} class="is-on"{% endif %}>Cologne</a>
        <a href="/collections/m-body-oil"{% if collection.handle == 'm-body-oil' %} class="is-on"{% endif %}>Body oil</a>
        <a href="/collections/m-butter-creme"{% if collection.handle == 'm-butter-creme' %} class="is-on"{% endif %}>Butter creme</a>
        <a href="/collections/exfoliating-body-wash"{% if collection.handle == 'exfoliating-body-wash' %} class="is-on"{% endif %}>Body wash</a>
        <a href="/collections/beard"{% if collection.handle contains 'beard' %} class="is-on"{% endif %}>Beard</a>
      </div>
      <div class="suas-men-grid">
        {% assign suas_men_shown = 0 %}
        {% for product in collection.products %}
          {% include 'suas-men-hide-women' %}
          {% unless suas_men_hide %}
            {% assign suas_men_shown = suas_men_shown | plus: 1 %}
            <a class="suas-men-tile" href="{{ product.url }}?world=men">
              <span class="suas-men-shot">
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title, widths: '450,700,900' }}
                {% else %}
                  <span class="suas-men-blank"></span>
                {% endif %}
              </span>
              <b class="suas-men-font">{{ product.title }}</b>
              <span class="suas-men-mono">{{ product.price | money }}</span>
            </a>
          {% endunless %}
        {% endfor %}
      </div>
      {% if collection.products_count == 0 or suas_men_shown == 0 %}
        <p class="suas-men-empty">nothing on this shelf yet.</p>
      {% endif %}
      {% if paginate.pages > 1 %}
        <div class="suas-men-pages">
          {{ paginate | default_pagination }}
        </div>
      {% endif %}
    </div>
  </article>
  {% endpaginate %}
</section>
{% schema %}
{
  "name": "SUAS Men Collection",
  "settings": [],
  "presets": [{"name": "SUAS Men Collection"}]
}
{% endschema %}

<section class="suas-bookings-page" data-suas-book-v="compact" aria-label="Book The Lab">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
    .suas-bookings-page{--ink:#101010;--pink:#ffe8ef;--hot:#ff9fc2;--lime:#d9ff78;--blue:#c9e7ff;--sun:#fff2a8;--lav:#e8ddff;min-height:100vh;color:var(--ink);background:radial-gradient(circle at 10% 8%,rgba(255,159,194,.25),transparent 30%),radial-gradient(circle at 90% 14%,rgba(217,255,120,.3),transparent 30%),linear-gradient(180deg,#fff 0%,#fffaf5 100%);font-family:Futura,'Futura PT',Arial,sans-serif}
    .suas-bookings-page *{box-sizing:border-box}
    .suas-book-wrap{width:min(1180px,calc(100vw - 28px));margin:0 auto;padding:18px 0 36px}
    .suas-book-card,.suas-book-panel,.suas-book-option{border:2px solid var(--ink);border-radius:22px;box-shadow:0 5px 0 var(--ink)}
    .suas-book-top{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(280px,.95fr);gap:12px;margin-bottom:12px;align-items:stretch}
    .suas-book-hero{background:rgba(255,255,255,.92);padding:16px 18px;display:grid;align-content:center;gap:8px}
    .suas-book-kicker,.suas-book-label,.suas-book-button,.suas-book-badge,.suas-book-tab{font-family:Futura,'Futura PT',Arial,sans-serif;font-size:11px;letter-spacing:.14em;text-transform:uppercase;font-weight:900}
    .suas-book-title,.suas-book-option h2,.suas-book-panel h2,.suas-book-price,.suas-seat-meter strong{font-family:'Casual Human',Futura,Arial,sans-serif;font-weight:400;letter-spacing:0;text-transform:uppercase}
    .suas-book-kicker{opacity:.7}
    .suas-book-title{margin:0;font-size:clamp(2rem,4vw,3.1rem);line-height:.86}
    .suas-book-copy{margin:0;font-size:.92rem;line-height:1.35;font-weight:800;color:rgba(16,16,16,.66)}
    .suas-book-tabs{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:4px}
    .suas-book-tab{min-height:44px;border:2px solid var(--ink);border-radius:999px;background:#fff;color:var(--ink);cursor:pointer;box-shadow:0 3px 0 var(--ink)}
    .suas-book-tab[data-kind="self"].is-on{background:var(--pink)}
    .suas-book-tab[data-kind="guided"].is-on{background:var(--lime)}
    .suas-book-panel{background:#fff;padding:14px 16px;display:grid;gap:8px}
    .suas-book-panel h2{margin:0;font-size:1.25rem;line-height:.95}
    .suas-book-hours-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
    .suas-book-hours-grid p{margin:0;padding:8px 10px;border-radius:14px;background:var(--chip,#fff);border:1px solid rgba(16,16,16,.12);font-size:12px;line-height:1.35;font-weight:800}
    .suas-book-hours-note{grid-column:1/-1;margin:0;font:700 11px/1.35 Futura,Arial,sans-serif;color:rgba(16,16,16,.62)}
    .suas-book-grid{display:grid;gap:12px;grid-template-columns:1fr!important}
    .suas-book-option{display:none!important;gap:10px;background:var(--card);padding:14px 16px;scroll-margin-top:88px}
    .suas-book-option.is-open{display:grid!important}
    .suas-book-option-head{display:grid;grid-template-columns:1fr auto auto;gap:8px;align-items:center}
    .suas-book-option h2{margin:4px 0 0;font-size:clamp(1.35rem,2.2vw,2rem);line-height:.88}
    .suas-book-desc{margin:4px 0 0;font-size:13px;line-height:1.3;font-weight:800;color:rgba(16,16,16,.68)}
    .suas-book-price-card{min-width:96px;border:2px solid var(--ink);border-radius:16px;background:#fff;box-shadow:0 3px 0 var(--ink);padding:8px;text-align:center}
    .suas-book-price-card span{display:block;margin-bottom:4px;font:900 8px/1 Futura,Arial,sans-serif;letter-spacing:.15em;text-transform:uppercase;color:rgba(16,16,16,.55)}
    .suas-book-price{display:block;font-size:clamp(1.3rem,2vw,1.8rem);line-height:.9}
    .suas-book-badge{display:inline-flex;width:fit-content;border:2px solid var(--ink);border-radius:999px;padding:6px 10px 5px;background:rgba(255,255,255,.76);box-shadow:0 3px 0 rgba(16,16,16,.18)}
    .suas-seat-meter{display:flex;flex-direction:column;justify-content:center;min-width:132px;padding:8px 10px;border:2px solid var(--ink);border-radius:16px;background:var(--lime);box-shadow:3px 3px 0 var(--ink)}
    .suas-seat-meter strong{font-size:1.15rem;line-height:.9}
    .suas-seat-meter span{font:900 9px/1.2 Futura,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase;opacity:.65;text-align:right}
    .suas-seat-meter.is-full{background:var(--pink)}
    .suas-seat-meter.is-low{background:var(--sun)}
    .suas-book-form{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:2px}
    .suas-book-field{display:grid;gap:4px}
    .suas-book-field[data-wide],.suas-book-button,.suas-book-note,.suas-book-addons,.suas-book-contact,.suas-type-grid,.suas-plus-choice,.suas-time-chips{grid-column:1/-1}
    .suas-book-label{color:rgba(16,16,16,.58)}
    .suas-book-input,.suas-book-select,.suas-bookings-page select.suas-book-select,.suas-bookings-page select.suas-time-select{position:static!important;width:100%!important;height:auto!important;min-height:48px!important;opacity:1!important;pointer-events:auto!important;appearance:auto!important;border:2px solid rgba(16,16,16,.18);border-radius:14px;padding:10px 12px;background:#fff;color:var(--ink);font:800 16px/1.2 Futura,'Futura PT',Arial,sans-serif;outline:none}
    .suas-book-input:focus,.suas-book-select:focus{border-color:var(--ink);box-shadow:0 0 0 4px rgba(255,159,194,.22)}
    .suas-book-addons{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
    .suas-book-addon{min-height:56px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:8px;border:1.8px solid rgba(16,16,16,.22);border-radius:15px;padding:9px 10px;background:rgba(255,255,255,.78);cursor:pointer}
    .suas-book-addon input{width:18px;height:18px;accent-color:var(--hot)}
    .suas-book-addon strong{font-size:12px;line-height:1.2;text-transform:uppercase}
    .suas-book-addon span{font-size:12px;font-weight:900;white-space:nowrap}
    .suas-book-addon:has(input:checked){border-color:var(--ink);background:#fff2a8;box-shadow:0 3px 0 var(--ink)}
    .suas-book-addon:has(input:disabled){opacity:.48;cursor:not-allowed}
    .suas-book-button{min-height:52px;border:2px solid var(--ink);border-radius:999px;padding:12px 15px;color:var(--ink);background:linear-gradient(180deg,#ffd4e5 0%,#ff9fc2 100%);box-shadow:0 4px 0 var(--ink);cursor:pointer;text-align:center;font-size:13px}
    .suas-book-button:hover{color:var(--ink);transform:translateY(2px);box-shadow:0 2px 0 var(--ink)}
    .suas-book-button[disabled]{cursor:not-allowed;opacity:.58;background:#fff}
    .suas-book-note{margin:0;border:1px solid rgba(16,16,16,.14);border-radius:13px;background:rgba(255,255,255,.7);padding:8px 10px;font-size:12px;line-height:1.35;font-weight:800;color:rgba(16,16,16,.62)}
    .suas-book-policy{padding:11px 12px;border:1.8px solid rgba(16,16,16,.25);border-radius:15px;background:rgba(255,255,255,.66)}
    .suas-book-policy strong{display:block;margin-bottom:4px;font:900 10px/1.2 Futura,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase}
    .suas-book-policy p{margin:0;font:700 12px/1.4 Futura,Arial,sans-serif;color:rgba(16,16,16,.68)}
    .suas-book-contact{display:none;padding:14px;border:2px solid var(--ink);border-radius:18px;background:#fff;box-shadow:3px 4px 0 var(--ink)}
    .suas-book-contact.is-on{display:grid;gap:10px}
    .suas-book-contact p{margin:0;font:800 14px/1.4 Futura,Arial,sans-serif}
    .suas-book-contact a{display:grid;place-items:center;min-height:48px;border:2px solid var(--ink);border-radius:999px;background:var(--sun);color:var(--ink);text-decoration:none;font:900 12px/1 Futura,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase}
    .suas-type-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
    .suas-type-card{position:relative;display:grid;grid-template-columns:1fr auto;gap:2px 8px;min-height:0;align-content:center;padding:10px 12px;border:2px solid rgba(16,16,16,.2);border-radius:16px;background:#fff;cursor:pointer;box-shadow:0 3px 0 rgba(16,16,16,.18)}
    .suas-type-card input{position:absolute;opacity:0;pointer-events:none}
    .suas-type-card em{grid-column:1;font:900 9px/1 Futura,Arial,sans-serif;letter-spacing:.14em;font-style:normal;opacity:.5}
    .suas-type-card strong{grid-column:1;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:1.15rem;line-height:.88;font-weight:400;text-transform:uppercase}
    .suas-type-card small{display:none}
    .suas-type-card b{grid-column:2;grid-row:1/span 2;align-self:center;font:900 13px/1 Futura,Arial,sans-serif}
    .suas-type-card.is-on{border-color:var(--ink);background:var(--sun);box-shadow:0 4px 0 var(--ink)}
    .suas-plus-choice{grid-column:1/-1;display:none;grid-template-columns:1fr 1fr;gap:8px}
    .suas-plus-choice.is-on{display:grid}
    .suas-plus-choice button{min-height:46px;border:2px solid rgba(16,16,16,.2);border-radius:999px;background:#fff;font:900 11px/1 Futura,Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase;cursor:pointer}
    .suas-plus-choice button.is-on{border-color:var(--ink);background:var(--blue);box-shadow:0 3px 0 var(--ink)}
    .suas-time-chips{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:8px}
    .suas-time-chips button{min-height:42px;padding:0 14px;border:2px solid rgba(16,16,16,.2);border-radius:999px;background:#fff;font:900 11px/1 Futura,Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase;cursor:pointer}
    .suas-time-chips button.is-on{border-color:var(--ink);background:var(--lime);box-shadow:0 3px 0 var(--ink)}
    .suas-time-chips button:disabled{opacity:.4;cursor:not-allowed}
    .suas-bookings-page .suas-visually-hidden,
    .suas-bookings-page #GuidedVariant,
    .suas-bookings-page #GuidedTime,
    .suas-bookings-page #SelfExperience,
    .suas-bookings-page #ParfumTime{
      position:absolute!important;width:1px!important;height:1px!important;min-height:0!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;opacity:0!important;pointer-events:none!important;border:0!important;padding:0!important;margin:0!important
    }
    @media(max-width:980px){.suas-book-wrap{width:min(760px,calc(100vw - 18px))}.suas-book-top,.suas-book-hours-grid,.suas-type-grid{grid-template-columns:1fr}.suas-book-option-head{grid-template-columns:1fr auto}.suas-book-form{grid-template-columns:1fr 1fr}}
    @media(max-width:700px){.suas-book-wrap{width:min(430px,calc(100vw - 14px));padding:14px 0 28px}.suas-book-card,.suas-book-panel,.suas-book-option{border-radius:18px;box-shadow:0 4px 0 var(--ink)}.suas-book-title{font-size:clamp(2.1rem,12vw,3rem)}.suas-book-form,.suas-plus-choice{grid-template-columns:1fr}.suas-book-input,.suas-book-select{min-height:48px!important;font-size:16px!important}}
  </style>

  <div class="suas-book-wrap">
    <div class="suas-book-top">
      <div class="suas-book-hero suas-book-card">
        <div class="suas-book-kicker">about us / bookings</div>
        <h1 class="suas-book-title">book the lab.</h1>
        <p class="suas-book-copy">Choose a session, pick a time, then check out. Prices follow the selected Shopify product.</p>
        <div class="suas-book-tabs" data-book-tabs>
          <button class="suas-book-tab is-on" type="button" data-kind="self">self-guided</button>
          <button class="suas-book-tab" type="button" data-kind="guided">guided class</button>
        </div>
      </div>
      <aside class="suas-book-panel">
        <h2>lab hours</h2>
        <div class="suas-book-hours-grid">
          <p style="--chip:#ffe8ef;"><b>Self-guided</b><br>Thu–Fri 1:00–5:00 PM<br>Sat–Sun 1:00–4:00 PM</p>
          <p style="--chip:#d9ff78;"><b>Guided · 75 min · 12 seats</b><br>Thu–Fri 6:00–7:15 PM<br>Sat 4:30–5:45 or 6:00–7:15 PM</p>
        </div>
        <p class="suas-book-hours-note">Closed Monday–Wednesday. No guided classes on Sunday. Walk-ins welcome in self-guided hours if a station is free. Guided cancel under 24 hours is non-refundable.</p>
      </aside>
    </div>

    <div class="suas-book-grid">
      {% liquid
        assign parfum_product = section.settings.parfum_product
        assign body_oil_product = section.settings.body_oil_product
        assign combo_product = section.settings.combo_product
        assign roll_on_product = section.settings.roll_on_product
        assign roll_on_addon_product = section.settings.roll_on_addon_product
        assign travel_addon_product = section.settings.travel_addon_product
        assign deluxe_product = section.settings.deluxe_product
        if deluxe_product == blank and section.settings.deluxe_product_handle != blank
          assign deluxe_handle = section.settings.deluxe_product_handle | handleize
          assign deluxe_product = all_products[deluxe_handle]
        endif

        assign self_form_product = parfum_product
        if self_form_product == blank
          assign self_form_product = body_oil_product
        endif
        if self_form_product == blank
          assign self_form_product = combo_product
        endif
        if self_form_product == blank
          assign self_form_product = roll_on_product
        endif

        assign parfum_main_variant = blank
        assign travel_addon_variant = blank
        if parfum_product != blank
          for variant in parfum_product.variants
            assign variant_name = variant.title | downcase
            if variant_name contains '15ml' or variant_name contains '15 ml' or variant_name contains 'travel' or variant_name contains 'second perfume'
              if travel_addon_variant == blank and variant.available
                assign travel_addon_variant = variant
              endif
            elsif parfum_main_variant == blank and variant.available
              assign parfum_main_variant = variant
            endif
          endfor
          if parfum_main_variant == blank
            assign parfum_main_variant = parfum_product.selected_or_first_available_variant
          endif
        endif

        assign body_oil_main_variant = body_oil_product.selected_or_first_available_variant
        assign combo_main_variant = combo_product.selected_or_first_available_variant
        assign roll_on_main_variant = blank
        assign roll_on_addon_variant = blank
        if roll_on_product != blank
          for variant in roll_on_product.variants
            assign variant_name = variant.title | downcase
            if variant_name contains 'add-on' or variant_name contains 'add on' or variant_name contains 'addon'
              if roll_on_addon_variant == blank and variant.available
                assign roll_on_addon_variant = variant
              endif
            elsif roll_on_main_variant == blank and variant.available
              assign roll_on_main_variant = variant
            endif
          endfor
          if roll_on_main_variant == blank
            assign roll_on_main_variant = roll_on_product.selected_or_first_available_variant
          endif
        endif

        if roll_on_addon_product != blank
          assign roll_on_addon_variant = roll_on_addon_product.selected_or_first_available_variant
        endif
        if travel_addon_product != blank
          assign travel_addon_variant = travel_addon_product.selected_or_first_available_variant
        endif
      %}

      <article class="suas-book-option is-open" id="self-guided" style="--card:#ffe8ef;">
        <div class="suas-book-option-head">
          <div>
            <span class="suas-book-badge">self-guided</span>
            <h2>Self-Guided Lab Experiment</h2>
            <p class="suas-book-desc" data-self-description>Perfume, roll-on, or combo sesh (perfume + body oil).</p>
          </div>
          <div class="suas-book-price-card"><span>price</span><strong class="suas-book-price" data-self-price aria-live="polite">{% if parfum_main_variant != blank %}{{ parfum_main_variant.price | money }}{% else %}pick one{% endif %}</strong></div>
        </div>

        {% if self_form_product != blank %}
          {% form 'product', self_form_product, class:'suas-book-form', data-booking-form:'self' %}
            <div class="suas-type-grid" data-self-types>
              {% if parfum_main_variant != blank %}
              <label class="suas-type-card is-on">
                <input type="radio" name="_self_type" value="{{ parfum_main_variant.id }}" data-label="Lab Session: Eau De Parfum (30mL)" data-price="{{ parfum_main_variant.price | money }}" data-copy="Create a custom 30mL eau de parfum at your own pace." checked{% unless parfum_main_variant.available %} disabled{% endunless %}>
                <em>01</em>
                <strong>perfume</strong>
                <small>Just the perfume experiment.</small>
                <b>{{ parfum_main_variant.price | money }}</b>
              </label>
              {% endif %}
              {% if roll_on_main_variant != blank %}
              <label class="suas-type-card">
                <input type="radio" name="_self_type" value="{{ roll_on_main_variant.id }}" data-label="Lab Session: Roll-On Perfume (10mL)" data-price="{{ roll_on_main_variant.price | money }}" data-copy="Create a portable 10mL roll-on perfume oil."{% unless roll_on_main_variant.available %} disabled{% endunless %}>
                <em>02</em>
                <strong>roll-on</strong>
                <small>The roll-on perfume experiment.</small>
                <b>{{ roll_on_main_variant.price | money }}</b>
              </label>
              {% endif %}
              {% if combo_main_variant != blank %}
              <label class="suas-type-card">
                <input type="radio" name="_self_type" value="{{ combo_main_variant.id }}" data-label="Lab Session Combo" data-price="{{ combo_main_variant.price | money }}" data-copy="Combo sesh: a perfume experiment plus a body oil. Body oil is not its own session."{% unless combo_main_variant.available %} disabled{% endunless %}>
                <em>03</em>
                <strong>combo sesh</strong>
                <small>Perfume and a body oil together.</small>
                <b>{{ combo_main_variant.price | money }}</b>
              </label>
              {% endif %}
            </div>
            <label class="suas-book-label suas-visually-hidden" for="SelfExperience">choose your experiment</label>
            <select class="suas-book-select suas-visually-hidden" id="SelfExperience" name="id" required>
              <option value="">choose experiment</option>
              {% if parfum_main_variant != blank %}<option value="{{ parfum_main_variant.id }}" data-experience="Lab Session: Eau De Parfum (30mL)" data-price="{{ parfum_main_variant.price | money }}" selected{% unless parfum_main_variant.available %} disabled{% endunless %}>Lab Session: Eau De Parfum (30mL)</option>{% endif %}
              {% if roll_on_main_variant != blank %}<option value="{{ roll_on_main_variant.id }}" data-experience="Lab Session: Roll-On Perfume (10mL)" data-price="{{ roll_on_main_variant.price | money }}"{% unless roll_on_main_variant.available %} disabled{% endunless %}>Lab Session: Roll-On Perfume (10mL)</option>{% endif %}
              {% if combo_main_variant != blank %}<option value="{{ combo_main_variant.id }}" data-experience="Lab Session Combo" data-price="{{ combo_main_variant.price | money }}"{% unless combo_main_variant.available %} disabled{% endunless %}>Lab Session Combo</option>{% endif %}
            </select>
            <input type="hidden" name="properties[Booking type]" value="Self-Guided Lab Experiment">
            <input type="hidden" name="properties[Selected experience]" value="" data-self-experience-property>
            <div class="suas-book-field"><label class="suas-book-label" for="ParfumDate">date</label><input class="suas-book-input" id="ParfumDate" type="date" name="properties[Preferred date]" required></div>
            <div class="suas-book-field"><label class="suas-book-label" for="ParfumGuests">guests</label><input class="suas-book-input" id="ParfumGuests" type="number" name="quantity" min="1" value="1"></div>
            <div class="suas-book-field"><label class="suas-book-label" for="ParfumPhone">phone</label><input class="suas-book-input" id="ParfumPhone" type="tel" name="properties[Phone number]" required></div>
            <div class="suas-book-field"><label class="suas-book-label" for="ParfumName">name</label><input class="suas-book-input" id="ParfumName" type="text" name="properties[Guest name]" required></div>
            <div class="suas-book-field" data-wide>
              <span class="suas-book-label">arrival time</span>
              <div class="suas-time-chips" data-self-chips></div>
              <select class="suas-book-select suas-time-select suas-visually-hidden" id="ParfumTime" name="properties[Preferred time]" required><option value="">choose time</option><option>1:00 PM</option><option>2:00 PM</option><option>3:00 PM</option><option>4:00 PM</option><option>5:00 PM</option></select>
            </div>
            <button class="suas-book-button" type="submit">add booking to cart</button>
          {% endform %}
        {% else %}
          <button class="suas-book-button" disabled>connect booking products</button>
        {% endif %}
      </article>

      <article class="suas-book-option" id="guided-class" style="--card:#d9ff78;">
        <div class="suas-book-option-head">
          <div>
            <span class="suas-book-badge">guided class · 75 min</span>
            <h2>Guided Lab Session</h2>
            <p class="suas-book-desc" data-guided-description>Perfume, perfume + one, or signature collection.</p>
          </div>
          <div class="suas-seat-meter" data-suas-seat-meter><strong data-suas-seat-text>12 of 12 seats left</strong><span data-suas-seat-hint>pick date + time</span></div>
          <div class="suas-book-price-card"><span>price</span><strong class="suas-book-price" data-guided-price aria-live="polite">$85.00</strong></div>
        </div>

        {% if deluxe_product != blank %}
          {% form 'product', deluxe_product, class:'suas-book-form', data-booking-form:'guided' %}
            <input type="hidden" name="properties[Booking type]" value="Guided Lab Session">
            <input type="hidden" name="properties[Class length]" value="75 minutes">
            <input type="hidden" name="properties[Guided session type]" value="Perfume experiment" data-guided-type-property>
            <input type="hidden" name="properties[Second experiment]" value="" data-guided-plus-property>
            <input type="hidden" name="properties[Guided package price]" value="$85.00" data-guided-price-property>
            <div class="suas-type-grid" data-guided-types>
              <label class="suas-type-card is-on">
                <input type="radio" name="_guided_type" value="perfume" data-label="Perfume experiment" data-price="$85.00" data-copy="Create a custom perfume with hands-on guidance from start to finish." checked>
                <em>01</em>
                <strong>perfume</strong>
                <small>Just the perfume experiment.</small>
                <b>$85</b>
              </label>
              <label class="suas-type-card">
                <input type="radio" name="_guided_type" value="plus" data-label="Perfume + body oil or butter creme" data-price="$115.00" data-copy="Create a guided perfume, then add a body oil or butter creme experiment.">
                <em>02</em>
                <strong>perfume + one</strong>
                <small>Perfume with a body oil or butter creme experiment.</small>
                <b>$115</b>
              </label>
              <label class="suas-type-card">
                <input type="radio" name="_guided_type" value="signature" data-label="Signature collection" data-price="$150.00" data-copy="Create a perfume, body oil, and butter creme in one guided class.">
                <em>03</em>
                <strong>signature</strong>
                <small>Perfume, body oil, and butter creme.</small>
                <b>$150</b>
              </label>
            </div>
            <div class="suas-plus-choice" data-guided-plus>
              <button type="button" data-plus="Body Oil">body oil</button>
              <button type="button" data-plus="Butter Creme">butter creme</button>
            </div>
            {% if deluxe_product.has_only_default_variant %}
              <input type="hidden" name="id" value="{{ deluxe_product.selected_or_first_available_variant.id }}">
            {% else %}
              <label class="suas-book-label suas-visually-hidden" for="GuidedVariant">class seat</label>
              <select class="suas-book-select suas-visually-hidden" id="GuidedVariant" name="id">
                {% for variant in deluxe_product.variants %}
                  {% assign guided_variant_name = variant.title | downcase %}
                  {% if variant.inventory_management != blank %}
                    {% assign guided_seats = variant.inventory_quantity %}
                  {% else %}
                    {% assign guided_seats = 12 %}
                  {% endif %}
                  <option value="{{ variant.id }}" data-price="{{ variant.price | money }}" data-title="{{ variant.title | escape }}" data-seats="{{ guided_seats }}"{% unless variant.available %} disabled{% endunless %}>{{ variant.title }}</option>
                {% endfor %}
              </select>
            {% endif %}
            <div class="suas-book-field"><label class="suas-book-label" for="GuidedDate">class date</label><input class="suas-book-input" id="GuidedDate" type="date" name="properties[Class date]" required></div>
            <div class="suas-book-field"><label class="suas-book-label" for="GuidedGuests">guests</label><input class="suas-book-input" id="GuidedGuests" type="number" name="quantity" min="1" max="12" value="1"></div>
            <div class="suas-book-field"><label class="suas-book-label" for="GuidedPhone">phone</label><input class="suas-book-input" id="GuidedPhone" type="tel" name="properties[Phone number]" required></div>
            <div class="suas-book-field"><label class="suas-book-label" for="GuidedName">name</label><input class="suas-book-input" id="GuidedName" type="text" name="properties[Guest name]" required></div>
            <div class="suas-book-field" data-wide>
              <span class="suas-book-label">class time</span>
              <div class="suas-time-chips" data-guided-chips></div>
              <select class="suas-book-select suas-time-select suas-visually-hidden" id="GuidedTime" name="properties[Class time]" required><option value="">choose time</option><option>Thursday 6:00 PM - 7:15 PM</option><option>Friday 6:00 PM - 7:15 PM</option><option>Saturday 4:30 PM - 5:45 PM</option><option>Saturday 6:00 PM - 7:15 PM</option></select>
            </div>
            {% if deluxe_product.available %}<button class="suas-book-button" type="submit" data-guided-submit>add booking to cart</button>{% else %}<button class="suas-book-button" disabled data-guided-submit>this class is full</button>{% endif %}
            <div class="suas-book-contact" data-guided-full>
              <p>This class is full. Send us a note and we will see if we can still fit your party in.</p>
              <a href="/pages/contact-us">contact us</a>
            </div>
          {% endform %}
        {% else %}
          <button class="suas-book-button" disabled>connect guided product</button>
        {% endif %}
      </article>
    </div>
  </div>

  <script>
    (function () {
      var root = document.currentScript.closest('.suas-bookings-page');
      if (!root) return;
      var today = new Date();
      var stamp = today.getFullYear() + '-' + String(today.getMonth() + 1).padStart(2, '0') + '-' + String(today.getDate()).padStart(2, '0');
      var dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
      var selfTimes = {
        0: ['1:00 PM', '2:00 PM', '3:00 PM', '4:00 PM'],
        4: ['1:00 PM', '2:00 PM', '3:00 PM', '4:00 PM', '5:00 PM'],
        5: ['1:00 PM', '2:00 PM', '3:00 PM', '4:00 PM', '5:00 PM'],
        6: ['1:00 PM', '2:00 PM', '3:00 PM', '4:00 PM']
      };
      var guidedTimes = {
        4: ['Thursday 6:00 PM - 7:15 PM'],
        5: ['Friday 6:00 PM - 7:15 PM'],
        6: ['Saturday 4:30 PM - 5:45 PM', 'Saturday 6:00 PM - 7:15 PM']
      };
      var TOTAL = 12;
      var remaining = TOTAL;

      function showBookKind(kind) {
        var selfCard = root.querySelector('#self-guided');
        var guidedCard = root.querySelector('#guided-class');
        if (selfCard) selfCard.classList.toggle('is-open', kind === 'self');
        if (guidedCard) guidedCard.classList.toggle('is-open', kind === 'guided');
        root.querySelectorAll('[data-book-tabs] .suas-book-tab').forEach(function (tab) {
          tab.classList.toggle('is-on', tab.getAttribute('data-kind') === kind);
        });
        root.querySelectorAll('#self-guided [required], #self-guided select[name="id"]').forEach(function (field) {
          if (kind === 'self') field.setAttribute('required', 'required');
          else field.removeAttribute('required');
        });
        root.querySelectorAll('#guided-class [required], #guided-class select[name="id"]').forEach(function (field) {
          if (kind === 'guided') field.setAttribute('required', 'required');
          else field.removeAttribute('required');
        });
      }
      root.querySelectorAll('[data-book-tabs] .suas-book-tab').forEach(function (tab) {
        tab.addEventListener('click', function () { showBookKind(tab.getAttribute('data-kind')); });
      });
      showBookKind((location.hash || '').indexOf('guided') !== -1 ? 'guided' : 'self');

      function dateDay(value) {
        if (!value) return null;
        var bits = value.split('-').map(Number);
        return new Date(bits[0], bits[1] - 1, bits[2]).getDay();
      }
      function reject(input, message) {
        alert(message);
        input.value = '';
        input.focus();
      }
      function setOptions(select, options) {
        if (!select) return;
        var current = select.value;
        select.innerHTML = '<option value="">choose time</option>' + options.map(function (time) { return '<option>' + time + '</option>'; }).join('');
        if (options.indexOf(current) !== -1) select.value = current;
      }

      root.querySelectorAll('input[type="date"]').forEach(function (input) { input.min = stamp; });

      var selfForm = root.querySelector('[data-booking-form="self"]');
      var selfChips = root.querySelector('[data-self-chips]');
      function renderSelfChips(options, selected) {
        if (!selfChips) return;
        selfChips.innerHTML = '';
        if (!options.length) {
          var empty = document.createElement('button');
          empty.type = 'button';
          empty.disabled = true;
          empty.textContent = 'pick Thursday–Sunday';
          selfChips.appendChild(empty);
          return;
        }
        options.forEach(function (time) {
          var button = document.createElement('button');
          button.type = 'button';
          button.textContent = time;
          button.classList.toggle('is-on', time === selected);
          button.addEventListener('click', function () {
            selfTime.value = time;
            renderSelfChips(options, time);
          });
          selfChips.appendChild(button);
        });
      }
      if (selfForm) {
        var selfDate = selfForm.querySelector('input[type="date"]');
        var selfTime = selfForm.querySelector('select[name="properties[Preferred time]"]');
        var updateSelf = function () {
          var day = dateDay(selfDate.value);
          if (day === null) {
            renderSelfChips([], '');
            return;
          }
          var options = selfTimes[day] || [];
          if (!options.length) {
            setOptions(selfTime, []);
            renderSelfChips([], '');
            reject(selfDate, dayNames[day] + ' is closed for self-guided bookings. Please choose Thursday, Friday, Saturday, or Sunday.');
            return;
          }
          setOptions(selfTime, options);
          if (options.indexOf(selfTime.value) === -1) selfTime.value = options[0];
          renderSelfChips(options, selfTime.value);
        };
        selfDate.addEventListener('change', updateSelf);
        renderSelfChips([], '');
        selfForm.addEventListener('submit', function (event) {
          var day = dateDay(selfDate.value);
          var options = selfTimes[day] || [];
          if (!options.length || options.indexOf(selfTime.value) === -1) {
            event.preventDefault();
            alert('That self-guided time is outside the Lab window. Thursday and Friday are 1:00 PM – 5:00 PM. Saturday and Sunday are 1:00 PM – 4:00 PM.');
          }
        });
      }

      var selfExperience = root.querySelector('#SelfExperience');
      var selfExperienceProperty = root.querySelector('[data-self-experience-property]');
      var selfPrice = root.querySelector('[data-self-price]');
      var selfDescription = root.querySelector('[data-self-description]');
      var selfTypes = root.querySelector('[data-self-types]');
      function syncSelfType() {
        if (!selfTypes) return;
        var input = selfTypes.querySelector('input:checked');
        selfTypes.querySelectorAll('.suas-type-card').forEach(function (card) {
          card.classList.toggle('is-on', card.contains(input));
        });
        if (!input) return;
        if (selfExperience) selfExperience.value = input.value;
        if (selfExperienceProperty) selfExperienceProperty.value = input.dataset.label || '';
        if (selfPrice) selfPrice.textContent = input.dataset.price || '';
        if (selfDescription) selfDescription.textContent = input.dataset.copy || '';
      }
      if (selfTypes) {
        selfTypes.addEventListener('change', syncSelfType);
        syncSelfType();
      } else if (selfExperience && selfExperienceProperty) {
        selfExperience.addEventListener('change', syncSelfType);
      }

      if (selfForm) {
        selfForm.addEventListener('submit', async function (event) {
          if (event.defaultPrevented) return;
          var addons = Array.prototype.slice.call(selfForm.querySelectorAll('[data-addon-variant]:checked')).filter(function (box) { return box.dataset.addonVariant; });
          if (!addons.length) return;
          event.preventDefault();
          var button = selfForm.querySelector('[type="submit"]');
          button.disabled = true;
          button.textContent = 'reserving...';
          var data = new FormData(selfForm);
          var properties = {};
          data.forEach(function (value, key) {
            var match = key.match(/^properties\[(.+)\]$/);
            if (match && value) properties[match[1]] = value;
          });
          var quantity = Math.max(1, Number(data.get('quantity')) || 1);
          var items = [{ id: Number(data.get('id')), quantity: quantity, properties: properties }];
          addons.forEach(function (box) {
            items.push({
              id: Number(box.dataset.addonVariant),
              quantity: quantity,
              properties: {
                'Add-on for': properties['Selected experience'] || 'Self-Guided Lab Experiment',
                'Booking date': properties['Preferred date'] || '',
                'Booking time': properties['Preferred time'] || '',
                'Guest name': properties['Guest name'] || '',
                'Add-on': box.dataset.addonName || 'Add-on'
              }
            });
          });
          try {
            var response = await fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ items: items }) });
            if (!response.ok) throw new Error('Cart error');
            window.location.assign('/cart');
          } catch (error) {
            button.disabled = false;
            button.textContent = 'add booking to cart';
            alert('We could not add that booking and its add-ons. Please confirm the selected variants are available and try again.');
          }
        }, { capture: false });
      }

      var guidedForm = root.querySelector('[data-booking-form="guided"]');
      var guidedVariant = root.querySelector('#GuidedVariant');
      var guidedPrice = root.querySelector('[data-guided-price]');
      var guidedDescription = root.querySelector('[data-guided-description]');
      var guidedDate = guidedForm ? guidedForm.querySelector('input[type="date"]') : null;
      var guidedTime = guidedForm ? guidedForm.querySelector('select[name="properties[Class time]"]') : null;
      var guidedSubmit = root.querySelector('[data-guided-submit]');
      var guidedFull = root.querySelector('[data-guided-full]');
      var seatMeter = root.querySelector('[data-suas-seat-meter]');
      var seatText = root.querySelector('[data-suas-seat-text]');
      var seatHint = root.querySelector('[data-suas-seat-hint]');
      var typeWrap = root.querySelector('[data-guided-types]');
      var plusWrap = root.querySelector('[data-guided-plus]');
      var chips = root.querySelector('[data-guided-chips]');
      var typeProperty = root.querySelector('[data-guided-type-property]');
      var plusProperty = root.querySelector('[data-guided-plus-property]');
      var priceProperty = root.querySelector('[data-guided-price-property]');

      function selectedType() {
        return typeWrap ? typeWrap.querySelector('input:checked') : null;
      }
      function typeKey() {
        var input = selectedType();
        return input ? input.value : 'perfume';
      }
      function variantKind(title) {
        var t = String(title || '').toLowerCase();
        if (t.indexOf('signature') !== -1 || t.indexOf('all three') !== -1 || t.indexOf('deluxe') !== -1) return 'signature';
        if (t.indexOf('body oil') !== -1 || t.indexOf('butter') !== -1 || t.indexOf('+') !== -1 || t.indexOf('115') !== -1) return 'plus';
        return 'perfume';
      }
      function matchGuidedVariant() {
        if (!guidedVariant) return;
        var date = guidedDate ? guidedDate.value : '';
        var time = guidedTime ? guidedTime.value : '';
        var kind = typeKey();
        var day = dateDay(date);
        var dayName = day === null ? '' : dayNames[day].slice(0, 3).toLowerCase();
        var timeBit = (time.split(' ').slice(1).join(' ') || time).replace(/\s+/g, '').toLowerCase();
        var options = Array.prototype.slice.call(guidedVariant.options);
        var scored = options.filter(function (opt) { return opt.value && !opt.disabled; }).sort(function (a, b) {
          function score(opt) {
            var title = (opt.dataset.title || opt.textContent || '').toLowerCase().replace(/\s+/g, '');
            var s = 0;
            if (variantKind(opt.dataset.title || opt.textContent) === kind) s += 8;
            if (dayName && title.indexOf(dayName) !== -1) s += 4;
            if (timeBit && title.indexOf(timeBit.replace(/-/g, '')) !== -1) s += 4;
            return s;
          }
          return score(b) - score(a);
        });
        if (scored[0]) guidedVariant.value = scored[0].value;
      }
      function syncGuidedType() {
        var input = selectedType();
        if (!typeWrap) return;
        typeWrap.querySelectorAll('.suas-type-card').forEach(function (card) {
          card.classList.toggle('is-on', card.contains(input));
        });
        if (plusWrap) plusWrap.classList.toggle('is-on', typeKey() === 'plus');
        if (typeProperty && input) typeProperty.value = input.dataset.label || input.value;
        if (priceProperty && input) priceProperty.value = input.dataset.price || '';
        if (guidedPrice && input) guidedPrice.textContent = input.dataset.price || '$85.00';
        if (guidedDescription && input) guidedDescription.textContent = input.dataset.copy || '';
        if (typeKey() !== 'plus' && plusProperty) plusProperty.value = '';
        matchGuidedVariant();
        paintSeats();
      }
      if (typeWrap) {
        typeWrap.addEventListener('change', syncGuidedType);
        syncGuidedType();
      }
      if (plusWrap) {
        plusWrap.addEventListener('click', function (event) {
          var button = event.target.closest('[data-plus]');
          if (!button) return;
          plusWrap.querySelectorAll('[data-plus]').forEach(function (item) { item.classList.toggle('is-on', item === button); });
          if (plusProperty) plusProperty.value = button.getAttribute('data-plus');
        });
      }

      function renderTimeChips(options, selected) {
        if (!chips) return;
        chips.innerHTML = '';
        if (!options.length) {
          var empty = document.createElement('button');
          empty.type = 'button';
          empty.disabled = true;
          empty.textContent = 'pick a Thursday, Friday, or Saturday';
          chips.appendChild(empty);
          return;
        }
        options.forEach(function (time) {
          var button = document.createElement('button');
          button.type = 'button';
          button.textContent = time.replace(/^(Thursday|Friday|Saturday)\s+/, '');
          button.classList.toggle('is-on', time === selected);
          button.addEventListener('click', function () {
            guidedTime.value = time;
            renderTimeChips(options, time);
            matchGuidedVariant();
            paintSeats();
          });
          chips.appendChild(button);
        });
      }

      if (guidedForm && guidedDate && guidedTime) {
        var updateGuided = function () {
          var day = dateDay(guidedDate.value);
          if (day === null) {
            renderTimeChips([], '');
            return;
          }
          var options = guidedTimes[day] || [];
          if (!options.length) {
            setOptions(guidedTime, []);
            renderTimeChips([], '');
            reject(guidedDate, dayNames[day] + ' is not available for guided Lab classes. Please choose Thursday, Friday, or Saturday.');
            paintSeats();
            return;
          }
          setOptions(guidedTime, options);
          if (options.indexOf(guidedTime.value) === -1) guidedTime.value = options[0];
          renderTimeChips(options, guidedTime.value);
          matchGuidedVariant();
          paintSeats();
        };
        guidedDate.addEventListener('change', updateGuided);
        renderTimeChips([], '');
        guidedForm.addEventListener('submit', function (event) {
          if (typeKey() === 'plus' && plusProperty && !plusProperty.value) {
            event.preventDefault();
            alert('Pick body oil or butter creme for that guided session.');
            return;
          }
          var day = dateDay(guidedDate.value);
          var options = guidedTimes[day] || [];
          if (!options.length || options.indexOf(guidedTime.value) === -1) {
            event.preventDefault();
            alert('That guided class time does not match the selected date. Guided classes are Thursday and Friday 6:00 PM – 7:15 PM, and Saturday 4:30 PM – 5:45 PM or 6:00 PM – 7:15 PM.');
            return;
          }
          var guests = Math.max(1, Number((guidedForm.querySelector('[name="quantity"]') || {}).value || 1));
          if (remaining <= 0 || guests > remaining) {
            event.preventDefault();
            if (guidedFull) guidedFull.classList.add('is-on');
            alert('This class is full. Contact us and we will see if we can still fit you in.');
          }
        });
      }

      async function paintSeats() {
        remaining = TOTAL;
        var option = guidedVariant ? guidedVariant.options[guidedVariant.selectedIndex] : null;
        if (option && option.dataset.seats) remaining = Math.max(0, Number(option.dataset.seats));
        if (option && option.disabled) remaining = 0;
        var date = guidedDate ? guidedDate.value : '';
        var time = guidedTime ? guidedTime.value : '';
        if (!date && !option) {
          if (seatText) seatText.textContent = TOTAL + ' of ' + TOTAL + ' seats left';
          if (seatHint) seatHint.textContent = 'pick a class date + time';
          if (guidedFull) guidedFull.classList.remove('is-on');
          return;
        }
        try {
          var cart = await fetch('/cart.js', { credentials: 'same-origin' }).then(function (r) { return r.json(); });
          (cart.items || []).forEach(function (item) {
            var props = item.properties || {};
            var sameVariant = option && String(item.id) === String(option.value);
            var sameSlot = props['Class date'] === date && (!time || props['Class time'] === time);
            if (sameVariant || sameSlot) remaining -= Number(item.quantity || 0);
          });
        } catch (e) {}
        remaining = Math.max(0, remaining);
        if (seatText) seatText.textContent = remaining + ' of ' + TOTAL + ' seats left';
        if (seatHint) seatHint.textContent = remaining ? 'this guided class' : 'class is full';
        if (seatMeter) {
          seatMeter.classList.toggle('is-low', remaining > 0 && remaining <= 3);
          seatMeter.classList.toggle('is-full', remaining <= 0);
        }
        var qty = guidedForm ? guidedForm.querySelector('[name="quantity"]') : null;
        if (qty) {
          qty.max = String(Math.max(1, remaining || 1));
          if (remaining > 0 && Number(qty.value || 1) > remaining) qty.value = String(remaining);
        }
        if (guidedSubmit) {
          guidedSubmit.disabled = remaining <= 0;
          guidedSubmit.style.display = remaining <= 0 ? 'none' : '';
          if (remaining > 0) guidedSubmit.textContent = 'add booking to cart';
        }
        if (guidedFull) guidedFull.classList.toggle('is-on', remaining <= 0);
      }

      paintSeats();
    })();
  </script>
</section>
{% schema %}{"name":"SUAS Bookings Page","settings":[{"type":"product","id":"body_oil_product","label":"Self-Guided Body Oil product"},{"type":"product","id":"parfum_product","label":"Self-Guided Lab Experiment product"},{"type":"product","id":"combo_product","label":"Self-Guided Combo product"},{"type":"product","id":"roll_on_product","label":"Self-Guided Roll-On Perfume product"},{"type":"product","id":"roll_on_addon_product","label":"Roll-On add-on product"},{"type":"product","id":"travel_addon_product","label":"Travel / second perfume add-on product"},{"type":"product","id":"deluxe_product","label":"Guided Lab Session product"},{"type":"text","id":"deluxe_product_handle","label":"Guided fallback product handle","info":"Use this if the product picker will not load the guided product."}],"presets":[{"name":"SUAS Bookings Page"}]}{% endschema %}

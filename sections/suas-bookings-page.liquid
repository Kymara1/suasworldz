            if (charmTime) setOptions(charmTime, []);
            renderCharmChips([], '');
            paintCharmSeats();
            if (charmStatus) charmStatus.textContent = 'Charm Bar bookings open November 14.';
            reject(charmDate, 'Charm Bar bookings open November 14. Pick a date from then on.');
            return;
          }
          var day = dateDay(charmDate.value);
          var slots = charmSlotsForDay(day);
          if (!slots.length) {
            if (charmTime) setOptions(charmTime, []);
            renderCharmChips([], '');
            paintCharmSeats();
            if (charmStatus) charmStatus.textContent = (dayNames[day] || 'That day') + ' is closed. Pick Thursday through Sunday.';
            reject(charmDate, (dayNames[day] || 'That day') + ' is closed for Charm Bar. Please choose Thursday, Friday, Saturday, or Sunday.');
            return;
          }
          if (charmStatus) charmStatus.textContent = 'Four seats per 45-minute slot. Closed Monday through Wednesday. Opens November 14.';
          setOptions(charmTime, slots);
          if (slots.indexOf(charmTime.value) === -1) charmTime.value = slots[0];
          renderCharmChips(slots, charmTime.value);
          paintCharmSeats();
        }
        charmDate.addEventListener('change', fillCharmTimes);
        if (charmQty) charmQty.addEventListener('change', paintCharmSeats);
        renderCharmChips([], '');
        paintCharmSeats();
        charmForm.addEventListener('submit', async function (event) {
          event.preventDefault();
          syncCharmType();
          await paintCharmSeats();
          var guests = Math.max(1, Math.min(CHARM_TOTAL, Number((charmQty && charmQty.value) || 1)));
          var day = dateDay(charmDate.value);
          var slots = charmSlotsForDay(day);
          if (!charmExperience || !charmExperience.value) {
            if (charmStatus) charmStatus.textContent = 'Pick a piece first.';
            return;
          }
          if (!charmDate.value || charmDate.value < OPENS) {
            if (charmStatus) charmStatus.textContent = 'Charm Bar bookings open November 14.';
            return;
          }
          if (!slots.length || slots.indexOf(charmTime.value) === -1) {
            if (charmStatus) charmStatus.textContent = 'Pick a Thursday through Sunday 45-minute Charm Bar slot.';
            return;
          }
          if (charmRemaining <= 0 || guests > charmRemaining) {
            if (charmStatus) charmStatus.textContent = 'That slot only has ' + charmRemaining + ' of ' + CHARM_TOTAL + ' seats left.';
            return;
          }
          var pieceLabel = (charmTypes && charmTypes.querySelector('input:checked') && charmTypes.querySelector('input:checked').dataset.label) || charmExperience.options[charmExperience.selectedIndex].text;
          var properties = {
            'Booking type': 'Charm Bar Reservation',
            'Experience': pieceLabel,
            'Reservation date': charmDate.value,
            'Estimated arrival': charmTime.value,
            'Guest name': charmForm.querySelector('#BookCharmName').value,
            'Email': (charmForm.querySelector('#BookCharmEmail') || {}).value || '',
            'Phone number': charmForm.querySelector('#BookCharmPhone').value,
            'Seats reserved': String(guests)
          };
          var items = [{ id: Number(charmExperience.value), quantity: guests, properties: properties }];
          charmForm.querySelectorAll('[data-addon-variant]:checked').forEach(function (box) {
            if (!box.dataset.addonVariant) return;
            items.push({
              id: Number(box.dataset.addonVariant),
              quantity: 1,
              properties: {
                'Add-on for': properties.Experience,
                'Reservation date': charmDate.value,
                'Guest name': properties['Guest name']
              }
            });
          });
          if (charmSubmit) {
            charmSubmit.disabled = true;
            charmSubmit.textContent = 'reserving...';
          }
          if (charmStatus) charmStatus.textContent = 'Adding your Charm Bar reservation...';
          try {
            var response = await fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify({ items: items })
            });
            if (!response.ok) throw new Error('Cart request failed');
            window.location.href = '/cart';
          } catch (err) {
            if (charmStatus) charmStatus.textContent = 'That reservation could not be added. Try again or walk in during Lab hours.';
            if (charmSubmit) {
              charmSubmit.disabled = false;
              charmSubmit.textContent = 'pay to hold seat';
            }
          }
        });
      }
    })();
  </script>
  </div>
</section>

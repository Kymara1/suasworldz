  <script type="application/json" id="suas-lab-seats-data">
  {%- if shop.metafields.suas.lab_seats.value != blank -%}
    {{ shop.metafields.suas.lab_seats.value | json }}
  {%- elsif shop.metafields.suas.lab_seats != blank -%}
    {{ shop.metafields.suas.lab_seats | json }}
  {%- else -%}
    {"slots":{},"labCap":14,"charmCap":4}
  {%- endif -%}
  </script>
  <script>
    (function () {
      var root = document.currentScript.closest('.suas-bookings-page');
      if (!root) return;
      var OPENS = '2026-11-14';
      var soldSeats = { slots: {}, labCap: 14, charmCap: 4 };
      try {
        var seatNode = document.getElementById('suas-lab-seats-data');
        if (seatNode && seatNode.textContent) soldSeats = JSON.parse(seatNode.textContent);
      } catch (e) {}
      function soldFor(kind, date, time) {
        if (!date || !time || !soldSeats || !soldSeats.slots) return 0;
        var key = kind + '|' + date + '|' + time;
        var row = soldSeats.slots[key];
        if (!row) return 0;
        return Math.max(0, Number(row.seats || 0));
      }
      function nyStamp() {
        try {
          return new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
        } catch (e) {
          var t = new Date();
          return t.getFullYear() + '-' + String(t.getMonth() + 1).padStart(2, '0') + '-' + String(t.getDate()).padStart(2, '0');
        }
      }
      var stamp = nyStamp() > OPENS ? nyStamp() : OPENS;
      var dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
      var selfTimes = {
        0: ['1:00 PM', '2:00 PM', '3:00 PM', '4:00 PM'],
        4: ['1:00 PM', '2:00 PM', '3:00 PM', '4:00 PM', '5:00 PM'],
        5: ['1:00 PM', '2:00 PM', '3:00 PM', '4:00 PM', '5:00 PM'],
        6: ['1:00 PM', '2:00 PM', '3:00 PM', '4:00 PM']
      };
      var guidedTimes = {
        4: ['Thursday 6:00 PM - 7:15 PM'],
        5: ['Friday 6:00 PM - 7:15 PM'],
        6: ['Saturday 4:30 PM - 5:45 PM', 'Saturday 6:00 PM - 7:15 PM']
      };
      var TOTAL = 14;
      var CHARM_TOTAL = 4;
      var remaining = TOTAL;
      var selfRemaining = TOTAL;
      var charmRemaining = CHARM_TOTAL;

      function pad2(n) { return String(n).padStart(2, '0'); }
      function parseClock(text) {
        var match = String(text || '').match(/(\d{1,2}):(\d{2})\s*(AM|PM)/i);
        if (!match) return null;
        var hour = Number(match[1]);
        var minute = Number(match[2]);
        var ap = match[3].toUpperCase();
        if (ap === 'PM' && hour !== 12) hour += 12;
        if (ap === 'AM' && hour === 12) hour = 0;
        return { hour: hour, minute: minute };
      }
      function formatClock(totalMinutes) {
        var hour = Math.floor(totalMinutes / 60);
        var minute = totalMinutes % 60;
        var ap = hour >= 12 ? 'PM' : 'AM';
        var display = hour % 12;
        if (display === 0) display = 12;
        return display + ':' + pad2(minute) + ' ' + ap;
      }
      function charmSlotsForDay(day) {
        if (day !== 0 && day !== 4 && day !== 5 && day !== 6) return [];
        var endHour = (day === 0 || day === 6) ? 16 : 17;
        var slots = [];
        for (var m = 13 * 60; m + 45 <= endHour * 60; m += 45) slots.push(formatClock(m));
        return slots;
      }
      async function fetchCart() {
        try {
          return await fetch('/cart.js', { credentials: 'same-origin' }).then(function (r) { return r.json(); });
        } catch (e) {
          return { items: [] };
        }
      }
      function seatsTakenInCart(items, dateKey, timeKey, dateValue, timeValue) {
        var taken = 0;
        (items || []).forEach(function (item) {
          var props = item.properties || {};
          if (String(props[dateKey] || '') !== String(dateValue || '')) return;
          if (String(props[timeKey] || '') !== String(timeValue || '')) return;
          var reserved = Number(props['Seats reserved'] || item.quantity || 0);
          taken += Math.max(0, reserved);
        });
        return taken;
      }
      function clockStamp(date, clock) {
        return String(date).replace(/-/g, '') + 'T' + pad2(clock.hour) + pad2(clock.minute) + '00';
      }
      function addMinutes(clock, mins) {
        var total = clock.hour * 60 + clock.minute + mins;
        return { hour: Math.floor(total / 60) % 24, minute: total % 60 };
      }
      function fieldValue(form, name) {
        var el = form && form.querySelector('[name="' + name + '"]');
        return el ? String(el.value || '').trim() : '';
      }
      function googleCalUrl(title, date, start, end, details) {
        return 'https://calendar.google.com/calendar/render?action=TEMPLATE'
          + '&text=' + encodeURIComponent(title)
          + '&dates=' + clockStamp(date, start) + '/' + clockStamp(date, end)
          + '&ctz=America/New_York'
          + '&details=' + encodeURIComponent(details)
          + '&location=' + encodeURIComponent('188 W Franklin Blvd, Gastonia, NC 28052');
      }
      function stampCalendar(form, title, date, timeText, minutes) {
        if (!form) return;
        var guest = fieldValue(form, 'properties[Guest name]');
        var phone = fieldValue(form, 'properties[Phone number]');
        var staff = form.querySelector('[data-staff-calendar]');
        var start = parseClock(timeText);
        if (!date || !start) {
          if (staff) staff.value = '';
          return;
        }
        var end = addMinutes(start, minutes || 60);
        var details = [
          title,
          guest ? ('Guest: ' + guest) : '',
          phone ? ('Phone: ' + phone) : '',
          fieldValue(form, 'properties[Email]') ? ('Email: ' + fieldValue(form, 'properties[Email]')) : '',
          'The Lab at SUAS · 188 W Franklin Blvd, Gastonia, NC 28052'
        ].filter(Boolean).join('\n');
        var staffTitle = 'LAB · ' + (guest || 'Guest') + ' · ' + String(title).replace(/^SUAS Lab · /, '');
        if (staff) staff.value = googleCalUrl(staffTitle, date, start, end, details);
      }

      function showBookKind(kind) {
        if (kind === 'guided') kind = 'self';
        var selfCard = root.querySelector('#self-guided');
        var guidedCard = root.querySelector('#guided-class');
        var charmCard = root.querySelector('#charm-bar');
        if (selfCard) selfCard.classList.toggle('is-open', kind === 'self');
        if (guidedCard) guidedCard.classList.toggle('is-open', false);
        if (charmCard) charmCard.classList.toggle('is-open', kind === 'charm');
        root.querySelectorAll('[data-book-tabs] .suas-book-tab').forEach(function (tab) {
          var on = tab.getAttribute('data-kind') === kind;
          tab.classList.toggle('is-on', on);
          tab.setAttribute('aria-selected', on ? 'true' : 'false');
          tab.setAttribute('tabindex', on ? '0' : '-1');
        });
        root.querySelectorAll('#self-guided [required], #self-guided select[name="id"]').forEach(function (field) {
          if (kind === 'self') field.setAttribute('required', 'required');
          else field.removeAttribute('required');
        });
        root.querySelectorAll('#guided-class [required], #guided-class select[name="id"]').forEach(function (field) {
          field.removeAttribute('required');
        });
        root.querySelectorAll('#charm-bar [required], #charm-bar select[name="id"]').forEach(function (field) {

<section class="suas-bookings-page" aria-label="Book The Lab">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}.suas-bookings-page{--ink:#101010;--pink:#ffe8ef;--hot:#ff9fc2;--lime:#d9ff78;--blue:#c9e7ff;--sun:#fff2a8;min-height:100vh;color:var(--ink);background:radial-gradient(circle at 12% 8%,rgba(255,159,194,.2),transparent 28%),radial-gradient(circle at 92% 16%,rgba(217,255,120,.24),transparent 28%),linear-gradient(180deg,#fff 0%,#fffaf5 100%);font-family:Futura,'Futura PT',Arial,sans-serif}.suas-bookings-page *{box-sizing:border-box}.suas-book-wrap{width:min(1040px,calc(100vw - 28px));margin:0 auto;padding:clamp(16px,2.5vw,30px) 0 40px}.suas-book-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(230px,.48fr);gap:12px;align-items:stretch;margin-bottom:14px}.suas-book-card,.suas-book-panel,.suas-book-option{border:2px solid var(--ink);border-radius:18px;box-shadow:0 5px 0 var(--ink)}.suas-book-card,.suas-book-panel{background:rgba(255,255,255,.86);padding:15px}.suas-book-kicker,.suas-book-label,.suas-book-button,.suas-book-badge{font-family:Futura,'Futura PT',Arial,sans-serif;font-size:8.5px;letter-spacing:.16em;text-transform:uppercase;font-weight:900}.suas-book-title,.suas-book-option h2,.suas-book-panel h2,.suas-book-price{font-family:'Casual Human',Futura,Arial,sans-serif;font-weight:400;letter-spacing:0;text-transform:uppercase}.suas-book-title{margin:6px 0 9px;font-size:clamp(2rem,4.6vw,3.65rem);line-height:.86}.suas-book-copy{max-width:620px;margin:0;font-size:.82rem;line-height:1.38;font-weight:800;color:rgba(16,16,16,.64)}.suas-book-panel{display:flex;flex-direction:column;gap:8px;background:#fff}.suas-book-panel h2{margin:0;font-size:1.35rem;line-height:.95}.suas-book-list{display:grid;gap:6px;margin:0;padding:0;list-style:none}.suas-book-list li{border:1px solid rgba(16,16,16,.14);border-radius:13px;padding:8px 9px;background:var(--chip,#fff);font-size:9.5px;line-height:1.24;font-weight:900}.suas-book-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;align-items:start}.suas-book-option{display:grid;gap:9px;background:var(--card);padding:13px;min-height:0}.suas-book-option h2{margin:5px 0 0;font-size:clamp(1.28rem,2.1vw,1.95rem);line-height:.9}.suas-book-desc{margin:7px 0 0;font-size:10.5px;line-height:1.3;font-weight:900;color:rgba(16,16,16,.66)}.suas-book-price{display:block;margin-top:7px;font-size:clamp(1.25rem,1.8vw,1.75rem);line-height:1}.suas-book-badge{display:inline-flex;width:fit-content;max-width:100%;align-items:center;justify-content:center;border:2px solid var(--ink);border-radius:999px;padding:5px 8px 4px;background:rgba(255,255,255,.72);line-height:1.1;box-shadow:0 3px 0 rgba(16,16,16,.18)}.suas-book-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;margin-top:4px}.suas-book-field{display:grid;gap:4px}.suas-book-field[data-wide],.suas-book-button{grid-column:1/-1}.suas-book-label{color:rgba(16,16,16,.54)}.suas-book-input,.suas-book-select,.suas-bookings-page select.suas-book-select,.suas-bookings-page select.suas-time-select{position:static!important;width:100%!important;height:auto!important;min-height:36px!important;opacity:1!important;pointer-events:auto!important;appearance:auto!important;border:2px solid rgba(16,16,16,.16);border-radius:12px;padding:8px 10px;background:#fff;color:var(--ink);font:900 11px/1.2 Futura,'Futura PT',Arial,sans-serif;outline:none}.suas-book-input:focus,.suas-book-select:focus{border-color:var(--ink);box-shadow:0 0 0 4px rgba(255,159,194,.2)}.suas-bookings-page .suas-click-list{display:none!important}.suas-book-button{min-height:39px;border:2px solid var(--ink);border-radius:999px;padding:10px 14px;color:var(--ink);background:linear-gradient(180deg,#ffd4e5 0%,#ff9fc2 100%);box-shadow:0 4px 0 var(--ink);cursor:pointer;text-align:center}.suas-book-button:hover{color:var(--ink);transform:translateY(2px);box-shadow:0 2px 0 var(--ink)}.suas-book-button[disabled]{cursor:not-allowed;opacity:.58;background:#fff}.suas-book-note{grid-column:1/-1;margin:0;font-size:9.5px;line-height:1.3;font-weight:800;color:rgba(16,16,16,.56)}.suas-book-addons{grid-column:1/-1;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}.suas-book-addon{min-height:42px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:7px;border:1.5px solid rgba(16,16,16,.2);border-radius:12px;padding:7px 8px;background:rgba(255,255,255,.76);cursor:pointer}.suas-book-addon input{width:17px;height:17px;accent-color:var(--hot)}.suas-book-addon strong{font-size:8.5px;line-height:1.15;text-transform:uppercase}.suas-book-addon span{font-size:8px;font-weight:900;white-space:nowrap}.suas-book-addon:has(input:checked){border-color:var(--ink);background:#fff2a8;box-shadow:0 3px 0 var(--ink)}.suas-book-addon:has(input:disabled){opacity:.48;cursor:not-allowed}@media(max-width:980px){.suas-book-wrap{width:min(760px,calc(100vw - 18px))}.suas-book-hero{grid-template-columns:1fr}.suas-book-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.suas-book-option{padding:10px;gap:6px}.suas-book-form{grid-template-columns:repeat(2,minmax(0,1fr));gap:5px}.suas-book-option h2{font-size:clamp(1.05rem,4.8vw,1.55rem)}.suas-book-desc{font-size:9px}.suas-book-input,.suas-book-select{min-height:32px!important;font-size:9px!important;padding:6px 7px!important}}@media(max-width:700px){.suas-book-wrap{width:min(430px,calc(100vw - 14px));padding:14px 0 34px}.suas-book-hero{gap:10px;margin-bottom:12px}.suas-book-grid{grid-template-columns:1fr!important;gap:13px}.suas-book-card,.suas-book-panel,.suas-book-option{border-radius:17px!important;box-shadow:0 4px 0 var(--ink)!important}.suas-book-card,.suas-book-panel{padding:12px!important}.suas-book-option{padding:10px!important;gap:5px!important}.suas-book-title{font-size:clamp(2rem,12vw,3.15rem);margin-bottom:6px}.suas-book-copy{font-size:.72rem;line-height:1.32}.suas-book-panel h2{font-size:1.08rem}.suas-book-list{gap:5px}.suas-book-list li{font-size:8.5px;padding:7px 8px}.suas-book-option h2{font-size:clamp(1.25rem,8.5vw,1.85rem)!important;line-height:.9!important}.suas-book-desc{font-size:9px!important;line-height:1.28!important;margin-top:6px!important}.suas-book-price{font-size:1.35rem!important;margin-top:4px!important}.suas-book-form{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:5px!important;margin-top:4px!important}.suas-book-input,.suas-book-select{min-height:33px!important;border-radius:11px!important;font-size:9px!important;padding:6px 7px!important}.suas-book-button{min-height:34px!important;font-size:7px!important;letter-spacing:.1em!important;padding:7px 8px!important}.suas-book-badge,.suas-book-label{font-size:7px!important}.suas-book-note{font-size:8px!important}}@media(max-width:430px){.suas-book-wrap{width:calc(100vw - 12px);padding-top:12px}.suas-book-grid{grid-template-columns:1fr!important;gap:12px!important}.suas-book-option{padding:9px!important;border-radius:15px!important;gap:5px!important}.suas-book-card,.suas-book-panel{padding:11px}.suas-book-title{font-size:clamp(2rem,11vw,3.2rem)}.suas-book-panel h2{font-size:1.1rem}.suas-book-list li{font-size:8.5px}.suas-book-option h2{font-size:clamp(1.18rem,8vw,1.65rem)!important}.suas-book-desc{font-size:8.5px!important;line-height:1.24}.suas-book-price{font-size:1.25rem!important}.suas-book-badge,.suas-book-label{font-size:7px}.suas-book-button{font-size:8px;letter-spacing:.1em;padding:8px 9px}}
  @media screen and (max-width:749px){
  body .suas-bookings-page .suas-book-wrap{width:calc(100vw - 16px)!important;max-width:none!important;padding:10px 0 28px!important}
  body .suas-bookings-page .suas-book-grid{display:grid!important;grid-template-columns:minmax(0,1fr)!important;gap:12px!important}
  body .suas-bookings-page .suas-book-option{width:100%!important;min-width:0!important;padding:12px!important;gap:7px!important}
  body .suas-bookings-page .suas-book-option h2{font-size:1.55rem!important;line-height:.9!important;margin:4px 0 0!important}
  body .suas-bookings-page .suas-book-price{font-size:1.25rem!important;margin-top:3px!important}
  body .suas-bookings-page .suas-book-desc{max-width:36rem!important;margin-top:4px!important;font-size:9px!important;line-height:1.25!important}
  body .suas-bookings-page .suas-book-form{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:7px!important;margin-top:2px!important}
  body .suas-bookings-page .suas-book-field{min-width:0!important;gap:3px!important}
  body .suas-bookings-page .suas-book-input,
  body .suas-bookings-page .suas-book-select{min-height:36px!important;padding:7px 9px!important;font-size:10px!important}
  body .suas-bookings-page .suas-book-addons{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:7px!important}
  body .suas-bookings-page .suas-book-addon{display:grid!important;grid-template-columns:18px minmax(0,1fr) auto!important;min-width:0!important;min-height:44px!important;padding:7px 9px!important;gap:7px!important}
  body .suas-bookings-page .suas-book-addon strong{display:block!important;min-width:0!important;font-size:8px!important;line-height:1.15!important;word-break:normal!important;overflow-wrap:normal!important;white-space:normal!important}
  body .suas-bookings-page .suas-book-addon span{font-size:8px!important;white-space:nowrap!important}
  body .suas-bookings-page .suas-book-note{font-size:8px!important;line-height:1.2!important}
  body .suas-bookings-page .suas-book-button{min-height:36px!important;margin-top:2px!important}
}
@media screen and (max-width:390px){
  body .suas-bookings-page .suas-book-addons{grid-template-columns:1fr!important}
  body .suas-bookings-page .suas-book-addon{min-height:38px!important}
}
  </style>
  <div class="suas-book-wrap">
    <div class="suas-book-hero"><div class="suas-book-card"><div class="suas-book-kicker">about us / bookings</div><h1 class="suas-book-title">book the lab.</h1><p class="suas-book-copy">Pick your experiment, date, time, and contact info, then check out. Walk-ins are welcome for self-guided Lab experiments when stations are open.</p></div><aside class="suas-book-panel"><h2>class + walk-in times.</h2><ul class="suas-book-list"><li style="--chip:#ffe8ef;">Guided Lab: Thursday and Friday, 6:00 PM - 7:30 PM.</li><li style="--chip:#c9e7ff;">Guided Lab: Saturday, 4:00 PM - 5:30 PM or 6:00 PM - 7:30 PM.</li><li style="--chip:#fff2a8;">Thursday and Friday walk-ins: self-guided Lab experiments available before 5:00 PM.</li><li style="--chip:#fff2a8;">Saturday walk-ins: self-guided Lab experiments available before 5:00 PM.</li><li style="--chip:#d9ff78;">Sunday walk-ins: self-guided only, available before 5:00 PM.</li><li style="--chip:#f3f3f3;">Monday, Tuesday, and Wednesday: closed for Lab bookings.</li></ul></aside></div>
    <div class="suas-book-grid">
      {% liquid
        assign parfum_product = section.settings.parfum_product
        assign body_oil_product = section.settings.body_oil_product
        assign combo_product = section.settings.combo_product
        assign roll_on_product = section.settings.roll_on_product
        assign roll_on_addon_product = section.settings.roll_on_addon_product
        assign travel_addon_product = section.settings.travel_addon_product
        assign deluxe_product = section.settings.deluxe_product
        if deluxe_product == blank and section.settings.deluxe_product_handle != blank
          assign deluxe_handle = section.settings.deluxe_product_handle | handleize
          assign deluxe_product = all_products[deluxe_handle]
        endif

        assign parfum_main_variant = blank
        assign travel_addon_variant = blank
        if parfum_product != blank
          for variant in parfum_product.variants
            assign variant_name = variant.title | downcase
            if variant_name contains '15ml' or variant_name contains '15 ml' or variant_name contains 'travel' or variant_name contains 'second perfume'
              if travel_addon_variant == blank and variant.available
                assign travel_addon_variant = variant
              endif
            elsif parfum_main_variant == blank and variant.available
              assign parfum_main_variant = variant
            endif
          endfor
          if parfum_main_variant == blank
            assign parfum_main_variant = parfum_product.selected_or_first_available_variant
          endif
        endif

        assign body_oil_main_variant = body_oil_product.selected_or_first_available_variant
        assign combo_main_variant = combo_product.selected_or_first_available_variant
        assign roll_on_main_variant = blank
        assign roll_on_addon_variant = blank
        if roll_on_product != blank
          for variant in roll_on_product.variants
            assign variant_name = variant.title | downcase
            if variant_name contains 'add-on' or variant_name contains 'add on' or variant_name contains 'addon'
              if roll_on_addon_variant == blank and variant.available
                assign roll_on_addon_variant = variant
              endif
            elsif roll_on_main_variant == blank and variant.available
              assign roll_on_main_variant = variant
            endif
          endfor
          if roll_on_main_variant == blank
            assign roll_on_main_variant = roll_on_product.selected_or_first_available_variant
          endif
        endif

        if roll_on_addon_product != blank
          assign roll_on_addon_variant = roll_on_addon_product.selected_or_first_available_variant
        endif
        if travel_addon_product != blank
          assign travel_addon_variant = travel_addon_product.selected_or_first_available_variant
        endif
      %}
      <article class="suas-book-option" style="--card:#ffe8ef;">
        <div>
          <span class="suas-book-badge">self-guided</span>
          <h2>Self-Guided Lab Experiment</h2>
          <strong class="suas-book-price" data-self-price aria-live="polite"></strong>
          <p class="suas-book-desc" data-self-description>Choose one creation, then add an extra roll-on or travel perfume if you want a second product.</p>
        </div>
        {% if parfum_product != blank %}
          {% form 'product', parfum_product, class:'suas-book-form', data-booking-form:'self' %}
            <div class="suas-book-field" data-wide>
              <label class="suas-book-label" for="SelfExperience">choose your experiment</label>
              <select class="suas-book-select" id="SelfExperience" name="id" required>
                <option value="">choose experiment</option>
                {% if parfum_main_variant != blank %}<option value="{{ parfum_main_variant.id }}" data-experience="Lab Session: Eau De Parfum (30mL)" data-price="$35" data-description="Create a custom 30mL eau de parfum with up to four scent notes.">Lab Session: Eau De Parfum (30mL) - $35</option>{% endif %}
                {% if body_oil_main_variant != blank %}<option value="{{ body_oil_main_variant.id }}" data-experience="Lab Session: Body Oil (30mL)" data-price="$35" data-description="Create a custom 30mL body oil with up to four scent notes.">Lab Session: Body Oil (30mL) - $35</option>{% endif %}
                {% if combo_main_variant != blank %}<option value="{{ combo_main_variant.id }}" data-experience="Lab Session Combo" data-price="$65" data-description="Create both a custom 30mL eau de parfum and a custom 30mL body oil.">Lab Session Combo - $65</option>{% endif %}
                {% if roll_on_main_variant != blank %}<option value="{{ roll_on_main_variant.id }}" data-experience="Lab Session: Roll-On Perfume (10mL)" data-price="$27" data-description="Create a portable 10mL roll-on perfume oil with up to four scent notes.">Lab Session: Roll-On Perfume (10mL) - $27</option>{% endif %}
              </select>
            </div>
            <input type="hidden" name="properties[Booking type]" value="Self-Guided Lab Experiment">
            <input type="hidden" name="properties[Selected experience]" value="" data-self-experience-property>
            <div class="suas-book-addons">
              <label class="suas-book-addon">
                <input type="checkbox" data-addon-variant="{% if roll_on_addon_variant != blank %}{{ roll_on_addon_variant.id }}{% endif %}" data-addon-name="10mL Roll-On Perfume"{% if roll_on_addon_variant == blank %} disabled{% endif %}>
                <strong>10mL roll-on add-on</strong><span>+$15</span>
              </label>
              <label class="suas-book-addon">
                <input type="checkbox" data-addon-variant="{% if travel_addon_variant != blank %}{{ travel_addon_variant.id }}{% endif %}" data-addon-name="15mL Travel / Second Perfume"{% if travel_addon_variant == blank %} disabled{% endif %}>
                <strong>15mL travel / second perfume</strong><span>+$15</span>
              </label>
            </div>
            {% if roll_on_addon_variant == blank or travel_addon_variant == blank %}<p class="suas-book-note">Select the two add-on products in the Theme Editor to activate both add-on boxes. Variant-name detection remains available as a fallback.</p>{% endif %}
            <div class="suas-book-field"><label class="suas-book-label" for="ParfumDate">date</label><input class="suas-book-input" id="ParfumDate" type="date" name="properties[Preferred date]" required></div>
            <div class="suas-book-field"><label class="suas-book-label" for="ParfumTime">arrival time</label><select class="suas-book-select suas-time-select" id="ParfumTime" name="properties[Preferred time]" required><option value="">choose time</option><option>12:00 PM</option><option>1:00 PM</option><option>2:00 PM</option><option>3:00 PM</option><option>4:00 PM</option><option>5:00 PM</option></select></div>
            <div class="suas-book-field"><label class="suas-book-label" for="ParfumGuests">guests</label><input class="suas-book-input" id="ParfumGuests" type="number" name="quantity" min="1" value="1"></div>
            <div class="suas-book-field"><label class="suas-book-label" for="ParfumPhone">phone</label><input class="suas-book-input" id="ParfumPhone" type="tel" name="properties[Phone number]" required></div>
            <div class="suas-book-field" data-wide><label class="suas-book-label" for="ParfumName">name</label><input class="suas-book-input" id="ParfumName" type="text" name="properties[Guest name]" required></div>
            <button class="suas-book-button" type="submit">add booking to cart</button>
          {% endform %}
        {% else %}
          <button class="suas-book-button" disabled>connect Eau de Parfum product</button>
        {% endif %}
        <div class="suas-book-policy"><strong>Self-guided booking note</strong><p>Online booking reserves your seat for the selected time and is strongly encouraged because only 12 seats are available. Walk-ins are welcome before 5:00 PM on operating days, subject to station availability. Refund requests for self-guided bookings are reviewed individually on a case-by-case basis and are not guaranteed.</p></div>
      </article>
      <article class="suas-book-option" style="--card:#d9ff78;"><div><span class="suas-book-badge">guided class</span><h2>Guided Lab Session</h2><strong class="suas-book-price" data-guided-price aria-live="polite">{% if deluxe_product != blank %}{{ deluxe_product.selected_or_first_available_variant.price | money }}{% else %}choose an experiment{% endif %}</strong><p class="suas-book-desc" data-guided-description>Hands-on guided 30mL perfume class. Choose an experiment option to see everything included.</p></div>{% if deluxe_product != blank %}{% form 'product', deluxe_product, class:'suas-book-form', data-booking-form:'guided' %}<input type="hidden" name="properties[Booking type]" value="Guided Lab Session">{% if deluxe_product.has_only_default_variant %}<input type="hidden" name="id" value="{{ deluxe_product.selected_or_first_available_variant.id }}"><p class="suas-book-note">Add guided variants for body oil, butter creme, and Deluxe.</p>{% else %}<div class="suas-book-field" data-wide><label class="suas-book-label" for="GuidedVariant">choose your experiment</label><select class="suas-book-select" id="GuidedVariant" name="id">{% for variant in deluxe_product.variants %}{% assign guided_variant_name = variant.title | downcase %}{% if guided_variant_name contains 'combo' or guided_variant_name contains 'all three' or guided_variant_name contains 'signature collection' %}{% assign guided_variant_description = 'Create your signature collection: 30mL perfume, 1 oz body oil, and 4 oz butter creme in one guided experience.' %}{% elsif guided_variant_name contains 'body oil' %}{% assign guided_variant_description = 'Create a guided 30mL perfume plus a custom 1 oz body oil.' %}{% elsif guided_variant_name contains 'butter' %}{% assign guided_variant_description = 'Create a guided 30mL perfume plus a custom 4 oz butter creme.' %}{% else %}{% assign guided_variant_description = 'Create a custom 30mL perfume with hands-on guidance from start to finish.' %}{% endif %}<option value="{{ variant.id }}" data-price="{{ variant.price | money }}" data-description="{{ guided_variant_description | escape }}"{% unless variant.available %} disabled{% endunless %}>{{ variant.title }} - {{ variant.price | money }}{% unless variant.available %} - full{% endunless %}</option>{% endfor %}</select></div>{% endif %}<div class="suas-book-field"><label class="suas-book-label" for="GuidedDate">class date</label><input class="suas-book-input" id="GuidedDate" type="date" name="properties[Class date]" required></div><div class="suas-book-field"><label class="suas-book-label" for="GuidedTime">class time</label><select class="suas-book-select suas-time-select" id="GuidedTime" name="properties[Class time]" required><option value="">choose time</option><option>Thursday 6:00 PM - 7:30 PM</option><option>Friday 6:00 PM - 7:30 PM</option><option>Saturday 4:00 PM - 5:30 PM</option><option>Saturday 6:00 PM - 7:30 PM</option></select></div><div class="suas-book-field"><label class="suas-book-label" for="GuidedGuests">guests</label><input class="suas-book-input" id="GuidedGuests" type="number" name="quantity" min="1" max="12" value="1"></div><div class="suas-book-field"><label class="suas-book-label" for="GuidedPhone">phone</label><input class="suas-book-input" id="GuidedPhone" type="tel" name="properties[Phone number]" required></div><div class="suas-book-field" data-wide><label class="suas-book-label" for="GuidedName">name</label><input class="suas-book-input" id="GuidedName" type="text" name="properties[Guest name]" required></div>{% if deluxe_product.available %}<button class="suas-book-button" type="submit">add booking to cart</button>{% else %}<button class="suas-book-button" disabled>all guided classes full</button>{% endif %}{% endform %}{% else %}<button class="suas-book-button" disabled>connect guided product</button>{% endif %}<div class="suas-book-policy"><strong>Guided class policy</strong><p>Each guided class is limited to 12 guests. Please reserve the correct number of seats for your party. Guided-session payments are non-refundable when canceled less than 24 hours before the scheduled class.</p></div></article>
    </div>
  </div>
  <style>
  .suas-book-policy {
    margin-top: 10px;
    padding: 10px 12px;
    border: 1px solid rgba(16,16,16,.22);
    border-radius: 8px;
    background: rgba(255,255,255,.58);
    color: #101010;
  }
  .suas-book-policy strong {
    display: block;
    margin-bottom: 3px;
    font: 800 11px/1.2 Futura, Arial, sans-serif;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .suas-book-policy p {
    margin: 0;
    font: 600 12px/1.4 Futura, Arial, sans-serif;
  }
  @media (max-width: 749px) {
    .suas-book-policy { padding: 8px 9px; }
    .suas-book-policy p { font-size: 11px; }
  }
</style>
<script>(()=>{const root=document.currentScript.closest('.suas-bookings-page');if(!root)return;const today=new Date();const stamp=`${today.getFullYear()}-${String(today.getMonth()+1).padStart(2,'0')}-${String(today.getDate()).padStart(2,'0')}`;const dayNames=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];const selfTimes={0:['12:00 PM','1:00 PM','2:00 PM','3:00 PM','4:00 PM','5:00 PM'],4:['12:00 PM','1:00 PM','2:00 PM','3:00 PM','4:00 PM','5:00 PM'],5:['12:00 PM','1:00 PM','2:00 PM','3:00 PM','4:00 PM','5:00 PM'],6:['12:00 PM','1:00 PM','2:00 PM','3:00 PM']};const guidedTimes={4:['Thursday 6:00 PM - 7:30 PM'],5:['Friday 6:00 PM - 7:30 PM'],6:['Saturday 4:00 PM - 5:30 PM','Saturday 6:00 PM - 7:30 PM']};function dateDay(value){if(!value)return null;const bits=value.split('-').map(Number);return new Date(bits[0],bits[1]-1,bits[2]).getDay()}function reject(input,message){alert(message);input.value='';input.focus()}function setOptions(select,options){const current=select.value;select.innerHTML='<option value="">choose time</option>'+options.map(time=>`<option>${time}</option>`).join('');if(options.includes(current))select.value=current}root.querySelectorAll('input[type="date"]').forEach(input=>input.min=stamp);const selfForm=root.querySelector('[data-booking-form="self"]');if(selfForm){const date=selfForm.querySelector('input[type="date"]');const time=selfForm.querySelector('select[name="properties[Preferred time]"]');const update=()=>{const day=dateDay(date.value);if(day===null)return;const options=selfTimes[day]||[];if(!options.length){setOptions(time,[]);reject(date,`${dayNames[day]} is closed for self-guided bookings. Please choose Thursday, Friday, Saturday, or Sunday.`);return}setOptions(time,options)};date.addEventListener('change',update);selfForm.addEventListener('submit',event=>{const day=dateDay(date.value);const options=selfTimes[day]||[];if(!options.length||!options.includes(time.value)){event.preventDefault();alert('That self-guided time is outside the Lab walk-in window. Please choose an available day and arrival time.')}})}const selfExperience=root.querySelector('#SelfExperience');const selfExperienceProperty=root.querySelector('[data-self-experience-property]');const selfPrice=root.querySelector('[data-self-price]');const selfDescription=root.querySelector('[data-self-description]');if(selfExperience&&selfExperienceProperty){const defaultDescription='Choose one creation, then add an extra roll-on or travel perfume if you want a second product.';const syncExperience=()=>{const option=selfExperience.options[selfExperience.selectedIndex];selfExperienceProperty.value=option?.dataset.experience||'';if(selfPrice)selfPrice.textContent=option?.dataset.price||'';if(selfDescription)selfDescription.textContent=option?.dataset.description||defaultDescription};selfExperience.addEventListener('change',syncExperience);syncExperience()}if(selfForm){selfForm.addEventListener('submit',async event=>{if(event.defaultPrevented)return;const addons=[...selfForm.querySelectorAll('[data-addon-variant]:checked')].filter(box=>box.dataset.addonVariant);if(!addons.length)return;event.preventDefault();const button=selfForm.querySelector('[type="submit"]');button.disabled=true;button.textContent='adding booking...';const data=new FormData(selfForm);const properties={};for(const [key,value] of data.entries()){const match=key.match(/^properties\[(.+)\]$/);if(match&&value)properties[match[1]]=value}const quantity=Math.max(1,Number(data.get('quantity'))||1);const items=[{id:Number(data.get('id')),quantity,properties}];addons.forEach(box=>items.push({id:Number(box.dataset.addonVariant),quantity,properties:{'Add-on for':properties['Selected experience']||'Self-Guided Lab Experiment','Booking date':properties['Preferred date']||'','Booking time':properties['Preferred time']||'','Guest name':properties['Guest name']||'','Add-on':box.dataset.addonName||'Add-on'}}));try{const response=await fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items})});if(!response.ok)throw new Error('Cart error');window.location.assign('/cart')}catch(error){button.disabled=false;button.textContent='add booking to cart';alert('We could not add that booking and its add-ons. Please confirm the selected variants are available and try again.')}},{capture:false})}const guidedForm=root.querySelector('[data-booking-form="guided"]');const guidedVariant=root.querySelector('#GuidedVariant');const guidedPrice=root.querySelector('[data-guided-price]');const guidedDescription=root.querySelector('[data-guided-description]');if(guidedVariant){const syncGuidedExperience=()=>{const option=guidedVariant.options[guidedVariant.selectedIndex];if(guidedPrice)guidedPrice.textContent=option?.dataset.price||'choose an experiment';if(guidedDescription)guidedDescription.textContent=option?.dataset.description||'Choose an experiment option to see everything included.'};guidedVariant.addEventListener('change',syncGuidedExperience);syncGuidedExperience()}if(guidedForm){const date=guidedForm.querySelector('input[type="date"]');const time=guidedForm.querySelector('select[name="properties[Class time]"]');const update=()=>{const day=dateDay(date.value);if(day===null)return;const options=guidedTimes[day]||[];if(!options.length){setOptions(time,[]);reject(date,`${dayNames[day]} is not available for guided Lab classes. Please choose Thursday, Friday, or Saturday.`);return}setOptions(time,options)};date.addEventListener('change',update);guidedForm.addEventListener('submit',event=>{const day=dateDay(date.value);const options=guidedTimes[day]||[];if(!options.length||!options.includes(time.value)){event.preventDefault();alert('That guided class time does not match the selected date. Please choose one of the available class times.')}})}})();</script>
</section>

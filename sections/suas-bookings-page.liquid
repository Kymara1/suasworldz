<section class="suas-bookings-page suas-os-page" data-suas-book-v="head" aria-label="Book The Lab">
  {% render 'suas-os-page-chrome' %}
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
    .suas-bookings-page.suas-os-page{--ink:#101010;--navy:#07162e;--pink:#ffd8e8;--hot:#ff9bc4;--lime:#d9ff78;--blue:#1e6ad4;--sun:#fff2a8;--lav:#e8ddff;--cream:#f4ecd4;min-height:calc(100vh - 36px);color:var(--ink);font-family:Tahoma,Futura,Arial,sans-serif}
    .suas-bookings-page *{box-sizing:border-box}
    .suas-book-wrap{width:100%;margin:0;padding:0 0 18px}
    .suas-book-card,.suas-book-panel,.suas-book-option{border:2.5px solid #101010;background:#f4ecd4;border-radius:22px;overflow:hidden}
    .suas-book-top{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(280px,.9fr);gap:14px;padding:0 18px 14px;align-items:stretch}
    .suas-book-hero{padding:0;display:grid;align-content:start;background:transparent;border:0;box-shadow:none}
    .suas-book-kicker,.suas-book-label,.suas-book-button,.suas-book-badge,.suas-book-tab{font-family:Tahoma,Futura,Arial,sans-serif;font-size:11px;letter-spacing:.08em;text-transform:uppercase;font-weight:900}
    .suas-book-title,.suas-book-option h2,.suas-book-panel h2,.suas-book-price,.suas-seat-meter strong{font-family:'Casual Human',Futura,Arial,sans-serif;font-weight:400;letter-spacing:0;text-transform:uppercase}
    .suas-book-kicker{margin:0 0 6px;color:rgba(255,255,255,.8);letter-spacing:.02em}
    .suas-book-title{margin:0;font-size:clamp(2.2rem,5vw,3.6rem);line-height:.86;color:var(--lime)}
    .suas-book-copy{margin:8px 0 0;font-size:14px;line-height:1.4;font-weight:800;color:rgba(255,255,255,.86)}
    .suas-book-copy a{color:var(--lime);font-weight:900}
    .suas-book-hero-head{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:end;padding:14px 22px 16px;color:#fff}
    .suas-book-mark{width:72px;height:72px;display:grid;place-items:center;border:3px solid #fff;border-radius:999px;background:var(--lime);color:var(--navy);font-family:'Casual Human',Futura,Arial,sans-serif;font-size:2.6rem;line-height:.8}
    .suas-book-bar{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:34px;padding:6px 12px;color:#101010;font:900 11px/1 Tahoma,Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase}
    .suas-book-option .suas-book-bar{color:#fff}
    .suas-book-bar span{display:flex;gap:3px}
    .suas-book-bar i{width:14px;height:12px;border:1.5px solid #fff;background:rgba(255,255,255,.35);font-style:normal}
    .suas-book-hero,.suas-book-panel,.suas-book-option{min-width:0;overflow:hidden}
    .suas-book-tabs{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;padding:16px}
    .suas-book-tab{min-height:48px;border:2px solid #101010;border-radius:10px;background:#fff;color:#101010;cursor:pointer}
    .suas-book-tab.is-on{background:#101010;color:#fff}
    .suas-book-tab.is-soon,.suas-book-tab[disabled]{opacity:.48;filter:grayscale(.7);cursor:not-allowed;background:#d8d4cc;color:rgba(16,16,16,.72)}
    .suas-book-tab.is-soon.is-on{background:#9a9590;color:#fff}
    .suas-book-panel{padding:0;display:grid}
    .suas-book-panel h2{margin:0;font-size:1.25rem;line-height:.95}
    .suas-book-hours-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:8px;padding:14px}
    .suas-book-hours-grid p{margin:0;padding:10px 12px;background:#fff;border:2px solid #101010;font-size:12px;line-height:1.35;font-weight:800;min-width:0;width:100%;overflow-wrap:anywhere}
    .suas-book-walkin{display:none}
    .suas-book-hours-note{grid-column:1/-1;margin:0;padding:0 12px 12px;font:700 11px/1.35 Tahoma,Arial,sans-serif;color:rgba(16,16,16,.7)}
    .suas-book-grid{display:grid;gap:14px;grid-template-columns:1fr!important;padding:0 18px 8px}
    .suas-book-option{display:none!important;gap:0;background:var(--cream);padding:0;scroll-margin-top:88px}
    .suas-book-option.is-open{display:grid!important}
    .suas-book-option-head{display:flex!important;flex-wrap:wrap;align-items:flex-start;justify-content:flex-start;gap:10px 12px;padding:12px}
    .suas-book-option-head>:first-child{flex:0 1 auto;width:fit-content;max-width:min(36rem,100%)}
    .suas-book-option h2{margin:4px 0 0;font-size:clamp(1.35rem,2.2vw,2rem);line-height:.88;width:fit-content;max-width:100%}
    .suas-book-desc{margin:4px 0 0;font-size:13px;line-height:1.3;font-weight:800;color:rgba(16,16,16,.68)}
    .suas-book-price-card,.suas-seat-meter{flex:0 0 auto;width:auto!important;max-width:100%}
    .suas-book-price-card{border:2px solid var(--ink);background:#fff;box-shadow:3px 3px 0 var(--ink);padding:8px 12px;text-align:center}
    .suas-book-price-card span{display:block;margin-bottom:4px;font:900 8px/1 Tahoma,Arial,sans-serif;letter-spacing:.15em;text-transform:uppercase;color:rgba(16,16,16,.55)}
    .suas-book-price{display:block;font-size:clamp(1.3rem,2vw,1.8rem);line-height:.9}
    .suas-book-badge{display:inline-flex;width:fit-content;border:2px solid var(--ink);padding:6px 10px 5px;background:#fff}
    .suas-seat-meter{display:flex;flex-direction:column;justify-content:center;min-width:0;padding:8px 10px;border:2px solid var(--ink);background:var(--lime);box-shadow:3px 3px 0 var(--ink)}
    .suas-seat-meter strong{font-size:1.15rem;line-height:.9}
    .suas-seat-meter span{font:900 9px/1.2 Tahoma,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase;opacity:.65;text-align:right}
    .suas-seat-meter.is-full{background:var(--pink)}
    .suas-seat-meter.is-low{background:var(--sun)}
    .suas-book-form{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;padding:0 12px 12px}
    .suas-book-field{display:grid;gap:4px}
    .suas-book-field[data-wide],.suas-book-button,.suas-book-note,.suas-book-addons,.suas-book-contact,.suas-type-grid,.suas-plus-choice,.suas-time-chips,.suas-book-task{grid-column:1/-1}
    .suas-book-label{color:rgba(16,16,16,.7)}
    .suas-book-input,.suas-book-select,.suas-bookings-page select.suas-book-select,.suas-bookings-page select.suas-time-select{position:static!important;width:100%!important;height:auto!important;min-height:40px!important;opacity:1!important;pointer-events:auto!important;appearance:auto!important;border:2px solid var(--ink);border-radius:0;padding:8px 10px;background:#fff;color:var(--ink);font:800 16px/1.2 Tahoma,Arial,sans-serif;outline:none}
    .suas-book-input:focus,.suas-book-select:focus{outline:3px solid var(--ink);outline-offset:2px}
    .suas-book-addons{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
    .suas-book-addon{min-height:48px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:8px;border:2px solid var(--ink);padding:8px 10px;background:#fff;cursor:pointer}
    .suas-book-addon input{width:18px;height:18px;accent-color:#101010}
    .suas-book-addon strong{font-size:12px;line-height:1.2;text-transform:uppercase}
    .suas-book-addon span{font-size:12px;font-weight:900;white-space:nowrap}
    .suas-book-addon:has(input:checked){background:var(--sun);box-shadow:0 3px 0 var(--ink)}
    .suas-book-addon:has(input:disabled){opacity:.48;cursor:not-allowed}
    .suas-book-button{min-height:48px;border:0;border-radius:10px;padding:0 16px;color:#101010;background:linear-gradient(180deg,#f0b07a,#e07a3d);cursor:pointer;text-align:center;font:900 13px/1 Tahoma,Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}
    .suas-book-button:hover{filter:brightness(.97)}
    .suas-book-button[disabled]{cursor:not-allowed;opacity:.58;background:#fff;border:2px solid #101010}
    .suas-book-task{display:grid;gap:0;margin:0 12px 12px;padding:0;background:transparent;color:#101010}
    .suas-book-task em,.suas-book-task b{display:none}
    .suas-book-task .suas-book-button{width:100%}
    .suas-book-note{margin:0;border:2px solid var(--ink);background:var(--hot);padding:8px 10px;font-size:12px;line-height:1.35;font-weight:800;color:var(--ink)}
    .suas-book-policy{padding:11px 12px;border:2px solid var(--ink);background:#fff}
    .suas-book-policy strong{display:block;margin-bottom:4px;font:900 10px/1.2 Tahoma,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase}
    .suas-book-policy p{margin:0;font:700 12px/1.4 Tahoma,Arial,sans-serif;color:rgba(16,16,16,.68)}
    .suas-book-contact{display:none;padding:14px;border:2px solid var(--ink);background:#fff;box-shadow:3px 4px 0 var(--ink)}
    .suas-book-contact.is-on{display:grid;gap:10px}
    .suas-book-contact p{margin:0;font:800 14px/1.4 Tahoma,Arial,sans-serif}
    .suas-book-contact a{display:grid;place-items:center;min-height:40px;border:2px solid var(--ink);background:var(--sun);color:var(--ink);text-decoration:none;font:900 12px/1 Tahoma,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase}
    .suas-type-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
    .suas-type-grid.is-charm{grid-template-columns:repeat(3,minmax(0,1fr))}
    .suas-type-card{position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:3px 10px;min-height:0;align-content:start;padding:12px;border:2px solid var(--ink);background:#fff;cursor:pointer}
    .suas-type-card input{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;opacity:0}
    .suas-type-card em{grid-column:1;font:900 9px/1 Tahoma,Arial,sans-serif;letter-spacing:.14em;font-style:normal;opacity:.5}
    .suas-type-card strong{grid-column:1;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:1.15rem;line-height:.88;font-weight:400;text-transform:uppercase}
    .suas-type-card small{grid-column:1/-1;display:block;margin:2px 0 0;font:700 11px/1.35 Tahoma,Arial,sans-serif;color:rgba(16,16,16,.68);text-transform:none;letter-spacing:0}
    .suas-type-card b{grid-column:2;grid-row:1/span 2;align-self:start;padding-top:2px;font:900 13px/1 Tahoma,Arial,sans-serif}
    .suas-type-card.is-on{border-color:var(--ink);background:var(--sun);box-shadow:0 3px 0 var(--ink)}
    .suas-type-card.is-on em{opacity:1}
    .suas-book-option.is-soon{opacity:.72;filter:grayscale(.35)}
    .suas-book-option.is-soon .suas-book-form{pointer-events:none}
    .suas-book-soon-note{grid-column:1/-1;margin:0 12px 12px;border:2px solid var(--ink);background:#d8d4cc;padding:10px 12px;font:800 13px/1.35 Tahoma,Arial,sans-serif;color:rgba(16,16,16,.78)}
    .suas-type-card:focus-within{outline:3px solid var(--ink);outline-offset:3px}
    .suas-book-tab:focus-visible,.suas-plus-choice button:focus-visible,.suas-time-chips button:focus-visible,.suas-book-button:focus-visible,.suas-book-input:focus-visible,.suas-book-select:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
    .suas-plus-choice{grid-column:1/-1;display:none;grid-template-columns:1fr 1fr;gap:8px}
    .suas-plus-choice.is-on{display:grid}
    .suas-plus-choice button{min-height:42px;border:2px solid var(--ink);background:#fff;font:900 11px/1 Tahoma,Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase;cursor:pointer}
    .suas-plus-choice button.is-on{background:#cdeeff;box-shadow:0 3px 0 var(--ink)}
    .suas-time-chips{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:8px}
    .suas-time-chips button{min-height:40px;padding:0 14px;border:2px solid var(--ink);background:#fff;font:900 11px/1 Tahoma,Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase;cursor:pointer}
    .suas-time-chips button.is-on{background:var(--lime);box-shadow:0 3px 0 var(--ink)}
    .suas-time-chips button:disabled{opacity:.4;cursor:not-allowed}
    .suas-bookings-page .suas-visually-hidden,
    .suas-bookings-page #GuidedVariant,
    .suas-bookings-page #GuidedTime,
    .suas-bookings-page #SelfExperience,
    .suas-bookings-page #ParfumTime,
    .suas-bookings-page #BookCharmExperience,
    .suas-bookings-page #BookCharmTime{
      position:absolute!important;width:1px!important;height:1px!important;min-height:0!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;opacity:0!important;pointer-events:none!important;border:0!important;padding:0!important;margin:0!important
    }
    @media(max-width:1023px){.suas-book-top,.suas-book-hours-grid,.suas-type-grid,.suas-book-hero-head{grid-template-columns:minmax(0,1fr)!important}.suas-type-grid.is-charm{grid-template-columns:repeat(2,minmax(0,1fr))!important}.suas-book-form{grid-template-columns:1fr 1fr}.suas-book-mark{width:56px;height:56px;font-size:2rem}}
    @media(max-width:700px){.suas-book-title{font-size:clamp(2rem,11vw,3rem)}.suas-book-form,.suas-plus-choice,.suas-type-grid{grid-template-columns:1fr}.suas-type-grid.is-charm{grid-template-columns:repeat(2,minmax(0,1fr))!important}.suas-book-input,.suas-book-select{min-height:48px!important;font-size:16px!important}.suas-book-tabs{grid-template-columns:1fr;gap:6px}.suas-book-tab{min-height:40px;font-size:10px}}
  </style>

  <div class="suas-os-sheet">
    <div class="suas-os-titlebar"><span class="suas-os-orb" aria-hidden="true"></span><b>LAB.EXE</b><span class="suas-os-winbtns" aria-hidden="true"><i></i><i></i><i></i></span></div>
  <div class="suas-book-wrap">
    <header class="suas-book-hero-head">
      <div>
        <p class="suas-book-kicker">lab booking · paid at checkout</p>
        <h1 class="suas-book-title">book the lab.</h1>
        <p class="suas-book-copy">Sessions start November 14. Pick a seat, pay now, and the booking lands in our orders. We ping you the day before. Private parties still use the <a href="/pages/party-booking">party order form</a> (request first, invoice later).</p>
      </div>
      <span class="suas-book-mark" aria-hidden="true">S.</span>
    </header>
    <div class="suas-book-top">
      <div class="suas-book-card">
        <div class="suas-book-bar" style="background:#d6c21a"><b>S 1. Choose your session</b><span aria-hidden="true"><i></i><i></i><i></i></span></div>
        <div class="suas-book-tabs" data-book-tabs role="tablist" aria-label="Booking type">
          <button class="suas-book-tab is-on" type="button" data-kind="self" role="tab" aria-selected="true" aria-controls="self-guided" id="book-tab-self">self-guided</button>
          <button class="suas-book-tab is-soon" type="button" data-kind="guided" role="tab" aria-selected="false" aria-controls="guided-class" id="book-tab-guided" aria-disabled="true" title="Guided classes are not open yet">guided</button>
          <button class="suas-book-tab" type="button" data-kind="charm" role="tab" aria-selected="false" aria-controls="charm-bar" id="book-tab-charm">charm bar</button>
        </div>
      </div>
      <aside class="suas-book-panel">
        <div class="suas-book-bar" style="background:#e23d8a"><b>S 2. Lab hours</b><span aria-hidden="true"><i></i><i></i><i></i></span></div>
        <div class="suas-book-hours-grid">
          <p style="--chip:#ffe8ef;"><b>Self-guided</b><br>Thu–Fri 1:00–5:00 PM<br>Sat–Sun 1:00–4:00 PM</p>
          <p style="--chip:#d8d4cc;"><b>Guided · soon</b><br>Not open for booking yet.<br>We’ll announce when seats drop.</p>
          <p style="--chip:#fff2a8;"><b>Charm Bar · 4 seats / 45 min</b><br>Same days as self-guided. Counter updates for the slot you pick.</p>
        </div>
        <p class="suas-book-hours-note">Bookings open Saturday, November 14. Closed Monday–Wednesday. Self-guided Lab is 14 seats per hour. Charm Bar is 4 seats per 45-minute slot. Walk-ins welcome if a seat is free.</p>
      </aside>
    </div>

    <div class="suas-book-grid">
      {% liquid
        assign parfum_product = section.settings.parfum_product
        assign body_oil_product = section.settings.body_oil_product
        assign combo_product = section.settings.combo_product
        assign roll_on_product = section.settings.roll_on_product
        assign roll_on_addon_product = section.settings.roll_on_addon_product
        assign travel_addon_product = section.settings.travel_addon_product
        assign deluxe_product = section.settings.deluxe_product
        if deluxe_product == blank and section.settings.deluxe_product_handle != blank
          assign deluxe_handle = section.settings.deluxe_product_handle | handleize
          assign deluxe_product = all_products[deluxe_handle]
        endif

        assign self_form_product = parfum_product
        if self_form_product == blank
          assign self_form_product = body_oil_product
        endif
        if self_form_product == blank
          assign self_form_product = combo_product
        endif
        if self_form_product == blank
          assign self_form_product = roll_on_product
        endif

        assign parfum_main_variant = blank
        assign travel_addon_variant = blank
        if parfum_product != blank
          for variant in parfum_product.variants
            assign variant_name = variant.title | downcase
            if variant_name contains '15ml' or variant_name contains '15 ml' or variant_name contains 'travel' or variant_name contains 'second perfume'
              if travel_addon_variant == blank and variant.available
                assign travel_addon_variant = variant
              endif
            elsif parfum_main_variant == blank and variant.available
              assign parfum_main_variant = variant
            endif
          endfor
          if parfum_main_variant == blank
            assign parfum_main_variant = parfum_product.selected_or_first_available_variant
          endif
        endif

        assign body_oil_main_variant = body_oil_product.selected_or_first_available_variant
        assign combo_main_variant = combo_product.selected_or_first_available_variant
        assign roll_on_main_variant = blank
        assign roll_on_addon_variant = blank
        if roll_on_product != blank
          for variant in roll_on_product.variants
            assign variant_name = variant.title | downcase
            if variant_name contains 'add-on' or variant_name contains 'add on' or variant_name contains 'addon'
              if roll_on_addon_variant == blank and variant.available
                assign roll_on_addon_variant = variant
              endif
            elsif roll_on_main_variant == blank and variant.available
              assign roll_on_main_variant = variant
            endif
          endfor
          if roll_on_main_variant == blank
            assign roll_on_main_variant = roll_on_product.selected_or_first_available_variant
          endif
        endif

        if roll_on_addon_product != blank
          assign roll_on_addon_variant = roll_on_addon_product.selected_or_first_available_variant
        endif
        if travel_addon_product != blank
          assign travel_addon_variant = travel_addon_product.selected_or_first_available_variant
        endif

        assign charm_product = all_products['charm-bar-reservation']
        assign charm_extra_product = all_products['charm-bar-extra-charms']
        assign charm_plushie_product = all_products['charm-bar-plushie']
        assign charm_bead_product = all_products['charm-bar-bead-sticks']
      %}

      <article class="suas-book-option is-open" id="self-guided" role="tabpanel" aria-labelledby="book-tab-self" style="--card:#ffe8ef;">
        <div class="suas-book-bar" style="background:#1e6ad4"><b>S 3. Self-guided details</b><span aria-hidden="true"><i></i><i></i><i></i></span></div>
        <div class="suas-book-option-head">
          <div>
            <span class="suas-book-badge">self-guided</span>
            <h2>Self-Guided Lab Experiment</h2>
            <p class="suas-book-desc" data-self-description>Pick one experiment. You mix at your own pace — no instructor.</p>
          </div>
          <div class="suas-seat-meter" data-self-seat-meter><strong data-self-seat-text>14 of 14 seats left</strong><span data-self-seat-hint>pick date + hour</span></div>
          <div class="suas-book-price-card"><span>price</span><strong class="suas-book-price" data-self-price aria-live="polite">{% if parfum_main_variant != blank %}{{ parfum_main_variant.price | money }}{% else %}pick one{% endif %}</strong></div>
        </div>

        {% if self_form_product != blank %}
          {% form 'product', self_form_product, class:'suas-book-form', data-booking-form:'self' %}
            <div class="suas-type-grid" data-self-types>
              {% if parfum_main_variant != blank %}
              <label class="suas-type-card is-on">
                <input type="radio" name="_self_type" value="{{ parfum_main_variant.id }}" data-label="Custom Perfume — 30 mL" data-price="{{ parfum_main_variant.price | money }}" data-copy="Custom 30 mL eau de parfum. Choose notes, mix, bottle, and decorate." checked{% unless parfum_main_variant.available %} disabled{% endunless %}>
                <em>01</em>
                <strong>perfume</strong>
                <small>Custom 30 mL eau de parfum. Choose your notes, mix, bottle, and take it home.</small>
                <b>{{ parfum_main_variant.price | money }}</b>
              </label>
              {% endif %}
              {% if roll_on_main_variant != blank %}
              <label class="suas-type-card">
                <input type="radio" name="_self_type" value="{{ roll_on_main_variant.id }}" data-label="Perfume Roll-On — 10 mL" data-price="{{ roll_on_main_variant.price | money }}" data-copy="Portable 10 mL perfume oil in a roll-on. Same Lab mix, pocket size."{% unless roll_on_main_variant.available %} disabled{% endunless %}>
                <em>02</em>
                <strong>roll-on</strong>
                <small>Portable 10 mL perfume oil in a roll-on. Same Lab mix, pocket size.</small>
                <b>{{ roll_on_main_variant.price | money }}</b>
              </label>
              {% endif %}
              {% if combo_main_variant != blank %}
              <label class="suas-type-card">

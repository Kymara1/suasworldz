<section class="suas-bookings-page" aria-label="Book The Lab">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}.suas-bookings-page{--ink:#101010;--pink:#ffe8ef;--hot:#ff9fc2;--lime:#d9ff78;--blue:#c9e7ff;--sun:#fff2a8;min-height:100vh;color:var(--ink);background:radial-gradient(circle at 12% 8%,rgba(255,159,194,.2),transparent 28%),radial-gradient(circle at 92% 16%,rgba(217,255,120,.24),transparent 28%),linear-gradient(180deg,#fff 0%,#fffaf5 100%);font-family:Futura,'Futura PT',Arial,sans-serif}.suas-bookings-page *{box-sizing:border-box}.suas-book-wrap{width:min(980px,calc(100vw - 34px));margin:0 auto;padding:clamp(24px,4vw,44px) 0 52px}.suas-book-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,.48fr);gap:14px;align-items:stretch;margin-bottom:16px}.suas-book-card,.suas-book-panel,.suas-book-option{border:2px solid var(--ink);border-radius:22px;box-shadow:0 6px 0 var(--ink)}.suas-book-card,.suas-book-panel{background:rgba(255,255,255,.84);padding:clamp(18px,2.7vw,28px)}.suas-book-kicker,.suas-book-label,.suas-book-button,.suas-book-badge{font-family:Futura,'Futura PT',Arial,sans-serif;font-size:9px;letter-spacing:.18em;text-transform:uppercase;font-weight:900}.suas-book-title,.suas-book-option h2,.suas-book-panel h2,.suas-book-price{font-family:'Casual Human',Futura,Arial,sans-serif;font-weight:400;letter-spacing:0;text-transform:uppercase}.suas-book-title{margin:8px 0 12px;font-size:clamp(2.6rem,6vw,5rem);line-height:.86}.suas-book-copy{max-width:680px;margin:0;font-size:clamp(.92rem,1.25vw,1.08rem);line-height:1.48;font-weight:800;color:rgba(16,16,16,.64)}.suas-book-panel{display:flex;flex-direction:column;gap:10px;background:#fff}.suas-book-panel h2{margin:0;font-size:1.8rem;line-height:.95}.suas-book-list{display:grid;gap:8px;margin:0;padding:0;list-style:none}.suas-book-list li{border:1px solid rgba(16,16,16,.14);border-radius:15px;padding:10px;background:var(--chip,#fff);font-size:11px;line-height:1.32;font-weight:900}.suas-book-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.suas-book-option{display:flex;flex-direction:column;gap:12px;background:var(--card);padding:18px}.suas-book-option h2{margin:8px 0 0;font-size:clamp(1.75rem,3vw,2.65rem);line-height:.9}.suas-book-desc{margin:9px 0 0;font-size:12px;line-height:1.38;font-weight:900;color:rgba(16,16,16,.66)}.suas-book-price{display:block;margin-top:10px;font-size:clamp(1.65rem,2.4vw,2.15rem);line-height:1}.suas-book-badge{display:inline-flex;width:fit-content;max-width:100%;align-items:center;justify-content:center;border:2px solid var(--ink);border-radius:999px;padding:6px 9px 5px;background:rgba(255,255,255,.72);line-height:1.15;box-shadow:0 3px 0 rgba(16,16,16,.18)}.suas-book-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin-top:auto}.suas-book-field{display:grid;gap:5px}.suas-book-field[data-wide],.suas-book-button{grid-column:1/-1}.suas-book-label{color:rgba(16,16,16,.54)}.suas-book-input,.suas-book-select{width:100%;min-height:42px;border:2px solid rgba(16,16,16,.16);border-radius:14px;padding:9px 11px;background:#fff;color:var(--ink);font:800 12px/1.2 Futura,'Futura PT',Arial,sans-serif;outline:none}.suas-book-input:focus,.suas-book-select:focus{border-color:var(--ink);box-shadow:0 0 0 4px rgba(255,159,194,.2)}.suas-book-button{min-height:46px;border:2px solid var(--ink);border-radius:999px;padding:12px 16px;color:var(--ink);background:linear-gradient(180deg,#ffd4e5 0%,#ff9fc2 100%);box-shadow:0 5px 0 var(--ink);cursor:pointer;text-align:center}.suas-book-button:hover{color:var(--ink);transform:translateY(2px);box-shadow:0 3px 0 var(--ink)}.suas-book-button[disabled]{cursor:not-allowed;opacity:.58;background:#fff}.suas-book-note{grid-column:1/-1;margin:0;font-size:11px;line-height:1.42;font-weight:800;color:rgba(16,16,16,.56)}@media(max-width:980px){.suas-book-hero,.suas-book-grid{grid-template-columns:1fr}}@media(max-width:620px){.suas-book-wrap{width:min(100% - 22px,520px);padding:22px 0 44px}.suas-book-card,.suas-book-panel,.suas-book-option{border-radius:20px;padding:16px}.suas-book-title{font-size:clamp(2.55rem,13vw,4.45rem)}.suas-book-form{grid-template-columns:1fr}.suas-book-desc{min-height:0}}
  </style>
  <div class="suas-book-wrap">
    <div class="suas-book-hero"><div class="suas-book-card"><div class="suas-book-kicker">about us / bookings</div><h1 class="suas-book-title">book the lab.</h1><p class="suas-book-copy">Choose your experiment, pick your date and time, add your contact info, then check out. Walk-ins are welcome for self-guided perfume experiments when stations are open.</p></div><aside class="suas-book-panel"><h2>class + walk-in times.</h2><ul class="suas-book-list"><li style="--chip:#ffe8ef;">Guided Lab: Thursday and Friday, 6:00 PM - 7:30 PM.</li><li style="--chip:#c9e7ff;">Guided Lab: Saturday, 4:00 PM - 5:00 PM or 5:30 PM - 6:30 PM.</li><li style="--chip:#fff2a8;">Thursday and Friday walk-ins: self-guided perfume experiments available until 5:30 PM.</li><li style="--chip:#fff2a8;">Saturday walk-ins: self-guided perfume experiments available until 3:30 PM.</li><li style="--chip:#d9ff78;">Sunday walk-ins: self-guided only, available until 5:00 PM.</li><li style="--chip:#f3f3f3;">Monday, Tuesday, and Wednesday: closed for Lab bookings.</li></ul></aside></div>
    <div class="suas-book-grid">
      {% assign parfum_product = section.settings.parfum_product %}{% assign deluxe_product = section.settings.deluxe_product %}{% if deluxe_product == blank and section.settings.deluxe_product_handle != blank %}{% assign deluxe_handle = section.settings.deluxe_product_handle | handleize %}{% assign deluxe_product = all_products[deluxe_handle] %}{% endif %}
      <article class="suas-book-option" style="--card:#ffe8ef;"><div><span class="suas-book-badge">self-guided</span><h2>Self-Guided Perfume Experiment</h2><p class="suas-book-desc">Create a 30 mL eau de parfum at your pace. Add a 15 mL sample for an additional $15 when selected as a product variant.</p><strong class="suas-book-price">$35</strong></div>{% if parfum_product != blank %}{% form 'product', parfum_product, class:'suas-book-form' %}{% if parfum_product.has_only_default_variant %}<input type="hidden" name="id" value="{{ parfum_product.selected_or_first_available_variant.id }}"><p class="suas-book-note">Create the 15 mL add-on as a product variant when you are ready.</p>{% else %}<div class="suas-book-field" data-wide><label class="suas-book-label" for="ParfumVariant">option</label><select class="suas-book-select" id="ParfumVariant" name="id">{% for variant in parfum_product.variants %}<option value="{{ variant.id }}"{% unless variant.available %} disabled{% endunless %}>{{ variant.title }} - {{ variant.price | money }}{% unless variant.available %} - full{% endunless %}</option>{% endfor %}</select></div>{% endif %}<input type="hidden" name="properties[Booking type]" value="Self-guided Perfume Experiment"><div class="suas-book-field"><label class="suas-book-label" for="ParfumDate">date</label><input class="suas-book-input" id="ParfumDate" type="date" name="properties[Preferred date]" required></div><div class="suas-book-field"><label class="suas-book-label" for="ParfumTime">arrival time</label><select class="suas-book-select suas-time-select" id="ParfumTime" name="properties[Preferred time]" required><option value="">choose time</option><option>12:00 PM</option><option>1:00 PM</option><option>2:00 PM</option><option>3:00 PM</option><option>4:00 PM</option><option>5:00 PM</option></select></div><div class="suas-book-field"><label class="suas-book-label" for="ParfumGuests">guests</label><input class="suas-book-input" id="ParfumGuests" type="number" name="quantity" min="1" value="1"></div><div class="suas-book-field"><label class="suas-book-label" for="ParfumPhone">phone</label><input class="suas-book-input" id="ParfumPhone" type="tel" name="properties[Phone number]" required></div><div class="suas-book-field" data-wide><label class="suas-book-label" for="ParfumName">name</label><input class="suas-book-input" id="ParfumName" type="text" name="properties[Guest name]" required></div><button class="suas-book-button" type="submit">add booking to cart</button>{% endform %}{% else %}<button class="suas-book-button" disabled>connect product in theme editor</button>{% endif %}</article>
      <article class="suas-book-option" style="--card:#d9ff78;"><div><span class="suas-book-badge">guided class</span><h2>Guided Lab Session</h2><p class="suas-book-desc">Guided 30 mL perfume experiment is $85 per person. Add 1 oz body oil (+$20), add 4 oz butter creme (+$20), or choose the Deluxe Lab Session for $140 with all three.</p><strong class="suas-book-price">$85+</strong></div>{% if deluxe_product != blank %}{% form 'product', deluxe_product, class:'suas-book-form' %}<input type="hidden" name="properties[Booking type]" value="Guided Lab Session">{% if deluxe_product.has_only_default_variant %}<input type="hidden" name="id" value="{{ deluxe_product.selected_or_first_available_variant.id }}"><p class="suas-book-note">Add guided session variants for body oil, butter creme, and Deluxe Lab Session.</p>{% else %}<div class="suas-book-field" data-wide><label class="suas-book-label" for="GuidedVariant">experiment option</label><select class="suas-book-select" id="GuidedVariant" name="id">{% for variant in deluxe_product.variants %}<option value="{{ variant.id }}"{% unless variant.available %} disabled{% endunless %}>{{ variant.title }} - {{ variant.price | money }}{% unless variant.available %} - full{% endunless %}</option>{% endfor %}</select></div>{% endif %}<div class="suas-book-field"><label class="suas-book-label" for="GuidedDate">class date</label><input class="suas-book-input" id="GuidedDate" type="date" name="properties[Class date]" required></div><div class="suas-book-field"><label class="suas-book-label" for="GuidedTime">class time</label><select class="suas-book-select" id="GuidedTime" name="properties[Class time]" required><option value="">choose time</option><option>Thursday 6:00 PM - 7:30 PM</option><option>Friday 6:00 PM - 7:30 PM</option><option>Saturday 4:00 PM - 5:00 PM</option><option>Saturday 5:30 PM - 6:30 PM</option></select></div><div class="suas-book-field"><label class="suas-book-label" for="GuidedGuests">guests</label><input class="suas-book-input" id="GuidedGuests" type="number" name="quantity" min="1" max="12" value="1"></div><div class="suas-book-field"><label class="suas-book-label" for="GuidedPhone">phone</label><input class="suas-book-input" id="GuidedPhone" type="tel" name="properties[Phone number]" required></div><div class="suas-book-field" data-wide><label class="suas-book-label" for="GuidedName">name</label><input class="suas-book-input" id="GuidedName" type="text" name="properties[Guest name]" required></div>{% if deluxe_product.available %}<button class="suas-book-button" type="submit">add booking to cart</button>{% else %}<button class="suas-book-button" disabled>all guided classes full</button>{% endif %}{% endform %}{% else %}<button class="suas-book-button" disabled>connect guided product</button>{% endif %}</article>
    </div>
  </div>
  <script>(()=>{const today=new Date();const stamp=`${today.getFullYear()}-${String(today.getMonth()+1).padStart(2,'0')}-${String(today.getDate()).padStart(2,'0')}`;document.querySelectorAll('.suas-bookings-page input[type="date"]').forEach(input=>input.min=stamp)})();</script>
</section>
{% schema %}{"name":"SUAS Bookings Page","settings":[{"type":"product","id":"body_oil_product","label":"Deprecated Body Oil product"},{"type":"product","id":"parfum_product","label":"Self-Guided Perfume Experiment product"},{"type":"product","id":"combo_product","label":"Deprecated Combo product"},{"type":"product","id":"deluxe_product","label":"Guided Lab Session product"},{"type":"text","id":"deluxe_product_handle","label":"Guided fallback product handle","info":"Use this if the product picker will not load the guided product."}],"presets":[{"name":"SUAS Bookings Page"}]}{% endschema %}

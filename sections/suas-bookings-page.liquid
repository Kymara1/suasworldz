<section class="suas-bookings-page" aria-label="Book The Lab">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
    .suas-bookings-page{--ink:#101010;--pink:#ffe8ef;--hot:#ff9fc2;--lime:#d9ff78;--blue:#c9e7ff;--sun:#fff2a8;min-height:100vh;color:var(--ink);background:radial-gradient(circle at 12% 8%,rgba(255,159,194,.2),transparent 28%),radial-gradient(circle at 92% 16%,rgba(217,255,120,.24),transparent 28%),linear-gradient(180deg,#fff 0%,#fffaf5 100%);font-family:Futura,'Futura PT',Arial,sans-serif}.suas-bookings-page *{box-sizing:border-box}.suas-book-wrap{width:min(900px,calc(100vw - 30px));margin:0 auto;padding:clamp(20px,3vw,34px) 0 44px}.suas-book-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(230px,.45fr);gap:12px;align-items:stretch;margin-bottom:14px}.suas-book-card,.suas-book-panel,.suas-book-option{border:2px solid var(--ink);border-radius:20px;box-shadow:0 5px 0 var(--ink)}.suas-book-card,.suas-book-panel{background:rgba(255,255,255,.86);padding:16px}.suas-book-kicker,.suas-book-label,.suas-book-button,.suas-book-badge{font-family:Futura,'Futura PT',Arial,sans-serif;font-size:9px;letter-spacing:.16em;text-transform:uppercase;font-weight:900}.suas-book-title,.suas-book-option h2,.suas-book-panel h2,.suas-book-price{font-family:'Casual Human',Futura,Arial,sans-serif;font-weight:400;letter-spacing:0;text-transform:uppercase}.suas-book-title{margin:7px 0 10px;font-size:clamp(2.35rem,4.8vw,4rem);line-height:.86}.suas-book-copy{max-width:640px;margin:0;font-size:.9rem;line-height:1.42;font-weight:800;color:rgba(16,16,16,.64)}.suas-book-panel{display:flex;flex-direction:column;gap:8px;background:#fff}.suas-book-panel h2{margin:0;font-size:1.55rem;line-height:.95}.suas-book-list{display:grid;gap:7px;margin:0;padding:0;list-style:none}.suas-book-list li{border:1px solid rgba(16,16,16,.14);border-radius:14px;padding:9px 10px;background:var(--chip,#fff);font-size:10.5px;line-height:1.28;font-weight:900}.suas-book-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;align-items:start}.suas-book-option{display:grid;gap:12px;background:var(--card);padding:15px}.suas-book-option h2{margin:6px 0 0;font-size:clamp(1.6rem,2.45vw,2.35rem);line-height:.92}.suas-book-desc{margin:8px 0 0;font-size:11.5px;line-height:1.32;font-weight:900;color:rgba(16,16,16,.66)}.suas-book-price{display:block;margin-top:8px;font-size:clamp(1.42rem,2vw,1.9rem);line-height:1}.suas-book-badge{display:inline-flex;width:fit-content;max-width:100%;align-items:center;justify-content:center;border:2px solid var(--ink);border-radius:999px;padding:5px 9px 4px;background:rgba(255,255,255,.72);line-height:1.1;box-shadow:0 3px 0 rgba(16,16,16,.18)}.suas-book-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin-top:2px}.suas-book-field{display:grid;gap:5px}.suas-book-field[data-wide],.suas-book-button{grid-column:1/-1}.suas-book-label{color:rgba(16,16,16,.54)}.suas-book-input,.suas-book-select,.suas-bookings-page select.suas-book-select,.suas-bookings-page select.suas-time-select{position:static!important;width:100%!important;height:auto!important;min-height:40px!important;opacity:1!important;pointer-events:auto!important;appearance:auto!important;border:2px solid rgba(16,16,16,.16);border-radius:14px;padding:9px 11px;background:#fff;color:var(--ink);font:900 12px/1.2 Futura,'Futura PT',Arial,sans-serif;outline:none}.suas-book-input:focus,.suas-book-select:focus{border-color:var(--ink);box-shadow:0 0 0 4px rgba(255,159,194,.2)}.suas-bookings-page .suas-click-list{display:none!important}.suas-book-button{min-height:44px;border:2px solid var(--ink);border-radius:999px;padding:11px 16px;color:var(--ink);background:linear-gradient(180deg,#ffd4e5 0%,#ff9fc2 100%);box-shadow:0 4px 0 var(--ink);cursor:pointer;text-align:center}.suas-book-button:hover{color:var(--ink);transform:translateY(2px);box-shadow:0 2px 0 var(--ink)}.suas-book-button[disabled]{cursor:not-allowed;opacity:.58;background:#fff}.suas-book-note{grid-column:1/-1;margin:0;font-size:10.5px;line-height:1.35;font-weight:800;color:rgba(16,16,16,.56)}@media(max-width:980px){.suas-book-hero,.suas-book-grid{grid-template-columns:1fr}.suas-book-wrap{width:min(620px,calc(100vw - 24px))}}@media(max-width:620px){.suas-book-wrap{width:min(100% - 20px,520px);padding:18px 0 38px}.suas-book-card,.suas-book-panel,.suas-book-option{border-radius:18px;padding:14px}.suas-book-title{font-size:clamp(2.35rem,12vw,3.9rem)}.suas-book-form{grid-template-columns:1fr}.suas-book-option h2{font-size:clamp(1.75rem,8.5vw,2.8rem)}}
  </style>
  <div class="suas-book-wrap">
    <div class="suas-book-hero"><div class="suas-book-card"><div class="suas-book-kicker">about us / bookings</div><h1 class="suas-book-title">book the lab.</h1><p class="suas-book-copy">Pick your experiment, date, time, and contact info, then check out. Walk-ins are welcome for self-guided perfume experiments when stations are open.</p></div><aside class="suas-book-panel"><h2>class + walk-in times.</h2><ul class="suas-book-list"><li style="--chip:#ffe8ef;">Guided Lab: Thursday and Friday, 6:00 PM - 7:30 PM.</li><li style="--chip:#c9e7ff;">Guided Lab: Saturday, 4:00 PM - 5:00 PM or 5:30 PM - 6:30 PM.</li><li style="--chip:#fff2a8;">Thursday and Friday walk-ins: self-guided perfume experiments available until 5:30 PM.</li><li style="--chip:#fff2a8;">Saturday walk-ins: self-guided perfume experiments available until 3:30 PM.</li><li style="--chip:#d9ff78;">Sunday walk-ins: self-guided only, available until 5:00 PM.</li><li style="--chip:#f3f3f3;">Monday, Tuesday, and Wednesday: closed for Lab bookings.</li></ul></aside></div>
    <div class="suas-book-grid">
      {% assign parfum_product = section.settings.parfum_product %}{% assign deluxe_product = section.settings.deluxe_product %}{% if deluxe_product == blank and section.settings.deluxe_product_handle != blank %}{% assign deluxe_handle = section.settings.deluxe_product_handle | handleize %}{% assign deluxe_product = all_products[deluxe_handle] %}{% endif %}
      <article class="suas-book-option" style="--card:#ffe8ef;"><div><span class="suas-book-badge">self-guided</span><h2>Self-Guided Perfume Experiment</h2><p class="suas-book-desc">Create a 30 mL eau de parfum at your pace. Add a 15 mL sample for an additional $15 when selected as a product variant.</p><strong class="suas-book-price">$35</strong></div>{% if parfum_product != blank %}{% form 'product', parfum_product, class:'suas-book-form', data-booking-form:'self' %}{% if parfum_product.has_only_default_variant %}<input type="hidden" name="id" value="{{ parfum_product.selected_or_first_available_variant.id }}"><p class="suas-book-note">Create the 15 mL add-on as a product variant when you are ready.</p>{% else %}<div class="suas-book-field" data-wide><label class="suas-book-label" for="ParfumVariant">option</label><select class="suas-book-select" id="ParfumVariant" name="id">{% for variant in parfum_product.variants %}<option value="{{ variant.id }}"{% unless variant.available %} disabled{% endunless %}>{{ variant.title }} - {{ variant.price | money }}{% unless variant.available %} - full{% endunless %}</option>{% endfor %}</select></div>{% endif %}<input type="hidden" name="properties[Booking type]" value="Self-guided Perfume Experiment"><div class="suas-book-field"><label class="suas-book-label" for="ParfumDate">date</label><input class="suas-book-input" id="ParfumDate" type="date" name="properties[Preferred date]" required></div><div class="suas-book-field"><label class="suas-book-label" for="ParfumTime">arrival time</label><select class="suas-book-select suas-time-select" id="ParfumTime" name="properties[Preferred time]" required><option value="">choose time</option><option>12:00 PM</option><option>1:00 PM</option><option>2:00 PM</option><option>3:00 PM</option><option>4:00 PM</option><option>5:00 PM</option></select></div><div class="suas-book-field"><label class="suas-book-label" for="ParfumGuests">guests</label><input class="suas-book-input" id="ParfumGuests" type="number" name="quantity" min="1" value="1"></div><div class="suas-book-field"><label class="suas-book-label" for="ParfumPhone">phone</label><input class="suas-book-input" id="ParfumPhone" type="tel" name="properties[Phone number]" required></div><div class="suas-book-field" data-wide><label class="suas-book-label" for="ParfumName">name</label><input class="suas-book-input" id="ParfumName" type="text" name="properties[Guest name]" required></div><button class="suas-book-button" type="submit">add booking to cart</button>{% endform %}{% else %}<button class="suas-book-button" disabled>connect product in theme editor</button>{% endif %}</article>
      <article class="suas-book-option" style="--card:#d9ff78;"><div><span class="suas-book-badge">guided class</span><h2>Guided Lab Session</h2><p class="suas-book-desc">Guided 30 mL perfume experiment is $85 per person. Add 1 oz body oil (+$20), add 4 oz butter creme (+$20), or choose the Deluxe Lab Session for $140 with all three.</p><strong class="suas-book-price">$85+</strong></div>{% if deluxe_product != blank %}{% form 'product', deluxe_product, class:'suas-book-form', data-booking-form:'guided' %}<input type="hidden" name="properties[Booking type]" value="Guided Lab Session">{% if deluxe_product.has_only_default_variant %}<input type="hidden" name="id" value="{{ deluxe_product.selected_or_first_available_variant.id }}"><p class="suas-book-note">Add guided session variants for body oil, butter creme, and Deluxe Lab Session.</p>{% else %}<div class="suas-book-field" data-wide><label class="suas-book-label" for="GuidedVariant">experiment option</label><select class="suas-book-select" id="GuidedVariant" name="id">{% for variant in deluxe_product.variants %}<option value="{{ variant.id }}"{% unless variant.available %} disabled{% endunless %}>{{ variant.title }} - {{ variant.price | money }}{% unless variant.available %} - full{% endunless %}</option>{% endfor %}</select></div>{% endif %}<div class="suas-book-field"><label class="suas-book-label" for="GuidedDate">class date</label><input class="suas-book-input" id="GuidedDate" type="date" name="properties[Class date]" required></div><div class="suas-book-field"><label class="suas-book-label" for="GuidedTime">class time</label><select class="suas-book-select suas-time-select" id="GuidedTime" name="properties[Class time]" required><option value="">choose time</option><option>Thursday 6:00 PM - 7:30 PM</option><option>Friday 6:00 PM - 7:30 PM</option><option>Saturday 4:00 PM - 5:00 PM</option><option>Saturday 5:30 PM - 6:30 PM</option></select></div><div class="suas-book-field"><label class="suas-book-label" for="GuidedGuests">guests</label><input class="suas-book-input" id="GuidedGuests" type="number" name="quantity" min="1" max="12" value="1"></div><div class="suas-book-field"><label class="suas-book-label" for="GuidedPhone">phone</label><input class="suas-book-input" id="GuidedPhone" type="tel" name="properties[Phone number]" required></div><div class="suas-book-field" data-wide><label class="suas-book-label" for="GuidedName">name</label><input class="suas-book-input" id="GuidedName" type="text" name="properties[Guest name]" required></div>{% if deluxe_product.available %}<button class="suas-book-button" type="submit">add booking to cart</button>{% else %}<button class="suas-book-button" disabled>all guided classes full</button>{% endif %}{% endform %}{% else %}<button class="suas-book-button" disabled>connect guided product</button>{% endif %}</article>
    </div>
  </div>
  <script>(()=>{const root=document.currentScript.closest('.suas-bookings-page');if(!root)return;const today=new Date();const stamp=`${today.getFullYear()}-${String(today.getMonth()+1).padStart(2,'0')}-${String(today.getDate()).padStart(2,'0')}`;const dayNames=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];const selfTimes={0:['12:00 PM','1:00 PM','2:00 PM','3:00 PM','4:00 PM','5:00 PM'],4:['12:00 PM','1:00 PM','2:00 PM','3:00 PM','4:00 PM','5:00 PM'],5:['12:00 PM','1:00 PM','2:00 PM','3:00 PM','4:00 PM','5:00 PM'],6:['12:00 PM','1:00 PM','2:00 PM','3:00 PM']};const guidedTimes={4:['Thursday 6:00 PM - 7:30 PM'],5:['Friday 6:00 PM - 7:30 PM'],6:['Saturday 4:00 PM - 5:00 PM','Saturday 5:30 PM - 6:30 PM']};function dateDay(value){if(!value)return null;const bits=value.split('-').map(Number);return new Date(bits[0],bits[1]-1,bits[2]).getDay()}function reject(input,message){alert(message);input.value='';input.focus()}function setOptions(select,options){const current=select.value;select.innerHTML='<option value="">choose time</option>'+options.map(time=>`<option>${time}</option>`).join('');if(options.includes(current))select.value=current}root.querySelectorAll('input[type="date"]').forEach(input=>input.min=stamp);const selfForm=root.querySelector('[data-booking-form="self"]');if(selfForm){const date=selfForm.querySelector('input[type="date"]');const time=selfForm.querySelector('select[name="properties[Preferred time]"]');const update=()=>{const day=dateDay(date.value);if(day===null)return;const options=selfTimes[day]||[];if(!options.length){setOptions(time,[]);reject(date,`${dayNames[day]} is closed for self-guided bookings. Please choose Thursday, Friday, Saturday, or Sunday.`);return}setOptions(time,options)};date.addEventListener('change',update);selfForm.addEventListener('submit',event=>{const day=dateDay(date.value);const options=selfTimes[day]||[];if(!options.length||!options.includes(time.value)){event.preventDefault();alert('That self-guided time is outside the Lab walk-in window. Please choose an available day and arrival time.')}})}const guidedForm=root.querySelector('[data-booking-form="guided"]');if(guidedForm){const date=guidedForm.querySelector('input[type="date"]');const time=guidedForm.querySelector('select[name="properties[Class time]"]');const update=()=>{const day=dateDay(date.value);if(day===null)return;const options=guidedTimes[day]||[];if(!options.length){setOptions(time,[]);reject(date,`${dayNames[day]} is not available for guided Lab classes. Please choose Thursday, Friday, or Saturday.`);return}setOptions(time,options)};date.addEventListener('change',update);guidedForm.addEventListener('submit',event=>{const day=dateDay(date.value);const options=guidedTimes[day]||[];if(!options.length||!options.includes(time.value)){event.preventDefault();alert('That guided class time does not match the selected date. Please choose one of the available class times.')}})}})();</script>
</section>
{% schema %}{"name":"SUAS Bookings Page","settings":[{"type":"product","id":"body_oil_product","label":"Deprecated Body Oil product"},{"type":"product","id":"parfum_product","label":"Self-Guided Perfume Experiment product"},{"type":"product","id":"combo_product","label":"Deprecated Combo product"},{"type":"product","id":"deluxe_product","label":"Guided Lab Session product"},{"type":"text","id":"deluxe_product_handle","label":"Guided fallback product handle","info":"Use this if the product picker will not load the guided product."}],"presets":[{"name":"SUAS Bookings Page"}]}{% endschema %}
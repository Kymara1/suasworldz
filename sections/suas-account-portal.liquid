{%- liquid
  assign account_name = 'babe'
  if customer
    assign account_name = customer.first_name | default: customer.name | default: 'babe'
  endif

  assign saved_points = 0
  if customer
    assign saved_points = customer.metafields.suas.total_points.value
    if saved_points == blank
      assign saved_points = customer.metafields.custom.total_points.value
    endif
    if saved_points == blank
      assign saved_points = customer.metafields.loyalty.points.value
    endif
  endif
  assign saved_points = saved_points | default: 0 | plus: 0
  assign spend_points = 0
  assign reward_goal = 1000
  assign points_left = reward_goal
  assign points_progress = 0
  if customer
    assign spend_points = customer.total_spent | plus: 0 | divided_by: 100
    if spend_points > saved_points
      assign saved_points = spend_points
    endif
    assign points_left = reward_goal | minus: saved_points
    if points_left < 0
      assign points_left = 0
    endif
    assign points_progress = saved_points | times: 100 | divided_by: reward_goal
    if points_progress > 100
      assign points_progress = 100
    endif
  endif
-%}

{% render 'suas-os-account-styles' %}
{% render 'suas-a11y-auth-tabs' %}
<section class="suas-os-account" data-suas-account-hub data-shopify-points="{{ saved_points }}" aria-label="SUAS account">
  <div class="suas-os-wrap{% if customer %} is-wide{% endif %}">
    {% render 'suas-os-account-mark' %}

    {% unless customer %}
      <article class="suas-os-win">
        <div class="suas-os-winbar">
          <div class="suas-os-dots">
            <span class="suas-os-dot" style="--dot:#ff5f57"></span>
            <span class="suas-os-dot" style="--dot:#febc2e"></span>
            <span class="suas-os-dot" style="--dot:#28c840"></span>
          </div>
          <span class="suas-os-wintitle suas-mono">ACCOUNT.LOCK</span>
          <span class="suas-os-live suas-mono"><b></b>SECURE</span>
        </div>
        <div class="suas-os-body">
          <p class="suas-os-kicker">suas.os / security</p>
          <h1 class="suas-os-title suas-font">sign in first.</h1>
          <p class="suas-os-copy">this door stays locked until you log in or make an account. orders, addresses, and your notes wait on the other side.</p>
          <div class="suas-os-tabs" role="tablist" aria-label="Account access">
            <button class="suas-os-tab is-on" type="button" role="tab" id="suas-tab-login" data-suas-auth="login" aria-controls="suas-panel-login" aria-selected="true" tabindex="0">log in</button>
            <button class="suas-os-tab" type="button" role="tab" id="suas-tab-register" data-suas-auth="register" aria-controls="suas-panel-register" aria-selected="false" tabindex="-1">create account</button>
            <button class="suas-os-tab" type="button" role="tab" id="suas-tab-recover" data-suas-auth="recover" aria-controls="suas-panel-recover" aria-selected="false" tabindex="-1">forgot password</button>
          </div>

          <div class="suas-os-auth is-on" role="tabpanel" id="suas-panel-login" data-suas-auth-view="login" aria-labelledby="suas-tab-login">
            {% form 'customer_login' %}
              <input type="hidden" name="return_to" value="/pages/account">
              <div class="suas-os-errors">{{ form.errors | default_errors }}</div>
              <div class="suas-os-form">
                <div class="suas-os-field"><label for="suas-login-email">email</label><input id="suas-login-email" type="email" name="customer[email]" autocomplete="email" required></div>
                {% if form.password_needed %}
                  <div class="suas-os-field"><label for="suas-login-password">password</label><input id="suas-login-password" type="password" name="customer[password]" autocomplete="current-password" required></div>
                {% endif %}
                <button class="suas-os-btn is-dark" type="submit">log in</button>
              </div>
            {% endform %}
          </div>

          <div class="suas-os-auth" role="tabpanel" id="suas-panel-register" data-suas-auth-view="register" aria-labelledby="suas-tab-register" hidden inert>
            {% form 'create_customer' %}
              <input type="hidden" name="return_to" value="/pages/account">
              <div class="suas-os-errors">{{ form.errors | default_errors }}</div>
              <div class="suas-os-form">
                <div class="suas-os-two">
                  <div class="suas-os-field"><label for="suas-reg-first">first name</label><input id="suas-reg-first" type="text" name="customer[first_name]" autocomplete="given-name" required></div>
                  <div class="suas-os-field"><label for="suas-reg-last">last name</label><input id="suas-reg-last" type="text" name="customer[last_name]" autocomplete="family-name" required></div>
                </div>
                <div class="suas-os-field"><label for="suas-reg-email">email</label><input id="suas-reg-email" type="email" name="customer[email]" autocomplete="email" required></div>
                <div class="suas-os-field"><label for="suas-reg-password">password</label><input id="suas-reg-password" type="password" name="customer[password]" autocomplete="new-password" required></div>
                <button class="suas-os-btn is-dark" type="submit">create account</button>
              </div>
            {% endform %}
          </div>

          <div class="suas-os-auth" role="tabpanel" id="suas-panel-recover" data-suas-auth-view="recover" aria-labelledby="suas-tab-recover" hidden inert>
            {% form 'recover_customer_password' %}
              <div class="suas-os-errors">{{ form.errors | default_errors }}</div>
              {% if form.posted_successfully? %}
                <p class="suas-os-copy">reset email sent. check your inbox.</p>
              {% else %}
                <div class="suas-os-form">
                  <div class="suas-os-field"><label for="suas-recover-email">email</label><input id="suas-recover-email" type="email" name="email" autocomplete="email" required></div>
                  <button class="suas-os-btn is-dark" type="submit">send reset</button>
                </div>
              {% endif %}
            {% endform %}
          </div>
        </div>
      </article>
    {% else %}
      <div class="suas-os-mid">
        <article class="suas-os-win">
          <div class="suas-os-winbar">
            <div class="suas-os-dots">
              <span class="suas-os-dot" style="--dot:#ff5f57"></span>
              <span class="suas-os-dot" style="--dot:#febc2e"></span>
              <span class="suas-os-dot" style="--dot:#28c840"></span>
            </div>
            <span class="suas-os-wintitle suas-mono" data-suas-win-title>SECURITY.SYS</span>
            <span class="suas-os-live suas-mono"><b></b>IN</span>
          </div>
          <div class="suas-os-body">
            <section class="suas-os-view is-on" id="suas-view-security" data-suas-view="security" role="tabpanel" aria-labelledby="suas-hub-security">
              <p class="suas-os-kicker">suas.os / security</p>
              <h1 class="suas-os-title suas-font">hi, {{ account_name | downcase }}.</h1>
              <p class="suas-os-copy">you're in. email, password, and where we ship — that's the important part.</p>
              <div class="suas-os-list">
                <div class="suas-os-ticket"><span class="suas-os-icon" style="--tile:#fff1a8">@</span><span><strong>{{ customer.email }}</strong><small>signed-in email</small></span></div>
                <button class="suas-os-ticket" type="button" data-suas-open="addresses"><span class="suas-os-icon" style="--tile:#cdeeff">pin</span><span><strong>addresses</strong><small>shipping + pickup</small></span><span class="suas-os-mini suas-mono">edit</span></button>
                <a class="suas-os-ticket" href="{{ routes.account_logout_url }}"><span class="suas-os-icon" style="--tile:#ffd8e8">bye</span><span><strong>sign out</strong><small>lock this window</small></span><span class="suas-os-mini suas-mono">go</span></a>
              </div>
              {% form 'recover_customer_password', data-suas-recover: true %}
                <div class="suas-os-errors">{{ form.errors | default_errors }}</div>
                {% if form.posted_successfully? %}
                  <p class="suas-os-note">reset email sent to {{ customer.email }}.</p>
                {% else %}
                  <div class="suas-os-form">
                    <input type="hidden" name="email" value="{{ customer.email }}">
                    <button class="suas-os-btn is-dark" type="submit">email me a reset link</button>
                  </div>
                {% endif %}
              {% endform %}
            </section>

            <section class="suas-os-view" id="suas-view-orders" data-suas-view="orders" role="tabpanel" aria-labelledby="suas-hub-orders" hidden inert>
              <p class="suas-os-kicker">suas.os / orders</p>
              <h2 class="suas-os-title suas-font">your orders.</h2>
              <div class="suas-os-list">
                {% paginate customer.orders by 50 %}
                {% for order in customer.orders %}
                  <button class="suas-os-ticket" type="button" data-suas-open="order-{{ order.id }}">
                    <span class="suas-os-icon" style="--tile:#ffd8e8">{{ forloop.index }}</span>
                    <span>
                      <strong>{{ order.name }}</strong>
                      <small>{{ order.created_at | date: '%b %d, %Y' }} · {{ order.financial_status | replace: '_', ' ' }}</small>
                    </span>
                    <span class="suas-os-mini suas-mono">{{ order.total_price | money }}</span>
                  </button>
                {% else %}
                  <div class="suas-os-empty">no orders yet. go smell something.</div>
                {% endfor %}
                {% endpaginate %}
              </div>
            </section>

            <section class="suas-os-view" id="suas-view-addresses" data-suas-view="addresses" role="tabpanel" aria-labelledby="suas-hub-addresses" hidden inert>
              <p class="suas-os-kicker">suas.os / addresses</p>
              <h2 class="suas-os-title suas-font">where we ship.</h2>
              <p class="suas-os-copy">saved on your SUAS login. add or edit without leaving this window.</p>
              <div class="suas-os-list">
                {% for address in customer.addresses %}
                  <div class="suas-os-ticket">
                    <span class="suas-os-icon" style="--tile:#cdeeff">pin</span>
                    <span>
                      <strong>{{ address.name }}{% if address == customer.default_address %} · default{% endif %}</strong>
                      <small>{{ address.street }}, {{ address.city }} {{ address.zip }}</small>
                    </span>
                    <span class="suas-os-actions" style="margin:0">
                      <button class="suas-os-btn" type="button" data-suas-addr-edit="{{ address.id }}">edit</button>
                      {{ 'delete' | delete_customer_address_link: address.id }}
                    </span>
                  </div>
                  <div class="suas-os-addr-form" data-suas-addr-form="{{ address.id }}">
                    {% render 'suas-os-address-form', address: address, address_id: address.id %}
                  </div>
                {% else %}
                  <div class="suas-os-empty">no addresses yet.</div>
                {% endfor %}
              </div>
              <button class="suas-os-btn is-dark" type="button" data-suas-addr-edit="new">add address</button>
              <div class="suas-os-addr-form" data-suas-addr-form="new">
                {% render 'suas-os-address-form', address: customer.new_address, address_id: 'new' %}
              </div>
            </section>

            {% for order in customer.orders limit: 50 %}
              <section class="suas-os-view" data-suas-view="order-{{ order.id }}" hidden inert>
                {% render 'suas-os-order-card', order: order %}
              </section>
            {% endfor %}

            <section class="suas-os-view" id="suas-view-points" data-suas-view="points" role="tabpanel" aria-labelledby="suas-hub-points" hidden inert>
              <p class="suas-os-kicker">suas.os / points</p>
              <h2 class="suas-os-title suas-font">your points.</h2>
              <p class="suas-os-number suas-font">{{ saved_points }}</p>
              <p class="suas-os-copy">1 point for every $1 you spend. at 1,000 points you get $10 off. show this screen at checkout or in the Lab.</p>
              <div class="suas-os-progress" style="--progress: {{ points_progress }}%;" aria-label="{{ points_progress }} percent to reward"><span></span></div>
              <div class="suas-os-row"><span>0</span><span>{{ points_left }} pts to $10</span><span>{{ reward_goal }}</span></div>
              <div class="suas-os-list">
                <div class="suas-os-ticket"><span class="suas-os-icon" style="--tile:#d9ff78">$</span><span><strong>{{ customer.total_spent | money }} spent</strong><small>lifetime on this login</small></span></div>
                {% if saved_points >= reward_goal %}
                  <div class="suas-os-ticket"><span class="suas-os-icon" style="--tile:#fff1a8">ok</span><span><strong>reward ready</strong><small>$10 off. tell us at checkout.</small></span></div>
                {% endif %}
              </div>
            </section>

            <section class="suas-os-view" id="suas-view-journal" data-suas-view="journal" role="tabpanel" aria-labelledby="suas-hub-journal" hidden inert>
              <p class="suas-os-kicker">suas.os / journal</p>
              <h2 class="suas-os-title suas-font">what did you make?</h2>
              <p class="suas-os-copy">save a Lab mix or a favorite bottle. notes stay on this phone.</p>
              <form class="suas-os-form" data-suas-journal-form>
                <div class="suas-os-two">
                  <div class="suas-os-field"><label for="suas-journal-name">name</label><input id="suas-journal-name" name="name" placeholder="pink sugar villain" required></div>
                  <div class="suas-os-field"><label for="suas-journal-product">product</label><select id="suas-journal-product" name="product"><option>Perfume / Cologne</option><option>Roll-On</option><option>Body Oil</option><option>Butter Creme</option><option>Everything Mist</option><option>Candle</option></select></div>
                </div>
                <div class="suas-os-field"><label for="suas-journal-notes">notes</label><input id="suas-journal-notes" name="notes" placeholder="mandarin, vanilla, amber"></div>
                <div class="suas-os-field"><label for="suas-journal-vibe">how did it smell?</label><textarea id="suas-journal-vibe" name="vibe" placeholder="sweet, warm, clean, loud, soft..."></textarea></div>
                <button class="suas-os-btn is-dark" type="submit">save note</button>
              </form>
              <div class="suas-os-list" data-suas-journal-list></div>
            </section>
          </div>
        </article>

        <aside class="suas-os-win">
          <div class="suas-os-winbar">
            <div class="suas-os-dots">
              <span class="suas-os-dot" style="--dot:#ff5f57"></span>
              <span class="suas-os-dot" style="--dot:#febc2e"></span>
              <span class="suas-os-dot" style="--dot:#28c840"></span>
            </div>
            <span class="suas-os-wintitle suas-mono">QUICK.LAUNCH</span>
            <span class="suas-os-live suas-mono"><b></b>GO</span>
          </div>
          <div class="suas-os-body">
            <div class="suas-os-launch" role="tablist" aria-label="Account windows">
              <button class="suas-os-tile is-on" type="button" role="tab" id="suas-hub-security" style="--tile:#fff1a8" data-suas-open="security" aria-controls="suas-view-security" aria-selected="true" tabindex="0"><strong class="suas-font">security</strong><span>login + safety</span></button>
              <button class="suas-os-tile" type="button" role="tab" id="suas-hub-points" style="--tile:#fff1a8" data-suas-open="points" aria-controls="suas-view-points" aria-selected="false" tabindex="-1"><strong class="suas-font">points</strong><span>{{ saved_points }} pts</span></button>
              <button class="suas-os-tile" type="button" role="tab" id="suas-hub-orders" style="--tile:#ffd8e8" data-suas-open="orders" aria-controls="suas-view-orders" aria-selected="false" tabindex="-1"><strong class="suas-font">orders</strong><span>history</span></button>
              <button class="suas-os-tile" type="button" role="tab" id="suas-hub-addresses" style="--tile:#cdeeff" data-suas-open="addresses" aria-controls="suas-view-addresses" aria-selected="false" tabindex="-1"><strong class="suas-font">addresses</strong><span>ship here</span></button>
              <button class="suas-os-tile" type="button" role="tab" id="suas-hub-journal" style="--tile:#d9ff78" data-suas-open="journal" aria-controls="suas-view-journal" aria-selected="false" tabindex="-1"><strong class="suas-font">journal</strong><span>what you mixed</span></button>
            </div>
          </div>
        </aside>
      </div>
    {% endunless %}
  </div>
  <div class="suas-os-toast" data-suas-toast></div>
</section>

<script>
(() => {
  const root = document.querySelector('[data-suas-account-hub]');
  if (!root || root.dataset.ready === 'true') return;
  root.dataset.ready = 'true';

  const storageKey = 'suasAccountPortal.v2';
  const shopifyPoints = parseInt(root.dataset.shopifyPoints || '0', 10) || 0;
  const emptyState = { points: shopifyPoints, journal: [], log: [], answered: [] };

  const load = () => {
    try {
      const parsed = JSON.parse(localStorage.getItem(storageKey) || 'null');
      return { ...emptyState, ...(parsed || {}), points: Math.max(shopifyPoints, Number(parsed?.points || 0)) };
    } catch (error) {
      return { ...emptyState };
    }
  };

  let state = load();
  const save = () => localStorage.setItem(storageKey, JSON.stringify(state));
  const $ = (selector) => root.querySelector(selector);
  const $$ = (selector) => [...root.querySelectorAll(selector)];
  const toast = (message) => {
    const box = $('[data-suas-toast]');
    if (!box) return;
    box.textContent = message;
    box.classList.add('is-live');
    window.clearTimeout(box._timer);
    box._timer = window.setTimeout(() => box.classList.remove('is-live'), 2400);
  };

  const addPoints = (amount, reason) => {
    const pts = Number(amount) || 0;
    state.points += pts;
    state.log.unshift({ amount: pts, reason, date: new Date().toLocaleString() });
    state.log = state.log.slice(0, 12);
    save();
    render();
    toast('saved.');
  };

  const openView = (name) => {
    $$('[data-suas-view]').forEach((view) => {
      const on = view.dataset.suasView === name;
      view.classList.toggle('is-on', on);
      view.hidden = !on;
      if (on) view.removeAttribute('inert');
      else view.setAttribute('inert', '');
    });
    const tab = name.indexOf('order-') === 0 ? 'orders' : name;
    $$('[data-suas-open]').forEach((button) => {
      const on = button.dataset.suasOpen === tab;
      button.classList.toggle('is-on', on);
      if (button.getAttribute('role') === 'tab') {
        button.setAttribute('aria-selected', on ? 'true' : 'false');
        button.tabIndex = on ? 0 : -1;
      }
    });
    const titles = { security: 'SECURITY.SYS', orders: 'ORDERS.LOG', addresses: 'ADDRESS.BOOK', journal: 'SCENT.JOURNAL', points: 'POINTS.WALLET' };
    const win = $('[data-suas-win-title]');
    if (win) win.textContent = name.indexOf('order-') === 0 ? 'ORDER.FILE' : (titles[name] || 'SECURITY.SYS');
    try { history.replaceState(null, '', '#' + name); } catch (e) {}
  };

  const renderJournal = () => {
    const list = $('[data-suas-journal-list]');
    if (!list) return;
    list.innerHTML = state.journal.length
      ? state.journal.map((entry, index) => `<div class="suas-os-ticket" style="grid-template-columns:minmax(0,1fr) auto"><span><strong>${entry.name}</strong><small>${entry.product} • ${entry.date}</small></span><button class="suas-os-btn" type="button" data-delete-journal="${entry.id}">delete</button></div>`)
        .join('')
      : '<div class="suas-os-empty">no scents saved yet. add your first mix above.</div>';
  };

  const openAuth = window.suasBindAuthTabs(root);

  const render = () => { renderJournal(); };

  root.addEventListener('click', (event) => {
    const auth = event.target.closest('[data-suas-auth]');
    if (auth) openAuth(auth.dataset.suasAuth);
    const open = event.target.closest('[data-suas-open]');
    if (open) openView(open.dataset.suasOpen);
    const editAddr = event.target.closest('[data-suas-addr-edit]');
    if (editAddr) {
      openView('addresses');
      $$('[data-suas-addr-form]').forEach((form) => form.classList.toggle('is-on', form.dataset.suasAddrForm === editAddr.dataset.suasAddrEdit));
    }
    const cancelAddr = event.target.closest('[data-suas-addr-cancel]');
    if (cancelAddr) {
      const form = root.querySelector('[data-suas-addr-form="' + cancelAddr.dataset.suasAddrCancel + '"]');
      if (form) form.classList.remove('is-on');
    }
    const del = event.target.closest('[data-delete-journal]');
    if (del) {
      state.journal = state.journal.filter((entry) => entry.id !== del.dataset.deleteJournal);
      save();
      render();
      toast('note deleted.');
    }
  });

  const form = $('[data-suas-journal-form]');
  if (form) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      state.journal.unshift({ id: `${Date.now()}`, name: data.get('name') || 'untitled mix', product: data.get('product') || 'product', notes: data.get('notes') || '', vibe: data.get('vibe') || '', date: new Date().toLocaleDateString() });
      state.journal = state.journal.slice(0, 24);
      form.reset();
      addPoints(10, 'journal');
      openView('journal');
    });
  }

  render();
  const hash = (location.hash || '').replace('#', '');
  if (hash && $('[data-suas-view="' + hash + '"]')) openView(hash);
  const bootProvinces = () => {
    if (!window.Shopify || !Shopify.CountryProvinceSelector) return;
    if (document.getElementById('address_country_new')) {
      new Shopify.CountryProvinceSelector('address_country_new', 'address_province_new', { hideElement: 'address_province_container_new' });
    }
    {% if customer %}
    {% for address in customer.addresses %}
    if (document.getElementById('address_country_{{ address.id }}')) {
      new Shopify.CountryProvinceSelector('address_country_{{ address.id }}', 'address_province_{{ address.id }}', { hideElement: 'address_province_container_{{ address.id }}' });
    }
    {% endfor %}
    {% endif %}
  };
  bootProvinces();
  window.addEventListener('load', bootProvinces);
  const authHas = (name) => {
    const box = $(`[data-suas-auth-view="${name}"]`);
    if (!box) return false;
    return Boolean(box.querySelector('.errors, li')) || /reset email sent/i.test(box.textContent);
  };
  if (authHas('register') || location.hash === '#register') openAuth('register');
  else if (authHas('recover')) openAuth('recover');
})();
</script>
{% render 'suas-os-recover-stay' %}

{% schema %}{"name":"SUAS account portal","settings":[],"presets":[{"name":"SUAS account portal"}]}{% endschema %}

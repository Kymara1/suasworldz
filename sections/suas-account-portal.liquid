{%- liquid
  assign account_name = 'babe'
  if customer
    assign account_name = customer.first_name | default: customer.name | default: 'babe'
  endif

  assign suas_points = 0
  assign saved_blends = 0
  assign lab_visits = 0
  assign favorite_notes = blank

  if customer
    assign suas_points = customer.metafields.suas.total_points.value
    if suas_points == blank
      assign suas_points = customer.metafields.custom.total_points.value
    endif
    if suas_points == blank
      assign suas_points = customer.metafields.loyalty.points.value
    endif
    assign suas_points = suas_points | default: 0 | plus: 0

    assign saved_blends = customer.metafields.suas.saved_blends_count.value
    if saved_blends == blank
      assign saved_blends = customer.metafields.custom.saved_blends_count.value
    endif
    assign saved_blends = saved_blends | default: 0 | plus: 0

    assign lab_visits = customer.metafields.suas.lab_visits.value
    if lab_visits == blank
      assign lab_visits = customer.metafields.custom.lab_visits.value
    endif
    assign lab_visits = lab_visits | default: 0 | plus: 0

    assign favorite_notes = customer.metafields.suas.favorite_notes.value
    if favorite_notes == blank
      assign favorite_notes = customer.metafields.custom.favorite_notes.value
    endif
  endif

  assign reward_goal = 1000
  assign points_left = reward_goal | minus: suas_points
  if points_left < 0
    assign points_left = 0
  endif
  assign progress = suas_points | times: 100 | divided_by: reward_goal
  if progress > 100
    assign progress = 100
  endif
-%}

<style>
  @font-face {
    font-family: "Casual Human";
    src: url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Casual Human";
    src: url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  .suas-account-portal {
    --ink: #0d0d0d;
    --muted: rgba(13, 13, 13, 0.58);
    --line: rgba(13, 13, 13, 0.12);
    --cream: #fffaf4;
    --blush: #ffd7e8;
    --hot-blush: #ff9fc6;
    --yellow: #fff3a4;
    --blue: #cdefff;
    --green: #dbff9e;
    background:
      radial-gradient(circle at 8% 14%, rgba(255, 215, 232, 0.62), transparent 28%),
      radial-gradient(circle at 88% 4%, rgba(219, 255, 158, 0.42), transparent 24%),
      linear-gradient(180deg, #fffaf4 0%, #ffffff 48%, #fff8fb 100%);
    color: var(--ink);
    font-family: Futura, "Futura PT", Arial, sans-serif;
    min-height: 82vh;
    overflow: hidden;
    padding: clamp(30px, 5vw, 72px) clamp(16px, 4vw, 54px) 76px;
    position: relative;
  }

  .suas-account-portal * { box-sizing: border-box; }
  .suas-account-portal a { color: inherit; text-decoration: none; }

  .suas-account-portal::before {
    content: "SUAS";
    position: absolute;
    right: -4vw;
    top: 26px;
    color: rgba(13, 13, 13, 0.035);
    font-family: "Casual Human", Futura, Arial, sans-serif;
    font-size: clamp(140px, 21vw, 320px);
    font-weight: 700;
    line-height: 0.8;
    pointer-events: none;
    transform: rotate(-5deg);
  }

  .suas-account-shell {
    margin: 0 auto;
    max-width: 1180px;
    position: relative;
    z-index: 1;
  }

  .suas-account-brand-row {
    align-items: center;
    display: flex;
    gap: 14px;
    margin-bottom: 24px;
  }

  .suas-account-orb {
    background: conic-gradient(from 210deg, #f7d1ff, #dbff9e, #bce8ff, #ffc7df, #f7d1ff);
    border-radius: 999px;
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.14);
    height: 58px;
    width: 58px;
  }

  .suas-account-brand,
  .suas-account-title,
  .suas-account-card-title,
  .suas-account-number,
  .suas-account-bubble strong,
  .suas-account-empty-title {
    font-family: "Casual Human", Futura, Arial, sans-serif;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: lowercase;
  }

  .suas-account-brand {
    font-size: 42px;
    line-height: 1;
  }

  .suas-account-hero {
    align-items: end;
    display: grid;
    gap: 22px;
    grid-template-columns: minmax(0, 1fr) auto;
    margin-bottom: 28px;
  }

  .suas-account-kicker,
  .suas-account-label,
  .suas-account-btn,
  .suas-account-pill,
  .suas-account-table th,
  .suas-account-mini {
    font-family: Futura, "Futura PT", Arial, sans-serif;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .suas-account-kicker,
  .suas-account-label {
    color: var(--muted);
    font-size: 10px;
    font-weight: 700;
    margin: 0 0 9px;
  }

  .suas-account-title {
    font-size: clamp(56px, 8.8vw, 106px);
    line-height: 0.86;
    margin: 0;
    max-width: 820px;
  }

  .suas-account-actions,
  .suas-account-quick-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .suas-account-actions { justify-content: flex-end; }

  .suas-account-btn {
    align-items: center;
    appearance: none;
    background: #fff;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    box-shadow: 0 5px 0 var(--ink);
    display: inline-flex;
    font-size: 10px;
    font-weight: 700;
    justify-content: center;
    min-height: 44px;
    padding: 12px 18px;
    transition: transform 160ms ease, box-shadow 160ms ease, background-color 160ms ease;
  }

  .suas-account-btn:hover {
    background: var(--blush);
    box-shadow: 0 3px 0 var(--ink);
    transform: translateY(2px);
  }

  .suas-account-btn.is-dark {
    background: var(--ink);
    color: #fff;
  }

  .suas-account-btn.is-dark:hover {
    background: #fff;
    color: var(--ink);
  }

  .suas-account-grid {
    align-items: start;
    display: grid;
    gap: 22px;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
  }

  .suas-account-stack { display: grid; gap: 22px; }

  .suas-account-card {
    background: rgba(255, 255, 255, 0.88);
    border: 1.5px solid var(--ink);
    border-radius: 30px;
    box-shadow: 0 8px 0 var(--ink), 0 18px 44px rgba(0, 0, 0, 0.08);
    overflow: hidden;
  }

  .suas-account-card.is-points {
    background: linear-gradient(135deg, #fff7fb 0%, #fff 52%, #efffca 100%);
  }

  .suas-account-card-inner { padding: clamp(22px, 3vw, 34px); }

  .suas-account-card-title {
    font-size: clamp(36px, 5vw, 62px);
    line-height: 0.94;
    margin: 0;
  }

  .suas-account-copy {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.65;
    margin: 10px 0 0;
    max-width: 58ch;
  }

  .suas-account-number {
    font-size: clamp(76px, 10vw, 126px);
    line-height: 0.85;
    margin: 8px 0;
  }

  .suas-account-progress {
    background: rgba(13, 13, 13, 0.09);
    border-radius: 999px;
    height: 13px;
    margin: 24px 0 10px;
    overflow: hidden;
  }

  .suas-account-progress span {
    background: var(--ink);
    border-radius: inherit;
    display: block;
    height: 100%;
    width: var(--progress);
  }

  .suas-account-progress-row {
    color: var(--muted);
    display: flex;
    font-size: 12px;
    gap: 14px;
    justify-content: space-between;
  }

  .suas-account-bubbles {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 22px;
  }

  .suas-account-bubble {
    align-items: center;
    aspect-ratio: 1;
    background: var(--bubble);
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    box-shadow: 0 6px 0 var(--ink);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 16px;
    text-align: center;
  }

  .suas-account-bubble strong {
    font-size: clamp(28px, 4vw, 42px);
    line-height: 0.9;
  }

  .suas-account-bubble span {
    color: rgba(13, 13, 13, 0.62);
    font-size: 10px;
    letter-spacing: 0.16em;
    line-height: 1.35;
    margin-top: 10px;
    text-transform: uppercase;
  }

  .suas-account-list {
    display: grid;
    gap: 12px;
    margin-top: 20px;
  }

  .suas-account-list-item {
    align-items: center;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 22px;
    display: grid;
    gap: 12px;
    grid-template-columns: 48px minmax(0, 1fr) auto;
    min-height: 74px;
    padding: 13px 16px;
  }

  .suas-account-icon {
    align-items: center;
    background: var(--icon-color, var(--blush));
    border-radius: 999px;
    display: flex;
    font-family: "Casual Human", Futura, Arial, sans-serif;
    font-size: 22px;
    height: 48px;
    justify-content: center;
    width: 48px;
  }

  .suas-account-list-item strong {
    display: block;
    font-size: 15px;
    line-height: 1.3;
  }

  .suas-account-list-item span span {
    color: var(--muted);
    display: block;
    font-size: 12px;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .suas-account-arrow {
    font-family: "Casual Human", Futura, Arial, sans-serif;
    font-size: 26px;
  }

  .suas-account-table-wrap {
    margin-top: 20px;
    overflow-x: auto;
  }

  .suas-account-table {
    border-collapse: separate;
    border-spacing: 0 10px;
    min-width: 620px;
    width: 100%;
  }

  .suas-account-table th {
    color: var(--muted);
    font-size: 9px;
    padding: 0 14px 3px;
    text-align: left;
  }

  .suas-account-table td {
    background: #fff;
    border-bottom: 1px solid var(--line);
    border-top: 1px solid var(--line);
    font-size: 13px;
    padding: 16px 14px;
    vertical-align: middle;
  }

  .suas-account-table td:first-child { border-left: 1px solid var(--line); border-radius: 18px 0 0 18px; }
  .suas-account-table td:last-child { border-right: 1px solid var(--line); border-radius: 0 18px 18px 0; text-align: right; }

  .suas-account-pill {
    border: 1px solid var(--line);
    border-radius: 999px;
    display: inline-flex;
    font-size: 9px;
    padding: 7px 9px;
    white-space: nowrap;
  }

  .suas-account-empty {
    background: var(--cream);
    border: 1px dashed rgba(13, 13, 13, 0.24);
    border-radius: 24px;
    margin-top: 20px;
    padding: 24px;
    text-align: center;
  }

  .suas-account-empty-title {
    font-size: 34px;
    line-height: 1;
    margin: 0 0 8px;
  }

  .suas-account-login-card {
    background: #050505;
    color: #fff;
    margin: 0 auto;
    max-width: 840px;
    text-align: center;
  }

  .suas-account-login-logo {
    display: block;
    margin: 0 auto 22px;
    max-width: 120px;
    width: 32%;
  }

  .suas-account-login-card .suas-account-card-title {
    color: #fff;
    font-size: clamp(46px, 7vw, 76px);
  }

  .suas-account-login-card .suas-account-copy {
    color: rgba(255, 255, 255, 0.72);
    margin-left: auto;
    margin-right: auto;
  }

  .suas-account-login-card .suas-account-btn {
    box-shadow: 0 5px 0 #fff;
  }

  @media (max-width: 920px) {
    .suas-account-hero,
    .suas-account-grid { grid-template-columns: 1fr; }
    .suas-account-actions { justify-content: flex-start; }
  }

  @media (max-width: 680px) {
    .suas-account-portal { padding: 24px 14px 56px; }
    .suas-account-title { font-size: clamp(48px, 17vw, 70px); }
    .suas-account-bubbles { grid-template-columns: 1fr; }
    .suas-account-bubble { aspect-ratio: 2.35 / 1; border-radius: 28px; }
    .suas-account-list-item { grid-template-columns: 44px minmax(0, 1fr); }
    .suas-account-arrow { display: none; }
  }
</style>

<section class="suas-account-portal">
  <div class="suas-account-shell">
    <div class="suas-account-brand-row">
      <span class="suas-account-orb" aria-hidden="true"></span>
      <span class="suas-account-brand">suas</span>
    </div>

    {% if customer %}
      <div class="suas-account-hero">
        <div>
          <p class="suas-account-kicker">your account</p>
          <h1 class="suas-account-title">hi, {{ account_name | downcase }}.</h1>
        </div>
        <div class="suas-account-actions">
          <a class="suas-account-btn" href="{{ routes.account_url }}">orders + profile</a>
          <a class="suas-account-btn is-dark" href="{{ routes.account_logout_url }}">sign out</a>
        </div>
      </div>

      <div class="suas-account-grid">
        <div class="suas-account-stack">
          <article class="suas-account-card is-points">
            <div class="suas-account-card-inner">
              <p class="suas-account-label">your points</p>
              <p class="suas-account-number">{{ suas_points }}</p>
              <h2 class="suas-account-card-title">rewards are loading.</h2>
              <p class="suas-account-copy">Earn 1 point for every $1 spent. At 1,000 points, unlock $10 off online or in store.</p>
              <div class="suas-account-progress" style="--progress: {{ progress }}%;" aria-label="{{ progress }} percent toward next reward"><span></span></div>
              <div class="suas-account-progress-row">
                <span>0 pts</span>
                <span>{{ points_left }} pts to next $10</span>
                <span>{{ reward_goal }} pts</span>
              </div>
              <div class="suas-account-quick-actions" style="margin-top: 22px;">
                <a class="suas-account-btn is-dark" href="/collections/all">shop smells</a>
                <a class="suas-account-btn" href="/pages/shut-up-and-smell">visit the lab</a>
              </div>
            </div>
          </article>

          <article class="suas-account-card">
            <div class="suas-account-card-inner">
              <p class="suas-account-label">lovable account energy</p>
              <h2 class="suas-account-card-title">scent library.</h2>
              <p class="suas-account-copy">A soft place for blends, lab visits, and favorite notes. These cards are ready for your Shopify points and fragrance data.</p>
              <div class="suas-account-bubbles">
                <div class="suas-account-bubble" style="--bubble: #ffd7e8;"><strong>{{ saved_blends }}</strong><span>saved blends</span></div>
                <div class="suas-account-bubble" style="--bubble: #fff3a4;"><strong>{{ lab_visits }}</strong><span>lab visits</span></div>
                <div class="suas-account-bubble" style="--bubble: #cdefff;"><strong>{% if favorite_notes != blank %}yes{% else %}new{% endif %}</strong><span>{% if favorite_notes != blank %}{{ favorite_notes }}{% else %}favorite notes{% endif %}</span></div>
              </div>
              <div class="suas-account-quick-actions" style="margin-top: 22px;">
                <a class="suas-account-btn" href="/pages/shut-up-and-smell#build-a-fragrance">build a fragrance</a>
                <a class="suas-account-btn" href="/pages/shut-up-and-smell">book the lab</a>
              </div>
            </div>
          </article>

          <article class="suas-account-card">
            <div class="suas-account-card-inner">
              <p class="suas-account-label">recent activity</p>
              <h2 class="suas-account-card-title">orders.</h2>
              {% if customer.orders.size > 0 %}
                {% paginate customer.orders by 8 %}
                  <div class="suas-account-table-wrap">
                    <table class="suas-account-table">
                      <thead><tr><th>order</th><th>date</th><th>payment</th><th>status</th><th>total</th></tr></thead>
                      <tbody>
                        {% for order in customer.orders %}
                          <tr>
                            <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                            <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                            <td><span class="suas-account-pill">{{ order.financial_status_label | default: order.financial_status }}</span></td>
                            <td><span class="suas-account-pill">{{ order.fulfillment_status_label | default: order.fulfillment_status | default: 'processing' }}</span></td>
                            <td>{{ order.total_price | money_with_currency }}</td>
                          </tr>
                        {% endfor %}
                      </tbody>
                    </table>
                  </div>
                {% endpaginate %}
              {% else %}
                <div class="suas-account-empty">
                  <p class="suas-account-empty-title">no orders yet.</p>
                  <p class="suas-account-copy">When you shop online, your order history will live right here.</p>
                  <a class="suas-account-btn is-dark" href="/collections/all">shop smells</a>
                </div>
              {% endif %}
            </div>
          </article>
        </div>

        <aside class="suas-account-stack">
          <article class="suas-account-card">
            <div class="suas-account-card-inner">
              <p class="suas-account-label">profile</p>
              <h2 class="suas-account-card-title">your details.</h2>
              <div class="suas-account-list">
                <a class="suas-account-list-item" href="{{ routes.account_url }}">
                  <span class="suas-account-icon" style="--icon-color: #ffd7e8;">@</span>
                  <span><strong>{{ customer.name }}</strong><span>{{ customer.email }}</span></span>
                  <span class="suas-account-arrow">+</span>
                </a>
                <a class="suas-account-list-item" href="{{ routes.account_url }}">
                  <span class="suas-account-icon" style="--icon-color: #dbff9e;">pin</span>
                  <span><strong>addresses</strong><span>{% if customer.default_address %}{{ customer.default_address.city }}, {{ customer.default_address.province_code | default: customer.default_address.province }}{% else %}manage in Shopify account{% endif %}</span></span>
                  <span class="suas-account-arrow">+</span>
                </a>
              </div>
            </div>
          </article>

          <article class="suas-account-card">
            <div class="suas-account-card-inner">
              <p class="suas-account-label">quick doors</p>
              <div class="suas-account-list">
                <a class="suas-account-list-item" href="/collections/new-arrivals"><span class="suas-account-icon" style="--icon-color: #ffd7e8;">new</span><span><strong>new arrivals</strong><span>fresh from the shelf</span></span><span class="suas-account-arrow">+</span></a>
                <a class="suas-account-list-item" href="/collections/best-sellers"><span class="suas-account-icon" style="--icon-color: #fff3a4;">best</span><span><strong>best sellers</strong><span>the ones they love</span></span><span class="suas-account-arrow">+</span></a>
                <a class="suas-account-list-item" href="/collections/oddities"><span class="suas-account-icon" style="--icon-color: #cdefff;">odd</span><span><strong>oddities</strong><span>little experiments</span></span><span class="suas-account-arrow">+</span></a>
              </div>
            </div>
          </article>
        </aside>
      </div>
    {% else %}
      <article class="suas-account-card suas-account-login-card">
        <div class="suas-account-card-inner">
          <img class="suas-account-login-logo" src="{{ 'suas-logo.png' | asset_url }}" alt="SUAS">
          <p class="suas-account-label" style="color: rgba(255,255,255,.58);">your account</p>
          <h1 class="suas-account-card-title">suas 2.0 is loading.</h1>
          <p class="suas-account-copy">Sign in to see rewards, orders, scent notes, lab visits, and your saved fragrance world.</p>
          <div class="suas-account-quick-actions" style="justify-content: center; margin-top: 24px;">
            <a class="suas-account-btn" href="{{ routes.account_login_url }}">sign in</a>
            <a class="suas-account-btn is-dark" href="/pages/shut-up-and-smell">visit the lab</a>
          </div>
        </div>
      </article>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "SUAS account portal",
  "settings": [],
  "presets": [
    {
      "name": "SUAS account portal"
    }
  ]
}
{% endschema %}

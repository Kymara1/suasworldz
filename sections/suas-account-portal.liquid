{%- liquid
  assign account_name = 'babe'
  if customer
    assign account_name = customer.first_name | default: customer.name | default: 'babe'
  endif
  assign suas_points = 0
  if customer
    assign suas_points = customer.metafields.suas.total_points.value
    if suas_points == blank
      assign suas_points = customer.metafields.custom.total_points.value
    endif
    if suas_points == blank
      assign suas_points = customer.metafields.loyalty.points.value
    endif
    assign suas_points = suas_points | default: 0 | plus: 0
  endif
  assign reward_goal = 1000
  assign points_left = reward_goal | minus: suas_points
  if points_left < 0
    assign points_left = 0
  endif
  assign progress = suas_points | times: 100 | divided_by: reward_goal
  if progress > 100
    assign progress = 100
  endif
-%}
<style>
  @font-face{font-family:"Casual Human";src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-weight:400;font-display:swap}@font-face{font-family:"Casual Human";src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}.suas-account-hub{--ink:#0d0d0d;--muted:rgba(13,13,13,.58);--paper:#fffaf4;--pink:#ffd7e8;--hot:#ff9fc6;--yellow:#fff3a4;--blue:#cdefff;--green:#dbff9e;--lav:#e4d5ff;min-height:86vh;padding:clamp(22px,4vw,58px) 14px 62px;color:var(--ink);background:linear-gradient(rgba(13,13,13,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(13,13,13,.035) 1px,transparent 1px),radial-gradient(circle at 8% 12%,rgba(255,215,232,.58),transparent 28%),radial-gradient(circle at 88% 6%,rgba(219,255,158,.42),transparent 26%),linear-gradient(180deg,#fffaf4,#fff 54%,#fff8fb);background-size:24px 24px,24px 24px,auto,auto,auto;font-family:Futura,"Futura PT",Arial,sans-serif;overflow:hidden}.suas-account-hub *{box-sizing:border-box}.suas-account-hub a{color:inherit;text-decoration:none}.suas-ah-shell{width:min(1120px,100%);margin:0 auto}.suas-ah-brand{display:flex;align-items:center;gap:13px;margin-bottom:18px}.suas-ah-orb{width:50px;height:50px;border-radius:999px;background:conic-gradient(from 210deg,#f7d1ff,#dbff9e,#bce8ff,#ffc7df,#f7d1ff);box-shadow:0 12px 24px rgba(0,0,0,.13)}.suas-ah-logo,.suas-ah-title,.suas-ah-card h2,.suas-ah-number,.suas-ah-feature strong{font-family:"Casual Human",Futura,Arial,sans-serif!important;font-weight:700!important;letter-spacing:0!important}.suas-ah-logo{font-size:38px;line-height:1;text-transform:lowercase}.suas-ah-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,.42fr);gap:16px;align-items:stretch;margin-bottom:16px}.suas-ah-panel,.suas-ah-card,.suas-ah-feature,.suas-ah-ticket{border:2px solid var(--ink);border-radius:24px;background:rgba(255,255,255,.9);box-shadow:6px 7px 0 var(--ink)}.suas-ah-panel{padding:clamp(18px,3vw,30px)}.suas-ah-kicker,.suas-ah-btn,.suas-ah-mini,.suas-ah-label{font:900 9px/1 Futura,"Futura PT",Arial,sans-serif;letter-spacing:.18em;text-transform:uppercase}.suas-ah-kicker,.suas-ah-label{color:var(--muted)}.suas-ah-title{max-width:760px;margin:10px 0 12px;font-size:clamp(3rem,7vw,6.2rem);line-height:.82;text-transform:lowercase}.suas-ah-copy{max-width:58ch;margin:0;color:var(--muted);font-size:13px;line-height:1.55;font-weight:800}.suas-ah-actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:18px}.suas-ah-btn{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:11px 15px;border:2px solid var(--ink);border-radius:999px;background:#fff;box-shadow:0 4px 0 var(--ink);transition:transform 160ms ease,box-shadow 160ms ease}.suas-ah-btn:hover{transform:translateY(2px);box-shadow:0 2px 0 var(--ink);background:var(--pink)}.suas-ah-btn.is-dark{background:var(--ink);color:#fff}.suas-ah-status{display:grid;align-content:center;gap:11px;background:#050505;color:#fff}.suas-ah-status .suas-ah-copy{color:rgba(255,255,255,.72)}.suas-ah-grid{display:grid;grid-template-columns:minmax(0,1.06fr) minmax(280px,.72fr);gap:16px}.suas-ah-stack{display:grid;gap:16px}.suas-ah-card{padding:clamp(16px,2.4vw,24px)}.suas-ah-card h2{margin:5px 0 9px;font-size:clamp(2rem,4vw,3.5rem);line-height:.88;text-transform:lowercase}.suas-ah-number{margin:6px 0;font-size:clamp(4.2rem,8vw,7rem);line-height:.82}.suas-ah-progress{height:12px;margin:18px 0 8px;border-radius:999px;background:rgba(13,13,13,.1);overflow:hidden}.suas-ah-progress span{display:block;height:100%;width:var(--progress);border-radius:inherit;background:#101010}.suas-ah-row{display:flex;justify-content:space-between;gap:8px;color:var(--muted);font-size:11px;font-weight:800}.suas-ah-feature-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.suas-ah-feature{min-height:142px;padding:13px;display:flex;flex-direction:column;justify-content:space-between;background:var(--tile);transition:transform 160ms ease,box-shadow 160ms ease}.suas-ah-feature:hover{transform:translateY(2px);box-shadow:4px 5px 0 var(--ink)}.suas-ah-feature span{font-size:22px}.suas-ah-feature strong{font-size:clamp(1.4rem,2.4vw,2rem);line-height:.9;text-transform:lowercase}.suas-ah-feature small{color:rgba(13,13,13,.62);font-size:10px;line-height:1.3;font-weight:800}.suas-ah-ticket{display:grid;grid-template-columns:48px minmax(0,1fr) auto;gap:11px;align-items:center;min-height:70px;padding:12px;margin-top:10px;background:#fff}.suas-ah-icon{display:grid;place-items:center;width:48px;height:48px;border-radius:999px;background:var(--tile);font-family:"Casual Human",Futura,Arial,sans-serif;font-weight:700}.suas-ah-ticket strong{display:block;font-size:14px}.suas-ah-ticket small{display:block;color:var(--muted);font-size:11px;line-height:1.35}.suas-ah-pill{display:inline-flex;width:max-content;max-width:100%;padding:7px 9px;border:1.5px solid var(--ink);border-radius:999px;background:var(--yellow);box-shadow:0 3px 0 var(--ink)}@media(max-width:900px){.suas-ah-hero,.suas-ah-grid{grid-template-columns:1fr}.suas-ah-feature-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.suas-account-hub{padding:18px 10px 48px}.suas-ah-title{font-size:clamp(2.65rem,16vw,4.8rem)}.suas-ah-feature-grid{grid-template-columns:1fr 1fr;gap:8px}.suas-ah-feature{min-height:116px;border-radius:18px;padding:11px}.suas-ah-feature strong{font-size:1.1rem}.suas-ah-feature small{font-size:8.5px}.suas-ah-ticket{grid-template-columns:38px minmax(0,1fr);border-radius:18px}.suas-ah-icon{width:38px;height:38px}.suas-ah-ticket .suas-ah-mini{display:none}}
</style>
<section class="suas-account-hub">
  <div class="suas-ah-shell">
    <div class="suas-ah-brand"><span class="suas-ah-orb"></span><span class="suas-ah-logo">suas</span></div>
    <div class="suas-ah-hero"><article class="suas-ah-panel"><p class="suas-ah-kicker">account hub / suas 2.0</p><h1 class="suas-ah-title">{% if customer %}hi, {{ account_name | downcase }}.{% else %}your scent world lives here.{% endif %}</h1><p class="suas-ah-copy">Login, rewards, saved formulas, orders, design tools, games, and lab memories all get one cute front door.</p><div class="suas-ah-actions">{% if customer %}<a class="suas-ah-btn is-dark" href="{{ routes.account_url }}">orders + profile</a><a class="suas-ah-btn" href="{{ routes.account_logout_url }}">sign out</a>{% else %}<a class="suas-ah-btn is-dark" href="{{ routes.account_login_url }}">login</a><a class="suas-ah-btn" href="/account/register">create account</a>{% endif %}<a class="suas-ah-btn" href="/pages/bookings">book the lab</a></div></article><aside class="suas-ah-panel suas-ah-status"><span class="suas-ah-pill suas-ah-mini">lab status: open + mixing</span><p class="suas-ah-copy">Next up: connect Shopify customer metafields or a loyalty app so points, formulas, and saved designs become live account data.</p></aside></div>
    <div class="suas-ah-grid"><main class="suas-ah-stack"><article class="suas-ah-card"><p class="suas-ah-label">points</p><p class="suas-ah-number">{{ suas_points }}</p><h2>rewards loading.</h2><p class="suas-ah-copy">Earn points online and in store, then redeem them with a code, barcode, or reward card once the loyalty backend is connected.</p><div class="suas-ah-progress" style="--progress: {{ progress }}%;"><span></span></div><div class="suas-ah-row"><span>0 pts</span><span>{{ points_left }} pts to next reward</span><span>{{ reward_goal }} pts</span></div></article><article class="suas-ah-card"><p class="suas-ah-label">account doors</p><div class="suas-ah-feature-grid"><a class="suas-ah-feature" style="--tile:#ffd7e8" href="{{ routes.account_url }}"><span>lock</span><strong>security</strong><small>profile, address, login settings</small></a><a class="suas-ah-feature" style="--tile:#dbff9e" href="/pages/shut-up-and-smell#build-a-fragrance"><span>mix</span><strong>formula book</strong><small>save blends + scent notes</small></a><a class="suas-ah-feature" style="--tile:#cdefff" href="/pages/shut-up-and-smell#build-a-fragrance"><span>label</span><strong>design studio</strong><small>labels and bottle looks</small></a><a class="suas-ah-feature" style="--tile:#fff3a4" href="/pages/rewards"><span>pts</span><strong>rewards</strong><small>points, perks, coupons</small></a><a class="suas-ah-feature" style="--tile:#e4d5ff" href="/pages/games"><span>play</span><strong>games</strong><small>scent quizzes and minis</small></a><a class="suas-ah-feature" style="--tile:#ffc7df" href="/collections/all"><span>shop</span><strong>orders</strong><small>reorder the good stuff</small></a></div></article></main><aside class="suas-ah-stack"><article class="suas-ah-card"><p class="suas-ah-label">quick links</p><a class="suas-ah-ticket" href="/pages/bookings"><span class="suas-ah-icon" style="--tile:#dbff9e">+</span><span><strong>Book the Lab</strong><small>self-guided or guided class</small></span><span class="suas-ah-mini">go</span></a><a class="suas-ah-ticket" href="/pages/shut-up-and-smell"><span class="suas-ah-icon" style="--tile:#ffd7e8">s.</span><span><strong>Build a Formula</strong><small>up to four scent notes</small></span><span class="suas-ah-mini">go</span></a><a class="suas-ah-ticket" href="/pages/visit-us"><span class="suas-ah-icon" style="--tile:#cdefff">pin</span><span><strong>Visit Us</strong><small>188 W Franklin Blvd, Gastonia</small></span><span class="suas-ah-mini">map</span></a></article><article class="suas-ah-card"><p class="suas-ah-label">customer data</p><h2>{% if customer %}profile connected.{% else %}login required.{% endif %}</h2><p class="suas-ah-copy">{% if customer %}Signed in as {{ customer.email }}. Shopify orders are live; rewards and formulas can connect through metafields next.{% else %}Sign in first so Shopify can show order history. The SUAS-only extras are staged here for the next backend connection.{% endif %}</p></article></aside></div>
  </div>
</section>

<section class="suas-contact-page suas-os-page" aria-label="Contact SUAS">
  {% render 'suas-os-page-chrome' %}
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}@font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}
    .suas-contact-page.suas-os-page{padding:52px 14px 48px;min-height:calc(100vh - 36px)}
    .suas-contact-inner{max-width:none;margin:0}
    .suas-contact-title,.suas-contact-card h2{font-family:'Casual Human',Futura,Arial,sans-serif!important;letter-spacing:0!important;font-weight:400!important}
    .suas-contact-kicker{font:800 .72rem/1 Tahoma,Arial,sans-serif;letter-spacing:.28em;text-transform:uppercase;color:#d9ff78}
    .suas-contact-title{margin:8px 0 18px;font-size:clamp(2.4rem,6vw,4.4rem);line-height:.82;text-transform:lowercase;color:#d9ff78}
    .suas-contact-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:16px}
    .suas-contact-card,.suas-contact-form{border:2.5px solid #101010;border-radius:28px;padding:clamp(20px,3vw,28px)}
    .suas-contact-card{background:#ffe8ef}
    .suas-contact-card h2{margin:0 0 16px;font-size:clamp(2.2rem,4.4vw,3.6rem);line-height:.9;text-transform:lowercase;color:#101010}
    .suas-contact-card p,.suas-contact-card li{font:700 1rem/1.6 Tahoma,Arial,sans-serif;color:rgba(16,16,16,.82)}
    .suas-contact-card ul{margin:0 0 18px;padding-left:18px}
    .suas-socials{display:flex;flex-wrap:wrap;gap:10px}
    .suas-socials a{display:inline-flex;min-height:40px;align-items:center;border:2px solid #101010;border-radius:999px;background:#fff;color:#101010;padding:8px 15px;text-decoration:none;font:900 11px/1 Tahoma,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase}
    .suas-contact-form{display:grid;gap:12px;background:#d8dde6}
    .suas-contact-form label{font:900 10px/1 Tahoma,Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#101010}
    .suas-contact-form input,.suas-contact-form select,.suas-contact-form textarea{width:100%;min-height:48px;border:0;border-radius:18px;background:#fff;padding:12px 15px;font:700 14px/1.3 Tahoma,Arial,sans-serif;color:#101010}
    .suas-contact-form input[aria-invalid="true"],.suas-contact-form textarea[aria-invalid="true"],.suas-contact-form select[aria-invalid="true"]{outline:2px solid #8a1024}
    .suas-contact-field-error{margin:0;color:#8a1024;font:800 12px/1.35 Tahoma,Arial,sans-serif}
    .suas-contact-form textarea{min-height:150px;resize:vertical}
    .suas-contact-button{min-height:48px;border:2px solid #101010;border-radius:999px;background:#fff;font:900 12px/1 Tahoma,Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;cursor:pointer}
    .suas-contact-success{padding:14px 16px;border:2px solid #101010;border-radius:18px;background:#d9ff78;font:900 13px/1.4 Tahoma,Arial,sans-serif}
    .suas-contact-errors{padding:14px 16px;border:2px solid #101010;border-radius:18px;background:#ffd8e8;font:900 13px/1.4 Tahoma,Arial,sans-serif}
    @media(max-width:840px){.suas-contact-grid{grid-template-columns:1fr}}
  </style>
  <div class="suas-os-sheet">
    <div class="suas-os-titlebar"><span class="suas-os-orb" aria-hidden="true"></span><b>CONTACT.EXE</b><span class="suas-os-winbtns" aria-hidden="true"><i></i><i></i><i></i></span></div>
  <div class="suas-contact-inner suas-os-sheet-body">
    <p class="suas-contact-kicker">suas.os / support desk</p>
    <h1 class="suas-contact-title">send us a note.</h1>
    <div class="suas-contact-grid">
      <aside class="suas-contact-card">
        <h2>what’s this for?</h2>
        <ul>
          <li>Order questions</li>
          <li>Product issues</li>
          <li>Wholesale requests</li>
          <li>Parties, events, and scent moments</li>
        </ul>
        <p>We read the notes, match the vibe, and get back to you as soon as we can.</p>
        <div class="suas-socials">
          <a href="https://www.instagram.com/shopsuas/" target="_blank" rel="noopener">IG @shopsuas</a>
          <a href="https://www.facebook.com/search/top?q=suas" target="_blank" rel="noopener">FB Suas</a>
        </div>
      </aside>
      {% form 'contact', class: 'suas-contact-form', id: 'suas-contact-form' %}
        {% if form.posted_successfully? %}
          <div class="suas-contact-success" role="status">Message sent. We got you.</div>
        {% endif %}
        {% if form.errors %}
          <div class="suas-contact-errors" role="alert" id="suas-contact-errors">{{ form.errors | default_errors }}</div>
        {% endif %}
        <div>
          <label for="suas-contact-name">your name</label>
          <input
            id="suas-contact-name"
            type="text"
            name="contact[name]"
            value="{{ form.name }}"
            placeholder="first name is fine"
            autocomplete="name"
            required
            {% if form.errors contains 'name' or form.errors contains 'author' %}
              aria-invalid="true"
              aria-describedby="suas-contact-name-err"
            {% endif %}
          >
          {% if form.errors contains 'name' or form.errors contains 'author' %}
            <p class="suas-contact-field-error" id="suas-contact-name-err">name needed.</p>
          {% endif %}
        </div>
        <div>
          <label for="suas-contact-email">email</label>
          <input
            id="suas-contact-email"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            placeholder="you@email.com"
            autocomplete="email"
            required
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="suas-contact-email-err"
            {% endif %}
          >
          {% if form.errors contains 'email' %}
            <p class="suas-contact-field-error" id="suas-contact-email-err">use a real email.</p>
          {% endif %}
        </div>
        <div>
          <label for="suas-contact-topic">topic</label>
          <select id="suas-contact-topic" name="contact[topic]">
            <option>Order information</option>
            <option>Issue with an order</option>
            <option>Wholesale</option>
            <option>Parties & events</option>
            <option>Something else cute</option>
          </select>
        </div>
        <div>
          <label for="suas-contact-body">message</label>
          <textarea
            id="suas-contact-body"
            name="contact[body]"
            placeholder="tell us what’s up"
            required
            {% if form.errors contains 'body' %}
              aria-invalid="true"
              aria-describedby="suas-contact-body-err"
            {% endif %}
          >{{ form.body }}</textarea>
          {% if form.errors contains 'body' %}
            <p class="suas-contact-field-error" id="suas-contact-body-err">write a note.</p>
          {% endif %}
        </div>
        <button class="suas-contact-button" type="submit">send it</button>
      {% endform %}
    </div>
  </div>
  </div>
  <script>
    (function () {
      var form = document.getElementById('suas-contact-form');
      if (!form) return;
      var bad = form.querySelector('[aria-invalid="true"]');
      if (bad) bad.focus();
    })();
  </script>
</section>
{% schema %}{"name":"SUAS Contact Page","settings":[],"presets":[{"name":"SUAS Contact Page"}]}{% endschema %}

<section class="suas-contact-page" aria-label="Contact SUAS">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}@font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}
    .suas-contact-page{--ink:#101010;--pink:#ffd8e8;--blue:#cdeeff;--lime:#d9ff78;min-height:86vh;padding:clamp(42px,6vw,78px) clamp(18px,4vw,56px);background:radial-gradient(circle at 12% 18%,rgba(255,216,232,.55),transparent 30%),radial-gradient(circle at 90% 80%,rgba(217,255,120,.3),transparent 28%),#fbfaf7;color:var(--ink)}.suas-contact-inner{max-width:1020px;margin:0 auto}.suas-contact-title,.suas-contact-card h2,.suas-contact-button{font-family:'Casual Human',Futura,Arial,sans-serif!important;letter-spacing:0!important}.suas-contact-kicker{font:800 .78rem/1 Futura,Arial,sans-serif;letter-spacing:.34em;text-transform:uppercase;color:rgba(16,16,16,.48)}.suas-contact-title{margin:16px 0 26px;font-size:clamp(4rem,9vw,8rem);font-weight:400!important;line-height:.82;text-transform:lowercase}.suas-contact-grid{display:grid;grid-template-columns:.88fr 1.12fr;gap:18px}.suas-contact-card,.suas-contact-form{border:2px solid var(--ink);border-radius:28px;background:rgba(255,255,255,.82);box-shadow:7px 8px 0 var(--ink);padding:clamp(20px,3vw,30px)}.suas-contact-card{background:linear-gradient(145deg,#fff 0%,var(--pink) 150%)}.suas-contact-card h2{margin:0 0 16px;font-size:clamp(2.6rem,5vw,4.8rem);font-weight:400!important;line-height:.9}.suas-contact-card p,.suas-contact-card li{font:700 1rem/1.6 Futura,Arial,sans-serif;color:rgba(16,16,16,.68)}.suas-contact-card ul{margin:0 0 20px;padding-left:20px}.suas-socials{display:flex;flex-wrap:wrap;gap:10px}.suas-socials a{display:inline-flex;min-height:40px;align-items:center;border:2px solid var(--ink);border-radius:999px;background:#fff;color:var(--ink);box-shadow:0 3px 0 var(--ink);padding:8px 15px;text-decoration:none;font:900 12px/1 Futura,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase}.suas-contact-form{display:grid;gap:12px}.suas-contact-form input,.suas-contact-form select,.suas-contact-form textarea{width:100%;min-height:50px;border:1.5px solid rgba(16,16,16,.22);border-radius:18px;background:#fff;padding:12px 15px;font:700 14px/1.3 Futura,Arial,sans-serif;color:var(--ink)}.suas-contact-form textarea{min-height:150px;resize:vertical}.suas-contact-button{min-height:52px;border:2px solid var(--ink);border-radius:999px;background:var(--lime);box-shadow:0 5px 0 var(--ink);font-size:1.25rem;text-transform:lowercase;cursor:pointer}.suas-contact-success{padding:14px 16px;border:2px solid var(--ink);border-radius:18px;background:var(--lime);font:900 13px/1.4 Futura,Arial,sans-serif}.suas-contact-errors{padding:14px 16px;border:2px solid var(--ink);border-radius:18px;background:var(--pink);font:900 13px/1.4 Futura,Arial,sans-serif}@media(max-width:840px){.suas-contact-grid{grid-template-columns:1fr}.suas-contact-title{font-size:clamp(3.6rem,17vw,5.8rem)}}
  </style>
  <div class="suas-contact-inner"><p class="suas-contact-kicker">suas.os / support desk</p><h1 class="suas-contact-title">send us a note.</h1><div class="suas-contact-grid"><aside class="suas-contact-card"><h2>what’s this for?</h2><ul><li>Order questions</li><li>Product issues</li><li>Wholesale requests</li><li>Parties, events, and scent moments</li></ul><p>We read the notes, match the vibe, and get back to you as soon as we can.</p><div class="suas-socials"><a href="https://www.instagram.com/shopsuas/" target="_blank" rel="noopener">IG @shopsuas</a><a href="https://www.facebook.com/search/top?q=suas" target="_blank" rel="noopener">FB Suas</a></div></aside>{% form 'contact', class: 'suas-contact-form' %}{% if form.posted_successfully? %}<div class="suas-contact-success">Message sent. We got you.</div>{% endif %}{% if form.errors %}<div class="suas-contact-errors">{{ form.errors | default_errors }}</div>{% endif %}<input type="text" name="contact[name]" placeholder="Your name" required><input type="email" name="contact[email]" placeholder="Email" required><select name="contact[topic]" aria-label="Topic"><option>Order information</option><option>Issue with an order</option><option>Wholesale</option><option>Parties & events</option><option>Something else cute</option></select><textarea name="contact[body]" placeholder="Tell us what’s up" required></textarea><button class="suas-contact-button" type="submit">send it</button>{% endform %}</div></div>
</section>
{% schema %}{"name":"SUAS Contact Page","settings":[],"presets":[{"name":"SUAS Contact Page"}]}{% endschema %}
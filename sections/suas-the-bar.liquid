<section class="suas-the-bar" id="the-bar" aria-label="The Bar">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}
    .suas-the-bar{--ink:#101010;--cream:#f4f0e8;--lime:#d9ff78;color:var(--ink);background:linear-gradient(180deg,#ece7dc,#f7f3ea 40%,#e8e2d6);padding:clamp(28px,5vw,64px) 0 72px;font-family:Futura,'Futura PT',Arial,sans-serif}
    .suas-the-bar *{box-sizing:border-box}
    .suas-bar-wrap{width:min(1180px,calc(100vw - 28px));margin:0 auto}
    .suas-bar-head{display:flex;justify-content:space-between;align-items:end;gap:16px;margin:0 0 18px;flex-wrap:wrap}
    .suas-bar-head small{display:block;font-size:10px;letter-spacing:.2em;text-transform:uppercase;font-weight:900;margin:0 0 6px}
    .suas-bar-head h2{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(2.6rem,7vw,5.2rem);line-height:.82;text-transform:lowercase}
    .suas-bar-soon{border:2px solid var(--ink);background:var(--lime);padding:10px 14px;box-shadow:4px 5px 0 var(--ink);font-weight:900;letter-spacing:.08em;text-transform:uppercase;font-size:11px}
    .suas-bar-station{border:2px solid var(--ink);border-radius:28px;background:#f7f4ee;box-shadow:7px 8px 0 var(--ink);overflow:hidden}
    .suas-bar-window{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px;min-height:44px;padding:8px 14px;border-bottom:2px solid var(--ink);background:linear-gradient(180deg,#fff,#e8edf3)}
    .suas-bar-dots{display:flex;gap:7px}
    .suas-bar-dots b{width:11px;height:11px;border-radius:99px;background:var(--d)}
    .suas-bar-title{text-align:center;font-size:10px;letter-spacing:.18em;font-weight:900}
    .suas-bar-stage{padding:22px 18px 28px;background:radial-gradient(circle at 50% 0,rgba(255,255,255,.7),transparent 42%),#efeae0}
    .suas-bar-rail{height:14px;border:2px solid var(--ink);border-radius:8px;background:#2a2a2a;box-shadow:0 6px 0 rgba(16,16,16,.12)}
    .suas-bar-row{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:8px;margin-top:0;padding:0 4px}
    .suas-dispense{appearance:none;border:0;background:transparent;padding:0;cursor:pointer;display:flex;flex-direction:column;align-items:center;min-width:0}
    .suas-dispense .tube{width:min(100%,54px);height:118px;border:2px solid var(--ink);border-radius:999px 999px 18px 18px;background:linear-gradient(180deg,#fff 0 28%,var(--fill) 42% 100%);box-shadow:2px 3px 0 var(--ink);position:relative}
    .suas-dispense .nozzle{width:16px;height:22px;border:2px solid var(--ink);border-top:0;background:#1d1d1d}
    .suas-dispense em{margin-top:8px;font-style:normal;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(.85rem,1.6vw,1.15rem);line-height:.9;text-align:center}
    .suas-dispense[aria-pressed='true'] .tube{outline:3px solid var(--lime);transform:translateY(3px)}
    .suas-dispense:focus-visible{outline:3px solid var(--ink);outline-offset:4px}
    .suas-bar-mix{display:grid;grid-template-columns:minmax(180px,.7fr) minmax(0,1.3fr);gap:16px;align-items:center;margin-top:22px}
    .suas-bar-bottle{width:86px;height:210px;margin:18px auto 0;border:3px solid var(--ink);border-radius:22px 22px 34px 34px;background:linear-gradient(180deg,#fff,#e8e8e8);box-shadow:4px 5px 0 var(--ink);position:relative;overflow:visible}
    .suas-bar-bottle:before{content:'';position:absolute;left:50%;top:-18px;transform:translateX(-50%);width:28px;height:22px;background:#111;border-radius:4px 4px 0 0}
    .suas-bar-bottle:after{content:'';position:absolute;inset:8px 10px 12px;border-radius:16px 16px 26px 26px;background:inherit;opacity:.35;pointer-events:none}
    .suas-bar-copy h3{margin:0 0 8px;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(2rem,4vw,3.2rem);line-height:.86;text-transform:lowercase}
    .suas-bar-copy p{margin:0 0 12px;font-size:14px;font-weight:700;line-height:1.35;max-width:46ch}
    .suas-bar-chips{display:flex;flex-wrap:wrap;gap:8px;min-height:34px;margin:0 0 14px}
    .suas-bar-chips span{border:2px solid var(--ink);border-radius:999px;background:#fff;padding:6px 10px;font-size:12px;font-weight:800;text-transform:lowercase}
    .suas-bar-actions{display:flex;flex-wrap:wrap;gap:8px}
    .suas-bar-actions a,.suas-bar-actions button{min-height:44px;display:inline-flex;align-items:center;justify-content:center;border:2px solid var(--ink);border-radius:999px;padding:0 16px;background:#fff;color:var(--ink);box-shadow:0 4px 0 var(--ink);font-weight:900;text-decoration:none;cursor:pointer;font-family:inherit}
    .suas-bar-actions a[data-dark]{background:var(--ink);color:#fff}
    @media(max-width:820px){
      .suas-bar-row{grid-template-columns:repeat(4,minmax(0,1fr))}
      .suas-bar-mix{grid-template-columns:1fr}
    }
  </style>
  <div class="suas-bar-wrap">
    <div class="suas-bar-head">
      <div>
        <small>interactive retail / downtown gastonia</small>
        <h2>the bar.</h2>
      </div>
      <div class="suas-bar-soon">coming soon 11.2026</div>
    </div>
    <div class="suas-bar-station">
      <div class="suas-bar-window">
        <div class="suas-bar-dots"><b style="--d:#ff5f57"></b><b style="--d:#febc2e"></b><b style="--d:#28c840"></b></div>
        <div class="suas-bar-title">THE.BAR / TAP A DISPENSER</div>
        <div class="suas-bar-title">LIVE</div>
      </div>
      <div class="suas-bar-stage" data-suas-bar>
        <div class="suas-bar-rail" aria-hidden="true"></div>
        <div class="suas-bar-row">
          <button class="suas-dispense" type="button" data-note="neroli" style="--fill:#f6f1c4" aria-pressed="false"><span class="tube"></span><span class="nozzle"></span><em>neroli</em></button>
          <button class="suas-dispense" type="button" data-note="gardenia" style="--fill:#f4b7d4" aria-pressed="false"><span class="tube"></span><span class="nozzle"></span><em>gardenia</em></button>
          <button class="suas-dispense" type="button" data-note="pistachio" style="--fill:#e6d36a" aria-pressed="false"><span class="tube"></span><span class="nozzle"></span><em>pistachio</em></button>
          <button class="suas-dispense" type="button" data-note="cashmere" style="--fill:#f3efe8" aria-pressed="false"><span class="tube"></span><span class="nozzle"></span><em>cashmere</em></button>
          <button class="suas-dispense" type="button" data-note="berry crush" style="--fill:#e9cbb8" aria-pressed="false"><span class="tube"></span><span class="nozzle"></span><em>berry crush</em></button>
          <button class="suas-dispense" type="button" data-note="sandalwood" style="--fill:#efe3b8" aria-pressed="false"><span class="tube"></span><span class="nozzle"></span><em>sandalwood</em></button>
          <button class="suas-dispense" type="button" data-note="vanilla silk" style="--fill:#f7f1dc" aria-pressed="false"><span class="tube"></span><span class="nozzle"></span><em>vanilla silk</em></button>
          <button class="suas-dispense" type="button" data-note="mahogany" style="--fill:#efe9d4" aria-pressed="false"><span class="tube"></span><span class="nozzle"></span><em>mahogany</em></button>
        </div>
        <div class="suas-bar-mix">
          <div class="suas-bar-bottle" data-blend></div>
          <div class="suas-bar-copy">
            <h3>mix it like the store.</h3>
            <p>Tap up to 3 notes. Same move as The Lab wall. Save the idea, then bottle it downtown.</p>
            <div class="suas-bar-chips" data-chips><span>tap a dispenser</span></div>
            <div class="suas-bar-actions">
              <button type="button" data-reset>start over</button>
              <a data-dark href="/pages/bookings">book the lab</a>
              <a href="/pages/the-lab">full lab walkthrough</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script>
    (function () {
      var root = document.currentScript.closest('.suas-the-bar');
      if (!root || root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';
      var notes = [];
      var colors = { neroli:'#f6f1c4', gardenia:'#f4b7d4', pistachio:'#e6d36a', cashmere:'#f3efe8', 'berry crush':'#e9cbb8', sandalwood:'#efe3b8', 'vanilla silk':'#f7f1dc', mahogany:'#efe9d4' };
      var bottle = root.querySelector('[data-blend]');
      var chips = root.querySelector('[data-chips]');
      var book = root.querySelector('a[data-dark]');
      function paint() {
        root.querySelectorAll('.suas-dispense').forEach(function (btn) {
          btn.setAttribute('aria-pressed', notes.indexOf(btn.getAttribute('data-note')) >= 0 ? 'true' : 'false');
        });
        chips.innerHTML = notes.length
          ? notes.map(function (n) { return '<span>' + n + '</span>'; }).join('')
          : '<span>tap a dispenser</span>';
        var mix = notes.map(function (n) { return colors[n]; }).join(',');
        bottle.style.background = notes.length ? 'linear-gradient(180deg,#fff,' + mix + ')' : 'linear-gradient(180deg,#fff,#e8e8e8)';
        var q = notes.length ? ('?mix=' + encodeURIComponent(notes.join(' + '))) : '';
        book.href = '/pages/bookings' + q;
      }
      root.querySelectorAll('.suas-dispense').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var note = btn.getAttribute('data-note');
          var i = notes.indexOf(note);
          if (i >= 0) notes.splice(i, 1);
          else if (notes.length < 3) notes.push(note);
          paint();
        });
      });
      root.querySelector('[data-reset]').addEventListener('click', function () { notes = []; paint(); });
      paint();
    })();
  </script>
</section>
{% schema %}
{
  "name": "SUAS The Bar",
  "settings": [],
  "presets": [{ "name": "SUAS The Bar" }]
}
{% endschema %}

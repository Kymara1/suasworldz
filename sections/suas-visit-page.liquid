<section class="suas-visit-page" aria-label="Visit SUAS">
  <style>
    @font-face { font-family: 'Casual Human'; src: url({{ 'CasualHuman.otf' | asset_url }}) format('opentype'); font-display: swap; }
    @font-face { font-family: 'Casual Human'; src: url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype'); font-weight: 700; font-display: swap; }
    .suas-visit-page { --ink:#101010; --paper:#f6f7fa; --pink:#ffc3d7; --blue:#bfe8ff; --lime:#d9ff78; min-height:88vh; padding:clamp(46px,6vw,82px) clamp(18px,4vw,56px); color:var(--ink); background:linear-gradient(rgba(16,16,16,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.035) 1px,transparent 1px),radial-gradient(circle at 78% 15%,rgba(217,255,120,.28),transparent 30%),radial-gradient(circle at 12% 75%,rgba(255,195,215,.34),transparent 28%),var(--paper); background-size:22px 22px,22px 22px,auto,auto,auto; }
    .suas-visit-inner { max-width:1080px; margin:0 auto; }
    .suas-visit-kicker { font-family:Futura,Arial,sans-serif; font-size:.8rem; letter-spacing:.34em; text-transform:uppercase; color:rgba(16,16,16,.48); }
    .suas-visit-title, .suas-visit-card h2, .suas-visit-button { font-family:'Casual Human',Futura,Arial,sans-serif!important; font-weight:700!important; letter-spacing:0!important; }
    .suas-visit-title { max-width:850px; margin:18px 0 22px; font-size:clamp(3.8rem,9vw,8rem); line-height:.82; text-transform:lowercase; }
    .suas-visit-copy { max-width:680px; font-family:Futura,Arial,sans-serif; font-size:clamp(1rem,1.45vw,1.16rem); line-height:1.7; }
    .suas-visit-grid { display:grid; grid-template-columns:1fr 1fr; gap:18px; margin-top:34px; align-items:stretch; }
    .suas-visit-card { min-height:210px; display:flex; flex-direction:column; justify-content:space-between; padding:24px; border:2px solid var(--ink); border-radius:26px; background:rgba(255,255,255,.78); box-shadow:7px 8px 0 var(--ink); }
    .suas-visit-card:nth-child(1){background:linear-gradient(160deg,#fff 0%,var(--pink) 160%);} .suas-visit-card:nth-child(2){background:linear-gradient(160deg,#fff 0%,var(--lime) 160%);} .suas-visit-card:nth-child(3){background:linear-gradient(160deg,#fff 0%,var(--blue) 160%); grid-column:1 / -1; min-height:160px;}
    .suas-visit-card h2 { margin:0 0 14px; font-size:clamp(2.3rem,4vw,4rem); line-height:.9; text-transform:lowercase; }
    .suas-visit-card p { margin:0 0 10px; font-family:Futura,Arial,sans-serif; font-weight:700; line-height:1.55; color:rgba(16,16,16,.68); }
    .suas-map-box { min-height:190px; display:grid; place-items:center; margin-top:16px; border:2px solid var(--ink); border-radius:24px; background:linear-gradient(rgba(16,16,16,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.045) 1px,transparent 1px),#fff; background-size:20px 20px; color:var(--ink); text-decoration:none; box-shadow:inset 0 0 0 10px rgba(255,216,232,.28); }
    .suas-map-box span { display:inline-flex; align-items:center; justify-content:center; min-height:48px; padding:10px 18px; border:2px solid var(--ink); border-radius:999px; background:var(--lime); box-shadow:0 4px 0 var(--ink); font:900 12px/1 Futura,Arial,sans-serif; letter-spacing:.13em; text-transform:uppercase; }
    .suas-visit-actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:34px; }
    .suas-visit-button { display:inline-flex; min-height:50px; align-items:center; justify-content:center; padding:13px 24px; border:2px solid var(--ink); border-radius:999px; color:var(--ink); background:#fff; box-shadow:0 5px 0 var(--ink); text-decoration:none; text-transform:lowercase; transition:transform 160ms ease,box-shadow 160ms ease,background 160ms ease; }
    .suas-visit-button:hover { color:var(--ink); background:var(--pink); transform:translateY(2px); box-shadow:0 3px 0 var(--ink); }
    .suas-visit-button[data-dark] { color:#fff; background:var(--ink); }
    @media (max-width:760px){ .suas-visit-grid{grid-template-columns:1fr;} .suas-visit-card:nth-child(3){grid-column:auto;} .suas-visit-card{min-height:170px;} .suas-map-box{min-height:150px;} }
  </style>
  <div class="suas-visit-inner">
    <p class="suas-visit-kicker">{{ section.settings.kicker }}</p>
    <h1 class="suas-visit-title">{{ section.settings.heading }}</h1>
    <div class="suas-visit-copy">{{ section.settings.copy }}</div>
    <div class="suas-visit-grid">
      <article class="suas-visit-card"><h2>address.</h2><p>188 W Franklin Blvd<br>Gastonia, NC 28052</p><a class="suas-map-box" href="https://www.google.com/maps/search/?api=1&query=188%20W%20Franklin%20Blvd%2C%20Gastonia%20NC%2028052" target="_blank" rel="noopener"><span>open directions</span></a></article>
      <article class="suas-visit-card"><h2>parking.</h2><p>Public parking is directly across the street. Pull up, park, and come smell something pretty.</p><p>For Lab bookings, give yourself a few extra minutes so you can settle in before your session starts.</p></article>
      <article class="suas-visit-card"><h2>what to do when you get here.</h2><p>Shop the floor, ask what’s mixing, or head into The Lab for your custom scent experience.</p></article>
    </div>
    <div class="suas-visit-actions"><a class="suas-visit-button" data-dark href="/pages/bookings">book the lab</a><a class="suas-visit-button" href="/pages/shut-up-and-smell">visit the lab page</a><a class="suas-visit-button" href="/pages/contact">contact us</a></div>
  </div>
</section>
{% schema %}{"name":"SUAS Visit Page","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"suas.os / visit us"},{"type":"text","id":"heading","label":"Heading","default":"come smell with us."},{"type":"richtext","id":"copy","label":"Intro","default":"<p>Pull up for scent, self care, home fragrance, and The Lab in Gastonia, NC.</p>"}],"presets":[{"name":"SUAS Visit Page"}]}{% endschema %}
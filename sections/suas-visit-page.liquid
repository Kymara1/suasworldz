<section class="suas-visit-page" aria-label="Visit SUAS">
  <style>
    @font-face { font-family: 'Casual Human'; src: url({{ 'CasualHuman.otf' | asset_url }}) format('opentype'); font-display: swap; }
    @font-face { font-family: 'Casual Human'; src: url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype'); font-weight: 700; font-display: swap; }
    .suas-visit-page { --ink:#101010; --paper:#f6f7fa; --pink:#ffc3d7; --blue:#bfe8ff; --lime:#d9ff78; min-height:88vh; padding:clamp(52px,7vw,96px) clamp(18px,4vw,60px); color:var(--ink); background:linear-gradient(rgba(16,16,16,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.035) 1px,transparent 1px),radial-gradient(circle at 78% 15%,rgba(217,255,120,.28),transparent 30%),radial-gradient(circle at 12% 75%,rgba(255,195,215,.34),transparent 28%),var(--paper); background-size:22px 22px,22px 22px,auto,auto,auto; }
    .suas-visit-inner { max-width:1080px; margin:0 auto; }
    .suas-visit-kicker { font-family:Futura,Arial,sans-serif; font-size:.8rem; letter-spacing:.34em; text-transform:uppercase; color:rgba(16,16,16,.48); }
    .suas-visit-title, .suas-visit-card h2, .suas-visit-button { font-family:'Casual Human',Futura,Arial,sans-serif!important; font-weight:700!important; letter-spacing:0!important; }
    .suas-visit-title { max-width:850px; margin:18px 0 26px; font-size:clamp(4rem,10vw,9rem); line-height:.82; text-transform:lowercase; }
    .suas-visit-copy { max-width:640px; font-family:Futura,Arial,sans-serif; font-size:clamp(1rem,1.45vw,1.18rem); line-height:1.75; }
    .suas-visit-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; margin-top:42px; }
    .suas-visit-card { min-height:220px; display:flex; flex-direction:column; justify-content:space-between; padding:24px; border:2px solid var(--ink); border-radius:8px; background:rgba(255,255,255,.72); box-shadow:8px 8px 0 var(--ink); }
    .suas-visit-card:nth-child(1){background:linear-gradient(160deg,#fff 0%,var(--pink) 160%);} .suas-visit-card:nth-child(2){background:linear-gradient(160deg,#fff 0%,var(--lime) 160%);} .suas-visit-card:nth-child(3){background:linear-gradient(160deg,#fff 0%,var(--blue) 160%);}
    .suas-visit-card h2 { margin:0; font-size:clamp(2.2rem,4vw,3.8rem); line-height:.9; text-transform:lowercase; }
    .suas-visit-card p { margin:22px 0 0; font-family:Futura,Arial,sans-serif; line-height:1.55; }
    .suas-visit-actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:40px; }
    .suas-visit-button { display:inline-flex; min-height:52px; align-items:center; justify-content:center; padding:13px 26px; border:2px solid var(--ink); border-radius:999px; color:var(--ink); background:#fff; box-shadow:0 5px 0 var(--ink); text-decoration:none; text-transform:lowercase; transition:transform 160ms ease,box-shadow 160ms ease,background 160ms ease; }
    .suas-visit-button:hover { color:var(--ink); background:var(--pink); transform:translateY(2px); box-shadow:0 3px 0 var(--ink); }
    .suas-visit-button[data-dark] { color:#fff; background:var(--ink); }
    @media (max-width:760px){ .suas-visit-grid{grid-template-columns:1fr;} .suas-visit-card{min-height:180px;} }
  </style>
  <div class="suas-visit-inner">
    <p class="suas-visit-kicker">{{ section.settings.kicker }}</p>
    <h1 class="suas-visit-title">{{ section.settings.heading }}</h1>
    <div class="suas-visit-copy">{{ section.settings.copy }}</div>
    <div class="suas-visit-grid">
      <article class="suas-visit-card"><h2>{{ section.settings.card_one_title }}</h2><p>{{ section.settings.card_one_text }}</p></article>
      <article class="suas-visit-card"><h2>{{ section.settings.card_two_title }}</h2><p>{{ section.settings.card_two_text }}</p></article>
      <article class="suas-visit-card"><h2>{{ section.settings.card_three_title }}</h2><p>{{ section.settings.card_three_text }}</p></article>
    </div>
    <div class="suas-visit-actions"><a class="suas-visit-button" data-dark href="/pages/shut-up-and-smell">visit the lab</a><a class="suas-visit-button" href="/pages/build-your-formula">build a formula</a><a class="suas-visit-button" href="/pages/contact">contact us</a></div>
  </div>
</section>
{% schema %}{"name":"SUAS Visit Page","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"suas.os / visit us"},{"type":"text","id":"heading","label":"Heading","default":"come smell with us."},{"type":"richtext","id":"copy","label":"Intro","default":"<p>Pull up for scent, self care, home fragrance, and the in-store lab experience in Gastonia, NC.</p>"},{"type":"text","id":"card_one_title","label":"Card one title","default":"shop"},{"type":"textarea","id":"card_one_text","label":"Card one text","default":"Browse body, home, feminine, masculine, and oddities by mood."},{"type":"text","id":"card_two_title","label":"Card two title","default":"lab"},{"type":"textarea","id":"card_two_text","label":"Card two text","default":"Book your fragrance moment and build a custom scent formula."},{"type":"text","id":"card_three_title","label":"Card three title","default":"pickup"},{"type":"textarea","id":"card_three_text","label":"Card three text","default":"Shop online, visit in-store, or use the lab page to plan your next blend."}],"presets":[{"name":"SUAS Visit Page"}]}{% endschema %}
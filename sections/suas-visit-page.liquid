<section class="suas-visit-page suas-os-page" aria-label="Visit SUAS">
  {% render 'suas-os-page-chrome' %}
  <style>
    @font-face { font-family: 'Casual Human'; src: url({{ 'CasualHuman.otf' | asset_url }}) format('opentype'); font-display: swap; }
    @font-face { font-family: 'Casual Human'; src: url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype'); font-weight: 700; font-display: swap; }
    .suas-visit-page.suas-os-page { padding:28px 14px 36px; min-height:0; }
    .suas-visit-inner { padding:4px 2px 2px; }
    .suas-visit-kicker { margin:0 0 10px; font:800 .68rem/1 Tahoma,Arial,sans-serif; letter-spacing:.22em; text-transform:uppercase; color:#d9ff78; }
    .suas-visit-title, .suas-visit-card h2 { font-family:'Casual Human',Futura,Arial,sans-serif!important; font-weight:400!important; letter-spacing:0!important; }
    .suas-visit-page.suas-os-page h1.suas-visit-title { max-width:720px; margin:0 0 16px; font-size:clamp(1.7rem,4vw,2.7rem); line-height:.94; text-transform:lowercase; color:#d9ff78; }
    .suas-visit-copy, .suas-visit-copy p { max-width:640px; margin:0; font:700 .92rem/1.45 Tahoma,Arial,sans-serif; color:#fff; }
    .suas-visit-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:16px; align-items:stretch; }
    .suas-visit-card { min-height:0; display:flex; flex-direction:column; justify-content:space-between; padding:14px 16px; border:2.5px solid #101010; border-radius:22px; background:#fff; }
    .suas-visit-card:nth-child(1){background:#ffe8ef;} .suas-visit-card:nth-child(2){background:#eaf8c8;} .suas-visit-card:nth-child(3){background:#e7f3ff; grid-column:1 / -1; min-height:0;}
    .suas-visit-card h2 { margin:0 0 8px; font-size:clamp(1.35rem,2.6vw,1.9rem); line-height:.95; text-transform:lowercase; color:#101010; }
    .suas-visit-card p { margin:0 0 8px; font:700 13px/1.45 Tahoma,Arial,sans-serif; color:rgba(16,16,16,.72); }
    .suas-map-box { min-height:88px; display:grid; place-items:center; margin-top:10px; border:2.5px solid #101010; border-radius:18px; background:linear-gradient(rgba(16,16,16,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.045) 1px,transparent 1px),#fff; background-size:18px 18px; color:var(--ink); text-decoration:none; }
    .suas-map-box span { display:inline-flex; align-items:center; justify-content:center; min-height:36px; padding:8px 14px; border:2px solid #101010; border-radius:999px; background:#d9ff78; font:900 10px/1 Tahoma,Arial,sans-serif; letter-spacing:.13em; text-transform:uppercase; }
    .suas-visit-actions { display:flex; flex-wrap:wrap; gap:8px; margin-top:14px; }
    .suas-visit-page a.suas-visit-button,
    .suas-visit-button { display:inline-flex; min-height:44px; align-items:center; justify-content:center; padding:10px 16px; border:2px solid #d9ff78 !important; border-radius:999px; color:#101010 !important; background:#d9ff78 !important; font:900 10px/1 Tahoma,Arial,sans-serif; letter-spacing:.08em; text-decoration:none !important; text-transform:uppercase; box-shadow:0 3px 0 #101010; }
    .suas-visit-page a.suas-visit-button:hover,
    .suas-visit-button:hover { color:#101010 !important; background:#fff1a8 !important; border-color:#101010 !important; transform:translateY(1px); box-shadow:0 2px 0 #101010; }
    .suas-visit-page a.suas-visit-button[data-dark],
    .suas-visit-button[data-dark] { color:#fff !important; background:#101010 !important; border-color:#101010 !important; }
    .suas-visit-page a.suas-visit-button[data-dark]:hover,
    .suas-visit-button[data-dark]:hover { color:#101010 !important; background:#d9ff78 !important; }
    @media (max-width:760px){ .suas-visit-grid{grid-template-columns:1fr;} .suas-visit-card:nth-child(3){grid-column:auto;} .suas-visit-card{min-height:0;} .suas-map-box{min-height:72px;} }
  </style>
  <div class="suas-os-sheet">
    <div class="suas-os-titlebar"><span class="suas-os-orb" aria-hidden="true"></span><b>VISIT.EXE</b><span class="suas-os-winbtns" aria-hidden="true"><i></i><i></i><i></i></span></div>
  <div class="suas-visit-inner suas-os-sheet-body">
    <p class="suas-visit-kicker">{{ section.settings.kicker }}</p>
    <h1 class="suas-visit-title">{{ section.settings.heading }}</h1>
    <div class="suas-visit-copy">{{ section.settings.copy }}</div>
    <div class="suas-visit-grid">
      <article class="suas-visit-card"><h2>address.</h2><p>188 W Franklin Blvd<br>Gastonia, NC 28052</p><a class="suas-map-box" href="https://www.google.com/maps/search/?api=1&query=188%20W%20Franklin%20Blvd%2C%20Gastonia%20NC%2028052" target="_blank" rel="noopener"><span>open directions</span></a></article>
      <article class="suas-visit-card"><h2>parking.</h2><p>Public parking is directly across the street. Pull up, park, and come smell something pretty.</p><p>For Lab bookings, give yourself a few extra minutes so you can settle in before your session starts.</p></article>
      <article class="suas-visit-card"><h2>what to do when you get here.</h2><p>Shop the floor, ask what’s mixing, book The Lab, or grab a Charm Bar seat and build your little extra.</p></article>
    </div>
    <div class="suas-visit-actions"><a class="suas-visit-button" data-dark href="/pages/bookings">book the lab</a><a class="suas-visit-button" href="/pages/bookings#charm-bar">book the charm bar</a><a class="suas-visit-button" href="/pages/shut-up-and-smell">visit the lab page</a><a class="suas-visit-button" href="/pages/contact-us">contact us</a></div>
  </div>
  </div>
</section>
{% schema %}{"name":"SUAS Visit Page","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"suas.os / visit us"},{"type":"text","id":"heading","label":"Heading","default":"come smell with us."},{"type":"richtext","id":"copy","label":"Intro","default":"<p>Pull up for scent, self care, home fragrance, and The Lab in Gastonia, NC.</p>"}],"presets":[{"name":"SUAS Visit Page"}]}{% endschema %}
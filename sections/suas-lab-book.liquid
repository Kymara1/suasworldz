<section class="suas-lab-book" aria-label="Book The Lab" data-suas-lab-book>
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
    .suas-lab-book{--ink:#101010;--cream:#fbfaf7;--pink:#ffd8e8;--hot:#ff9bc4;--lime:#d9ff78;--blue:#cdeeff;--sun:#fff1a8;--lav:#e4d5ff;color:var(--ink);background:linear-gradient(rgba(16,16,16,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.035) 1px,transparent 1px),radial-gradient(circle at 8% 10%,rgba(255,216,232,.5),transparent 28%),radial-gradient(circle at 92% 80%,rgba(217,255,120,.28),transparent 32%),var(--cream);background-size:22px 22px,22px 22px,auto,auto,auto;font-family:Futura,'Futura PT',Arial,sans-serif}
    .suas-lab-book *{box-sizing:border-box}
    .suas-lab-wrap{width:min(820px,calc(100vw - 24px));margin:0 auto;padding:clamp(16px,2.4vw,28px) 0 48px}
    .suas-lab-window{border:2px solid var(--ink);border-radius:24px;background:rgba(255,255,255,.96);box-shadow:5px 6px 0 var(--ink);overflow:hidden}
    .suas-lab-bar{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:8px;min-height:40px;padding:8px 12px;border-bottom:2px solid var(--ink);background:linear-gradient(180deg,#fff,#e8edf3)}
    .suas-lab-dots{display:flex;gap:6px}
    .suas-lab-dot{width:10px;height:10px;border-radius:999px;background:var(--dot)}
    .suas-lab-bar-title,.suas-lab-kicker,.suas-lab-next,.suas-lab-back,.suas-lab-submit,.suas-lab-chip,.suas-lab-seat-label,.suas-lab-step{font-family:Futura,'Futura PT',Arial,sans-serif;font-weight:900;letter-spacing:.14em;text-transform:uppercase}
    .suas-lab-bar-title{font-size:10px;text-align:center}
    .suas-lab-live{font-size:8px;letter-spacing:.16em;font-weight:900}
    .suas-lab-body{padding:16px}
    .suas-lab-title{margin:0 0 6px;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(2rem,6vw,3.4rem);line-height:.86;font-weight:400;text-transform:lowercase}
    .suas-lab-copy{margin:0 0 14px;font-size:13px;line-height:1.4;font-weight:700;color:rgba(16,16,16,.68)}
    .suas-lab-meter{display:grid;gap:6px;margin:0 0 16px;padding:10px 12px;border:2px solid var(--ink);border-radius:18px;background:var(--lime);box-shadow:3px 4px 0 var(--ink)}
    .suas-lab-meter.is-low{background:var(--sun)}
    .suas-lab-meter.is-full{background:var(--pink)}
    .suas-lab-seat-row{display:flex;justify-content:space-between;align-items:end;gap:8px}
    .suas-lab-seat-count{font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(1.5rem,4vw,2.1rem);line-height:.9}
    .suas-lab-seat-label{font-size:9px;opacity:.7}
    .suas-lab-bar-track{height:10px;border:1.5px solid var(--ink);border-radius:999px;background:#fff;overflow:hidden}
    .suas-lab-bar-track i{display:block;height:100%;width:100%;background:var(--ink);transform-origin:left center}
    .suas-lab-steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin-bottom:14px}
    .suas-lab-step{min-height:34px;display:flex;align-items:center;justify-content:center;border:1.5px solid var(--ink);border-radius:999px;background:#fff;font-size:8px}
    .suas-lab-step.is-on{background:var(--pink);box-shadow:0 2px 0 var(--ink)}
    .suas-lab-pane[hidden]{display:none!important}
    .suas-lab-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
    .suas-lab-choice{display:flex;flex-direction:column;gap:4px;min-height:92px;padding:12px;border:2px solid var(--ink);border-radius:18px;background:var(--fill,#fff);box-shadow:0 3px 0 var(--ink);text-align:left;cursor:pointer}
    .suas-lab-choice.is-on{box-shadow:0 1px 0 var(--ink);transform:translateY(2px)}
    .suas-lab-choice strong{font-family:'Casual Human',Futura,Arial,sans-serif;font-size:1.15rem;line-height:.9;font-weight:400;text-transform:lowercase}
    .suas-lab-choice span{font-size:11px;font-weight:800}
    .suas-lab-choice small{font-size:9px;font-weight:900;letter-spacing:.1em;text-transform:uppercase;opacity:.6}
    .suas-lab-field{display:grid;gap:5px;margin-bottom:10px}
    .suas-lab-field label{font-size:10px;font-weight:900;letter-spacing:.12em;text-transform:uppercase;color:rgba(16,16,16,.55)}
    .suas-lab-input,.suas-lab-select{width:100%;min-height:46px;border:2px solid var(--ink);border-radius:14px;padding:10px 12px;background:#fff;color:var(--ink);font:800 16px/1.2 Futura,Arial,sans-serif}
    .suas-lab-times{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
    .suas-lab-chip{min-height:42px;border:2px solid var(--ink);border-radius:999px;background:#fff;font-size:9px;cursor:pointer}
    .suas-lab-chip.is-on{background:var(--lime);box-shadow:0 2px 0 var(--ink)}
    .suas-lab-addons{display:grid;gap:8px;margin:8px 0 12px}
    .suas-lab-addon{display:grid;grid-template-columns:auto 1fr auto;gap:8px;align-items:center;min-height:48px;padding:8px 10px;border:1.5px solid var(--ink);border-radius:14px;background:#fff;cursor:pointer;font-size:12px;font-weight:800}
    .suas-lab-nav{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:14px}
    .suas-lab-next,.suas-lab-back,.suas-lab-submit{min-height:46px;border:2px solid var(--ink);border-radius:999px;background:var(--pink);box-shadow:0 3px 0 var(--ink);cursor:pointer;font-size:11px}
    .suas-lab-back{background:#fff}
    .suas-lab-submit{grid-column:1/-1;background:var(--lime)}
    .suas-lab-submit:disabled,.suas-lab-next:disabled{opacity:.4;cursor:not-allowed;box-shadow:none}
    .suas-lab-note{margin:10px 0 0;font-size:11px;font-weight:700;color:rgba(16,16,16,.6)}
    .suas-lab-hours{display:grid;gap:6px;margin-top:12px;padding:10px;border:1.5px dashed rgba(16,16,16,.25);border-radius:16px;background:rgba(255,255,255,.7);font-size:12px;font-weight:700}
    .suas-lab-cal{margin:0 0 14px;border:2px solid var(--ink);border-radius:18px;overflow:hidden;min-height:420px;background:#fff}
    .suas-lab-cal iframe{width:100%;min-height:620px;border:0}
    .suas-lab-error{display:none;margin-top:8px;padding:8px 10px;border:1.5px solid var(--ink);border-radius:12px;background:var(--pink);font-size:12px;font-weight:800}
    .suas-lab-error.is-on{display:block}
    @media(max-width:640px){.suas-lab-wrap{width:calc(100vw - 12px)}.suas-lab-title{font-size:clamp(1.8rem,10vw,2.6rem)}.suas-lab-cal iframe{min-height:720px}}
  </style>
  {% liquid
    assign parfum_product = section.settings.parfum_product
    assign body_oil_product = section.settings.body_oil_product
    assign combo_product = section.settings.combo_product
    assign roll_on_product = section.settings.roll_on_product
    assign roll_on_addon_product = section.settings.roll_on_addon_product
    assign travel_addon_product = section.settings.travel_addon_product
    assign deluxe_product = section.settings.deluxe_product
    if parfum_product == blank
      assign parfum_product = all_products['lab-session-eau-de-parfum']
    endif
    if body_oil_product == blank
      assign body_oil_product = all_products['lab-session-body-oil']
    endif
    if combo_product == blank
      assign combo_product = all_products['lab-session-combo-sesh']
    endif
    if roll_on_product == blank
      assign roll_on_product = all_products['lab-session-roll-on-perfume']
    endif
    if roll_on_addon_product == blank
      assign roll_on_addon_product = all_products['lab-session-add-on-10ml-roll-on-perfume-oil']
    endif
    if deluxe_product == blank
      assign deluxe_product = all_products['deluxe-lab-session']
    endif
    assign parfum_main_variant = parfum_product.selected_or_first_available_variant
    assign body_oil_main_variant = body_oil_product.selected_or_first_available_variant
    assign combo_main_variant = combo_product.selected_or_first_available_variant
    assign roll_on_main_variant = roll_on_product.selected_or_first_available_variant
    assign roll_on_addon_variant = roll_on_addon_product.selected_or_first_available_variant
    assign travel_addon_variant = travel_addon_product.selected_or_first_available_variant
    assign seats_total = section.settings.seats_total | default: 12 | plus: 0
    if seats_total < 1
      assign seats_total = 12
    endif
    assign calendly_url = section.settings.calendly_url | strip
    assign calendly_embed = ''
    if calendly_url == blank
      assign calendly_url = shop.metafields.suas.calendly_url.value | strip
    endif
    if calendly_url != blank and calendly_url contains '<iframe'
      assign calendly_embed = calendly_url
      assign calendly_url = ''
    endif
    if calendly_url != blank
      unless calendly_url contains 'http'
        assign calendly_url = 'https://' | append: calendly_url
      endunless
    endif
  %}
  <div class="suas-lab-wrap">
    <div class="suas-lab-window">
      <div class="suas-lab-bar">
        <div class="suas-lab-dots"><span class="suas-lab-dot" style="--dot:#ff5f57"></span><span class="suas-lab-dot" style="--dot:#febc2e"></span><span class="suas-lab-dot" style="--dot:#28c840"></span></div>
        <span class="suas-lab-bar-title">LAB.BOOK / calendly</span>
        <span class="suas-lab-live">12 MAX</span>
      </div>
      <div class="suas-lab-body">
        <h1 class="suas-lab-title">book your experiment.</h1>
        <p class="suas-lab-copy">Pick a mix, grab a time, hold your seats. The Lab has 12 seats a date. When they are gone, that date stops selling.{% if calendly_url != blank or calendly_embed != blank %} The calendar writes the appointment for you.{% endif %}</p>

        <div class="suas-lab-meter" data-suas-seat-meter>
          <div class="suas-lab-seat-row">
            <strong class="suas-lab-seat-count" data-suas-seat-text>12 of 12 seats left</strong>
            <span class="suas-lab-seat-label" data-suas-seat-hint>pick a date</span>
          </div>
          <div class="suas-lab-bar-track" aria-hidden="true"><i data-suas-seat-fill></i></div>
        </div>

        {% if calendly_url != blank %}
          <div class="suas-lab-cal">
            <div class="calendly-inline-widget" data-url="{{ calendly_url | escape }}" style="min-width:320px;height:700px"></div>
          </div>
        {% elsif calendly_embed != blank %}
          <div class="suas-lab-cal">{{ calendly_embed }}</div>
        {% endif %}

        <div class="suas-lab-steps" aria-label="Booking steps">
          <span class="suas-lab-step is-on" data-suas-step-pill="1">1 mix</span>
          <span class="suas-lab-step" data-suas-step-pill="2">2 when</span>
          <span class="suas-lab-step" data-suas-step-pill="3">3 seats</span>
        </div>

        <form data-suas-book-form>
          <div class="suas-lab-pane" data-suas-pane="1">
            <p class="suas-lab-seat-label">what are you mixing?</p>
            <div class="suas-lab-grid" data-suas-choices>
              {% if parfum_main_variant != blank %}
                <button class="suas-lab-choice" type="button" style="--fill:#ffd8e8" data-kind="self" data-id="{{ parfum_main_variant.id }}" data-name="eau de parfum" data-price="{{ parfum_main_variant.price | money }}" {% unless parfum_main_variant.available %}disabled{% endunless %}><small>self-guided</small><strong>eau de parfum</strong><span>30mL • {{ parfum_main_variant.price | money }}</span></button>
              {% endif %}
              {% if body_oil_main_variant != blank %}
                <button class="suas-lab-choice" type="button" style="--fill:#cdeeff" data-kind="self" data-id="{{ body_oil_main_variant.id }}" data-name="body oil" data-price="{{ body_oil_main_variant.price | money }}" {% unless body_oil_main_variant.available %}disabled{% endunless %}><small>self-guided</small><strong>body oil</strong><span>30mL • {{ body_oil_main_variant.price | money }}</span></button>
              {% endif %}
              {% if combo_main_variant != blank %}
                <button class="suas-lab-choice" type="button" style="--fill:#e4d5ff" data-kind="self" data-id="{{ combo_main_variant.id }}" data-name="combo session" data-price="{{ combo_main_variant.price | money }}" {% unless combo_main_variant.available %}disabled{% endunless %}><small>self-guided</small><strong>combo</strong><span>perfume + oil • {{ combo_main_variant.price | money }}</span></button>
              {% endif %}
              {% if roll_on_main_variant != blank %}
                <button class="suas-lab-choice" type="button" style="--fill:#fff1a8" data-kind="self" data-id="{{ roll_on_main_variant.id }}" data-name="roll-on perfume" data-price="{{ roll_on_main_variant.price | money }}" {% unless roll_on_main_variant.available %}disabled{% endunless %}><small>self-guided</small><strong>roll-on</strong><span>10mL • {{ roll_on_main_variant.price | money }}</span></button>
              {% endif %}
              {% if deluxe_product != blank %}
                {% for variant in deluxe_product.variants %}
                  <button class="suas-lab-choice" type="button" style="--fill:#d9ff78" data-kind="guided" data-id="{{ variant.id }}" data-name="{{ variant.title | escape }}" data-price="{{ variant.price | money }}" {% unless variant.available %}disabled{% endunless %}><small>guided class</small><strong>{{ variant.title | downcase }}</strong><span>{{ variant.price | money }}</span></button>
                {% endfor %}
              {% endif %}
            </div>
          </div>

          <div class="suas-lab-pane" data-suas-pane="2" hidden>
            <div class="suas-lab-field"><label for="LabDate">date</label><input class="suas-lab-input" id="LabDate" type="date" required></div>
            <div class="suas-lab-field"><span>time</span><div class="suas-lab-times" data-suas-times></div></div>
            {% if calendly_url != blank or calendly_embed != blank %}
              <p class="suas-lab-note">Match the date and time you picked in Calendly so checkout and the calendar stay on the same seat.</p>
            {% endif %}
          </div>

          <div class="suas-lab-pane" data-suas-pane="3" hidden>
            <div class="suas-lab-field"><label for="LabGuests">how many seats?</label><input class="suas-lab-input" id="LabGuests" type="number" min="1" max="{{ seats_total }}" value="1" required></div>
            <div class="suas-lab-field"><label for="LabName">name</label><input class="suas-lab-input" id="LabName" type="text" required></div>
            <div class="suas-lab-field"><label for="LabPhone">phone</label><input class="suas-lab-input" id="LabPhone" type="tel" required></div>
            <div class="suas-lab-addons" data-suas-addons hidden>
              {% if roll_on_addon_variant != blank %}
                <label class="suas-lab-addon"><input type="checkbox" data-addon-id="{{ roll_on_addon_variant.id }}" data-addon-name="10mL Roll-On"{% unless roll_on_addon_variant.available %} disabled{% endunless %}>10mL roll-on add-on<span>+ {{ roll_on_addon_variant.price | money }}</span></label>
              {% endif %}
              {% if travel_addon_variant != blank %}
                <label class="suas-lab-addon"><input type="checkbox" data-addon-id="{{ travel_addon_variant.id }}" data-addon-name="15mL Travel Perfume"{% unless travel_addon_variant.available %} disabled{% endunless %}>15mL travel / second perfume<span>+ {{ travel_addon_variant.price | money }}</span></label>
              {% endif %}
            </div>
            <p class="suas-lab-note">Checkout holds the seats. Set the Calendly event to 12 spots so a full date stops booking on the calendar too.</p>
          </div>

          <p class="suas-lab-error" data-suas-error></p>
          <div class="suas-lab-nav">
            <button class="suas-lab-back" type="button" data-suas-back hidden>back</button>
            <button class="suas-lab-next" type="button" data-suas-next>next</button>
            <button class="suas-lab-submit" type="submit" data-suas-submit hidden>reserve seats</button>
          </div>
        </form>

        <div class="suas-lab-hours">
          <div>Open for bookings Thursday–Sunday. Closed Monday–Wednesday.</div>
          <div>Self-guided: before 5:00 PM. Guided classes: Thu/Fri 6:00 PM, Sat 4:00 PM or 6:00 PM.</div>
        </div>
      </div>
    </div>
  </div>
  {% if calendly_url != blank %}
    <script src="https://assets.calendly.com/assets/external/widget.js" async></script>
  {% endif %}
  <script type="application/json" data-suas-seat-board>{{ shop.metafields.suas.lab_seats.value | default: '{}' }}</script>
  <script>
    (() => {
      const root = document.querySelector('[data-suas-lab-book]');
      if (!root || root.dataset.wired === 'true') return;
      root.dataset.wired = 'true';
      const TOTAL = {{ seats_total }};
      const selfTimes = {0:['12:00 PM','1:00 PM','2:00 PM','3:00 PM','4:00 PM','5:00 PM'],4:['12:00 PM','1:00 PM','2:00 PM','3:00 PM','4:00 PM','5:00 PM'],5:['12:00 PM','1:00 PM','2:00 PM','3:00 PM','4:00 PM','5:00 PM'],6:['12:00 PM','1:00 PM','2:00 PM','3:00 PM']};
      const guidedTimes = {4:['Thursday 6:00 PM - 7:30 PM'],5:['Friday 6:00 PM - 7:30 PM'],6:['Saturday 4:00 PM - 5:30 PM','Saturday 6:00 PM - 7:30 PM']};
      const dayNames = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
      const form = root.querySelector('[data-suas-book-form]');
      const panes = [...root.querySelectorAll('[data-suas-pane]')];
      const pills = [...root.querySelectorAll('[data-suas-step-pill]')];
      const nextBtn = root.querySelector('[data-suas-next]');
      const backBtn = root.querySelector('[data-suas-back]');
      const submitBtn = root.querySelector('[data-suas-submit]');
      const dateInput = root.querySelector('#LabDate');
      const guestsInput = root.querySelector('#LabGuests');
      const timesWrap = root.querySelector('[data-suas-times]');
      const addons = root.querySelector('[data-suas-addons]');
      const errorEl = root.querySelector('[data-suas-error]');
      const meter = root.querySelector('[data-suas-seat-meter]');
      const seatText = root.querySelector('[data-suas-seat-text]');
      const seatHint = root.querySelector('[data-suas-seat-hint]');
      const seatFill = root.querySelector('[data-suas-seat-fill]');
      let step = 1;
      let choice = null;
      let timeValue = '';
      let remaining = TOTAL;
      let board = {};
      try { board = JSON.parse((root.querySelector('[data-suas-seat-board]') || {}).textContent || '{}') || {}; } catch (e) { board = {}; }
      const today = new Date();
      dateInput.min = `${today.getFullYear()}-${String(today.getMonth()+1).padStart(2,'0')}-${String(today.getDate()).padStart(2,'0')}`;
      const showError = (msg) => { errorEl.textContent = msg || ''; errorEl.classList.toggle('is-on', Boolean(msg)); };
      const dateDay = (value) => {
        if (!value) return null;
        const bits = value.split('-').map(Number);
        return new Date(bits[0], bits[1]-1, bits[2]).getDay();
      };
      const seatKey = () => {
        if (!choice || !dateInput.value) return '';
        return choice.kind === 'guided' ? `guided|${dateInput.value}|${timeValue}` : `self|${dateInput.value}`;
      };
      const paintMeter = () => {
        const left = Math.max(0, remaining);
        seatText.textContent = `${left} of ${TOTAL} seats left`;
        seatFill.style.transform = `scaleX(${left / TOTAL})`;
        meter.classList.toggle('is-low', left > 0 && left <= 3);
        meter.classList.toggle('is-full', left <= 0);
        guestsInput.max = String(Math.max(1, left || 1));
        if (left <= 0) {
          seatHint.textContent = 'sold out';
          submitBtn.disabled = true;
          submitBtn.textContent = 'sold out for this date';
        } else {
          seatHint.textContent = dateInput.value ? 'live for this date' : 'pick a date';
          submitBtn.disabled = false;
          submitBtn.textContent = 'reserve seats';
        }
      };
      const refreshSeats = async () => {
        remaining = TOTAL;
        const key = seatKey();
        if (key) remaining -= Number(board[key] || 0);
        try {
          const cart = await fetch('/cart.js', { credentials: 'same-origin' }).then((r) => r.json());
          (cart.items || []).forEach((item) => {
            const props = item.properties || {};
            const date = props['Preferred date'] || props['Class date'] || '';
            const time = props['Preferred time'] || props['Class time'] || '';
            const kind = (props['Booking type'] || '').toLowerCase().includes('guided') ? 'guided' : 'self';
            const itemKey = kind === 'guided' ? `guided|${date}|${time}` : `self|${date}`;
            if (key && itemKey === key) remaining -= Number(item.quantity || 0);
          });
        } catch (e) {}
        remaining = Math.max(0, remaining);
        paintMeter();
        if (Number(guestsInput.value || 1) > remaining && remaining > 0) guestsInput.value = String(remaining);
        return remaining;
      };
      const renderTimes = () => {
        timesWrap.innerHTML = '';
        timeValue = '';
        const day = dateDay(dateInput.value);
        if (day === null || !choice) return;
        const options = (choice.kind === 'guided' ? guidedTimes[day] : selfTimes[day]) || [];
        if (!options.length) {
          showError(`${dayNames[day]} is closed for that experiment. Thursday–Sunday only.`);
          dateInput.value = '';
          refreshSeats();
          return;
        }
        showError('');
        options.forEach((time) => {
          const chip = document.createElement('button');
          chip.type = 'button';
          chip.className = 'suas-lab-chip';
          chip.textContent = time;
          chip.addEventListener('click', () => {
            timeValue = time;
            timesWrap.querySelectorAll('.suas-lab-chip').forEach((node) => node.classList.toggle('is-on', node === chip));
            refreshSeats();
          });
          timesWrap.appendChild(chip);
        });
        refreshSeats();
      };
      const setStep = (next) => {
        step = next;
        panes.forEach((pane) => { pane.hidden = Number(pane.dataset.suasPane) !== step; });
        pills.forEach((pill) => pill.classList.toggle('is-on', Number(pill.dataset.suasStepPill) === step));
        backBtn.hidden = step === 1;
        nextBtn.hidden = step === 3;
        submitBtn.hidden = step !== 3;
        addons.hidden = !(choice && choice.kind === 'self');
      };
      root.querySelectorAll('[data-suas-choices] .suas-lab-choice').forEach((button) => {
        button.addEventListener('click', () => {
          choice = { kind: button.dataset.kind, id: Number(button.dataset.id), name: button.dataset.name, price: button.dataset.price };
          root.querySelectorAll('[data-suas-choices] .suas-lab-choice').forEach((node) => node.classList.toggle('is-on', node === button));
          showError('');
        });
      });
      dateInput.addEventListener('change', renderTimes);
      window.addEventListener('message', (event) => {
        if (!event.data || event.data.event !== 'calendly.event_scheduled') return;
        const payload = event.data.payload || {};
        const start = payload.event && payload.event.start_time ? new Date(payload.event.start_time) : null;
        if (!start || Number.isNaN(start.getTime())) return;
        dateInput.value = `${start.getFullYear()}-${String(start.getMonth()+1).padStart(2,'0')}-${String(start.getDate()).padStart(2,'0')}`;
        timeValue = start.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
        renderTimes();
        timeValue = start.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
        refreshSeats();
      });
      nextBtn.addEventListener('click', () => {
        if (step === 1 && !choice) { showError('Pick an experiment first.'); return; }
        if (step === 2) {
          if (!dateInput.value || !timeValue) { showError('Pick a date and a time.'); return; }
          if (remaining <= 0) { showError('That date is booked up. 0 of 12 seats left.'); return; }
        }
        showError('');
        setStep(Math.min(3, step + 1));
        refreshSeats();
      });
      backBtn.addEventListener('click', () => { showError(''); setStep(Math.max(1, step - 1)); });
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        await refreshSeats();
        const guests = Math.max(1, Number(guestsInput.value || 1));
        if (!choice || !dateInput.value || !timeValue) { showError('Finish the date and time step.'); return; }
        if (remaining <= 0 || guests > remaining) { showError(`Only ${remaining} seat${remaining === 1 ? '' : 's'} left for that date.`); return; }
        const name = root.querySelector('#LabName').value.trim();
        const phone = root.querySelector('#LabPhone').value.trim();
        if (!name || !phone) { showError('Name and phone keep the reservation.'); return; }
        submitBtn.disabled = true;
        submitBtn.textContent = 'holding seats...';
        const properties = {
          'Booking type': choice.kind === 'guided' ? 'Guided Lab Session' : 'Self-Guided Lab Experiment',
          'Selected experience': choice.name,
          'Guest name': name,
          'Phone number': phone,
          'Seats': String(guests),
          'Seat cap': String(TOTAL)
        };
        if (choice.kind === 'guided') {
          properties['Class date'] = dateInput.value;
          properties['Class time'] = timeValue;
        } else {
          properties['Preferred date'] = dateInput.value;
          properties['Preferred time'] = timeValue;
        }
        const items = [{ id: choice.id, quantity: guests, properties }];
        root.querySelectorAll('[data-addon-id]:checked').forEach((box) => {
          items.push({
            id: Number(box.dataset.addonId),
            quantity: guests,
            properties: { 'Add-on for': choice.name, 'Booking date': dateInput.value, 'Booking time': timeValue, 'Guest name': name, 'Add-on': box.dataset.addonName || 'Add-on' }
          });
        });
        try {
          const response = await fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, credentials: 'same-origin', body: JSON.stringify({ items }) });
          if (!response.ok) throw new Error('cart');
          window.location.assign('/cart');
        } catch (err) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'reserve seats';
          showError('Could not hold those seats. Try again.');
        }
      });
      paintMeter();
    })();
  </script>
</section>
{% schema %}
{
  "name": "SUAS Lab Book",
  "settings": [
    {"type":"text","id":"calendly_url","label":"Calendly URL","info":"Paste your Calendly event link, like https://calendly.com/yourname/lab. Set that event to 12 spots per time."},
    {"type":"range","id":"seats_total","label":"Seats per Lab date","min":1,"max":24,"step":1,"default":12},
    {"type":"product","id":"body_oil_product","label":"Self-Guided Body Oil product"},
    {"type":"product","id":"parfum_product","label":"Self-Guided Lab Experiment product"},
    {"type":"product","id":"combo_product","label":"Self-Guided Combo product"},
    {"type":"product","id":"roll_on_product","label":"Self-Guided Roll-On Perfume product"},
    {"type":"product","id":"roll_on_addon_product","label":"Roll-On add-on product"},
    {"type":"product","id":"travel_addon_product","label":"Travel / second perfume add-on product"},
    {"type":"product","id":"deluxe_product","label":"Guided Lab Session product"}
  ],
  "presets": [{"name":"SUAS Lab Book"}]
}
{% endschema %}

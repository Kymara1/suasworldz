<style>
  #shopify-section-{{ section.id }} {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    left: auto !important;
    right: auto !important;
    top: auto !important;
    transform: none !important;
    position: relative !important;
  }
  .suas-page-window {
    box-sizing: border-box;
    width: 100%;
    max-width: min(1280px, 100%);
    margin: 0 auto;
    padding: 0;
  }
  .suas-page-window .suas-catalog-head {
    margin: 0 0 16px;
  }
  .suas-page-window .suas-catalog-head-bar {
    min-height: 52px;
    padding: 10px 16px;
  }
  .suas-page-window .suas-catalog-head-bar b {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: clamp(1.25rem, 2.4vw, 1.7rem) !important;
  }
  .suas-page-window .suas-catalog-head-bar em {
    flex: 0 0 auto;
  }
</style>
<div class="suas-page-window">
  <div class="suas-catalog-head">
    <div class="suas-catalog-head-bar">
      <span class="suas-catalog-dot" style="--dot:#ff5f57"></span>
      <span class="suas-catalog-dot" style="--dot:#febc2e"></span>
      <span class="suas-catalog-dot" style="--dot:#28c840"></span>
      <b>{{ page.title | default: section.settings.title | downcase }}</b>
      {% if section.settings.kicker != blank %}<em>{{ section.settings.kicker }}</em>{% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SUAS page window",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Fallback title",
      "default": "dupe?"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Right badge"
    }
  ],
  "presets": [{ "name": "SUAS page window" }]
}
{% endschema %}

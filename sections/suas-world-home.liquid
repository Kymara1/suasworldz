<section class="suas-world-home" aria-label="SUAS World home">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}
    .suas-world-home{--ink:#101010;--cream:#fbfaf7;--pink:#ffd8e8;--hot:#ff9bc4;--blue:#cdeeff;--lime:#d9ff78;--lav:#e4d5ff;--sun:#fff1a8;color:var(--ink);background:#fff;font-family:Futura,'Futura PT',Arial,sans-serif;overflow:visible;padding-top:52px}
    .suas-world-home *{box-sizing:border-box}
    .suas-world-home a{color:inherit}
    .suas-font{font-family:'Casual Human',Futura,Arial,sans-serif!important;font-weight:400!important;letter-spacing:0!important}
    .suas-mono{font-family:Futura,'Futura PT',Arial,sans-serif;font-size:10px;letter-spacing:.22em;text-transform:uppercase;font-weight:900}
    .suas-home-wrap{width:min(1340px,calc(100vw - 24px));margin:0 auto}
    .suas-billboard{display:grid;justify-items:center;gap:0;width:100%;margin:0 0 4px;padding:0 0 12px;text-align:center;overflow:visible;border:2px solid var(--ink);border-radius:28px;background-color:#fff;background-image:linear-gradient(rgba(16,16,16,.12) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.12) 1px,transparent 1px);background-size:22px 22px;box-shadow:5px 6px 0 var(--ink)}
    .suas-bizarra-blast{display:grid;gap:10px;width:100%;margin:0 0 12px;padding:14px 16px;border:2.5px solid var(--ink);border-radius:24px;background:linear-gradient(135deg,#ff9bc4 0%,#fff1a8 48%,#d9ff78 100%);box-shadow:5px 6px 0 var(--ink);color:var(--ink);text-decoration:none}
    .suas-bizarra-blast:hover{color:var(--ink);transform:translateY(2px);box-shadow:3px 4px 0 var(--ink)}
    .suas-bizarra-kicker{margin:0;font:900 10px/1 Futura,Arial,sans-serif;letter-spacing:.18em;text-transform:uppercase}
    .suas-bizarra-blast h2{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif;font-weight:400;font-size:clamp(1.85rem,5vw,3rem);line-height:.88;text-transform:lowercase}
    .suas-bizarra-blast p{margin:0;max-width:46rem;font:800 13px/1.35 Futura,Arial,sans-serif}
    .suas-bizarra-meta{display:flex;flex-wrap:wrap;gap:6px}
    .suas-bizarra-meta span{display:inline-flex;align-items:center;min-height:28px;padding:5px 10px;border:1.75px solid var(--ink);border-radius:999px;background:#fff;font:900 10px/1 Futura,Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase}
    @media(max-width:560px){.suas-bizarra-blast{padding:12px;border-radius:18px;gap:8px}.suas-bizarra-blast p{font-size:12px}.suas-bizarra-meta span{font-size:9px;min-height:26px;padding:4px 8px}}
    .suas-billboard .suas-window-bar{width:100%;border-radius:26px 26px 0 0}
    .suas-home-logo{position:relative;display:grid;place-items:center;width:168px;height:168px;max-width:none;margin:14px 0 8px;color:inherit;text-decoration:none;overflow:visible}
    .suas-home-logo-img{grid-area:1/1;display:block;width:168px;height:168px;max-width:168px;max-height:168px;object-fit:contain;object-position:center;background:transparent;border:2px solid var(--ink);border-radius:999px;box-shadow:3px 4px 0 var(--ink);z-index:1}
    .suas-home-logo-img--season{display:none}
    html.suas-halloween .suas-world-home .suas-home-logo-img--core{display:block!important}
    .suas-home-logo .suas-side-orb,.suas-home-logo-orb{width:clamp(56px,9vw,92px)!important;height:clamp(56px,9vw,92px)!important;flex:0 0 auto;border-radius:999px;background:radial-gradient(circle at 32% 20%,#fff 0 10%,transparent 32%),conic-gradient(from 210deg,#ffd8e8,#c9e7ff,#d8e26a,#ffd8e8);box-shadow:inset 0 -6px 12px rgba(0,0,0,.16),inset 0 6px 12px rgba(255,255,255,.85),0 8px 16px -8px rgba(16,16,16,.35)}
    .suas-home-logo-arc{grid-area:1/1;width:220px;height:236px;overflow:visible;pointer-events:none;z-index:2}
    .suas-home-logo-arc-text{font-family:Futura,'Futura PT',Arial,sans-serif;font-weight:900;font-size:22px;letter-spacing:.04em;text-transform:uppercase;fill:var(--ink)}
    .suas-home-logo-tag{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
    .suas-home-h1{margin:8px 0 0;font-size:clamp(2.6rem,6vw,4.2rem);line-height:.8;text-transform:lowercase}
    .suas-aisles{display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:stretch}
    .suas-aisle-col{display:flex;flex-direction:column;gap:10px;min-width:0;min-height:0}
    .suas-aisle-col .suas-aisle{flex:1}
    .suas-men-jump{min-height:46px;display:flex;align-items:center;justify-content:center;border:2px solid #101010;border-radius:999px;background:#101010;color:#fff;box-shadow:4px 5px 0 #101010;text-decoration:none;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(1.35rem,2.4vw,1.85rem);line-height:.85;letter-spacing:0;text-transform:uppercase}
    .suas-men-jump:hover{color:#fff;background:#101010;transform:translateY(2px);box-shadow:2px 3px 0 #101010}
    .suas-aisle{display:flex;flex-direction:column;gap:12px;min-height:0;padding:22px;border:2px solid var(--ink);border-radius:24px;box-shadow:5px 6px 0 var(--ink);overflow:hidden;background-image:linear-gradient(rgba(16,16,16,.1) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.1) 1px,transparent 1px);background-size:22px 22px}
    .suas-aisle--body{background-color:#ffd4ea}
    .suas-aisle--home{background-color:#d9ff78}
    .suas-aisle small{display:block;width:100%;text-align:center!important;font-size:10px;letter-spacing:.2em;text-transform:uppercase;font-weight:900}
    .suas-aisle h2,.suas-aisle h3{margin:0 auto;display:block;width:100%;text-align:center!important;font-size:clamp(2.6rem,5vw,4.2rem);line-height:.8;text-transform:lowercase}
    .suas-aisle p{margin:0;font-size:13px;font-weight:700;line-height:1.3}
    .suas-aisle-chips{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}
    .suas-aisle-chips a{min-height:42px;min-width:0;width:100%;display:inline-flex;align-items:center;justify-content:center;padding:8px 10px;border:1.75px solid var(--ink);border-radius:999px;background:#fff;box-shadow:0 2px 0 var(--ink);text-decoration:none;text-align:center;font-size:12px;font-weight:900;letter-spacing:.06em;text-transform:uppercase;line-height:1.1;white-space:normal}
    .suas-aisle-chips a:hover{transform:translateY(1px);box-shadow:0 1px 0 var(--ink)}
    .suas-hero-stack{display:grid;gap:18px}
    .suas-mid-row{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(260px,1fr);gap:12px;align-items:start}
    .suas-feed-notes{min-height:0;display:flex;flex-direction:column;gap:0;border:2px solid var(--ink);border-radius:22px;background:linear-gradient(rgba(16,16,16,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.025) 1px,transparent 1px),linear-gradient(135deg,rgba(255,216,232,.52),rgba(255,255,255,.95) 58%,rgba(217,255,120,.36));background-size:18px 18px,18px 18px,auto;box-shadow:5px 6px 0 var(--ink);padding:0;overflow:hidden}
    .suas-feed-announcement{width:100%;min-height:0;flex:1;display:flex;align-items:center;border:1.5px solid var(--ink);border-radius:15px;background:rgba(255,255,255,.9);padding:10px 12px;color:var(--ink);font-size:1.05rem;line-height:1.15}
    .suas-product-buy{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);align-items:stretch;gap:6px;margin-top:0;min-width:0}
    .suas-feed-atc{min-height:32px;width:100%;min-width:0;display:inline-flex;align-items:center;justify-content:center;border:1.75px solid var(--ink);border-radius:999px;padding:6px 8px;color:var(--ink)!important;background:var(--lime)!important;box-shadow:0 2px 0 var(--ink);font-weight:900;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;font-size:8px}
    .suas-feed-atc:hover{color:var(--ink);transform:translateY(2px);box-shadow:0 1px 0 var(--ink)}
    .suas-feed-atc:disabled{opacity:.4;cursor:not-allowed;transform:none;box-shadow:0 3px 0 var(--ink)}
    .suas-now-card,.suas-launch-panel,.suas-boost,.suas-hours-win{border:2px solid var(--ink);border-radius:24px;background:rgba(255,255,255,.93);box-shadow:5px 6px 0 var(--ink);overflow:hidden}
    .suas-launch-col{display:grid;gap:12px;align-content:start;min-width:0}
    .suas-hours-win .suas-window-bar{min-height:34px;padding:6px 10px}
    .suas-hours-body{padding:8px;display:grid;gap:8px}
    .suas-hours-split{display:grid;grid-template-columns:1fr 1fr;gap:6px}
    .suas-hours-block{display:grid;gap:5px;min-width:0;padding:7px;border:1.5px solid var(--ink);border-radius:12px;background:#fff}
    .suas-hours-block b{font:900 9px/1 Futura,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase}
    .suas-hours-list{display:grid;gap:4px;margin:0;padding:0;list-style:none}
    .suas-hours-list li{display:flex;justify-content:space-between;align-items:baseline;gap:6px;padding:6px 8px;border:1.5px solid var(--ink);border-radius:10px;background:#fbfaf7;font:800 9px/1.2 Futura,Arial,sans-serif}
    .suas-hours-list span:first-child{font-size:9px;letter-spacing:.02em}
    .suas-hours-list span:last-child{text-align:right;opacity:1;font-size:13px;font-weight:900;line-height:1.15;letter-spacing:0}
    .suas-hours-note{margin:0;padding:6px 8px;border:1.5px solid var(--ink);border-radius:12px;background:#fff1a8;font:800 9px/1.3 Futura,Arial,sans-serif;letter-spacing:.04em;text-transform:uppercase}
    @media(max-width:560px){.suas-hours-split{grid-template-columns:1fr 1fr;gap:5px}.suas-hours-block{padding:6px}.suas-hours-list li{padding:5px 6px;font-size:9px}.suas-hours-list span:first-child{font-size:9px}.suas-hours-list span:last-child{font-size:12px}}
    .suas-window-bar{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px;min-height:42px;padding:8px 14px;border-bottom:2px solid var(--ink);background:linear-gradient(180deg,#fff,#e8edf3);overflow:hidden}
    .suas-window-dots{display:flex;gap:7px;min-width:0}
    .suas-dot{width:11px;height:11px;flex:0 0 auto;border-radius:999px;background:var(--dot)}
    .suas-window-title{text-align:center;font-size:10px;letter-spacing:.2em;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .suas-rotator-pause{min-height:28px;justify-self:end;padding:4px 8px;border:1.5px solid var(--ink);border-radius:999px;background:#fff;box-shadow:0 2px 0 var(--ink);font:900 9px/1 Futura,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase;cursor:pointer}
    .suas-window-live{display:inline-flex;align-items:center;gap:6px;font-size:9px;font-weight:900;letter-spacing:.16em}
    .suas-window-live b{width:8px;height:8px;border-radius:999px;background:#28c840;box-shadow:0 0 0 4px rgba(40,200,64,.18);animation:suasHomeBlink 1.4s steps(2,end) infinite}
    .suas-hours-win .suas-window-live[data-open='false'] b{background:#ff5f57;box-shadow:0 0 0 4px rgba(255,95,87,.2);animation:suasHomeBlink 1.8s steps(2,end) infinite}
    .suas-hours-win .suas-window-live[data-open='true'] b{background:#28c840;box-shadow:0 0 0 4px rgba(40,200,64,.18)}
    @keyframes suasHomeBlink{50%{opacity:.35}}
    .suas-feed-notes-body{display:flex;flex:1;flex-direction:column;gap:6px;padding:10px 12px 12px}
    .suas-product-rotator{position:relative;height:auto;min-height:0;padding:16px;overflow:hidden;isolation:isolate}
    .suas-product-slide{position:relative;inset:auto;display:none;grid-template-columns:minmax(0,320px) minmax(0,1fr);align-items:stretch;gap:14px;color:var(--ink);opacity:1;pointer-events:auto;transform:none;animation:none!important;min-width:0}
    .suas-product-slide.is-active,.suas-product-slide.is-static,.suas-product-rotator[data-count='1'] .suas-product-slide{display:grid;opacity:1;pointer-events:auto;transform:none;z-index:2}
    .suas-product-photo{position:relative;width:100%;max-width:min(320px,42vh);max-height:min(320px,42vh);min-width:0;aspect-ratio:1;display:block;justify-self:start;align-self:center;border:2px solid var(--ink);border-radius:20px;isolation:isolate;background-color:#fff;background-image:linear-gradient(rgba(16,16,16,.12) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.12) 1px,transparent 1px);background-size:22px 22px;box-shadow:3px 4px 0 var(--ink);overflow:hidden;color:var(--ink);text-decoration:none}
    .suas-product-photo img{position:absolute;inset:0;width:100%;height:100%;padding:4%;box-sizing:border-box;object-fit:contain;object-position:center center;transform:none;filter:none;animation:none}
    .suas-product-fallback{width:72%;aspect-ratio:1;display:grid;place-items:center;border-radius:999px;background:#fff;color:var(--ink);font-size:4rem}
    .suas-world-home .suas-product-kicker{display:none!important}
    .suas-product-copy{width:100%;min-height:0;min-width:0;height:100%;display:grid;align-content:center;gap:8px;border:2px solid var(--ink);border-radius:18px;background:rgba(255,255,255,.95);box-shadow:none;padding:10px 12px;overflow:hidden}
    .suas-product-title{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-width:0;color:var(--ink);text-decoration:none;font-size:clamp(1.15rem,2vw,1.55rem);line-height:.9;text-transform:lowercase}
    .suas-product-title:hover{color:var(--ink)}
    .suas-product-price{display:inline-flex;width:100%;min-width:0;min-height:32px;align-items:center;justify-content:center;margin-top:0;padding:6px 8px;border:1.5px solid var(--ink);border-radius:999px;background:#fff;box-shadow:0 2px 0 var(--ink);font-weight:900;font-size:9px;letter-spacing:.08em}
    .suas-product-actions{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:0;min-width:0}
    .suas-feed-btn{min-height:30px;width:100%;min-width:0;display:inline-flex;align-items:center;justify-content:center;border:1.75px solid var(--ink);border-radius:999px;padding:6px 8px;color:var(--ink);background:var(--feed-btn,#fff);box-shadow:0 2px 0 var(--ink);text-decoration:none;font-weight:900;font-size:8px;letter-spacing:.08em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;transition:transform 160ms ease,box-shadow 160ms ease}
    .suas-feed-btn:hover{color:var(--ink);transform:translateY(2px);box-shadow:0 1px 0 var(--ink)}
    .suas-launch-panel{display:flex;flex-direction:column;justify-content:flex-start;align-self:start;height:auto;min-height:0;width:100%;padding:0;gap:0}
    .suas-launch-panel .suas-window-bar{width:100%;max-width:none;align-self:stretch;overflow:hidden;min-height:42px;padding:8px 14px;background:#101010;color:#d9ff78;border-bottom:2px solid #101010}
    .suas-launch-panel .suas-window-title{font-size:11px;letter-spacing:.14em;overflow:visible;text-overflow:clip;color:#d9ff78}
    .suas-launch-panel .suas-window-live{color:#d9ff78}
    .suas-launch-body{display:flex;flex-direction:column;gap:11px;padding:12px;flex:0 0 auto}
    .suas-launch-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
    .suas-launch-grid .suas-launch:nth-of-type(n+5){display:none!important}
    .suas-launch{min-height:88px;display:flex;flex-direction:column;justify-content:center;border:2.5px solid #101010;border-radius:32px;padding:14px 16px;color:#101010;background:var(--launch);box-shadow:none;text-decoration:none}
    .suas-launch:hover{color:#101010;filter:brightness(.97)}
    .suas-launch strong{font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:clamp(1.2rem,2vw,1.55rem);font-weight:400!important;line-height:.86;text-transform:uppercase}
    .suas-launch span{margin-top:6px;font:900 9px/1 Futura,Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}
    html body .suas-world-home .suas-launch-grid a.suas-launch:nth-child(1){background:#d9ff78!important}
    html body .suas-world-home .suas-launch-grid a.suas-launch:nth-child(2){background:#ff9bc4!important}
    html body .suas-world-home .suas-launch-grid a.suas-launch:nth-child(3){background:#cdeeff!important}
    html body .suas-world-home .suas-launch-grid a.suas-launch:nth-child(4){background:#e4d5ff!important}
    .suas-actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:auto}
    .suas-btn{min-height:38px;display:inline-flex;align-items:center;justify-content:center;border:2px solid var(--ink);border-radius:999px;padding:9px 14px;color:var(--ink);background:#fff;box-shadow:0 4px 0 var(--ink);text-decoration:none;font-weight:900}
    .suas-btn[data-dark]{color:#fff;background:var(--ink)}
    .suas-boost-body{display:grid;grid-template-columns:minmax(180px,.7fr) minmax(0,1.3fr);gap:12px;padding:14px}
    .suas-boost-copy{display:flex;flex-direction:column;justify-content:center;gap:8px;padding:10px;border:2px solid var(--ink);border-radius:18px;background:linear-gradient(135deg,var(--lime),#fff 70%)}
    .suas-boost-copy strong{font-size:clamp(1.6rem,3vw,2.3rem);line-height:.86;text-transform:lowercase}
    .suas-boost-copy p{margin:0;font-size:12px;font-weight:700;line-height:1.3}
    .suas-boost-rail{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;align-items:start}
    .suas-boost-card{display:flex;flex-direction:column;gap:8px;min-width:0;height:auto;padding:10px;border:2px solid var(--ink);border-radius:18px;background:#fff;box-shadow:3px 4px 0 var(--ink);text-decoration:none;color:var(--ink);overflow:hidden}
    .suas-boost-card img,.suas-boost-fallback{display:block;width:100%!important;height:auto!important;max-height:none!important;aspect-ratio:1;object-fit:contain;object-position:center center;border:1.5px solid var(--ink);border-radius:14px;background:linear-gradient(135deg,#fff,var(--pink))}
    .suas-boost-card:nth-child(2) img,.suas-boost-card:nth-child(2) .suas-boost-fallback{background:linear-gradient(135deg,#fff,var(--blue))}
    .suas-boost-card:nth-child(3) img,.suas-boost-card:nth-child(3) .suas-boost-fallback{background:linear-gradient(135deg,#fff,var(--sun))}
    .suas-boost-card b{font-size:.92rem;line-height:.95;text-transform:lowercase;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .suas-boost-meta{display:flex;flex-wrap:wrap;align-items:center;gap:6px}
    .suas-sale{display:inline-flex;align-items:center;min-height:22px;padding:3px 8px;border:1.5px solid var(--ink);border-radius:999px;background:var(--hot);font-size:8px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}
    .suas-boost-card s{opacity:.45;font-size:9px}
    @keyframes suasBob{0%,100%{transform:translateY(0) rotate(-1deg)}50%{transform:translateY(-5px) rotate(1deg)}}
    @media(max-width:1023px){
      .suas-world-home{padding-top:12px}
      .suas-home-logo{width:min(42vw,168px);height:min(42vw,168px);max-width:168px;margin:12px auto 14px}
      .suas-home-logo-img{width:100%;height:100%;max-width:168px;max-height:168px;border-radius:999px;object-fit:contain;object-position:center}
      .suas-home-logo-arc{display:none}
    }
    @media(max-width:990px){
      .suas-aisles{grid-template-columns:1fr 1fr;gap:8px}
      .suas-aisle{padding:16px;border-radius:18px}
      .suas-window-title{font-size:9px}
      .suas-product-rotator{height:auto;padding:14px}
      .suas-product-slide{grid-template-columns:minmax(0,228px) minmax(0,1fr);gap:12px}
      .suas-product-photo{max-width:min(228px,38vh);max-height:min(228px,38vh);justify-self:start;align-self:center}
      .suas-product-copy{padding:10px 11px;gap:8px}
      .suas-product-title{font-size:clamp(1.05rem,3vw,1.3rem)}
      .suas-launch{min-height:78px;padding:12px}
      .suas-launch strong{font-size:1.25rem;font-weight:400!important;text-transform:uppercase}
      .suas-launch span{display:block;font-size:9px;font-weight:900}
      .suas-boost-body{grid-template-columns:1fr}
      .suas-boost-rail{grid-template-columns:repeat(3,minmax(0,1fr))}
    }
    @media(max-width:560px){
      .suas-aisles{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:6px}
      .suas-aisle-col{gap:6px}
      .suas-men-jump{min-height:32px;font-size:clamp(1rem,4.6vw,1.25rem);box-shadow:2px 3px 0 var(--ink)}
      .suas-aisle{padding:12px 11px 13px;border-radius:16px;gap:8px;box-shadow:3px 4px 0 var(--ink)}
      .suas-aisle small{font-size:9px;letter-spacing:.12em}
      .suas-aisle h2,.suas-aisle h3{font-size:clamp(1.7rem,8vw,2.25rem)}
      .suas-aisle-chips{gap:6px}
      .suas-aisle-chips a{min-height:34px;padding:6px 7px;font-size:10px;letter-spacing:.04em;box-shadow:0 2px 0 var(--ink)}
      .suas-home-logo{width:min(46vw,152px);height:min(46vw,152px);max-width:152px;margin:12px auto 14px}
      .suas-home-logo-img{width:100%;height:100%;max-width:152px;max-height:152px;border-radius:999px;object-fit:contain;object-position:center}
      .suas-home-logo-arc{display:none}
      .suas-mid-row{grid-template-columns:1fr;gap:8px}
      .suas-window-live{display:none}
      .suas-product-rotator{padding:12px}
      .suas-product-slide{grid-template-columns:minmax(0,186px) minmax(0,1fr);gap:10px}

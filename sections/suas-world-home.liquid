<section class="suas-world-home" aria-label="SUAS World home">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}@font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}
    .suas-world-home{--ink:#101010;--cream:#fbfaf7;--pink:#ffd8e8;--hot:#ff9bc4;--blue:#cdeeff;--lime:#d9ff78;--lav:#e4d5ff;--sun:#fff1a8;color:var(--ink);background:linear-gradient(rgba(16,16,16,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.035) 1px,transparent 1px),radial-gradient(circle at 8% 14%,rgba(255,216,232,.55),transparent 28%),radial-gradient(circle at 90% 76%,rgba(217,255,120,.28),transparent 30%),var(--cream);background-size:22px 22px,22px 22px,auto,auto,auto;font-family:Futura,'Futura PT',Arial,sans-serif;overflow:hidden}.suas-world-home *{box-sizing:border-box}.suas-font{font-family:'Casual Human',Futura,Arial,sans-serif!important;font-weight:400!important;letter-spacing:0!important}.suas-mono{font-family:Futura,'Futura PT',Arial,sans-serif;font-size:10px;letter-spacing:.24em;text-transform:uppercase;font-weight:900}.suas-home-wrap{width:min(1120px,calc(100vw - 28px));margin:0 auto}.suas-hero{padding:clamp(42px,6vw,78px) 0}.suas-hero-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(300px,.75fr);gap:18px;align-items:stretch}.suas-now-card,.suas-launch-panel{border:2px solid var(--ink);border-radius:30px;background:rgba(255,255,255,.84);box-shadow:8px 9px 0 var(--ink);overflow:hidden}.suas-window-bar{display:flex;align-items:center;gap:8px;min-height:42px;padding:10px 16px;border-bottom:1.5px solid rgba(16,16,16,.14);background:linear-gradient(180deg,#fff,#e9edf3)}.suas-dot{width:12px;height:12px;border-radius:999px;background:var(--dot)}.suas-window-title{margin-left:auto;color:rgba(16,16,16,.52)}.suas-product-rotator{position:relative;min-height:430px;padding:clamp(18px,3vw,30px);isolation:isolate}.suas-product-slide{position:absolute;inset:clamp(18px,3vw,30px);display:grid;grid-template-columns:minmax(180px,.7fr) minmax(0,1fr);align-items:center;gap:clamp(16px,3vw,28px);color:var(--ink);text-decoration:none;opacity:0;pointer-events:none;animation:suasProductSpin var(--duration,32s) ease-in-out infinite;animation-delay:var(--delay,0s)}.suas-product-slide:first-child{position:relative;inset:auto}.suas-product-slide.is-static,.suas-product-rotator[data-count='1'] .suas-product-slide{opacity:1;animation:none;pointer-events:auto}.suas-product-photo{width:min(100%,260px);aspect-ratio:1;display:grid;place-items:center;border:2px solid var(--ink);border-radius:28px;background:linear-gradient(135deg,#fff,var(--pink));box-shadow:6px 7px 0 var(--ink);overflow:hidden}.suas-product-photo img{width:88%;height:88%;object-fit:contain;filter:drop-shadow(0 14px 18px rgba(16,16,16,.18));animation:suasBob 5s ease-in-out infinite}.suas-product-fallback{width:70%;aspect-ratio:1;display:grid;place-items:center;border-radius:999px;background:#fff;color:var(--ink);font-size:5rem}.suas-product-kicker{display:inline-flex;width:max-content;margin-bottom:12px;padding:7px 10px;border:1.5px solid var(--ink);border-radius:999px;background:var(--lime);box-shadow:0 3px 0 var(--ink);color:var(--ink)}.suas-product-title{font-size:clamp(3rem,6.8vw,6rem);line-height:.82;text-transform:lowercase}.suas-product-price{display:inline-flex;width:max-content;min-height:36px;align-items:center;margin-top:16px;padding:8px 13px;border:1.5px solid var(--ink);border-radius:999px;background:#fff;box-shadow:0 3px 0 var(--ink);font-weight:900}.suas-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}.suas-btn{min-height:46px;display:inline-flex;align-items:center;justify-content:center;border:2px solid var(--ink);border-radius:999px;padding:12px 18px;color:var(--ink);background:#fff;box-shadow:0 4px 0 var(--ink);text-decoration:none;font-weight:900}.suas-btn[data-dark]{color:#fff;background:var(--ink)}.suas-launch-panel{padding:clamp(20px,3vw,28px);display:flex;flex-direction:column;justify-content:space-between;gap:18px}.suas-launch-title{font-size:clamp(3rem,6vw,5.4rem);line-height:.82;text-transform:lowercase}.suas-launch-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.suas-launch{min-height:86px;display:flex;flex-direction:column;justify-content:center;border:2px solid var(--ink);border-radius:22px;padding:14px;color:var(--ink);background:var(--launch);box-shadow:0 5px 0 var(--ink);text-decoration:none;transition:transform 160ms ease,box-shadow 160ms ease}.suas-launch:hover{color:var(--ink);transform:translateY(2px);box-shadow:0 3px 0 var(--ink)}.suas-launch strong{font-size:1.65rem;line-height:.9;text-transform:lowercase}.suas-led{border-top:1.5px solid rgba(16,16,16,.14);background:#101010;overflow:hidden}.suas-led-track{display:inline-flex;white-space:nowrap;animation:suasLed 34s linear infinite}.suas-led-track span{padding:12px 20px;color:#fff}.suas-section{padding:clamp(50px,7vw,86px) 0;background:rgba(255,255,255,.42)}.suas-section-head{margin-bottom:24px}.suas-section-head h2{margin:0;font-size:clamp(3.4rem,8vw,7rem);line-height:.84;text-transform:lowercase}.suas-scent-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px}.suas-scent{min-height:150px;display:flex;flex-direction:column;justify-content:end;align-items:center;border:2px solid var(--ink);border-radius:999px 999px 8px 8px;padding:22px 12px 18px;color:var(--ink);background:#f2f3f5;box-shadow:0 7px 0 var(--ink);text-align:center;text-decoration:none;transition:transform 160ms ease,box-shadow 160ms ease}.suas-scent:hover{color:var(--ink);transform:translateY(3px);box-shadow:0 4px 0 var(--ink)}.suas-scent h3{margin:0;font-size:clamp(1.55rem,2.7vw,2.7rem);line-height:.9;text-transform:uppercase}.suas-scent p{margin:9px 0 0;font-size:10px;line-height:1.35;font-weight:900;letter-spacing:.1em;text-transform:uppercase;opacity:.72}@keyframes suasProductSpin{0%,6%{opacity:0;transform:translateY(18px) scale(.985)}10%,28%{opacity:1;transform:translateY(0) scale(1)}34%,100%{opacity:0;transform:translateY(-18px) scale(.99)}}@keyframes suasBob{0%,100%{transform:translateY(0) rotate(-1deg)}50%{transform:translateY(-7px) rotate(1deg)}}@keyframes suasLed{from{transform:translateX(0)}to{transform:translateX(-50%)}}@media(max-width:990px){.suas-hero-grid{grid-template-columns:1fr}.suas-scent-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:620px){.suas-hero{padding-top:24px}.suas-product-rotator{min-height:360px;padding:16px}.suas-product-slide{inset:16px;grid-template-columns:1fr;align-content:start;gap:12px}.suas-product-photo{width:min(66vw,188px);border-radius:22px}.suas-product-title{font-size:clamp(2.4rem,13vw,4rem)}.suas-launch-grid{grid-template-columns:1fr}.suas-launch{min-height:68px}.suas-scent{min-height:112px;padding:18px 8px 14px}.suas-scent h3{font-size:clamp(1.04rem,7vw,1.7rem)}.suas-scent p{font-size:8px}}
  </style>
  {% liquid
    assign butter_collection = collections['butter-creme']
    if butter_collection == blank or butter_collection.products_count == 0
      assign butter_collection = collections['women-s-butter-creme']
    endif
    if butter_collection == blank or butter_collection.products_count == 0
      assign butter_collection = collections['m-butter-creme']
    endif
    if butter_collection == blank or butter_collection.products_count == 0
      assign butter_collection = collections['whipped-body-butter']
    endif
    assign butter_count = butter_collection.products_count | default: 0
    if butter_count > 6
      assign butter_count = 6
    endif
  %}
  <div class="suas-hero"><div class="suas-home-wrap"><div class="suas-hero-grid"><div class="suas-now-card"><div class="suas-window-bar"><span class="suas-dot" style="--dot:#ff5f57"></span><span class="suas-dot" style="--dot:#febc2e"></span><span class="suas-dot" style="--dot:#28c840"></span><span class="suas-window-title suas-mono">now mixing / product feed</span></div><div class="suas-product-rotator" data-count="{{ butter_count }}">{% if butter_collection != blank and butter_collection.products_count > 0 %}{% for product in butter_collection.products limit:6 %}<a class="suas-product-slide" href="{{ product.url }}" style="--duration: {{ butter_count | times: 4 }}s; --delay: {{ forloop.index0 | times: 4 }}s;"><div class="suas-product-photo">{% if product.featured_image %}{{ product.featured_image | image_url: width: 620 | image_tag: loading: 'eager', alt: product.title }}{% else %}<div class="suas-product-fallback suas-font">s.</div>{% endif %}</div><div class="suas-product-copy"><div class="suas-product-kicker suas-mono">tap to shop</div><div class="suas-product-title suas-font">{{ product.title }}</div><div class="suas-product-price suas-mono">{{ product.price | money }}</div></div></a>{% endfor %}{% else %}<a class="suas-product-slide is-static" href="/collections/women-s-butter-creme"><div class="suas-product-photo"><div class="suas-product-fallback suas-font">s.</div></div><div class="suas-product-copy"><div class="suas-product-kicker suas-mono">tap to shop</div><div class="suas-product-title suas-font">butter creme</div><div class="suas-product-price suas-mono">shop collection</div></div></a>{% endif %}</div></div><aside class="suas-launch-panel"><div><div class="suas-mono" style="margin-bottom:12px;">quick launch</div><div class="suas-launch-title suas-font">choose your door.</div></div><div class="suas-launch-grid"><a class="suas-launch" href="/collections/new-arrivals" style="--launch:#ffd8e8"><strong class="suas-font">new arrivals</strong><span class="suas-mono">shop</span></a><a class="suas-launch" href="/collections/best-sellers" style="--launch:#d9ff78"><strong class="suas-font">best sellers</strong><span class="suas-mono">shop</span></a><a class="suas-launch" href="/collections/feminine" style="--launch:#e4d5ff"><strong class="suas-font">feminine</strong><span class="suas-mono">shop</span></a><a class="suas-launch" href="/collections/masculine" style="--launch:#cdeeff"><strong class="suas-font">masculine</strong><span class="suas-mono">shop</span></a><a class="suas-launch" href="/collections/oddities" style="--launch:#fff1a8"><strong class="suas-font">oddities</strong><span class="suas-mono">shop</span></a><a class="suas-launch" href="/pages/bookings" style="--launch:#ff9bc4"><strong class="suas-font">book the lab</strong><span class="suas-mono">reserve</span></a></div><div class="suas-actions"><a class="suas-btn suas-mono" data-dark href="/collections/all">shop all</a><a class="suas-btn suas-mono" href="/pages/shut-up-and-smell">the lab</a></div></aside></div></div></div><div class="suas-led" aria-hidden="true"><div class="suas-led-track suas-mono">{% for i in (1..2) %}<span>smell rich</span><span>handmade in gastonia</span><span>dopamine on tap</span><span>formula 001</span><span>shut up & smell</span><span>suas.os online</span>{% endfor %}</div></div><div class="suas-section"><div class="suas-home-wrap"><div class="suas-section-head"><h2 class="suas-font">signature scents.</h2></div><div class="suas-scent-grid"><a class="suas-scent" href="/products/apple-tease"><h3 class="suas-font">nectar</h3><p>passionfruit pineapple juicy</p></a><a class="suas-scent" href="/products/good-girl"><h3 class="suas-font">good girl</h3><p>sweet feminine addictive</p></a><a class="suas-scent" href="/products/shocking-ice"><h3 class="suas-font">tonic</h3><p>fresh citrus minty</p></a><a class="suas-scent" href="/products/milkd"><h3 class="suas-font">haze</h3><p>dreamy soft comforting</p></a><a class="suas-scent" href="/products/brown-suga"><h3 class="suas-font">ember</h3><p>warm vanilla magnetic</p></a><a class="suas-scent" href="/products/plumeria"><h3 class="suas-font">crimson</h3><p>bold sweet tempting</p></a></div></div></div>
</section>
{% schema %}{"name":"SUAS World Home","settings":[],"presets":[{"name":"SUAS World Home"}]}{% endschema %}

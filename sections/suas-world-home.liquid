<section class="suas-world-home" aria-label="SUAS World home">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}
    .suas-world-home{--ink:#101010;--cream:#fbfaf7;--pink:#ffd8e8;--hot:#ff9bc4;--blue:#cdeeff;--lime:#d9ff78;--lav:#e4d5ff;--sun:#fff1a8;color:var(--ink);background:linear-gradient(rgba(16,16,16,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.035) 1px,transparent 1px),radial-gradient(circle at 8% 14%,rgba(255,216,232,.55),transparent 28%),radial-gradient(circle at 90% 76%,rgba(217,255,120,.28),transparent 30%),var(--cream);background-size:22px 22px,22px 22px,auto,auto,auto;font-family:Futura,'Futura PT',Arial,sans-serif;overflow:hidden}
    .suas-world-home *{box-sizing:border-box}
    .suas-font{font-family:'Casual Human',Futura,Arial,sans-serif!important;font-weight:400!important;letter-spacing:0!important}
    .suas-mono{font-family:Futura,'Futura PT',Arial,sans-serif;font-size:10px;letter-spacing:.22em;text-transform:uppercase;font-weight:900}
    .suas-home-wrap{width:min(1260px,calc(100vw - 32px));margin:0 auto}
    .suas-hero{padding:clamp(14px,2vw,22px) 0 18px}
    .suas-hero-grid{display:grid!important;grid-template-columns:minmax(0,1.48fr) minmax(285px,.52fr)!important;gap:14px!important;align-items:start!important}
    .suas-feed-column{display:grid;gap:14px;min-width:0}
    .suas-feed-notes{min-height:156px;display:flex;flex-direction:column;gap:10px;border:2px solid var(--ink);border-radius:22px;background:linear-gradient(rgba(16,16,16,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.025) 1px,transparent 1px),linear-gradient(135deg,rgba(255,216,232,.52),rgba(255,255,255,.95) 58%,rgba(217,255,120,.36));background-size:18px 18px,18px 18px,auto;box-shadow:5px 6px 0 var(--ink);padding:14px}
    .suas-feed-note-label{display:flex;align-items:center;justify-content:space-between;gap:8px}
    .suas-feed-note-label strong{font-size:1.35rem;line-height:1;text-transform:lowercase;font-weight:700!important;white-space:nowrap}
    .suas-feed-note{width:100%;min-height:72px;resize:vertical;border:1.5px solid var(--ink);border-radius:15px;background:rgba(255,255,255,.9);padding:10px;color:var(--ink);font:700 12px/1.35 Futura,'Futura PT',Arial,sans-serif}
    .suas-feed-note::placeholder{color:rgba(16,16,16,.48)}
    .suas-feed-announcement{width:100%;min-height:72px;display:flex;align-items:center;border:1.5px solid var(--ink);border-radius:15px;background:rgba(255,255,255,.9);padding:11px 13px;color:var(--ink);font-size:1.15rem;line-height:1.15}
    .suas-feed-notes-actions{display:flex;gap:8px;align-items:center}
    .suas-feed-notes-actions .suas-feed-btn{flex:1}
    .suas-product-copy>.suas-product-actions{display:none!important}
    .suas-now-card,.suas-launch-panel{border:2px solid var(--ink);border-radius:24px;background:rgba(255,255,255,.93);box-shadow:5px 6px 0 var(--ink);overflow:hidden}
    .suas-window-bar{display:flex;align-items:center;gap:8px;min-height:34px;padding:7px 12px;border-bottom:1.5px solid rgba(16,16,16,.14);background:linear-gradient(180deg,#fff,#e9edf3)}
    .suas-dot{width:10px;height:10px;border-radius:999px;background:var(--dot)}
    .suas-window-title{margin-left:auto;color:rgba(16,16,16,.58)}
    .suas-product-rotator{position:relative;height:430px!important;min-height:0!important;padding:18px;isolation:isolate}
    .suas-product-slide{position:absolute!important;inset:18px!important;display:grid!important;grid-template-columns:minmax(310px,385px) minmax(310px,430px);justify-content:center;align-items:center;justify-items:center;gap:clamp(22px,3.6vw,46px);color:var(--ink);text-decoration:none;opacity:0;pointer-events:none;transform:translateY(8px) scale(.985);transition:opacity 950ms ease,transform 950ms ease}
    .suas-product-slide.is-active,.suas-product-slide.is-static,.suas-product-rotator[data-count='1'] .suas-product-slide{opacity:1;pointer-events:auto;transform:translateY(0) scale(1)}
    .suas-product-photo{width:min(100%,370px);aspect-ratio:1;display:grid;place-items:center;border:2px solid var(--ink);border-radius:26px;background:linear-gradient(135deg,#fff,var(--pink));box-shadow:7px 8px 0 var(--ink);overflow:hidden;color:var(--ink);text-decoration:none}
    .suas-product-photo img{width:92%;height:92%;object-fit:contain;filter:drop-shadow(0 12px 16px rgba(16,16,16,.15));animation:suasBob 6.8s ease-in-out infinite}
    .suas-product-fallback{width:72%;aspect-ratio:1;display:grid;place-items:center;border-radius:999px;background:#fff;color:var(--ink);font-size:4rem}
    .suas-world-home .suas-product-kicker{display:none!important}
    .suas-product-copy{width:100%;min-height:288px;display:grid;align-content:center;border:1.5px solid rgba(16,16,16,.17);border-radius:25px;background:rgba(255,255,255,.95);box-shadow:0 18px 32px rgba(16,16,16,.1);padding:28px 30px}
    .suas-product-title{display:block;color:var(--ink);text-decoration:none;font-size:clamp(2.8rem,4.2vw,4.75rem);line-height:.82;text-transform:lowercase}
    .suas-product-title:hover{color:var(--ink)}
    .suas-product-price{display:inline-flex;width:max-content;min-height:34px;align-items:center;margin-top:18px;padding:8px 13px;border:1.5px solid var(--ink);border-radius:999px;background:#fff;box-shadow:0 3px 0 var(--ink);font-weight:900}
    .suas-product-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}
    .suas-feed-btn{min-height:36px;display:inline-flex;align-items:center;justify-content:center;border:1.75px solid var(--ink);border-radius:999px;padding:9px 13px;color:var(--ink);background:var(--feed-btn,#fff);box-shadow:0 3px 0 var(--ink);text-decoration:none;font-weight:900;transition:transform 160ms ease,box-shadow 160ms ease}
    .suas-feed-btn:hover{color:var(--ink);transform:translateY(2px);box-shadow:0 1px 0 var(--ink)}
    .suas-launch-panel{padding:15px;display:flex;flex-direction:column;justify-content:flex-start;gap:11px;min-height:0!important}
    .suas-launch-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
    .suas-launch{min-height:72px;display:flex;flex-direction:column;justify-content:center;border:1.75px solid var(--ink);border-radius:18px;padding:12px;color:var(--ink);background:var(--launch);box-shadow:0 4px 0 var(--ink);text-decoration:none;transition:transform 160ms ease,box-shadow 160ms ease}
    .suas-launch:hover{color:var(--ink);transform:translateY(2px);box-shadow:0 2px 0 var(--ink)}
    .suas-launch strong{font-size:1.13rem;line-height:.9;text-transform:lowercase}
    .suas-actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:12px}
    .suas-btn{min-height:38px;display:inline-flex;align-items:center;justify-content:center;border:2px solid var(--ink);border-radius:999px;padding:9px 14px;color:var(--ink);background:#fff;box-shadow:0 4px 0 var(--ink);text-decoration:none;font-weight:900}
    .suas-btn[data-dark]{color:#fff;background:var(--ink)}
    .suas-led{border-top:1.5px solid rgba(16,16,16,.16);background:#101010;overflow:hidden}
    .suas-led-track{display:inline-flex;white-space:nowrap;animation:suasLed 34s linear infinite}
    .suas-led-track span{padding:10px 20px;color:#fff}
    .suas-section{padding:clamp(30px,4.2vw,48px) 0;background:rgba(255,255,255,.42)}
    .suas-section-head{margin-bottom:16px}
    .suas-section-head h2{margin:0;font-size:clamp(2.65rem,5.4vw,4.75rem);line-height:.84;text-transform:lowercase}
    .suas-scent-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px}
    .suas-scent{position:relative;isolation:isolate;min-height:132px;display:flex;flex-direction:column;justify-content:center;align-items:center;border:2px solid var(--ink);border-radius:58% 42% 52% 48%/46% 58% 42% 54%;padding:21px 12px 17px;color:var(--ink);background:rgba(255,255,255,.74);box-shadow:0 7px 0 var(--ink);text-align:center;text-decoration:none;transition:transform 180ms ease,box-shadow 180ms ease,background 180ms ease}
    .suas-scent:before,.suas-scent:after{content:'';position:absolute;z-index:-1;border:1.5px solid var(--ink);background:rgba(255,216,232,.2);opacity:.55}
    .suas-scent:before{inset:9px -7px 13px 8px;border-radius:45% 55% 47% 53%/56% 44% 58% 42%;transform:rotate(-6deg)}
    .suas-scent:after{inset:-6px 14px 18px -5px;border-radius:60% 40% 62% 38%/42% 60% 40% 58%;transform:rotate(8deg)}
    .suas-scent:nth-child(2n){border-radius:46% 54% 48% 52%/58% 42% 56% 44%;background:rgba(205,238,255,.52)}
    .suas-scent:nth-child(3n){background:rgba(255,241,168,.48)}
    .suas-scent:nth-child(4n){background:rgba(228,213,255,.5)}
    .suas-scent:hover{color:var(--ink);transform:translateY(3px) rotate(-1deg);box-shadow:0 4px 0 var(--ink);background:rgba(255,216,232,.6)}
    .suas-scent h3{margin:0;font-size:clamp(1.35rem,2.2vw,2.1rem);line-height:.9;text-transform:uppercase}
    .suas-scent p{margin:9px 0 0;font-size:9px;line-height:1.35;font-weight:900;letter-spacing:.09em;text-transform:uppercase;opacity:.72}
    @keyframes suasBob{0%,100%{transform:translateY(0) rotate(-1deg)}50%{transform:translateY(-5px) rotate(1deg)}}@keyframes suasLed{from{transform:translateX(0)}to{transform:translateX(-50%)}}@keyframes suasProductName{0%,12%{transform:translateX(0)}88%,100%{transform:translateX(var(--name-travel,-34%))}}
    @media(max-width:990px){.suas-home-wrap{width:min(100% - 14px,760px)}.suas-hero-grid{grid-template-columns:minmax(0,1fr) minmax(122px,.36fr)!important;gap:8px!important}.suas-now-card,.suas-launch-panel{border-radius:18px;box-shadow:3px 4px 0 var(--ink)}.suas-window-bar{min-height:28px;padding:6px 8px}.suas-dot{width:8px;height:8px}.suas-window-title{font-size:6.5px;letter-spacing:.1em}.suas-product-rotator{height:245px!important;padding:8px}.suas-product-slide{inset:8px!important;grid-template-columns:118px minmax(0,1fr);gap:10px}.suas-product-photo{width:118px;border-radius:16px;box-shadow:3px 4px 0 var(--ink)}.suas-product-copy{min-height:132px;padding:10px 11px;border-radius:16px;box-shadow:0 8px 18px rgba(16,16,16,.07)}.suas-product-title{font-size:clamp(1.15rem,4.2vw,1.72rem)}.suas-product-price{min-height:24px;margin-top:7px;padding:5px 7px;font-size:7px;letter-spacing:.12em}.suas-product-actions{gap:6px;margin-top:9px}.suas-feed-btn{min-height:27px;padding:6px 8px;font-size:6.5px;letter-spacing:.1em}.suas-launch-panel{padding:8px;gap:7px}.suas-launch-panel>.suas-actions{display:none}.suas-launch-grid{grid-template-columns:1fr!important;gap:6px}.suas-launch{min-height:31px;padding:5px 7px;border-radius:11px;box-shadow:0 2px 0 var(--ink)}.suas-launch strong{font-size:.74rem}.suas-launch span{display:none}.suas-scent-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
    @media(max-width:430px){.suas-home-wrap{width:calc(100vw - 10px)}.suas-hero{padding-top:8px}.suas-hero-grid{grid-template-columns:minmax(0,1fr) 108px!important;gap:6px!important}.suas-product-rotator{height:235px!important}.suas-product-slide{grid-template-columns:1fr;align-content:start;gap:7px}.suas-product-photo{width:min(128px,88%);justify-self:center}.suas-product-copy{min-height:90px;padding:8px 8px;text-align:center}.suas-product-title{font-size:clamp(1.02rem,5.6vw,1.32rem)}.suas-product-price{margin:7px auto 0;font-size:6px}.suas-product-actions{justify-content:center}.suas-feed-btn{min-height:25px;padding:5px 7px;font-size:5.9px}.suas-launch-panel{padding:6px}.suas-launch-grid{gap:5px}.suas-launch{min-height:28px;padding:5px 6px}.suas-launch strong{font-size:.66rem}.suas-section-head h2{font-size:clamp(2.5rem,14vw,4rem)}.suas-scent-grid{gap:9px}.suas-scent{min-height:104px;padding:16px 7px 12px}.suas-scent h3{font-size:clamp(.95rem,5.4vw,1.35rem)}.suas-scent p{font-size:7px}}
  
    /* SUAS MOBILE PRODUCT FEED V3 */
    @media(max-width:430px){
      .suas-now-card{min-width:0!important;height:auto!important;align-self:start!important}
      .suas-product-rotator{height:222px!important;min-height:222px!important;padding:7px!important;overflow:hidden!important}
      .suas-product-slide{
        inset:7px!important;
        z-index:0!important;
        visibility:hidden!important;
        pointer-events:none!important;
        display:grid!important;
        grid-template-columns:minmax(0,1fr) 76px!important;
        grid-template-rows:148px 48px!important;
        column-gap:8px!important;
        row-gap:6px!important;
        align-items:center!important;
        align-content:start!important;
        justify-items:stretch!important;
      }
      .suas-product-slide.is-active,
      .suas-product-slide.is-static,
      .suas-product-rotator[data-count='1'] .suas-product-slide{
        z-index:3!important;
        visibility:visible!important;
        pointer-events:auto!important;
      }
      .suas-product-photo{
        grid-column:1!important;
        grid-row:1!important;
        width:min(148px,100%)!important;
        height:148px!important;
        aspect-ratio:1/1!important;
        justify-self:center!important;
        border-radius:15px!important;
        box-shadow:3px 4px 0 var(--ink)!important;
      }
      .suas-product-photo img{
        width:94%!important;
        height:94%!important;
        object-fit:contain!important;
        animation:none!important;
      }
      .suas-product-copy{
        display:contents!important;
        min-height:0!important;
        padding:0!important;
        border:0!important;
        background:transparent!important;
        box-shadow:none!important;
      }
      .suas-product-title{
        grid-column:1/3!important;
        grid-row:2!important;
        align-self:start!important;
        width:100%!important;
        min-width:0!important;
        margin:0!important;
        padding:3px 1px 0!important;
        color:var(--ink)!important;
        font-size:clamp(12px,3.65vw,15px)!important;
        line-height:1!important;
        text-align:center!important;
        white-space:nowrap!important;
        overflow:visible!important;
        text-overflow:clip!important;
        animation:suasProductName 7.5s ease-in-out infinite alternate!important;
        will-change:transform!important;
      }
      .suas-product-price{
        grid-column:2!important;
        grid-row:1!important;
        align-self:center!important;
        justify-self:stretch!important;
        width:100%!important;
        min-width:0!important;
        min-height:32px!important;
        margin:0!important;
        padding:7px 3px!important;
        justify-content:center!important;
        font-size:6.5px!important;
        letter-spacing:.08em!important;
        text-align:center!important;
      }
      .suas-product-actions{
        grid-column:2!important;
        grid-row:2!important;
        align-self:start!important;
        display:grid!important;
        grid-template-columns:1fr!important;
        gap:5px!important;
        width:100%!important;
        margin:0!important;
      }
      .suas-product-photo,
      .suas-product-title,
      .suas-feed-btn{
        position:relative!important;
        z-index:8!important;
        pointer-events:auto!important;
        touch-action:manipulation!important;
      }
      .suas-feed-notes{min-height:150px!important;gap:7px!important;padding:9px!important;border-radius:17px!important;box-shadow:3px 4px 0 var(--ink)!important}
      .suas-feed-note-label strong{font-size:1rem!important}
      .suas-feed-note{min-height:68px!important;max-height:92px!important;padding:8px!important;font-size:10px!important}
      .suas-feed-notes-actions{gap:6px!important}
      .suas-feed-notes-actions .suas-feed-btn{min-height:27px!important;font-size:6px!important}
      .suas-feed-btn{
        width:100%!important;
        min-width:0!important;
        min-height:22px!important;
        padding:5px 2px!important;
        font-size:5.5px!important;
        line-height:1!important;
        letter-spacing:.06em!important;
        white-space:nowrap!important;
      }
      @media(prefers-reduced-motion:reduce){.suas-product-title{animation:none!important;transform:none!important}}
    }
    /* END SUAS MOBILE PRODUCT FEED V3 */
</style>
  {% liquid
    assign butter_collection = collections['butter-creme']
    if butter_collection == blank or butter_collection.products_count == 0
      assign butter_collection = collections['women-s-butter-creme']
    endif
    if butter_collection == blank or butter_collection.products_count == 0
      assign butter_collection = collections['m-butter-creme']
    endif
    if butter_collection == blank or butter_collection.products_count == 0
      assign butter_collection = collections['whipped-body-butter']
    endif
    assign butter_count = butter_collection.products_count | default: 0
    if butter_count > 6
      assign butter_count = 6
    endif
  %}
  <div class="suas-hero">
    <div class="suas-home-wrap">
      <div class="suas-hero-grid">
        <div class="suas-feed-column">
        <div class="suas-now-card">
          <div class="suas-window-bar"><span class="suas-dot" style="--dot:#ff5f57"></span><span class="suas-dot" style="--dot:#febc2e"></span><span class="suas-dot" style="--dot:#28c840"></span><span class="suas-window-title suas-mono">now mixing / product feed</span></div>
          <div class="suas-product-rotator" data-suas-product-rotator data-count="{{ butter_count }}">
            {% if butter_collection != blank and butter_collection.products_count > 0 %}
              {% for product in butter_collection.products limit:6 %}
                <div class="suas-product-slide{% if forloop.first %} is-active{% endif %}">
                  <a class="suas-product-photo" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
                    {% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'eager', alt: product.title }}{% else %}<div class="suas-product-fallback suas-font">s.</div>{% endif %}
                  </a>
                  <div class="suas-product-copy"><a class="suas-product-title suas-font" href="{{ product.url }}">{{ product.title }}</a><div class="suas-product-price suas-mono">{{ product.price | money }}</div><div class="suas-product-actions"><a class="suas-feed-btn suas-mono" href="#suas-reviews" style="--feed-btn:#fff1a8">reviews</a><a class="suas-feed-btn suas-mono" href="/account" style="--feed-btn:#ffd8e8">account</a></div></div>
                </div>
              {% endfor %}
            {% else %}
              <div class="suas-product-slide is-static is-active"><a class="suas-product-photo" href="/collections/butter-creme"><div class="suas-product-fallback suas-font">s.</div></a><div class="suas-product-copy"><a class="suas-product-title suas-font" href="/collections/butter-creme">butter creme</a><div class="suas-product-price suas-mono">shop</div><div class="suas-product-actions"><a class="suas-feed-btn suas-mono" href="#suas-reviews" style="--feed-btn:#fff1a8">reviews</a><a class="suas-feed-btn suas-mono" href="/account" style="--feed-btn:#ffd8e8">account</a></div></div></div>
            {% endif %}
          </div>
        </div>
        <div class="suas-feed-notes">
          <div class="suas-feed-note-label"><strong class="suas-font">{{ section.settings.announcement_heading | default: 'daily announcement.' }}</strong></div>
          <div class="suas-feed-announcement suas-font" role="note">{{ section.settings.announcement_text | default: 'Plot twist: a new SUAS store and Fragrance Bar are coming soon. Your next signature scent is getting a new home.' }}</div>
          <div class="suas-feed-notes-actions"><a class="suas-feed-btn suas-mono" href="#suas-reviews" style="--feed-btn:#fff1a8">reviews</a><a class="suas-feed-btn suas-mono" href="/account" style="--feed-btn:#ffd8e8">account</a></div>
        </div>
        </div>
        <aside class="suas-launch-panel">
          <div class="suas-mono">quick launch</div>
          <div class="suas-launch-grid">
            <a class="suas-launch" href="{{ section.settings.new_arrivals_link | default: '/pages/new-arrivals' }}" style="--launch:#ffd8e8"><strong class="suas-font">new arrivals</strong><span class="suas-mono">shop</span></a>
            <a class="suas-launch" href="{{ section.settings.best_sellers_link | default: '/pages/best-sellers' }}" style="--launch:#d9ff78"><strong class="suas-font">best sellers</strong><span class="suas-mono">shop</span></a>
            <a class="suas-launch" href="/collections/feminine" style="--launch:#e4d5ff"><strong class="suas-font">feminine</strong><span class="suas-mono">shop</span></a>
            <a class="suas-launch" href="/collections/masculine" style="--launch:#cdeeff"><strong class="suas-font">masculine</strong><span class="suas-mono">shop</span></a>
            <a class="suas-launch" href="/collections/oddities" style="--launch:#fff1a8"><strong class="suas-font">oddities</strong><span class="suas-mono">shop</span></a>
            <a class="suas-launch" href="/pages/bookings" style="--launch:#ff9bc4"><strong class="suas-font">book the lab</strong><span class="suas-mono">reserve</span></a>
            <a class="suas-launch" href="{{ section.settings.charm_bar_link | default: '/pages/charm-bar' }}" style="--launch:#cdeeff"><strong class="suas-font">the charm bar</strong><span class="suas-mono">reserve</span></a>
          </div>
          <div class="suas-actions"><a class="suas-btn suas-mono" data-dark href="/collections/all">shop all</a><a class="suas-btn suas-mono" href="/pages/shut-up-and-smell">the lab</a></div>
        </aside>
      </div>
    </div>
  </div>
  <div class="suas-led" aria-hidden="true"><div class="suas-led-track suas-mono">{% for i in (1..2) %}<span>smell rich</span><span>handmade in gastonia</span><span>dopamine on tap</span><span>formula 001</span><span>shut up & smell</span><span>suas.os online</span>{% endfor %}</div></div>
  <div class="suas-section"><div class="suas-home-wrap"><div class="suas-section-head"><h2 class="suas-font">signature scents.</h2></div><div class="suas-scent-grid"><a class="suas-scent" href="/products/apple-tease"><h3 class="suas-font">nectar</h3><p>passionfruit pineapple juicy</p></a><a class="suas-scent" href="/products/good-girl"><h3 class="suas-font">good girl</h3><p>sweet feminine addictive</p></a><a class="suas-scent" href="/products/shocking-ice"><h3 class="suas-font">tonic</h3><p>fresh citrus minty</p></a><a class="suas-scent" href="/products/milkd"><h3 class="suas-font">haze</h3><p>dreamy soft comforting</p></a><a class="suas-scent" href="/products/brown-suga"><h3 class="suas-font">ember</h3><p>warm vanilla magnetic</p></a><a class="suas-scent" href="/products/plumeria"><h3 class="suas-font">crimson</h3><p>bold sweet tempting</p></a></div></div></div>
  <script>(()=>{function wireFeedNote(){const note=document.querySelector('.suas-world-home [data-suas-feed-note]');if(!note||note.dataset.suasNoteReady==='true')return;note.dataset.suasNoteReady='true';try{note.value=localStorage.getItem('suasProductFeedNote')||''}catch(error){}note.addEventListener('input',()=>{try{localStorage.setItem('suasProductFeedNote',note.value)}catch(error){}})}wireFeedNote();function wireFeedLinks(){document.querySelectorAll('.suas-world-home .suas-product-photo,.suas-world-home .suas-product-title,.suas-world-home .suas-feed-btn').forEach(link=>{if(link.dataset.suasTapReady==='true')return;link.dataset.suasTapReady='true';link.addEventListener('click',event=>{event.preventDefault();event.stopPropagation();const href=link.getAttribute('href')||'';if(!href)return;if(href.charAt(0)==='#'){const target=document.querySelector(href);if(target){target.scrollIntoView({behavior:'smooth',block:'start'});history.replaceState(null,'',href)}}else{window.location.assign(link.href)}},{capture:true})})}wireFeedLinks();function launchKey(link){const title=(link.querySelector('strong')?.textContent||link.textContent||'').trim().toLowerCase().replace(/\s+/g,' ');return title.replace(/\b(shop|launch|reserve)\b/g,'').trim()||((link.getAttribute('href')||'').replace(/\?.*$/,''))}function dedupeLaunch(){document.querySelectorAll('.suas-world-home .suas-launch-grid').forEach(grid=>{const seen=new Set;[...grid.querySelectorAll('a')].forEach(link=>{const key=launchKey(link);if(seen.has(key)){link.remove()}else{seen.add(key)}})})}dedupeLaunch();document.querySelectorAll('[data-suas-product-rotator]').forEach(rotator=>{if(rotator.dataset.ready==='true')return;rotator.dataset.ready='true';const slides=[...rotator.querySelectorAll('.suas-product-slide')];if(slides.length<2)return;let active=0;setInterval(()=>{slides[active].classList.remove('is-active');active=(active+1)%slides.length;slides[active].classList.add('is-active')},7600)})})();</script>

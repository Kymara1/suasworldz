<section class="suas-world-home" aria-label="SUAS World home">
  <style>
    @font-face {
      font-family: 'Casual Human';
      src: url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');
      font-display: swap;
    }

    @font-face {
      font-family: 'Casual Human';
      src: url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');
      font-weight: 700;
      font-display: swap;
    }

    .suas-world-home {
      --ink: #101010;
      --cream: #f8f7f4;
      --world: #f6f7fa;
      --pink: #ff9bc4;
      --soft-pink: #ffd8e8;
      --blue: #9dd7ff;
      --lav: #c7b5ff;
      --sun: #ffe86b;
      --lime: #c6f76a;
      color: var(--ink);
      background: var(--world);
      font-family: Futura, 'Futura PT', Arial, sans-serif;
      overflow: hidden;
    }

    .suas-world-home * { box-sizing: border-box; }

    .suas-font {
      font-family: 'Casual Human', Futura, Arial, sans-serif !important;
      font-weight: 400;
      letter-spacing: 0;
    }

    .suas-mono {
      font-family: Futura, 'Futura PT', Arial, sans-serif;
      font-size: 10px;
      letter-spacing: 0.28em;
      text-transform: uppercase;
    }

    .suas-home-wrap {
      width: min(1280px, calc(100vw - 28px));
      margin: 0 auto;
    }

    .suas-cyber-hero {
      position: relative;
      padding: clamp(34px, 6vw, 76px) 0 clamp(54px, 8vw, 96px);
      background:
        radial-gradient(720px 420px at 10% 20%, rgba(255, 126, 184, 0.22), transparent 62%),
        radial-gradient(660px 410px at 90% 78%, rgba(157, 215, 255, 0.24), transparent 62%),
        radial-gradient(520px 320px at 50% 100%, rgba(199, 181, 255, 0.2), transparent 62%),
        var(--cream);
    }

    .suas-cyber-deck {
      position: relative;
      border-radius: 30px;
      padding: 3px;
      background: linear-gradient(145deg, #fff 0%, #d7dbe3 25%, #f6f7fa 45%, #b8bdc6 70%, #fff 100%);
      box-shadow: 0 30px 60px -20px rgba(16, 16, 16, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.9);
      animation: suasBoot 0.8s ease-out both;
    }

    .suas-cyber-window {
      border-radius: 27px;
      overflow: hidden;
      background: linear-gradient(180deg, #f6f7fa 0%, #e5e8ee 100%);
    }

    .suas-titlebar {
      min-height: 44px;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 16px;
      border-bottom: 1px solid rgba(16, 16, 16, 0.15);
      background: linear-gradient(180deg, #fff 0%, #e9ecf1 62%, #d0d4dc 100%);
    }

    .suas-dots {
      display: flex;
      gap: 6px;
    }

    .suas-dots span {
      width: 12px;
      height: 12px;
      border-radius: 999px;
      box-shadow: inset 0 -1px 0 rgba(0, 0, 0, 0.25);
    }

    .suas-titlebar-label {
      flex: 1;
      text-align: center;
      color: rgba(16, 16, 16, 0.66);
    }

    .suas-cyber-body {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.95fr);
    }

    .suas-screen {
      position: relative;
      min-height: 540px;
      padding: clamp(24px, 4vw, 44px);
      overflow: hidden;
      color: #fff;
      background: radial-gradient(120% 92% at 30% 20%, #1a1533 0%, #0d0b1a 60%, #05040c 100%);
      animation: suasPower 0.9s ease-out both;
    }

    .suas-screen:before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: radial-gradient(rgba(201, 160, 255, 0.34) 1px, transparent 1px);
      background-size: 22px 22px;
      mask-image: radial-gradient(ellipse at 50% 50%, #000 40%, transparent 92%);
      pointer-events: none;
    }

    .suas-screen:after {
      content: "";
      position: absolute;
      inset: 0;
      background-image: repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.15) 0 1px, transparent 1px 3px);
      box-shadow: inset 0 0 120px rgba(0, 0, 0, 0.7);
      pointer-events: none;
    }

    .suas-screen-inner {
      position: relative;
      z-index: 1;
    }

    .suas-hud {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 30px;
      color: var(--lav);
    }

    .suas-live {
      color: var(--blue);
    }

    .suas-live:before {
      content: "";
      display: inline-block;
      width: 7px;
      height: 7px;
      margin-right: 8px;
      border-radius: 999px;
      background: #28c840;
      animation: suasBlink 1.4s steps(2, end) infinite;
    }

    .suas-screen h1 {
      margin: 0;
      font-size: clamp(3.1rem, 8vw, 7.5rem);
      line-height: 0.88;
      text-transform: lowercase;
      color: #fff;
    }

    .suas-screen h1 span {
      display: block;
      background: linear-gradient(120deg, #ffb4dc 0%, #c9a0ff 46%, #6bb6ea 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .suas-feature {
      display: flex;
      align-items: end;
      gap: 20px;
      margin-top: 34px;
    }

    .suas-holo {
      width: min(55%, 330px);
      aspect-ratio: 1;
      position: relative;
      display: grid;
      place-items: center;
      border-radius: 24px;
      background: radial-gradient(60% 60% at 50% 42%, rgba(255, 180, 220, 0.55), rgba(201, 160, 255, 0.15) 56%, transparent 82%);
      box-shadow: inset 0 0 42px rgba(201, 160, 255, 0.35);
    }

    .suas-holo img {
      width: 78%;
      height: 78%;
      object-fit: contain;
      filter: drop-shadow(0 16px 26px rgba(255, 180, 220, 0.44));
      animation: suasBob 5s ease-in-out infinite;
    }

    .suas-product-title {
      min-width: 0;
      font-size: clamp(2rem, 3.4vw, 3.3rem);
      line-height: 0.92;
      text-transform: lowercase;
    }

    .suas-bars {
      width: min(260px, 100%);
      margin-top: 16px;
      display: grid;
      gap: 9px;
    }

    .suas-bar {
      display: grid;
      grid-template-columns: 54px 1fr;
      align-items: center;
      gap: 9px;
    }

    .suas-bar-track {
      height: 7px;
      overflow: hidden;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.1);
    }

    .suas-bar-track span {
      display: block;
      height: 100%;
      width: var(--w);
      border-radius: 999px;
      background: var(--c);
      box-shadow: 0 0 10px var(--c);
    }

    .suas-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 32px;
    }

    .suas-btn {
      min-height: 46px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(16, 16, 16, 0.16);
      border-radius: 999px;
      padding: 12px 18px;
      color: var(--ink);
      background: linear-gradient(180deg, #fff 0%, #ffd9ea 100%);
      box-shadow: 0 8px 18px -6px rgba(255, 126, 184, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.9);
      text-decoration: none;
      font-weight: 900;
    }

    .suas-btn[data-dark] {
      color: #fff;
      background: linear-gradient(180deg, #3a2a66 0%, #1c1338 100%);
      box-shadow: 0 0 0 1px rgba(201, 160, 255, 0.4), 0 0 18px -4px rgba(201, 160, 255, 0.55);
    }

    .suas-launch-panel {
      padding: clamp(20px, 3vw, 30px);
      display: flex;
      flex-direction: column;
      gap: 22px;
      border-left: 1px solid rgba(16, 16, 16, 0.15);
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.88) 0%, rgba(255, 236, 244, 0.62) 100%);
    }

    .suas-launch-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .suas-launch {
      position: relative;
      min-height: 92px;
      border-radius: 22px;
      padding: 16px;
      color: var(--ink);
      text-decoration: none;
      background: linear-gradient(180deg, #fff 0%, var(--launch) 140%);
      box-shadow: 0 0 0 1px rgba(16, 16, 16, 0.12), 0 6px 14px -4px rgba(var(--glow), 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.9);
      transition: transform 170ms ease;
    }

    .suas-launch:hover {
      color: var(--ink);
      transform: translateY(-2px) rotate(-1deg);
    }

    .suas-launch strong {
      display: block;
      font-size: 1.8rem;
      line-height: 0.9;
      text-transform: lowercase;
    }

    .suas-log {
      border-radius: 18px;
      padding: 16px;
      color: #a8ffb8;
      background: #0d0b1a;
      box-shadow: inset 0 0 0 1px rgba(201, 160, 255, 0.25);
    }

    .suas-log p {
      margin: 5px 0;
      font-family: ui-monospace, Consolas, monospace;
      font-size: 11px;
      line-height: 1.5;
    }

    .suas-led {
      position: relative;
      overflow: hidden;
      border-top: 1px solid rgba(16, 16, 16, 0.15);
      background: linear-gradient(180deg, #0d0b1a 0%, #1a1533 100%);
    }

    .suas-led-track {
      display: inline-flex;
      white-space: nowrap;
      animation: suasLed 32s linear infinite;
    }

    .suas-led-track span {
      padding: 12px 20px;
      color: var(--blue);
    }

    .suas-section {
      position: relative;
      padding: clamp(52px, 8vw, 102px) 0;
      background: var(--cream);
    }

    .suas-section[data-white] {
      background: #fff;
    }

    .suas-section:before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: linear-gradient(rgba(16, 16, 16, 0.045) 1px, transparent 1px), linear-gradient(90deg, rgba(16, 16, 16, 0.045) 1px, transparent 1px);
      background-size: 50px 50px;
      pointer-events: none;
    }

    .suas-section > .suas-home-wrap {
      position: relative;
      z-index: 1;
    }

    .suas-section-head {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 24px;
      margin-bottom: 26px;
    }

    .suas-section-head h2 {
      margin: 0;
      font-size: clamp(3.4rem, 8vw, 7rem);
      line-height: 0.85;
      text-transform: lowercase;
    }

    .suas-shelf-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 14px;
    }

    .suas-shelf-card {
      min-height: 190px;
      display: grid;
      place-items: center;
      border: 2px solid var(--ink);
      border-radius: 22px;
      color: #fff;
      background: var(--ink);
      box-shadow: 0 8px 0 var(--ink);
      text-align: center;
      text-decoration: none;
      transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease, color 160ms ease;
    }

    .suas-shelf-card:hover {
      color: var(--ink);
      background: var(--hover);
      transform: translateY(3px) rotate(-0.8deg);
      box-shadow: 0 5px 0 var(--ink);
    }

    .suas-shelf-card span {
      display: block;
      padding: 16px;
      font-size: clamp(2.4rem, 3.6vw, 4rem);
      line-height: 0.9;
      text-transform: uppercase;
    }

    .suas-lab-teaser {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(320px, 0.8fr);
      gap: 18px;
      align-items: stretch;
    }

    .suas-lab-copy,
    .suas-hours {
      border: 2px solid var(--ink);
      border-radius: 28px;
      padding: clamp(24px, 4vw, 44px);
      background: rgba(255, 255, 255, 0.72);
      box-shadow: 0 7px 0 var(--ink);
    }

    .suas-lab-copy h2 {
      margin: 0;
      font-size: clamp(3.6rem, 8vw, 7rem);
      line-height: 0.84;
      text-transform: lowercase;
    }

    .suas-lab-copy p {
      max-width: 720px;
      margin: 22px 0 0;
      font-size: clamp(1.15rem, 2.2vw, 1.8rem);
      line-height: 1.18;
      text-transform: lowercase;
      color: rgba(16, 16, 16, 0.62);
    }

    .suas-step-row {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
      margin-top: 30px;
    }

    .suas-step {
      min-height: 122px;
      border: 1px solid rgba(16, 16, 16, 0.12);
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.74);
      padding: 18px;
    }

    .suas-step b {
      display: block;
      margin-bottom: 22px;
      color: rgba(16, 16, 16, 0.45);
    }

    .suas-step span {
      display: block;
      font-size: 1.45rem;
      line-height: 1;
      text-transform: uppercase;
    }

    .suas-scent-grid {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 10px;
    }

    .suas-scent {
      min-height: 165px;
      display: flex;
      flex-direction: column;
      justify-content: end;
      align-items: center;
      border: 2px solid var(--ink);
      border-radius: 999px 999px 5px 5px;
      padding: 22px 12px 18px;
      color: var(--ink);
      background: #f2f3f5;
      box-shadow: 0 7px 0 var(--ink);
      text-align: center;
      text-decoration: none;
      transition: transform 160ms ease, box-shadow 160ms ease;
    }

    .suas-scent:hover {
      color: var(--ink);
      transform: translateY(3px);
      box-shadow: 0 4px 0 var(--ink);
    }

    .suas-scent h3 {
      margin: 0;
      font-size: clamp(1.55rem, 2.7vw, 2.9rem);
      line-height: 0.9;
      text-transform: uppercase;
    }

    .suas-scent p {
      margin: 9px 0 0;
      font-size: 10px;
      line-height: 1.35;
      font-weight: 900;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      opacity: 0.72;
    }

    @keyframes suasBoot {
      from { opacity: 0; transform: translateY(20px) scale(0.98); filter: blur(6px); }
      to { opacity: 1; transform: none; filter: blur(0); }
    }

    @keyframes suasPower {
      0% { clip-path: inset(48% 0 48% 0); filter: brightness(2.2) saturate(0.5); }
      60% { clip-path: inset(0); filter: brightness(1.2) saturate(1.2); }
      100% { filter: none; }
    }

    @keyframes suasBob {
      0%, 100% { transform: translateY(0) rotate(-1deg); }
      50% { transform: translateY(-7px) rotate(1deg); }
    }

    @keyframes suasBlink {
      0%, 60% { opacity: 1; }
      65%, 100% { opacity: 0.25; }
    }

    @keyframes suasLed {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

    @media (max-width: 990px) {
      .suas-cyber-body,
      .suas-lab-teaser {
        grid-template-columns: 1fr;
      }

      .suas-launch-panel {
        border-left: 0;
        border-top: 1px solid rgba(16, 16, 16, 0.15);
      }

      .suas-shelf-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .suas-step-row {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .suas-scent-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 620px) {
      .suas-cyber-hero {
        padding-top: 24px;
      }

      .suas-screen {
        min-height: 0;
      }

      .suas-hud,
      .suas-section-head {
        display: block;
      }

      .suas-feature {
        display: block;
      }

      .suas-holo {
        width: 100%;
        max-width: 260px;
        margin-bottom: 18px;
      }

      .suas-launch-grid,
      .suas-step-row {
        grid-template-columns: 1fr;
      }

      .suas-shelf-card {
        min-height: 145px;
      }

      .suas-scent {
        min-height: 112px;
        padding: 18px 8px 14px;
      }

      .suas-scent h3 {
        font-size: clamp(1.04rem, 7vw, 1.7rem);
      }

      .suas-scent p {
        font-size: 8px;
      }
    }
  </style>

  <div class="suas-cyber-hero">
    <div class="suas-home-wrap">
      <div class="suas-cyber-deck">
        <div class="suas-cyber-window">
          <div class="suas-titlebar">
            <div class="suas-dots" aria-hidden="true"><span style="background:#ff5f57;"></span><span style="background:#febc2e;"></span><span style="background:#28c840;"></span></div>
            <div class="suas-titlebar-label suas-mono">SUAS.OS v2.06 / home / fairy hero</div>
            <div class="suas-mono">88%</div>
          </div>

          <div class="suas-cyber-body">
            <div class="suas-screen">
              <div class="suas-screen-inner">
                <div class="suas-hud suas-mono"><span>now_mixing</span><span class="suas-live">live ch.01</span></div>
                <h1 class="suas-font">scent is the<span>accessory.</span></h1>
                <div class="suas-feature">
                  <div class="suas-holo">
                    <img src="{{ 'suas-logo.png' | asset_url }}" alt="SUAS">
                  </div>
                  <div>
                    <div class="suas-product-title suas-font">suas world</div>
                    <div class="suas-mono" style="color:var(--sun); margin-top:8px;">fragrance - self care - little experiments</div>
                    <div class="suas-bars" aria-hidden="true">
                      <div class="suas-bar"><span class="suas-mono">top</span><div class="suas-bar-track"><span style="--w:82%; --c:#ffb4dc;"></span></div></div>
                      <div class="suas-bar"><span class="suas-mono">heart</span><div class="suas-bar-track"><span style="--w:64%; --c:#c9a0ff;"></span></div></div>
                      <div class="suas-bar"><span class="suas-mono">base</span><div class="suas-bar-track"><span style="--w:46%; --c:#6bb6ea;"></span></div></div>
                    </div>
                  </div>
                </div>
                <div class="suas-actions">
                  <a class="suas-btn suas-mono" href="/collections/all">shop product</a>
                  <a class="suas-btn suas-mono" data-dark href="/collections/all">shop the collection</a>
                </div>
              </div>
            </div>

            <aside class="suas-launch-panel">
              <div>
                <div class="suas-mono" style="margin-bottom:10px;">quick_launch</div>
                <div class="suas-launch-grid">
                  <a class="suas-launch" href="/collections/body-care" style="--launch:#ff7eb8; --glow:255,126,184;"><strong class="suas-font">body</strong><span class="suas-mono">launch</span></a>
                  <a class="suas-launch" href="/collections/home-care" style="--launch:#f6e14a; --glow:246,225,74;"><strong class="suas-font">home</strong><span class="suas-mono">launch</span></a>
                  <a class="suas-launch" href="/collections/masculine" style="--launch:#6bb6ea; --glow:107,182,234;"><strong class="suas-font">masculine</strong><span class="suas-mono">launch</span></a>
                  <a class="suas-launch" href="/collections/feminine" style="--launch:#c9a0ff; --glow:201,160,255;"><strong class="suas-font">feminine</strong><span class="suas-mono">launch</span></a>
                </div>
              </div>
              <div class="suas-log">
                <div class="suas-mono" style="color:#c9a0ff;">system_log</div>
                <p>&gt; booting scent.core v2.06 ........ ok</p>
                <p>&gt; loading fairy.dust modules ....... ok</p>
                <p>&gt; mood.analyzer calibrating ......... live</p>
              </div>
              <div>
                <div class="suas-mono" style="margin-bottom:10px;">channels</div>
                <div class="suas-actions" style="margin-top:0;">
                  <a class="suas-btn suas-mono" href="/pages/shut-up-and-smell">the bar</a>
                  <a class="suas-btn suas-mono" href="/pages/reviews">reviews</a>
                  <a class="suas-btn suas-mono" href="/account">account</a>
                </div>
              </div>
            </aside>
          </div>

          <div class="suas-led" aria-hidden="true">
            <div class="suas-led-track suas-mono">
              {% for i in (1..2) %}
                <span>smell rich</span><span>hand-poured chaos</span><span>gastonia nc</span><span>dopamine on tap</span><span>formula 001</span><span>suas.os online</span>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="suas-section">
    <div class="suas-home-wrap">
      <div class="suas-section-head">
        <h2 class="suas-font">shop the shelf.</h2>
      </div>
      <div class="suas-shelf-grid">
        <a class="suas-shelf-card" href="/collections/new-arrivals" style="--hover:rgba(217,255,120,.78);"><span class="suas-font">new arrivals</span></a>
        <a class="suas-shelf-card" href="/collections/best-sellers" style="--hover:rgba(255,232,239,.84);"><span class="suas-font">best sellers</span></a>
        <a class="suas-shelf-card" href="/collections/home-care" style="--hover:rgba(157,215,255,.76);"><span class="suas-font">home</span></a>
        <a class="suas-shelf-card" href="/collections/body-care" style="--hover:rgba(255,159,194,.72);"><span class="suas-font">body</span></a>
        <a class="suas-shelf-card" href="/collections/oddities" style="--hover:rgba(199,181,255,.76);"><span class="suas-font">oddities</span></a>
      </div>
    </div>
  </div>

  <div class="suas-section" data-white>
    <div class="suas-home-wrap">
      <div class="suas-lab-teaser">
        <div class="suas-lab-copy">
          <div class="suas-mono">the lab - experiment 001</div>
          <h2 class="suas-font">mix your own signature scent.</h2>
          <p class="suas-font">Pick your session, choose your notes, name it, label it, and leave with something custom made by you.</p>
          <div class="suas-step-row">
            <div class="suas-step"><b class="suas-mono">step 01</b><span class="suas-font">choose size</span></div>

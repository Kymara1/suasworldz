<section class="suas-world-home" aria-label="SUAS World home">
  <style>
    @font-face {
      font-family: 'Casual Human';
      src: url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');
      font-display: swap;
    }

    @font-face {
      font-family: 'Casual Human';
      src: url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');
      font-weight: 700;
      font-display: swap;
    }

    .suas-world-home {
      --ink: #101010;
      --cream: #f8f7f4;
      --world: #f6f7fa;
      --pink: #ff9bc4;
      --soft-pink: #ffd8e8;
      --blue: #9dd7ff;
      --lav: #c7b5ff;
      --sun: #ffe86b;
      --lime: #c6f76a;
      color: var(--ink);
      background: var(--world);
      font-family: Futura, 'Futura PT', Arial, sans-serif;
      overflow: hidden;
    }

    .suas-world-home * { box-sizing: border-box; }

    .suas-font {
      font-family: 'Casual Human', Futura, Arial, sans-serif !important;
      font-weight: 400;
      letter-spacing: 0;
    }

    .suas-mono {
      font-family: Futura, 'Futura PT', Arial, sans-serif;
      font-size: 10px;
      letter-spacing: 0.28em;
      text-transform: uppercase;
    }

    .suas-home-wrap {
      width: min(1280px, calc(100vw - 28px));
      margin: 0 auto;
    }

    .suas-cyber-hero {
      position: relative;
      padding: clamp(34px, 6vw, 76px) 0 clamp(54px, 8vw, 96px);
      background:
        radial-gradient(720px 420px at 10% 20%, rgba(255, 126, 184, 0.22), transparent 62%),
        radial-gradient(660px 410px at 90% 78%, rgba(157, 215, 255, 0.24), transparent 62%),
        radial-gradient(520px 320px at 50% 100%, rgba(199, 181, 255, 0.2), transparent 62%),
        var(--cream);
    }

    .suas-cyber-deck {
      position: relative;
      border-radius: 30px;
      padding: 3px;
      background: linear-gradient(145deg, #fff 0%, #d7dbe3 25%, #f6f7fa 45%, #b8bdc6 70%, #fff 100%);
      box-shadow: 0 30px 60px -20px rgba(16, 16, 16, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.9);
      animation: suasBoot 0.8s ease-out both;
    }

    .suas-cyber-window {
      border-radius: 27px;
      overflow: hidden;
      background: linear-gradient(180deg, #f6f7fa 0%, #e5e8ee 100%);
    }

    .suas-titlebar {
      min-height: 44px;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 16px;
      border-bottom: 1px solid rgba(16, 16, 16, 0.15);
      background: linear-gradient(180deg, #fff 0%, #e9ecf1 62%, #d0d4dc 100%);
    }

    .suas-dots {
      display: flex;
      gap: 6px;
    }

    .suas-dots span {
      width: 12px;
      height: 12px;
      border-radius: 999px;
      box-shadow: inset 0 -1px 0 rgba(0, 0, 0, 0.25);
    }

    .suas-titlebar-label {
      flex: 1;
      text-align: center;
      color: rgba(16, 16, 16, 0.66);
    }

    .suas-cyber-body {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.95fr);
    }

    .suas-screen {
      position: relative;
      min-height: 540px;
      padding: clamp(24px, 4vw, 44px);
      overflow: hidden;
      color: #fff;
      background: radial-gradient(120% 92% at 30% 20%, #1a1533 0%, #0d0b1a 60%, #05040c 100%);
      animation: suasPower 0.9s ease-out both;
    }

    .suas-screen:before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: radial-gradient(rgba(201, 160, 255, 0.34) 1px, transparent 1px);
      background-size: 22px 22px;
      mask-image: radial-gradient(ellipse at 50% 50%, #000 40%, transparent 92%);
      pointer-events: none;
    }

    .suas-screen:after {
      content: "";
      position: absolute;
      inset: 0;
      background-image: repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.15) 0 1px, transparent 1px 3px);
      box-shadow: inset 0 0 120px rgba(0, 0, 0, 0.7);
      pointer-events: none;
    }

    .suas-screen-inner {
      position: relative;
      z-index: 1;
    }

    .suas-hud {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 30px;
      color: var(--lav);
    }

    .suas-live {
      color: var(--blue);
    }

    .suas-live:before {
      content: "";
      display: inline-block;
      width: 7px;
      height: 7px;
      margin-right: 8px;
      border-radius: 999px;
      background: #28c840;
      animation: suasBlink 1.4s steps(2, end) infinite;
    }

    .suas-screen h1 {
      margin: 0;
      font-size: clamp(3.1rem, 8vw, 7.5rem);
      line-height: 0.88;
      text-transform: lowercase;
      color: #fff;
    }

    .suas-screen h1 span {
      display: block;
      background: linear-gradient(120deg, #ffb4dc 0%, #c9a0ff 46%, #6bb6ea 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .suas-product-rotator {
      position: relative;
      min-height: 420px;
      isolation: isolate;
    }

    .suas-product-rotator:before {
      content: "";
      position: absolute;
      inset: 6% 4% auto auto;
      width: 220px;
      aspect-ratio: 1;
      border-radius: 999px;
      background: rgba(255, 180, 220, 0.18);
      filter: blur(2px);
      z-index: -1;
    }

    .suas-product-slide {
      position: absolute;
      inset: 0;
      display: grid;
      grid-template-columns: minmax(190px, 0.76fr) minmax(0, 1fr);
      align-items: center;
      gap: clamp(18px, 4vw, 34px);
      color: #fff;
      text-decoration: none;
      opacity: 0;
      transform: translateY(18px) scale(0.98);
      pointer-events: none;
      animation: suasProductSpin var(--duration, 20s) ease-in-out infinite;
      animation-delay: var(--delay, 0s);
    }

    .suas-product-slide:first-child {
      position: relative;
    }

    .suas-product-slide.is-static,
    .suas-product-rotator[data-count="1"] .suas-product-slide {
      opacity: 1;
      transform: none;
      animation: none;
      pointer-events: auto;
    }

    .suas-product-rotator[data-count="2"] .suas-product-slide,
    .suas-product-rotator[data-count="3"] .suas-product-slide,
    .suas-product-rotator[data-count="4"] .suas-product-slide,
    .suas-product-rotator[data-count="5"] .suas-product-slide,
    .suas-product-rotator[data-count="6"] .suas-product-slide {
      pointer-events: auto;
    }

    .suas-product-photo {
      width: min(100%, 310px);
      aspect-ratio: 1;
      display: grid;
      place-items: center;
      border: 2px solid rgba(255, 255, 255, 0.46);
      border-radius: 30px;
      background:
        radial-gradient(circle at 35% 26%, rgba(255, 255, 255, 0.34), transparent 34%),
        linear-gradient(135deg, rgba(255, 155, 196, 0.58), rgba(199, 181, 255, 0.28));
      box-shadow: 0 18px 46px rgba(0, 0, 0, 0.3), inset 0 0 44px rgba(255, 255, 255, 0.12);
      overflow: hidden;
    }

    .suas-product-photo img {
      width: 88%;
      height: 88%;
      object-fit: contain;
      filter: drop-shadow(0 18px 24px rgba(0, 0, 0, 0.34));
      animation: suasBob 5s ease-in-out infinite;
    }

    .suas-product-fallback {
      width: 72%;
      aspect-ratio: 1;
      display: grid;
      place-items: center;
      border-radius: 999px;
      background: #fff;
      color: var(--ink);
      font-size: clamp(4rem, 10vw, 6.5rem);
      line-height: 1;
      box-shadow: 0 10px 0 rgba(0, 0, 0, 0.25);
    }

    .suas-product-copy {
      min-width: 0;
    }

    .suas-product-kicker {
      color: var(--sun);
      margin-bottom: 12px;
    }

    .suas-product-title {
      min-width: 0;
      font-size: clamp(3rem, 6.8vw, 6.6rem);
      line-height: 0.82;
      text-transform: lowercase;
      color: #fff;
    }

    .suas-product-price {
      display: inline-flex;
      align-items: center;
      min-height: 36px;
      margin-top: 16px;
      border: 1px solid rgba(255, 255, 255, 0.44);
      border-radius: 999px;
      padding: 8px 13px;
      color: var(--ink);
      background: #fff;
      box-shadow: 0 0 22px rgba(255, 180, 220, 0.34);
      font-weight: 900;
    }

    .suas-product-review {
      max-width: 430px;
      margin: 18px 0 0;
      color: rgba(255, 255, 255, 0.78);
      font-size: clamp(1.05rem, 2vw, 1.35rem);
      line-height: 1.32;
      text-transform: lowercase;
    }

    .suas-product-review b {
      color: #fff;
    }

    .suas-bars {
      width: min(260px, 100%);
      margin-top: 18px;
      display: grid;
      gap: 9px;
    }

    .suas-bar {
      display: grid;
      grid-template-columns: 54px 1fr;
      align-items: center;
      gap: 9px;
    }

    .suas-bar-track {
      height: 7px;
      overflow: hidden;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.1);
    }

    .suas-bar-track span {
      display: block;
      height: 100%;
      width: var(--w);
      border-radius: 999px;
      background: var(--c);
      box-shadow: 0 0 10px var(--c);
    }

    .suas-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 32px;
    }

    .suas-btn {
      min-height: 46px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(16, 16, 16, 0.16);
      border-radius: 999px;
      padding: 12px 18px;
      color: var(--ink);
      background: linear-gradient(180deg, #fff 0%, #ffd9ea 100%);
      box-shadow: 0 8px 18px -6px rgba(255, 126, 184, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.9);
      text-decoration: none;
      font-weight: 900;
    }

    .suas-btn[data-dark] {
      color: #fff;
      background: linear-gradient(180deg, #3a2a66 0%, #1c1338 100%);
      box-shadow: 0 0 0 1px rgba(201, 160, 255, 0.4), 0 0 18px -4px rgba(201, 160, 255, 0.55);
    }

    .suas-launch-panel {
      padding: clamp(20px, 3vw, 30px);
      display: flex;
      flex-direction: column;
      gap: 22px;
      border-left: 1px solid rgba(16, 16, 16, 0.15);
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.88) 0%, rgba(255, 236, 244, 0.62) 100%);
    }

    .suas-launch-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .suas-launch {
      position: relative;
      min-height: 92px;
      border-radius: 22px;
      padding: 16px;
      color: var(--ink);
      text-decoration: none;
      background: linear-gradient(180deg, #fff 0%, var(--launch) 140%);
      box-shadow: 0 0 0 1px rgba(16, 16, 16, 0.12), 0 6px 14px -4px rgba(var(--glow), 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.9);
      transition: transform 170ms ease;
    }

    .suas-launch:hover {
      color: var(--ink);
      transform: translateY(-2px) rotate(-1deg);
    }

    .suas-launch strong {
      display: block;
      font-size: 1.8rem;
      line-height: 0.9;
      text-transform: lowercase;
    }

    .suas-log {
      border-radius: 18px;
      padding: 16px;
      color: #a8ffb8;
      background: #0d0b1a;
      box-shadow: inset 0 0 0 1px rgba(201, 160, 255, 0.25);
    }

    .suas-log p {
      margin: 5px 0;
      font-family: ui-monospace, Consolas, monospace;
      font-size: 11px;
      line-height: 1.5;
    }

    .suas-led {
      position: relative;
      overflow: hidden;
      border-top: 1px solid rgba(16, 16, 16, 0.15);
      background: linear-gradient(180deg, #0d0b1a 0%, #1a1533 100%);
    }

    .suas-led-track {
      display: inline-flex;
      white-space: nowrap;
      animation: suasLed 32s linear infinite;
    }

    .suas-led-track span {
      padding: 12px 20px;
      color: var(--blue);
    }

    .suas-section {
      position: relative;
      padding: clamp(52px, 8vw, 102px) 0;
      background: var(--cream);
    }

    .suas-section[data-white] {
      background: #fff;
    }

    .suas-section:before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: linear-gradient(rgba(16, 16, 16, 0.045) 1px, transparent 1px), linear-gradient(90deg, rgba(16, 16, 16, 0.045) 1px, transparent 1px);
      background-size: 50px 50px;
      pointer-events: none;
    }

    .suas-section > .suas-home-wrap {
      position: relative;
      z-index: 1;
    }

    .suas-section-head {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 24px;
      margin-bottom: 26px;
    }

    .suas-section-head h2 {
      margin: 0;
      font-size: clamp(3.4rem, 8vw, 7rem);
      line-height: 0.85;
      text-transform: lowercase;
    }

    .suas-shelf-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(138px, 1fr));
      gap: 14px;
    }

    .suas-shelf-card {
      min-height: 190px;
      overflow: hidden;
      display: grid;
      place-items: center;
      border: 2px solid var(--ink);
      border-radius: 22px;
      color: #fff;
      background: var(--ink);
      box-shadow: 0 8px 0 var(--ink);
      text-align: center;
      text-decoration: none;
      transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease, color 160ms ease;
    }

    .suas-shelf-card:hover {
      color: var(--ink);
      background: var(--hover);
      transform: translateY(3px) rotate(-0.8deg);
      box-shadow: 0 5px 0 var(--ink);
    }

    .suas-shelf-card span {
      display: block;
      width: 100%;
      max-width: 100%;
      padding: 16px 12px;
      font-size: clamp(1.75rem, 2.55vw, 3.05rem);
      line-height: 0.86;
      text-transform: uppercase;
      overflow-wrap: break-word;
      word-break: normal;
    }

    .suas-lab-teaser {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(320px, 0.8fr);
      gap: 18px;
      align-items: stretch;
    }

    .suas-lab-copy,
    .suas-hours {
      border: 2px solid var(--ink);
      border-radius: 28px;
      padding: clamp(24px, 4vw, 44px);
      background: rgba(255, 255, 255, 0.72);
      box-shadow: 0 7px 0 var(--ink);
    }

    .suas-lab-copy h2 {
      margin: 0;
      font-size: clamp(3.6rem, 8vw, 7rem);
      line-height: 0.84;
      text-transform: lowercase;
    }

    .suas-lab-copy p {
      max-width: 720px;
      margin: 22px 0 0;
      font-size: clamp(1.15rem, 2.2vw, 1.8rem);
      line-height: 1.18;
      text-transform: lowercase;
      color: rgba(16, 16, 16, 0.62);
    }

    .suas-step-row {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
      margin-top: 30px;
    }

    .suas-step {
      min-height: 122px;
      border: 1px solid rgba(16, 16, 16, 0.12);
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.74);
      padding: 18px;
    }

    .suas-step b {
      display: block;
      margin-bottom: 22px;
      color: rgba(16, 16, 16, 0.45);
    }

    .suas-step span {
      display: block;
      font-size: 1.45rem;
      line-height: 1;
      text-transform: uppercase;
    }

    .suas-scent-grid {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 10px;
    }

    .suas-scent {
      min-height: 165px;
      display: flex;
      flex-direction: column;
      justify-content: end;
      align-items: center;
      border: 2px solid var(--ink);
      border-radius: 999px 999px 5px 5px;
      padding: 22px 12px 18px;
      color: var(--ink);
      background: #f2f3f5;
      box-shadow: 0 7px 0 var(--ink);
      text-align: center;
      text-decoration: none;
      transition: transform 160ms ease, box-shadow 160ms ease;
    }

    .suas-scent:hover {
      color: var(--ink);
      transform: translateY(3px);
      box-shadow: 0 4px 0 var(--ink);
    }

    .suas-scent h3 {
      margin: 0;
      font-size: clamp(1.55rem, 2.7vw, 2.9rem);
      line-height: 0.9;
      text-transform: uppercase;
    }

    .suas-scent p {
      margin: 9px 0 0;
      font-size: 10px;
      line-height: 1.35;
      font-weight: 900;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      opacity: 0.72;
    }

    @keyframes suasProductSpin {
      0%, 7% { opacity: 0; transform: translateY(18px) scale(0.98); }
      11%, 28% { opacity: 1; transform: translateY(0) scale(1); }
      34%, 100% { opacity: 0; transform: translateY(-18px) scale(0.985); }
    }

    @keyframes suasBoot {
      from { opacity: 0; transform: translateY(20px) scale(0.98); filter: blur(6px); }
      to { opacity: 1; transform: none; filter: blur(0); }
    }

    @keyframes suasPower {
      0% { clip-path: inset(48% 0 48% 0); filter: brightness(2.2) saturate(0.5); }
      60% { clip-path: inset(0); filter: brightness(1.2) saturate(1.2); }
      100% { filter: none; }
    }

    @keyframes suasBob {
      0%, 100% { transform: translateY(0) rotate(-1deg); }
      50% { transform: translateY(-7px) rotate(1deg); }
    }

    @keyframes suasBlink {
      0%, 60% { opacity: 1; }
      65%, 100% { opacity: 0.25; }
    }

    @keyframes suasLed {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

    @media (max-width: 990px) {
      .suas-cyber-body,
      .suas-lab-teaser {
        grid-template-columns: 1fr;
      }

      .suas-launch-panel {
        border-left: 0;
        border-top: 1px solid rgba(16, 16, 16, 0.15);
      }

      .suas-shelf-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .suas-step-row {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .suas-scent-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 620px) {
      .suas-cyber-hero {
        padding-top: 24px;
      }

      .suas-screen {
        min-height: 0;
        padding: 18px;
      }

      .suas-hud,
      .suas-section-head {
        display: block;
      }

      .suas-hud {
        margin-bottom: 14px;
      }

      .suas-product-rotator {
        min-height: 342px;
      }

      .suas-product-slide {
        grid-template-columns: 1fr;
        align-content: start;
        gap: 12px;
      }

      .suas-product-photo {
        width: min(68vw, 188px);
        border-radius: 22px;
      }

      .suas-product-copy {
        padding: 14px !important;
        border-radius: 20px !important;
        gap: 8px !important;
      }

      .suas-product-title {
        font-size: clamp(2rem, 11vw, 3.2rem);
      }

      .suas-product-price {
        min-height: 30px;
        margin-top: 4px;
        padding: 7px 10px;
      }

      .suas-bars {
        display: none;
      }

      .suas-launch-grid,
      .suas-step-row {
        grid-template-columns: 1fr;
      }

      .suas-shelf-card {
        min-height: 145px;
      }

      .suas-shelf-card span {
        font-size: clamp(1.45rem, 9vw, 2.45rem);
        padding: 12px 8px;
      }

      .suas-scent {
        min-height: 112px;
        padding: 18px 8px 14px;
      }

      .suas-scent h3 {
        font-size: clamp(1.04rem, 7vw, 1.7rem);
      }

      .suas-scent p {
        font-size: 8px;
      }
    }
  </style>

  {% liquid
    assign butter_collection = collections['butter-creme']
    if butter_collection == blank or butter_collection.products_count == 0
      assign butter_collection = collections['women-s-butter-creme']
    endif
    if butter_collection == blank or butter_collection.products_count == 0
      assign butter_collection = collections['m-butter-creme']
    endif
    if butter_collection == blank or butter_collection.products_count == 0
      assign butter_collection = collections['whipped-body-butter']
    endif
    assign butter_count = butter_collection.products_count | default: 0
    if butter_count > 6
      assign butter_count = 6
    endif
  %}

  <div class="suas-cyber-hero">
    <div class="suas-home-wrap">
      <div class="suas-cyber-deck">
        <div class="suas-cyber-window">
          <div class="suas-titlebar">
            <div class="suas-dots" aria-hidden="true"><span style="background:#ff5f57;"></span><span style="background:#febc2e;"></span><span style="background:#28c840;"></span></div>
            <div class="suas-titlebar-label suas-mono">SUAS.OS v2.06 / home / fairy hero</div>
            <div class="suas-mono">88%</div>
          </div>

          <div class="suas-cyber-body">
            <div class="suas-screen">
              <div class="suas-screen-inner">
                <div class="suas-hud suas-mono"><span>now_mixing</span><span class="suas-live">live butter.creme</span></div>

                <div class="suas-product-rotator" data-count="{{ butter_count }}">
                  {% if butter_collection != blank and butter_collection.products_count > 0 %}
                    {% for product in butter_collection.products limit: 6 %}
                      <a class="suas-product-slide" href="{{ product.url }}" style="--duration: {{ butter_count | times: 4 }}s; --delay: {{ forloop.index0 | times: 4 }}s;">
                        <div class="suas-product-photo">
                          {% if product.featured_image %}
                            {{ product.featured_image | image_url: width: 620 | image_tag: loading: 'eager', alt: product.title }}
                          {% else %}
                            <div class="suas-product-fallback suas-font">s.</div>
                          {% endif %}
                        </div>
                        <div class="suas-product-copy">
                          <div class="suas-product-kicker suas-mono">butter creme review</div>
                          <div class="suas-product-title suas-font">{{ product.title }}</div>

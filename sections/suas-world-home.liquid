<section class="suas-world-home" aria-label="SUAS World home">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}@font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}
    .suas-world-home{--ink:#101010;--cream:#fbfaf7;--pink:#ffd8e8;--hot:#ff9bc4;--blue:#cdeeff;--lime:#d9ff78;--lav:#e4d5ff;--sun:#fff1a8;color:var(--ink);background:linear-gradient(rgba(16,16,16,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.035) 1px,transparent 1px),radial-gradient(circle at 8% 14%,rgba(255,216,232,.55),transparent 28%),radial-gradient(circle at 90% 76%,rgba(217,255,120,.28),transparent 30%),var(--cream);background-size:22px 22px,22px 22px,auto,auto,auto;font-family:Futura,'Futura PT',Arial,sans-serif;overflow:hidden}.suas-world-home *{box-sizing:border-box}.suas-font{font-family:'Casual Human',Futura,Arial,sans-serif!important;font-weight:400!important;letter-spacing:0!important}.suas-mono{font-family:Futura,'Futura PT',Arial,sans-serif;font-size:10px;letter-spacing:.24em;text-transform:uppercase;font-weight:900}.suas-home-wrap{width:min(1080px,calc(100vw - 28px));margin:0 auto}.suas-hero{padding:clamp(22px,3.5vw,46px) 0}.suas-hero-grid{display:grid;grid-template-columns:minmax(0,1.02fr) minmax(260px,.58fr);gap:16px;align-items:stretch}.suas-now-card,.suas-launch-panel{border:2px solid var(--ink);border-radius:26px;background:rgba(255,255,255,.88);box-shadow:6px 7px 0 var(--ink);overflow:hidden}.suas-window-bar{display:flex;align-items:center;gap:8px;min-height:38px;padding:8px 14px;border-bottom:1.5px solid rgba(16,16,16,.14);background:linear-gradient(180deg,#fff,#e9edf3)}.suas-dot{width:11px;height:11px;border-radius:999px;background:var(--dot)}.suas-window-title{margin-left:auto;color:rgba(16,16,16,.52)}.suas-product-rotator{position:relative;min-height:286px;padding:16px;isolation:isolate}.suas-product-slide{position:absolute!important;inset:16px!important;display:grid!important;grid-template-columns:minmax(135px,195px) minmax(0,1fr);align-items:center;justify-items:center;gap:clamp(12px,2vw,22px);color:var(--ink);text-decoration:none;opacity:0;pointer-events:none;transform:translateY(10px) scale(.985);transition:opacity 850ms ease,transform 850ms ease}.suas-product-slide:first-child{position:absolute!important;inset:16px!important}.suas-product-slide.is-active,.suas-product-slide.is-static,.suas-product-rotator[data-count='1'] .suas-product-slide{opacity:1;pointer-events:auto;transform:translateY(0) scale(1)}.suas-product-photo{width:min(100%,188px);aspect-ratio:1;display:grid;place-items:center;border:2px solid var(--ink);border-radius:22px;background:linear-gradient(135deg,#fff,var(--pink));box-shadow:5px 6px 0 var(--ink);overflow:hidden}.suas-product-photo img{width:88%;height:88%;object-fit:contain;filter:drop-shadow(0 12px 16px rgba(16,16,16,.15));animation:suasBob 6.4s ease-in-out infinite}.suas-product-fallback{width:70%;aspect-ratio:1;display:grid;place-items:center;border-radius:999px;background:#fff;color:var(--ink);font-size:3.8rem}.suas-world-home .suas-product-kicker{display:none!important}.suas-product-copy{width:min(300px,100%);min-height:142px;display:grid;align-content:center;justify-self:center;border:1.5px solid rgba(16,16,16,.15);border-radius:24px;background:rgba(255,255,255,.9);box-shadow:0 10px 24px rgba(16,16,16,.08);padding:18px 20px}.suas-product-title{font-size:clamp(2rem,3.5vw,3.35rem);line-height:.84;text-transform:lowercase}.suas-product-price{display:inline-flex;width:max-content;min-height:32px;align-items:center;margin-top:12px;padding:8px 12px;border:1.5px solid var(--ink);border-radius:999px;background:#fff;box-shadow:0 3px 0 var(--ink);font-weight:900}.suas-actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:16px}.suas-btn{min-height:40px;display:inline-flex;align-items:center;justify-content:center;border:2px solid var(--ink);border-radius:999px;padding:10px 15px;color:var(--ink);background:#fff;box-shadow:0 4px 0 var(--ink);text-decoration:none;font-weight:900}.suas-btn[data-dark]{color:#fff;background:var(--ink)}.suas-launch-panel{padding:clamp(14px,2vw,20px);display:flex;flex-direction:column;justify-content:center;gap:13px}.suas-launch-title{display:none!important}.suas-launch-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.suas-launch{min-height:70px;display:flex;flex-direction:column;justify-content:center;border:2px solid var(--ink);border-radius:19px;padding:11px;color:var(--ink);background:var(--launch);box-shadow:0 5px 0 var(--ink);text-decoration:none;transition:transform 160ms ease,box-shadow 160ms ease}.suas-launch:hover{color:var(--ink);transform:translateY(2px);box-shadow:0 3px 0 var(--ink)}.suas-launch strong{font-size:1.25rem;line-height:.9;text-transform:lowercase}.suas-led{border-top:1.5px solid rgba(16,16,16,.14);background:#101010;overflow:hidden}.suas-led-track{display:inline-flex;white-space:nowrap;animation:suasLed 34s linear infinite}.suas-led-track span{padding:11px 20px;color:#fff}.suas-section{padding:clamp(36px,5vw,60px) 0;background:rgba(255,255,255,.42)}.suas-section-head{margin-bottom:20px}.suas-section-head h2{margin:0;font-size:clamp(2.65rem,6vw,5.25rem);line-height:.84;text-transform:lowercase}.suas-scent-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px}.suas-scent{position:relative;isolation:isolate;min-height:136px;display:flex;flex-direction:column;justify-content:center;align-items:center;border:2px solid var(--ink);border-radius:58% 42% 52% 48%/46% 58% 42% 54%;padding:22px 12px 18px;color:var(--ink);background:rgba(255,255,255,.74);box-shadow:0 7px 0 var(--ink);text-align:center;text-decoration:none;transition:transform 180ms ease,box-shadow 180ms ease,background 180ms ease}.suas-scent:before,.suas-scent:after{content:'';position:absolute;z-index:-1;border:1.5px solid var(--ink);background:rgba(255,216,232,.2);opacity:.55}.suas-scent:before{inset:9px -7px 13px 8px;border-radius:45% 55% 47% 53%/56% 44% 58% 42%;transform:rotate(-6deg)}.suas-scent:after{inset:-6px 14px 18px -5px;border-radius:60% 40% 62% 38%/42% 60% 40% 58%;transform:rotate(8deg)}.suas-scent:nth-child(2n){border-radius:46% 54% 48% 52%/58% 42% 56% 44%;background:rgba(205,238,255,.52)}.suas-scent:nth-child(3n){background:rgba(255,241,168,.48)}.suas-scent:nth-child(4n){background:rgba(228,213,255,.5)}.suas-scent:hover{color:var(--ink);transform:translateY(3px) rotate(-1deg);box-shadow:0 4px 0 var(--ink);background:rgba(255,216,232,.6)}.suas-scent h3{margin:0;font-size:clamp(1.35rem,2.2vw,2.1rem);line-height:.9;text-transform:uppercase}.suas-scent p{margin:9px 0 0;font-size:9px;line-height:1.35;font-weight:900;letter-spacing:.09em;text-transform:uppercase;opacity:.72}@keyframes suasBob{0%,100%{transform:translateY(0) rotate(-1deg)}50%{transform:translateY(-5px) rotate(1deg)}}@keyframes suasLed{from{transform:translateX(0)}to{transform:translateX(-50%)}}@media(max-width:990px){.suas-home-wrap{width:min(100% - 18px,760px)}.suas-hero-grid{grid-template-columns:minmax(0,1fr) minmax(126px,.42fr);gap:10px}.suas-now-card,.suas-launch-panel{border-radius:20px;box-shadow:4px 5px 0 var(--ink)}.suas-product-rotator{min-height:218px;padding:10px}.suas-product-slide,.suas-product-slide:first-child{inset:10px!important;grid-template-columns:94px minmax(0,1fr);gap:10px}.suas-product-photo{width:94px;border-radius:17px;box-shadow:3px 4px 0 var(--ink)}.suas-product-copy{min-height:116px;padding:12px 13px;border-radius:18px}.suas-product-title{font-size:clamp(1.2rem,4.6vw,2rem)}.suas-product-price{min-height:28px;padding:6px 9px;font-size:7px}.suas-launch-panel{padding:10px;gap:9px}.suas-launch-panel>.suas-actions{display:none}.suas-launch-grid{grid-template-columns:1fr;gap:7px}.suas-launch{min-height:43px;padding:8px;border-radius:14px;box-shadow:0 3px 0 var(--ink)}.suas-launch strong{font-size:clamp(.85rem,3.4vw,1.08rem)}.suas-launch span{display:none}.suas-scent-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:430px){.suas-home-wrap{width:calc(100vw - 12px)}.suas-hero{padding-top:12px}.suas-hero-grid{grid-template-columns:minmax(0,1fr) minmax(105px,.36fr);gap:7px}.suas-product-rotator{min-height:190px}.suas-product-slide,.suas-product-slide:first-child{grid-template-columns:76px minmax(0,1fr);gap:8px}.suas-product-photo{width:76px}.suas-product-copy{min-height:94px;padding:9px 10px}.suas-product-title{font-size:clamp(1rem,5.5vw,1.45rem)}.suas-window-title{font-size:7px;letter-spacing:.14em}.suas-launch-panel{padding:8px}.suas-launch-grid{gap:6px}.suas-launch{min-height:36px;padding:6px 7px;border-radius:12px}.suas-launch strong{font-size:.78rem}.suas-section-head h2{font-size:clamp(2.5rem,14vw,4rem)}.suas-scent-grid{gap:9px}.suas-scent{min-height:104px;padding:16px 7px 12px}.suas-scent h3{font-size:clamp(.95rem,5.4vw,1.35rem)}.suas-scent p{font-size:7px}}
  </style>
  {% liquid
    assign butter_collection = collections['butter-creme']
    if butter_collection == blank or butter_collection.products_count == 0
      assign butter_collection = collections['women-s-butter-creme']
    endif
    if butter_collection == blank or butter_collection.products_count == 0
      assign butter_collection = collections['m-butter-creme']
    endif
    if butter_collection == blank or butter_collection.products_count == 0
      assign butter_collection = collections['whipped-body-butter']
    endif
    assign butter_count = butter_collection.products_count | default: 0
    if butter_count > 6
      assign butter_count = 6
    endif
  %}
  <div class="suas-hero"><div class="suas-home-wrap"><div class="suas-hero-grid"><div class="suas-now-card"><div class="suas-window-bar"><span class="suas-dot" style="--dot:#ff5f57"></span><span class="suas-dot" style="--dot:#febc2e"></span><span class="suas-dot" style="--dot:#28c840"></span><span class="suas-window-title suas-mono">now mixing / product feed</span></div><div class="suas-product-rotator" data-suas-product-rotator data-count="{{ butter_count }}">{% if butter_collection != blank and butter_collection.products_count > 0 %}{% for product in butter_collection.products limit:6 %}<a class="suas-product-slide{% if forloop.first %} is-active{% endif %}" href="{{ product.url }}"><div class="suas-product-photo">{% if product.featured_image %}{{ product.featured_image | image_url: width: 620 | image_tag: loading: 'eager', alt: product.title }}{% else %}<div class="suas-product-fallback suas-font">s.</div>{% endif %}</div><div class="suas-product-copy"><div class="suas-product-kicker suas-mono">tap to shop</div><div class="suas-product-title suas-font">{{ product.title }}</div><div class="suas-product-price suas-mono">{{ product.price | money }}</div></div></a>{% endfor %}{% else %}<a class="suas-product-slide is-static is-active" href="/collections/women-s-butter-creme"><div class="suas-product-photo"><div class="suas-product-fallback suas-font">s.</div></div><div class="suas-product-copy"><div class="suas-product-title suas-font">butter creme</div><div class="suas-product-price suas-mono">shop collection</div></div></a>{% endif %}</div></div><aside class="suas-launch-panel"><div><div class="suas-mono" style="margin-bottom:10px;">quick launch</div><div class="suas-launch-title suas-font">choose your door.</div></div><div class="suas-launch-grid"><a class="suas-launch" href="/collections/new-arrivals" style="--launch:#ffd8e8"><strong class="suas-font">new arrivals</strong><span class="suas-mono">shop</span></a><a class="suas-launch" href="/collections/best-sellers" style="--launch:#d9ff78"><strong class="suas-font">best sellers</strong><span class="suas-mono">shop</span></a><a class="suas-launch" href="/collections/feminine" style="--launch:#e4d5ff"><strong class="suas-font">feminine</strong><span class="suas-mono">shop</span></a><a class="suas-launch" href="/collections/masculine" style="--launch:#cdeeff"><strong class="suas-font">masculine</strong><span class="suas-mono">shop</span></a><a class="suas-launch" href="/collections/oddities" style="--launch:#fff1a8"><strong class="suas-font">oddities</strong><span class="suas-mono">shop</span></a><a class="suas-launch" href="/pages/bookings" style="--launch:#ff9bc4"><strong class="suas-font">book the lab</strong><span class="suas-mono">reserve</span></a></div><div class="suas-actions"><a class="suas-btn suas-mono" data-dark href="/collections/all">shop all</a><a class="suas-btn suas-mono" href="/pages/shut-up-and-smell">the lab</a></div></aside></div></div></div><div class="suas-led" aria-hidden="true"><div class="suas-led-track suas-mono">{% for i in (1..2) %}<span>smell rich</span><span>handmade in gastonia</span><span>dopamine on tap</span><span>formula 001</span><span>shut up & smell</span><span>suas.os online</span>{% endfor %}</div></div><div class="suas-section"><div class="suas-home-wrap"><div class="suas-section-head"><h2 class="suas-font">signature scents.</h2></div><div class="suas-scent-grid"><a class="suas-scent" href="/products/apple-tease"><h3 class="suas-font">nectar</h3><p>passionfruit pineapple juicy</p></a><a class="suas-scent" href="/products/good-girl"><h3 class="suas-font">good girl</h3><p>sweet feminine addictive</p></a><a class="suas-scent" href="/products/shocking-ice"><h3 class="suas-font">tonic</h3><p>fresh citrus minty</p></a><a class="suas-scent" href="/products/milkd"><h3 class="suas-font">haze</h3><p>dreamy soft comforting</p></a><a class="suas-scent" href="/products/brown-suga"><h3 class="suas-font">ember</h3><p>warm vanilla magnetic</p></a><a class="suas-scent" href="/products/plumeria"><h3 class="suas-font">crimson</h3><p>bold sweet tempting</p></a></div></div></div>
  <script>(()=>{document.querySelectorAll('.suas-world-home .suas-launch-grid').forEach(grid=>{const seen=new Set;[...grid.querySelectorAll('a')].forEach(link=>{const href=link.getAttribute('href')||'';if(seen.has(href)){link.remove()}else{seen.add(href)}})});document.querySelectorAll('[data-suas-product-rotator]').forEach(rotator=>{if(rotator.dataset.ready==='true')return;rotator.dataset.ready='true';const slides=[...rotator.querySelectorAll('.suas-product-slide')];if(slides.length<2)return;let active=0;setInterval(()=>{slides[active].classList.remove('is-active');active=(active+1)%slides.length;slides[active].classList.add('is-active')},6600)})})();</script>
</section>
{% schema %}{"name":"SUAS World Home","settings":[],"presets":[{"name":"SUAS World Home"}]}{% endschema %}

<section class="suas-world-home" aria-label="SUAS World home">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}
    .suas-world-home{--ink:#101010;--cream:#fbfaf7;--pink:#ffd8e8;--hot:#ff9bc4;--blue:#cdeeff;--lime:#d9ff78;--lav:#e4d5ff;--sun:#fff1a8;color:var(--ink);background:linear-gradient(rgba(16,16,16,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.035) 1px,transparent 1px),radial-gradient(circle at 8% 14%,rgba(255,216,232,.55),transparent 28%),radial-gradient(circle at 90% 76%,rgba(217,255,120,.28),transparent 30%),var(--cream);background-size:22px 22px,22px 22px,auto,auto,auto;font-family:Futura,'Futura PT',Arial,sans-serif;overflow:visible;padding-top:10px}
    .suas-world-home *{box-sizing:border-box}
    .suas-world-home a{color:inherit}
    .suas-font{font-family:'Casual Human',Futura,Arial,sans-serif!important;font-weight:400!important;letter-spacing:0!important}
    .suas-mono{font-family:Futura,'Futura PT',Arial,sans-serif;font-size:10px;letter-spacing:.22em;text-transform:uppercase;font-weight:900}
    .suas-home-wrap{width:min(1340px,calc(100vw - 24px));margin:0 auto}
    .suas-billboard{display:grid;gap:0;padding:16px 2px 14px;text-align:center;justify-items:center;overflow:visible}
    .suas-home-logo{display:inline-flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;max-width:none;color:inherit;text-decoration:none}
    .suas-home-logo-img{display:block;width:96px;height:96px;max-width:96px;max-height:96px;object-fit:contain;background:#000;border:2px solid var(--ink);border-radius:16px;box-shadow:3px 4px 0 var(--ink)}
    .suas-home-logo-img--season{display:none}
    .suas-home-logo .suas-side-orb,.suas-home-logo-orb{width:clamp(56px,9vw,92px)!important;height:clamp(56px,9vw,92px)!important;flex:0 0 auto;border-radius:999px;background:radial-gradient(circle at 32% 20%,#fff 0 10%,transparent 32%),conic-gradient(from 210deg,#ffd8e8,#c9e7ff,#d8e26a,#ffd8e8);box-shadow:inset 0 -6px 12px rgba(0,0,0,.16),inset 0 6px 12px rgba(255,255,255,.85),0 8px 16px -8px rgba(16,16,16,.35)}
    .suas-home-logo-tag{display:block;margin:0;font:900 10px/1 Futura,'Futura PT',Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;white-space:nowrap;color:var(--ink)}
    .suas-home-logo-type{font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(3.6rem,10vw,6.4rem);font-weight:700;line-height:.8;text-transform:uppercase}
    .suas-aisles{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .suas-aisle{display:flex;flex-direction:column;gap:10px;min-height:0;padding:16px;border:2px solid var(--ink);border-radius:24px;box-shadow:5px 6px 0 var(--ink);overflow:hidden}
    .suas-aisle--body{background:linear-gradient(135deg,#ffd8e8,#fff 62%)}
    .suas-aisle--home{background:linear-gradient(135deg,#cdeeff,#fff1a8 70%)}
    .suas-aisle small{display:block;width:100%;text-align:center!important;font-size:10px;letter-spacing:.2em;text-transform:uppercase;font-weight:900}
    .suas-aisle h3{margin:0 auto;display:block;width:100%;text-align:center!important;font-size:clamp(2.2rem,4.5vw,3.6rem);line-height:.8;text-transform:lowercase}
    .suas-aisle p{margin:0;font-size:13px;font-weight:700;line-height:1.3}
    .suas-aisle-chips{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}
    .suas-aisle-chips a{min-height:34px;min-width:0;width:100%;display:inline-flex;align-items:center;justify-content:center;padding:6px 8px;border:1.75px solid var(--ink);border-radius:999px;background:#fff;box-shadow:0 2px 0 var(--ink);text-decoration:none;text-align:center;font-size:10px;font-weight:900;letter-spacing:.06em;text-transform:uppercase;line-height:1.1;white-space:normal}
    .suas-aisle-chips a:hover{transform:translateY(1px);box-shadow:0 1px 0 var(--ink)}
    .suas-hero-stack{display:grid;gap:18px}
    .suas-mid-row{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(260px,1fr);gap:12px;align-items:start}
    .suas-feed-notes{min-height:0;display:flex;flex-direction:column;gap:0;border:2px solid var(--ink);border-radius:22px;background:linear-gradient(rgba(16,16,16,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.025) 1px,transparent 1px),linear-gradient(135deg,rgba(255,216,232,.52),rgba(255,255,255,.95) 58%,rgba(217,255,120,.36));background-size:18px 18px,18px 18px,auto;box-shadow:5px 6px 0 var(--ink);padding:0;overflow:hidden}
    .suas-feed-announcement{width:100%;min-height:0;flex:1;display:flex;align-items:center;border:1.5px solid var(--ink);border-radius:15px;background:rgba(255,255,255,.9);padding:10px 12px;color:var(--ink);font-size:1.05rem;line-height:1.15}
    .suas-product-buy{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);align-items:stretch;gap:6px;margin-top:0;min-width:0}
    .suas-feed-atc{min-height:32px;width:100%;min-width:0;display:inline-flex;align-items:center;justify-content:center;border:1.75px solid var(--ink);border-radius:999px;padding:6px 8px;color:var(--ink)!important;background:var(--lime)!important;box-shadow:0 2px 0 var(--ink);font-weight:900;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;font-size:8px}
    .suas-feed-atc:hover{color:var(--ink);transform:translateY(2px);box-shadow:0 1px 0 var(--ink)}
    .suas-feed-atc:disabled{opacity:.4;cursor:not-allowed;transform:none;box-shadow:0 3px 0 var(--ink)}
    .suas-now-card,.suas-launch-panel,.suas-boost{border:2px solid var(--ink);border-radius:24px;background:rgba(255,255,255,.93);box-shadow:5px 6px 0 var(--ink);overflow:hidden}
    .suas-window-bar{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px;min-height:42px;padding:8px 14px;border-bottom:2px solid var(--ink);background:linear-gradient(180deg,#fff,#e8edf3);overflow:hidden}
    .suas-window-dots{display:flex;gap:7px;min-width:0}
    .suas-dot{width:11px;height:11px;flex:0 0 auto;border-radius:999px;background:var(--dot)}
    .suas-window-title{text-align:center;font-size:10px;letter-spacing:.2em;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .suas-window-live{display:inline-flex;align-items:center;gap:6px;font-size:9px;font-weight:900;letter-spacing:.16em}
    .suas-window-live b{width:8px;height:8px;border-radius:999px;background:#28c840;box-shadow:0 0 0 4px rgba(40,200,64,.18);animation:suasHomeBlink 1.4s steps(2,end) infinite}
    @keyframes suasHomeBlink{50%{opacity:.35}}
    .suas-feed-notes-body{display:flex;flex:1;flex-direction:column;gap:6px;padding:10px 12px 12px}
    .suas-product-rotator{position:relative;height:auto;min-height:0;padding:16px;overflow:hidden;isolation:isolate}
    .suas-product-slide{position:relative;inset:auto;display:none;grid-template-columns:minmax(0,320px) minmax(0,1fr);align-items:stretch;gap:14px;color:var(--ink);opacity:1;pointer-events:auto;transform:none;animation:none!important;min-width:0}
    .suas-product-slide.is-active,.suas-product-slide.is-static,.suas-product-rotator[data-count='1'] .suas-product-slide{display:grid;opacity:1;pointer-events:auto;transform:none;z-index:2}
    .suas-product-photo{width:100%;max-width:min(320px,42vh);max-height:min(320px,42vh);min-width:0;aspect-ratio:1;display:grid;place-items:center;justify-self:start;align-self:center;border:2px solid var(--ink);border-radius:20px;background:linear-gradient(135deg,#fff,var(--pink));box-shadow:3px 4px 0 var(--ink);overflow:hidden;color:var(--ink);text-decoration:none}
    .suas-product-photo img{width:92%;height:92%;object-fit:contain;filter:drop-shadow(0 8px 10px rgba(16,16,16,.12));animation:suasBob 6.8s ease-in-out infinite}
    .suas-product-fallback{width:72%;aspect-ratio:1;display:grid;place-items:center;border-radius:999px;background:#fff;color:var(--ink);font-size:4rem}
    .suas-world-home .suas-product-kicker{display:none!important}
    .suas-product-copy{width:100%;min-height:0;min-width:0;height:100%;display:grid;align-content:center;gap:8px;border:2px solid var(--ink);border-radius:18px;background:rgba(255,255,255,.95);box-shadow:none;padding:10px 12px;overflow:hidden}
    .suas-product-title{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-width:0;color:var(--ink);text-decoration:none;font-size:clamp(1.15rem,2vw,1.55rem);line-height:.9;text-transform:lowercase}
    .suas-product-title:hover{color:var(--ink)}
    .suas-product-price{display:inline-flex;width:100%;min-width:0;min-height:32px;align-items:center;justify-content:center;margin-top:0;padding:6px 8px;border:1.5px solid var(--ink);border-radius:999px;background:#fff;box-shadow:0 2px 0 var(--ink);font-weight:900;font-size:9px;letter-spacing:.08em}
    .suas-product-actions{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:0;min-width:0}
    .suas-feed-btn{min-height:30px;width:100%;min-width:0;display:inline-flex;align-items:center;justify-content:center;border:1.75px solid var(--ink);border-radius:999px;padding:6px 8px;color:var(--ink);background:var(--feed-btn,#fff);box-shadow:0 2px 0 var(--ink);text-decoration:none;font-weight:900;font-size:8px;letter-spacing:.08em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;transition:transform 160ms ease,box-shadow 160ms ease}
    .suas-feed-btn:hover{color:var(--ink);transform:translateY(2px);box-shadow:0 1px 0 var(--ink)}
    .suas-launch-panel{display:flex;flex-direction:column;justify-content:flex-start;align-self:start;height:auto;min-height:0;width:100%;padding:0;gap:0}
    .suas-launch-panel .suas-window-bar{width:100%;max-width:none;align-self:stretch;overflow:hidden;min-height:42px;padding:8px 14px}
    .suas-launch-panel .suas-window-title{font-size:11px;letter-spacing:.14em;overflow:visible;text-overflow:clip}
    .suas-launch-body{display:flex;flex-direction:column;gap:11px;padding:12px;flex:0 0 auto}
    .suas-launch-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
    .suas-launch-grid .suas-launch:nth-of-type(n+5){display:none!important}
    .suas-launch{min-height:64px;display:flex;flex-direction:column;justify-content:center;border:1.75px solid var(--ink);border-radius:18px;padding:12px;color:var(--ink);background:var(--launch);box-shadow:0 4px 0 var(--ink);text-decoration:none;transition:transform 160ms ease,box-shadow 160ms ease}
    .suas-launch:hover{color:var(--ink);transform:translateY(2px);box-shadow:0 2px 0 var(--ink)}
    .suas-launch strong{font-size:1.13rem;font-weight:700!important;line-height:.9;text-transform:lowercase}
    .suas-launch span{margin-top:4px;font-size:9px;font-weight:900;letter-spacing:.12em}
    .suas-actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:auto}
    .suas-btn{min-height:38px;display:inline-flex;align-items:center;justify-content:center;border:2px solid var(--ink);border-radius:999px;padding:9px 14px;color:var(--ink);background:#fff;box-shadow:0 4px 0 var(--ink);text-decoration:none;font-weight:900}
    .suas-btn[data-dark]{color:#fff;background:var(--ink)}
    .suas-boost-body{display:grid;grid-template-columns:minmax(180px,.7fr) minmax(0,1.3fr);gap:12px;padding:14px}
    .suas-boost-copy{display:flex;flex-direction:column;justify-content:center;gap:8px;padding:10px;border:2px solid var(--ink);border-radius:18px;background:linear-gradient(135deg,var(--lime),#fff 70%)}
    .suas-boost-copy strong{font-size:clamp(1.6rem,3vw,2.3rem);line-height:.86;text-transform:lowercase}
    .suas-boost-copy p{margin:0;font-size:12px;font-weight:700;line-height:1.3}
    .suas-boost-rail{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;align-items:start}
    .suas-boost-card{display:flex;flex-direction:column;gap:8px;min-width:0;height:auto;padding:10px;border:2px solid var(--ink);border-radius:18px;background:#fff;box-shadow:3px 4px 0 var(--ink);text-decoration:none;color:var(--ink)}
    .suas-boost-card img,.suas-boost-fallback{width:100%!important;height:auto!important;max-height:none!important;aspect-ratio:1;object-fit:contain;border:1.5px solid var(--ink);border-radius:14px;background:linear-gradient(135deg,#fff,var(--pink))}
    .suas-boost-card:nth-child(2) img,.suas-boost-card:nth-child(2) .suas-boost-fallback{background:linear-gradient(135deg,#fff,var(--blue))}
    .suas-boost-card:nth-child(3) img,.suas-boost-card:nth-child(3) .suas-boost-fallback{background:linear-gradient(135deg,#fff,var(--sun))}
    .suas-boost-card b{font-size:.92rem;line-height:.95;text-transform:lowercase;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .suas-boost-meta{display:flex;flex-wrap:wrap;align-items:center;gap:6px}
    .suas-sale{display:inline-flex;align-items:center;min-height:22px;padding:3px 8px;border:1.5px solid var(--ink);border-radius:999px;background:var(--hot);font-size:8px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}
    .suas-boost-card s{opacity:.45;font-size:9px}
    .suas-product-slide:nth-child(2) .suas-product-photo{background:linear-gradient(135deg,#fff,var(--blue))}
    .suas-product-slide:nth-child(3) .suas-product-photo{background:linear-gradient(135deg,#fff,var(--sun))}
    .suas-product-slide:nth-child(4) .suas-product-photo{background:linear-gradient(135deg,#fff,var(--lav))}
    .suas-product-slide:nth-child(5) .suas-product-photo{background:linear-gradient(135deg,#fff,var(--lime))}
    .suas-product-slide:nth-child(6) .suas-product-photo{background:linear-gradient(135deg,#fff,var(--hot))}
    @keyframes suasBob{0%,100%{transform:translateY(0) rotate(-1deg)}50%{transform:translateY(-5px) rotate(1deg)}}
    @media(max-width:990px){
      .suas-aisles{grid-template-columns:1fr 1fr;gap:8px}
      .suas-aisle{padding:12px;border-radius:18px}
      .suas-window-title{font-size:9px}
      .suas-product-rotator{height:auto;padding:14px}
      .suas-product-slide{grid-template-columns:minmax(0,228px) minmax(0,1fr);gap:12px}
      .suas-product-photo{max-width:min(228px,38vh);max-height:min(228px,38vh);justify-self:start;align-self:center}
      .suas-product-copy{padding:10px 11px;gap:8px}
      .suas-product-title{font-size:clamp(1.05rem,3vw,1.3rem)}
      .suas-launch{min-height:62px;padding:10px}
      .suas-launch strong{font-size:1.2rem;font-weight:700!important}
      .suas-launch span{display:block;font-size:9px;font-weight:900}
      .suas-boost-body{grid-template-columns:1fr}
      .suas-boost-rail{grid-template-columns:repeat(3,minmax(0,1fr))}
    }
    @media(max-width:560px){
      .suas-aisles{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:6px}
      .suas-aisle{padding:8px 7px 9px;border-radius:14px;gap:6px;box-shadow:3px 4px 0 var(--ink)}
      .suas-aisle small{font-size:7px;letter-spacing:.12em}
      .suas-aisle h3{font-size:clamp(1.35rem,7.5vw,1.85rem)}
      .suas-aisle-chips{gap:5px}
      .suas-aisle-chips a{min-height:26px;padding:4px 5px;font-size:7.5px;letter-spacing:.03em;box-shadow:0 2px 0 var(--ink)}
      .suas-home-logo{max-width:none}
      .suas-home-logo-img{width:84px;height:84px;max-width:84px;max-height:84px;border-radius:999px;box-shadow:2px 3px 0 var(--ink)}
      .suas-home-logo-tag{font-size:8.5px;letter-spacing:.12em}
      .suas-mid-row{grid-template-columns:1fr;gap:8px}
      .suas-window-live{display:none}
      .suas-product-rotator{padding:12px}
      .suas-product-slide{grid-template-columns:minmax(0,186px) minmax(0,1fr);gap:10px}
      .suas-product-photo{max-width:min(186px,36vh);max-height:min(186px,36vh);border-radius:16px}
      .suas-product-copy{padding:10px 11px;gap:8px;border-radius:16px}
      .suas-product-title{font-size:clamp(1rem,4.2vw,1.22rem)}
      .suas-product-buy,.suas-product-actions{margin-top:0;gap:6px}
      .suas-product-price,.suas-feed-atc,.suas-feed-btn{min-height:30px;padding:6px 8px;font-size:8px;letter-spacing:.05em;box-shadow:0 2px 0 var(--ink)}
      .suas-launch span{display:block;font-size:9px;font-weight:900}
      .suas-boost-rail{grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}
      .suas-boost-card{padding:6px;border-radius:14px}
      .suas-boost-card b{font-size:.68rem}
    }
    @media(prefers-reduced-motion:reduce){.suas-product-title,.suas-product-photo img,.suas-window-live b{animation:none!important}}
  </style>
  {% liquid
    assign butter_collection = collections['butter-creme']
    if butter_collection == blank or butter_collection.products_count == 0
      assign butter_collection = collections['women-s-butter-creme']
    endif
    if butter_collection == blank or butter_collection.products_count == 0
      assign butter_collection = collections['m-butter-creme']
    endif
    if butter_collection == blank or butter_collection.products_count == 0
      assign butter_collection = collections['whipped-body-butter']
    endif
    assign butter_count = butter_collection.products_count | default: 0
    if butter_count > 6
      assign butter_count = 6
    endif
    assign home_collection = collections['home-care']
    if home_collection == blank or home_collection.products_count == 0
      assign home_collection = collections['candles']
    endif
    assign boost_collection = collections['best-sellers']
    if boost_collection == blank or boost_collection.products_count == 0
      assign boost_collection = collections['new-arrivals']
    endif
    if boost_collection == blank or boost_collection.products_count == 0
      assign boost_collection = butter_collection
    endif
  %}
  <div class="suas-hero">
    <div class="suas-home-wrap">
      <div class="suas-hero-stack">
        <header class="suas-billboard">
          <a class="suas-home-logo" href="{{ routes.root_url }}" aria-label="SUAS, Shut Up & Smell">
            <img class="suas-home-logo-img suas-home-logo-img--core" src="{{ 'suas-logo.png' | asset_url }}" width="72" height="72" alt="SUAS">
            <img class="suas-home-logo-img suas-home-logo-img--season" src="{{ 'suas-logo-halloween.png' | asset_url }}" width="72" height="72" alt="">
            <span class="suas-home-logo-tag">shut up &amp; smell</span>
          </a>
        </header>
        <div class="suas-aisles">
          <article class="suas-aisle suas-aisle--body">
            <small class="suas-mono">aisle 01</small>
            <h3 class="suas-font">body</h3>
            <div class="suas-aisle-chips">
              <a href="/collections/butter-creme">Butter Creme</a>
              <a href="/collections/body-wash">Body Wash</a>
              <a href="/collections/body-oil">Body Oil</a>
              <a href="/collections/cleansing-bar">Cleansing Bar</a>
              <a href="/collections/body-scrub">Body Scrub</a>
              <a href="/collections/eau-de-parfum">Perfume</a>
              <a href="/collections/body-jelly">Skin Jelly</a>
              <a href="/collections/body-care">Shop body</a>
            </div>
          </article>
          <article class="suas-aisle suas-aisle--home">
            <small class="suas-mono">aisle 02</small>
            <h3 class="suas-font">home</h3>
            <div class="suas-aisle-chips">
              <a href="/collections/candles">Candles</a>
              <a href="/collections/everything-mist">Everything Mist</a>
              <a href="/collections/burnt-oils">Burnt Oils</a>
              <a href="/collections/carpet-dust">Carpet Dust</a>
              <a href="/collections/all-purpose-cleaner">All Purpose Cleaner</a>
              <a href="/collections/home-care">Shop home</a>
            </div>
          </article>
        </div>
        <div class="suas-mid-row">
        <div class="suas-now-card">
          <div class="suas-window-bar">
            <div class="suas-window-dots">
              <span class="suas-dot" style="--dot:#ff5f57"></span>
              <span class="suas-dot" style="--dot:#febc2e"></span>
              <span class="suas-dot" style="--dot:#28c840"></span>
            </div>
            <span class="suas-window-title suas-mono">PRODUCT.FEED</span>
            <span class="suas-window-live suas-mono"><b></b>LIVE</span>
          </div>
          <div class="suas-product-rotator" data-suas-product-rotator data-count="{{ butter_count }}">
            {% if butter_collection != blank and butter_collection.products_count > 0 %}
              {% for product in butter_collection.products limit: 3 %}
                <div class="suas-product-slide{% if forloop.first %} is-active{% endif %}">
                  <a class="suas-product-photo" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
                    {% if product.featured_image %}
                      {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'eager', alt: product.title }}
                    {% else %}
                      <div class="suas-product-fallback suas-font">s.</div>
                    {% endif %}
                  </a>
                  <div class="suas-product-copy">
                    <a class="suas-product-title suas-font" href="{{ product.url }}">{{ product.title }}</a>
                    {% render 'product-rating', product: product, link: true %}
                    <div class="suas-product-buy">
                      <div class="suas-product-price suas-mono">{{ product.price | money }}</div>
                      <button type="button" class="suas-feed-atc suas-mono" data-suas-atc="{{ product.selected_or_first_available_variant.id }}"{% unless product.available %} disabled{% endunless %}>add</button>
                    </div>
                  </div>
                </div>
              {% endfor %}
              {% if home_collection != blank and home_collection.products_count > 0 %}
                {% for product in home_collection.products limit: 3 %}
                  <div class="suas-product-slide">
                    <a class="suas-product-photo" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
                      {% if product.featured_image %}
                        {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}
                      {% else %}
                        <div class="suas-product-fallback suas-font">s.</div>
                      {% endif %}
                    </a>
                    <div class="suas-product-copy">
                      <a class="suas-product-title suas-font" href="{{ product.url }}">{{ product.title }}</a>
                      {% render 'product-rating', product: product, link: true %}
                      <div class="suas-product-buy">
                        <div class="suas-product-price suas-mono">{{ product.price | money }}</div>
                        <button type="button" class="suas-feed-atc suas-mono" data-suas-atc="{{ product.selected_or_first_available_variant.id }}"{% unless product.available %} disabled{% endunless %}>add</button>
                      </div>
                    </div>
                  </div>
                {% endfor %}
              {% endif %}
            {% else %}
              <div class="suas-product-slide is-static is-active">
                <a class="suas-product-photo" href="/collections/butter-creme"><div class="suas-product-fallback suas-font">s.</div></a>
                <div class="suas-product-copy">
                  <a class="suas-product-title suas-font" href="/collections/butter-creme">butter creme</a>
                  <div class="suas-product-buy">
                    <div class="suas-product-price suas-mono">shop</div>
                  </div>
                </div>
              </div>
            {% endif %}
          </div>
        </div>

        <div class="suas-launch-panel">
          <div class="suas-window-bar">
            <div class="suas-window-dots">
              <span class="suas-dot" style="--dot:#ff5f57"></span>
              <span class="suas-dot" style="--dot:#febc2e"></span>
              <span class="suas-dot" style="--dot:#28c840"></span>
            </div>
            <span class="suas-window-title suas-mono">QUICK.LAUNCH</span>
            <span class="suas-window-live suas-mono"><b></b>GO</span>
          </div>
          <div class="suas-launch-body">
            <div class="suas-launch-grid" data-suas-fixed-launch="true">
              <a class="suas-launch" href="/pages/bookings" style="--launch:#ff9bc4">
                <strong class="suas-font">book the lab</strong>
                <span class="suas-mono">reserve</span>
              </a>
              <a class="suas-launch" href="/collections/new-arrivals" style="--launch:#d9ff78">
                <strong class="suas-font">new arrivals</strong>
                <span class="suas-mono">shop</span>
              </a>
              <a class="suas-launch" href="/pages/reviews" style="--launch:#fff1a8">
                <strong class="suas-font">reviews</strong>
                <span class="suas-mono">read</span>
              </a>
              <a class="suas-launch" href="/account" style="--launch:#e4d5ff">
                <strong class="suas-font">account</strong>
                <span class="suas-mono">you</span>
              </a>
            </div>
          </div>
        </div>
        </div>

        <div class="suas-boost">
          <div class="suas-window-bar">
            <div class="suas-window-dots">
              <span class="suas-dot" style="--dot:#ff5f57"></span>
              <span class="suas-dot" style="--dot:#febc2e"></span>
              <span class="suas-dot" style="--dot:#28c840"></span>
            </div>
            <span class="suas-window-title suas-mono">HOT.NOW / best sellers</span>
            <span class="suas-window-live suas-mono"><b></b>MOVE</span>
          </div>
          <div class="suas-boost-body">
            <div class="suas-boost-copy">
              <strong class="suas-font">grab it while it lasts.</strong>
              <a class="suas-btn suas-mono" data-dark href="/collections/best-sellers">shop best sellers</a>
            </div>
            <div class="suas-boost-rail">
              {% if boost_collection != blank %}
                {% for product in boost_collection.products limit: 3 %}
                  <a class="suas-boost-card" href="{{ product.url }}">
                    {% if product.featured_image %}
                      {{ product.featured_image | image_url: width: 480 | image_tag: loading: 'lazy', alt: product.title }}
                    {% else %}
                      <div class="suas-boost-fallback"></div>
                    {% endif %}
                    <b class="suas-font">{{ product.title }}</b>
                    {% render 'product-rating', product: product %}
                    <div class="suas-boost-meta">
                      {% if product.compare_at_price > product.price %}
                        <span class="suas-sale">sale</span>
                        <s class="suas-mono">{{ product.compare_at_price | money }}</s>
                      {% endif %}
                      <span class="suas-mono">{{ product.price | money }}</span>
                    </div>
                  </a>
                {% endfor %}
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script>(()=>{function wireFeedLinks(){document.querySelectorAll('.suas-world-home .suas-feed-btn').forEach(link=>{if(link.dataset.suasTapReady==='true')return;link.dataset.suasTapReady='true';link.addEventListener('click',event=>{const href=link.getAttribute('href')||'';if(href.charAt(0)!=='#')return;event.preventDefault();const target=document.querySelector(href);if(target){target.scrollIntoView({behavior:'smooth',block:'start'});history.replaceState(null,'',href)}})})}wireFeedLinks();function wireFeedCart(){document.querySelectorAll('.suas-world-home [data-suas-atc]').forEach(button=>{if(button.dataset.suasAtcReady==='true')return;button.dataset.suasAtcReady='true';button.addEventListener('click',event=>{event.preventDefault();event.stopPropagation();if(button.disabled)return;const id=Number(button.getAttribute('data-suas-atc'));if(!id)return;const original=button.textContent;button.disabled=true;button.textContent='adding';fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},credentials:'same-origin',body:JSON.stringify({id,quantity:1})}).then(response=>{if(!response.ok)throw new Error('cart');return response.json()}).then(()=>fetch('/cart.js',{credentials:'same-origin'})).then(response=>response.json()).then(cart=>{document.querySelectorAll('[data-suas-cart-count]').forEach(node=>{node.textContent=cart.item_count});button.textContent='added';setTimeout(()=>{button.disabled=false;button.textContent=original},1200)}).catch(()=>{button.disabled=false;button.textContent='try again';setTimeout(()=>{button.textContent=original},1400)})})})}wireFeedCart();function launchKey(link){const title=(link.querySelector('strong')?.textContent||link.textContent||'').trim().toLowerCase().replace(/\s+/g,' ');return title.replace(/\b(shop|launch|reserve)\b/g,'').trim()||((link.getAttribute('href')||'').replace(/\?.*$/,''))}function dedupeLaunch(){document.querySelectorAll('.suas-world-home .suas-launch-grid').forEach(grid=>{if(grid.getAttribute('data-suas-fixed-launch')==='true'){;[...grid.querySelectorAll('a.suas-launch')].slice(4).forEach(link=>link.remove());return}const seen=new Set;[...grid.querySelectorAll('a')].forEach(link=>{const key=launchKey(link);if(seen.has(key)||seen.size>=4){link.remove()}else{seen.add(key)}})})}dedupeLaunch();[80,250,700,1500].forEach(t=>setTimeout(dedupeLaunch,t));document.querySelectorAll('[data-suas-product-rotator]').forEach(rotator=>{if(rotator.dataset.ready==='true')return;rotator.dataset.ready='true';const slides=[...rotator.querySelectorAll('.suas-product-slide')];if(slides.length<2)return;let active=0;setInterval(()=>{slides[active].classList.remove('is-active');active=(active+1)%slides.length;slides[active].classList.add('is-active')},7600)})})();</script>
</section>

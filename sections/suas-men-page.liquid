<section class="suas-men-collection" aria-label="{{ page.title | escape }}">
  {% render 'suas-men-chrome' %}
  <style>
    .suas-men-collection{display:grid;place-items:start center;color:#fff;background:linear-gradient(rgba(255,255,255,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.08) 1px,transparent 1px),#000;background-size:22px 22px,22px 22px,auto;font-family:Futura,'Futura PT',Arial,sans-serif;padding:24px 16px 40px;min-height:calc(100vh - 36px)}
    .suas-men-collection *{box-sizing:border-box}
    .suas-men-collection a{color:inherit}
    .suas-men-font{font-family:'Casual Human',Futura,Arial,sans-serif!important;letter-spacing:0!important}
    .suas-men-mono{font-family:Futura,'Futura PT',Arial,sans-serif;font-size:10px;letter-spacing:.16em;text-transform:uppercase;font-weight:900}
    .suas-men-win{width:min(880px,100%);border:2px solid #fff;border-radius:22px;background:#000;box-shadow:5px 6px 0 #fff;overflow:hidden}
    .suas-men-bar{min-height:40px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:8px;padding:7px 12px;border-bottom:2px solid #fff}
    .suas-men-dots{display:flex;gap:6px}
    .suas-men-dot{width:10px;height:10px;border-radius:999px;border:1.5px solid #fff}
    .suas-men-dot.is-on{background:#fff}
    .suas-men-bar b{text-align:center;font-size:11px;letter-spacing:.18em}
    .suas-men-exit{color:#fff;text-decoration:none;font-size:9px;letter-spacing:.14em}
    .suas-men-body{display:flex;flex-direction:column;gap:12px;padding:14px}
    .suas-men-body h1{margin:0;text-align:center;font-size:clamp(2rem,5vw,2.8rem);line-height:.8;text-transform:lowercase}
    .suas-men-chips{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}
    .suas-men-chips a{min-height:36px;display:inline-flex;align-items:center;justify-content:center;padding:6px 8px;border:1.75px solid #fff;border-radius:999px;background:#000;color:#fff;box-shadow:0 2px 0 #fff;text-decoration:none;text-align:center;font-size:10px;font-weight:900;letter-spacing:.06em;text-transform:uppercase}
    .suas-men-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
    .suas-men-tile{display:flex;flex-direction:column;gap:7px;padding:10px;border:2px solid #fff;border-radius:14px;text-decoration:none}
    .suas-men-tile img,.suas-men-blank{display:block;width:100%;aspect-ratio:1;object-fit:contain;border:1.5px solid #fff;border-radius:10px;background:#111}
    .suas-men-tile b{font-size:.9rem;line-height:.95;text-transform:lowercase;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .suas-men-empty,.suas-men-copy{margin:0;text-align:center;font-size:13px;font-weight:800;opacity:.7}
    .suas-men-copy :link,.suas-men-copy :visited{color:#fff}
    .suas-men-shelf{display:flex;flex-direction:column;gap:8px}
    .suas-men-shelf h2{margin:8px 0 0;font-size:1.4rem;text-transform:lowercase}
    @media(max-width:700px){
      .suas-men-chips,.suas-men-grid{grid-template-columns:1fr 1fr}
      .suas-men-win{border-radius:18px}
    }
  </style>
  {% liquid
    assign rack_handles = 'cologne,body-oil-1,m-butter-creme,exfoliating-body-wash,beard,masculine' | split: ','
    assign mapped_handle = ''
    case page.handle
      when 'men-s-butters'
        assign mapped_handle = 'm-butter-creme'
      when 'men-s-body-oil', 'men-s-body-oil-2'
        assign mapped_handle = 'm-body-oil'
      when 'men-s-body-mist', 'men-s-body-mist-2'
        assign mapped_handle = 'm-eau-de-parfum'
      when 'men-s-scrubs'
        assign mapped_handle = 'men-s-sugar-scrubs'
      when 'men-s-body-balm'
        assign mapped_handle = 'm-butter-creme'
    endcase
    assign mapped_collection = collections[mapped_handle]
    assign show_all_racks = false
    if page.handle == 'men-s-shop' or page.handle == 'masculine-scents'
      assign show_all_racks = true
    endif
  %}
  <article class="suas-men-win">
    <div class="suas-men-bar">
      <div class="suas-men-dots" aria-hidden="true"><span class="suas-men-dot is-on"></span><span class="suas-men-dot"></span><span class="suas-men-dot"></span></div>
      <b class="suas-men-mono">the rack</b>
      <a class="suas-men-exit suas-men-mono" href="/pages/suas-men">back</a>
    </div>
    <div class="suas-men-body">
      <h1 class="suas-men-font">{{ page.title }}</h1>
      <div class="suas-men-chips">
        <a href="/collections/cologne">Cologne</a>
        <a href="/collections/body-oil-1">Body oil</a>
        <a href="/collections/m-butter-creme">Butter creme</a>
        <a href="/collections/exfoliating-body-wash">Body wash</a>
        <a href="/collections/beard">Beard</a>
        <a href="/collections/masculine">The rack</a>
      </div>
      {% if show_all_racks %}
        {% for handle in rack_handles %}
          {% assign shelf = collections[handle] %}
          {% if shelf != blank and shelf.products_count > 0 %}
            <div class="suas-men-shelf">
              <h2 class="suas-men-font">{{ shelf.title }}</h2>
              <div class="suas-men-grid">
                {% for product in shelf.products limit: 8 %}
                  {% include 'suas-men-hide-women' %}
                  {% unless suas_men_hide %}
                    <a class="suas-men-tile" href="{{ product.url }}">
                      {% if product.featured_image %}
                        {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}
                      {% else %}
                        <div class="suas-men-blank"></div>
                      {% endif %}
                      <b class="suas-men-font">{{ product.title }}</b>
                      <span class="suas-men-mono">{{ product.price | money }}</span>
                    </a>
                  {% endunless %}
                {% endfor %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      {% elsif mapped_collection != blank %}
        <div class="suas-men-grid">
          {% for product in mapped_collection.products limit: 24 %}
            {% include 'suas-men-hide-women' %}
            {% unless suas_men_hide %}
              <a class="suas-men-tile" href="{{ product.url }}">
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}
                {% else %}
                  <div class="suas-men-blank"></div>
                {% endif %}
                <b class="suas-men-font">{{ product.title }}</b>
                <span class="suas-men-mono">{{ product.price | money }}</span>
              </a>
            {% endunless %}
          {% endfor %}
        </div>
        {% if mapped_collection.products_count == 0 %}
          <p class="suas-men-empty">nothing on this shelf yet.</p>
        {% endif %}
      {% elsif page.content != blank %}
        <div class="suas-men-copy">{{ page.content }}</div>
      {% else %}
        <p class="suas-men-empty">pick a shelf.</p>
      {% endif %}
    </div>
  </article>
</section>
{% schema %}
{
  "name": "SUAS Men Page",
  "settings": [],
  "presets": [{"name": "SUAS Men Page"}]
}
{% endschema %}

{%- liquid
  comment
    Prefer all_products by handle so kit prices stay locked to Lab @ Home SKUs
    even if theme-editor product settings are empty or stale.
  endcomment
  assign perfume_product = all_products['lab-at-home-perfume']
  assign oil_product = all_products['lab-at-home-body-oil']
  assign rollon_product = all_products['lab-at-home-roll-on']
  assign trio_product = all_products['lab-at-home-trio']

  if section.settings.perfume_product != blank and section.settings.perfume_product.selected_or_first_available_variant != blank
    assign perfume_product = section.settings.perfume_product
  endif
  if section.settings.oil_product != blank and section.settings.oil_product.selected_or_first_available_variant != blank
    assign oil_product = section.settings.oil_product
  endif
  if section.settings.rollon_product != blank and section.settings.rollon_product.selected_or_first_available_variant != blank
    assign rollon_product = section.settings.rollon_product
  endif
  if section.settings.trio_product != blank and section.settings.trio_product.selected_or_first_available_variant != blank
    assign trio_product = section.settings.trio_product
  endif

  assign perfume_variant = perfume_product.selected_or_first_available_variant
  assign oil_variant = oil_product.selected_or_first_available_variant
  assign rollon_variant = rollon_product.selected_or_first_available_variant
  assign trio_variant = trio_product.selected_or_first_available_variant
-%}

<style>
  @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
  @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}
</style>
{{ 'suas-lab-at-home.css' | asset_url | stylesheet_tag }}

<section
  class="suas-lah"
  id="lab-at-home"
  aria-label="The Lab at Home"
  data-suas-lah
  data-variant-perfume="{{ perfume_variant.id | default: 0 }}"
  data-variant-oil="{{ oil_variant.id | default: 0 }}"
  data-variant-rollon="{{ rollon_variant.id | default: 0 }}"
  data-variant-trio="{{ trio_variant.id | default: 0 }}"
  data-price-perfume="{{ perfume_variant.price | default: 4900 }}"
  data-price-oil="{{ oil_variant.price | default: 3500 }}"
  data-price-rollon="{{ rollon_variant.price | default: 2400 }}"
  data-price-trio="{{ trio_variant.price | default: 9900 }}"
  data-money-perfume="{{ perfume_variant.price | default: 4900 | money }}"
  data-money-oil="{{ oil_variant.price | default: 3500 | money }}"
  data-money-rollon="{{ rollon_variant.price | default: 2800 | money }}"
  data-money-trio="{{ trio_variant.price | default: 9900 | money }}"
  data-title-perfume="{{ perfume_product.title | default: 'The Lab @ Home - 30 mL Custom Perfume' | escape }}"
  data-title-oil="{{ oil_product.title | default: 'The Lab @ Home - 30 mL Custom Body Oil' | escape }}"
  data-title-rollon="{{ rollon_product.title | default: 'The Lab @ Home - 10 mL Custom Roll-On' | escape }}"
  data-title-trio="{{ trio_product.title | default: 'The Lab @ Home Trio' | escape }}"
  data-bottle-cylinder="{{ 'lah-pack-cylinder.png' | asset_url }}"
  data-bottle-round="{{ 'lah-pack-round.png' | asset_url }}"
  data-bottle-oil="{{ 'lah-pack-oil.png' | asset_url }}"
  data-bottle-rollon="{{ 'lah-pack-rollon.png' | asset_url }}"
  data-bottle-trio="{{ 'lah-pack-trio.png' | asset_url }}"
>
  <div class="suas-lah-wrap">
    <div class="suas-lah-window" data-lah-window>
      <div class="suas-lah-titlebar">
        <span class="suas-lah-app" data-lah-app-title>LAB.HOME.EXE - Setup Wizard</span>
        <span class="suas-lah-winbtns">
          <i class="suas-lah-winbtn" data-kind="min" aria-hidden="true"></i>
          <i class="suas-lah-winbtn" data-kind="max" aria-hidden="true"></i>
          <a class="suas-lah-winbtn" data-kind="close" href="/pages/bookings" aria-label="Close Lab at Home and return to bookings"></a>
        </span>
      </div>

      {%- comment -%} -- SETUP (video beat 1) -- {%- endcomment -%}
      <div class="suas-lah-screen is-on" data-lah-screen="setup" role="region" aria-label="Setup wizard">
        <div class="suas-lah-wizard">
          <aside class="suas-lah-sidebar" aria-hidden="true">
            <div class="suas-lah-sidebar-card">LAB<br>HOME</div>
          </aside>
          <div class="suas-lah-wizard-body">
            <p class="suas-lah-wizard-kicker">BLACK FRIDAY RELEASE</p>
            <h1 class="suas-lah-wizard-title">NEW SOFTWARE DETECTED</h1>
            <p class="suas-lah-wizard-copy">Your fragrance lab is now a DIY kit - build it online, we ship it home.</p>
            <p class="suas-lah-chip suas-lah-chip-hot">Ships to all 50 states</p>
            <div class="suas-lah-wizard-nav">
              <button class="suas-lah-btn suas-lah-btn-lime" type="button" data-lah-goto="welcome">Continue &gt;</button>
            </div>
          </div>
        </div>
      </div>

      {%- comment -%} -- WELCOME (video beat 2) -- {%- endcomment -%}
      <div class="suas-lah-screen" data-lah-screen="welcome" role="region" aria-label="Welcome" hidden>
        <div class="suas-lah-wizard">
          <aside class="suas-lah-sidebar" aria-hidden="true">
            <div class="suas-lah-sidebar-card">LAB<br>HOME</div>
          </aside>
          <div class="suas-lah-wizard-body">
            <div class="suas-lah-welcome-row">
              <span class="suas-lah-welcome-bottle" aria-hidden="true"></span>
              <div>
                <h1 class="suas-lah-wizard-title suas-lah-wizard-title-sm">The Lab has officially left the building.</h1>
                <p class="suas-lah-wizard-copy">Create your own signature perfume from anywhere.</p>
              </div>
            </div>
            <p class="suas-lah-chip suas-lah-chip-lime">30 mL DIY Perfume Kit</p>
            <p class="suas-lah-wizard-meta">1�15 mL base + 3�5 mL notes - from the Lab @ Home scent list</p>
            <p class="suas-lah-banner-soft">DIY kit � packed by SUAS � ships to all 50 states</p>
            <details class="suas-lah-includes">
              <summary class="suas-lah-includes-label">each kit includes</summary>
              <ul class="suas-lah-includes-list">
                <li>15 mL base note (your favorite)</li>
                <li>three 5 mL fragrance vials</li>
                <li>30 mL perfume bottle</li>
                <li>mixing beaker</li>
                <li>mini pipettes + funnel</li>
                <li>alcohol prep pad</li>
                <li>customizable label</li>
                <li>reusable clear kit case</li>
              </ul>
            </details>
            <div class="suas-lah-wizard-nav">
              <button class="suas-lah-btn suas-lah-btn-ghost" type="button" data-lah-goto="setup">&lt; Back</button>
              <button class="suas-lah-btn suas-lah-btn-lime" type="button" data-lah-goto="build">Let's Get Started &gt;</button>
            </div>
          </div>
        </div>
      </div>

      {%- comment -%} -- BUILDER / CUSTOMIZE (video beat 3) -- {%- endcomment -%}
      <div class="suas-lah-screen" data-lah-screen="build" role="region" aria-label="Customize your kit" hidden>
        <div class="suas-lah-build-shell">
          <header class="suas-lah-head">
            <h1 class="suas-lah-title">{{ section.settings.heading | default: 'the lab @ home' | escape }}</h1>
            <p class="suas-lah-sub">{{ section.settings.copy | default: 'DIY kit - pick from the Lab @ Home scent list, we pack & ship.' | escape }}</p>
            <div class="suas-lah-ships" data-lah-ships>
              <span class="suas-lah-ships-pick" data-lah-ships-pick hidden></span>
              <span class="suas-lah-ships-text">Ships to all 50 states</span>
            </div>
          </header>

          <div class="suas-lah-body">
            <div class="suas-lah-panel suas-lah-panel-kit">
              <p class="suas-lah-step-label">0) pick your kit</p>
              <p class="suas-visually-hidden" data-lah-selected aria-live="polite"></p>
              <div class="suas-lah-kits" data-lah-kits role="group" aria-label="Kit type"></div>
              <div class="suas-lah-trio-track" data-lah-trio-track hidden>
                <div class="suas-lah-trio-steps" data-lah-trio-steps role="tablist" aria-label="Trio product steps"></div>
              </div>
            </div>

            <p class="suas-lah-recipe" data-lah-recipe>1) 15 mL base (your favorite) ? 2) 3 � 5 mL notes</p>

            <div class="suas-lah-build">
              <div class="suas-lah-panel suas-lah-panel-notes">
                <p class="suas-lah-slot-hint" data-lah-slot-hint role="status" aria-live="polite">Tube 1 of 4 - pick your 15 mL base</p>
                <div class="suas-lah-slotbar" data-lah-slots></div>

                <label class="suas-lah-search-label" for="LahNoteSearch">filter notes</label>
                <input id="LahNoteSearch" class="suas-lah-search" type="search" placeholder="search notes" data-lah-search autocomplete="off" enterkeyhint="search">

                <div class="suas-lah-filters" data-lah-filters role="group" aria-label="Filter scent families"></div>
                <div class="suas-lah-notes" data-lah-notes role="listbox" aria-label="Scent notes" aria-multiselectable="true"></div>
              </div>

              <aside class="suas-lah-stage" data-lah-stage>
                <div class="suas-lah-bottle-card">
                  <p class="suas-lah-fill-status" data-lah-fill-status>0 / 30 mL</p>
                  <div class="suas-lah-photo-stage" data-lah-bottle data-shape="perfume" aria-hidden="true">
                    <div class="suas-lah-photo-body">
                      <img class="suas-lah-photo-bottle" data-lah-photo-bottle src="{{ 'lah-pack-cylinder.png' | asset_url }}" alt="" width="210" height="320">
                      <div class="suas-lah-photo-fill" data-lah-photo-fill>
                        <span class="suas-lah-photo-liquid" data-lah-liquid></span>
                      </div>
                    </div>
                  </div>
                  <div class="suas-lah-bottle-pick" data-lah-bottle-pick hidden>
                    <p class="suas-lah-step-label">bottle shape</p>
                    <div class="suas-lah-bottle-options" data-lah-bottle-options role="group" aria-label="30 mL perfume bottle"></div>
                  </div>
                </div>
              </aside>
            </div>

            <div class="suas-lah-vials-wrap">
              <p class="suas-lah-step-label">your formula</p>
              <div class="suas-lah-vials" data-lah-vials aria-label="Formula vials"></div>
            </div>

            <div class="suas-lah-checkout" data-lah-checkout>
              <div class="suas-lah-name-row">
                <label for="LahFormulaName">3) name your formula <span class="suas-lah-optional">(optional)</span></label>
                <input id="LahFormulaName" class="suas-formula-input" type="text" maxlength="48" placeholder="type a name." data-lah-name autocomplete="off">
              </div>

              <p class="suas-lah-statusbar" data-lah-statusbar role="status" aria-live="polite">Select your 15 mL base (favorite)</p>

              <div class="suas-lah-actions">
                <button class="suas-lah-btn suas-lah-btn-hot" type="button" data-lah-atc disabled>Select your 15 mL base (favorite)</button>
                <button class="suas-lah-btn suas-lah-btn-ghost" type="button" data-lah-reset>start over</button>
                <p class="suas-lah-error" data-lah-error role="alert"></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="suas-lah-sticky" data-lah-sticky aria-label="Lab at Home progress">
    <div class="suas-lah-sticky-thumb" aria-hidden="true">
      <img data-lah-sticky-bottle src="{{ 'lah-pack-cylinder.png' | asset_url }}" alt="" width="48" height="72">
      <span class="suas-lah-sticky-liquid" data-lah-sticky-liquid></span>
    </div>
    <div class="suas-lah-sticky-copy">
      <strong data-lah-sticky-status>0 / 30 mL</strong>
      <span data-lah-sticky-coach>Select your 15 mL base</span>
    </div>
    <button class="suas-lah-btn suas-lah-btn-hot suas-lah-sticky-atc" type="button" data-lah-sticky-atc disabled>fill tubes</button>
  </div>

  <p class="suas-visually-hidden" data-lah-live aria-live="polite"></p>
</section>

<script>
  window.SUAS_LAB_HOME_NOTES = [
    { id: 'cherry', label: 'Cherry', family: 'fruit', hex: '#c41e3a', hex2: '#ff6b8a' },
    { id: 'strawberry', label: 'Strawberry', family: 'fruit', hex: '#e63946', hex2: '#ffb3c1' },
    { id: 'pineapple', label: 'Pineapple', family: 'fruit', hex: '#f4c430', hex2: '#fff1a8' },
    { id: 'apple', label: 'Apple', family: 'fruit', hex: '#7cb342', hex2: '#d9ff78' },
    { id: 'watermelon', label: 'Watermelon', family: 'fruit', hex: '#ff4d6d', hex2: '#c8f7c5' },
    { id: 'black-currant', label: 'Black Currant', family: 'fruit', hex: '#4a1942', hex2: '#c77dbb' },
    { id: 'fig', label: 'Fig', family: 'fruit', hex: '#6b3a5a', hex2: '#d4a5c9' },
    { id: 'honey', label: 'Honey', family: 'gourmand', hex: '#d4a017', hex2: '#ffe08a' },
    { id: 'bergamot', label: 'Bergamot', family: 'green', hex: '#a9dd59', hex2: '#ffe071' },
    { id: 'caramel', label: 'Caramel', family: 'gourmand', hex: '#b85d19', hex2: '#ffc45f' },
    { id: 'coffee', label: 'Coffee', family: 'gourmand', hex: '#3e2723', hex2: '#a1887f' },
    { id: 'heavy-cream', label: 'Heavy Cream', family: 'gourmand', hex: '#fff5e6', hex2: '#f5d9b8' },
    { id: 'coconut', label: 'Coconut', family: 'gourmand', hex: '#fff7df', hex2: '#d0a36a' },
    { id: 'baby-powder', label: 'Baby Powder', family: 'sparkle', hex: '#f7f1e9', hex2: '#e8dff5' },
    { id: 'ocean-scent', label: 'Ocean Scent', family: 'green', hex: '#4fc3f7', hex2: '#b3e5fc' },
    { id: 'white-musk', label: 'White Musk', family: 'sparkle', hex: '#f5f5f5', hex2: '#d8e2ff' },
    { id: 'black-oud', label: 'Black Oud', family: 'sparkle', hex: '#1a1210', hex2: '#5c4033' },
    { id: 'cedar', label: 'Cedar', family: 'green', hex: '#74401f', hex2: '#c98445' }
  ];
</script>
<script src="{{ 'suas-lab-at-home.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "SUAS Lab @ Home",
  "tag": "section",
  "settings": [
    {"type":"text","id":"kicker","label":"Kicker (optional)"},
    {"type":"text","id":"heading","label":"Heading","default":"the lab @ home"},
    {"type":"textarea","id":"copy","label":"Copy","default":"DIY kit - pick from the Lab @ Home scent list, we pack & ship."},
    {"type":"header","content":"Products"},
    {"type":"product","id":"perfume_product","label":"Perfume kit product"},
    {"type":"product","id":"oil_product","label":"Body oil kit product"},
    {"type":"product","id":"rollon_product","label":"Roll-on kit product"},
    {"type":"product","id":"trio_product","label":"Trio product"}
  ],
  "presets": [
    {"name":"SUAS Lab @ Home"}
  ]
}
{% endschema %}

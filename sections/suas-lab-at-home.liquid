{%- liquid
  assign perfume_product = all_products['lab-at-home-perfume']
  assign oil_product = all_products['lab-at-home-body-oil']
  assign rollon_product = all_products['lab-at-home-roll-on']
  assign trio_product = all_products['lab-at-home-trio']

  if section.settings.perfume_product != blank and section.settings.perfume_product.selected_or_first_available_variant != blank
    assign perfume_product = section.settings.perfume_product
  endif
  if section.settings.oil_product != blank and section.settings.oil_product.selected_or_first_available_variant != blank
    assign oil_product = section.settings.oil_product
  endif
  if section.settings.rollon_product != blank and section.settings.rollon_product.selected_or_first_available_variant != blank
    assign rollon_product = section.settings.rollon_product
  endif
  if section.settings.trio_product != blank and section.settings.trio_product.selected_or_first_available_variant != blank
    assign trio_product = section.settings.trio_product
  endif

  assign perfume_variant = perfume_product.selected_or_first_available_variant
  assign oil_variant = oil_product.selected_or_first_available_variant
  assign rollon_variant = rollon_product.selected_or_first_available_variant
  assign trio_variant = trio_product.selected_or_first_available_variant
-%}

{{ 'suas-lab-at-home.css' | asset_url | stylesheet_tag }}

<section
  class="suas-lah"
  id="lab-at-home"
  aria-label="Lab @ Home"
  data-suas-lah
  data-variant-perfume="{{ perfume_variant.id | default: 0 }}"
  data-variant-oil="{{ oil_variant.id | default: 0 }}"
  data-variant-rollon="{{ rollon_variant.id | default: 0 }}"
  data-variant-trio="{{ trio_variant.id | default: 0 }}"
  data-price-perfume="{{ perfume_variant.price | default: 4900 }}"
  data-price-oil="{{ oil_variant.price | default: 3500 }}"
  data-price-rollon="{{ rollon_variant.price | default: 2400 }}"
  data-price-trio="{{ trio_variant.price | default: 9900 }}"
  data-money-perfume="{{ perfume_variant.price | default: 4900 | money }}"
  data-money-oil="{{ oil_variant.price | default: 3500 | money }}"
  data-money-rollon="{{ rollon_variant.price | default: 2800 | money }}"
  data-money-trio="{{ trio_variant.price | default: 9900 | money }}"
  data-title-perfume="{{ perfume_product.title | default: 'The Lab @ Home  -  30 mL Custom Perfume' | escape }}"
  data-title-oil="{{ oil_product.title | default: 'The Lab @ Home  -  30 mL Custom Body Oil' | escape }}"
  data-title-rollon="{{ rollon_product.title | default: 'The Lab @ Home  -  10 mL Custom Roll-On' | escape }}"
  data-title-trio="{{ trio_product.title | default: 'The Lab @ Home Trio' | escape }}"
  data-bottle-cylinder="{{ 'lah-pack-cylinder.png' | asset_url }}"
  data-bottle-round="{{ 'lah-pack-round.png' | asset_url }}"
  data-bottle-oil="{{ 'lah-pack-oil.png' | asset_url }}"
  data-bottle-rollon="{{ 'lah-pack-rollon.png' | asset_url }}"
  data-bottle-trio="{{ 'lah-pack-trio.png' | asset_url }}"
>
  <div class="suas-lah-wrap">
    <div class="suas-lah-window" data-lah-window>
      <div class="suas-lah-titlebar">
        <span class="suas-lah-app" data-lah-app-title>Step 1 of 5</span>
        <span class="suas-lah-winbtns">
          <i class="suas-lah-winbtn" data-kind="min" aria-hidden="true"></i>
          <i class="suas-lah-winbtn" data-kind="max" aria-hidden="true"></i>
          <a class="suas-lah-winbtn" data-kind="close" href="/pages/bookings" aria-label="Close Lab @ Home"></a>
        </span>
      </div>

      {%- comment -%} XP install wizard: kit  ->  bottle  ->  notes  ->  name  ->  process {%- endcomment -%}
      <div class="suas-lah-screen is-on" data-lah-screen="build" role="region" aria-label="Install Lab @ Home">
        <div class="suas-lah-install" data-lah-install>
          <aside class="suas-lah-install-rail" aria-label="Install steps">
            <p class="suas-lah-install-rail-title">Install<br>steps</p>
            <ol class="suas-lah-install-steps" data-lah-install-steps>
              <li data-step-id="kit"><em>1</em><span>Kit type</span></li>
              <li data-step-id="bottle"><em>2</em><span>Bottle</span></li>
              <li data-step-id="notes"><em>3</em><span>Scent notes</span></li>
              <li data-step-id="name"><em>4</em><span>Name it</span></li>
              <li data-step-id="process"><em>5</em><span>Process</span></li>
            </ol>
            <p class="suas-lah-install-rail-foot">ships all 50 states</p>
          </aside>

          <div class="suas-lah-install-main">
            <div class="suas-lah-step is-on" data-lah-step="kit" role="group" aria-labelledby="lah-step-kit-title">
              <h2 id="lah-step-kit-title" class="suas-lah-step-title">Step 1 - Choose your kit</h2>
              <p class="suas-lah-step-copy">choose your experiment</p>
              <div class="suas-lah-kits" data-lah-kits role="group" aria-label="Kit type"></div>
              <div class="suas-lah-trio-track" data-lah-trio-track hidden>
                <div class="suas-lah-trio-steps" data-lah-trio-steps role="tablist" aria-label="Trio steps"></div>
              </div>
            </div>

            <div class="suas-lah-step" data-lah-step="bottle" role="group" aria-labelledby="lah-step-bottle-title" hidden>
              <h2 id="lah-step-bottle-title" class="suas-lah-step-title" data-lah-bottle-title>Step 2 - Choose your bottle</h2>
              <p class="suas-lah-step-copy" data-lah-bottle-copy>Pick the pack we ship with your kit.</p>
              <div class="suas-lah-bottle-pick" data-lah-bottle-pick>
                <div class="suas-lah-bottle-options" data-lah-bottle-options role="group" aria-label="Bottle"></div>
              </div>
            </div>

            <div class="suas-lah-step" data-lah-step="notes" role="group" aria-labelledby="lah-step-notes-title" hidden>
              <h2 id="lah-step-notes-title" class="suas-lah-step-title">Step 3 - Choose scent notes</h2>
              <p class="suas-lah-step-copy" data-lah-slot-hint role="status" aria-live="polite">4 scent notes  -  base counts as one. tap a note, it pours into the tube.</p>
              <div class="suas-lah-notes-desk">
                <div class="suas-lah-pane">
                  <div class="suas-lah-pane-head">
                    <span>notes.exe</span>
                    <span data-lah-note-count>16</span>
                  </div>
                  <div class="suas-lah-pane-body">
                    <div class="suas-lah-filters" data-lah-filters role="group" aria-label="Families"></div>
                    <label class="suas-visually-hidden" for="LahNoteSearch">search</label>
                    <input id="LahNoteSearch" class="suas-lah-search" type="search" placeholder="find a note..." data-lah-search autocomplete="off">
                    <div class="suas-lah-tray" data-lah-notes role="listbox" aria-label="Scent tray"></div>
                  </div>
                </div>
                <div class="suas-lah-pane suas-lah-pane-stage">
                  <div class="suas-lah-pane-head">
                    <span>formula.exe</span>
                    <span data-lah-fill-status>0 / 30 mL</span>
                  </div>
                  <div class="suas-lah-pane-body">
                    <div class="suas-lah-stage-box" data-lah-vials-wrap>
                      <div class="suas-lah-vials" data-lah-vials aria-label="Your formula tubes"></div>
                      <div class="suas-lah-pour-toast" data-lah-pour-toast hidden aria-live="polite"></div>
                      <div class="suas-lah-sparkles" data-lah-sparkles aria-hidden="true"></div>
                      <div class="suas-lah-fly" data-lah-fly aria-hidden="true"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="suas-lah-step" data-lah-step="name" role="group" aria-labelledby="lah-step-name-title" hidden>
              <h2 id="lah-step-name-title" class="suas-lah-step-title">Step 4 - Name your formula</h2>
              <p class="suas-lah-step-copy">Name it now for a printed label  -  or skip and use the write-in label later.</p>
              <label class="suas-lah-step-label" for="LahFormulaName">formula name</label>
              <input id="LahFormulaName" type="text" maxlength="48" placeholder="ex: Island Soft.exe" data-lah-name autocomplete="off">
              <p class="suas-lah-name-preview" data-lah-selected>untitled formula</p>
            </div>

            <div class="suas-lah-step" data-lah-step="process" role="group" aria-labelledby="lah-step-process-title" hidden>
              <h2 id="lah-step-process-title" class="suas-lah-step-title">Step 5 - Process your kit</h2>
              <p class="suas-lah-step-copy">Review the install, then add to bag.</p>
              <div class="suas-lah-crt" aria-live="polite">
                <b data-lah-crt-kicker>ready to ship</b>
                <strong data-lah-crt-price>$49.00</strong>
                <em data-lah-statusbar>Select your 15 mL base</em>
                <em data-lah-recipe class="suas-lah-crt-recipe"></em>
              </div>
              <p class="suas-lah-error" data-lah-error role="alert"></p>
            </div>

            <div class="suas-lah-install-nav">
              <button class="suas-lah-btn suas-lah-btn-ghost" type="button" data-lah-install-back>&lt; Back</button>
              <button class="suas-lah-btn suas-lah-btn-lime" type="button" data-lah-install-next>Next &gt;</button>
              <button class="suas-lah-cta suas-lah-nav-atc" type="button" data-lah-atc disabled hidden>add to bag</button>
              <button class="suas-lah-btn suas-lah-btn-ghost" type="button" data-lah-reset>start over</button>
            </div>
          </div>
        </div>

        <div data-lah-stage hidden>
          <div class="suas-lah-photo-stage" data-lah-bottle aria-hidden="true">
            <div class="suas-lah-photo-body">
              <img class="suas-lah-photo-bottle" data-lah-photo-bottle src="{{ 'lah-pack-cylinder.png' | asset_url }}" alt="" width="1" height="1">
              <div class="suas-lah-photo-fill" data-lah-photo-fill><span class="suas-lah-photo-liquid" data-lah-liquid></span></div>
            </div>
          </div>
        </div>
        <p class="suas-visually-hidden" data-lah-deskbar></p>
        <div class="suas-lah-slotbar" data-lah-slots hidden></div>
        <span class="suas-lah-ships-pick" data-lah-ships-pick hidden></span>
      </div>
    </div>
  </div>

  <div class="suas-lah-sticky" data-lah-sticky aria-label="Progress">
    <div class="suas-lah-sticky-copy">
      <strong data-lah-sticky-status>0 / 30 mL</strong>
      <span data-lah-sticky-coach>pick your base</span>
    </div>
    <button class="suas-lah-btn suas-lah-btn-hot suas-lah-sticky-atc" type="button" data-lah-sticky-atc disabled>add to bag</button>
  </div>
  <p class="suas-visually-hidden" data-lah-live aria-live="polite"></p>
</section>

<script>
  window.SUAS_LAB_HOME_NOTES = [
    { id: 'cherry', label: 'Cherry', family: 'fruit', hex: '#c41e3a', hex2: '#ff6b8a' },
    { id: 'strawberry', label: 'Strawberry', family: 'fruit', hex: '#e63946', hex2: '#ffb3c1' },
    { id: 'pineapple', label: 'Pineapple', family: 'fruit', hex: '#f4c430', hex2: '#fff1a8' },
    { id: 'apple', label: 'Apple', family: 'fruit', hex: '#7cb342', hex2: '#d9ff78' },
    { id: 'watermelon', label: 'Watermelon', family: 'fruit', hex: '#ff4d6d', hex2: '#c8f7c5' },
    { id: 'black-currant', label: 'Black Currant', family: 'fruit', hex: '#4a1942', hex2: '#c77dbb' },
    { id: 'fig', label: 'Fig', family: 'fruit', hex: '#6b3a5a', hex2: '#d4a5c9' },
    { id: 'honey', label: 'Honey', family: 'gourmand', hex: '#d4a017', hex2: '#ffe08a' },
    { id: 'bergamot', label: 'Bergamot', family: 'green', hex: '#a9dd59', hex2: '#ffe071' },
    { id: 'caramel', label: 'Caramel', family: 'gourmand', hex: '#b85d19', hex2: '#ffc45f' },
    { id: 'heavy-cream', label: 'Heavy Cream', family: 'gourmand', hex: '#fff5e6', hex2: '#f5d9b8' },
    { id: 'coconut', label: 'Coconut', family: 'gourmand', hex: '#fff7df', hex2: '#d0a36a' },
    { id: 'ocean-scent', label: 'Ocean Scent', family: 'green', hex: '#4fc3f7', hex2: '#b3e5fc' },
    { id: 'white-musk', label: 'White Musk', family: 'sparkle', hex: '#f5f5f5', hex2: '#d8e2ff' },
    { id: 'black-oud', label: 'Black Oud', family: 'sparkle', hex: '#1a1210', hex2: '#5c4033' },
    { id: 'cedar', label: 'Cedar', family: 'green', hex: '#74401f', hex2: '#c98445' }
  ];
</script>
<script src="{{ 'suas-lab-at-home.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "SUAS Lab @ Home",
  "tag": "section",
  "settings": [
    {"type":"text","id":"kicker","label":"Kicker (optional)"},
    {"type":"text","id":"heading","label":"Heading","default":"the lab @ home"},
    {"type":"textarea","id":"copy","label":"Copy","default":"tap a note  -  it pours into the tube"},
    {"type":"product","id":"perfume_product","label":"Perfume kit"},
    {"type":"product","id":"oil_product","label":"Body oil kit"},
    {"type":"product","id":"rollon_product","label":"Roll-on kit"},
    {"type":"product","id":"trio_product","label":"Trio"}
  ],
  "presets": [{"name":"SUAS Lab @ Home"}]
}
{% endschema %}

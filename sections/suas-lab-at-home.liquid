{%- liquid
  assign perfume_product = section.settings.perfume_product
  assign oil_product = section.settings.oil_product
  assign rollon_product = section.settings.rollon_product
  assign trio_product = section.settings.trio_product

  if perfume_product == blank
    assign perfume_product = all_products['lab-at-home-perfume']
  endif
  if oil_product == blank
    assign oil_product = all_products['lab-at-home-body-oil']
  endif
  if rollon_product == blank
    assign rollon_product = all_products['lab-at-home-roll-on']
  endif
  if trio_product == blank
    assign trio_product = all_products['lab-at-home-trio']
  endif

  assign perfume_variant = perfume_product.selected_or_first_available_variant
  assign oil_variant = oil_product.selected_or_first_available_variant
  assign rollon_variant = rollon_product.selected_or_first_available_variant
  assign trio_variant = trio_product.selected_or_first_available_variant
-%}

{{ 'suas-lab-at-home.css' | asset_url | stylesheet_tag }}

<section
  class="suas-lah"
  id="lab-at-home"
  aria-label="The Lab at Home"
  data-suas-lah
  data-variant-perfume="{{ perfume_variant.id | default: 0 }}"
  data-variant-oil="{{ oil_variant.id | default: 0 }}"
  data-variant-rollon="{{ rollon_variant.id | default: 0 }}"
  data-variant-trio="{{ trio_variant.id | default: 0 }}"
  data-note-assets='{"note-station-strawberry.png":{{ "note-station-strawberry.png" | asset_url | json }},"note-pineapple.png":{{ "note-pineapple.png" | asset_url | json }},"note-blackberry.png":{{ "note-blackberry.png" | asset_url | json }},"note-station-caramel.png":{{ "note-station-caramel.png" | asset_url | json }},"note-station-vanilla.png":{{ "note-station-vanilla.png" | asset_url | json }},"note-coconut.png":{{ "note-coconut.png" | asset_url | json }},"note-station-sandalwood.png":{{ "note-station-sandalwood.png" | asset_url | json }}}'
>
  <div class="suas-lah-wrap">
    <div class="suas-lah-window">
      <div class="suas-lah-titlebar">
        <span class="suas-lah-dots" aria-hidden="true">
          <i style="--dot:#ff5f57"></i>
          <i style="--dot:#febc2e"></i>
          <i style="--dot:#28c840"></i>
        </span>
        <span class="suas-lah-app">LAB.HOME.EXE</span>
      </div>

      <header class="suas-lah-head">
        <p class="suas-lah-kicker">{{ section.settings.kicker | escape }}</p>
        <h2 class="suas-lah-title">{{ section.settings.heading | escape }}</h2>
        <p class="suas-lah-sub">{{ section.settings.copy | escape }}</p>
      </header>

      <div class="suas-lah-body">
        <div class="suas-lah-panel">
          <p class="suas-lah-step-label">01 · choose your kit</p>
          <div class="suas-lah-kits" data-lah-kits role="group" aria-label="Kit type"></div>

          <div class="suas-lah-protocol" data-lah-protocol></div>

          <p class="suas-lah-step-label" style="margin-top:16px">02 · pour your notes</p>
          <div class="suas-lah-slotbar" data-lah-slots aria-live="polite"></div>

          <div class="suas-lah-filters" data-lah-filters role="group" aria-label="Filter scent families"></div>
          <div class="suas-lah-notes" data-lah-notes role="listbox" aria-label="Scent notes" aria-multiselectable="true"></div>
        </div>

        <aside class="suas-lah-stage">
          <div class="suas-lah-bottle-card">
            <p class="suas-lah-fill-status" data-lah-fill-status>0 / 30 mL filled</p>
            <div class="suas-lah-bottle" data-lah-bottle data-shape="perfume" aria-hidden="true">
              <span class="suas-lah-cap"></span>
              <span class="suas-lah-neck"></span>
              <span class="suas-lah-body-glass">
                <span class="suas-lah-liquid" data-lah-liquid></span>
                <span class="suas-lah-layers" data-lah-layers></span>
                <span class="suas-lah-shine"></span>
              </span>
            </div>
            <ul class="suas-lah-recipe" data-lah-recipe></ul>
          </div>

          <div class="suas-lah-name-row">
            <label for="LahFormulaName">name your formula</label>
            <input id="LahFormulaName" class="suas-formula-input" type="text" maxlength="48" placeholder="ex: peachy glow" data-lah-name autocomplete="off">
          </div>

          <div class="suas-lah-actions">
            <button class="suas-lah-btn" type="button" data-lah-atc data-pink disabled>add to cart</button>
            <button class="suas-lah-btn suas-lah-btn-ghost" type="button" data-lah-reset>start over</button>
            <p class="suas-lah-error" data-lah-error role="alert"></p>
          </div>
        </aside>
      </div>
    </div>
  </div>

  <p class="suas-visually-hidden" data-lah-live aria-live="polite"></p>
</section>

<script>
  window.SUAS_LAB_HOME_NOTES = [
    { id: 'cherry', label: 'Cherry', family: 'fruit', hex: '#c41e3a', hex2: '#ff6b8a', photo: null },
    { id: 'strawberry', label: 'Strawberry', family: 'fruit', hex: '#e63946', hex2: '#ffb3c1', photo: 'note-station-strawberry.png' },
    { id: 'pineapple', label: 'Pineapple', family: 'fruit', hex: '#f4c430', hex2: '#fff1a8', photo: 'note-pineapple.png' },
    { id: 'apple', label: 'Apple', family: 'fruit', hex: '#7cb342', hex2: '#d9ff78', photo: null },
    { id: 'watermelon', label: 'Watermelon', family: 'fruit', hex: '#ff4d6d', hex2: '#c8f7c5', photo: null },
    { id: 'black-currant', label: 'Black Currant', family: 'fruit', hex: '#4a1942', hex2: '#c77dbb', photo: 'note-blackberry.png' },
    { id: 'fig', label: 'Fig', family: 'fruit', hex: '#6b3a5a', hex2: '#d4a5c9', photo: null },
    { id: 'honey', label: 'Honey', family: 'gourmand', hex: '#d4a017', hex2: '#ffe08a', photo: null },
    { id: 'bergamot', label: 'Bergamot', family: 'green', hex: '#a9dd59', hex2: '#ffe071', photo: null },
    { id: 'caramel', label: 'Caramel', family: 'gourmand', hex: '#b85d19', hex2: '#ffc45f', photo: 'note-station-caramel.png' },
    { id: 'coffee', label: 'Coffee', family: 'gourmand', hex: '#3e2723', hex2: '#a1887f', photo: null },
    { id: 'heavy-cream', label: 'Heavy Cream (Phlur Type)', family: 'gourmand', hex: '#fff5e6', hex2: '#f5d9b8', photo: 'note-station-vanilla.png' },
    { id: 'coconut', label: 'Coconut', family: 'gourmand', hex: '#fff7df', hex2: '#d0a36a', photo: 'note-coconut.png' },
    { id: 'baby-powder', label: 'Baby Powder', family: 'sparkle', hex: '#f7f1e9', hex2: '#e8dff5', photo: null },
    { id: 'ocean-scent', label: 'Ocean Scent', family: 'green', hex: '#4fc3f7', hex2: '#b3e5fc', photo: null },
    { id: 'white-musk', label: 'White Musk', family: 'sparkle', hex: '#f5f5f5', hex2: '#d8e2ff', photo: null },
    { id: 'black-oud', label: 'Black Oud', family: 'sparkle', hex: '#1a1210', hex2: '#5c4033', photo: null },
    { id: 'cedar', label: 'Cedar', family: 'green', hex: '#74401f', hex2: '#c98445', photo: 'note-station-sandalwood.png' }
  ];
</script>
<script src="{{ 'suas-lab-at-home.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "SUAS Lab @ Home",
  "tag": "section",
  "settings": [
    {"type":"text","id":"kicker","label":"Kicker","default":"SUAS.OS / THE LAB @ HOME"},
    {"type":"text","id":"heading","label":"Heading","default":"build your signature scent at home."},
    {"type":"textarea","id":"copy","label":"Copy","default":"Same protocol as The Lab. Pick your kit, pour your notes, watch the bottle fill, name it, and check out."},
    {"type":"header","content":"Products"},
    {"type":"product","id":"perfume_product","label":"Perfume kit product"},
    {"type":"product","id":"oil_product","label":"Body oil kit product"},
    {"type":"product","id":"rollon_product","label":"Roll-on kit product"},
    {"type":"product","id":"trio_product","label":"Trio product"}
  ],
  "presets": [
    {"name":"SUAS Lab @ Home"}
  ]
}
{% endschema %}

{%- liquid
  comment
    Prefer all_products by handle so kit prices stay locked to Lab @ Home SKUs
    even if theme-editor product settings are empty or stale.
  endcomment
  assign perfume_product = all_products['lab-at-home-perfume']
  assign oil_product = all_products['lab-at-home-body-oil']
  assign rollon_product = all_products['lab-at-home-roll-on']
  assign trio_product = all_products['lab-at-home-trio']

  if section.settings.perfume_product != blank and section.settings.perfume_product.selected_or_first_available_variant != blank
    assign perfume_product = section.settings.perfume_product
  endif
  if section.settings.oil_product != blank and section.settings.oil_product.selected_or_first_available_variant != blank
    assign oil_product = section.settings.oil_product
  endif
  if section.settings.rollon_product != blank and section.settings.rollon_product.selected_or_first_available_variant != blank
    assign rollon_product = section.settings.rollon_product
  endif
  if section.settings.trio_product != blank and section.settings.trio_product.selected_or_first_available_variant != blank
    assign trio_product = section.settings.trio_product
  endif

  assign perfume_variant = perfume_product.selected_or_first_available_variant
  assign oil_variant = oil_product.selected_or_first_available_variant
  assign rollon_variant = rollon_product.selected_or_first_available_variant
  assign trio_variant = trio_product.selected_or_first_available_variant
-%}

{{ 'suas-lab-at-home.css' | asset_url | stylesheet_tag }}

<section
  class="suas-lah"
  id="lab-at-home"
  aria-label="The Lab at Home"
  data-suas-lah
  data-variant-perfume="{{ perfume_variant.id | default: 0 }}"
  data-variant-oil="{{ oil_variant.id | default: 0 }}"
  data-variant-rollon="{{ rollon_variant.id | default: 0 }}"
  data-variant-trio="{{ trio_variant.id | default: 0 }}"
  data-price-perfume="{{ perfume_variant.price | default: 4900 }}"
  data-price-oil="{{ oil_variant.price | default: 3500 }}"
  data-price-rollon="{{ rollon_variant.price | default: 2400 }}"
  data-price-trio="{{ trio_variant.price | default: 9900 }}"
  data-money-perfume="{{ perfume_variant.price | default: 4900 | money }}"
  data-money-oil="{{ oil_variant.price | default: 3500 | money }}"
  data-money-rollon="{{ rollon_variant.price | default: 2400 | money }}"
  data-money-trio="{{ trio_variant.price | default: 9900 | money }}"
  data-title-perfume="{{ perfume_product.title | default: 'The Lab @ Home — 30 mL Custom Perfume' | escape }}"
  data-title-oil="{{ oil_product.title | default: 'The Lab @ Home — 30 mL Custom Body Oil' | escape }}"
  data-title-rollon="{{ rollon_product.title | default: 'The Lab @ Home — 10 mL Custom Roll-On' | escape }}"
  data-title-trio="{{ trio_product.title | default: 'The Lab @ Home Trio' | escape }}"
  data-bottle-cylinder="{{ 'lah-pack-cylinder.png' | asset_url }}"
  data-bottle-round="{{ 'lah-pack-round.png' | asset_url }}"
  data-bottle-oil="{{ 'lah-pack-oil.png' | asset_url }}"
  data-bottle-rollon="{{ 'lah-pack-rollon.png' | asset_url }}"
  data-bottle-trio="{{ 'lah-pack-trio.png' | asset_url }}"
>
  <div class="suas-lah-wrap">
    <div class="suas-lah-window">
      <div class="suas-lah-titlebar">
        <span class="suas-lah-dots" aria-hidden="true">
          <i style="--dot:#ff5f57"></i>
          <i style="--dot:#febc2e"></i>
          <i style="--dot:#28c840"></i>
        </span>
        <span class="suas-lah-app">LAB.HOME.EXE</span>
      </div>

      <header class="suas-lah-head">
        <p class="suas-lah-kicker">{{ section.settings.kicker | escape }}</p>
        <h2 class="suas-lah-title">{{ section.settings.heading | escape }}</h2>
        <p class="suas-lah-sub">{{ section.settings.copy | escape }}</p>
      </header>

      <div class="suas-lah-body">
        <div class="suas-lah-panel">
          <p class="suas-lah-step-label">01 · choose your kit</p>
          <p class="suas-lah-selected" data-lah-selected aria-live="polite"></p>
          <div class="suas-lah-kits" data-lah-kits role="group" aria-label="Kit type"></div>

          <div class="suas-lah-trio-track" data-lah-trio-track hidden>
            <p class="suas-lah-step-label">trio path · build each formula</p>
            <p class="suas-lah-slot-hint">Pick notes for perfume, then body oil, then roll-on. Each product gets its own blend.</p>
            <div class="suas-lah-trio-steps" data-lah-trio-steps role="tablist" aria-label="Trio product steps"></div>
          </div>

          <div class="suas-lah-protocol" data-lah-protocol></div>

          <p class="suas-lah-step-label" data-lah-notes-label>02 · choose notes</p>
          <p class="suas-lah-slot-hint">Tap a tube to edit. Same note can fill more than one tube.</p>
          <div class="suas-lah-slotbar" data-lah-slots aria-live="polite"></div>

          <div class="suas-lah-filters" data-lah-filters role="group" aria-label="Filter scent families"></div>
          <div class="suas-lah-notes" data-lah-notes role="listbox" aria-label="Scent notes" aria-multiselectable="true"></div>
        </div>

        <aside class="suas-lah-stage">
          <div class="suas-lah-bottle-card">
            <p class="suas-lah-fill-status" data-lah-fill-status>0 / 30 mL filled</p>
            <div class="suas-lah-trio-hero" data-lah-trio-hero hidden>
              <img src="{{ 'lah-pack-trio.png' | asset_url }}" alt="Perfume, body oil, and roll-on trio bottles" width="360" height="240" data-lah-trio-img>
            </div>
            <div class="suas-lah-photo-stage" data-lah-bottle data-shape="perfume" aria-hidden="true">
              <div class="suas-lah-photo-body">
                <img class="suas-lah-photo-bottle" data-lah-photo-bottle src="{{ 'lah-pack-cylinder.png' | asset_url }}" alt="" width="210" height="320">
                <div class="suas-lah-photo-fill" data-lah-photo-fill>
                  <span class="suas-lah-photo-liquid" data-lah-liquid></span>
                </div>
              </div>
            </div>
            <div class="suas-lah-bottle-pick" data-lah-bottle-pick hidden>
              <p class="suas-lah-bottle-pick-label">bottle shape · silver sprayer</p>
              <div class="suas-lah-bottle-options" data-lah-bottle-options role="group" aria-label="30 mL perfume bottle"></div>
            </div>
            <ul class="suas-lah-recipe" data-lah-recipe></ul>
          </div>

          <div class="suas-lah-name-row">
            <label for="LahFormulaName">name your formula</label>
            <input id="LahFormulaName" class="suas-formula-input" type="text" maxlength="48" placeholder="ex: peachy glow" data-lah-name autocomplete="off">
          </div>

          <div class="suas-lah-actions">
            <button class="suas-lah-btn" type="button" data-lah-atc data-pink disabled>add to cart</button>
            <button class="suas-lah-btn suas-lah-btn-ghost" type="button" data-lah-reset>start over</button>
            <p class="suas-lah-error" data-lah-error role="alert"></p>
          </div>
        </aside>
      </div>
    </div>
  </div>

  <p class="suas-visually-hidden" data-lah-live aria-live="polite"></p>
</section>

<script>
  window.SUAS_LAB_HOME_NOTES = [
    { id: 'cherry', label: 'Cherry', family: 'fruit', hex: '#c41e3a', hex2: '#ff6b8a' },
    { id: 'strawberry', label: 'Strawberry', family: 'fruit', hex: '#e63946', hex2: '#ffb3c1' },
    { id: 'pineapple', label: 'Pineapple', family: 'fruit', hex: '#f4c430', hex2: '#fff1a8' },
    { id: 'apple', label: 'Apple', family: 'fruit', hex: '#7cb342', hex2: '#d9ff78' },
    { id: 'watermelon', label: 'Watermelon', family: 'fruit', hex: '#ff4d6d', hex2: '#c8f7c5' },
    { id: 'black-currant', label: 'Black Currant', family: 'fruit', hex: '#4a1942', hex2: '#c77dbb' },

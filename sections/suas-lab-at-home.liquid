    { id: 'cedar', label: 'Cedar', family: 'green', hex: '#74401f', hex2: '#c98445' }
  ];
</script>
<script src="{{ 'suas-lab-at-home.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "SUAS Lab @ Home",
  "tag": "section",
  "settings": [
    {"type":"text","id":"kicker","label":"Kicker","default":"SUAS.OS / THE LAB @ HOME"},
    {"type":"text","id":"heading","label":"Heading","default":"build your signature scent at home."},
    {"type":"textarea","id":"copy","label":"Copy","default":"Same protocol as The Lab. Pick your kit, pour your notes, watch the bottle fill, name it, and check out."},
    {"type":"header","content":"Products"},
    {"type":"product","id":"perfume_product","label":"Perfume kit product"},
    {"type":"product","id":"oil_product","label":"Body oil kit product"},
    {"type":"product","id":"rollon_product","label":"Roll-on kit product"},
    {"type":"product","id":"trio_product","label":"Trio product"}
  ],
  "presets": [
    {"name":"SUAS Lab @ Home"}
  ]
}
{% endschema %}

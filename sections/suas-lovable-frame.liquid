    <div class="suas-search-bar">
      <span aria-hidden="true"></span>
      <b id="suas-search-title">search.exe</b>
      <button class="suas-search-close" type="button" data-suas-search-close>close</button>
    </div>
    <form class="suas-search-body" action="{{ routes.search_url }}" method="get" role="search">
      <label for="suas-search-q-os">find a scent</label>
      <input id="suas-search-q-os" type="search" name="q" placeholder="poppy, butter, lab..." autocomplete="off" required>
      <button class="suas-search-go" type="submit">find it</button>
    </form>
  </div>
</div>

<script>
  (() => {
    const routes = { reviews: '/pages/reviews', account: '/pages/account' };
    const rewriteSuasHomeLinks = () => {
      document.querySelectorAll('.suas-world-home a[href="#suas-reviews"]').forEach((link) => { link.setAttribute('href', routes.reviews); });
      document.querySelectorAll('a[href="/account"], a[href="/pages/suas-account"], a[href="/pages/suas-accounts"], a[href="/pages/accounts"]').forEach((link) => { link.setAttribute('href', routes.account); });
      document.querySelectorAll('a[href="/pages/about"], a[href="/pages/about-us"]').forEach((link) => { link.setAttribute('href', '/pages/who-are-we'); });
      document.querySelectorAll('a[href="/account/login"], a[href="/account/login/"], a[href*="/account/login"]').forEach((link) => {
        const href = link.getAttribute('href') || '';
        if (href.indexOf('/account/login') !== -1) link.setAttribute('href', '/pages/account');
      });
      document.querySelectorAll('a[href="/account/register"], a[href="/account/register/"], a[href*="/account/register"]').forEach((link) => {
        link.setAttribute('href', '/pages/account#register');
      });
    };
    rewriteSuasHomeLinks();
    (function bindSuasSearch() {
      const layer = document.getElementById('suas-search-win');
      const input = document.getElementById('suas-search-q-os');
      if (!layer || !input) return;
      let lastFocus = null;
      const open = (event) => {
        if (event) event.preventDefault();
        lastFocus = document.activeElement;
        document.documentElement.classList.remove('suas-panel-open');
        layer.hidden = false;
        document.documentElement.classList.add('suas-search-open');
        window.setTimeout(() => input.focus(), 30);
      };
      const close = () => {
        layer.hidden = true;
        document.documentElement.classList.remove('suas-search-open');
        if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
      };
      document.querySelectorAll('[data-suas-search-open]').forEach((link) => {
        link.addEventListener('click', open);
      });
      layer.querySelectorAll('[data-suas-search-close]').forEach((node) => {
        node.addEventListener('click', close);
      });
      document.addEventListener('keydown', (event) => {
        if (!document.documentElement.classList.contains('suas-search-open')) return;
        if (event.key === 'Escape') {
          event.preventDefault();
          close();
        }
      });
    })();
    document.addEventListener('click', (event) => {
      const link = event.target.closest('a');
      if (!link || !link.href) return;
      let next = '';
      try {
        const url = new URL(link.href, location.origin);
        const path = url.pathname.replace(/\/+$/, '') || '/';
        if (path === '/account/register') next = '/pages/account#register';
        else if (path === '/account/login') next = '/pages/account';
        else if (url.hostname.indexOf('shopify.com') !== -1 && /authentication|account/.test(url.pathname)) next = path.indexOf('register') !== -1 || url.search.indexOf('signup') !== -1 ? '/pages/account#register' : '/pages/account';
      } catch (e) {}
      if (!next) return;
      event.preventDefault();
      window.location.href = next;
    }, true);
    new MutationObserver(rewriteSuasHomeLinks).observe(document.documentElement, { childList: true, subtree: true });
  })();
</script>


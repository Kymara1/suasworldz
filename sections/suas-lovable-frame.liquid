<style>
  @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
  @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}
  :root{--suas-ink:{{ section.settings.ink_color }};--suas-world:{{ section.settings.page_color }};--suas-pink:{{ section.settings.pink_color }};--suas-lime:{{ section.settings.lime_color }}}
  body{background:var(--suas-world)}
  .suas-frame,.suas-side-brand,.suas-side-label{font-family:'Casual Human',Futura,Arial,sans-serif!important;font-weight:700!important}
  .suas-frame-marquee{position:fixed;top:0;left:0;right:0;z-index:80;height:36px;overflow:hidden;background:var(--suas-ink);color:#fff;box-shadow:0 8px 20px -18px rgba(16,16,16,.85)}
  .suas-frame-marquee-track{display:inline-flex;min-width:200%;height:100%;align-items:center;white-space:nowrap;animation:suasFrameMarquee {{ section.settings.marquee_speed }}s linear infinite}
  .suas-frame-marquee-track span{display:inline-flex;align-items:center;gap:14px;padding:0 22px;font-size:17px;line-height:1;text-transform:lowercase}.suas-frame-marquee-track span:after{content:'+';color:rgba(255,255,255,.56)}
  @keyframes suasFrameMarquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  .suas-side-rail{position:fixed;inset:36px auto 0 0;z-index:55;width:252px;display:flex;flex-direction:column;background:linear-gradient(180deg,#fff 0%,#f6f7fa 60%,#eef0f5 100%);border-right:1px solid rgba(16,16,16,.1);box-shadow:inset -8px 0 20px -20px rgba(16,16,16,.2)}
  .suas-side-head{display:flex;align-items:center;gap:13px;padding:24px 20px 17px;color:var(--suas-ink);text-decoration:none}.suas-side-head:hover{color:var(--suas-ink);text-decoration:none}
  .suas-side-orb{width:45px;height:45px;border-radius:999px;background:radial-gradient(circle at 32% 20%,#fff 0 10%,transparent 32%),conic-gradient(from 210deg,#ffd8e8,#c9e7ff,#d8e26a,#ffd8e8);box-shadow:inset 0 -6px 12px rgba(0,0,0,.16),inset 0 6px 12px rgba(255,255,255,.85),0 8px 16px -8px rgba(16,16,16,.35)}
  .suas-side-brand{font-size:2.15rem;line-height:.9;text-transform:uppercase}.suas-side-kicker,.suas-side-status b,.suas-side-foot a,.suas-side-foot span{font-family:Futura,'Futura PT',Arial,sans-serif;font-size:10px;letter-spacing:.28em;text-transform:uppercase}.suas-side-kicker{margin:0 20px 12px;padding-top:16px;border-top:1px solid rgba(16,16,16,.13);color:rgba(16,16,16,.42)}
  .suas-side-nav{flex:1;overflow-y:auto;padding:6px 12px 14px}.suas-side-link{min-height:58px;display:grid;grid-template-columns:42px 1fr auto;align-items:center;gap:11px;padding:9px 12px;border-radius:999px;color:var(--suas-ink);text-decoration:none;transition:transform 180ms ease,background 180ms ease,color 180ms ease}.suas-side-link:hover{color:var(--suas-ink);background:rgba(255,255,255,.85);transform:translateX(3px);text-decoration:none}.suas-side-link.is-active{min-height:58px;margin:0;color:var(--suas-ink);background:#ffd8e8}
  .suas-side-icon{width:38px;height:38px;display:grid;place-items:center;border:1px solid rgba(16,16,16,.08);border-radius:999px;background:linear-gradient(180deg,#fff 0%,var(--tint) 130%);box-shadow:inset 0 1px 0 rgba(255,255,255,.9);font-size:18px}.suas-side-link.is-active .suas-side-icon{border-color:rgba(255,255,255,.28);background:rgba(255,255,255,.14)}.suas-side-label{font-size:1.65rem;line-height:.96;text-transform:uppercase}.suas-side-num{font-family:Futura,'Futura PT',Arial,sans-serif;font-size:11px;letter-spacing:.2em;opacity:.45}
  .suas-side-dropdown summary{cursor:pointer;list-style:none}.suas-side-dropdown summary::-webkit-details-marker{display:none}.suas-panel-submenu{display:grid;gap:6px;padding:0 4px 8px 52px}.suas-panel-submenu a{width:fit-content;max-width:100%;padding:6px 9px;border:1.5px solid #101010;border-radius:999px;color:var(--suas-ink);background:#fff;box-shadow:0 2px 0 #101010;font-family:Futura,'Futura PT',Arial,sans-serif;font-size:9px;font-weight:900;letter-spacing:.12em;text-decoration:none;text-transform:uppercase}.suas-panel-submenu a:nth-child(6n+1){background:#ffd8e8}.suas-panel-submenu a:nth-child(6n+2){background:#fff1a8}.suas-panel-submenu a:nth-child(6n+3){background:#cdeeff}.suas-panel-submenu a:nth-child(6n+4){background:#e4d5ff}.suas-panel-submenu a:nth-child(6n+5){background:#d9ff78}.suas-panel-submenu a:nth-child(6n+6){background:#ff9bc4}.suas-panel-submenu a:hover{filter:brightness(.97)}
  .suas-side-status{margin:10px 15px 12px;min-height:74px;display:flex;align-items:center;gap:11px;padding:16px 20px;border-radius:999px;background:rgba(255,255,255,.84);box-shadow:0 13px 30px rgba(16,16,16,.08)}.suas-side-status-dot{width:9px;height:9px;border-radius:999px;background:var(--suas-lime);box-shadow:0 0 14px rgba(198,247,106,.9);animation:suasPulse 1.6s ease-in-out infinite}.suas-side-status b,.suas-side-status span{display:block}.suas-side-status b{color:rgba(16,16,16,.42);margin-bottom:5px}.suas-side-status span{font-size:1.08rem;line-height:1;text-transform:uppercase}.suas-side-foot{display:flex;justify-content:space-between;gap:8px;padding:0 14px 16px}.suas-side-foot a,.suas-side-foot span{color:rgba(16,16,16,.46);text-decoration:none}@keyframes suasPulse{0%,100%{opacity:.35;transform:scale(.86)}50%{opacity:1;transform:scale(1.1)}}
  @media(min-width:1024px){.suas-side-rail{inset:30px auto 0 0;padding-top:14px;height:calc(100vh - 30px)}.off-canvas--main-content{margin-left:252px;width:calc(100% - 252px)}.header--root,.announcement--root{display:none!important}}
  @media(max-width:1023px){.header--root,.announcement--root{display:none!important}.suas-frame-marquee{height:34px}.suas-frame-marquee-track span{padding:0 18px;font-size:15px}.suas-side-rail{position:relative;inset:auto;top:auto;z-index:20;width:100%;display:grid;grid-template-columns:40px 1fr 40px;align-items:center;margin-top:34px;padding:4px 8px 8px;background:rgba(255,255,255,.96);border-right:0;border-bottom:1px solid rgba(16,16,16,.1)}.suas-side-head{grid-column:1/-1;grid-row:1;justify-content:center;gap:8px;padding:0 2px 6px}.suas-side-nav{grid-column:1/-1}.suas-side-orb{width:22px;height:22px}.suas-side-brand{font-size:1.05rem;line-height:1}.suas-side-kicker,.suas-side-status,.suas-side-foot{display:none}}
</style>

{% liquid
  assign suas_contact_page = pages['contact-us']
  if suas_contact_page == blank
    assign suas_contact_page = pages['contact']
  endif
  assign suas_contact_url = suas_contact_page.url | default: '/pages/contact-us'
%}

{% capture body_submenu_default %}Body|/collections/body-care
Butter Creme|/collections/butter-creme
Body Scrub|/collections/body-scrub
Body Jelly|/collections/body-jelly
Body Oil|/collections/body-oil
Cleansing Bar|/collections/cleansing-bar
Body Wash|/collections/body-wash{% endcapture %}
{% capture home_submenu_default %}Home Products|/collections/home-care
Candles|/collections/candles
Everything Mist|/collections/everything-mist
Burnt Oils|/collections/burnt-oils
Carpet Dust|/collections/carpet-dust
All Purpose Cleaner|/collections/all-purpose-cleaner{% endcapture %}
{% capture about_submenu_default %}Who are we|/pages/who-are-we
Book the Lab|/pages/bookings
Charm Bar|/pages/charm-bar
Parties & Events|/pages/parties-events
Contact Us|{{ suas_contact_url }}
Refund Policy|/pages/refund-policy{% endcapture %}

<div class="suas-frame" aria-label="SUAS site frame">
  <div class="suas-frame-marquee" aria-hidden="true"><div class="suas-frame-marquee-track">
    {% for i in (1..2) %}
      {% if section.settings.marquee_1 != blank %}<span>{{ section.settings.marquee_1 }}</span>{% endif %}
      {% if section.settings.marquee_2 != blank %}<span>{{ section.settings.marquee_2 }}</span>{% endif %}
      {% if section.settings.marquee_3 != blank %}<span>{{ section.settings.marquee_3 }}</span>{% endif %}
      {% if section.settings.marquee_4 != blank %}<span>{{ section.settings.marquee_4 }}</span>{% endif %}
      {% if section.settings.marquee_5 != blank %}<span>{{ section.settings.marquee_5 }}</span>{% endif %}
      {% if section.settings.marquee_6 != blank %}<span>{{ section.settings.marquee_6 }}</span>{% endif %}
    {% endfor %}
  </div></div>

  <aside class="suas-side-rail" aria-label="SUAS control panel">
    <a class="suas-side-head" href="{{ section.settings.home_link | default: routes.root_url }}" aria-label="Go to SUAS homepage"><span class="suas-side-orb" aria-hidden="true"></span><span class="suas-side-brand">{{ section.settings.brand_text }}</span></a>
    <p class="suas-side-kicker">{{ section.settings.control_label }}</p>
    <nav class="suas-side-nav">
      {% if section.settings.body_enabled %}
        {% liquid
          assign item_active = false
          assign body_active_paths = section.settings.body_active_paths | default: '/collections/body,/collections/body-care,/collections/butter-creme,/collections/cleansing-bar,/collections/body-scrub,/collections/body-jelly,/collections/body-oil,/collections/body-wash' | split: ','
          for active_path in body_active_paths
            assign clean_path = active_path | strip
            if clean_path != blank and request.path contains clean_path
              assign item_active = true
            endif
          endfor
          assign body_menu = linklists[section.settings.body_menu]
          assign body_collections = section.settings.body_collections
          assign body_submenu = section.settings.body_submenu | default: body_submenu_default
          assign body_rows = body_submenu | newline_to_br | split: '<br />'
          assign has_body_block_collections = false
          for dropdown_block in section.blocks
            if dropdown_block.type == 'dropdown_collection_item' and dropdown_block.settings.dropdown == 'body' and dropdown_block.settings.collection != blank
              assign has_body_block_collections = true
            endif
          endfor
        %}
        <details class="suas-side-dropdown" data-suas-mobile-keep="true"><summary class="suas-side-link{% if item_active %} is-active{% endif %}"><span class="suas-side-icon" style="--tint:{{ section.settings.body_tint }}">{{ section.settings.body_icon }}</span><span class="suas-side-label">{{ section.settings.body_label }}</span><span class="suas-side-num">{{ section.settings.body_number }}</span></summary><div class="suas-panel-submenu">{% if body_collections.size > 0 or has_body_block_collections %}{% for collection in body_collections %}<a href="{{ collection.url }}">{{ collection.title }}</a>{% endfor %}{% for dropdown_block in section.blocks %}{% if dropdown_block.type == 'dropdown_collection_item' and dropdown_block.settings.dropdown == 'body' and dropdown_block.settings.collection != blank %}{% assign item_title = dropdown_block.settings.label | default: dropdown_block.settings.collection.title %}<a href="{{ dropdown_block.settings.collection.url }}" {{ dropdown_block.shopify_attributes }}>{{ item_title }}</a>{% endif %}{% endfor %}{% elsif body_menu.links.size > 0 %}{% for link in body_menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% else %}{% for row in body_rows %}{% assign parts = row | strip | split: '|' %}{% assign link_label = parts[0] | strip %}{% assign link_url = parts[1] | strip %}{% if link_label != blank and link_url != blank %}<a href="{{ link_url }}">{{ link_label }}</a>{% endif %}{% endfor %}{% endif %}</div></details>
      {% endif %}

      {% if section.settings.home_enabled %}
        {% liquid
          assign item_active = false
          assign home_active_paths = section.settings.home_active_paths | default: '/collections/home,/collections/home-care,/collections/candles,/collections/everything-mist,/collections/burnt-oils,/collections/carpet-dust,/collections/all-purpose-cleaner' | split: ','
          for active_path in home_active_paths
            assign clean_path = active_path | strip
            if clean_path != blank and request.path contains clean_path
              assign item_active = true
            endif
          endfor
          assign home_menu = linklists[section.settings.home_menu]
          assign home_collections = section.settings.home_collections
          assign home_submenu = section.settings.home_submenu | default: home_submenu_default
          assign home_rows = home_submenu | newline_to_br | split: '<br />'
          assign has_home_block_collections = false
          for dropdown_block in section.blocks
            if dropdown_block.type == 'dropdown_collection_item' and dropdown_block.settings.dropdown == 'home' and dropdown_block.settings.collection != blank
              assign has_home_block_collections = true
            endif
          endfor
        %}
        <details class="suas-side-dropdown" data-suas-mobile-keep="true"><summary class="suas-side-link{% if item_active %} is-active{% endif %}"><span class="suas-side-icon" style="--tint:{{ section.settings.home_tint }}">{{ section.settings.home_icon }}</span><span class="suas-side-label">{{ section.settings.home_label }}</span><span class="suas-side-num">{{ section.settings.home_number }}</span></summary><div class="suas-panel-submenu">{% if home_collections.size > 0 or has_home_block_collections %}{% for collection in home_collections %}<a href="{{ collection.url }}">{{ collection.title }}</a>{% endfor %}{% for dropdown_block in section.blocks %}{% if dropdown_block.type == 'dropdown_collection_item' and dropdown_block.settings.dropdown == 'home' and dropdown_block.settings.collection != blank %}{% assign item_title = dropdown_block.settings.label | default: dropdown_block.settings.collection.title %}<a href="{{ dropdown_block.settings.collection.url }}" {{ dropdown_block.shopify_attributes }}>{{ item_title }}</a>{% endif %}{% endfor %}{% elsif home_menu.links.size > 0 %}{% for link in home_menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% else %}{% for row in home_rows %}{% assign parts = row | strip | split: '|' %}{% assign link_label = parts[0] | strip %}{% assign link_url = parts[1] | strip %}{% if link_label != blank and link_url != blank %}<a href="{{ link_url }}">{{ link_label }}</a>{% endif %}{% endfor %}{% endif %}</div></details>
      {% endif %}

      {% if section.settings.scent_enabled %}
        {% liquid
          assign item_active = false
          assign active_paths = section.settings.scent_active_paths | default: '/pages/scent-profile' | split: ','
          for active_path in active_paths
            assign clean_path = active_path | strip
            if clean_path != blank and request.path contains clean_path
              assign item_active = true
            endif
          endfor
        %}
        <a class="suas-side-link{% if item_active %} is-active{% endif %}" href="{{ section.settings.scent_link }}"><span class="suas-side-icon" style="--tint:{{ section.settings.scent_tint }}">{{ section.settings.scent_icon }}</span><span class="suas-side-label">{{ section.settings.scent_label }}</span><span class="suas-side-num">{{ section.settings.scent_number }}</span></a>
      {% endif %}
      {% if section.settings.oddities_enabled %}
        {% liquid
          assign item_active = false
          assign active_paths = section.settings.oddities_active_paths | default: '/collections/oddities' | split: ','
          for active_path in active_paths
            assign clean_path = active_path | strip
            if clean_path != blank and request.path contains clean_path
              assign item_active = true
            endif
          endfor
        %}
        <a class="suas-side-link{% if item_active %} is-active{% endif %}" href="{{ section.settings.oddities_link }}"><span class="suas-side-icon" style="--tint:{{ section.settings.oddities_tint }}">{{ section.settings.oddities_icon }}</span><span class="suas-side-label">{{ section.settings.oddities_label }}</span><span class="suas-side-num">{{ section.settings.oddities_number }}</span></a>
      {% endif %}
      {% if section.settings.lab_enabled %}
        {% liquid
          assign item_active = false
          assign active_paths = section.settings.lab_active_paths | default: '/pages/the-lab,/pages/bookings,/pages/charm-bar,/pages/parties-events' | split: ','
          for active_path in active_paths
            assign clean_path = active_path | strip
            if clean_path != blank and request.path contains clean_path
              assign item_active = true
            endif
          endfor
        %}
        <a class="suas-side-link{% if item_active %} is-active{% endif %}" data-suas-mobile-keep="true" href="{{ section.settings.lab_link }}"><span class="suas-side-icon" style="--tint:{{ section.settings.lab_tint }}">{{ section.settings.lab_icon }}</span><span class="suas-side-label">{{ section.settings.lab_label }}</span><span class="suas-side-num">{{ section.settings.lab_number }}</span></a>
      {% endif %}

      {% if section.settings.about_enabled %}
        {% liquid
          assign item_active = false
          assign about_active_paths = section.settings.about_active_paths | default: '/pages/about,/pages/who-are-we,/pages/bookings,/pages/charm-bar,/pages/parties-events,/pages/contact,/pages/refund-policy' | split: ','
          for active_path in about_active_paths
            assign clean_path = active_path | strip
            if clean_path != blank and request.path contains clean_path
              assign item_active = true
            endif
          endfor
          assign about_menu = linklists[section.settings.about_menu]
          assign about_submenu = section.settings.about_submenu | default: about_submenu_default
          assign about_rows = about_submenu | newline_to_br | split: '<br />'
          assign has_about_block_collections = false
          for dropdown_block in section.blocks
            if dropdown_block.type == 'dropdown_collection_item' and dropdown_block.settings.dropdown == 'about' and dropdown_block.settings.collection != blank
              assign has_about_block_collections = true
            endif
          endfor
        %}
        <details class="suas-side-dropdown" data-suas-mobile-keep="true"><summary class="suas-side-link{% if item_active %} is-active{% endif %}"><span class="suas-side-icon" style="--tint:{{ section.settings.about_tint }}">{{ section.settings.about_icon }}</span><span class="suas-side-label">{{ section.settings.about_label }}</span><span class="suas-side-num">{{ section.settings.about_number }}</span></summary><div class="suas-panel-submenu">{% if about_menu.links.size > 0 %}{% for link in about_menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% for dropdown_block in section.blocks %}{% if dropdown_block.type == 'dropdown_collection_item' and dropdown_block.settings.dropdown == 'about' and dropdown_block.settings.collection != blank %}{% assign item_title = dropdown_block.settings.label | default: dropdown_block.settings.collection.title %}<a href="{{ dropdown_block.settings.collection.url }}" {{ dropdown_block.shopify_attributes }}>{{ item_title }}</a>{% endif %}{% endfor %}{% elsif has_about_block_collections %}{% for dropdown_block in section.blocks %}{% if dropdown_block.type == 'dropdown_collection_item' and dropdown_block.settings.dropdown == 'about' and dropdown_block.settings.collection != blank %}{% assign item_title = dropdown_block.settings.label | default: dropdown_block.settings.collection.title %}<a href="{{ dropdown_block.settings.collection.url }}" {{ dropdown_block.shopify_attributes }}>{{ item_title }}</a>{% endif %}{% endfor %}{% else %}{% for row in about_rows %}{% assign parts = row | strip | split: '|' %}{% assign link_label = parts[0] | strip %}{% assign link_url = parts[1] | strip %}{% if link_label != blank and link_url != blank %}<a href="{{ link_url }}">{{ link_label }}</a>{% endif %}{% endfor %}{% endif %}</div></details>
      {% endif %}
      {% if section.settings.visit_enabled %}
        {% liquid
          assign item_active = false
          assign active_paths = section.settings.visit_active_paths | default: '/pages/visit-us' | split: ','
          for active_path in active_paths
            assign clean_path = active_path | strip
            if clean_path != blank and request.path contains clean_path
              assign item_active = true
            endif
          endfor
        %}
        <a class="suas-side-link{% if item_active %} is-active{% endif %}" href="{{ section.settings.visit_link }}"><span class="suas-side-icon" style="--tint:{{ section.settings.visit_tint }}">{{ section.settings.visit_icon }}</span><span class="suas-side-label">{{ section.settings.visit_label }}</span><span class="suas-side-num">{{ section.settings.visit_number }}</span></a>
      {% endif %}

      {% for block in section.blocks %}
        {% if block.type == 'panel_item' %}
          {% liquid
            assign extra_title = block.settings.label
            assign extra_url = block.settings.link
            if block.settings.collection != blank
              assign extra_url = block.settings.collection.url
              if extra_title == blank
                assign extra_title = block.settings.collection.title
              endif
            elsif block.settings.page != blank
              assign extra_url = block.settings.page.url
              if extra_title == blank
                assign extra_title = block.settings.page.title
              endif
            endif
            if extra_title == blank
              assign extra_title = 'new item'
            endif
            assign item_active = false
            if extra_url != blank and request.path contains extra_url
              assign item_active = true
            endif
            assign extra_active_paths = block.settings.active_paths | split: ','
            for active_path in extra_active_paths
              assign clean_path = active_path | strip
              if clean_path != blank and request.path contains clean_path
                assign item_active = true
              endif
            endfor
            assign extra_menu = linklists[block.settings.menu]
            assign extra_submenu = block.settings.submenu
            assign extra_rows = extra_submenu | newline_to_br | split: '<br />'
          %}
          {% if extra_menu.links.size > 0 or block.settings.submenu != blank %}
            <details class="suas-side-dropdown" {{ block.shopify_attributes }}><summary class="suas-side-link{% if item_active %} is-active{% endif %}"><span class="suas-side-icon" style="--tint:{{ block.settings.tint }}">{{ block.settings.icon }}</span><span class="suas-side-label">{{ extra_title }}</span><span class="suas-side-num">{{ block.settings.number }}</span></summary><div class="suas-panel-submenu">{% if extra_menu.links.size > 0 %}{% for link in extra_menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% else %}{% for row in extra_rows %}{% assign parts = row | strip | split: '|' %}{% assign link_label = parts[0] | strip %}{% assign link_url = parts[1] | strip %}{% if link_label != blank and link_url != blank %}<a href="{{ link_url }}">{{ link_label }}</a>{% endif %}{% endfor %}{% endif %}</div></details>
          {% else %}
            <a class="suas-side-link{% if item_active %} is-active{% endif %}" href="{{ extra_url | default: routes.root_url }}" {{ block.shopify_attributes }}><span class="suas-side-icon" style="--tint:{{ block.settings.tint }}">{{ block.settings.icon }}</span><span class="suas-side-label">{{ extra_title }}</span><span class="suas-side-num">{{ block.settings.number }}</span></a>
          {% endif %}
        {% endif %}
      {% endfor %}
    </nav>
    <div class="suas-side-status"><span class="suas-side-status-dot" aria-hidden="true"></span><div><b>{{ section.settings.status_label }}</b><span>{{ section.settings.status_text }}</span></div></div>
    <div class="suas-side-foot" aria-hidden="true"><a href="{{ section.settings.footer_link_1 }}">{{ section.settings.footer_label_1 }}</a><a href="{{ section.settings.footer_link_2 }}">{{ section.settings.footer_label_2 }}</a><span>{{ section.settings.version_text }}</span></div>
  </aside>
</div>

<script>
  (() => {
    const routes = { reviews: '/pages/reviews', account: '/pages/account' };
    const rewriteSuasHomeLinks = () => {
      document.querySelectorAll('.suas-world-home a[href="#suas-reviews"]').forEach((link) => { link.setAttribute('href', routes.reviews); });
      document.querySelectorAll('.suas-world-home a[href="/account"], .suas-world-home a[href="/pages/suas-account"], .suas-world-home a[href="/pages/suas-accounts"], .suas-world-home a[href="/pages/accounts"], .suas-side-foot a[href="/account"], .suas-side-foot a[href="/pages/suas-account"], .suas-side-foot a[href="/pages/suas-accounts"], .suas-side-foot a[href="/pages/accounts"]').forEach((link) => { link.setAttribute('href', routes.account); });
    };

<style>
  @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
  @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}
  :root{--suas-ink:{{ section.settings.ink_color }};--suas-world:{{ section.settings.page_color }};--suas-pink:{{ section.settings.pink_color }};--suas-lime:{{ section.settings.lime_color }}}
  body{background:var(--suas-world)}
  .suas-frame,.suas-side-brand,.suas-side-label{font-family:'Casual Human',Futura,Arial,sans-serif!important;font-weight:700!important}
  .suas-frame-marquee{position:fixed;top:0;left:0;right:0;z-index:80;height:36px;overflow:hidden;background:var(--suas-ink);color:#fff;box-shadow:0 8px 20px -18px rgba(16,16,16,.85)}
  .suas-frame-marquee-track{display:inline-flex;min-width:200%;height:100%;align-items:center;white-space:nowrap;animation:suasFrameMarquee {{ section.settings.marquee_speed }}s linear infinite}
  .suas-frame-marquee-track span{display:inline-flex;align-items:center;gap:14px;padding:0 22px;font-size:17px;line-height:1;text-transform:lowercase}.suas-frame-marquee-track span:after{content:'+';color:rgba(255,255,255,.56)}
  @keyframes suasFrameMarquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  .suas-side-rail{position:fixed;inset:36px auto 0 0;z-index:55;width:252px;display:flex;flex-direction:column;background:linear-gradient(180deg,#fff 0%,#f6f7fa 60%,#eef0f5 100%);border-right:1px solid rgba(16,16,16,.1);box-shadow:inset -8px 0 20px -20px rgba(16,16,16,.2)}
  .suas-side-head{display:flex;align-items:center;gap:13px;padding:24px 20px 17px;color:var(--suas-ink);text-decoration:none}.suas-side-head:hover{color:var(--suas-ink);text-decoration:none}
  .suas-side-orb{width:45px;height:45px;border-radius:999px;background:radial-gradient(circle at 32% 20%,#fff 0 10%,transparent 32%),conic-gradient(from 210deg,#ffd8e8,#c9e7ff,#d8e26a,#ffd8e8);box-shadow:inset 0 -6px 12px rgba(0,0,0,.16),inset 0 6px 12px rgba(255,255,255,.85),0 8px 16px -8px rgba(16,16,16,.35)}
  .suas-side-brand{font-size:2.15rem;line-height:.9;text-transform:uppercase}.suas-side-kicker,.suas-side-status b,.suas-side-foot a,.suas-side-foot span{font-family:Futura,'Futura PT',Arial,sans-serif;font-size:10px;letter-spacing:.28em;text-transform:uppercase}.suas-side-kicker{margin:0 20px 12px;padding-top:16px;border-top:1px solid rgba(16,16,16,.13);color:rgba(16,16,16,.42)}
  .suas-side-nav{flex:1;min-height:0;overflow-y:auto;padding:4px 10px 8px;scrollbar-width:none;-ms-overflow-style:none}.suas-side-nav::-webkit-scrollbar{width:0;height:0;display:none}.suas-side-link{min-height:44px;display:grid;grid-template-columns:38px 1fr auto;align-items:center;gap:8px;padding:6px 10px;border-radius:999px;color:var(--suas-ink);text-decoration:none;transition:transform 180ms ease,background 180ms ease,color 180ms ease}.suas-side-link:hover{color:var(--suas-ink);background:rgba(255,255,255,.85);transform:translateX(3px);text-decoration:none}.suas-side-link.is-active{min-height:44px;margin:0;color:var(--suas-ink);background:#ffd8e8}
  .suas-side-icon{width:32px;height:32px;display:grid;place-items:center;border:1px solid rgba(16,16,16,.08);border-radius:999px;background:linear-gradient(180deg,#fff 0%,var(--tint) 130%);box-shadow:inset 0 1px 0 rgba(255,255,255,.9);font-size:16px}.suas-side-link.is-active .suas-side-icon{border-color:rgba(255,255,255,.28);background:rgba(255,255,255,.14)}.suas-side-label{font-size:1.35rem;line-height:1;text-transform:uppercase;white-space:nowrap}.suas-side-num{font-family:Futura,'Futura PT',Arial,sans-serif;font-size:10px;letter-spacing:.2em;opacity:.45}
  .suas-side-dropdown summary{cursor:pointer;list-style:none}.suas-side-dropdown summary::-webkit-details-marker{display:none}.suas-panel-submenu{display:grid;gap:6px;padding:0 4px 8px 52px}.suas-panel-submenu a{width:fit-content;max-width:100%;padding:6px 9px;border:1.5px solid #101010;border-radius:999px;color:var(--suas-ink);background:#fff;box-shadow:0 2px 0 #101010;font-family:Futura,'Futura PT',Arial,sans-serif;font-size:9px;font-weight:900;letter-spacing:.12em;text-decoration:none;text-transform:uppercase}.suas-panel-submenu a:nth-child(6n+1){background:#ffd8e8}.suas-panel-submenu a:nth-child(6n+2){background:#fff1a8}.suas-panel-submenu a:nth-child(6n+3){background:#cdeeff}.suas-panel-submenu a:nth-child(6n+4){background:#e4d5ff}.suas-panel-submenu a:nth-child(6n+5){background:#d9ff78}.suas-panel-submenu a:nth-child(6n+6){background:#ff9bc4}.suas-panel-submenu a:hover{filter:brightness(.97)}
  .suas-side-status{margin:10px 15px 12px;min-height:74px;display:flex;align-items:center;gap:11px;padding:16px 20px;border-radius:999px;background:rgba(255,255,255,.84);box-shadow:0 13px 30px rgba(16,16,16,.08)}.suas-side-status-dot{width:9px;height:9px;border-radius:999px;background:var(--suas-lime);box-shadow:0 0 14px rgba(198,247,106,.9);animation:suasPulse 1.6s ease-in-out infinite}.suas-side-status b,.suas-side-status span{display:block}.suas-side-status b{color:rgba(16,16,16,.42);margin-bottom:5px}.suas-side-status span{font-size:1.08rem;line-height:1;text-transform:uppercase}.suas-side-foot{display:flex;justify-content:space-between;gap:8px;padding:0 14px 16px}.suas-side-foot a,.suas-side-foot span{color:rgba(16,16,16,.46);text-decoration:none}@keyframes suasPulse{0%,100%{opacity:.35;transform:scale(.86)}50%{opacity:1;transform:scale(1.1)}}
  @media(min-width:1024px){.suas-side-rail{inset:36px auto 0 0;padding-top:4px;height:calc(100vh - 36px)}.off-canvas--main-content{margin-left:252px;width:calc(100% - 252px)}.header--root,.announcement--root{display:none!important}}
  @media(max-width:1023px){.header--root,.announcement--root{display:none!important}.suas-frame-marquee{height:34px}.suas-frame-marquee-track span{padding:0 18px;font-size:15px}}
  .suas-os-search{display:inline-grid;place-items:center;width:40px;min-width:40px;height:40px;padding:0;border:1.5px solid #101010;border-radius:999px;background:#d9ff78;color:#101010!important;box-shadow:0 2px 0 #101010;text-decoration:none;flex:0 0 auto}
  .suas-os-search svg{display:block}
  .suas-side-foot a:focus-visible,.suas-os-search:focus-visible,.suas-panel-toggle:focus-visible,.suas-side-link:focus-visible,.suas-panel-submenu a:focus-visible{outline:3px solid var(--suas-ink);outline-offset:3px}
  .suas-skip{position:absolute;left:8px;top:8px;z-index:2147483647;display:flex;gap:8px}
  .suas-search-layer{position:fixed;inset:0;z-index:2147483000;display:grid;place-items:center;padding:18px}
  .suas-search-layer[hidden]{display:none!important}
  .suas-search-scrim{position:absolute;inset:0;background:rgba(16,16,16,.42)}
  .suas-search-win{position:relative;z-index:1;width:min(420px,100%);border:2px solid #101010;border-radius:22px;background:#fff;box-shadow:5px 6px 0 #101010;overflow:hidden;font-family:Futura,'Futura PT',Arial,sans-serif}
  .suas-search-bar{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:8px;min-height:40px;padding:8px 12px;border-bottom:2px solid #101010;background:linear-gradient(180deg,#fff,#e8edf3)}
  .suas-search-bar b{text-align:center;font:900 10px/1 Futura,Arial,sans-serif;letter-spacing:.18em;text-transform:uppercase}
  .suas-search-close{min-height:32px;padding:0 10px;border:1.5px solid #101010;border-radius:999px;background:#ffd8e8;box-shadow:0 2px 0 #101010;font:900 9px/1 Futura,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase;cursor:pointer}
  .suas-search-body{display:grid;gap:10px;padding:16px}
  .suas-search-body label{font:900 10px/1 Futura,Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase}
  .suas-search-body input{width:100%;min-height:48px;border:2px solid #101010;border-radius:14px;padding:10px 12px;font:800 16px/1.2 Futura,Arial,sans-serif}
  .suas-search-body input:focus{outline:3px solid #101010;outline-offset:2px}
  .suas-search-go{min-height:48px;border:2px solid #101010;border-radius:999px;background:#d9ff78;box-shadow:0 3px 0 #101010;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:1.35rem;cursor:pointer}
  html.suas-search-open,html.suas-search-open body{overflow:hidden}
  @media(prefers-reduced-motion:reduce){.suas-frame-marquee-track{animation:none!important}}
</style>

{% liquid
  assign suas_contact_page = pages['contact-us']
  if suas_contact_page == blank
    assign suas_contact_page = pages['contact']
  endif
  assign suas_contact_url = suas_contact_page.url | default: '/pages/contact-us'
  if suas_contact_url == blank or suas_contact_url == '/pages/contact'
    assign suas_contact_url = '/pages/contact-us'
  endif
%}

{% capture body_submenu_default %}Body|/collections/body
Butter Creme|/collections/butter-creme
Body Scrub|/collections/body-scrub
Body Jelly|/collections/body-jelly
Body Oil|/collections/body-oil
Cleansing Bar|/collections/cleansing-bar
Body Wash|/collections/body-wash{% endcapture %}
{% capture home_submenu_default %}Home Products|/collections/home
Candles|/collections/candles
Everything Mist|/collections/everything-mist
Burnt Oils|/collections/burnt-oils
Incense|/collections/incense
Carpet Dust|/collections/carpet-dust
All Purpose Cleaner|/collections/all-purpose-cleaner{% endcapture %}
{% capture shared_submenu_default %}Cleansing Bar|/collections/cleansing-bar
Body Oil|/collections/body-oil
Body Wash|/collections/body-wash
Butter Creme|/collections/butter-creme
Cologne|/collections/cologne
Perfume|/collections/eau-de-parfum
Skin Jelly|/collections/body-jelly{% endcapture %}
{% capture about_submenu_default %}Who are we|/pages/who-are-we
Book the Lab|/pages/bookings
Charm Bar|/pages/charm-bar
Contact Us|{{ suas_contact_url }}
Refund Policy|/pages/refund-policy{% endcapture %}
{% if template.suffix == 'suas-men' or template.suffix == 'suas-men-inner' or template.suffix == 'cologne' or template.suffix == 'exfoliating-body-wash' or template.suffix contains 'men-s-' or template.suffix contains 'masculine' or template.suffix contains 'beard' or template.suffix contains 'm-body' or template.suffix contains 'm-butter' or template.suffix contains 'm-eau' or template.suffix contains 'm-skin' %}
  {% assign suas_men_panel = true %}
{% else %}
  {% assign suas_men_panel = false %}
{% endif %}

<div class="suas-frame" aria-label="{% if suas_men_panel %}SUAS Men control panel{% else %}SUAS site frame{% endif %}">
  <div class="suas-frame-marquee" aria-hidden="true"><div class="suas-frame-marquee-track">
    {% for i in (1..2) %}
      {% if suas_men_panel %}
        <span>suas men</span><span>the rack</span><span>cologne. oil. beard.</span><span>the lab is mixing</span><span>handmade in gastonia</span><span>no bouquet copy</span>
      {% else %}
        {% if section.settings.marquee_1 != blank %}<span>{{ section.settings.marquee_1 }}</span>{% endif %}
        {% if section.settings.marquee_2 != blank %}<span>{{ section.settings.marquee_2 }}</span>{% endif %}
        {% if section.settings.marquee_3 != blank %}<span>{{ section.settings.marquee_3 }}</span>{% endif %}
        {% if section.settings.marquee_4 != blank %}<span>{{ section.settings.marquee_4 }}</span>{% endif %}
        {% if section.settings.marquee_5 != blank %}<span>{{ section.settings.marquee_5 }}</span>{% endif %}
        {% if section.settings.marquee_6 != blank %}<span>{{ section.settings.marquee_6 }}</span>{% endif %}
      {% endif %}
    {% endfor %}
  </div></div>

  <div class="suas-mobile-bar">
    <a class="suas-side-head suas-mobile-home" href="{% if suas_men_panel %}/pages/suas-men{% else %}{{ section.settings.home_link | default: routes.root_url }}{% endif %}" aria-label="{% if suas_men_panel %}SUAS Men{% else %}Go to SUAS homepage{% endif %}"><span class="suas-side-orb" aria-hidden="true"></span><span class="suas-side-brand">{% if suas_men_panel %}SUAS{% else %}{{ section.settings.brand_text }}{% endif %}</span></a>
    <div class="suas-mobile-bar-actions">
      {% render 'suas-os-search' %}
      <button type="button" class="suas-panel-toggle" aria-expanded="false" aria-controls="suas-control-panel">
        <span class="suas-panel-toggle-lines" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="suas-panel-toggle-text">menu</span>
      </button>
    </div>
  </div>
  <div class="suas-panel-scrim" hidden></div>

  <aside class="suas-side-rail" id="suas-control-panel" aria-label="{% if suas_men_panel %}SUAS Men control panel{% else %}SUAS control panel{% endif %}">
    <a class="suas-side-head" href="{% if suas_men_panel %}/pages/suas-men{% else %}{{ section.settings.home_link | default: routes.root_url }}{% endif %}" aria-label="{% if suas_men_panel %}SUAS Men{% else %}Go to SUAS homepage{% endif %}"><span class="suas-side-orb" aria-hidden="true"></span><span class="suas-side-brand">{% if suas_men_panel %}SUAS{% else %}{{ section.settings.brand_text }}{% endif %}</span></a>
    <p class="suas-side-kicker">{% if suas_men_panel %}men terminal{% else %}{{ section.settings.control_label }}{% endif %}</p>
    <nav class="suas-side-nav" aria-label="{% if suas_men_panel %}SUAS Men menu{% else %}SUAS menu{% endif %}">
      {% if suas_men_panel %}
        <a class="suas-side-link{% if request.path contains '/collections/cologne' %} is-active{% endif %}" href="/collections/cologne"><span class="suas-side-icon" style="--tint:#fff">01</span><span class="suas-side-label">cologne</span><span class="suas-side-num">01</span></a>
        <a class="suas-side-link{% if request.path contains '/collections/m-body-oil' %} is-active{% endif %}" href="/collections/m-body-oil"><span class="suas-side-icon" style="--tint:#fff">02</span><span class="suas-side-label">oil</span><span class="suas-side-num">02</span></a>
        <a class="suas-side-link{% if request.path contains '/collections/m-butter-creme' %} is-active{% endif %}" href="/collections/m-butter-creme"><span class="suas-side-icon" style="--tint:#fff">03</span><span class="suas-side-label">butter</span><span class="suas-side-num">03</span></a>
        <a class="suas-side-link{% if request.path contains '/collections/exfoliating-body-wash' %} is-active{% endif %}" href="/collections/exfoliating-body-wash"><span class="suas-side-icon" style="--tint:#fff">04</span><span class="suas-side-label">wash</span><span class="suas-side-num">04</span></a>
        <a class="suas-side-link{% if request.path contains '/collections/beard' %} is-active{% endif %}" href="/collections/beard"><span class="suas-side-icon" style="--tint:#fff">05</span><span class="suas-side-label">beard</span><span class="suas-side-num">05</span></a>
        <details class="suas-side-dropdown"{% if request.path contains '/pages/visit-us' or request.path contains '/pages/bookings' or request.path contains '/pages/the-lab' %} open{% endif %}><summary class="suas-side-link{% if request.path contains '/pages/visit-us' or request.path contains '/pages/bookings' or request.path contains '/pages/the-lab' %} is-active{% endif %}"><span class="suas-side-icon" style="--tint:#fff">06</span><span class="suas-side-label">visit us</span><span class="suas-side-num">06</span></summary><div class="suas-panel-submenu"><a href="/pages/visit-us">Visit Us</a><a href="/pages/bookings">The Lab</a></div></details>
        <a class="suas-side-link" href="/"><span class="suas-side-icon" style="--tint:#fff">07</span><span class="suas-side-label">exit</span><span class="suas-side-num">07</span></a>
      {% else %}
      {% if section.settings.body_enabled %}
        {% liquid
          assign item_active = false
          assign body_active_paths = section.settings.body_active_paths | default: '/collections/body,/collections/body-care,/collections/butter-creme,/collections/cleansing-bar,/collections/body-scrub,/collections/body-jelly,/collections/body-oil,/collections/body-wash' | split: ','
          for active_path in body_active_paths
            assign clean_path = active_path | strip
            if clean_path != blank and request.path contains clean_path
              assign item_active = true
            endif
          endfor
          assign body_menu = linklists[section.settings.body_menu]
          assign body_collections = section.settings.body_collections
          assign body_submenu = section.settings.body_submenu | default: body_submenu_default
          assign body_rows = body_submenu | newline_to_br | split: '<br />'
          assign has_body_block_collections = false
          for dropdown_block in section.blocks
            if dropdown_block.type == 'dropdown_collection_item' and dropdown_block.settings.dropdown == 'body' and dropdown_block.settings.collection != blank
              assign has_body_block_collections = true
            endif
          endfor
        %}
        <details class="suas-side-dropdown" data-suas-mobile-keep="true"><summary class="suas-side-link{% if item_active %} is-active{% endif %}"><span class="suas-side-icon" style="--tint:{{ section.settings.body_tint }}">{{ section.settings.body_icon }}</span><span class="suas-side-label">{{ section.settings.body_label }}</span><span class="suas-side-num">{{ section.settings.body_number }}</span></summary><div class="suas-panel-submenu">{% if body_collections.size > 0 or has_body_block_collections %}{% for collection in body_collections %}<a href="{{ collection.url }}">{{ collection.title }}</a>{% endfor %}{% for dropdown_block in section.blocks %}{% if dropdown_block.type == 'dropdown_collection_item' and dropdown_block.settings.dropdown == 'body' and dropdown_block.settings.collection != blank %}{% assign item_title = dropdown_block.settings.label | default: dropdown_block.settings.collection.title %}<a href="{{ dropdown_block.settings.collection.url }}" {{ dropdown_block.shopify_attributes }}>{{ item_title }}</a>{% endif %}{% endfor %}{% elsif body_menu.links.size > 0 %}{% for link in body_menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% else %}{% for row in body_rows %}{% assign parts = row | strip | split: '|' %}{% assign link_label = parts[0] | strip %}{% assign link_url = parts[1] | strip %}{% if link_label != blank and link_url != blank %}<a href="{{ link_url }}">{{ link_label }}</a>{% endif %}{% endfor %}{% endif %}</div></details>
      {% endif %}

      {% if false %}
        {% liquid
          assign item_active = false
          assign home_active_paths = section.settings.home_active_paths | default: '/collections/home,/collections/home-care,/collections/candles,/collections/everything-mist,/collections/burnt-oils,/collections/incense,/collections/carpet-dust,/collections/all-purpose-cleaner' | split: ','
          for active_path in home_active_paths
            assign clean_path = active_path | strip
            if clean_path != blank and request.path contains clean_path
              assign item_active = true
            endif
          endfor
          assign home_menu = linklists[section.settings.home_menu]
          assign home_collections = section.settings.home_collections
          assign home_submenu = section.settings.home_submenu | default: home_submenu_default
          assign home_rows = home_submenu | newline_to_br | split: '<br />'
          assign has_home_block_collections = false
          for dropdown_block in section.blocks
            if dropdown_block.type == 'dropdown_collection_item' and dropdown_block.settings.dropdown == 'home' and dropdown_block.settings.collection != blank
              assign has_home_block_collections = true
            endif
          endfor
        %}
        <details class="suas-side-dropdown" data-suas-mobile-keep="true"><summary class="suas-side-link{% if item_active %} is-active{% endif %}"><span class="suas-side-icon" style="--tint:{{ section.settings.home_tint }}">{{ section.settings.home_icon }}</span><span class="suas-side-label">{{ section.settings.home_label }}</span><span class="suas-side-num">{{ section.settings.home_number }}</span></summary><div class="suas-panel-submenu">{% if home_collections.size > 0 or has_home_block_collections %}{% for collection in home_collections %}<a href="{{ collection.url }}">{{ collection.title }}</a>{% endfor %}{% for dropdown_block in section.blocks %}{% if dropdown_block.type == 'dropdown_collection_item' and dropdown_block.settings.dropdown == 'home' and dropdown_block.settings.collection != blank %}{% assign item_title = dropdown_block.settings.label | default: dropdown_block.settings.collection.title %}<a href="{{ dropdown_block.settings.collection.url }}" {{ dropdown_block.shopify_attributes }}>{{ item_title }}</a>{% endif %}{% endfor %}{% elsif home_menu.links.size > 0 %}{% for link in home_menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% else %}{% for row in home_rows %}{% assign parts = row | strip | split: '|' %}{% assign link_label = parts[0] | strip %}{% assign link_url = parts[1] | strip %}{% if link_label != blank and link_url != blank %}<a href="{{ link_url }}">{{ link_label }}</a>{% endif %}{% endfor %}{% endif %}</div></details>
      {% endif %}

      {% if section.settings.shared_enabled %}
        {% liquid
          assign item_active = false
          assign shared_active_paths = section.settings.shared_active_paths | default: '/collections/shared' | split: ','
          for active_path in shared_active_paths
            assign clean_path = active_path | strip
            if clean_path != blank and request.path contains clean_path
              assign item_active = true
            endif
          endfor
          assign shared_menu = linklists[section.settings.shared_menu]
          assign shared_collections = section.settings.shared_collections
          assign shared_submenu = section.settings.shared_submenu | default: shared_submenu_default
          assign shared_rows = shared_submenu | newline_to_br | split: '<br />'
          assign has_shared_block_collections = false
          for dropdown_block in section.blocks
            if dropdown_block.type == 'dropdown_collection_item' and dropdown_block.settings.dropdown == 'shared' and dropdown_block.settings.collection != blank
              assign has_shared_block_collections = true
            endif
          endfor
        %}

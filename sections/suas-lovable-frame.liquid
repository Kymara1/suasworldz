utes }}>{{ item_title }}</a>{% endunless %}{% endif %}{% endfor %}{% else %}{% for row in about_rows %}{% assign parts = row | strip | split: '|' %}{% assign link_label = parts[0] | strip %}{% assign link_url = parts[1] | strip %}{% assign link_down = link_label | downcase %}{% if link_url == '/pages/contact' %}{% assign link_url = '/pages/contact-us' %}{% endif %}{% if link_label != blank and link_url != blank %}{% unless link_down contains 'parties' or link_down contains 'event' or link_down contains 'visit' %}<a href="{{ link_url }}">{{ link_label }}</a>{% endunless %}{% endif %}{% endfor %}{% endif %}</div></details>

<style>
  @font-face {
    font-family: 'Casual Human';
    src: url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');
    font-display: swap;
  }

  @font-face {
    font-family: 'Casual Human';
    src: url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');
    font-weight: 700;
    font-display: swap;
  }

  :root {
    --suas-ink: {{ section.settings.ink_color }};
    --suas-world: {{ section.settings.page_color }};
    --suas-pink: {{ section.settings.pink_color }};
    --suas-lime: {{ section.settings.lime_color }};
  }

  body { background: var(--suas-world); }

  .suas-frame,
  .suas-font,
  .suas-side-brand,
  .suas-side-label,
  .suas-panel-brand,
  .suas-panel-label,
  .suas-panel-hero h2,
  .suas-lab-title,
  .suas-lab-subtitle,
  .suas-lab-step span,
  .suas-session h3,
  .suas-price,
  .suas-formula-head h2,
  .suas-size-btn strong,
  .suas-note-btn strong,
  .suas-review-title,
  .suas-review-bubble,
  .suas-password-title,
  .suas-password-prompt {
    font-family: 'Casual Human', Futura, Arial, sans-serif !important;
    font-weight: 700 !important;
  }

  .suas-frame-marquee {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 80;
    height: 36px;
    overflow: hidden;
    background: var(--suas-ink);
    color: #fff;
    border-bottom: 1px solid rgba(16, 16, 16, 0.12);
    box-shadow: 0 8px 20px -18px rgba(16, 16, 16, 0.85);
  }

  .suas-frame-marquee-track {
    display: inline-flex;
    min-width: 200%;
    height: 100%;
    align-items: center;
    white-space: nowrap;
    animation: suasFrameMarquee {{ section.settings.marquee_speed }}s linear infinite;
  }

  .suas-frame-marquee-track span {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 0 22px;
    font-size: 17px;
    line-height: 1;
    text-transform: lowercase;
  }

  .suas-frame-marquee-track span:after {
    content: "+";
    color: rgba(255, 255, 255, 0.56);
  }

  @keyframes suasFrameMarquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .suas-side-rail {
    position: fixed;
    inset: 36px auto 0 0;
    z-index: 55;
    width: 252px;
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, #fff 0%, #f6f7fa 60%, #eef0f5 100%);
    border-right: 1px solid rgba(16, 16, 16, 0.1);
    box-shadow: inset -8px 0 20px -20px rgba(16, 16, 16, 0.2);
  }

  .suas-side-head {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 24px 20px 17px;
    color: var(--suas-ink);
    text-decoration: none;
  }

  .suas-side-orb {
    width: 45px;
    height: 45px;
    border-radius: 999px;
    background: radial-gradient(circle at 32% 20%, #fff 0 10%, transparent 32%), conic-gradient(from 210deg, #ffd8e8, #c9e7ff, #d8e26a, #ffd8e8);
    box-shadow: inset 0 -6px 12px rgba(0, 0, 0, 0.16), inset 0 6px 12px rgba(255, 255, 255, 0.85), 0 8px 16px -8px rgba(16, 16, 16, 0.35);
  }

  .suas-side-brand {
    font-size: 2.15rem;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .suas-side-kicker,
  .suas-side-status b,
  .suas-side-foot a,
  .suas-side-foot span {
    font-family: Futura, 'Futura PT', Arial, sans-serif;
    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .suas-side-kicker {
    margin: 0 20px 12px;
    padding-top: 16px;
    border-top: 1px solid rgba(16, 16, 16, 0.13);
    color: rgba(16, 16, 16, 0.42);
  }

  .suas-side-nav {
    flex: 1;
    overflow-y: auto;
    padding: 6px 12px 14px;
  }

  .suas-side-link {
    min-height: 58px;
    display: grid;
    grid-template-columns: 42px 1fr auto;
    align-items: center;
    gap: 11px;
    padding: 9px 12px;
    border-radius: 999px;
    color: var(--suas-ink);
    text-decoration: none;
    transition: transform 180ms ease, background 180ms ease, color 180ms ease;
  }

  .suas-side-link:hover {
    color: var(--suas-ink);
    background: rgba(255, 255, 255, 0.85);
    transform: translateX(3px);
  }

  .suas-side-link.is-active {
    min-height: 70px;
    margin: 8px -2px;
    color: #fff;
    background: var(--suas-ink);
  }

  .suas-side-icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(16, 16, 16, 0.08);
    border-radius: 999px;
    background: linear-gradient(180deg, #fff 0%, var(--tint) 130%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
    font-size: 18px;
  }

  .suas-side-link.is-active .suas-side-icon {
    border-color: rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.14);
  }

  .suas-side-label {
    font-size: 1.65rem;
    line-height: 0.96;
    text-transform: uppercase;
  }

  .suas-side-num {
    font-family: Futura, 'Futura PT', Arial, sans-serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    opacity: 0.45;
  }

  .suas-side-dropdown summary {
    cursor: pointer;
    list-style: none;
  }

  .suas-side-dropdown summary::-webkit-details-marker { display: none; }

  .suas-panel-submenu {
    display: grid;
    gap: 6px;
    padding: 0 4px 8px 52px;
  }

  .suas-panel-submenu a {
    width: fit-content;
    max-width: 100%;
    padding: 6px 9px;
    border-radius: 999px;
    color: rgba(16, 16, 16, 0.7);
    background: rgba(255, 255, 255, 0.78);
    font-family: Futura, 'Futura PT', Arial, sans-serif;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .suas-panel-submenu a:hover {
    color: var(--suas-ink);
    background: var(--suas-pink);
  }

  .suas-side-status {
    margin: 10px 15px 12px;
    min-height: 74px;
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 16px 20px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.84);
    box-shadow: 0 13px 30px rgba(16, 16, 16, 0.08);
  }

  .suas-side-status-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--suas-lime);
    box-shadow: 0 0 14px rgba(198, 247, 106, 0.9);
    animation: suasPulse 1.6s ease-in-out infinite;
  }

  .suas-side-status b,
  .suas-side-status span { display: block; }
  .suas-side-status b { color: rgba(16, 16, 16, 0.42); margin-bottom: 5px; }
  .suas-side-status span { font-size: 1.08rem; line-height: 1; text-transform: uppercase; }

  .suas-side-foot {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding: 0 14px 16px;
  }

  .suas-side-foot a,
  .suas-side-foot span {
    color: rgba(16, 16, 16, 0.46);
    text-decoration: none;
  }

  @keyframes suasPulse {
    0%, 100% { opacity: 0.35; transform: scale(0.86); }
    50% { opacity: 1; transform: scale(1.1); }
  }

  @media (min-width: 1024px) {
    .suas-frame-marquee { left: 0; right: auto; width: 100%; }
    .suas-side-rail { inset: 0 auto 0 0; padding-top: 6px; }
    .off-canvas--main-content { margin-left: 252px; width: calc(100% - 252px); }
    .header--root,
    .announcement--root { display: none !important; }
  }

  @media (max-width: 1023px) {
    .header--root,
    .announcement--root { display: none !important; }

    .suas-frame-marquee { height: 34px; }
    .suas-frame-marquee-track span { padding: 0 18px; font-size: 15px; }

    .suas-side-rail {
      position: sticky;
      inset: auto;
      top: 34px;
      z-index: 59;
      width: 100%;
      display: block;
      padding: 8px 10px 10px;
      background: rgba(255, 255, 255, 0.96);
      border-right: 0;
      border-bottom: 1px solid rgba(16, 16, 16, 0.1);
      box-shadow: 0 10px 24px -20px rgba(16, 16, 16, 0.45);
    }

    .suas-side-head { justify-content: center; gap: 10px; padding: 4px 0 8px; }
    .suas-side-orb { width: 28px; height: 28px; }
    .suas-side-brand { font-size: 1.35rem; line-height: 1; }
    .suas-side-kicker,
    .suas-side-status,
    .suas-side-foot { display: none; }

    .suas-side-nav {
      flex: none;
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding: 2px 0 4px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .suas-side-nav::-webkit-scrollbar { display: none; }

    .suas-side-dropdown { flex: 0 0 auto; }
    .suas-side-link {
      min-height: 40px;
      flex: 0 0 auto;
      grid-template-columns: 26px auto;
      gap: 7px;
      padding: 7px 11px 7px 8px;
      border: 1px solid rgba(16, 16, 16, 0.1);
      background: rgba(255, 255, 255, 0.82);
      box-shadow: 0 4px 0 rgba(16, 16, 16, 0.12);
    }

    .suas-side-link.is-active { min-height: 40px; margin: 0; box-shadow: 0 4px 0 rgba(16, 16, 16, 0.25); }
    .suas-side-icon { width: 24px; height: 24px; font-size: 12px; }
    .suas-side-label { font-size: 1rem; line-height: 1; white-space: nowrap; }
    .suas-side-num { display: none; }

    .suas-panel-submenu {
      position: absolute;
      z-index: 65;
      min-width: 170px;
      max-width: min(86vw, 240px);
      padding: 8px;
      margin-top: 6px;
      border: 1px solid rgba(16, 16, 16, 0.12);
      border-radius: 14px;
      background: #fff;
      box-shadow: 0 16px 32px rgba(16, 16, 16, 0.16);
    }
  }

  .suas-booking-subgroup {
    display: grid;
    gap: 5px;
    margin: 0;
  }
  .suas-booking-subgroup > summary {
    width: fit-content;
    min-width: 118px;
    max-width: 100%;
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 7px 11px;
    border: 1px solid rgba(16, 16, 16, 0.12);
    border-radius: 999px;
    color: var(--suas-ink);
    background: var(--suas-pink);
    box-shadow: 0 3px 0 rgba(16, 16, 16, 0.9);
    font-family: 'Casual Human', Futura, Arial, sans-serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
    line-height: 1.1;
  }
  .suas-booking-subgroup > summary:hover {
    background: var(--suas-lime);
    transform: translateY(-1px);
  }
  .suas-booking-subgroup > summary::-webkit-details-marker { display: none; }
  .suas-booking-subgroup > summary::after {
    content: '+';
    font-family: Futura, Arial, sans-serif;
    font-size: 14px;
    line-height: 1;
  }
  .suas-booking-subgroup[open] > summary::after { content: '-'; }
  .suas-booking-subgroup-links {
    display: grid;
    gap: 5px;
    padding: 2px 0 2px 12px;
    border-left: 2px solid var(--suas-pink);
  }

</style>

{% liquid
  assign suas_contact_page = pages['contact-us']
  if suas_contact_page == blank
    assign suas_contact_page = pages['contact']
  endif
  assign suas_contact_url = suas_contact_page.url | default: '/pages/contact-us'
%}

<div class="suas-frame" aria-label="SUAS site frame">
  <div class="suas-frame-marquee" aria-hidden="true">
    <div class="suas-frame-marquee-track">
      {% for i in (1..2) %}
        {% if section.settings.marquee_1 != blank %}<span>{{ section.settings.marquee_1 }}</span>{% endif %}
        {% if section.settings.marquee_2 != blank %}<span>{{ section.settings.marquee_2 }}</span>{% endif %}
        {% if section.settings.marquee_3 != blank %}<span>{{ section.settings.marquee_3 }}</span>{% endif %}
        {% if section.settings.marquee_4 != blank %}<span>{{ section.settings.marquee_4 }}</span>{% endif %}
        {% if section.settings.marquee_5 != blank %}<span>{{ section.settings.marquee_5 }}</span>{% endif %}
        {% if section.settings.marquee_6 != blank %}<span>{{ section.settings.marquee_6 }}</span>{% endif %}
      {% endfor %}
    </div>
  </div>

  <aside class="suas-side-rail" aria-label="SUAS control panel">
    <a class="suas-side-head" href="{{ section.settings.home_link | default: '/' }}">
      <span class="suas-side-orb" aria-hidden="true"></span>
      <span class="suas-side-brand">{{ section.settings.brand_text }}</span>
    </a>
    <p class="suas-side-kicker">{{ section.settings.control_label }}</p>
    <nav class="suas-side-nav">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% liquid
            assign is_active = false
            if block.settings.active_match != blank and request.path contains block.settings.active_match
              assign is_active = true
            endif
            assign has_submenu = false
            if block.settings.submenu_1_label != blank or block.settings.submenu_2_label != blank or block.settings.submenu_3_label != blank or block.settings.submenu_4_label != blank or block.settings.submenu_5_label != blank or block.settings.submenu_6_label != blank
              assign has_submenu = true
            endif
          %}

          {% if has_submenu %}
            <details class="suas-side-dropdown" {{ block.shopify_attributes }}>
              <summary class="suas-side-link{% if is_active %} is-active{% endif %}">
                <span class="suas-side-icon" style="--tint: {{ block.settings.tint_color }};">{{ block.settings.icon }}</span>
                <span class="suas-side-label">{{ block.settings.title }}</span>
                <span class="suas-side-num">{{ block.settings.number }}</span>
              </summary>
              <div class="suas-panel-submenu">
                {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.title }}</a>{% endif %}
                {% if block.settings.submenu_1_label != blank %}{% assign submenu_1_url = block.settings.submenu_1_link %}{% if block.settings.submenu_1_label contains 'Contact' %}{% assign submenu_1_url = suas_contact_url %}{% endif %}{% if block.settings.submenu_1_label contains 'Booking' %}<details class="suas-booking-subgroup"><summary>{{ block.settings.submenu_1_label }}</summary><div class="suas-booking-subgroup-links"><a href="/pages/bookings">Book the Lab</a><a href="/pages/charm-bar">Charm Bar</a></div></details>{% else %}<a href="{{ submenu_1_url }}">{{ block.settings.submenu_1_label }}</a>{% endif %}{% endif %}
                {% if block.settings.submenu_2_label != blank %}{% assign submenu_2_url = block.settings.submenu_2_link %}{% if block.settings.submenu_2_label contains 'Contact' %}{% assign submenu_2_url = suas_contact_url %}{% endif %}{% if block.settings.submenu_2_label contains 'Booking' %}<details class="suas-booking-subgroup"><summary>{{ block.settings.submenu_2_label }}</summary><div class="suas-booking-subgroup-links"><a href="/pages/bookings">Book the Lab</a><a href="/pages/charm-bar">Charm Bar</a></div></details>{% else %}<a href="{{ submenu_2_url }}">{{ block.settings.submenu_2_label }}</a>{% endif %}{% endif %}
                {% if block.settings.submenu_3_label != blank %}{% assign submenu_3_url = block.settings.submenu_3_link %}{% if block.settings.submenu_3_label contains 'Contact' %}{% assign submenu_3_url = suas_contact_url %}{% endif %}{% if block.settings.submenu_3_label contains 'Booking' %}<details class="suas-booking-subgroup"><summary>{{ block.settings.submenu_3_label }}</summary><div class="suas-booking-subgroup-links"><a href="/pages/bookings">Book the Lab</a><a href="/pages/charm-bar">Charm Bar</a></div></details>{% else %}<a href="{{ submenu_3_url }}">{{ block.settings.submenu_3_label }}</a>{% endif %}{% endif %}
                {% if block.settings.submenu_4_label != blank %}{% assign submenu_4_url = block.settings.submenu_4_link %}{% if block.settings.submenu_4_label contains 'Contact' %}{% assign submenu_4_url = suas_contact_url %}{% endif %}{% if block.settings.submenu_4_label contains 'Booking' %}<details class="suas-booking-subgroup"><summary>{{ block.settings.submenu_4_label }}</summary><div class="suas-booking-subgroup-links"><a href="/pages/bookings">Book the Lab</a><a href="/pages/charm-bar">Charm Bar</a></div></details>{% else %}<a href="{{ submenu_4_url }}">{{ block.settings.submenu_4_label }}</a>{% endif %}{% endif %}
                {% if block.settings.submenu_5_label != blank %}{% assign submenu_5_url = block.settings.submenu_5_link %}{% if block.settings.submenu_5_label contains 'Contact' %}{% assign submenu_5_url = suas_contact_url %}{% endif %}{% if block.settings.submenu_5_label contains 'Booking' %}<details class="suas-booking-subgroup"><summary>{{ block.settings.submenu_5_label }}</summary><div class="suas-booking-subgroup-links"><a href="/pages/bookings">Book the Lab</a><a href="/pages/charm-bar">Charm Bar</a></div></details>{% else %}<a href="{{ submenu_5_url }}">{{ block.settings.submenu_5_label }}</a>{% endif %}{% endif %}
                {% if block.settings.submenu_6_label != blank %}{% assign submenu_6_url = block.settings.submenu_6_link %}{% if block.settings.submenu_6_label contains 'Contact' %}{% assign submenu_6_url = suas_contact_url %}{% endif %}{% if block.settings.submenu_6_label contains 'Booking' %}<details class="suas-booking-subgroup"><summary>{{ block.settings.submenu_6_label }}</summary><div class="suas-booking-subgroup-links"><a href="/pages/bookings">Book the Lab</a><a href="/pages/charm-bar">Charm Bar</a></div></details>{% else %}<a href="{{ submenu_6_url }}">{{ block.settings.submenu_6_label }}</a>{% endif %}{% endif %}
              </div>
            </details>
          {% else %}
            <a class="suas-side-link{% if is_active %} is-active{% endif %}" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
              <span class="suas-side-icon" style="--tint: {{ block.settings.tint_color }};">{{ block.settings.icon }}</span>
              <span class="suas-side-label">{{ block.settings.title }}</span>
              <span class="suas-side-num">{{ block.settings.number }}</span>
            </a>
          {% endif %}
        {% endfor %}
      {% else %}
        <details class="suas-side-dropdown">
          <summary class="suas-side-link{% if request.path contains '/collections/body' %} is-active{% endif %}"><span class="suas-side-icon" style="--tint: #ff9bc4;">o</span><span class="suas-side-label">body</span><span class="suas-side-num">01</span></summary>
          <div class="suas-panel-submenu"><a href="/collections/body-care">Body</a><a href="/collections/butter-creme">Butter Creme</a><a href="/collections/body-scrub">Body Scrub</a><a href="/collections/body-jelly">Body Jelly</a><a href="/collections/body-oil">Body Oil</a><a href="/collections/cleansing-bar">Cleansing Bar</a><a href="/collections/body-wash">Body Wash</a></div>
        </details>
        <details class="suas-side-dropdown">
          <summary class="suas-side-link{% if request.path contains '/collections/home' %} is-active{% endif %}"><span class="suas-side-icon" style="--tint: #ffe86b;">i</span><span class="suas-side-label">home</span><span class="suas-side-num">02</span></summary>
          <div class="suas-panel-submenu"><a href="/collections/home-care">Home</a><a href="/collections/candles">Candles</a><a href="/collections/everything-mist">Everything Mist</a><a href="/collections/burnt-oils">Burnt Oils</a></div>
        </details>
        <a class="suas-side-link{% if request.path contains '/collections/masculine' %} is-active{% endif %}" href="/collections/masculine"><span class="suas-side-icon" style="--tint: #9dd7ff;">*</span><span class="suas-side-label">masculine</span><span class="suas-side-num">03</span></a>
        <a class="suas-side-link{% if request.path contains '/collections/feminine' %} is-active{% endif %}" href="/collections/feminine"><span class="suas-side-icon" style="--tint: #ff9bc4;">x</span><span class="suas-side-label">feminine</span><span class="suas-side-num">04</span></a>
        <a class="suas-side-link{% if request.path contains '/collections/oddities' %} is-active{% endif %}" href="/collections/oddities"><span class="suas-side-icon" style="--tint: #c7b5ff;">*</span><span class="suas-side-label">oddities</span><span class="suas-side-num">05</span></a>
        <a class="suas-side-link{% if request.path contains '/pages/shut-up-and-smell' %} is-active{% endif %}" href="/pages/shut-up-and-smell"><span class="suas-side-icon" style="--tint: #c6f76a;">/</span><span class="suas-side-label">the lab</span><span class="suas-side-num">06</span></a>
        <details class="suas-side-dropdown">
          <summary class="suas-side-link{% if request.path contains '/pages/about' or request.path contains '/pages/bookings' or request.path contains '/pages/charm-bar' or request.path contains '/pages/contact' %} is-active{% endif %}"><span class="suas-side-icon" style="--tint: #c7b5ff;">?</span><span class="suas-side-label">about us</span><span class="suas-side-num">08</span></summary>
          <div class="suas-panel-submenu"><a href="/pages/about">Who are we</a><details class="suas-booking-subgroup"><summary>Bookings</summary><div class="suas-booking-subgroup-links"><a href="/pages/bookings">Book the Lab</a><a href="/pages/charm-bar">Charm Bar</a></div></details><a href="{{ suas_contact_url }}">Contact Us</a><a href="/policies/refund-policy">Refund Policy</a></div>
        </details>
        <a class="suas-side-link{% if request.path contains '/pages/visit-us' %} is-active{% endif %}" href="/pages/visit-us"><span class="suas-side-icon" style="--tint: #9dd7ff;">!</span><span class="suas-side-label">visit us</span><span class="suas-side-num">07</span></a>
      {% endif %}
    </nav>
    <div class="suas-side-status">
      <span class="suas-side-status-dot" aria-hidden="true"></span>
      <div><b>{{ section.settings.status_label }}</b><span>{{ section.settings.status_text }}</span></div>
    </div>
    <div class="suas-side-foot" aria-hidden="true">
      <a href="{{ section.settings.footer_link_1 }}">{{ section.settings.footer_label_1 }}</a>
      <a href="{{ section.settings.footer_link_2 }}">{{ section.settings.footer_label_2 }}</a>
      <span>{{ section.settings.version_text }}</span>
    </div>
  </aside>
</div>

<script>
  (() => {
    function placeVisitAfterAbout(scope) {
      const nav = (scope || document).querySelector('.suas-side-nav');
      if (!nav) return;
      const items = Array.from(nav.children);
      const about = items.find(item => (item.querySelector('.suas-side-label')?.textContent || '').trim().toLowerCase() === 'about us');
      const visit = items.find(item => (item.querySelector('.suas-side-label')?.textContent || '').trim().toLowerCase() === 'visit us');
      if (about && visit && about.nextElementSibling !== visit) about.insertAdjacentElement('afterend', visit);
    }
    placeVisitAfterAbout(document);
    document.addEventListener('shopify:section:load', event => placeVisitAfterAbout(event.target));
  })();
</script>

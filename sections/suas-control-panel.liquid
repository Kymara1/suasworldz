<section class="suas-control-panel" aria-label="SUAS control panel">
  <style>
    @font-face {
      font-family: 'Casual Human';
      src: url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');
      font-display: swap;
    }

    .suas-control-panel {
      --ink: #101010;
      --muted: rgba(16, 16, 16, 0.48);
      --line: rgba(16, 16, 16, 0.11);
      --soft: #f6f7fb;
      --lime: #d9ff78;
      --pink: #ffc4dc;
      --blue: #c9e7ff;
      --yellow: #fff2a9;
      --violet: #eee2ff;
      color: var(--ink);
      background:
        radial-gradient(circle at 12% 16%, rgba(255, 196, 220, 0.36), transparent 24%),
        radial-gradient(circle at 88% 26%, rgba(217, 255, 120, 0.28), transparent 26%),
        linear-gradient(180deg, #fff 0%, #f7f8fb 100%);
      padding: clamp(42px, 6vw, 88px) 0;
      border-top: 2px solid var(--ink);
      border-bottom: 2px solid var(--ink);
      font-family: Futura, 'Futura PT', Arial, sans-serif;
      overflow: hidden;
    }

    .suas-control-panel * { box-sizing: border-box; }

    .suas-panel-stage {
      width: min(1120px, calc(100vw - 28px));
      min-height: 660px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: minmax(280px, 345px) 1fr;
      gap: clamp(24px, 5vw, 68px);
      align-items: center;
    }

    .suas-panel-shell {
      position: relative;
      width: 100%;
      min-height: 630px;
      border: 1px solid rgba(16, 16, 16, 0.13);
      border-radius: 0 24px 24px 0;
      background: rgba(255, 255, 255, 0.86);
      box-shadow: 18px 20px 45px rgba(16, 16, 16, 0.11);
      backdrop-filter: blur(18px);
      overflow: hidden;
    }

    .suas-panel-inner {
      height: 100%;
      padding: 28px 18px 18px;
      display: flex;
      flex-direction: column;
    }

    .suas-panel-logo-row {
      display: flex;
      align-items: center;
      gap: 14px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--line);
    }

    .suas-panel-orb {
      width: 48px;
      height: 48px;
      border-radius: 999px;
      background:
        radial-gradient(circle at 28% 26%, #fff 0 10%, transparent 28%),
        radial-gradient(circle at 68% 34%, var(--lime) 0 16%, transparent 42%),
        radial-gradient(circle at 36% 75%, var(--pink) 0 22%, transparent 54%),
        linear-gradient(135deg, var(--blue), #fff);
      box-shadow: 0 14px 28px rgba(16, 16, 16, 0.16);
    }

    .suas-panel-brand {
      font-family: 'Casual Human', Futura, Arial, sans-serif;
      font-size: 2rem;
      line-height: 1;
      letter-spacing: 0;
    }

    .suas-panel-kicker {
      margin: 24px 0 14px;
      font-size: 10px;
      letter-spacing: 0.45em;
      text-transform: uppercase;
      color: rgba(16, 16, 16, 0.34);
    }

    .suas-panel-nav {
      display: grid;
      gap: 10px;
    }

    .suas-panel-link {
      min-height: 56px;
      display: grid;
      grid-template-columns: 50px 1fr auto;
      align-items: center;
      gap: 10px;
      padding: 8px 12px;
      border-radius: 999px;
      color: var(--ink);
      text-decoration: none;
      transition: transform 160ms ease, background 160ms ease, color 160ms ease, box-shadow 160ms ease;
    }

    .suas-panel-link:hover {
      color: var(--ink);
      background: rgba(255, 196, 220, 0.42);
      transform: translateX(4px);
    }

    .suas-panel-link.is-active {
      min-height: 70px;
      margin: 6px -4px;
      padding: 10px 16px;
      color: #fff;
      background: var(--ink);
      box-shadow: 0 10px 0 rgba(16, 16, 16, 0.18);
    }

    .suas-panel-icon {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border: 1px solid rgba(16, 16, 16, 0.08);
      border-radius: 999px;
      background: var(--icon-bg);
      box-shadow: inset 0 0 16px rgba(255, 255, 255, 0.44);
      font-size: 20px;
      line-height: 1;
    }

    .suas-panel-link.is-active .suas-panel-icon {
      border-color: rgba(255, 255, 255, 0.28);
      background: rgba(255, 255, 255, 0.1);
    }

    .suas-panel-label {
      font-family: 'Casual Human', Futura, Arial, sans-serif;
      font-size: 1.65rem;
      line-height: 1;
      text-transform: uppercase;
    }

    .suas-panel-number {
      font-size: 11px;
      letter-spacing: 0.22em;
      color: currentColor;
      opacity: 0.48;
      font-weight: 800;
    }

    .suas-panel-status {
      margin-top: auto;
      min-height: 82px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.86);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8), 0 14px 34px rgba(16, 16, 16, 0.08);
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 18px 22px;
    }

    .suas-panel-status-dot {
      width: 9px;
      height: 9px;
      border-radius: 999px;
      background: var(--lime);
      box-shadow: 0 0 16px rgba(217, 255, 120, 0.86);
    }

    .suas-panel-status b,
    .suas-panel-status span {
      display: block;
      font-size: 11px;
      letter-spacing: 0.28em;
      text-transform: uppercase;
    }

    .suas-panel-status b {
      color: rgba(16, 16, 16, 0.4);
      margin-bottom: 4px;
    }

    .suas-panel-status span {
      font-family: 'Casual Human', Futura, Arial, sans-serif;
      color: var(--ink);
    }

    .suas-panel-foot {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      padding: 18px 2px 0;
      font-size: 10px;
      letter-spacing: 0.34em;
      text-transform: uppercase;
      color: rgba(16, 16, 16, 0.42);
    }

    .suas-panel-copy h2 {
      margin: 0;
      font-family: 'Casual Human', Futura, Arial, sans-serif;
      font-size: clamp(4rem, 9vw, 9rem);
      font-weight: 400;
      line-height: 0.86;
      letter-spacing: 0;
      text-transform: lowercase;
    }

    .suas-panel-copy p {
      max-width: 520px;
      margin: 22px 0 0;
      font-size: clamp(15px, 1.6vw, 18px);
      line-height: 1.55;
      font-weight: 800;
      color: rgba(16, 16, 16, 0.58);
    }

    .suas-panel-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 30px;
    }

    .suas-panel-button {
      min-height: 52px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 2px solid var(--ink);
      border-radius: 999px;
      padding: 0 24px;
      background: #fff;
      color: var(--ink);
      box-shadow: 0 5px 0 var(--ink);
      font-family: 'Casual Human', Futura, Arial, sans-serif;
      font-size: 1.35rem;
      line-height: 1;
      text-decoration: none;
      text-transform: uppercase;
      transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease;
    }

    .suas-panel-button:hover {
      background: var(--pink);
      color: var(--ink);
      transform: translateY(2px);
      box-shadow: 0 3px 0 var(--ink);
    }

    @media (max-width: 860px) {
      .suas-panel-stage {
        min-height: 0;
        grid-template-columns: 1fr;
      }

      .suas-panel-shell {
        max-width: 390px;
        margin: 0 auto;
        border-radius: 24px;
      }

      .suas-panel-copy {
        text-align: center;
        order: -1;
      }

      .suas-panel-copy p {
        margin-left: auto;
        margin-right: auto;
      }

      .suas-panel-actions {
        justify-content: center;
      }
    }
  </style>

  <div class="suas-panel-stage">
    <aside class="suas-panel-shell">
      <div class="suas-panel-inner">
        <div class="suas-panel-logo-row">
          <span class="suas-panel-orb" aria-hidden="true"></span>
          <span class="suas-panel-brand">SUAS</span>
        </div>

        <p class="suas-panel-kicker">control panel</p>

        <nav class="suas-panel-nav" aria-label="SUAS quick links">
          <a class="suas-panel-link" href="/collections/body-care"><span class="suas-panel-icon" style="--icon-bg: var(--pink);">o</span><span class="suas-panel-label">body</span><span class="suas-panel-number">01</span></a>
          <a class="suas-panel-link" href="/collections/home-care"><span class="suas-panel-icon" style="--icon-bg: var(--yellow);">i</span><span class="suas-panel-label">home</span><span class="suas-panel-number">02</span></a>
          <a class="suas-panel-link" href="/collections/masculine"><span class="suas-panel-icon" style="--icon-bg: var(--blue);">*</span><span class="suas-panel-label">masculine</span><span class="suas-panel-number">03</span></a>
          <a class="suas-panel-link" href="/collections/feminine"><span class="suas-panel-icon" style="--icon-bg: var(--pink);">x</span><span class="suas-panel-label">feminine</span><span class="suas-panel-number">04</span></a>
          <a class="suas-panel-link" href="/collections/oddities"><span class="suas-panel-icon" style="--icon-bg: var(--violet);">*</span><span class="suas-panel-label">oddities</span><span class="suas-panel-number">05</span></a>
          <a class="suas-panel-link is-active" href="/pages/shut-up-and-smell"><span class="suas-panel-icon" style="--icon-bg: var(--lime);">/</span><span class="suas-panel-label">the lab</span><span class="suas-panel-number">06</span></a>
          <a class="suas-panel-link" href="/pages/contact"><span class="suas-panel-icon" style="--icon-bg: var(--blue);">!</span><span class="suas-panel-label">visit us</span><span class="suas-panel-number">07</span></a>
        </nav>

        <div class="suas-panel-status">
          <span class="suas-panel-status-dot" aria-hidden="true"></span>
          <div><b>lab status</b><span>open + mixing</span></div>
        </div>

        <div class="suas-panel-foot" aria-hidden="true">
          <span>account</span>
          <span>about</span>
          <span>v.04</span>
        </div>
      </div>
    </aside>

    <div class="suas-panel-copy">
      <h2>pick your door.</h2>
      <p>A softer way into the SUAS world: shop by mood, visit the lab, or jump straight into the pieces people ask for in store.</p>
      <div class="suas-panel-actions">
        <a class="suas-panel-button" href="/pages/shut-up-and-smell">enter the lab</a>
        <a class="suas-panel-button" href="/collections/all">shop smells</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SUAS Control Panel",
  "settings": [],
  "presets": [
    {
      "name": "SUAS Control Panel"
    }
  ]
}
{% endschema %}

<section class="suas-refund-page" aria-label="Refund policy">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}.suas-refund-page{--ink:#101010;--pink:#ffd8e8;--lime:#d9ff78;min-height:82vh;padding:clamp(46px,7vw,86px) clamp(18px,4vw,56px);background:linear-gradient(rgba(16,16,16,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.035) 1px,transparent 1px),radial-gradient(circle at 85% 20%,rgba(217,255,120,.28),transparent 28%),#fbfaf7;background-size:22px 22px,22px 22px,auto,auto;color:var(--ink)}.suas-refund-card{max-width:860px;margin:0 auto;border:2px solid var(--ink);border-radius:30px;background:rgba(255,255,255,.86);box-shadow:8px 9px 0 var(--ink);padding:clamp(24px,5vw,46px)}.suas-refund-card h1,.suas-refund-card h2{font-family:'Casual Human',Futura,Arial,sans-serif!important;font-weight:400!important;letter-spacing:0!important;line-height:.86;text-transform:lowercase}.suas-refund-card h1{margin:0 0 22px;font-size:clamp(4rem,9vw,7.8rem)}.suas-refund-card h2{margin:26px 0 10px;font-size:clamp(2.2rem,5vw,4rem)}.suas-refund-card p,.suas-refund-card li{font:700 1rem/1.7 Futura,Arial,sans-serif;color:rgba(16,16,16,.7)}.suas-refund-note{display:inline-flex;margin:10px 0 18px;padding:10px 16px;border:2px solid var(--ink);border-radius:999px;background:var(--pink);box-shadow:0 3px 0 var(--ink);font:900 12px/1 Futura,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase}.suas-refund-card a{color:var(--ink);font-weight:900}@media(max-width:700px){.suas-refund-card{border-radius:24px;box-shadow:5px 6px 0 var(--ink)}}
  </style>
  <div class="suas-refund-card"><span class="suas-refund-note">the honest policy</span><h1>refund policy.</h1><p>We want you to love what you get from SUAS. Because our products are personal-care, fragrance, handmade, and/or custom-blended items, refunds are reviewed case by case, but ultimately all sales are final.</p><h2>case by case means:</h2><ul><li>If something arrived damaged, incorrect, or genuinely not right, contact us with your order number and photos.</li><li>We may offer a replacement, store credit, or another fix depending on the situation.</li><li>Used, opened, custom, and fragrance preference-based returns are not eligible for refunds.</li></ul><h2>need help?</h2><p>Send us a note through the <a href="/pages/contact">Contact Us</a> page and we’ll take a look with care.</p></div>
</section>
{% schema %}{"name":"SUAS Refund Page","settings":[],"presets":[{"name":"SUAS Refund Page"}]}{% endschema %}
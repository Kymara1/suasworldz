<section class="suas-refund-page suas-os-page" aria-label="Refund policy">
  {% render 'suas-os-page-chrome' %}
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}.suas-refund-page.suas-os-page{padding:52px 14px 48px;min-height:calc(100vh - 36px);background:transparent;color:#101010}.suas-refund-card{max-width:none;margin:0;border:0;border-radius:0;background:transparent;box-shadow:none;padding:8px 6px 16px}.suas-refund-card h1,.suas-refund-card h2{font-family:'Casual Human',Futura,Arial,sans-serif!important;font-weight:400!important;letter-spacing:0!important;line-height:.86;text-transform:lowercase}.suas-refund-card h1{margin:0 0 18px;font-size:clamp(2.4rem,6vw,4.4rem);color:#d9ff78}.suas-refund-card h2{margin:26px 0 10px;font-size:clamp(1.6rem,4vw,2.4rem);color:#d9ff78}.suas-refund-card p,.suas-refund-card li{font:700 1rem/1.7 Futura,Arial,sans-serif;color:rgba(255,255,255,.88)}.suas-refund-note{display:inline-flex;margin:10px 0 18px;padding:10px 16px;border:2px solid #101010;border-radius:999px;background:#ffd8e8;box-shadow:0 3px 0 #101010;font:900 12px/1 Futura,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#101010}.suas-refund-card a{color:#d9ff78;font-weight:900}@media(max-width:700px){.suas-refund-card{padding:8px 4px 12px}}
  </style>
  <div class="suas-os-sheet">
    <div class="suas-os-titlebar"><span class="suas-os-orb" aria-hidden="true"></span><b>REFUND.EXE</b><span class="suas-os-winbtns" aria-hidden="true"><i></i><i></i><i></i></span></div>
  <div class="suas-refund-card suas-os-sheet-body"><span class="suas-refund-note">the honest policy</span><h1>refund policy.</h1><p>We want you to love what you get from SUAS. Because our products are personal-care, fragrance, handmade, and/or custom-blended items, refunds are reviewed case by case, but ultimately all sales are final.</p><h2>case by case means:</h2><ul><li>If something arrived damaged, incorrect, or genuinely not right, contact us with your order number and photos.</li><li>We may offer a replacement, store credit, or another fix depending on the situation.</li><li>Used, opened, custom, and fragrance preference-based returns are not eligible for refunds.</li></ul><h2>need help?</h2><p>Send us a note through the <a href="/pages/contact-us">Contact Us</a> page and we’ll take a look with care.</p></div>
  </div>
</section>
{% schema %}{"name":"SUAS Refund Page","settings":[],"presets":[{"name":"SUAS Refund Page"}]}{% endschema %}
{% render 'suas-os-account-styles' %}
{% if customer %}
<script>window.location.replace('/pages/account#addresses');</script>
<meta http-equiv="refresh" content="0;url=/pages/account#addresses">
{% endif %}
<section class="suas-os-account" aria-label="SUAS addresses">
  <div class="suas-os-wrap is-wide">
    {% render 'suas-os-account-mark' %}
    <div class="suas-os-mid">
      <article class="suas-os-win">
        <div class="suas-os-winbar">
          <div class="suas-os-dots">
            <span class="suas-os-dot" style="--dot:#ff5f57"></span>
            <span class="suas-os-dot" style="--dot:#febc2e"></span>
            <span class="suas-os-dot" style="--dot:#28c840"></span>
          </div>
          <span class="suas-os-wintitle suas-mono">ADDRESS.BOOK</span>
          <span class="suas-os-live suas-mono"><b></b>IN</span>
        </div>
        <div class="suas-os-body">
          <p class="suas-os-copy">taking you back to your SUAS account.</p>
          <a class="suas-os-btn is-dark" href="/pages/account#addresses">open addresses</a>
        </div>
      </article>
      {% render 'suas-os-account-launch', current: 'addresses' %}
    </div>
  </div>
</section>

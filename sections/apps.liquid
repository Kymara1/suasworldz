{%- liquid
  assign bg_color = section.settings.background-color
  assign container_width = section.settings.container-width
  assign light_text = section.settings.light-text
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign is_product_review_shell = false

  if request.page_type == 'product'
    assign is_product_review_shell = true
  endif

  capture app_blocks
    for block in section.blocks
      render block
    endfor
  endcapture
-%}

{% if is_product_review_shell %}
  <style>
    html body.template--product .suas-note-grid{display:flex!important;grid-template-columns:none!important;gap:18px!important;overflow-x:auto!important;overflow-y:hidden!important;padding:0 6px 14px!important;scroll-snap-type:x mandatory!important;-webkit-overflow-scrolling:touch!important}html body.template--product .suas-note-grid::-webkit-scrollbar{height:8px!important}html body.template--product .suas-note-grid::-webkit-scrollbar-thumb{background:#101010!important;border-radius:999px!important}html body.template--product .suas-note-card{flex:0 0 calc((100% - 36px)/3)!important;min-width:260px!important;scroll-snap-align:start!important}
    html body.template--product .suas-note-card:before{background-image:var(--real-note-photo,var(--note-img))!important;background-size:cover!important;background-position:center!important;filter:saturate(1.06) contrast(1.04)!important}html body.template--product .suas-note-card:after{background:linear-gradient(180deg,rgba(0,0,0,.02) 0%,rgba(0,0,0,.05) 45%,rgba(0,0,0,.62) 100%)!important}.note-coconut{--real-note-photo:url('https://images.unsplash.com/photo-1580984969064-9a264d75832c?auto=format&fit=crop&w=1400&q=80')}.note-jasmine{--real-note-photo:url('https://commons.wikimedia.org/wiki/Special:FilePath/Jasmine%20flower%20(Jasminum%20sambac).jpg')}.note-musk{--real-note-photo:url('https://images.unsplash.com/photo-1634393653736-98a63fb73742?auto=format&fit=crop&w=1400&q=80')}.note-ocean{--real-note-photo:url('https://images.unsplash.com/photo-1676456471935-b5477d73ff3b?auto=format&fit=crop&w=1400&q=80')}.note-vanilla{--real-note-photo:url('https://images.unsplash.com/photo-1608797178974-15b35a64ede9?auto=format&fit=crop&w=1400&q=80')}.note-amber{--real-note-photo:url('https://images.unsplash.com/photo-1615485290382-441e4d049cb5?auto=format&fit=crop&w=1400&q=80')}.note-lavender{--real-note-photo:url('https://images.unsplash.com/photo-1499002238440-d264edd596ec?auto=format&fit=crop&w=1400&q=80')}.note-mandarin,.note-lemon,.note-orange,.note-citrus{--real-note-photo:url('https://images.unsplash.com/photo-1582979512210-99b6a53386f9?auto=format&fit=crop&w=1400&q=80')}.note-wildflower,.note-petals,.note-floral{--real-note-photo:url('https://images.unsplash.com/photo-1490750967868-88aa4486c946?auto=format&fit=crop&w=1400&q=80')}.note-sunshine,.note-warm{--real-note-photo:url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1400&q=80')}.note-signature,.note-cream,.note-spark,.note-soft{--real-note-photo:url('https://images.unsplash.com/photo-1615634260167-c8cdede054de?auto=format&fit=crop&w=1400&q=80')}
    @media(max-width:1023px){html body.template--product .suas-side-dropdown[open]:before{content:none!important;display:none!important;pointer-events:none!important}html body.template--product .suas-side-rail{overflow:visible!important}html body.template--product .suas-side-nav{position:relative!important;display:flex!important;gap:8px!important;overflow-x:auto!important;overflow-y:visible!important;padding:2px 0 5px!important}html body.template--product .suas-side-dropdown{position:static!important;min-width:max-content!important}html body.template--product .suas-side-dropdown[open] .suas-panel-submenu{position:fixed!important;top:128px!important;left:10px!important;right:10px!important;bottom:auto!important;z-index:9999!important;width:auto!important;min-width:0!important;max-width:none!important;max-height:55vh!important;display:grid!important;grid-template-columns:1fr!important;gap:8px!important;margin:0!important;padding:12px!important;overflow:auto!important;border:2px solid #101010!important;border-radius:20px!important;background:#fff!important;box-shadow:6px 7px 0 #101010,0 18px 40px rgba(16,16,16,.18)!important}.suas-side-dropdown[open] .suas-panel-submenu:before{content:none!important;display:none!important}.suas-side-dropdown[open] .suas-panel-submenu a{display:flex!important;align-items:center!important;justify-content:center!important;width:100%!important;min-height:42px!important;padding:10px 9px!important;border:1.5px solid rgba(16,16,16,.18)!important;border-radius:999px!important;background:rgba(255,255,255,.9)!important;color:#101010!important;text-align:center!important;font-size:9px!important;line-height:1.1!important;letter-spacing:.1em!important}html body.template--product .suas-note-card{flex-basis:76vw!important;min-width:76vw!important;max-width:76vw!important}}
    html body.template--product .shopify-section:has(.suas-product-review-shell)::before,html body.template--product .shopify-section:has(#aftership_reviews_all_reviews_widget_production)::before,html body.template--product .shopify-section:has(#aftership_reviews_carousel_v2_production)::before,html body.template--product .suas-product-review-teaser{content:none!important;display:none!important}.suas-product-review-shell{width:min(1040px,calc(100vw - 34px));margin:clamp(26px,4vw,48px) auto!important;color:#101010;font-family:Futura,'Futura PT',Arial,sans-serif}.suas-product-review-shell *{box-sizing:border-box}.suas-product-review-shell .apps--wrapper{border:2px solid #101010;border-radius:30px;background:linear-gradient(rgba(16,16,16,.026) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.026) 1px,transparent 1px),radial-gradient(circle at 10% 10%,rgba(255,216,232,.88),transparent 30%),radial-gradient(circle at 90% 90%,rgba(217,255,120,.62),transparent 28%),#fff;background-size:18px 18px,18px 18px,auto,auto,auto;box-shadow:8px 9px 0 #101010;overflow:hidden}.suas-review-window-bar{height:38px;display:flex;align-items:center;gap:8px;padding:0 16px;border-bottom:2px solid #101010;background:linear-gradient(#f6f7f9,#e9edf2)}.suas-review-window-bar span{width:12px;height:12px;border-radius:50%;background:#ff6257}.suas-review-window-bar span:nth-child(2){background:#ffbd2e}.suas-review-window-bar span:nth-child(3){background:#28c840}.suas-review-window-bar strong{margin-left:auto;font-size:9px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.suas-review-intro{display:grid;grid-template-columns:1.15fr auto;gap:18px;align-items:center;padding:clamp(18px,3vw,30px);border-bottom:2px solid #101010}.suas-review-intro p{margin:0;font-size:13px;line-height:1.45;font-weight:800}.suas-review-intro .suas-review-copy{max-width:670px}.suas-review-intro h2{margin:0 0 8px;font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:clamp(2.7rem,6vw,5.25rem);font-weight:700;line-height:.82;text-transform:uppercase}.suas-review-pill{display:inline-flex;width:max-content;margin:0 0 10px;padding:7px 14px 6px;border:2px solid #101010;border-radius:999px;background:#d9ff78;box-shadow:0 4px 0 #101010;font-size:9px;font-weight:900;letter-spacing:.16em;text-transform:uppercase}.suas-review-action{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:13px 20px;border:2px solid #101010;border-radius:999px;background:#ffd8e8;color:#101010!important;box-shadow:0 5px 0 #101010;text-decoration:none!important;font-size:10px;font-weight:900;letter-spacing:.14em;text-transform:uppercase;white-space:nowrap}.suas-review-app-stage{padding:clamp(14px,2vw,22px);min-height:150px}.suas-review-app-stage:empty:before{content:'reviews loading';display:flex;align-items:center;justify-content:center;min-height:120px;border:1px dashed rgba(16,16,16,.28);border-radius:20px;font-size:10px;font-weight:900;letter-spacing:.18em;text-transform:uppercase;color:#6c6c6c}.suas-review-app-stage iframe{width:100%!important;min-height:360px!important;border:0!important;border-radius:18px!important;background:#fff!important}@media(max-width:749px){.suas-product-review-shell{width:min(430px,calc(100vw - 16px));margin:24px auto!important}.suas-review-intro{grid-template-columns:1fr;padding:18px}.suas-review-action{width:100%}.suas-review-window-bar strong{font-size:7px}}
  </style>
{% endif %}

<div class="apps--root{% if is_product_review_shell %} suas-product-review-shell{% endif %}" data-section-id="{{ section.id }}" data-background-color="{{ bg_color }}" data-container-width="{{ container_width }}" data-light-text="{{ light_text }}" data-spacing-above="{{ spacing_above }}" data-spacing-below="{{ spacing_below }}">
  <div class="apps--wrapper{% if is_product_review_shell %} suas-review-shell-window{% endif %}">
    {% if is_product_review_shell %}
      <div class="suas-review-window-bar" aria-hidden="true"><span></span><span></span><span></span><strong>verified product notes</strong></div>
      <div class="suas-review-intro"><div class="suas-review-copy"><div class="suas-review-pill">customer smell reports</div><h2>smell reports.</h2><p>Reviews live here for this formula. Tell the next person how it smelled, how it wore, and whether it belongs in their cart.</p></div><a class="suas-review-action" href="/pages/reviews?product={{ product.handle }}#aftership_reviews_all_reviews_widget_production">write a review</a></div>
    {% endif %}
    <div class="suas-review-app-stage">{{ app_blocks }}</div>
  </div>
</div>

{% schema %}
{"name":"App wrapper","settings":[{"id":"background-color","label":"Background color","type":"select","options":[{"label":"None","value":"none"},{"label":"Light","value":"light"},{"label":"Dark","value":"dark"},{"label":"Accent","value":"accent"}],"default":"none"},{"id":"light-text","label":"Use light text color","type":"checkbox","default":false},{"id":"container-width","label":"Width of container","type":"range","min":1,"max":6,"step":1,"default":4},{"id":"spacing-above","label":"Spacing above","type":"checkbox","default":true},{"id":"spacing-below","label":"Spacing below","type":"checkbox","default":true}],"blocks":[{"type":"@app"}],"presets":[{"name":"App wrapper"}]}
{% endschema %}
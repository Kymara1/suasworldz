{%- liquid
  assign bg_color = section.settings.background-color
  assign container_width = section.settings.container-width
  assign light_text = section.settings.light-text
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign is_product_review_shell = false

  if request.page_type == 'product'
    assign is_product_review_shell = true
  endif

  capture app_blocks
    for block in section.blocks
      render block
    endfor
  endcapture
-%}

{% if is_product_review_shell %}
  <style>
    html body.template--product .suas-product-review-shell{width:100%;margin:22px 0 28px;padding:0;color:#101010;font-family:Futura,Arial,sans-serif;background:transparent}
    html body.template--product .suas-product-review-shell .apps--wrapper{border:0;border-radius:0;background:transparent;box-shadow:none;overflow:visible}
    html body.template--product .suas-review-window-bar{display:none}
    html body.template--product .suas-review-intro{display:grid;grid-template-columns:1.15fr auto;gap:18px;align-items:end;padding:0 0 18px;border-bottom:1px solid rgba(16,16,16,.12)}
    html body.template--product .suas-review-intro h2{margin:0 0 8px;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(2.2rem,5vw,4rem);line-height:.86;text-transform:uppercase}
    html body.template--product .suas-review-intro p{margin:0;font-size:13px;line-height:1.45;font-weight:800}
    html body.template--product .suas-review-action{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:12px 18px;border:2px solid #101010;border-radius:999px;background:#ffd8e8;color:#101010;box-shadow:0 4px 0 #101010;text-decoration:none;font:900 10px/1 Futura,Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase}
    html body.template--product .suas-review-app-stage{padding:16px;min-height:160px}
    html body.template--product .suas-review-app-stage iframe{width:100%;min-height:360px;border:0;border-radius:18px}
    @media(max-width:1023px){html body.template--product .suas-review-intro{grid-template-columns:1fr}html body.template--product .suas-review-action{width:100%}}
  </style>
{% endif %}

<div class="apps--root{% if is_product_review_shell %} suas-product-review-shell{% endif %}" data-section-id="{{ section.id }}" data-background-color="{{ bg_color }}" data-container-width="{{ container_width }}" data-light-text="{{ light_text }}" data-spacing-above="{{ spacing_above }}" data-spacing-below="{{ spacing_below }}">
  <div class="apps--wrapper{% if is_product_review_shell %} suas-review-shell-window{% endif %}">
    {% if is_product_review_shell %}
      <div class="suas-review-intro"><div class="suas-review-copy"><h2>smell reports</h2><p>How it actually wore. Leave a note for the next person.</p></div><a class="suas-review-action" href="/pages/reviews?product={{ product.handle }}">write a review</a></div>
    {% endif %}
    <div class="suas-review-app-stage">{{ app_blocks }}</div>
  </div>
</div>

{% schema %}
{"name":"App wrapper","settings":[{"id":"background-color","label":"Background color","type":"select","options":[{"label":"None","value":"none"},{"label":"Light","value":"light"},{"label":"Dark","value":"dark"},{"label":"Accent","value":"accent"}],"default":"none"},{"id":"light-text","label":"Use light text color","type":"checkbox","default":false},{"id":"container-width","label":"Width of container","type":"range","min":1,"max":6,"step":1,"default":4},{"id":"spacing-above","label":"Spacing above","type":"checkbox","default":true},{"id":"spacing-below","label":"Spacing below","type":"checkbox","default":true}],"blocks":[{"type":"@app"}],"presets":[{"name":"App wrapper"}]}
{% endschema %}

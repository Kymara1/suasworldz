{%- liquid
  assign bg_color = section.settings.background-color
  assign container_width = section.settings.container-width
  assign light_text = section.settings.light-text
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign is_product_review_shell = false

  if request.page_type == 'product'
    assign is_product_review_shell = true
  endif

  capture app_blocks
    for block in section.blocks
      render block
    endfor
  endcapture
-%}

{% if is_product_review_shell %}
  <style>
    html body.template--product .suas-product-review-shell{width:min(640px,calc(100vw - 24px));margin:16px auto 20px;padding:0;color:#101010;font-family:Futura,Arial,sans-serif;background:transparent}
    html body.template--product .suas-product-review-shell .apps--wrapper,
    html body.template--product .suas-review-shell-window{border:2px solid #101010!important;border-radius:16px!important;background:#fff!important;box-shadow:3px 4px 0 #101010!important;overflow:hidden!important}
    html body.template--product .suas-smell-winbar{display:flex;align-items:center;gap:6px;min-height:28px;padding:4px 10px;border-bottom:2px solid #101010;background:linear-gradient(180deg,#fff,#ece7f3)}
    html body.template--product .suas-smell-winbar i{width:8px;height:8px;border-radius:999px;display:block;background:#ff5f57}
    html body.template--product .suas-smell-winbar i:nth-child(2){background:#febc2e}
    html body.template--product .suas-smell-winbar i:nth-child(3){background:#28c840}
    html body.template--product .suas-smell-winbar b{margin-left:auto;font:900 8px/1 Futura,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase}
    html body.template--product .suas-review-intro{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:8px 10px 0}
    html body.template--product .suas-review-intro h2{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:1.35rem;line-height:1;text-transform:lowercase;font-weight:400}
    html body.template--product .suas-review-intro p,
    html body.template--product .suas-review-action,
    html body.template--product .suas-review-empty{display:none!important}
    html body.template--product .suas-review-app-stage{padding:0 10px 10px;min-height:0}
    html body.template--product .suas-review-app-stage iframe{display:none}
  </style>
{% endif %}

<div class="apps--root{% if is_product_review_shell %} suas-product-review-shell{% endif %}" data-section-id="{{ section.id }}" data-background-color="{{ bg_color }}" data-container-width="{{ container_width }}" data-light-text="{{ light_text }}" data-spacing-above="{{ spacing_above }}" data-spacing-below="{{ spacing_below }}">
  <div class="apps--wrapper{% if is_product_review_shell %} suas-review-shell-window{% endif %}">
    {% if is_product_review_shell %}
      <div class="suas-smell-winbar" aria-hidden="true"><i></i><i></i><i></i><b>reviews</b></div>
      <div class="suas-review-intro"><h2>reviews</h2></div>
      {% render 'suas-simple-review-form', product: product %}
    {% endif %}
    <div class="suas-review-app-stage" data-suas-review-stage>
      {{ app_blocks }}
    </div>
  </div>
</div>

{% schema %}
{"name":"App wrapper","settings":[{"id":"background-color","label":"Background color","type":"select","options":[{"label":"None","value":"none"},{"label":"Light","value":"light"},{"label":"Dark","value":"dark"},{"label":"Accent","value":"accent"}],"default":"none"},{"id":"light-text","label":"Use light text color","type":"checkbox","default":false},{"id":"container-width","label":"Width of container","type":"range","min":1,"max":6,"step":1,"default":4},{"id":"spacing-above","label":"Spacing above","type":"checkbox","default":true},{"id":"spacing-below","label":"Spacing below","type":"checkbox","default":true}],"blocks":[{"type":"@app"}],"presets":[{"name":"App wrapper"}]}
{% endschema %}

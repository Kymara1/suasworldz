{%- liquid
  assign bg_color = section.settings.background-color
  assign container_width = section.settings.container-width
  assign light_text = section.settings.light-text
  assign spacing_above = section.settings.spacing-above
  assign spacing_below = section.settings.spacing-below
  assign is_product_review_shell = false

  if request.page_type == 'product'
    assign is_product_review_shell = true
  endif

  capture app_blocks
    for block in section.blocks
      render block
    endfor
  endcapture
-%}

{% if is_product_review_shell %}
  <style>
    .suas-product-review-shell{width:min(1040px,calc(100vw - 34px));margin:clamp(30px,5vw,60px) auto!important;color:#101010;font-family:Futura,'Futura PT',Arial,sans-serif}.suas-product-review-shell *{box-sizing:border-box}.suas-product-review-shell .apps--wrapper{border:2px solid #101010;border-radius:30px;background:linear-gradient(rgba(16,16,16,.026) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.026) 1px,transparent 1px),radial-gradient(circle at 10% 10%,rgba(255,216,232,.88),transparent 30%),radial-gradient(circle at 90% 90%,rgba(217,255,120,.62),transparent 28%),#fff;background-size:18px 18px,18px 18px,auto,auto,auto;box-shadow:8px 9px 0 #101010;overflow:hidden}.suas-review-window-bar{height:38px;display:flex;align-items:center;gap:8px;padding:0 16px;border-bottom:2px solid #101010;background:linear-gradient(#f6f7f9,#e9edf2)}.suas-review-window-bar span{width:12px;height:12px;border-radius:50%;background:#ff6257}.suas-review-window-bar span:nth-child(2){background:#ffbd2e}.suas-review-window-bar span:nth-child(3){background:#28c840}.suas-review-window-bar strong{margin-left:auto;font-size:9px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.suas-review-shell-label{width:fit-content;margin:0 auto -18px;padding:9px 26px 7px;border:2px solid #101010;border-radius:999px;background:#d9ff78;box-shadow:0 6px 0 #101010;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(2rem,4.5vw,3.6rem);line-height:.86;text-transform:uppercase;position:relative;z-index:4}.suas-review-intro{display:grid;grid-template-columns:1.15fr auto;gap:18px;align-items:center;padding:clamp(18px,3vw,28px);border-bottom:2px solid #101010}.suas-review-intro p{margin:0;font-size:13px;line-height:1.45;font-weight:800}.suas-review-intro .suas-review-copy{max-width:650px}.suas-review-intro h2{margin:0 0 8px;font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:clamp(2.2rem,5vw,4.2rem);line-height:.82;text-transform:uppercase}.suas-review-action{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:13px 20px;border:2px solid #101010;border-radius:999px;background:#ffd8e8;color:#101010!important;box-shadow:0 5px 0 #101010;text-decoration:none!important;font-size:10px;font-weight:900;letter-spacing:.14em;text-transform:uppercase;white-space:nowrap}.suas-review-action:hover{transform:translateY(2px);box-shadow:0 3px 0 #101010}.suas-review-app-stage{padding:clamp(14px,2vw,22px);min-height:150px}.suas-review-app-stage:empty:before{content:'reviews loading';display:flex;align-items:center;justify-content:center;min-height:120px;border:1px dashed rgba(16,16,16,.28);border-radius:20px;font-size:10px;font-weight:900;letter-spacing:.18em;text-transform:uppercase;color:#6c6c6c}.suas-review-app-stage iframe{width:100%!important;min-height:360px!important;border:0!important;border-radius:18px!important;background:#fff!important}.suas-review-app-stage button,.suas-review-app-stage a[role='button'],.suas-review-app-stage [class*='button'],.suas-review-app-stage [class*='Button']{border-radius:999px!important;font-family:Futura,'Futura PT',Arial,sans-serif!important;font-weight:900!important;text-transform:uppercase!important}@media(max-width:749px){.suas-product-review-shell{width:min(430px,calc(100vw - 16px));margin:24px auto!important}.suas-review-intro{grid-template-columns:1fr;padding:18px}.suas-review-action{width:100%}.suas-review-window-bar strong{font-size:7px}}
  </style>
{% endif %}

<div
  class="apps--root{% if is_product_review_shell %} suas-product-review-shell{% endif %}"
  data-section-id="{{ section.id }}"
  data-background-color="{{ bg_color }}"
  data-container-width="{{ container_width }}"
  data-light-text="{{ light_text }}"
  data-spacing-above="{{ spacing_above }}"
  data-spacing-below="{{ spacing_below }}"
>
  {% if is_product_review_shell %}
    <div class="suas-review-shell-label">smell reports.</div>
  {% endif %}

  <div class="apps--wrapper{% if is_product_review_shell %} suas-review-shell-window{% endif %}">
    {% if is_product_review_shell %}
      <div class="suas-review-window-bar" aria-hidden="true">
        <span></span><span></span><span></span>
        <strong>verified product notes</strong>
      </div>
      <div class="suas-review-intro">
        <div class="suas-review-copy">
          <h2>leave your smell report.</h2>
          <p>Tell the next person how it wore, what it smelled like on you, and whether it belongs in their cart.</p>
        </div>
        <a class="suas-review-action" href="/pages/reviews?product={{ product.handle }}#aftership_reviews_all_reviews_widget_production">write a review</a>
      </div>
    {% endif %}

    <div class="suas-review-app-stage">
      {{ app_blocks }}
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "App wrapper",
    "settings": [
      {
        "id": "background-color",
        "label": "Background color",
        "type": "select",
        "options": [
          { "label": "None", "value": "none" },
          { "label": "Light", "value": "light" },
          { "label": "Dark", "value": "dark" },
          { "label": "Accent", "value": "accent" }
        ],
        "default": "none"
      },
      {
        "id": "light-text",
        "label": "Use light text color",
        "type": "checkbox",
        "default": false
      },
      {
        "id": "container-width",
        "label": "Width of container",
        "type": "range",
        "min": 1,
        "max": 6,
        "step": 1,
        "default": 4
      },
      {
        "id": "spacing-above",
        "label": "Spacing above",
        "type": "checkbox",
        "default": true
      },
      {
        "id": "spacing-below",
        "label": "Spacing below",
        "type": "checkbox",
        "default": true
      }
    ],
    "blocks": [
      {
        "type": "@app"
      }
    ],
    "presets": [
      {
        "name": "App wrapper"
      }
    ]
  }
{% endschema %}
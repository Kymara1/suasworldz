{% render 'suas-os-account-styles' %}
<section class="suas-os-account" aria-label="Create account">
  <div class="suas-os-wrap">
    {% render 'suas-os-account-mark' %}
    <article class="suas-os-win">
      <div class="suas-os-winbar">
        <div class="suas-os-dots">
          <span class="suas-os-dot" style="--dot:#ff5f57"></span>
          <span class="suas-os-dot" style="--dot:#febc2e"></span>
          <span class="suas-os-dot" style="--dot:#28c840"></span>
        </div>
        <span class="suas-os-wintitle suas-mono">ACCOUNT.CREATE</span>
        <span class="suas-os-live suas-mono"><b></b>NEW</span>
      </div>
      <div class="suas-os-body">
        <p class="suas-os-kicker">suas.os / security</p>
        <h1 class="suas-os-title suas-font">make an account.</h1>
        <p class="suas-os-copy">one minute. then your orders and addresses live here.</p>
        {% form 'create_customer' %}
          <input type="hidden" name="return_to" value="/pages/account">
          <div class="suas-os-errors">{{ form.errors | default_errors }}</div>
          <div class="suas-os-form">
            <div class="suas-os-two">
              <div class="suas-os-field"><label for="first_name">first name</label><input id="first_name" type="text" name="customer[first_name]" autocomplete="given-name" required></div>
              <div class="suas-os-field"><label for="last_name">last name</label><input id="last_name" type="text" name="customer[last_name]" autocomplete="family-name" required></div>
            </div>
            <div class="suas-os-field"><label for="email">email</label><input id="email" type="email" name="customer[email]" autocomplete="email" required></div>
            <div class="suas-os-field"><label for="password">password</label><input id="password" type="password" name="customer[password]" autocomplete="new-password" required></div>
            <div class="suas-os-actions">
              <button class="suas-os-btn is-dark" type="submit">create account</button>
              <a class="suas-os-btn" href="{{ routes.account_login_url }}">log in</a>
            </div>
          </div>
        {% endform %}
      </div>
    </article>
  </div>
</section>

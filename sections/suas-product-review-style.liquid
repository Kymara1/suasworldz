<section class="suas-product-review-style" aria-hidden="true">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}

    /* Product page polish */
    .product-page--root{--suas-ink:#101010;--suas-pink:#ffd8e8;--suas-blue:#cdeeff;--suas-yellow:#fff1a8;--suas-green:#d9ff78;width:min(1040px,calc(100vw - 36px))!important;margin:clamp(22px,4vw,54px) auto!important;background:transparent!important;color:var(--suas-ink)!important}
    .product-page--top-panel{padding:0!important;background:transparent!important}
    .product-page--panel-wrapper{display:grid!important;grid-template-columns:minmax(280px,.95fr) minmax(300px,.78fr)!important;gap:clamp(18px,3vw,34px)!important;align-items:start!important;max-width:100%!important;margin:0 auto!important}
    .product-page--featured-media,.product-page--featured-blocks{border:2px solid var(--suas-ink)!important;border-radius:26px!important;background:#fff!important;box-shadow:8px 10px 0 var(--suas-ink)!important;overflow:hidden!important}
    .product-page--featured-media{padding:clamp(14px,2.4vw,24px)!important;display:flex!important;align-items:center!important;justify-content:center!important;min-height:0!important}
    .product-page--featured-media img,.product-page--featured-media .image--root img{width:100%!important;max-width:430px!important;max-height:430px!important;object-fit:cover!important;border-radius:18px!important;display:block!important;margin:auto!important}
    .product-page--featured-blocks{padding:clamp(18px,2.7vw,30px)!important;max-width:440px!important;justify-self:start!important}
    .product-page--block{margin:0 0 14px!important}
    .product-page--heading{font-family:'Casual Human',Futura,Arial,sans-serif!important;font-weight:400!important;letter-spacing:0!important;text-transform:uppercase!important;font-size:clamp(2.4rem,5.2vw,4.6rem)!important;line-height:.82!important;margin:0 0 14px!important;color:var(--suas-ink)!important;overflow-wrap:anywhere!important}
    .product-page--heading [class*='star'],.product-page--heading .asrv-star-widget{display:inline-flex!important;vertical-align:middle!important;transform:scale(.86)!important;transform-origin:left center!important}
    .product-page--featured-blocks p,.product-page--featured-blocks li,.product-page--featured-blocks div:not(.product-page--heading){font-family:Futura,'Futura PT',Arial,sans-serif!important;font-size:13px!important;line-height:1.45!important;color:var(--suas-ink)!important}
    .product-page--price,.product-price--root,.product-price--wrapper{font:900 17px/1 Futura,Arial,sans-serif!important;letter-spacing:.04em!important;color:var(--suas-ink)!important}
    .product-page--featured-blocks button,.product-page--featured-blocks .shopify-payment-button__button,.product-page--featured-blocks [type='submit'],.product-page--featured-blocks a.button{border:2px solid var(--suas-ink)!important;border-radius:999px!important;box-shadow:0 5px 0 var(--suas-ink)!important;min-height:40px!important;font:900 10px/1 Futura,Arial,sans-serif!important;letter-spacing:.16em!important;text-transform:uppercase!important;text-decoration:none!important}
    .product-page--featured-blocks [type='submit'],.product-page--featured-blocks button[name='add']{background:var(--suas-pink)!important;color:var(--suas-ink)!important}
    .product-page--featured-blocks .shopify-payment-button__button{background:#311858!important;color:#fff!important}
    .product-page--featured-blocks button:hover,.product-page--featured-blocks .shopify-payment-button__button:hover,.product-page--featured-blocks [type='submit']:hover{transform:translateY(2px)!important;box-shadow:0 3px 0 var(--suas-ink)!important}
    .product-page--description,[data-block-type='description'],[data-block-type*='tabs_product_descriptions']{border-top:1px dashed rgba(16,16,16,.22)!important;padding-top:12px!important;margin-top:10px!important;max-height:340px!important;overflow:auto!important;scrollbar-width:thin!important}
    .product-page--description p,.product-page--description li,[data-block-type*='tabs_product_descriptions'] p,[data-block-type*='tabs_product_descriptions'] li{font-size:12px!important;line-height:1.5!important;font-weight:600!important}
    .product-page--content,.product-page--single-column{width:min(1040px,100%)!important;margin:0 auto!important}
    .product-page--media-variant{width:min(520px,100%)!important;margin:24px auto!important;border:2px solid var(--suas-ink)!important;border-radius:24px!important;background:#fff!important;box-shadow:7px 8px 0 var(--suas-ink)!important;padding:14px!important}
    .product-page--media-variant img{max-height:420px!important;object-fit:contain!important;border-radius:16px!important}

    /* AfterShip / review app stage. App internals may be iframe-protected, so this styles the visible container around your real reviews. */
    [id*='16946386895a53231c'],
    .shopify-section:has([class*='aftership']),
    .shopify-section:has([class*='automizely']),
    .shopify-section:has([class*='asrv']),
    .shopify-section:has([id*='aftership']),
    .shopify-section:has([id*='automizely']),
    .shopify-section:has(.jdgm-widget){width:min(1040px,calc(100vw - 36px))!important;margin:clamp(26px,4vw,58px) auto!important;padding:0!important;background:transparent!important}
    [id*='16946386895a53231c']::before{content:'product love notes.';display:block;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(2rem,5vw,4rem);line-height:.9;text-align:center;margin:0 0 18px;color:#101010;text-transform:uppercase}
    [id*='16946386895a53231c']::after{content:'tap the stars, read the tea, leave the love.';display:block;width:max-content;max-width:calc(100% - 24px);margin:14px auto 0;padding:9px 14px;border:2px solid #101010;border-radius:999px;background:#fff1a8;box-shadow:0 4px 0 #101010;font:900 9px/1 Futura,Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#101010;text-align:center}
    [id*='16946386895a53231c'] .shopify-app-block,
    [id*='16946386895a53231c'] iframe,
    .jdgm-rev-widg,.jdgm-widget:not(.jdgm-preview-badge),
    [class*='aftership'][class*='review'],[class*='automizely'][class*='review'],[class*='asrv'][class*='review']{display:block!important;width:100%!important;max-width:100%!important;border:2px solid #101010!important;border-radius:26px!important;background:linear-gradient(rgba(16,16,16,.028) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.028) 1px,transparent 1px),radial-gradient(circle at 8% 18%,rgba(255,216,232,.78),transparent 30%),radial-gradient(circle at 92% 72%,rgba(217,255,120,.42),transparent 30%),#fff!important;background-size:20px 20px,20px 20px,auto,auto,auto!important;box-shadow:7px 8px 0 #101010!important;overflow:hidden!important;color:#101010!important}
    [id*='16946386895a53231c'] .shopify-app-block{padding:clamp(14px,2vw,22px)!important;min-height:220px!important}
    [id*='16946386895a53231c'] iframe{min-height:360px!important;background:#fff!important}
    .jdgm-rev,.jdgm-question,[class*='review-card'],[class*='review-item'],[class*='asrv'] [class*='review'],[class*='aftership'] [class*='review'],[class*='automizely'] [class*='review']{border:2px solid #101010!important;border-radius:22px!important;background:var(--suas-review-card,#ffd8e8)!important;box-shadow:4px 5px 0 #101010!important;padding:14px!important;margin:13px 0!important;color:#101010!important}
    .jdgm-rev:nth-of-type(2n),[class*='review-item']:nth-of-type(2n){--suas-review-card:#cdeeff}.jdgm-rev:nth-of-type(3n),[class*='review-item']:nth-of-type(3n){--suas-review-card:#fff1a8}.jdgm-rev:nth-of-type(4n),[class*='review-item']:nth-of-type(4n){--suas-review-card:#e4d5ff}
    .jdgm-rev-widg__title,.jdgm-rev-widg h2,.jdgm-widget h2,[class*='review'] h2,[class*='aftership'] h2,[class*='automizely'] h2{font-family:'Casual Human',Futura,Arial,sans-serif!important;font-weight:400!important;letter-spacing:0!important;text-transform:lowercase!important;font-size:clamp(2rem,4vw,3.3rem)!important;line-height:.9!important;color:#101010!important;margin:0 0 12px!important}
    .jdgm-star,.jdgm-star:before,[class*='star']{color:#101010!important}.jdgm-rev__body,.jdgm-rev__body p,[class*='review'] p{font-size:13px!important;line-height:1.42!important;color:#101010!important;font-weight:800!important}
    .jdgm-write-rev-link,.jdgm-submit-rev,.jdgm-btn,button[class*='review'],a[class*='review'],[class*='aftership'] button,[class*='automizely'] button{min-height:38px!important;display:inline-flex!important;align-items:center!important;justify-content:center!important;border:2px solid #101010!important;border-radius:999px!important;background:#ffd8e8!important;color:#101010!important;box-shadow:0 4px 0 #101010!important;padding:9px 15px!important;font:900 9px/1 Futura,Arial,sans-serif!important;letter-spacing:.14em!important;text-transform:uppercase!important;text-decoration:none!important}

    @media(max-width:749px){
      .product-page--root{width:min(430px,calc(100vw - 16px))!important;margin:16px auto 28px!important}
      .product-page--panel-wrapper{grid-template-columns:1fr!important;gap:16px!important}
      .product-page--featured-media,.product-page--featured-blocks{border-radius:20px!important;box-shadow:5px 6px 0 #101010!important}
      .product-page--featured-media{padding:12px!important}.product-page--featured-media img,.product-page--featured-media .image--root img{max-width:100%!important;max-height:320px!important}
      .product-page--featured-blocks{max-width:100%!important;padding:15px!important;justify-self:stretch!important}
      .product-page--heading{font-size:clamp(2rem,13vw,3.25rem)!important;line-height:.86!important;margin-bottom:10px!important}
      .product-page--featured-blocks p,.product-page--featured-blocks li,.product-page--featured-blocks div:not(.product-page--heading){font-size:11px!important;line-height:1.38!important}
      .product-page--description,[data-block-type='description'],[data-block-type*='tabs_product_descriptions']{max-height:260px!important}
      .product-page--media-variant{width:100%!important;border-radius:20px!important;box-shadow:5px 6px 0 #101010!important;padding:10px!important;margin:16px auto!important}
      [id*='16946386895a53231c'],.shopify-section:has([class*='aftership']),.shopify-section:has([class*='automizely']),.shopify-section:has([class*='asrv']),.shopify-section:has([id*='aftership']),.shopify-section:has([id*='automizely']),.shopify-section:has(.jdgm-widget){width:min(430px,calc(100vw - 16px))!important;margin:20px auto!important}
      [id*='16946386895a53231c']::before{font-size:clamp(2rem,12vw,3rem)!important;margin-bottom:12px!important}
      [id*='16946386895a53231c'] .shopify-app-block,[id*='16946386895a53231c'] iframe,.jdgm-rev-widg,.jdgm-widget:not(.jdgm-preview-badge){border-radius:20px!important;box-shadow:5px 6px 0 #101010!important}
      [id*='16946386895a53231c'] iframe{min-height:420px!important}
    }
  </style>
  <script>
    document.addEventListener('DOMContentLoaded',function(){
      var reviewRoot=document.querySelector('[id*="16946386895a53231c"],.jdgm-rev-widg,.jdgm-widget,[class*="judgeme"],[class*="asrv"],[class*="aftership"],[class*="automizely"],[id*="aftership"],[id*="automizely"]');
      if(reviewRoot&&!reviewRoot.id)reviewRoot.id='suas_product_reviews';
      document.querySelectorAll('a[href="#judgeme_product_reviews"],a[href="#aftership_product_reviews"],a[href="#suas_product_reviews"]').forEach(function(link){link.addEventListener('click',function(event){var target=document.getElementById('suas_product_reviews')||document.getElementById('judgeme_product_reviews')||document.querySelector('[id*="16946386895a53231c"],.jdgm-rev-widg,.jdgm-widget,[class*="judgeme"],[class*="asrv"],[class*="aftership"],[class*="automizely"],[id*="aftership"],[id*="automizely"]');if(!target)return;event.preventDefault();target.scrollIntoView({behavior:'smooth',block:'start'});});});
    });
  </script>
</section>
{% schema %}{"name":"SUAS Product Reviews Style","settings":[],"presets":[{"name":"SUAS Product Reviews Style"}]}{% endschema %}
<section class="suas-product-review-style" aria-hidden="true">
  <style>
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
    @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}

    body.template--product{--suas-ink:#101010;--suas-pink:#ffd8e8;--suas-blue:#cdeeff;--suas-yellow:#fff1a8;--suas-green:#d9ff78}

    /* More product photos: real gallery, not a giant empty box. */
    body.template--product .product-page--content{width:min(980px,calc(100vw - 36px))!important;margin:clamp(20px,3vw,36px) auto 0!important;padding:0!important;background:transparent!important;clear:both!important}
    body.template--product .product-page--column-container,body.template--product .product-page--content-blocks:empty{display:none!important}
    body.template--product .product-page--single-column{display:block!important;width:100%!important;max-width:100%!important;margin:0 auto!important;padding:0!important;background:transparent!important;min-height:0!important;overflow:visible!important}
    body.template--product .suas-product-media-gallery{width:min(780px,100%)!important;margin:0 auto clamp(28px,4vw,46px)!important;padding:clamp(16px,2.4vw,24px)!important;border:2px solid var(--suas-ink)!important;border-radius:28px!important;background:linear-gradient(rgba(16,16,16,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.025) 1px,transparent 1px),linear-gradient(135deg,#fff7fb 0%,#fff 56%,#f3ffe1 100%)!important;background-size:20px 20px,20px 20px,auto!important;box-shadow:8px 9px 0 var(--suas-ink)!important;position:relative!important;z-index:1!important;overflow:visible!important}
    body.template--product .suas-product-gallery-label{width:max-content;max-width:calc(100% - 22px);margin:-44px auto 18px;padding:8px 22px 6px;border:2px solid var(--suas-ink);border-radius:999px;background:var(--suas-green);box-shadow:0 5px 0 var(--suas-ink);font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(1.5rem,3vw,2.25rem);line-height:.9;text-transform:lowercase;color:var(--suas-ink);text-align:center;position:relative;z-index:2}
    body.template--product .suas-product-gallery-track{display:grid!important;grid-template-columns:repeat(auto-fit,minmax(220px,1fr))!important;gap:16px!important;align-items:center!important;justify-items:center!important}
    body.template--product .suas-product-gallery-track .product-page--media-variant{width:100%!important;max-width:320px!important;min-height:0!important;margin:0!important;padding:12px!important;border:2px solid var(--suas-ink)!important;border-radius:24px!important;background:#fff!important;box-shadow:5px 6px 0 var(--suas-ink)!important;position:static!important;transform:none!important;overflow:hidden!important}
    body.template--product .suas-product-gallery-track .product-page--media-variant img,body.template--product .suas-product-gallery-track .image--root img{width:100%!important;height:auto!important;max-height:280px!important;object-fit:contain!important;border-radius:18px!important;display:block!important;margin:0 auto!important}

    /* Real review shell around the app section. */
    body.template--product .suas-product-review-shell{width:min(980px,calc(100vw - 36px))!important;margin:clamp(34px,5vw,60px) auto!important;padding:0!important;background:transparent!important;position:relative!important;z-index:2!important;clear:both!important}
    body.template--product .suas-product-review-shell::before{content:none!important}
    body.template--product .suas-review-shell-label{width:max-content;max-width:calc(100% - 22px);margin:0 auto -18px;padding:9px 26px 7px;border:2px solid var(--suas-ink);border-radius:999px;background:var(--suas-green);box-shadow:0 6px 0 var(--suas-ink);font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(1.75rem,3.6vw,2.65rem);line-height:.86;text-transform:lowercase;color:var(--suas-ink);text-align:center;position:relative;z-index:4}
    body.template--product .suas-review-shell-window{border:2px solid var(--suas-ink)!important;border-radius:28px!important;background:linear-gradient(rgba(16,16,16,.026) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.026) 1px,transparent 1px),radial-gradient(circle at 10% 20%,rgba(255,216,232,.9),transparent 30%),radial-gradient(circle at 88% 78%,rgba(217,255,120,.52),transparent 30%),#fff!important;background-size:20px 20px,20px 20px,auto,auto,auto!important;box-shadow:8px 9px 0 var(--suas-ink)!important;overflow:hidden!important;padding:0!important;min-height:0!important}
    body.template--product .suas-review-window-bar{height:36px;display:flex;align-items:center;gap:8px;padding:0 16px;border-bottom:1px solid rgba(16,16,16,.18);background:linear-gradient(#f6f7f9,#e9edf2);font:900 10px/1 Futura,Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#777}
    body.template--product .suas-review-window-bar span{width:13px;height:13px;border-radius:999px;display:block}.suas-review-window-bar span:nth-child(1){background:#ff6257}.suas-review-window-bar span:nth-child(2){background:#ffbd2e}.suas-review-window-bar span:nth-child(3){background:#28c840}
    body.template--product .suas-review-window-bar strong{margin-left:auto;font:900 10px/1 Futura,Arial,sans-serif;letter-spacing:.18em;color:#777;text-transform:uppercase}
    body.template--product .suas-review-app-stage{padding:clamp(18px,2.7vw,30px)!important;background:transparent!important}
    body.template--product .suas-review-app-stage .shopify-app-block{width:100%!important;max-width:100%!important;min-height:170px!important;margin:0!important;padding:clamp(16px,2vw,24px)!important;border:2px solid var(--suas-ink)!important;border-radius:24px!important;background:rgba(255,255,255,.78)!important;box-shadow:5px 6px 0 var(--suas-ink)!important;overflow:hidden!important}
    body.template--product .suas-review-app-stage iframe{width:100%!important;min-height:360px!important;border:0!important;border-radius:18px!important;background:#fff!important}

    body.template--product .suas-review-app-stage button,body.template--product .suas-review-app-stage a[role='button'],body.template--product .suas-review-app-stage [class*='button'],body.template--product [role='dialog'] button,body.template--product [aria-modal='true'] button{border:2px solid var(--suas-ink)!important;border-radius:999px!important;box-shadow:0 4px 0 var(--suas-ink)!important;font:900 10px/1 Futura,Arial,sans-serif!important;letter-spacing:.12em!important;text-transform:uppercase!important}
    body.template--product [role='dialog'],body.template--product [aria-modal='true']{border:2px solid var(--suas-ink)!important;border-radius:24px!important;background:linear-gradient(rgba(16,16,16,.024) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.024) 1px,transparent 1px),linear-gradient(135deg,#fff7fb 0%,#fff 62%,#f3ffe1 100%)!important;background-size:18px 18px,18px 18px,auto!important;box-shadow:8px 9px 0 var(--suas-ink),0 18px 60px rgba(16,16,16,.24)!important;color:var(--suas-ink)!important}
    body.template--product [role='dialog'] input,body.template--product [role='dialog'] textarea,body.template--product [aria-modal='true'] input,body.template--product [aria-modal='true'] textarea{border:1.5px solid var(--suas-ink)!important;border-radius:16px!important;background:rgba(255,255,255,.94)!important}

    @media(max-width:749px){
      body.template--product .product-page--content,body.template--product .suas-product-review-shell{width:min(430px,calc(100vw - 16px))!important}
      body.template--product .suas-product-media-gallery{width:100%!important;margin-top:30px!important;border-radius:22px!important;box-shadow:5px 6px 0 var(--suas-ink)!important;padding:14px!important}
      body.template--product .suas-product-gallery-label{margin-top:-34px;font-size:clamp(1.5rem,9vw,2.05rem)}
      body.template--product .suas-product-gallery-track{grid-template-columns:1fr!important;gap:13px!important}
      body.template--product .suas-product-gallery-track .product-page--media-variant{max-width:100%!important;border-radius:20px!important;box-shadow:4px 5px 0 var(--suas-ink)!important}
      body.template--product .suas-product-gallery-track .product-page--media-variant img,body.template--product .suas-product-gallery-track .image--root img{max-height:260px!important}
      body.template--product .suas-review-shell-label{font-size:clamp(1.7rem,10vw,2.25rem);margin-bottom:-14px}
      body.template--product .suas-review-shell-window{border-radius:22px!important;box-shadow:5px 6px 0 var(--suas-ink)!important}
      body.template--product .suas-review-window-bar strong{display:none}
      body.template--product .suas-review-app-stage{padding:14px!important}
      body.template--product .suas-review-app-stage .shopify-app-block{border-radius:18px!important;box-shadow:4px 5px 0 var(--suas-ink)!important;padding:12px!important}
      body.template--product .suas-review-app-stage iframe{min-height:420px!important}
    }
  </style>
  <script>
    document.addEventListener('DOMContentLoaded',function(){
      var root=document.querySelector('.suas-product-review-shell');
      if(root&&!root.id)root.id='suas_product_reviews';
      document.querySelectorAll('a[href="#judgeme_product_reviews"],a[href="#aftership_product_reviews"],a[href="#suas_product_reviews"]').forEach(function(link){
        link.addEventListener('click',function(event){
          var target=document.getElementById('suas_product_reviews')||root;
          if(!target)return;
          event.preventDefault();
          target.scrollIntoView({behavior:'smooth',block:'start'});
        });
      });
    });
  </script>
</section>
{% schema %}{"name":"SUAS Product Reviews Style","settings":[],"presets":[{"name":"SUAS Product Reviews Style"}]}{% endschema %}
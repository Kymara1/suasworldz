{%- liquid
  assign product_media_t = 'products.product_media' | t
  assign image_modal_t = 'products.image_modal' | t

  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign hide_variant_media = section.settings.hide-variant-media
  assign load_model = false
  assign load_youtube = false
  assign modal_enabled = section.settings.modal-enabled
  assign move_to_next_container = false
  assign featured_blocks = false
  assign product_id = product.id | append: '-' | append: section.id
  assign video_looping_enabled = section.settings.loop-enabled
  assign pdp_name = product.title | split: '?' | first | strip
  assign pdp_name = pdp_name | split: '?????' | first | split: '*' | first | strip
  if product.type != blank
    assign pdp_name = pdp_name | replace: product.type, '' | strip
  endif
  if pdp_name == blank
    assign pdp_name = product.title | split: '?????' | first | split: '?' | first | strip
  endif
  assign pdp_hook = product.description | strip_html | split: '.' | first | strip
  assign pdp_handle = product.handle | downcase
  assign is_lab_experiment = false
  if pdp_handle contains 'lab-session' or pdp_handle contains 'deluxe-lab'
    assign is_lab_experiment = true
  endif
  for lab_col in product.collections
    if lab_col.handle == 'the-lab' or lab_col.handle == 'lab'
      assign is_lab_experiment = true
    endif
  endfor
  assign is_charm_bar = false
  assign pdp_type_down = product.type | downcase
  if pdp_handle contains 'charm-bar' or pdp_type_down contains 'charm'
    assign is_charm_bar = true
  endif
  assign mix_1 = 'handmade'
  assign mix_2 = 'small batch'
  assign mix_3 = 'skin glow'
  assign mix_1_note = 'the open'
  assign mix_2_note = 'the heart'
  assign mix_3_note = 'the drydown'
  if pdp_handle contains 'eau-de-parfum' or pdp_handle contains '-edp'
    if pdp_handle contains 'ember'
      assign mix_1 = 'smoke'
      assign mix_1_note = 'the strike'
      assign mix_2 = 'cocoa'
      assign mix_2_note = 'warm + dense'
      assign mix_3 = 'woods'
      assign mix_3_note = 'the trail'
    elsif pdp_handle contains 'tonic'
      assign mix_1 = 'blackberry'
      assign mix_1_note = 'juicy + sweet'
      assign mix_2 = 'mint'
      assign mix_2_note = 'fresh + cooling'
      assign mix_3 = 'sage'
      assign mix_3_note = 'earthy + herbal'
    elsif pdp_handle contains 'poppy'
      assign mix_1 = 'bubblegum'
      assign mix_1_note = 'sweet + playful'
      assign mix_2 = 'soft florals'
      assign mix_2_note = 'pink lip gloss'
      assign mix_3 = 'skin musk'
      assign mix_3_note = 'the drydown'
    elsif pdp_handle contains 'nectar'
      assign mix_1 = 'pineapple'
      assign mix_1_note = 'bright fruit'
      assign mix_2 = 'passionfruit'
      assign mix_2_note = 'pulp + heat'
      assign mix_3 = 'mango'
      assign mix_3_note = 'the juice'
    endif
  elsif pdp_handle contains 'tonic'
    assign mix_1 = 'blackberry'
    assign mix_1_note = 'juicy + sweet'
    assign mix_2 = 'mint'
    assign mix_2_note = 'fresh + cooling'
    assign mix_3 = 'sage'
    assign mix_3_note = 'earthy + herbal'
  elsif pdp_handle contains 'poppy'
    assign mix_1 = 'bubblegum'
    assign mix_1_note = 'sweet + playful'
    assign mix_2 = 'soft florals'
    assign mix_2_note = 'pink lip gloss'
    assign mix_3 = 'skin musk'
    assign mix_3_note = 'the drydown'
  elsif pdp_handle contains 'haze'
    assign mix_1 = 'wildflower'
    assign mix_1_note = 'bouquet on a breeze'
    assign mix_2 = 'petals'
    assign mix_2_note = 'fresh + pretty'
    assign mix_3 = 'sunshine'
    assign mix_3_note = 'golden hour'
  elsif pdp_handle contains 'good'
    assign mix_1 = 'pear'
    assign mix_1_note = 'juicy + bright'
    assign mix_2 = 'jasmine'
    assign mix_2_note = 'petal-soft'
    assign mix_3 = 'coconut'
    assign mix_3_note = 'the drydown'
  elsif pdp_handle contains 'nectar'
    assign mix_1 = 'nectar'
    assign mix_1_note = 'honeyed fruit'
    assign mix_2 = 'soft florals'
    assign mix_2_note = 'the heart'
    assign mix_3 = 'skin musk'
    assign mix_3_note = 'the drydown'
  endif

  capture variant_media_ids
    for variant in product.variants
      echo '"' | append: variant.featured_media.id | append: '",'
    endfor
  endcapture
  assign variant_media_ids = variant_media_ids | split: ','
-%}

{% for media in product.media %}
  {%- liquid
    if media.media_type == "model"
      assign load_model = true
    elsif media.media_type == "external_video"
      assign load_youtube = true
    endif
  -%}

  {% if modal_enabled %}
    {%- capture modal_media -%}
      {{ modal_media }}

      {% if media.media_type == "image" %}
        <div class="modal--content">
          <div class="product-page--modal-image" data-id="{{ media.id }}">
            {% render 'image', image: media %}
          </div>
        </div>
      {% endif %}
    {%- endcapture -%}
  {% endif %}

  {%- capture variant_media -%}
    {%- liquid
      echo variant_media

      if media == featured_media
        continue
      endif

      capture media_id
        echo '"' | append: media.id | append: '"'
      endcapture
    -%}

    {% if hide_variant_media and variant_media_ids contains media_id %}
      <a
        class="product-page--hidden-variant"
        aria-label="{{ product_media_t }}"
        data-mq="none"
      >
        {%
          render "product--media",
          media_view: "featured",
          product_media: media,
          inside_carousel: false,
          video_looping_enabled: video_looping_enabled
        %}
      </a>

      {% continue %}
    {% endif %}

    <div class="product-page--media-variant">
      {% if modal_enabled and media.media_type == 'image' %}
        <a class="modal--link" tabindex="0" aria-label="{{ product_media_t }}">
      {% endif %}

      {%
        render "product--media",
        media_view: "featured",
        product_media: media,
        inside_carousel: false,
        video_looping_enabled: video_looping_enabled
      %}

      {% if modal_enabled and media.media_type == 'image' %}
        </a>
      {% endif %}
    </div>
  {%- endcapture -%}
{% endfor %}

{%- for block in section.blocks -%}
  {%- liquid
    if block.type == 'divider'
      assign move_to_next_container = true
      continue
    endif

    if block.type == 'scent-note-image'
      continue
    endif
  -%}

  {%- capture block_html -%}
    <div
      class="product-page--block"
      data-product-block
      data-block-type="{{ block.type }}"
      {{ block.shopify_attributes }}
    >
      {%- case block.type -%}
        {%- when 'overline' -%}
          <div class="product-page--overline" data-item="overline">
            {{ block.settings.text }}
          </div>

        {%- when 'heading' -%}
          <h2 class="product-page--heading" data-item="section-heading">
            {{ product.title }}
          </h2>

        {%- when 'vendor' -%}
          <div
            class="product-page--vendor"
            data-item="light-accent-text"
            itemprop="brand"
            content="{{ product.vendor }}"
          >
            <a href="{{ product.vendor | url_for_vendor }}">
              {{ product.vendor }}
            </a>
          </div>

        {%- when 'price' -%}
          {%- render 'product-price', product: product, id: product_id -%}

        {%- when 'low-stock' -%}
          {%
            render 'product-low-stock',
            id: product_id,
            current_variant: current_variant,
            threshold: block.settings.threshold
          %}

        {%- when 'options' -%}
          {%- unless is_lab_experiment -%}
            {%-
              render "product-options",
              id: product_id,
              product: product,
              block_settings: block.settings
            -%}
          {%- endunless -%}

        {%- when 'quantity-input' -%}
          {%- unless is_lab_experiment -%}
            {%- render 'product-quantity', id: product_id -%}
          {%- endunless -%}

        {%- when 'buy-buttons' -%}
          {%- if is_lab_experiment -%}
            <a class="product-buy-buttons--cta suas-lab-book-cta" href="/pages/bookings">book this experiment</a>
          {%- else -%}
            {%-
              render 'product-buy-buttons',
              id: product_id,
              product: product,
              smart_payment_enabled: block.settings.smart-payment-enabled
            -%}
          {%- endif -%}

        {%- when 'unavailable-form' -%}
          {%- unless is_lab_experiment -%}
            {%- render 'product-unavailable-form', product: product, id: product_id -%}
          {%- endunless -%}

        {%- when 'pickup' -%}
          {%- unless is_lab_experiment -%}
            {%- render 'product-pickup', product: product, id: product_id -%}
          {%- endunless -%}

        {%- when 'description' -%}
          {%- unless product.description == blank -%}
            <div
              class="product-page--description"
              data-item="rte-content"
              itemprop="description"
            >
              {{ product.description }}
            </div>
          {%- endunless -%}

        {%- when 'collapsible-tab' -%}
          {%- render 'collapsible-tab', block: block -%}

        {%- when 'rating' -%}
          {%- render 'product-rating' -%}

        {%- when 'liquid' -%}
          {{- block.settings.custom-liquid -}}

        {%- when '@app' -%}
          {%- render block -%}

      {%- endcase -%}
    </div>
  {%- endcapture -%}

  {%- liquid
    unless move_to_next_container
      assign featured_blocks = true
      capture featured_blocks_html
        echo featured_blocks_html
        echo block_html
      endcapture
    else
      capture content_blocks
        echo content_blocks
        echo block_html
      endcapture
    endunless
  -%}
{%- endfor -%}

<div
  class="product-page--root suas-station suas-pdp"
  data-featured-blocks="{{ featured_blocks }}"
  data-section-id="{{ section.id }}"
  data-section-type="product_page"
  data-js-class="Product"
  data-spacing="none"
  data-product-id="{{ product_id }}"
  data-handle="{{ product.handle }}"
  {% if is_lab_experiment %}data-lab-experiment="true"{% endif %}
  {% if is_charm_bar %}data-charm-bar="true"{% endif %}
>
  {%- liquid
    assign pdp_life = featured_media
    assign pdp_type = product.type | downcase
    assign pdp_home = false
    if pdp_type contains 'candle' or pdp_type contains 'mist' or pdp_type contains 'home' or pdp_type contains 'oil' or pdp_handle contains 'candle' or pdp_handle contains 'mist'
      assign pdp_home = true
    endif
  -%}
  <div class="suas-pdp-world suas-station-desk product-page--top-panel">
    <section class="suas-pdp-life" aria-label="{{ product.title | escape }} photos">
      <div class="suas-window-bar">
        <div class="suas-window-dots"><span class="suas-dot" style="--dot:#ff5f57"></span><span class="suas-dot" style="--dot:#febc2e"></span><span class="suas-dot" style="--dot:#28c840"></span></div>
        <span class="suas-window-title">LIVE.LOOK</span>
        <span class="suas-window-live"><b></b>cam</span>
      </div>
      <div class="suas-pdp-life-frame">
        {%- if pdp_life -%}
          <img
            class="suas-pdp-life-photo"
            src="{{ pdp_life | image_url: width: 1600 }}"
            srcset="{{ pdp_life | image_url: width: 800 }} 800w, {{ pdp_life | image_url: width: 1200 }} 1200w, {{ pdp_life | image_url: width: 1600 }} 1600w"
            sizes="(max-width: 1023px) 100vw, 36vw"
            alt="{{ pdp_life.alt | default: product.title | escape }}"
            width="{{ pdp_life.width | default: 1200 }}"
            height="{{ pdp_life.height | default: 1200 }}"
          >
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="suas-station-thumbs" role="list">
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              <button
                type="button"
                class="suas-station-thumb{% if featured_media and media.id == featured_media.id %} is-active{% endif %}"
                data-suas-thumb
                data-src="{{ media | image_url: width: 1600 }}"
                data-srcset="{{ media | image_url: width: 800 }} 800w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1600 }} 1600w"
                data-alt="{{ media.alt | default: product.title | escape }}"
                aria-label="Show photo {{ forloop.index }}"
              >
                <img src="{{ media | image_url: width: 240 }}" alt="">
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </section>

    {%- unless is_lab_experiment or is_charm_bar -%}
    <section class="suas-pdp-diagram" aria-label="what's inside">
      <div class="suas-window-bar">
        <div class="suas-window-dots"><span class="suas-dot" style="--dot:#ff5f57"></span><span class="suas-dot" style="--dot:#febc2e"></span><span class="suas-dot" style="--dot:#28c840"></span></div>
        <span class="suas-window-title">WHAT'S.INSIDE</span>
        <span class="suas-window-live"><b></b>mix</span>
      </div>
      <div class="suas-pdp-diagram-body">
        <article class="suas-pdp-note" data-note="1">
          <strong>{{ mix_1 }}</strong>
        </article>
        <article class="suas-pdp-note" data-note="2">
          <strong>{{ mix_2 }}</strong>
        </article>
        <article class="suas-pdp-note" data-note="3">
          <strong>{{ mix_3 }}</strong>
        </article>
      </div>
      <div class="suas-station-gravity-media" aria-hidden="true">
        {%- if featured_media -%}
          {% render "product--media", media_view: "featured", inside_carousel: false, product_media: featured_media, video_looping_enabled: video_looping_enabled %}
        {%- endif -%}
      </div>
    </section>
    {%- endunless -%}

    <aside class="suas-station-buy suas-pdp-ticket product-page--featured-blocks">
      <div class="suas-window-bar">
        <div class="suas-window-dots"><span class="suas-dot" style="--dot:#ff5f57"></span><span class="suas-dot" style="--dot:#febc2e"></span><span class="suas-dot" style="--dot:#28c840"></span></div>
        <span class="suas-window-title">{% if is_lab_experiment %}BOOK.THIS{% else %}ADD TO CART{% endif %}</span>
        <span class="suas-window-live"><b></b>now</span>
      </div>
      <div class="suas-station-buy-body">
        <h1 class="suas-pdp-name{% if is_charm_bar %} is-compact{% endif %}">{{ pdp_name }}</h1>
        {%- render 'product-rating', product: product, star_link: true -%}
        {%- if product.type != blank -%}
          <p class="suas-pdp-stamp">{{ product.type }}</p>
        {%- endif -%}
        {%- if is_lab_experiment -%}
          <p class="suas-pdp-hook">You mix this in The Lab. It is not a finished bottle sitting on a shelf.</p>
        {%- elsif is_charm_bar -%}
          <p class="suas-pdp-hook">Build it at the Charm Bar. Five seats. Same days as the Lab.</p>
        {%- elsif pdp_hook != blank -%}
          <p class="suas-pdp-hook">{{ pdp_hook }}.</p>
        {%- endif -%}
        {{ featured_blocks_html }}
      </div>
    </aside>
  </div>

  {% render 'suas-product-experience', product: product, note_blocks: section.blocks, is_lab_experiment: is_lab_experiment, is_charm_bar: is_charm_bar %}

  {{ 'suas-pdp-unique.css' | asset_url | stylesheet_tag }}

  <div class="product-page--content" hidden>
    {{ content_blocks }}
  </div>

  <script>
    (function () {
      var root = document.querySelector('[data-product-id="{{ product_id }}"]');
      if (!root) return;
      var photo = root.querySelector('.suas-pdp-life-photo');
      var thumbs = Array.prototype.slice.call(root.querySelectorAll('[data-suas-thumb]'));
      var count = root.querySelector('[data-suas-station-count]');
      var index = Math.max(0, thumbs.findIndex(function (thumb) { return thumb.classList.contains('is-active'); }));
      function show(next) {
        if (!thumbs.length) return;
        index = (next + thumbs.length) % thumbs.length;
        var thumb = thumbs[index];
        if (photo) {
          photo.src = thumb.getAttribute('data-src');
          photo.srcset = thumb.getAttribute('data-srcset') || '';
          photo.alt = thumb.getAttribute('data-alt') || '';
        }
        thumbs.forEach(function (item, i) { item.classList.toggle('is-active', i === index); });
        if (count) count.textContent = (index + 1) + ' / ' + thumbs.length;
      }
      thumbs.forEach(function (thumb, i) {
        thumb.addEventListener('click', function () { show(i); });
      });
      root.querySelectorAll('[data-suas-gallery-dir]').forEach(function (button) {
        button.addEventListener('click', function (event) {
          event.preventDefault();
          show(index + (button.getAttribute('data-suas-gallery-dir') === 'next' ? 1 : -1));
        });
      });
      root.querySelectorAll('[data-suas-mix]').forEach(function (chip) {
        chip.addEventListener('click', function () {
          root.querySelectorAll('[data-suas-mix]').forEach(function (item) { item.classList.toggle('is-on', item === chip); });
          root.style.setProperty('--hot', chip.getAttribute('data-tint') || '#ff9bc4');
        });
      });
      root.addEventListener('variantUpdated', function (event) {
        var variant = event.detail || {};
        var image = variant.featured_image || variant.featured_media || {};
        var src = image.src || image.preview_image || '';
        if (!photo || !src) return;
        photo.src = String(src).replace(/(\.[a-zA-Z]+)(\?|$)/, '_1600x$1$2').replace('http:', 'https:');
        photo.srcset = '';
      });
    })();
  </script>
</div>

{%
  render "product--scripts",
  product: product,
  id: product_id,
  load_model: load_model,
  load_youtube: load_youtube
%}

{% render 'product-schema', product: product %}

{% schema %}
{
  "name": "Product page",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "paragraph",
      "content": "Learn more about [media types](https://help.shopify.com/en/manual/products/product-media)."
    },
    {
      "type": "checkbox",
      "id": "modal-enabled",
      "label": "Enable modal popup",
      "default": true,
      "info": "Opens when clicking a product image"
    },
    {
      "type": "checkbox",
      "id": "hide-variant-media",
      "label": "Hide variant media",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "loop-enabled",
      "label": "Enable video looping",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "overline",
      "name": "Overline text",
      "limit": 1,
      "settings": [
        {
          "label": "Overline text",
          "id": "text",
          "type": "text",
          "default": "Overline text"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": []
    },
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1,
      "settings": []
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": []
    },
    {
      "type": "quantity-input",
      "name": "Quantity input",
      "limit": 1,
      "settings": []
    },
    {
      "type": "low-stock",
      "name": "Low stock notice",
      "limit": 1,
      "settings": [
        {
          "label": "Show low in stock notice when quantity is",
          "id": "threshold",
          "type": "range",
          "min": 0,
          "max": 10,
          "step": 1,
          "default": 5,
          "info": "Set to 0 to disable this feature. Updated for each variant."
        }
      ]
    },
    {
      "type": "options",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "variant-style",
          "label": "Product variant style",
          "options": [
            { "label": "Dropdowns", "value": "dropdowns" },
            { "label": "Buttons", "value": "buttons" }
          ],
          "default": "buttons"
        },
        {
          "type": "checkbox",
          "id": "swatches-enabled",
          "label": "Enable color swatches",
          "default": true,
          "info": "Automatically turn color options into swatches. [Learn more](https://support.troopthemes.com/guide/color-swatch-guide)"

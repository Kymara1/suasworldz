  }

  html body .suas-world-home .suas-cyber-deck {
    padding: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    animation: none !important;
  }

  html body .suas-world-home .suas-cyber-window {
    overflow: visible !important;
    border-radius: 0 !important;
    background: transparent !important;
  }

  html body .suas-world-home .suas-titlebar {

    color: #101010 !important;
    background:
      radial-gradient(circle at 13% 20%, rgba(255, 155, 196, 0.22), transparent 26%),
      radial-gradient(circle at 86% 12%, rgba(255, 232, 107, 0.3), transparent 24%),

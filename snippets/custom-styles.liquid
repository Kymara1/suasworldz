    background-image:
      linear-gradient(rgba(16, 16, 16, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(16, 16, 16, 0.03) 1px, transparent 1px) !important;
    background-size: 34px 34px !important;
    mask-image: none !important;
  }

  html body .suas-world-home .suas-screen:after {
    display: none !important;
  }

  html body .suas-world-home .suas-hud {
    color: rgba(16, 16, 16, 0.54) !important;
  }

  html body .suas-world-home .suas-live {
    color: rgba(16, 16, 16, 0.7) !important;
  }

  html body .suas-world-home .suas-screen h1 {
    color: #101010 !important;
    text-shadow: none !important;
  }

  html body .suas-world-home .suas-screen h1 span {
    color: #ff7eb8 !important;
    background: none !important;
    -webkit-background-clip: initial !important;
    background-clip: initial !important;
  }

  html body .suas-world-home .suas-holo {
    padding: 14px !important;
    border: 1px solid rgba(16, 16, 16, 0.12) !important;
    border-radius: 999px !important;
    background: #101010 !important;
    box-shadow: 0 18px 34px -24px rgba(16, 16, 16, 0.55), 8px 8px 0 rgba(255, 155, 196, 0.34) !important;
    transform: rotate(-3deg) !important;
  }

  html body .suas-world-home .suas-holo:before {
    display: none !important;
  }

  html body .suas-world-home .suas-product-title {
    color: #101010 !important;
  }

  html body .suas-world-home .suas-bar-track {
    background: rgba(16, 16, 16, 0.08) !important;
    box-shadow: inset 0 0 0 1px rgba(16, 16, 16, 0.05) !important;
  }

  html body .suas-world-home .suas-launch-panel {
    border: 1px solid rgba(16, 16, 16, 0.13) !important;
    border-radius: 32px !important;
    background: rgba(255, 255, 255, 0.86) !important;
    box-shadow: 0 24px 54px -36px rgba(16, 16, 16, 0.45) !important;
  }

  html body .suas-world-home .suas-launch {
    border: 1px solid rgba(16, 16, 16, 0.14) !important;
    border-radius: 24px !important;
    background: linear-gradient(180deg, #fff 0%, var(--launch) 130%) !important;
    box-shadow: 0 14px 24px -20px rgba(16, 16, 16, 0.42) !important;
  }

  html body .suas-world-home .suas-log {
    color: #101010 !important;
    border: 1px solid rgba(16, 16, 16, 0.12) !important;
    border-radius: 26px !important;
    background: #ffd8e8 !important;
    box-shadow: 0 18px 34px -28px rgba(16, 16, 16, 0.45) !important;
  }

  html body .suas-world-home .suas-log > .suas-mono,
  html body .suas-world-home .suas-log p {
    font-size: 0 !important;
  }

  html body .suas-world-home .suas-log > .suas-mono:after {
    content: "suas notes" !important;
    display: block !important;
    color: rgba(16, 16, 16, 0.62) !important;
    font-size: 10px !important;
  }

  html body .suas-world-home .suas-log p:after {
    display: block !important;
    font-size: 12px !important;
    line-height: 1.55 !important;
  }

  html body .suas-world-home .suas-log p:nth-of-type(1):after {
    content: "fragrance, self care, home scent, and little experiments." !important;
  }

  html body .suas-world-home .suas-log p:nth-of-type(2):after {
    content: "built by hand in gastonia, nc." !important;
  }

  html body .suas-world-home .suas-log p:nth-of-type(3):after {
    content: "the lab is open for mixing." !important;
  }

  html body .suas-world-home .suas-led {
    border-radius: 999px !important;
    background: #101010 !important;
    box-shadow: 0 14px 22px -18px rgba(16, 16, 16, 0.5) !important;
  }

  /* Remove the duplicate category shelf now that quick launch carries those doors */
  html body .suas-world-home > .suas-cyber-hero + .suas-section {
    display: none !important;
  }

  .suas-panel-dropdown {
    display: block;
    position: relative;
  }

  .suas-panel-dropdown > summary {
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .suas-panel-dropdown > summary::-webkit-details-marker {
    display: none;
  }

  .suas-panel-dropdown > summary .suas-panel-number:after,
  .suas-panel-dropdown > summary .suas-side-num:after {
    content: "+";
    display: inline-block;
    margin-left: 7px;
    opacity: 0.8;
  }

  .suas-panel-dropdown[open] > summary .suas-panel-number:after,
  .suas-panel-dropdown[open] > summary .suas-side-num:after {
    content: "-";
  }

  .suas-panel-submenu {
    display: grid;
    gap: 7px;
    margin: -2px 12px 10px 62px;
    padding: 8px 0 8px 12px;
    border-left: 1px solid rgba(16, 16, 16, 0.12);
  }

  .suas-side-dropdown .suas-panel-submenu {
    margin-left: 54px;
  }

  .suas-panel-submenu a {
    min-height: 31px;
    display: flex;
    align-items: center;
    border-radius: 999px;
    padding: 6px 11px;
    color: #101010;
    background: rgba(255, 255, 255, 0.74);
    text-decoration: none;
    font-family: 'Casual Human', Futura, Arial, sans-serif !important;
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    transition: transform 160ms ease, background 160ms ease, box-shadow 160ms ease;
  }

  .suas-panel-submenu a:hover {
    color: #101010;
    background: rgba(255, 196, 220, 0.68);
    box-shadow: 0 4px 0 rgba(16, 16, 16, 0.12);
    transform: translateX(3px);
  }

  .suas-side-dropdown .suas-panel-submenu a {
    font-size: 0.94rem;
  }

  @media only screen and (max-width: 1023px) {
    html body .suas-world-home .suas-cyber-body {
      grid-template-columns: minmax(0, 1fr) minmax(150px, 0.64fr) !important;
      gap: 10px !important;
      align-items: start !important;
    }

    html body .suas-world-home .suas-screen {
      min-height: auto !important;
      padding: 18px !important;
      border-radius: 24px !important;
    }

    html body .suas-world-home .suas-screen h1 {
      font-size: clamp(2rem, 10vw, 4.2rem) !important;
    }

    html body .suas-world-home .suas-feature {
      gap: 10px !important;
      margin-top: 18px !important;
    }

    html body .suas-world-home .suas-holo {
      width: min(46%, 150px) !important;
    }

    html body .suas-world-home .suas-product-title {
      font-size: clamp(1.25rem, 5vw, 2rem) !important;
    }

    html body .suas-world-home .suas-launch-panel {
      padding: 12px !important;
      gap: 10px !important;
      border-left: 1px solid rgba(16, 16, 16, 0.13) !important;
      border-top: 0 !important;
      border-radius: 24px !important;
    }

    html body .suas-world-home .suas-launch-grid {
      grid-template-columns: 1fr !important;
      gap: 8px !important;
    }

    html body .suas-world-home .suas-launch {
      min-height: 54px !important;
      padding: 9px 10px !important;
      border-radius: 18px !important;
    }

    html body .suas-world-home .suas-launch strong {
      font-size: clamp(1.05rem, 5vw, 1.45rem) !important;
    }

    html body .suas-world-home .suas-launch .suas-mono {
      font-size: 7px !important;
    }

    html body .suas-world-home .suas-log,
    html body .suas-world-home .suas-launch-panel > div:last-child {
      display: none !important;
    }

    .suas-side-dropdown {
      flex: 0 0 auto;
    }

    .suas-side-dropdown .suas-panel-submenu {
      margin: 8px 0 0;
      padding: 8px;
      border-left: 0;
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.92);
      box-shadow: 0 12px 26px -18px rgba(16, 16, 16, 0.48);
    }

    .suas-side-dropdown .suas-panel-submenu a {
      min-height: 29px;
      white-space: nowrap;
      font-size: 0.82rem;
    }
  }

  @media only screen and (max-width: 767px) {
    .header--right-side .x-menu {
      flex-direction: column;
      align-items: flex-start;
    }

    .header--right-side .x-menu li {
      margin-bottom: 10px;
    }
  }
</style>

<script>
  (function () {
    var path = window.location.pathname.replace(/\/$/, '');
    if (path === '/pages/shut-up-and-smell') {
      window.location.replace('/pages/the-lab');
    }

    if (path === '/pages/build-your-formula') {
      window.location.replace('/pages/the-lab#build-a-fragrance');
    }
  })();

  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('a[href="/pages/shut-up-and-smell"], a[href*="/pages/shut-up-and-smell?"]').forEach(function (link) {
      link.setAttribute('href', '/pages/the-lab');
    });

    document.querySelectorAll('a[href="/pages/build-your-formula"], a[href*="/pages/build-your-formula?"]').forEach(function (link) {
      link.setAttribute('href', '/pages/the-lab#build-a-fragrance');
    });

    var panelSubmenus = {
      body: [
        { title: 'butter creme', href: '/collections/butter-creme' },
        { title: 'body scrub', href: '/collections/body-scrub' },
        { title: 'body jelly', href: '/collections/body-jelly' },
        { title: 'body oil', href: '/collections/body-oil' },
        { title: 'cleansing bar', href: '/collections/cleansing-bar' },
        { title: 'body wash', href: '/collections/body-wash' }
      ],
      home: [
        { title: 'candles', href: '/collections/candles' },
        { title: 'everything mist', href: '/collections/everything-mist' },
        { title: 'burnt oils', href: '/collections/burnt-oils' }
      ]
    };

    function addControlSubmenu(selector, items, dropdownClass) {
      document.querySelectorAll(selector).forEach(function (link) {
        if (link.closest('.suas-panel-dropdown')) return;

        var details = document.createElement('details');
        details.className = 'suas-panel-dropdown ' + dropdownClass;

        var summary = document.createElement('summary');
        summary.className = link.className;
        summary.innerHTML = link.innerHTML;
        details.appendChild(summary);

        var menu = document.createElement('div');
        menu.className = 'suas-panel-submenu';

        items.forEach(function (item) {
          var child = document.createElement('a');
          child.href = item.href;
          child.textContent = item.title;
          menu.appendChild(child);
        });

        details.appendChild(menu);
        link.replaceWith(details);
      });
    }

    addControlSubmenu('.suas-side-nav > a.suas-side-link[href="/collections/body-care"]', panelSubmenus.body, 'suas-side-dropdown');
    addControlSubmenu('.suas-side-nav > a.suas-side-link[href="/collections/home-care"]', panelSubmenus.home, 'suas-side-dropdown');
    addControlSubmenu('.suas-panel-nav > a.suas-panel-link[href="/collections/body-care"]', panelSubmenus.body, 'suas-home-panel-dropdown');
    addControlSubmenu('.suas-panel-nav > a.suas-panel-link[href="/collections/home-care"]', panelSubmenus.home, 'suas-home-panel-dropdown');

    var grid = document.querySelector('.suas-world-home .suas-launch-grid');
    if (!grid || grid.querySelector('[data-suas-extra-launch="new-arrivals"]')) return;

    var links = [
      { key: 'new-arrivals', title: 'new arrivals', href: '/collections/new-arrivals', color: '#c6f76a', glow: '198,247,106' },
      { key: 'best-sellers', title: 'best sellers', href: '/collections/best-sellers', color: '#ffd8e8', glow: '255,216,232' },
      { key: 'oddities', title: 'oddities', href: '/collections/oddities', color: '#c7b5ff', glow: '199,181,255' }
    ];

    links.forEach(function (item) {
      var link = document.createElement('a');
      link.className = 'suas-launch';
      link.href = item.href;
      link.dataset.suasExtraLaunch = item.key;
      link.style.setProperty('--launch', item.color);
      link.style.setProperty('--glow', item.glow);
      link.innerHTML = '<strong class="suas-font">' + item.title + '</strong><span class="suas-mono">launch</span>';
      grid.appendChild(link);
    });
  });
</script>

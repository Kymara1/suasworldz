<style>
  @font-face{font-family:"Casual Human";src:url({{ 'CasualHuman.otf' | asset_url }}) format("opentype");font-display:swap}
  @font-face{font-family:"Casual Human";src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format("opentype");font-weight:700;font-display:swap}
  .suas-os-account{--ink:#101010;--cream:#fbfaf7;--pink:#ffd8e8;--hot:#ff9bc4;--blue:#cdeeff;--lime:#d9ff78;--lav:#e4d5ff;--sun:#fff1a8;min-height:86vh;padding:14px 12px 64px;color:var(--ink);background:linear-gradient(rgba(16,16,16,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.035) 1px,transparent 1px),radial-gradient(circle at 8% 14%,rgba(255,216,232,.55),transparent 28%),radial-gradient(circle at 90% 76%,rgba(217,255,120,.28),transparent 30%),var(--cream);background-size:22px 22px,22px 22px,auto,auto,auto;font-family:Futura,"Futura PT",Arial,sans-serif}
  .suas-os-account *{box-sizing:border-box}
  .suas-os-account a{color:inherit;text-decoration:none}
  .suas-os-account .suas-font{font-family:"Casual Human",Futura,Arial,sans-serif!important;font-weight:400!important;letter-spacing:0!important}
  .suas-os-account .suas-mono{font-family:Futura,"Futura PT",Arial,sans-serif;font-size:10px;letter-spacing:.22em;text-transform:uppercase;font-weight:900}
  .suas-os-wrap{width:min(640px,calc(100vw - 24px));margin:0 auto}
  .suas-os-wrap.is-wide{width:min(1180px,calc(100vw - 24px))}
  .suas-os-billboard{display:grid;justify-items:center;gap:0;padding:8px 2px 18px;text-align:center}
  .suas-os-account .suas-home-logo{position:relative;display:grid;place-items:center;width:220px;height:220px;color:inherit;overflow:visible}
  .suas-os-account .suas-home-logo-img{grid-area:1/1;display:block;width:152px;height:152px;max-width:152px;object-fit:contain;background:#000;border:2px solid var(--ink);border-radius:16px;box-shadow:3px 4px 0 var(--ink);z-index:1}
  .suas-os-account .suas-home-logo-img--season{display:none}
  .suas-os-account .suas-home-logo-arc{grid-area:1/1;width:220px;height:220px;overflow:visible;pointer-events:none;z-index:2}
  .suas-os-account .suas-home-logo-arc-text{font-family:Futura,'Futura PT',Arial,sans-serif;font-weight:900;font-size:13.5px;letter-spacing:.08em;text-transform:uppercase;fill:var(--ink,#101010);dominant-baseline:hanging}
  .suas-os-account .suas-home-logo-tag{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
  .suas-os-win{border:2px solid var(--ink);border-radius:24px;background:rgba(255,255,255,.93);box-shadow:5px 6px 0 var(--ink);overflow:hidden}
  .suas-os-winbar{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:10px;min-height:42px;padding:8px 14px;border-bottom:2px solid var(--ink);background:linear-gradient(180deg,#fff,#e8edf3)}
  .suas-os-dots{display:flex;gap:7px}
  .suas-os-dot{width:11px;height:11px;border-radius:999px;background:var(--dot)}
  .suas-os-wintitle{text-align:center;font-size:10px;letter-spacing:.2em;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .suas-os-live{display:inline-flex;align-items:center;gap:6px;font-size:9px;font-weight:900;letter-spacing:.16em}
  .suas-os-live b{width:8px;height:8px;border-radius:999px;background:#28c840;box-shadow:0 0 0 4px rgba(40,200,64,.18);animation:suasOsBlink 1.4s steps(2,end) infinite}
  @keyframes suasOsBlink{50%{opacity:.35}}
  .suas-os-body{display:grid;gap:14px;padding:clamp(16px,3vw,28px)}
  .suas-os-kicker{margin:0;color:rgba(16,16,16,.62);font:900 9px/1 Futura,Arial,sans-serif;letter-spacing:.18em;text-transform:uppercase}
  .suas-os-title{margin:0;font-size:clamp(2.8rem,8vw,5.4rem);line-height:.82;text-transform:lowercase}
  .suas-os-copy{margin:0;max-width:52ch;color:rgba(16,16,16,.66);font-size:13px;line-height:1.45;font-weight:800}
  .suas-os-tabs,.suas-os-actions{display:flex;flex-wrap:wrap;gap:8px}
  .suas-os-tab,.suas-os-btn{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:10px 16px;border:2px solid var(--ink);border-radius:999px;background:#fff;box-shadow:0 4px 0 var(--ink);font:900 10px/1 Futura,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase;cursor:pointer}
  .suas-os-tab:hover,.suas-os-btn:hover{transform:translateY(2px);box-shadow:0 2px 0 var(--ink);background:var(--pink)}
  .suas-os-tab.is-on,.suas-os-btn.is-dark{background:var(--ink);color:#fff}
  .suas-os-form{display:grid;gap:12px}
  .suas-os-field{display:grid;gap:6px}
  .suas-os-field label{font:900 9px/1 Futura,Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:rgba(16,16,16,.62)}
  .suas-os-field input,.suas-os-field textarea,.suas-os-field select{width:100%;min-height:48px;border:2px solid var(--ink);border-radius:16px;background:#fff;padding:12px 14px;color:var(--ink);font:800 15px/1.3 Futura,Arial,sans-serif;box-shadow:0 3px 0 rgba(16,16,16,.12)}
  .suas-os-field textarea{min-height:110px;resize:vertical}
  .suas-os-two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .suas-os-errors{margin:0;color:#b10d2a;font-size:12px;font-weight:800}
  .suas-os-errors:empty,.suas-os-errors:not(:has(*)){display:none}
  .suas-os-errors ul{margin:0;padding-left:18px}
  .suas-os-auth{display:none}
  .suas-os-auth.is-on{display:block}
  .suas-os-mid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(260px,.9fr);gap:12px;align-items:start}
  .suas-os-launch{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .suas-os-tile{min-height:86px;display:flex;flex-direction:column;justify-content:center;padding:14px;border:1.75px solid var(--ink);border-radius:18px;background:var(--tile,#ffd8e8);box-shadow:0 4px 0 var(--ink);text-align:left;cursor:pointer}
  .suas-os-tile:hover{transform:translateY(2px);box-shadow:0 2px 0 var(--ink)}
  .suas-os-tile.is-on{background:var(--ink);color:#fff}
  .suas-os-tile strong{font-size:1.35rem;line-height:.9;text-transform:lowercase}
  .suas-os-tile span{margin-top:5px;font-size:9px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}
  .suas-os-ticket{display:grid;grid-template-columns:48px minmax(0,1fr) auto;gap:11px;align-items:center;min-height:70px;padding:12px;border:2px solid var(--ink);border-radius:18px;background:#fff;box-shadow:0 4px 0 var(--ink)}
  .suas-os-icon{display:grid;place-items:center;width:48px;height:48px;border-radius:999px;background:var(--tile,#fff1a8);font-family:"Casual Human",Futura,Arial,sans-serif}
  .suas-os-ticket strong{display:block;font-size:14px}
  .suas-os-ticket small{display:block;color:rgba(16,16,16,.62);font-size:11px;font-weight:800}
  .suas-os-list{display:grid;gap:10px}
  .suas-os-view{display:none}
  .suas-os-view.is-on{display:grid;gap:12px}
  .suas-os-empty{padding:14px;border:1.5px dashed rgba(16,16,16,.35);border-radius:18px;color:rgba(16,16,16,.62);font-size:12px;font-weight:800}
  .suas-os-note{padding:10px 12px;border:1.5px solid rgba(16,16,16,.18);border-radius:16px;background:rgba(255,255,255,.72);font-size:11px;font-weight:800;color:rgba(16,16,16,.62)}
  .suas-os-toast{position:fixed;right:16px;bottom:16px;z-index:9999;max-width:min(330px,calc(100vw - 32px));padding:13px 15px;border:2px solid var(--ink);border-radius:18px;background:var(--lime);box-shadow:5px 6px 0 var(--ink);font-size:12px;font-weight:900;opacity:0;transform:translateY(12px);pointer-events:none;transition:opacity 180ms ease,transform 180ms ease}
  .suas-os-number{margin:0;font-size:clamp(3.6rem,8vw,6.4rem);line-height:.82}
  .suas-os-progress{height:14px;border:2px solid var(--ink);border-radius:999px;background:rgba(16,16,16,.1);overflow:hidden}
  .suas-os-progress span{display:block;height:100%;width:var(--progress,0%);background:var(--lime)}
  .suas-os-row{display:flex;justify-content:space-between;gap:8px;font-size:11px;font-weight:800;color:rgba(16,16,16,.62)}
  .suas-os-check{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:800}
  .suas-os-addr-form{display:none}
  .suas-os-addr-form.is-on{display:block}
  button.suas-os-ticket{width:100%;text-align:left;cursor:pointer;font:inherit;color:inherit}
  .suas-os-actions a{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:10px 16px;border:2px solid var(--ink);border-radius:999px;background:#fff;box-shadow:0 4px 0 var(--ink);font:900 10px/1 Futura,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase}
  @media(max-width:900px){.suas-os-mid{grid-template-columns:1fr}}
  @media(max-width:560px){
    .suas-os-account{padding:10px 8px 48px}
    .suas-os-account .suas-home-logo{width:176px;height:176px}
    .suas-os-account .suas-home-logo-img{width:118px;height:118px;max-width:118px;border-radius:999px;box-shadow:2px 3px 0 var(--ink)}
    .suas-os-account .suas-home-logo-arc{width:176px;height:176px}
    .suas-os-account .suas-home-logo-arc-text{font-size:13px}
    .suas-os-title{font-size:clamp(2.4rem,14vw,3.8rem)}
    .suas-os-two,.suas-os-launch{grid-template-columns:1fr}
    .suas-os-live{display:none}
    .suas-os-ticket{grid-template-columns:38px minmax(0,1fr)}
    .suas-os-ticket .suas-os-mini{display:none}
  }
  @media(prefers-reduced-motion:reduce){.suas-os-live b{animation:none!important}}
</style>

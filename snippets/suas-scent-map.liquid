{%- comment -%}
Generated from ops/config/scent-notes.json. Do not hand-edit.
Fields: handle|pdpLabel|familyLabel|file|family
Uncategorized notes default to sparkle.
{%- endcomment -%}
{%- assign suas_scent_map = '' -%}
{%- if suas_scent_mode == 'pdp' -%}
  {%- assign pdp_handle = product.handle | downcase -%}
  {%- assign pdp_scent = pdp_handle | replace: '-eau-de-parfum', '' | replace: '-cologne', '' | replace: '-butter-creme-copy', '' | replace: '-butter-creme-2', '' | replace: '-butter-creme', '' | replace: '-body-oil', '' | replace: '-body-wash', '' | replace: '-body-scrub', '' | replace: '-cleansing-bar', '' | replace: '-skin-jelly', '' | replace: '-body-jelly', '' -%}
  {%- assign scent_records = suas_scent_map | split: '||' -%}
  {%- assign pdp_exact_count = 0 -%}
  {%- for rec in scent_records -%}
    {%- assign np = rec | split: '|' -%}
    {%- if np[0] == pdp_handle -%}
      {%- assign pdp_exact_count = pdp_exact_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign pdp_note_count = 0 -%}
  {%- for rec in scent_records -%}
    {%- assign np = rec | split: '|' -%}
    {%- assign rec_scent = np[0] | replace: '-eau-de-parfum', '' | replace: '-cologne', '' | replace: '-butter-creme-copy', '' | replace: '-butter-creme-2', '' | replace: '-butter-creme', '' | replace: '-body-oil', '' | replace: '-body-wash', '' | replace: '-body-scrub', '' | replace: '-cleansing-bar', '' | replace: '-skin-jelly', '' | replace: '-body-jelly', '' -%}
    {%- if pdp_exact_count > 0 -%}
      {%- if np[0] == pdp_handle -%}
        {%- assign pdp_note_count = pdp_note_count | plus: 1 -%}
      {%- endif -%}
    {%- elsif np[0] == pdp_handle or rec_scent == pdp_scent -%}
      {%- assign pdp_note_count = pdp_note_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if pdp_note_count > 0 -%}
    <div class="suas-scent-notes">
      <div class="suas-scent-notes-grid{% if pdp_note_count == 3 %} is-three{% endif %}">
        {%- for rec in scent_records -%}
          {%- assign np = rec | split: '|' -%}
          {%- assign rec_scent = np[0] | replace: '-eau-de-parfum', '' | replace: '-cologne', '' | replace: '-butter-creme-copy', '' | replace: '-butter-creme-2', '' | replace: '-butter-creme', '' | replace: '-body-oil', '' | replace: '-body-wash', '' | replace: '-body-scrub', '' | replace: '-cleansing-bar', '' | replace: '-skin-jelly', '' | replace: '-body-jelly', '' -%}
          {%- assign show_note = false -%}
          {%- if pdp_exact_count > 0 -%}
            {%- if np[0] == pdp_handle -%}{%- assign show_note = true -%}{%- endif -%}
          {%- elsif np[0] == pdp_handle or rec_scent == pdp_scent -%}
            {%- assign show_note = true -%}
          {%- endif -%}
          {%- if show_note -%}
            <figure class="suas-scent-note">
              <span class="pic"><img src="{{ np[3] | asset_url }}" alt="{{ np[1] }}" width="800" height="800" loading="lazy"></span>
              <b>{{ np[1] }}</b>
            </figure>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
{%- elsif suas_scent_mode == 'families' -%}
  {%- assign scent_records = suas_scent_map | split: '||' -%}
  {%- assign family_order = 'fruit,floral,gourmand,green,sparkle' | split: ',' -%}
  {%- for family in family_order -%}
    <article class="suas-family">
      <a class="suas-family-name" href="/collections/scent-{{ family }}">{{ family }}</a>
      <div class="suas-family-shots">
        {%- assign seen_notes = '|' -%}
        {%- for rec in scent_records -%}
          {%- assign np = rec | split: '|' -%}
          {%- if np[4] == family -%}
            {%- assign note_key = np[2] | append: '|' -%}
            {%- unless seen_notes contains note_key -%}
              {%- assign seen_notes = seen_notes | append: note_key -%}
              <a href="/products/{{ np[0] }}">
                <img src="{{ np[3] | asset_url }}" alt="{{ np[2] }}" width="800" height="800" loading="lazy">
                <b>{{ np[2] }}</b>
              </a>
            {%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </article>
  {%- endfor -%}
{%- endif -%}
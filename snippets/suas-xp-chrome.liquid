{% comment %}
  SUAS window chrome in brand color: ink bars, round lime / hot pink / cream lights.
  Round frames stay. No Luna blue, no pumpkin bars.
{% endcomment %}
<style id="suas-xp-chrome">
  html body .suas-window-bar,
  html body .suas-os-winbar,
  html body .suas-cart-winbar,
  html body .suas-review-window-bar,
  html body .suas-xp-bar,
  html body .suas-lab-bar,
  html body .suas-lab-titlebar,
  html body .suas-catalog-head-bar,
  html body .suas-story-winbar,
  html body .suas-search-bar,
  html body .suas-rev-bar,
  html body .suas-window-strip {
    background: linear-gradient(180deg, #242424 0%, #101010 100%) !important;
    color: #d9ff78 !important;
    border-bottom: 2px solid #101010 !important;
  }

  html body .suas-window-title,
  html body .suas-os-wintitle,
  html body .suas-cart-win-title,
  html body .suas-xp-title,
  html body .suas-lab-bar-title,
  html body .suas-catalog-head-bar b,
  html body .suas-story-win-title,
  html body .suas-search-bar b,
  html body .suas-window-live,
  html body .suas-os-live,
  html body .suas-lab-live,
  html body .suas-cart-chip,
  html body .suas-review-window-bar strong {
    color: #d9ff78 !important;
    text-shadow: none;
  }

  html body .suas-dot,
  html body .suas-os-dot,
  html body .suas-lab-dot,
  html body .suas-catalog-dot,
  html body .suas-story-dot,
  html body .suas-rev-dot,
  html body .suas-cart-dots i,
  html body .suas-xp-btns i,
  html body .suas-review-window-bar span,
  html body .suas-pr-dot,
  html body .suas-review-picker__dot {
    width: 11px !important;
    height: 11px !important;
    border-radius: 999px !important;
    border: 1.5px solid #101010 !important;
    box-shadow: none !important;
  }
  html body .suas-dot:nth-child(1),
  html body .suas-os-dot:nth-child(1),
  html body .suas-lab-dot:nth-child(1),
  html body .suas-catalog-dot:nth-child(1),
  html body .suas-story-dot:nth-child(1),
  html body .suas-rev-dot:nth-child(1),
  html body .suas-cart-dots i:nth-child(1),
  html body .suas-review-window-bar span:nth-child(1),
  html body .suas-pr-dot:nth-child(1),
  html body .suas-review-picker__dot:nth-child(1) {
    background: #ff9bc4 !important;
  }
  html body .suas-dot:nth-child(2),
  html body .suas-os-dot:nth-child(2),
  html body .suas-lab-dot:nth-child(2),
  html body .suas-catalog-dot:nth-child(2),
  html body .suas-story-dot:nth-child(2),
  html body .suas-rev-dot:nth-child(2),
  html body .suas-cart-dots i:nth-child(2),
  html body .suas-review-window-bar span:nth-child(2) {
    background: #d9ff78 !important;
  }
  html body .suas-dot:nth-child(3),
  html body .suas-os-dot:nth-child(3),
  html body .suas-lab-dot:nth-child(3),
  html body .suas-catalog-dot:nth-child(3),
  html body .suas-story-dot:nth-child(3),
  html body .suas-rev-dot:nth-child(3),
  html body .suas-cart-dots i:nth-child(3),
  html body .suas-review-window-bar span:nth-child(3) {
    background: #f4ecd4 !important;
  }

  html body .suas-window-live b,
  html body .suas-os-live b {
    background: #d9ff78 !important;
    box-shadow: 0 0 0 3px rgba(217, 255, 120, .28) !important;
  }
</style>

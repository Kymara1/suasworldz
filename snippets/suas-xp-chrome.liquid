{% comment %}
  SUAS.OS window chrome: Windows XP Luna title bars, not iOS traffic lights.
  Halloween/fall recasts Luna as pumpkin-to-wine. After the season, bars go classic blue.
{% endcomment %}
<style id="suas-xp-chrome">
  html {
    --suas-xp-bar: linear-gradient(180deg, #6eb0f8 0%, #2b7ae4 42%, #1554be 100%);
    --suas-xp-ink: #fff;
    --suas-xp-close: linear-gradient(#e35d4f, #c42b1c);
    --suas-xp-btn: linear-gradient(#fff, #c5d3ea);
  }
  html.suas-halloween {
    --suas-xp-bar: linear-gradient(180deg, #f0b15a 0%, #e07a3d 36%, #a43b24 72%, #6b2430 100%);
    --suas-xp-ink: #fff8ee;
    --suas-xp-close: linear-gradient(#ffd8a8, #c45c26);
    --suas-xp-btn: linear-gradient(#fff8ee, #e6c9a0);
  }

  html:not(.suas-men):not(.suas-station-page) .suas-side-rail {
    background: linear-gradient(180deg, #fffdf6 0%, #f4ecd4 72%, #ece4c8 100%) !important;
    border-right: 2px solid #101010 !important;
  }
  html:not(.suas-men):not(.suas-station-page) .suas-side-head {
    margin: 10px 10px 4px !important;
    padding: 10px 12px !important;
    border: 2px solid #101010 !important;
    background: var(--suas-xp-bar) !important;
    color: var(--suas-xp-ink) !important;
    box-shadow: 3px 3px 0 #101010 !important;
  }
  html:not(.suas-men):not(.suas-station-page) .suas-side-brand {
    color: var(--suas-xp-ink) !important;
    text-shadow: 1px 1px 0 rgba(16, 16, 16, .35);
  }
  html:not(.suas-men):not(.suas-station-page) .suas-side-status {
    border: 2px solid #101010 !important;
    background: #fff !important;
    box-shadow: 3px 4px 0 #101010 !important;
  }

  html body .suas-window-bar,
  html body .suas-os-winbar,
  html body .suas-cart-winbar,
  html body .suas-review-window-bar,
  html body .suas-xp-bar,
  html body .suas-lab-bar,
  html body .suas-lab-titlebar,
  html body .suas-catalog-head-bar,
  html body .suas-story-winbar,
  html body .suas-search-bar,
  html body .suas-rev-bar,
  html body .suas-window-strip {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    background: var(--suas-xp-bar) !important;
    color: var(--suas-xp-ink) !important;
    border-bottom: 2px solid #101010 !important;
  }

  html body .suas-window-title,
  html body .suas-os-wintitle,
  html body .suas-cart-win-title,
  html body .suas-xp-title,
  html body .suas-lab-bar-title,
  html body .suas-catalog-head-bar b,
  html body .suas-story-win-title,
  html body .suas-search-bar b,
  html body .suas-window-live,
  html body .suas-os-live,
  html body .suas-lab-live,
  html body .suas-cart-chip,
  html body .suas-review-window-bar strong {
    color: var(--suas-xp-ink) !important;
    text-align: left !important;
    text-shadow: 1px 1px 0 rgba(16, 16, 16, .35);
  }

  html body .suas-window-title,
  html body .suas-os-wintitle,
  html body .suas-cart-win-title,
  html body .suas-xp-title,
  html body .suas-lab-bar-title {
    flex: 1 1 auto !important;
    order: 1 !important;
    min-width: 0;
    font-family: Tahoma, 'Segoe UI', Futura, Arial, sans-serif !important;
    letter-spacing: .06em !important;
  }

  html body .suas-window-live,
  html body .suas-os-live,
  html body .suas-lab-live,
  html body .suas-cart-chip {
    order: 2 !important;
    flex: 0 0 auto !important;
    opacity: .92;
  }

  html body .suas-window-dots,
  html body .suas-os-dots,
  html body .suas-cart-dots,
  html body .suas-lab-dots,
  html body .suas-story-dots,
  html body .suas-xp-btns {
    order: 3 !important;
    margin-left: 0 !important;
    display: flex !important;
    gap: 3px !important;
    flex: 0 0 auto !important;
  }

  html body .suas-dot,
  html body .suas-os-dot,
  html body .suas-lab-dot,
  html body .suas-catalog-dot,
  html body .suas-story-dot,
  html body .suas-rev-dot,
  html body .suas-cart-dots i,
  html body .suas-xp-btns i,
  html body .suas-review-window-bar span,
  html body .suas-pr-dot,
  html body .suas-review-picker__dot {
    width: 14px !important;
    height: 13px !important;
    border-radius: 2px !important;
    border: 1px solid #fff !important;
    box-shadow: 0 1px 0 rgba(16, 16, 16, .35) !important;
    background: var(--suas-xp-btn) !important;
  }

  html body .suas-dot:nth-child(1),
  html body .suas-os-dot:nth-child(1),
  html body .suas-lab-dot:nth-child(1),
  html body .suas-catalog-dot:nth-child(1),
  html body .suas-story-dot:nth-child(1),
  html body .suas-rev-dot:nth-child(1),
  html body .suas-cart-dots i:nth-child(1),
  html body .suas-review-window-bar span:nth-child(1),
  html body .suas-xp-btns i.x,
  html body .suas-pr-dot:nth-child(1),
  html body .suas-review-picker__dot:nth-child(1) {
    order: 3;
    background: var(--suas-xp-close) !important;
  }
  html body .suas-dot:nth-child(2),
  html body .suas-os-dot:nth-child(2),
  html body .suas-lab-dot:nth-child(2),
  html body .suas-catalog-dot:nth-child(2),
  html body .suas-story-dot:nth-child(2),
  html body .suas-rev-dot:nth-child(2),
  html body .suas-cart-dots i:nth-child(2),
  html body .suas-review-window-bar span:nth-child(2),
  html body .suas-xp-btns i.min {
    order: 1;
  }
  html body .suas-dot:nth-child(3),
  html body .suas-os-dot:nth-child(3),
  html body .suas-lab-dot:nth-child(3),
  html body .suas-catalog-dot:nth-child(3),
  html body .suas-story-dot:nth-child(3),
  html body .suas-rev-dot:nth-child(3),
  html body .suas-cart-dots i:nth-child(3),
  html body .suas-review-window-bar span:nth-child(3),
  html body .suas-xp-btns i.max {
    order: 2;
  }

  html body .suas-window-live b,
  html body .suas-os-live b {
    background: #d9ff78 !important;
    box-shadow: 0 0 0 3px rgba(217, 255, 120, .25) !important;
  }
  html.suas-halloween body .suas-window-live b,
  html.suas-halloween body .suas-os-live b {
    background: #e6c35c !important;
    box-shadow: 0 0 0 3px rgba(230, 195, 92, .28) !important;
  }

  /* Grown OS: cream desk, Luna chrome, color as a hit — not candy pills. */
  html:not(.suas-men):not(.suas-station-page) body,
  html:not(.suas-men):not(.suas-station-page) .off-canvas--main-content,
  html:not(.suas-men):not(.suas-station-page) .layout--main-content,
  html:not(.suas-men) body.template--collection .layout--main-content,
  html:not(.suas-men) body.template--search .layout--main-content,
  html:not(.suas-men) body.page--dupe .layout--main-content {
    background: linear-gradient(180deg, rgba(21, 84, 190, .14) 0%, rgba(244, 239, 227, 0) 140px), #f4efe3 !important;
    background-attachment: scroll !important;
  }
  html:not(.suas-men) .suas-world-home,
  html:not(.suas-men) .suas-bookings-page,
  html:not(.suas-men) .suas-contact-page,
  html:not(.suas-men) .suas-story-page,
  html:not(.suas-men) .suas-visit-page,
  html:not(.suas-men) .suas-a11y-page,
  html:not(.suas-men) .suas-reviews,
  html:not(.suas-men) .suas-lab-page {
    background: transparent !important;
  }

  html:not(.suas-men) .suas-side-orb,
  html:not(.suas-men) .suas-home-logo-orb,
  html:not(.suas-men) .suas-home-logo .suas-side-orb {
    background: #d9ff78 !important;
    border: 2px solid #101010 !important;
    box-shadow: inset 0 -3px 0 rgba(16, 16, 16, .2), 2px 2px 0 #101010 !important;
  }

  html:not(.suas-men) .suas-side-link,
  html:not(.suas-men) .suas-panel-submenu a,
  html:not(.suas-men) .suas-side-status,
  html:not(.suas-men) .suas-os-search,
  html:not(.suas-men) .suas-aisle,
  html:not(.suas-men) .suas-aisle-chips a,
  html:not(.suas-men) .suas-men-jump,
  html:not(.suas-men) .suas-now-card,
  html:not(.suas-men) .suas-launch-panel,
  html:not(.suas-men) .suas-hours-win,
  html:not(.suas-men) .suas-boost,
  html:not(.suas-men) .suas-feed-notes,
  html:not(.suas-men) .suas-launch,
  html:not(.suas-men) .suas-btn,
  html:not(.suas-men) .suas-feed-btn,
  html:not(.suas-men) .suas-feed-atc,
  html:not(.suas-men) .suas-product-price,
  html:not(.suas-men) .suas-product-photo,
  html:not(.suas-men) .suas-product-copy,
  html:not(.suas-men) .suas-boost-card,
  html:not(.suas-men) .suas-catalog-head,
  html:not(.suas-men) .suas-search-win,
  html:not(.suas-men) .suas-search-go,
  html:not(.suas-men) .suas-search-close,
  html:not(.suas-men) .suas-rotator-pause {
    border-radius: 3px !important;
  }
  html:not(.suas-men) .suas-aisle {
    background-image: none !important;
  }
  html:not(.suas-men) .suas-aisle--body { background-color: #f0c9d8 !important; }
  html:not(.suas-men) .suas-aisle--home { background-color: #efe3a8 !important; }
  html:not(.suas-men) .suas-aisle-chips a {
    background: #fffef8 !important;
    font-family: Tahoma, Futura, Arial, sans-serif !important;
    letter-spacing: .04em !important;
  }
  html:not(.suas-men) .suas-panel-submenu a {
    background: #fffef8 !important;
  }
  html:not(.suas-men) .suas-panel-submenu a:hover,
  html:not(.suas-men) .suas-side-link.is-active {
    background: #d9ff78 !important;
    color: #101010 !important;
  }
  html:not(.suas-men) .suas-side-status {
    border-radius: 3px !important;
  }
  html:not(.suas-men) .suas-home-h1 {
    color: #101010 !important;
    text-shadow: none !important;
  }
  html:not(.suas-men) body.template--collection .suas-catalog-card.product--root,
  html:not(.suas-men) body.template--search .suas-catalog-card.product--root,
  html:not(.suas-men) body.template--product .suas-pdp-life,
  html:not(.suas-men) body.template--product .suas-pdp-diagram,
  html:not(.suas-men) body.template--product .suas-pdp-ticket {
    border-radius: 3px !important;
    background: #fffef8 !important;
  }
  html:not(.suas-men) .suas-catalog-head-bar b,
  html:not(.suas-men) .suas-window-title {
    font-family: Tahoma, 'Segoe UI', Arial, sans-serif !important;
    font-size: 12px !important;
    font-weight: 700 !important;
    letter-spacing: .08em !important;
    text-transform: uppercase !important;
  }
  html:not(.suas-men) .suas-catalog-head-bar em {
    border-radius: 3px !important;
    background: #d9ff78 !important;
  }

  @media only screen and (max-width: 1023px) {
    html:not(.suas-men) body .suas-mobile-bar {
      background: #f4efe3 !important;
      border-bottom: 2px solid #101010 !important;
    }
    html:not(.suas-men) body .suas-mobile-bar .suas-side-head {
      margin: 0 !important;
      padding: 0 8px 0 0 !important;
      border: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
    }
    html:not(.suas-men) body .suas-mobile-bar .suas-side-brand {
      color: #101010 !important;
      text-shadow: none !important;
    }
    html:not(.suas-men) body .suas-panel-toggle {
      border-radius: 3px !important;
      background: #d9ff78 !important;
    }
  }
</style>

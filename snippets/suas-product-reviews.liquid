{%- liquid
  assign jm_count = product.metafields.reviews.rating_count | default: 0 | plus: 0
  assign jm_rating = 0
  if product.metafields.reviews.rating.value != blank
    assign jm_rating = product.metafields.reviews.rating.value.rating | default: 0 | plus: 0
  endif
-%}

<section class="suas-product-review-station" id="suas-product-review-station" aria-label="Review {{ product.title | escape }}">
  <style>
    .suas-product-review-station{--ink:#101010;--paper:#fbfaf7;--pink:#ffd8e8;--blue:#cdeeff;--lime:#d9ff78;--yellow:#fff1a8;width:min(1040px,calc(100vw - 24px));margin:34px auto 44px;font-family:Futura,'Futura PT',Arial,sans-serif;color:var(--ink)}
    .suas-product-review-station *{box-sizing:border-box}
    .suas-pr-window{border:2px solid var(--ink);border-radius:26px;background:rgba(255,255,255,.96);box-shadow:7px 8px 0 var(--ink);overflow:hidden}
    .suas-pr-bar{display:flex;align-items:center;gap:7px;min-height:38px;padding:8px 13px;border-bottom:2px solid var(--ink);background:linear-gradient(180deg,#fff,#edf0f5)}
    .suas-pr-dot{width:10px;height:10px;border-radius:999px;background:var(--dot);flex:0 0 auto}
    .suas-pr-title{margin-left:auto;padding:6px 10px;border:1.5px solid var(--ink);border-radius:999px;background:var(--yellow);box-shadow:0 2px 0 var(--ink);font:900 8px/1 Futura,Arial,sans-serif;letter-spacing:.13em;text-transform:uppercase;color:var(--ink)}
    .suas-pr-body{padding:clamp(14px,2.6vw,26px);background:linear-gradient(rgba(16,16,16,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.025) 1px,transparent 1px),linear-gradient(135deg,rgba(255,216,232,.35),rgba(217,255,120,.16));background-size:18px 18px,18px 18px,auto}
    .suas-pr-hero{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:16px;align-items:center;margin-bottom:18px;padding:clamp(14px,2vw,20px);border:2px solid var(--ink);border-radius:24px;background:var(--pink);box-shadow:4px 5px 0 var(--ink)}
    .suas-pr-hero h3{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:clamp(2.2rem,5vw,4rem);font-weight:400!important;line-height:.86;text-transform:lowercase;color:var(--ink)}
    .suas-pr-hero p{margin:8px 0 0;font-size:12px;font-weight:900;letter-spacing:.07em;text-transform:uppercase;color:var(--ink)}
    .suas-pr-score{display:grid;place-items:center;min-width:116px;min-height:94px;border:2px solid var(--ink);border-radius:22px;background:var(--lime);box-shadow:3px 4px 0 var(--ink);text-align:center}
    .suas-pr-score strong{font-size:2rem;line-height:1;font-weight:900;color:var(--ink)}
    .suas-pr-score span{font-size:9px;font-weight:900;letter-spacing:.1em;text-transform:uppercase;color:var(--ink)}
    .suas-pr-actions{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 18px}
    .suas-pr-button{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:10px 16px;border:2px solid var(--ink);border-radius:999px;background:var(--yellow);box-shadow:0 4px 0 var(--ink);color:var(--ink);font-size:10px;font-weight:900;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;cursor:pointer;transition:transform 160ms ease,box-shadow 160ms ease}
    .suas-pr-button:hover{color:var(--ink);transform:translateY(2px);box-shadow:0 2px 0 var(--ink)}
    .suas-pr-widget{border:2px solid var(--ink);border-radius:24px;background:rgba(255,255,255,.86);box-shadow:4px 5px 0 var(--ink);padding:clamp(12px,2vw,18px);overflow:hidden}
    .suas-pr-widget .jdgm-rev-widg{border:0!important;margin:0!important;padding:0!important;background:transparent!important;color:var(--ink)!important}
    .suas-pr-widget :is(.jdgm-rev-widg__title,.jdgm-rev__title,.jdgm-rev__author){font-family:Futura,'Futura PT',Arial,sans-serif!important;font-weight:900!important;letter-spacing:.06em!important;text-transform:uppercase!important;color:var(--ink)!important}
    .suas-pr-widget :is(.jdgm-rev,.jdgm-form-wrapper){border:2px solid var(--ink)!important;border-radius:22px!important;background:var(--yellow)!important;box-shadow:4px 5px 0 var(--ink)!important;color:var(--ink)!important;padding:16px!important}
    .suas-pr-widget :is(.jdgm-star,.jdgm-star:before){color:var(--ink)!important}
    .suas-pr-widget :is(button,.jdgm-btn,.jdgm-write-rev-link,input[type='submit']){min-height:40px!important;border:2px solid var(--ink)!important;border-radius:999px!important;background:var(--pink)!important;color:var(--ink)!important;box-shadow:0 4px 0 var(--ink)!important;font-family:Futura,'Futura PT',Arial,sans-serif!important;font-weight:900!important;letter-spacing:.08em!important;text-transform:uppercase!important;text-decoration:none!important}
    .suas-pr-widget :is(input,textarea,select){border:1.5px solid var(--ink)!important;border-radius:14px!important;background:#fff!important;color:var(--ink)!important;font-family:Futura,'Futura PT',Arial,sans-serif!important;font-weight:800!important}
    .suas-pr-loading{display:grid;place-items:center;min-height:110px;border:1.5px dashed rgba(16,16,16,.28);border-radius:18px;background:rgba(255,255,255,.72);font-size:10px;font-weight:900;letter-spacing:.14em;text-transform:uppercase;color:rgba(16,16,16,.58)}
    .suas-pr-widget:has(.jdgm-rev-widg__reviews,.jdgm-form-wrapper,.jdgm-write-rev-link) .suas-pr-loading{display:none}
    @media(max-width:650px){.suas-product-review-station{width:calc(100vw - 14px);margin:24px auto 34px}.suas-pr-window{border-radius:19px;box-shadow:4px 5px 0 var(--ink)}.suas-pr-hero{grid-template-columns:1fr;border-radius:18px}.suas-pr-score{width:100%;min-height:76px}.suas-pr-button{width:100%}.suas-pr-widget{border-radius:18px;box-shadow:3px 4px 0 var(--ink)}}
  </style>

  <div class="suas-pr-window">
    <div class="suas-pr-bar">
      <span class="suas-pr-dot" style="--dot:#ff5f57"></span>
      <span class="suas-pr-dot" style="--dot:#febc2e"></span>
      <span class="suas-pr-dot" style="--dot:#28c840"></span>
      <span class="suas-pr-title">product review terminal</span>
    </div>
    <div class="suas-pr-body">
      <div class="suas-pr-hero">
        <div>
          <h3>review {{ product.title }}</h3>
          <p>Tell us how it smelled, burned, wore, gifted, or surprised you.</p>
        </div>
        <div class="suas-pr-score" aria-label="{{ jm_rating | round: 1 }} out of 5 stars from {{ jm_count }} reviews">
          <strong>{{ jm_rating | round: 1 }}</strong>
          <span>{{ jm_count }} reviews</span>
        </div>
      </div>
      <div class="suas-pr-actions">
        <button class="suas-pr-button" type="button" data-suas-open-review>write a review</button>
        <a class="suas-pr-button" href="/pages/reviews">see all reviews</a>
      </div>
      <div class="suas-pr-widget" data-suas-product-review-widget>
        <div class="suas-pr-loading">review form loading</div>
        <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-product-title="{{ product.title | escape }}" data-id="{{ product.id }}" data-product-id="{{ product.id }}"></div>
      </div>
    </div>
  </div>

  <script>
    (() => {
      const section = document.currentScript.closest('.suas-product-review-station');
      if (!section || section.dataset.suasReviewReady === 'true') return;
      section.dataset.suasReviewReady = 'true';
      const openButton = section.querySelector('[data-suas-open-review]');
      const widget = section.querySelector('[data-suas-product-review-widget]');
      openButton && openButton.addEventListener('click', () => {
        widget && widget.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => {
          const judgeButton = section.querySelector('.jdgm-write-rev-link,.jdgm-btn[class*="write"],button[class*="write"],a[class*="write"]');
          if (judgeButton) judgeButton.click();
        }, 450);
      });
    })();
  </script>
</section>

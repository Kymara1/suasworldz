{% liquid
  assign desc_text = product.description | strip_html
  assign desc_down = desc_text | downcase
  assign product_title_down = product.title | downcase
  assign pdp_type = product.type | downcase
  assign pdp_home = false
  if pdp_type contains 'candle' or pdp_type contains 'mist' or pdp_type contains 'home' or product_title_down contains 'candle' or product_title_down contains 'mist'
    assign pdp_home = true
  endif
  assign ingredients_html = ''
  if product.description contains 'Ingredients'
    assign ingredients_html = product.description | split: 'Ingredients' | last
  elsif product.description contains 'ingredients'
    assign ingredients_html = product.description | split: 'ingredients' | last
  endif
%}

<style>
  html body.template--product .suas-product-experience{width:min(1280px,100%);margin:18px auto 0;color:#101010;font-family:Futura,'Futura PT',Arial,sans-serif}
  html body.template--product .suas-product-experience *{box-sizing:border-box}
  html body.template--product .shopify-section:has([class*='aftership'])::before,html body.template--product .shopify-section:has([class*='automizely'])::before{content:none!important;display:none!important}
  html body.template--product .product-options--container{margin-top:14px!important}
  html body.template--product .radios--container{display:flex!important;flex-wrap:wrap!important;gap:10px!important;align-items:center!important}
  html body.template--product .radios--input{position:absolute!important;inline-size:1px!important;block-size:1px!important;opacity:0!important;pointer-events:none!important}
  html body.template--product .radios--main{position:relative!important;background:transparent!important;border:0!important;box-shadow:none!important;padding:0!important;margin:0!important}
  html body.template--product .radios--value-button{inline-size:42px!important;block-size:42px!important;min-inline-size:42px!important;display:inline-flex!important;align-items:center!important;justify-content:center!important;padding:0!important;border:2px solid #101010!important;border-radius:999px!important;background:#fff!important;color:#101010!important;box-shadow:0 3px 0 #101010!important;font-size:0!important;cursor:pointer!important;overflow:hidden!important}
  html body.template--product .radios--value-button:nth-child(1){background:#ffd8e8!important}
  html body.template--product .radios--value-button:nth-child(2){background:#cdeeff!important}
  html body.template--product .radios--value-button:nth-child(3){background:#d9ff78!important}
  html body.template--product .radios--value-button:nth-child(4){background:#fff1a8!important}
  html body.template--product .radios--value-button:nth-child(5){background:#e4d5ff!important}
  html body.template--product .radios--value-button:nth-child(6){background:#ff9bc4!important}
  html body.template--product .radios--input:checked+.radios--value-button{box-shadow:0 0 0 3px #101010,0 4px 0 #101010!important}
  html body.template--product .product-page--price{margin:8px 0 4px!important;font-size:1.35rem!important;font-weight:900!important}
  .suas-pdp-fold{border:2px solid #101010;border-radius:22px;box-shadow:5px 6px 0 #101010;margin:0 0 12px;overflow:hidden}
  .suas-pdp-fold+.suas-pdp-fold{margin-top:10px}
  .suas-pdp-fold summary{list-style:none;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 18px;cursor:pointer;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(1.8rem,4vw,2.6rem);line-height:.85;text-transform:lowercase}
  .suas-pdp-fold summary::-webkit-details-marker{display:none}
  .suas-pdp-fold summary:after{content:'+';font-family:Futura,Arial,sans-serif;font-size:1.8rem;font-weight:900;line-height:1}
  .suas-pdp-fold[open] summary:after{content:'–'}
  .suas-pdp-fold-body{padding:4px 18px 20px;display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:18px;align-items:center;font-size:15px;line-height:1.5;font-weight:700}
  .suas-pdp-fold-body p{margin:0 0 10px}
  .suas-pdp-ing{display:grid;gap:14px}
  .suas-pdp-ing b{display:block;font-size:1.05rem;margin:0 0 2px}
  .suas-pdp-ing span{display:block;font-size:13px;font-weight:700}
  @media(max-width:820px){
    .suas-pdp-fold-body{grid-template-columns:1fr;padding:0 14px 16px}
    .suas-pdp-fold summary{font-size:clamp(1.5rem,8vw,2rem);padding:14px}
    html body.template--product .radios--value-button{inline-size:38px!important;block-size:38px!important;min-inline-size:38px!important}
  }
</style>

<section class="suas-product-experience" id="suas-pdp-details" aria-label="SUAS product details">
  <details class="suas-pdp-fold">
    <summary>details</summary>
    <div class="suas-pdp-fold-body">
      <div>
        {% if product.description != blank %}
          <div class="rte">{{ product.description }}</div>
        {% else %}
          <p>{{ product.title }} is mixed for the SUAS world: handmade, playful, and made to layer into your daily ritual.</p>
        {% endif %}
      </div>
      <div>
        <p><strong>soothes. moisturizes. layers.</strong></p>
        <p>{% if pdp_home %}Room-filling scent for the house, the car, the after-hours. Same world as the body jars.{% else %}Cushiony handmade formula for skin that wants to smell like something, not like a lecture.{% endif %}</p>
      </div>
    </div>
  </details>

  <details class="suas-pdp-fold">
    <summary>how it works</summary>
    <div class="suas-pdp-fold-body">
      <div>
        {% if pdp_home %}
          <p>Light it, mist it, or warm it. Give the room a minute. The scent is built to bloom, then sit pretty.</p>
        {% else %}
          <p>Warm a little in your hands. Press it into still-damp skin. Let it melt. That’s the whole spell.</p>
        {% endif %}
      </div>
      <div>
        <p><strong>{% if product_title_down contains 'butter' %}thick + creamy{% elsif product_title_down contains 'oil' %}glossy oil{% elsif product_title_down contains 'mist' %}air-light mist{% else %}small-batch finish{% endif %}</strong></p>
        <p>best for {% if product_title_down contains 'butter' %}after shower glow{% elsif product_title_down contains 'oil' %}body layering{% elsif product_title_down contains 'candle' %}room mood{% else %}daily ritual{% endif %}.</p>
      </div>
    </div>
  </details>

  <details class="suas-pdp-fold">
    <summary>ingredients</summary>
    <div class="suas-pdp-fold-body">
      <div aria-hidden="true" style="min-height:160px;border:2px solid #101010;border-radius:28px;background:linear-gradient(180deg,#fff,#ffd8e8 70%);"></div>
      <div class="suas-pdp-ing">
        {% if ingredients_html != blank %}
          <div class="rte">{{ ingredients_html }}</div>
        {% else %}
          <p><b>shea butter</b><span>cushions dry skin.</span></p>
          <p><b>cocoa butter</b><span>softens and seals.</span></p>
          <p><b>scent mix</b><span>the notes on this jar, handmade in small batches.</span></p>
        {% endif %}
      </div>
    </div>
  </details>
</section>

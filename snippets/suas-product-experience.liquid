{% liquid
  assign desc_text = product.description | strip_html
  assign desc_down = desc_text | downcase
  assign scent_body_down = desc_down | split: 'ingredients' | first | split: 'ingredient' | first | split: 'directions' | first
  assign profile_down = ''
  if scent_body_down contains 'scent profile:'
    assign profile_down = scent_body_down | split: 'scent profile:' | last | split: 'ingredients' | first | split: 'ingredient' | first | split: 'directions' | first
  elsif scent_body_down contains 'scent profile'
    assign profile_down = scent_body_down | split: 'scent profile' | last | split: 'ingredients' | first | split: 'ingredient' | first | split: 'directions' | first
  endif
  assign scent_down = profile_down | append: ' ' | append: scent_body_down
  assign product_title_down = product.title | downcase
  assign note_count = 0
  assign custom_note_count = 0
%}

<style>
  html body.template--product .suas-product-experience{--ink:#101010;--pink:#ffd8e8;--blue:#cdeeff;--lime:#d9ff78;width:100%;margin:22px 0 0;color:var(--ink);font-family:Futura,'Futura PT',Arial,sans-serif}
  html body.template--product .suas-product-experience *{box-sizing:border-box}
  html body.template--product .shopify-section:has([class*='aftership'])::before,html body.template--product .shopify-section:has([class*='automizely'])::before,html body.template--product .shopify-section:has([class*='asrv'])::before,html body.template--product .shopify-section:has([id*='aftership'])::before,html body.template--product .shopify-section:has([id*='automizely'])::before{content:none!important;display:none!important}
  html body.template--product .product-options--container{margin-top:18px!important}
  html body.template--product .radios--container{display:flex!important;flex-wrap:wrap!important;gap:10px!important;align-items:center!important}
  html body.template--product .radios--input{position:absolute!important;inline-size:1px!important;block-size:1px!important;opacity:0!important;pointer-events:none!important}
  html body.template--product .radios--main{position:relative!important;inline-size:auto!important;block-size:auto!important;background:transparent!important;border:0!important;box-shadow:none!important;padding:0!important;margin:0!important}
  html body.template--product .radios--value-button{inline-size:64px!important;block-size:64px!important;min-inline-size:64px!important;display:inline-flex!important;align-items:center!important;justify-content:center!important;padding:6px!important;border:2px solid #101010!important;border-radius:999px!important;background:#101010!important;color:#fff!important;box-shadow:none!important;font-family:Futura,'Futura PT',Arial,sans-serif!important;font-size:11px!important;font-weight:900!important;line-height:1!important;letter-spacing:.02em!important;text-align:center!important;text-transform:none!important;cursor:pointer!important;overflow:hidden!important;transition:transform .16s ease,box-shadow .16s ease!important}
  html body.template--product .radios--value-button div{display:flex!important;align-items:center!important;justify-content:center!important;width:100%!important;height:100%!important;margin:0!important;padding:0!important;color:#fff!important;text-align:center!important;line-height:1!important;white-space:nowrap!important;overflow:hidden!important;text-transform:none!important}
  html body.template--product .radios--value-button:hover{transform:translateY(-1px)!important;box-shadow:0 3px 0 #ff9bc4!important}
  html body.template--product .radios--input:checked+.radios--value-button,html body.template--product .radios--value-button[aria-checked='true']{background:#101010!important;color:#fff!important;box-shadow:0 4px 0 #ff9bc4!important}
  html body.template--product .radios--input:focus-visible+.radios--value-button{outline:3px solid #c6f76a!important;outline-offset:3px!important}
  .suas-kicker{margin:0 0 10px;font-size:10px;font-weight:900;letter-spacing:.2em;text-transform:uppercase}
  .suas-product-vibe-card,.suas-note-collection,.suas-product-lane-grid article{border:0;background:transparent;box-shadow:none}
  .suas-product-vibe-card{border-radius:0;overflow:visible;background:transparent;padding-top:28px;border-top:1px solid rgba(16,16,16,.12)}
  .suas-window-strip{display:none}
  .suas-window-strip span{width:12px;height:12px;border-radius:999px;background:#ff6257}.suas-window-strip span:nth-child(2){background:#ffbd2e}.suas-window-strip span:nth-child(3){background:#28c840}.suas-window-strip b{margin-left:auto;font-size:9px;font-weight:900;letter-spacing:.16em;text-transform:uppercase}
  .suas-product-vibe-copy{padding:clamp(18px,3vw,30px)}.suas-product-description{max-width:none;max-height:none;overflow:visible}.suas-product-description,.suas-product-description *{font-size:15px!important;line-height:1.58!important;color:var(--ink)!important}.suas-product-description p{margin:0 0 12px!important}.suas-product-description strong{font-weight:900!important}
  .suas-note-collection{margin-top:28px;border-radius:0;padding:0;background:transparent;overflow:visible}
  .suas-note-collection .suas-os-winbar{border-radius:0}
  .suas-note-head{text-align:center;margin:0 0 16px;padding:18px clamp(16px,3vw,30px) 0}.suas-note-head h2{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:clamp(2.4rem,5.6vw,5rem);font-weight:700;line-height:.84;text-transform:uppercase}.suas-note-head p{margin:8px auto 0;max-width:620px;font-size:12px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}
  .suas-note-grid{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:clamp(8px,1.6vw,18px)!important;align-items:stretch!important;padding:0 clamp(16px,3vw,30px) clamp(16px,3vw,30px)}
  .suas-note-card{position:relative;min-height:clamp(200px,26vw,320px);border:0;border-radius:18px;overflow:hidden;background:#111;box-shadow:none;display:flex;align-items:end;justify-content:center;padding:14px;isolation:isolate}
  .suas-note-card:before{content:'';position:absolute;inset:0;background-image:var(--note-img);background-size:cover;background-position:center;filter:saturate(1.08) contrast(1.04);z-index:-3}.suas-note-card:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.03) 0%,rgba(0,0,0,.12) 45%,rgba(0,0,0,.72) 100%);z-index:-1}
  .suas-note-card span{position:relative;z-index:3;display:inline-flex;align-items:center;justify-content:center;max-width:96%;min-height:32px;padding:8px 12px;border:1.5px solid rgba(255,255,255,.82);border-radius:999px;background:rgba(16,16,16,.5);backdrop-filter:blur(8px);color:#fff;text-shadow:0 2px 10px rgba(0,0,0,.45);font-size:12px;font-weight:900;letter-spacing:.06em;text-transform:lowercase;text-align:center}
  .note-coconut{--note-img:url('https://images.unsplash.com/photo-1580984969071-a8da5656c2fb?auto=format&fit=crop&w=1200&q=80')}.note-jasmine{--note-img:url('https://images.unsplash.com/photo-1562690868-60bbe7293e94?auto=format&fit=crop&w=1200&q=80')}.note-musk{--note-img:url('https://images.unsplash.com/photo-1615529162924-f8605388461d?auto=format&fit=crop&w=1200&q=80')}.note-ocean{--note-img:url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1200&q=80')}.note-vanilla{--note-img:url('https://images.unsplash.com/photo-1608797178974-15b35a64ede9?auto=format&fit=crop&w=1200&q=80')}.note-amber{--note-img:url('https://images.unsplash.com/photo-1615485290382-441e4d049cb5?auto=format&fit=crop&w=1200&q=80')}.note-lavender{--note-img:url('https://images.unsplash.com/photo-1499002238440-d264edd596ec?auto=format&fit=crop&w=1200&q=80')}.note-mandarin,.note-orange,.note-lemon,.note-citrus{--note-img:url('https://images.unsplash.com/photo-1582979512210-99b6a53386f9?auto=format&fit=crop&w=1200&q=80')}.note-peach{--note-img:url('https://images.unsplash.com/photo-1629828874514-d76c161c0077?auto=format&fit=crop&w=1200&q=80')}.note-plum{--note-img:url('https://images.unsplash.com/photo-1601493700631-2b16ec4b4716?auto=format&fit=crop&w=1200&q=80')}.note-strawberry{--note-img:url('https://images.unsplash.com/photo-1464965911861-746a04b4bca6?auto=format&fit=crop&w=1200&q=80')}.note-rose{--note-img:url('https://images.unsplash.com/photo-1518895949257-7621c3c786d7?auto=format&fit=crop&w=1200&q=80')}.note-wood{--note-img:url('https://images.unsplash.com/photo-1513836279014-a89f7a76ae86?auto=format&fit=crop&w=1200&q=80')}.note-mint{--note-img:url('https://images.unsplash.com/photo-1628556270448-4d4e4148e1b1?auto=format&fit=crop&w=1200&q=80')}.note-coffee{--note-img:url('https://images.unsplash.com/photo-1442512595331-e89e73853f31?auto=format&fit=crop&w=1200&q=80')}.note-caramel,.note-sugar{--note-img:url('https://images.unsplash.com/photo-1582176604856-e824b4736522?auto=format&fit=crop&w=1200&q=80')}.note-tea{--note-img:url('https://images.unsplash.com/photo-1544787219-7f47ccb76574?auto=format&fit=crop&w=1200&q=80')}.note-clean{--note-img:url('https://images.unsplash.com/photo-1618220179428-22790b461013?auto=format&fit=crop&w=1200&q=80')}.note-warm,.note-sunshine{--note-img:url('https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=1200&q=80')}.note-soft{--note-img:url('https://images.unsplash.com/photo-1515377905703-c4788e51af15?auto=format&fit=crop&w=1200&q=80')}.note-floral,.note-wildflower,.note-petals{--note-img:url('https://images.unsplash.com/photo-1490750967868-88aa4486c946?auto=format&fit=crop&w=1200&q=80')}.note-gourmand{--note-img:url('https://images.unsplash.com/photo-1606313564200-e75d5e30476c?auto=format&fit=crop&w=1200&q=80')}.note-signature{--note-img:url('https://images.unsplash.com/photo-1615634260167-c8cdede054de?auto=format&fit=crop&w=1200&q=80')}
  .suas-product-lane-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:24px}.suas-product-lane-grid article{border-radius:22px;padding:18px;background:linear-gradient(135deg,#fff,var(--blue))}.suas-product-lane-grid article:nth-child(2){background:linear-gradient(135deg,#fff,var(--pink))}.suas-product-lane-grid small{display:block;margin-bottom:7px;font-size:9px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.suas-product-lane-grid strong{font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(1.6rem,3vw,2.35rem);font-weight:700;line-height:.9;text-transform:lowercase}
  @media(max-width:820px){html body.template--product .suas-product-experience{width:100%;margin-top:14px}.suas-note-collection{padding:0;border-radius:22px}.suas-note-grid{grid-template-columns:1fr!important;gap:12px!important}.suas-note-card{min-height:180px;border-radius:17px;box-shadow:3px 4px 0 var(--ink);padding:8px}.suas-note-card span{font-size:12px;letter-spacing:.02em;min-height:28px;padding:6px 8px}.suas-product-lane-grid{grid-template-columns:1fr}.suas-window-strip b{font-size:8px}.suas-product-description,.suas-product-description *{font-size:13px!important}.suas-note-head h2{font-size:clamp(2rem,10vw,3rem)}html body.template--product .radios--value-button{inline-size:58px!important;block-size:58px!important;min-inline-size:58px!important;font-size:10px!important}}
</style>

<section class="suas-product-experience" aria-label="SUAS product details">
  <div class="suas-product-vibe-card">
    <div class="suas-product-vibe-copy">
      <p class="suas-kicker">what it smells like</p>
      {% if product.description != blank %}
        <div class="suas-product-description rte">{{ product.description }}</div>
      {% else %}
        <p>{{ product.title }} is mixed for the SUAS world: handmade, playful, and made to layer into your daily routine.</p>
      {% endif %}
    </div>
  </div>

  <div class="suas-note-collection" id="scent-notes">
    <div class="suas-note-head">
      <h2>tap a note.</h2>
      <p>the mix on this jar — same language as the rest of suas.os</p>
    </div>
    <div class="suas-note-grid">
      {% if note_blocks != blank %}
        {% for block in note_blocks %}
          {% if block.type == 'scent-note-image' and block.settings.note_image != blank %}
            {% liquid
              assign block_product_handle = block.settings.product.handle | default: block.settings.product_handle | handle
              assign current_product_handle = product.handle | handle
            %}
            {% if block_product_handle == blank or block_product_handle == current_product_handle %}
              {% assign custom_note_count = custom_note_count | plus: 1 %}
              <article class="suas-note-card suas-note-card--custom" style="--note-img:url('{{ block.settings.note_image | image_url: width: 1400 }}')" {{ block.shopify_attributes }}>
                <span>{{ block.settings.note_label | default: 'scent note' }}</span>
              </article>
            {% endif %}
          {% endif %}
        {% endfor %}
      {% endif %}

      {% if custom_note_count == 0 %}
        {% if scent_down contains 'wildflower bouquet' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-wildflower"><span>wildflower bouquet</span></article>{% endif %}
        {% if scent_down contains 'fresh petals' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-petals"><span>fresh petals</span></article>{% endif %}
        {% if scent_down contains 'soft sunshine' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-sunshine"><span>soft sunshine</span></article>{% endif %}
        {% if scent_down contains 'coconut' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-coconut"><span>creamy coconut</span></article>{% endif %}
        {% if scent_down contains 'jasmine' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-jasmine"><span>jasmine blossom</span></article>{% endif %}
        {% if scent_down contains 'musk' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-musk"><span>soft white musk</span></article>{% endif %}
        {% if scent_down contains 'ocean' or scent_down contains 'salty air' or scent_down contains 'sea' or scent_down contains 'marine' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-ocean"><span>fresh ocean breeze</span></article>{% endif %}
        {% if scent_down contains 'vanilla' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-vanilla"><span>vanilla</span></article>{% endif %}
        {% if scent_down contains 'amber' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-amber"><span>amber</span></article>{% endif %}
        {% if scent_down contains 'lavender' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-lavender"><span>lavender</span></article>{% endif %}
        {% if scent_down contains 'mandarin' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-mandarin"><span>mandarin</span></article>{% endif %}
        {% if scent_down contains 'orange' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-orange"><span>orange</span></article>{% endif %}
        {% if scent_down contains 'lemon' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-lemon"><span>lemon</span></article>{% endif %}
        {% if scent_down contains 'citrus' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-citrus"><span>citrus</span></article>{% endif %}
        {% if scent_down contains 'peach' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-peach"><span>peach</span></article>{% endif %}
        {% if scent_down contains 'plum' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-plum"><span>plum</span></article>{% endif %}
        {% if scent_down contains 'strawberry' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-strawberry"><span>strawberry</span></article>{% endif %}
        {% if scent_down contains 'rose' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-rose"><span>rose</span></article>{% endif %}
        {% if scent_down contains 'sandalwood' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-wood"><span>sandalwood</span></article>{% endif %}
        {% if scent_down contains 'cedar' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-wood"><span>cedarwood</span></article>{% endif %}
        {% if scent_down contains 'mint' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-mint"><span>mint</span></article>{% endif %}
        {% if scent_down contains 'coffee' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-coffee"><span>coffee</span></article>{% endif %}
        {% if scent_down contains 'caramel' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-caramel"><span>caramel</span></article>{% endif %}
        {% if scent_down contains 'sugar' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-sugar"><span>sugar</span></article>{% endif %}
        {% if scent_down contains 'tea' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-tea"><span>tea</span></article>{% endif %}
        {% if note_count < 3 and scent_down contains 'clean' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-clean"><span>clean skin</span></article>{% endif %}
        {% if note_count < 3 and scent_down contains 'warm' or note_count < 3 and scent_down contains 'skin' or note_count < 3 and scent_down contains 'sunscreen' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-warm"><span>warm skin</span></article>{% endif %}
        {% if note_count < 3 and scent_down contains 'soft' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-soft"><span>soft finish</span></article>{% endif %}
        {% if note_count < 3 and scent_down contains 'floral' or note_count < 3 and scent_down contains 'flower' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-floral"><span>soft florals</span></article>{% endif %}
        {% if note_count < 3 and scent_down contains 'sweet' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-gourmand"><span>soft sweetness</span></article>{% endif %}
        {% if note_count < 3 %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-signature"><span>signature blend</span></article>{% endif %}
        {% if note_count < 3 %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-soft"><span>wearable softness</span></article>{% endif %}
        {% if note_count < 3 %}<article class="suas-note-card note-clean"><span>finished formula</span></article>{% endif %}
      {% endif %}
    </div>
  </div>

  <div class="suas-product-lane-grid">
    <article><small>texture</small><strong>{% if product_title_down contains 'butter' or desc_down contains 'butter' %}thick + creamy{% elsif product_title_down contains 'oil' %}glossy oil{% elsif product_title_down contains 'mist' %}air-light mist{% else %}small-batch finish{% endif %}</strong></article>
    <article><small>best for</small><strong>{% if product_title_down contains 'butter' %}after shower glow{% elsif product_title_down contains 'oil' %}body layering{% elsif product_title_down contains 'candle' %}room mood{% else %}daily ritual{% endif %}</strong></article>
  </div>
</section>
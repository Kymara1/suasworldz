{% liquid
  assign desc_text = product.description | strip_html
  assign desc_down = desc_text | downcase
  assign product_title_down = product.title | downcase
  assign has_notes = false
%}

<style>
  html body.template--product .suas-product-experience{--ink:#101010;--pink:#ffd8e8;--blue:#cdeeff;--lime:#d9ff78;--cream:#fbf4ec;width:min(1120px,calc(100vw - 34px));margin:clamp(24px,4vw,50px) auto 0;color:var(--ink);font-family:Futura,'Futura PT',Arial,sans-serif}
  html body.template--product .suas-product-experience *{box-sizing:border-box}.suas-product-experience .suas-kicker{margin:0 0 10px;font-size:10px;font-weight:900;letter-spacing:.2em;text-transform:uppercase}.suas-product-vibe-card,.suas-note-collection,.suas-product-lane-grid article{border:2px solid var(--ink);background:#fff;box-shadow:7px 8px 0 var(--ink)}.suas-product-vibe-card{border-radius:28px;overflow:hidden;background:linear-gradient(rgba(16,16,16,.026) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.026) 1px,transparent 1px),radial-gradient(circle at 12% 18%,rgba(255,216,232,.84),transparent 30%),radial-gradient(circle at 92% 78%,rgba(217,255,120,.44),transparent 30%),#fff;background-size:18px 18px,18px 18px,auto,auto,auto}.suas-window-strip{height:38px;display:flex;align-items:center;gap:8px;padding:0 16px;border-bottom:2px solid var(--ink);background:linear-gradient(#f6f7f9,#e9edf2)}.suas-window-strip span{width:12px;height:12px;border-radius:999px;background:#ff6257}.suas-window-strip span:nth-child(2){background:#ffbd2e}.suas-window-strip span:nth-child(3){background:#28c840}.suas-window-strip b{margin-left:auto;font-size:9px;font-weight:900;letter-spacing:.16em;text-transform:uppercase}.suas-product-vibe-copy{padding:clamp(18px,3vw,30px)}.suas-product-description{max-width:880px}.suas-product-description,.suas-product-description *{font-size:14px!important;line-height:1.55!important;color:var(--ink)!important}.suas-product-description p{margin:0 0 12px!important}.suas-product-description strong{font-weight:900!important}
  .suas-note-collection{margin-top:clamp(24px,4vw,44px);border-radius:30px;padding:clamp(18px,3vw,30px);background:linear-gradient(rgba(16,16,16,.024) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.024) 1px,transparent 1px),#e9ded3;background-size:20px 20px,20px 20px,auto;overflow:hidden}.suas-note-head{text-align:center;margin-bottom:20px}.suas-note-head h2{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:clamp(3rem,6.3vw,6rem);font-weight:700;line-height:.84;text-transform:uppercase}.suas-note-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.suas-note-card{position:relative;min-height:330px;border:2px solid var(--ink);border-radius:24px;overflow:hidden;background:#fff;box-shadow:5px 6px 0 var(--ink);display:flex;align-items:end;justify-content:center;padding:18px;isolation:isolate}.suas-note-card:before{content:'';position:absolute;inset:0;background:var(--note-photo);filter:saturate(1.08) contrast(1.05);z-index:-3}.suas-note-card:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.04) 0%,rgba(0,0,0,.06) 44%,rgba(0,0,0,.6) 100%);z-index:-1}.suas-note-photo{position:absolute;inset:12px;border-radius:20px;overflow:hidden;z-index:-2;box-shadow:inset 0 0 0 1px rgba(255,255,255,.35),inset 0 -80px 80px rgba(0,0,0,.18)}.suas-note-photo:before,.suas-note-photo:after{content:'';position:absolute;display:block}.suas-note-card span{position:relative;z-index:3;display:inline-flex;align-items:center;justify-content:center;max-width:92%;min-height:34px;padding:9px 15px 8px;border:1.5px solid rgba(255,255,255,.8);border-radius:999px;background:rgba(16,16,16,.42);backdrop-filter:blur(8px);color:#fff;text-shadow:0 2px 10px rgba(0,0,0,.45);font-size:13px;font-weight:900;letter-spacing:.08em;text-transform:lowercase;text-align:center}
  .note-coconut{--note-photo:radial-gradient(circle at 66% 26%,rgba(255,255,255,.9) 0 8%,transparent 20%),radial-gradient(circle at 42% 46%,#fff7eb 0 18%,#7a4725 19% 34%,transparent 35%),radial-gradient(circle at 62% 60%,#fff1de 0 16%,#5b321b 17% 32%,transparent 33%),linear-gradient(135deg,#3b2116,#b88756 52%,#f2d7b1)}.note-coconut .suas-note-photo:before{left:18%;top:18%;width:68%;height:54%;border-radius:50%;background:radial-gradient(circle at 40% 45%,#fff7eb 0 25%,#6a3b20 26% 42%,transparent 43%),radial-gradient(circle at 64% 58%,#fff1df 0 23%,#4c2c1c 24% 40%,transparent 41%);filter:drop-shadow(0 18px 22px rgba(0,0,0,.35))}.note-jasmine{--note-photo:radial-gradient(circle at 72% 20%,rgba(255,255,255,.92),transparent 22%),linear-gradient(135deg,#254d2f,#76a85f 52%,#f7fff2)}.note-jasmine .suas-note-photo:before{left:18%;top:18%;width:64%;height:58%;background:radial-gradient(circle,#ffd963 0 5%,transparent 6%),radial-gradient(ellipse at 50% 4%,#fff 0 19%,transparent 20%),radial-gradient(ellipse at 96% 48%,#fff 0 20%,transparent 21%),radial-gradient(ellipse at 50% 96%,#fff 0 20%,transparent 21%),radial-gradient(ellipse at 4% 48%,#fff 0 20%,transparent 21%);filter:drop-shadow(0 18px 20px rgba(0,0,0,.32))}.note-jasmine .suas-note-photo:after{left:6%;bottom:18%;width:90%;height:26%;background:linear-gradient(125deg,transparent 0 18%,rgba(65,125,58,.9) 19% 24%,transparent 25%),linear-gradient(30deg,transparent 0 35%,rgba(125,170,91,.8) 36% 43%,transparent 44%)}.note-musk{--note-photo:radial-gradient(circle at 45% 42%,rgba(255,255,255,.96) 0 20%,transparent 42%),linear-gradient(135deg,#dfe8f3,#fffaf0 46%,#cdd7ea)}.note-musk .suas-note-photo:before{left:8%;right:8%;top:28%;height:38%;border-radius:999px;background:radial-gradient(circle at 18% 56%,#fff 0 23%,transparent 24%),radial-gradient(circle at 45% 32%,#fffdf8 0 31%,transparent 32%),radial-gradient(circle at 76% 56%,#f7f4ee 0 27%,transparent 28%);filter:blur(.2px) drop-shadow(0 18px 18px rgba(55,60,70,.22))}.note-ocean{--note-photo:linear-gradient(180deg,#dff8ff 0%,#96d9f1 34%,#1f76a8 67%,#0b3a55 100%)}.note-ocean .suas-note-photo:before{left:-10%;right:-10%;bottom:18%;height:44%;background:repeating-radial-gradient(ellipse at 20% 80%,transparent 0 22px,rgba(255,255,255,.82) 23px 28px,transparent 29px 48px);filter:blur(.6px)}.note-ocean .suas-note-photo:after{left:8%;top:15%;width:80%;height:36%;clip-path:polygon(0 65%,20% 35%,44% 60%,66% 24%,100% 58%,100% 100%,0 100%);background:linear-gradient(160deg,rgba(255,255,255,.88),rgba(255,255,255,.08))}.note-vanilla{--note-photo:radial-gradient(circle at 75% 22%,rgba(255,255,255,.85),transparent 20%),linear-gradient(135deg,#fff4cd,#b6814c 55%,#4c2d1e)}.note-vanilla .suas-note-photo:before,.note-vanilla .suas-note-photo:after{top:16%;width:34px;height:210px;border-radius:999px;background:linear-gradient(90deg,#2e1b13,#6d3e24 48%,#1e120d);box-shadow:inset 6px 0 10px rgba(255,255,255,.12),0 20px 22px rgba(0,0,0,.35)}.note-vanilla .suas-note-photo:before{left:35%;transform:rotate(24deg)}.note-vanilla .suas-note-photo:after{left:52%;transform:rotate(39deg)}.note-amber{--note-photo:radial-gradient(circle at 42% 34%,rgba(255,232,130,.95),transparent 18%),linear-gradient(135deg,#ffd06a,#a84a22 54%,#3f170c)}.note-amber .suas-note-photo:before{left:22%;top:17%;width:58%;height:52%;clip-path:polygon(16% 10%,68% 0,100% 35%,76% 100%,14% 82%,0 32%);background:linear-gradient(135deg,rgba(255,238,152,.95),rgba(161,55,20,.9));box-shadow:0 18px 24px rgba(0,0,0,.35)}.note-lavender{--note-photo:linear-gradient(135deg,#44306f,#7861c6 48%,#d8ccff)}.note-lavender .suas-note-photo:before{left:18%;top:12%;width:68%;height:70%;background:radial-gradient(circle,#c7adff 0 5px,transparent 6px) 0 0/18px 20px,linear-gradient(82deg,transparent 0 45%,rgba(50,84,45,.9) 46% 49%,transparent 50%);filter:drop-shadow(0 12px 14px rgba(0,0,0,.3))}.note-mandarin,.note-peach,.note-lemon,.note-strawberry{--note-photo:radial-gradient(circle at 70% 25%,rgba(255,255,255,.82),transparent 18%),linear-gradient(135deg,#fff0bd,#f57921 54%,#592414)}.note-mandarin .suas-note-photo:before,.note-peach .suas-note-photo:before,.note-lemon .suas-note-photo:before,.note-strawberry .suas-note-photo:before{left:19%;top:16%;width:62%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 35% 30%,rgba(255,255,255,.85) 0 13%,transparent 14%),radial-gradient(circle at 50% 50%,#ff982a 0 58%,#da641b 59%);box-shadow:0 18px 24px rgba(0,0,0,.3)}.note-lemon{--note-photo:linear-gradient(135deg,#fff6b8,#f0d938 54%,#827000)}.note-lemon .suas-note-photo:before{border-radius:55% 45% 52% 48%;background:radial-gradient(circle at 35% 30%,rgba(255,255,255,.88) 0 13%,transparent 14%),#ffe45c;transform:rotate(-18deg)}.note-peach{--note-photo:linear-gradient(135deg,#ffe1bf,#ff9a84 52%,#7a342d)}.note-peach .suas-note-photo:before{background:radial-gradient(circle at 35% 30%,rgba(255,255,255,.75) 0 13%,transparent 14%),#ffad75}.note-strawberry{--note-photo:linear-gradient(135deg,#ffd0dd,#e22956 52%,#5f1024)}.note-strawberry .suas-note-photo:before{border-radius:58% 42% 60% 40%/40% 42% 58% 60%;background:radial-gradient(circle at 35% 32%,rgba(255,255,255,.7) 0 13%,transparent 14%),#df2b4f}.note-plum{--note-photo:radial-gradient(circle at 70% 22%,rgba(255,255,255,.76),transparent 18%),linear-gradient(135deg,#efc7ff,#7a276f 54%,#2a1028)}.note-plum .suas-note-photo:before{left:20%;top:17%;width:62%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 34% 25%,#ffd3ef 0 14%,transparent 15%),#8b2a7f;box-shadow:0 18px 24px rgba(0,0,0,.34)}.note-rose{--note-photo:linear-gradient(135deg,#ffe0ec,#bd1c52 55%,#421222)}.note-rose .suas-note-photo:before{left:19%;top:15%;width:62%;aspect-ratio:1;border-radius:50%;background:conic-gradient(#ffb8cc,#b51647,#ff6d97,#ffd4df,#ff729a);box-shadow:0 18px 24px rgba(0,0,0,.34)}.note-wood{--note-photo:linear-gradient(135deg,#d3a46d,#70421e 52%,#241109)}.note-wood .suas-note-photo:before,.note-wood .suas-note-photo:after{top:12%;width:42px;height:230px;border-radius:18px;background:repeating-linear-gradient(105deg,#4a2814 0 10px,#c3915e 11px 18px,#6f421f 19px 29px);box-shadow:0 18px 22px rgba(0,0,0,.36)}.note-wood .suas-note-photo:before{left:34%;transform:rotate(25deg)}.note-wood .suas-note-photo:after{left:52%;transform:rotate(43deg)}.note-mint{--note-photo:linear-gradient(135deg,#d5ffe7,#52b672 52%,#173d25)}.note-mint .suas-note-photo:before,.note-mint .suas-note-photo:after{width:88px;height:46px;border-radius:80% 0 80% 0;background:linear-gradient(135deg,#baffd2,#2f9b59);box-shadow:0 15px 18px rgba(0,0,0,.26)}.note-mint .suas-note-photo:before{left:21%;top:26%;transform:rotate(-26deg)}.note-mint .suas-note-photo:after{right:18%;top:44%;transform:rotate(22deg)}.note-signature{--note-photo:linear-gradient(135deg,#ffd8e8,#fff,#d9ff78)}.note-cream{--note-photo:radial-gradient(circle at 44% 40%,#fff 0 24%,#f2d7e4 25% 42%,transparent 43%),linear-gradient(135deg,#fff,#ffd8e8)}.note-spark{--note-photo:linear-gradient(135deg,#e4d5ff,#cdeeff)}
  .suas-product-lane-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:24px}.suas-product-lane-grid article{border-radius:22px;padding:18px;background:linear-gradient(135deg,#fff,var(--blue))}.suas-product-lane-grid article:nth-child(2){background:linear-gradient(135deg,#fff,var(--pink))}.suas-product-lane-grid small{display:block;margin-bottom:7px;font-size:9px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.suas-product-lane-grid strong{font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(1.6rem,3vw,2.35rem);font-weight:700;line-height:.9;text-transform:lowercase}@media(max-width:820px){html body.template--product .suas-product-experience{width:min(430px,calc(100vw - 16px));margin-top:22px}.suas-note-grid{grid-template-columns:1fr;gap:13px}.suas-note-card{min-height:250px}.suas-product-lane-grid{grid-template-columns:1fr}.suas-window-strip b{font-size:7px;max-width:58%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.suas-product-description,.suas-product-description *{font-size:12px!important}.suas-note-head h2{font-size:clamp(2.55rem,13vw,4rem)}}
</style>

<section class="suas-product-experience" aria-label="SUAS product details">
  <div class="suas-product-vibe-card">
    <div class="suas-window-strip" aria-hidden="true"><span></span><span></span><span></span><b>formula file / {{ product.handle }}</b></div>
    <div class="suas-product-vibe-copy">
      <p class="suas-kicker">what it smells like</p>
      {% if product.description != blank %}
        <div class="suas-product-description rte">{{ product.description }}</div>
      {% else %}
        <p>{{ product.title }} is mixed for the SUAS world: handmade, playful, and made to layer into your daily routine.</p>
      {% endif %}
    </div>
  </div>

  <div class="suas-note-collection" id="scent-notes">
    <div class="suas-note-head">
      <p class="suas-kicker">star notes</p>
      <h2>smell it before it ships.</h2>
    </div>
    <div class="suas-note-grid">
      {% if desc_down contains 'coconut' %}{% assign has_notes = true %}<article class="suas-note-card note-coconut"><div class="suas-note-photo"></div><span>creamy coconut</span></article>{% endif %}
      {% if desc_down contains 'jasmine' %}{% assign has_notes = true %}<article class="suas-note-card note-jasmine"><div class="suas-note-photo"></div><span>jasmine blossom</span></article>{% endif %}
      {% if desc_down contains 'musk' %}{% assign has_notes = true %}<article class="suas-note-card note-musk"><div class="suas-note-photo"></div><span>soft white musk</span></article>{% endif %}
      {% if desc_down contains 'ocean' or desc_down contains 'salty air' or desc_down contains 'sea' %}{% assign has_notes = true %}<article class="suas-note-card note-ocean"><div class="suas-note-photo"></div><span>fresh ocean breeze</span></article>{% endif %}
      {% if desc_down contains 'vanilla' %}{% assign has_notes = true %}<article class="suas-note-card note-vanilla"><div class="suas-note-photo"></div><span>vanilla</span></article>{% endif %}
      {% if desc_down contains 'amber' %}{% assign has_notes = true %}<article class="suas-note-card note-amber"><div class="suas-note-photo"></div><span>amber</span></article>{% endif %}
      {% if desc_down contains 'lavender' %}{% assign has_notes = true %}<article class="suas-note-card note-lavender"><div class="suas-note-photo"></div><span>lavender</span></article>{% endif %}
      {% if desc_down contains 'mandarin' %}{% assign has_notes = true %}<article class="suas-note-card note-mandarin"><div class="suas-note-photo"></div><span>mandarin</span></article>{% endif %}
      {% if desc_down contains 'peach' %}{% assign has_notes = true %}<article class="suas-note-card note-peach"><div class="suas-note-photo"></div><span>peach</span></article>{% endif %}
      {% if desc_down contains 'plum' %}{% assign has_notes = true %}<article class="suas-note-card note-plum"><div class="suas-note-photo"></div><span>plum</span></article>{% endif %}
      {% if desc_down contains 'strawberry' %}{% assign has_notes = true %}<article class="suas-note-card note-strawberry"><div class="suas-note-photo"></div><span>strawberry</span></article>{% endif %}
      {% if desc_down contains 'rose' %}{% assign has_notes = true %}<article class="suas-note-card note-rose"><div class="suas-note-photo"></div><span>rose</span></article>{% endif %}
      {% if desc_down contains 'sandalwood' %}{% assign has_notes = true %}<article class="suas-note-card note-wood"><div class="suas-note-photo"></div><span>sandalwood</span></article>{% endif %}
      {% if desc_down contains 'cedar' %}{% assign has_notes = true %}<article class="suas-note-card note-wood"><div class="suas-note-photo"></div><span>cedarwood</span></article>{% endif %}
      {% if desc_down contains 'lemon' %}{% assign has_notes = true %}<article class="suas-note-card note-lemon"><div class="suas-note-photo"></div><span>lemon</span></article>{% endif %}
      {% if desc_down contains 'mint' %}{% assign has_notes = true %}<article class="suas-note-card note-mint"><div class="suas-note-photo"></div><span>mint</span></article>{% endif %}
      {% unless has_notes %}
        <article class="suas-note-card note-signature"><div class="suas-note-photo"></div><span>signature blend</span></article>
        <article class="suas-note-card note-cream"><div class="suas-note-photo"></div><span>soft finish</span></article>
        <article class="suas-note-card note-spark"><div class="suas-note-photo"></div><span>made to layer</span></article>
      {% endunless %}
    </div>
  </div>

  <div class="suas-product-lane-grid">
    <article><small>texture</small><strong>{% if product_title_down contains 'butter' or desc_down contains 'butter' %}thick + creamy{% elsif product_title_down contains 'oil' %}glossy oil{% elsif product_title_down contains 'mist' %}air-light mist{% else %}small-batch finish{% endif %}</strong></article>
    <article><small>best for</small><strong>{% if product_title_down contains 'butter' %}after shower glow{% elsif product_title_down contains 'oil' %}body layering{% elsif product_title_down contains 'candle' %}room mood{% else %}daily ritual{% endif %}</strong></article>
  </div>
</section>
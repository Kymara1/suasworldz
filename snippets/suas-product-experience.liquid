hoto-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1200&q=80')}.note-soft{--note-img:url('https://images.unsplash.com/photo-1515377905703-c4788e51af15?auto=format&fit=crop&w=1200&q=80')}.note-floral,.note-wildflower,.note-petals{--note-img:url('https://images.unsplash.com/photo-1490750967868-88aa4486c946?auto=format&fit=crop&w=1200&q=80')}.note-gourmand{--note-img:url('https://images.unsplash.com/photo-1606313564200-e75d5e30476c?auto=format&fit=crop&w=1200&q=80')}.note-signature{--note-img:url('https://images.unsplash.com/photo-1615634260167-c8cdede054de?auto=format&fit=crop&w=1200&q=80')}
  .suas-product-lane-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:24px}.suas-product-lane-grid article{border-radius:22px;padding:18px;background:linear-gradient(135deg,#fff,var(--blue))}.suas-product-lane-grid article:nth-child(2){background:linear-gradient(135deg,#fff,var(--pink))}.suas-product-lane-grid small{display:block;margin-bottom:7px;font-size:9px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.suas-product-lane-grid strong{font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(1.6rem,3vw,2.35rem);font-weight:700;line-height:.9;text-transform:lowercase}
  @media(max-width:1023px){html body.template--product .suas-side-rail{overflow:visible!important}html body.template--product .suas-side-nav{position:relative!important;display:flex!important;gap:8px!important;overflow-x:auto!important;overflow-y:visible!important;padding:2px 0 6px!important}html body.template--product .suas-side-dropdown{position:static!important}html body.template--product .suas-side-dropdown[open] summary{position:relative!important;z-index:1001!important;background:#101010!important;color:#fff!important;box-shadow:0 4px 0 rgba(16,16,16,.28)!important}html body.template--product .suas-side-dropdown[open]:before{content:''!important;position:fixed!important;inset:0!important;z-index:998!important;background:rgba(16,16,16,.34)!important;backdrop-filter:blur(3px)!important}html body.template--product .suas-side-dropdown[open] .suas-panel-submenu{position:fixed!important;left:10px!important;right:10px!important;top:auto!important;bottom:max(14px,env(safe-area-inset-bottom))!important;z-index:999!important;width:auto!important;min-width:0!important;max-width:none!important;max-height:min(68vh,520px)!important;display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:10px!important;margin:0!important;padding:18px!important;overflow:auto!important;border:2px solid #101010!important;border-radius:30px 30px 18px 18px!important;background:linear-gradient(135deg,#fff 0%,#fff8fb 48%,#f4ffd1 100%)!important;box-shadow:8px 9px 0 #101010,0 24px 70px rgba(16,16,16,.35)!important}.suas-side-dropdown[open] .suas-panel-submenu:before{content:'choose a lane';grid-column:1/-1;display:block;margin:0 0 2px;padding:0 4px;color:#101010;font-family:Futura,'Futura PT',Arial,sans-serif;font-size:10px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.suas-side-dropdown[open] .suas-panel-submenu a{display:flex!important;align-items:center!important;justify-content:space-between!important;width:100%!important;min-height:54px!important;padding:14px!important;border:1.7px solid rgba(16,16,16,.18)!important;border-radius:20px!important;background:rgba(255,255,255,.92)!important;color:#101010!important;text-align:left!important;font-size:10px!important;line-height:1.1!important;letter-spacing:.11em!important;box-shadow:0 4px 0 rgba(16,16,16,.08)!important}.suas-side-dropdown[open] .suas-panel-submenu a:after{content:'→';font-size:15px;letter-spacing:0}.suas-side-dropdown[open] .suas-panel-submenu a:hover{background:#d9ff78!important;border-color:#101010!important}}
  @media(max-width:820px){html body.template--product .suas-product-experience{width:min(430px,calc(100vw - 16px));margin-top:22px}.suas-note-grid{grid-template-columns:1fr;gap:13px}.suas-note-card{min-height:285px}.suas-product-lane-grid{grid-template-columns:1fr}.suas-window-strip b{font-size:7px;max-width:58%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.suas-product-description,.suas-product-description *{font-size:12px!important}.suas-note-head h2{font-size:clamp(2.55rem,13vw,4rem)}.suas-side-dropdown[open] .suas-panel-submenu{grid-template-columns:1fr!important}html body.template--product .radios--value-button{inline-size:58px!important;block-size:58px!important;min-inline-size:58px!important;font-size:8px!important}}

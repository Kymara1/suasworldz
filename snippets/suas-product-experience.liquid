<section class="suas-product-experience" aria-label="SUAS product details">
  <div class="suas-product-vibe-card">
    <div class="suas-window-strip" aria-hidden="true"><span></span><span></span><span></span><b>formula file / {{ product.handle }}</b></div>
    <div class="suas-product-vibe-copy">
      <p class="suas-kicker">what it smells like</p>
      {% if product.description != blank %}
        <div class="suas-product-description rte">{{ product.description }}</div>
      {% else %}
        <p>{{ product.title }} is mixed for the SUAS world: handmade, playful, and made to layer into your daily routine.</p>
      {% endif %}
    </div>
  </div>

  <div class="suas-note-collection" id="scent-notes">
    <div class="suas-note-head">
      <h2>smell it before it ships.</h2>
    </div>
    <div class="suas-note-grid">
      {% if scent_down contains 'wildflower bouquet' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-wildflower"><span>wildflower bouquet</span></article>{% endif %}
      {% if scent_down contains 'fresh petals' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-petals"><span>fresh petals</span></article>{% endif %}
      {% if scent_down contains 'soft sunshine' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-sunshine"><span>soft sunshine</span></article>{% endif %}
      {% if scent_down contains 'coconut' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-coconut"><span>creamy coconut</span></article>{% endif %}
      {% if scent_down contains 'jasmine' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-jasmine"><span>jasmine blossom</span></article>{% endif %}
      {% if scent_down contains 'musk' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-musk"><span>soft white musk</span></article>{% endif %}
      {% if scent_down contains 'ocean' or scent_down contains 'salty air' or scent_down contains 'sea' or scent_down contains 'marine' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-ocean"><span>fresh ocean breeze</span></article>{% endif %}
      {% if scent_down contains 'vanilla' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-vanilla"><span>vanilla</span></article>{% endif %}
      {% if scent_down contains 'amber' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-amber"><span>amber</span></article>{% endif %}
      {% if scent_down contains 'lavender' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-lavender"><span>lavender</span></article>{% endif %}
      {% if scent_down contains 'mandarin' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-mandarin"><span>mandarin</span></article>{% endif %}
      {% if scent_down contains 'orange' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-orange"><span>orange</span></article>{% endif %}
      {% if scent_down contains 'lemon' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-lemon"><span>lemon</span></article>{% endif %}
      {% if scent_down contains 'citrus' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-citrus"><span>citrus</span></article>{% endif %}
      {% if scent_down contains 'peach' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-peach"><span>peach</span></article>{% endif %}
      {% if scent_down contains 'plum' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-plum"><span>plum</span></article>{% endif %}
      {% if scent_down contains 'strawberry' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-strawberry"><span>strawberry</span></article>{% endif %}
      {% if scent_down contains 'rose' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-rose"><span>rose</span></article>{% endif %}
      {% if scent_down contains 'sandalwood' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-wood"><span>sandalwood</span></article>{% endif %}
      {% if scent_down contains 'cedar' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-wood"><span>cedarwood</span></article>{% endif %}
      {% if scent_down contains 'mint' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-mint"><span>mint</span></article>{% endif %}
      {% if scent_down contains 'coffee' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-coffee"><span>coffee</span></article>{% endif %}
      {% if scent_down contains 'caramel' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-caramel"><span>caramel</span></article>{% endif %}
      {% if scent_down contains 'sugar' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-sugar"><span>sugar</span></article>{% endif %}
      {% if scent_down contains 'tea' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-tea"><span>tea</span></article>{% endif %}
      {% if note_count < 3 and scent_down contains 'clean' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-clean"><span>clean skin</span></article>{% endif %}
      {% if note_count < 3 and scent_down contains 'warm' or note_count < 3 and scent_down contains 'skin' or note_count < 3 and scent_down contains 'sunscreen' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-warm"><span>warm skin</span></article>{% endif %}
      {% if note_count < 3 and scent_down contains 'soft' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-soft"><span>soft finish</span></article>{% endif %}
      {% if note_count < 3 and scent_down contains 'floral' or note_count < 3 and scent_down contains 'flower' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-floral"><span>soft florals</span></article>{% endif %}
      {% if note_count < 3 and scent_down contains 'sweet' %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-gourmand"><span>soft sweetness</span></article>{% endif %}
      {% if note_count < 3 %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-signature"><span>signature blend</span></article>{% endif %}
      {% if note_count < 3 %}{% assign note_count = note_count | plus: 1 %}<article class="suas-note-card note-soft"><span>wearable softness</span></article>{% endif %}
      {% if note_count < 3 %}<article class="suas-note-card note-clean"><span>finished formula</span></article>{% endif %}
    </div>
  </div>

  <div class="suas-product-lane-grid">
    <article><small>texture</small><strong>{% if product_title_down contains 'butter' or desc_down contains 'butter' %}thick + creamy{% elsif product_title_down contains 'oil' %}glossy oil{% elsif product_title_down contains 'mist' %}air-light mist{% else %}small-batch finish{% endif %}</strong></article>
    <article><small>best for</small><strong>{% if product_title_down contains 'butter' %}after shower glow{% elsif product_title_down contains 'oil' %}body layering{% elsif product_title_down contains 'candle' %}room mood{% else %}daily ritual{% endif %}</strong></article>
  </div>
</section>
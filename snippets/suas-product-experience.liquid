{% liquid
  assign desc_text = product.description | strip_html
  assign desc_down = desc_text | downcase
  assign scent_body_down = desc_down | split: 'ingredients' | first | split: 'ingredient' | first | split: 'directions' | first
  assign profile_down = ''
  if scent_body_down contains 'scent profile:'
    assign profile_down = scent_body_down | split: 'scent profile:' | last | split: 'ingredients' | first | split: 'ingredient' | first | split: 'directions' | first
  elsif scent_body_down contains 'scent profile'
    assign profile_down = scent_body_down | split: 'scent profile' | last | split: 'ingredients' | first | split: 'ingredient' | first | split: 'directions' | first
  endif
  assign scent_down = profile_down | append: ' ' | append: scent_body_down
  assign product_title_down = product.title | downcase
  assign note_count = 0
%}

<style>
  html body.template--product .suas-product-experience{--ink:#101010;--pink:#ffd8e8;--blue:#cdeeff;--lime:#d9ff78;width:min(1120px,calc(100vw - 34px));margin:clamp(24px,4vw,50px) auto 0;color:var(--ink);font-family:Futura,'Futura PT',Arial,sans-serif}html body.template--product .suas-product-experience *{box-sizing:border-box}.suas-kicker{margin:0 0 10px;font-size:10px;font-weight:900;letter-spacing:.2em;text-transform:uppercase}.suas-product-vibe-card,.suas-note-collection,.suas-product-lane-grid article{border:2px solid var(--ink);background:#fff;box-shadow:7px 8px 0 var(--ink)}.suas-product-vibe-card{border-radius:28px;overflow:hidden;background:linear-gradient(rgba(16,16,16,.026) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.026) 1px,transparent 1px),radial-gradient(circle at 12% 18%,rgba(255,216,232,.84),transparent 30%),radial-gradient(circle at 92% 78%,rgba(217,255,120,.44),transparent 30%),#fff;background-size:18px 18px,18px 18px,auto,auto,auto}.suas-window-strip{height:38px;display:flex;align-items:center;gap:8px;padding:0 16px;border-bottom:2px solid var(--ink);background:linear-gradient(#f6f7f9,#e9edf2)}.suas-window-strip span{width:12px;height:12px;border-radius:999px;background:#ff6257}.suas-window-strip span:nth-child(2){background:#ffbd2e}.suas-window-strip span:nth-child(3){background:#28c840}.suas-window-strip b{margin-left:auto;font-size:9px;font-weight:900;letter-spacing:.16em;text-transform:uppercase}.suas-product-vibe-copy{padding:clamp(18px,3vw,30px)}.suas-product-description{max-width:900px}.suas-product-description,.suas-product-description *{font-size:14px!important;line-height:1.55!important;color:var(--ink)!important}.suas-product-description p{margin:0 0 12px!important}.suas-product-description strong{font-weight:900!important}
  html body.template--product .product-options--container{margin-top:18px!important}html body.template--product .radios--container{display:flex!important;flex-wrap:wrap!important;gap:10px!important;align-items:center!important}html body.template--product .radios--input{position:absolute!important;inline-size:1px!important;block-size:1px!important;opacity:0!important;pointer-events:none!important}html body.template--product .radios--value-button{inline-size:62px!important;block-size:62px!important;min-inline-size:62px!important;display:inline-flex!important;align-items:center!important;justify-content:center!important;padding:6px!important;border:2px solid #101010!important;border-radius:999px!important;background:#fff!important;color:#101010!important;box-shadow:0 4px 0 rgba(16,16,16,.2)!important;font-family:Futura,'Futura PT',Arial,sans-serif!important;font-size:9px!important;font-weight:900!important;line-height:1.05!important;letter-spacing:.07em!important;text-align:center!important;text-transform:uppercase!important;cursor:pointer!important;transition:transform .16s ease,background .16s ease,color .16s ease,box-shadow .16s ease!important}html body.template--product .radios--value-button:hover{transform:translateY(-1px)!important;background:#f7ffd8!important}html body.template--product .radios--input:checked+.radios--value-button,html body.template--product .radios--value-button[aria-checked='true']{background:#101010!important;color:#fff!important;box-shadow:0 4px 0 #ff9bc4!important}html body.template--product .radios--input:focus-visible+.radios--value-button{outline:3px solid #c6f76a!important;outline-offset:3px!important}
  .suas-note-collection{margin-top:clamp(24px,4vw,44px);border-radius:30px;padding:clamp(18px,3vw,30px);background:linear-gradient(rgba(16,16,16,.024) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.024) 1px,transparent 1px),#e9ded3;background-size:20px 20px,20px 20px,auto;overflow:hidden}.suas-note-head{text-align:center;margin-bottom:20px}.suas-note-head h2{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:clamp(3rem,6.3vw,6rem);font-weight:700;line-height:.84;text-transform:uppercase}.suas-note-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.suas-note-card{position:relative;min-height:340px;border:2px solid var(--ink);border-radius:24px;overflow:hidden;background:#111;box-shadow:5px 6px 0 var(--ink);display:flex;align-items:end;justify-content:center;padding:18px;isolation:isolate}.suas-note-card:before{content:'';position:absolute;inset:0;background-image:var(--note-img);background-size:cover;background-position:center;filter:saturate(1.08) contrast(1.04);z-index:-3}.suas-note-card:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.02) 0%,rgba(0,0,0,.12) 45%,rgba(0,0,0,.68) 100%);z-index:-1}.suas-note-card span{position:relative;z-index:3;display:inline-flex;align-items:center;justify-content:center;max-width:92%;min-height:34px;padding:9px 15px 8px;border:1.5px solid rgba(255,255,255,.82);border-radius:999px;background:rgba(16,16,16,.46);backdrop-filter:blur(8px);color:#fff;text-shadow:0 2px 10px rgba(0,0,0,.45);font-size:13px;font-weight:900;letter-spacing:.08em;text-transform:lowercase;text-align:center}.note-coconut{--note-img:url('https://images.unsplash.com/photo-1580984969071-a8da5656c2fb?auto=format&fit=crop&w=1200&q=80')}.note-jasmine{--note-img:url('https://images.unsplash.com/photo-1562690868-60bbe7293e94?auto=format&fit=crop&w=1200&q=80')}.note-musk{--note-img:url('https://images.unsplash.com/photo-1615529162924-f8605388461d?auto=format&fit=crop&w=
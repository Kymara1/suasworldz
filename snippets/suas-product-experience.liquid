{% liquid
  assign desc_text = product.description | strip_html
  assign product_title_down = product.title | downcase
  assign pdp_type = product.type | downcase
  assign pdp_home = false
  if pdp_type contains 'candle' or pdp_type contains 'mist' or pdp_type contains 'home' or product_title_down contains 'candle' or product_title_down contains 'mist'
    assign pdp_home = true
  endif

  assign story_html = product.description
  if product.description contains 'Scent profile'
    assign story_html = product.description | split: 'Scent profile' | first
  elsif product.description contains 'scent profile'
    assign story_html = product.description | split: 'scent profile' | first
  elsif product.description contains 'Ingredients'
    assign story_html = product.description | split: 'Ingredients' | first
  elsif product.description contains 'ingredients'
    assign story_html = product.description | split: 'ingredients' | first
  endif

  assign ingredients_html = ''
  if product.description contains 'Ingredients'
    assign ingredients_html = product.description | split: 'Ingredients' | last | remove_first: ':' | strip
  elsif product.description contains 'ingredients'
    assign ingredients_html = product.description | split: 'ingredients' | last | remove_first: ':' | strip
  endif

  assign scent_line = ''
  if desc_text contains 'Scent profile:'
    assign scent_line = desc_text | split: 'Scent profile:' | last | split: 'For:' | first | strip
  elsif desc_text contains 'scent profile:'
    assign scent_line = desc_text | split: 'scent profile:' | last | split: 'For:' | first | strip
  endif
  if scent_line != blank
    assign scent_line = scent_line | split: 'Ingredients' | first | split: 'ingredients' | first | strip
  endif

  assign for_line = ''
  if desc_text contains 'For:'
    assign for_line = desc_text | split: 'For:' | last | split: 'Ingredients' | first | split: 'ingredients' | first | strip
  endif

  assign note_1_label = ''
  assign note_1_file = ''
  assign note_2_label = ''
  assign note_2_file = ''
  assign note_3_label = ''
  assign note_3_file = ''
  assign note_4_label = ''
  assign note_4_file = ''
  assign note_5_label = ''
  assign note_5_file = ''
  case product.handle
    when 'poppy'
      assign note_1_label = 'bubblegum'
      assign note_1_file = 'note-poppy-gum-balls.png'
      assign note_2_label = 'pink gum'
      assign note_2_file = 'note-poppy-gum.png'
      assign note_3_label = 'cosmos'
      assign note_3_file = 'note-poppy-cosmos.png'
      assign note_4_label = 'sparkle bouquet'
      assign note_4_file = 'note-poppy-bouquet.png'
      assign note_5_label = 'blossom bubbles'
      assign note_5_file = 'note-poppy-bubbles.png'
    when 'tonic-butter-creme'
      assign note_1_label = 'blackberry'
      assign note_1_file = 'note-blackberry.png'
      assign note_2_label = 'sage x mint'
      assign note_2_file = 'note-sage-mint.png'
    when 'nectar-butter-creme-copy'
      assign note_1_label = 'pineapple'
      assign note_1_file = 'note-pineapple.png'
      assign note_2_label = 'passionfruit'
      assign note_2_file = 'note-passionfruit.png'
      assign note_3_label = 'pineapple juice'
      assign note_3_file = 'note-pineapple-slices.png'
      assign note_4_label = 'passionfruit pulp'
      assign note_4_file = 'note-passionfruit-swirl.png'
    when 'good-girl-butter-creme-2'
      assign note_1_label = 'creamy coconut'
      assign note_1_file = 'note-coconut.png'
      assign note_2_label = 'jasmine blossom'
      assign note_2_file = 'note-jasmine.png'
    when 'haze-butter-creme'
      assign note_1_label = 'wildflower bouquet'
      assign note_1_file = 'note-wildflower.png'
      assign note_2_label = 'fresh petals'
      assign note_2_file = 'note-petals.png'
      assign note_3_label = 'soft sunshine'
      assign note_3_file = 'note-sunshine.png'
  endcase
%}

<style>
  html body.template--product .suas-product-experience{width:min(1180px,100%);margin:18px auto 0;color:#101010;font-family:Futura,'Futura PT',Arial,sans-serif}
  html body.template--product .suas-product-experience *{box-sizing:border-box}
  html body.template--product .shopify-section:has([class*='aftership'])::before,html body.template--product .shopify-section:has([class*='automizely'])::before{content:none!important;display:none!important}
  html body.template--product .product-options--container{margin-top:8px!important}
  html body.template--product .radios--container{display:flex!important;flex-wrap:wrap!important;gap:8px!important;align-items:center!important}
  html body.template--product .radios--input{position:absolute!important;inline-size:1px!important;block-size:1px!important;opacity:0!important;pointer-events:none!important}
  html body.template--product .radios--main{position:relative!important;background:transparent!important;border:0!important;box-shadow:none!important;padding:0!important;margin:0!important}
  html body.template--product .radios--swatch-button{inline-size:42px!important;block-size:42px!important;border:2px solid #101010!important;border-radius:999px!important}
  html body.template--product .radios--value-button{inline-size:auto!important;min-inline-size:52px!important;block-size:32px!important;display:inline-flex!important;align-items:center!important;justify-content:center!important;padding:0 10px!important;border:2px solid #101010!important;border-radius:999px!important;background:#fff!important;color:#101010!important;box-shadow:0 3px 0 #101010!important;font-size:11px!important;font-weight:900!important;line-height:1!important;cursor:pointer!important;overflow:visible!important;white-space:nowrap!important}
  html body.template--product .radios--value-button div{font-size:11px!important;line-height:1!important;color:inherit!important}
  html body.template--product .radios--input:checked+.radios--value-button{background:#101010!important;color:#fff!important;box-shadow:0 0 0 3px #101010,0 3px 0 #d9ff78!important}
  html body.template--product .product-page--price{margin:4px 0 8px!important;font-size:1.35rem!important;font-weight:900!important}
  .suas-pdp-fold{border:2px solid #101010;border-radius:22px;box-shadow:5px 6px 0 #101010;margin:0 0 12px;overflow:hidden}
  .suas-pdp-fold+.suas-pdp-fold{margin-top:10px}
  .suas-pdp-fold summary{list-style:none;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 18px;cursor:pointer;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(1.8rem,4vw,2.6rem);line-height:.85;text-transform:lowercase}
  .suas-pdp-fold summary::-webkit-details-marker{display:none}
  .suas-pdp-fold summary:after{content:'+';font-family:Futura,Arial,sans-serif;font-size:1.8rem;font-weight:900;line-height:1}
  .suas-pdp-fold[open] summary:after{content:'-'}
  .suas-pdp-fold-body{padding:0 18px 22px;font-size:15px;line-height:1.5;font-weight:700}
  .suas-pdp-fold-body p{margin:0 0 12px}
  .suas-pdp-details{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(220px,.8fr);gap:22px;align-items:start}
  .suas-pdp-story .rte p:last-child{margin-bottom:0}
  .suas-pdp-side{display:grid;gap:10px}
  .suas-pdp-chip{border:2px solid #101010;border-radius:18px;background:#fff;padding:12px 14px;box-shadow:3px 4px 0 #101010}
  .suas-pdp-chip b{display:block;margin:0 0 4px;font-size:10px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}
  .suas-pdp-chip p{margin:0;font-size:14px;line-height:1.35}
  .suas-pdp-steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
  .suas-pdp-step{border:2px solid #101010;border-radius:18px;background:#fff;padding:14px 12px;box-shadow:3px 4px 0 #101010}
  .suas-pdp-step em{display:block;margin:0 0 6px;font-style:normal;font-size:10px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}
  .suas-pdp-step p{margin:0;font-size:14px;line-height:1.35}
  .suas-pdp-ing{margin:0;font-size:14px;font-weight:700;line-height:1.55}
  .suas-scent-notes{margin:0 0 18px}
  .suas-scent-notes-head{margin:0 0 12px}
  .suas-scent-notes-head small{display:block;font-size:10px;font-weight:900;letter-spacing:.16em;text-transform:uppercase;margin:0 0 4px}
  .suas-scent-notes-head h2{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(2rem,5vw,3.1rem);line-height:.88;text-transform:lowercase;font-weight:700}
  .suas-scent-notes-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;align-items:start}
  .suas-scent-notes-grid.is-three{grid-template-columns:repeat(3,minmax(0,1fr))}
  .suas-scent-note{margin:0;border:2px solid #101010;border-radius:22px;overflow:hidden;background:#fff;box-shadow:4px 5px 0 #101010;display:flex;flex-direction:column}
  .suas-scent-note .pic{display:block;width:100%;aspect-ratio:1/1;overflow:hidden;background:#f4f1ea}
  .suas-scent-note img{display:block;width:100%!important;height:100%!important;max-height:none!important;object-fit:cover!important;object-position:center}
  .suas-scent-note b{display:block;padding:10px 12px 12px;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(1.15rem,3vw,1.55rem);line-height:.9;text-transform:lowercase;font-weight:700}
  @media(max-width:820px){
    .suas-pdp-fold-body{padding:0 14px 16px}
    .suas-pdp-fold summary{font-size:clamp(1.5rem,8vw,2rem);padding:14px}
    .suas-pdp-details,.suas-pdp-steps{grid-template-columns:1fr}
    html body.template--product .radios--value-button{block-size:30px!important;font-size:11px!important}
    .suas-scent-notes-grid,.suas-scent-notes-grid.is-three{grid-template-columns:repeat(2,minmax(0,1fr))}
  }
</style>

<section class="suas-product-experience" id="suas-pdp-details" aria-label="SUAS product details">
  {% if note_1_file != blank %}
    <div class="suas-scent-notes" aria-label="Scent notes">
      <div class="suas-scent-notes-head">
        <small>scent notes</small>
        <h2>what it smells like.</h2>
      </div>
      <div class="suas-scent-notes-grid{% if note_4_file == blank and note_3_file != blank %} is-three{% endif %}">
        <figure class="suas-scent-note">
          <span class="pic"><img src="{{ note_1_file | asset_url }}" alt="{{ note_1_label }}" width="800" height="800" loading="lazy"></span>
          <b>{{ note_1_label }}</b>
        </figure>
        {% if note_2_file != blank %}
          <figure class="suas-scent-note">
            <span class="pic"><img src="{{ note_2_file | asset_url }}" alt="{{ note_2_label }}" width="800" height="800" loading="lazy"></span>
            <b>{{ note_2_label }}</b>
          </figure>
        {% endif %}
        {% if note_3_file != blank %}
          <figure class="suas-scent-note">
            <span class="pic"><img src="{{ note_3_file | asset_url }}" alt="{{ note_3_label }}" width="800" height="800" loading="lazy"></span>
            <b>{{ note_3_label }}</b>
          </figure>
        {% endif %}
        {% if note_4_file != blank %}
          <figure class="suas-scent-note">
            <span class="pic"><img src="{{ note_4_file | asset_url }}" alt="{{ note_4_label }}" width="800" height="800" loading="lazy"></span>
            <b>{{ note_4_label }}</b>
          </figure>
        {% endif %}
        {% if note_5_file != blank %}
          <figure class="suas-scent-note">
            <span class="pic"><img src="{{ note_5_file | asset_url }}" alt="{{ note_5_label }}" width="800" height="800" loading="lazy"></span>
            <b>{{ note_5_label }}</b>
          </figure>
        {% endif %}
      </div>
    </div>
  {% endif %}

  <details class="suas-pdp-fold">
    <summary>details</summary>
    <div class="suas-pdp-fold-body">
      <div class="suas-pdp-details">
        <div class="suas-pdp-story">
          {% if story_html != blank %}
            <div class="rte">{{ story_html }}</div>
          {% else %}
            <p>{{ product.title }} is mixed for the SUAS world: handmade, playful, and made to layer into your daily ritual.</p>
          {% endif %}
        </div>
        <aside class="suas-pdp-side">
          {% if scent_line != blank %}
            <div class="suas-pdp-chip">
              <b>scent profile</b>
              <p>{{ scent_line }}</p>
            </div>
          {% endif %}
          {% if for_line != blank %}
            <div class="suas-pdp-chip">
              <b>for</b>
              <p>{{ for_line }}</p>
            </div>
          {% endif %}
          <div class="suas-pdp-chip">
            <b>the feel</b>
            <p>{% if pdp_home %}Room-filling scent for the house, the car, the after-hours.{% else %}Soothes. Moisturizes. Layers. Cushiony handmade formula for skin that wants to smell like something, not like a lecture.{% endif %}</p>
          </div>
        </aside>
      </div>
    </div>
  </details>

  <details class="suas-pdp-fold">
    <summary>how it works</summary>
    <div class="suas-pdp-fold-body">
      <div class="suas-pdp-steps">
        {% if pdp_home %}
          <div class="suas-pdp-step"><em>01 / set</em><p>Light it, mist it, or warm it.</p></div>
          <div class="suas-pdp-step"><em>02 / wait</em><p>Give the room a minute to catch it.</p></div>
          <div class="suas-pdp-step"><em>03 / live in it</em><p>The scent blooms, then sits pretty.</p></div>
        {% else %}
          <div class="suas-pdp-step"><em>01 / warm</em><p>Warm a little in your hands.</p></div>
          <div class="suas-pdp-step"><em>02 / press</em><p>Press it into still-damp skin.</p></div>
          <div class="suas-pdp-step"><em>03 / melt</em><p>Let it melt. That's the whole spell.</p></div>
        {% endif %}
      </div>
    </div>
  </details>

  <details class="suas-pdp-fold">
    <summary>ingredients</summary>
    <div class="suas-pdp-fold-body">
      {% if ingredients_html != blank %}
        <p class="suas-pdp-ing">{{ ingredients_html | strip_html }}</p>
      {% else %}
        <p class="suas-pdp-ing">Shea butter, mango seed butter, and the scent mix on this jar. Handmade in small batches in Gastonia, NC.</p>
      {% endif %}
    </div>
  </details>
</section>

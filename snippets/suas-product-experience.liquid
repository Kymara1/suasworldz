{% liquid
  assign desc_text = product.description | strip_html
  assign desc_down = desc_text | downcase
  assign product_title_down = product.title | downcase
  assign has_notes = false
%}

<style>
  html body.template--product .suas-product-experience{--ink:#101010;--pink:#ffd8e8;--hot:#ff9bc4;--blue:#cdeeff;--lime:#d9ff78;--sun:#fff1a8;--lav:#e4d5ff;width:min(1120px,calc(100vw - 34px));margin:clamp(24px,4vw,50px) auto 0;color:var(--ink);font-family:Futura,'Futura PT',Arial,sans-serif}
  html body.template--product .suas-product-experience *{box-sizing:border-box}.suas-product-experience .suas-kicker{margin:0 0 10px;font-size:10px;font-weight:900;letter-spacing:.2em;text-transform:uppercase}.suas-product-vibe-card,.suas-note-collection,.suas-product-lane-grid article{border:2px solid var(--ink);background:#fff;box-shadow:7px 8px 0 var(--ink)}.suas-product-vibe-card{border-radius:28px;overflow:hidden;background:linear-gradient(rgba(16,16,16,.026) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.026) 1px,transparent 1px),radial-gradient(circle at 12% 18%,rgba(255,216,232,.84),transparent 30%),radial-gradient(circle at 92% 78%,rgba(217,255,120,.44),transparent 30%),#fff;background-size:18px 18px,18px 18px,auto,auto,auto}.suas-window-strip{height:38px;display:flex;align-items:center;gap:8px;padding:0 16px;border-bottom:2px solid var(--ink);background:linear-gradient(#f6f7f9,#e9edf2)}.suas-window-strip span{width:12px;height:12px;border-radius:999px;background:#ff6257}.suas-window-strip span:nth-child(2){background:#ffbd2e}.suas-window-strip span:nth-child(3){background:#28c840}.suas-window-strip b{margin-left:auto;font-size:9px;font-weight:900;letter-spacing:.16em;text-transform:uppercase}.suas-product-vibe-copy{padding:clamp(18px,3vw,30px)}.suas-product-description{max-width:880px}.suas-product-description,.suas-product-description *{font-size:14px!important;line-height:1.55!important;color:var(--ink)!important}.suas-product-description p{margin:0 0 12px!important}.suas-product-description strong{font-weight:900!important}.suas-note-collection{margin-top:clamp(22px,4vw,38px);border-radius:30px;padding:clamp(18px,3vw,28px);background:linear-gradient(rgba(16,16,16,.024) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.024) 1px,transparent 1px),#efe5dc;background-size:20px 20px,20px 20px,auto;overflow:hidden}.suas-note-head{text-align:center;margin-bottom:18px}.suas-note-head h2{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif!important;font-size:clamp(2.8rem,6vw,5.5rem);font-weight:700;line-height:.84;text-transform:lowercase}.suas-note-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.suas-note-card{position:relative;min-height:320px;border:2px solid var(--ink);border-radius:22px;overflow:hidden;background:#fff;box-shadow:5px 6px 0 var(--ink);display:flex;align-items:end;justify-content:center;padding:16px}.suas-note-card:before{content:'';position:absolute;inset:0;background:var(--note-bg,linear-gradient(135deg,#fff,var(--pink)));z-index:0}.suas-note-card:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(0,0,0,.28));z-index:1;pointer-events:none}.suas-note-card span{position:relative;z-index:3;color:#fff;text-shadow:0 2px 8px rgba(0,0,0,.5);font-size:13px;font-weight:900;letter-spacing:.05em;text-transform:lowercase}.suas-note-art{position:absolute;inset:0;z-index:2;display:block}.suas-note-art i,.suas-note-art b,.suas-note-art em{position:absolute;display:block;font-style:normal}.note-coconut{--note-bg:radial-gradient(circle at 70% 20%,#fff9e7,transparent 18%),linear-gradient(135deg,#5c371b,#e0b870)}.note-coconut i{left:22%;top:20%;width:48%;aspect-ratio:1;border:7px solid var(--ink);border-radius:50%;background:radial-gradient(circle at 55% 46%,#fff8ef 0 38%,#6b3f20 39%)}.note-coconut b{left:34%;top:34%;width:15%;aspect-ratio:1;border-radius:50%;background:var(--ink);box-shadow:34px 5px 0 var(--ink),18px 28px 0 var(--ink)}.note-jasmine{--note-bg:linear-gradient(135deg,#6ca843,#f4fff0)}.note-jasmine i{left:26%;top:19%;width:45%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,#ffd851 0 11%,transparent 12%),radial-gradient(ellipse at 50% 3%,#fff 0 22%,transparent 23%),radial-gradient(ellipse at 97% 50%,#fff 0 22%,transparent 23%),radial-gradient(ellipse at 50% 97%,#fff 0 22%,transparent 23%),radial-gradient(ellipse at 3% 50%,#fff 0 22%,transparent 23%);filter:drop-shadow(0 5px 0 rgba(16,16,16,.38))}.note-jasmine b{left:12%;bottom:24%;width:76%;height:8px;border-radius:999px;background:#3c7b32;transform:rotate(-18deg)}.note-musk{--note-bg:linear-gradient(135deg,#f8f5ef,#dce8ff)}.note-musk i{left:16%;top:25%;width:64%;height:38%;border-radius:999px;background:radial-gradient(circle at 22% 56%,#fff 0 25%,transparent 26%),radial-gradient(circle at 45% 36%,#fff 0 32%,transparent 33%),radial-gradient(circle at 72% 56%,#fff 0 28%,transparent 29%)}.note-musk b{left:22%;top:60%;width:58%;height:12px;border-radius:999px;background:rgba(255,255,255,.7)}.note-ocean{--note-bg:linear-gradient(180deg,#bdefff,#246f9d)}.note-ocean i{left:0;right:0;bottom:33%;height:38%;background:repeating-radial-gradient(ellipse at 20% 80%,transparent 0 18px,#fff 19px 24px,transparent 25px 44px)}.note-ocean b{left:12%;top:16%;width:75%;height:32%;background:linear-gradient(160deg,rgba(255,255,255,.85),transparent);clip-path:polygon(0 65%,20% 35%,44% 60%,66% 24%,100% 58%,100% 100%,0 100%)}.note-vanilla{--note-bg:linear-gradient(135deg,#fff7cf,#8a532f)}.note-vanilla i,.note-vanilla b{width:26px;height:190px;border:5px solid var(--ink);border-radius:999px;background:#3c2117;top:17%}.note-vanilla i{left:36%;transform:rotate(24deg)}.note-vanilla b{left:52%;transform:rotate(39deg)}.note-amber{--note-bg:linear-gradient(135deg,#ffcc5a,#7b2d16)}.note-amber i{left:24%;top:20%;width:52%;height:45%;border:5px solid var(--ink);background:linear-gradient(135deg,#ffde7a,#b3461d);clip-path:polygon(16% 10%,68% 0,100% 35%,76% 100%,14% 82%,0 32%)}.note-lavender{--note-bg:linear-gradient(135deg,#6f54bc,#c9bbff)}.note-lavender i,.note-lavender b,.note-lavender em{bottom:20%;width:9px;height:60%;border-radius:999px;background:#365b34}.note-lavender i{left:35%;transform:rotate(-15deg)}.note-lavender b{left:50%;transform:rotate(5deg)}.note-lavender em{left:64%;transform:rotate(17deg)}.note-lavender .suas-note-art:after{content:'';position:absolute;left:29%;top:18%;width:42%;height:45%;background:radial-gradient(circle,#9c7bff 0 7px,transparent 8px) 0 0/18px 18px}.note-mandarin,.note-peach,.note-lemon,.note-strawberry{--note-bg:linear-gradient(135deg,#ffe6b8,#ff7b25)}.note-mandarin i,.note-peach i,.note-lemon i,.note-strawberry i{left:22%;top:16%;width:54%;aspect-ratio:1;border:6px solid var(--ink);border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff5a8 0 14%,transparent 15%),#ff8425}.note-lemon{--note-bg:linear-gradient(135deg,#fff7a8,#f3dc30)}.note-lemon i{border-radius:52% 48% 50% 50%/62% 62% 38% 38%;background:#ffe95b;transform:rotate(-22deg)}.note-peach{--note-bg:linear-gradient(135deg,#ffd6b5,#ff8f8b)}.note-peach i{background:#ffad75}.note-strawberry{--note-bg:linear-gradient(135deg,#ffb3ca,#db2450)}.note-strawberry i{border-radius:55% 45% 58% 42%/40% 42% 58% 60%;background:#e02b4f}.note-plum{--note-bg:linear-gradient(135deg,#e7bcff,#7b1f6f)}.note-plum i{left:23%;top:18%;width:54%;aspect-ratio:1;border:6px solid var(--ink);border-radius:50%;background:radial-gradient(circle at 35% 25%,#ffd3ef 0 14%,transparent 15%),#8b2a7f}.note-rose{--note-bg:linear-gradient(135deg,#ffd8e8,#b31545)}.note-rose i{left:24%;top:18%;width:52%;aspect-ratio:1;border:6px solid var(--ink);border-radius:50%;background:conic-gradient(#ff5d8e,#b31545,#ffd1de,#ff5d8e)}.note-wood{--note-bg:linear-gradient(135deg,#d5a26a,#4a2a17)}.note-wood i,.note-wood b{width:28px;height:185px;border:5px solid var(--ink);border-radius:16px;background:repeating-linear-gradient(100deg,#5c3219 0 9px,#d19b61 10px 17px);top:15%}.note-wood i{left:35%;transform:rotate(27deg)}.note-wood b{left:54%;transform:rotate(45deg)}.note-mint{--note-bg:linear-gradient(135deg,#a9ffcc,#2d8b50)}.note-mint i,.note-mint b,.note-signature i,.note-spark i{width:72px;height:38px;border:5px solid var(--ink);border-radius:50% 0 50% 0;background:#42b56d}.note-mint i{left:22%;top:27%;transform:rotate(-28deg)}.note-mint b{right:20%;top:44%;transform:rotate(22deg)}.note-signature{--note-bg:linear-gradient(135deg,#ffd8e8,#d9ff78)}.note-signature i{left:28%;top:26%;transform:rotate(-20deg)}.note-cream{--note-bg:linear-gradient(135deg,#fff,#ffd8e8)}.note-cream i{left:22%;top:28%;width:58%;height:30%;border-radius:999px;background:#fff;box-shadow:0 22px 0 #f9d4e4,0 44px 0 #fff}.note-spark{--note-bg:linear-gradient(135deg,#e4d5ff,#cdeeff)}.note-spark i{left:35%;top:30%;background:#d9ff78;clip-path:polygon(50% 0,62% 36%,100% 50%,62% 64%,50% 100%,38% 64%,0 50%,38% 36%)}.suas-product-lane-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:24px}.suas-product-lane-grid article{border-radius:22px;padding:18px;background:linear-gradient(135deg,#fff,var(--blue))}.suas-product-lane-grid article:nth-child(2){background:linear-gradient(135deg,#fff,var(--pink))}.suas-product-lane-grid article:nth-child(3){background:linear-gradient(135deg,#fff,var(--lime))}.suas-product-lane-grid small{display:block;margin-bottom:7px;font-size:9px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.suas-product-lane-grid strong{font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(1.6rem,3vw,2.35rem);font-weight:700;line-height:.9;text-transform:lowercase}@media(max-width:820px){html body.template--product .suas-product-experience{width:min(430px,calc(100vw - 16px));margin-top:22px}.suas-note-grid{grid-template-columns:1fr;gap:13px}.suas-note-card{min-height:230px}.suas-product-lane-grid{grid-template-columns:1fr}.suas-window-strip b{font-size:7px;max-width:58%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.suas-product-description,.suas-product-description *{font-size:12px!important}.suas-note-head h2{font-size:clamp(2.55rem,13vw,4rem)}}
</style>

<section class="suas-product-experience" aria-label="SUAS product details">
  <div class="suas-product-vibe-card">
    <div class="suas-window-strip" aria-hidden="true"><span></span><span></span><span></span><b>formula file / {{ product.handle }}</b></div>
    <div class="suas-product-vibe-copy">
      <p class="suas-kicker">what it smells like</p>
      {% if product.description != blank %}
        <div class="suas-product-description rte">{{ product.description }}</div>
      {% else %}
        <p>{{ product.title }} is mixed for the SUAS world: handmade, playful, and made to layer into your daily routine.</p>
      {% endif %}
    </div>
  </div>

  <div class="suas-note-collection" id="scent-notes">
    <div class="suas-note-head">
      <p class="suas-kicker">star notes</p>
      <h2>smell it before it ships.</h2>
    </div>
    <div class="suas-note-grid">
      {% if desc_down contains 'coconut' %}{% assign has_notes = true %}<article class="suas-note-card note-coconut"><div class="suas-note-art"><i></i><b></b><em></em></div><span>creamy coconut</span></article>{% endif %}
      {% if desc_down contains 'jasmine' %}{% assign has_notes = true %}<article class="suas-note-card note-jasmine"><div class="suas-note-art"><i></i><b></b><em></em></div><span>jasmine blossom</span></article>{% endif %}
      {% if desc_down contains 'musk' %}{% assign has_notes = true %}<article class="suas-note-card note-musk"><div class="suas-note-art"><i></i><b></b><em></em></div><span>soft white musk</span></article>{% endif %}
      {% if desc_down contains 'ocean' or desc_down contains 'salty air' or desc_down contains 'sea' %}{% assign has_notes = true %}<article class="suas-note-card note-ocean"><div class="suas-note-art"><i></i><b></b><em></em></div><span>fresh ocean breeze</span></article>{% endif %}
      {% if desc_down contains 'vanilla' %}{% assign has_notes = true %}<article class="suas-note-card note-vanilla"><div class="suas-note-art"><i></i><b></b><em></em></div><span>vanilla</span></article>{% endif %}
      {% if desc_down contains 'amber' %}{% assign has_notes = true %}<article class="suas-note-card note-amber"><div class="suas-note-art"><i></i><b></b><em></em></div><span>amber</span></article>{% endif %}
      {% if desc_down contains 'lavender' %}{% assign has_notes = true %}<article class="suas-note-card note-lavender"><div class="suas-note-art"><i></i><b></b><em></em></div><span>lavender</span></article>{% endif %}
      {% if desc_down contains 'mandarin' %}{% assign has_notes = true %}<article class="suas-note-card note-mandarin"><div class="suas-note-art"><i></i><b></b><em></em></div><span>mandarin</span></article>{% endif %}
      {% if desc_down contains 'peach' %}{% assign has_notes = true %}<article class="suas-note-card note-peach"><div class="suas-note-art"><i></i><b></b><em></em></div><span>peach</span></article>{% endif %}
      {% if desc_down contains 'plum' %}{% assign has_notes = true %}<article class="suas-note-card note-plum"><div class="suas-note-art"><i></i><b></b><em></em></div><span>plum</span></article>{% endif %}
      {% if desc_down contains 'strawberry' %}{% assign has_notes = true %}<article class="suas-note-card note-strawberry"><div class="suas-note-art"><i></i><b></b><em></em></div><span>strawberry</span></article>{% endif %}
      {% if desc_down contains 'rose' %}{% assign has_notes = true %}<article class="suas-note-card note-rose"><div class="suas-note-art"><i></i><b></b><em></em></div><span>rose</span></article>{% endif %}
      {% if desc_down contains 'sandalwood' %}{% assign has_notes = true %}<article class="suas-note-card note-wood"><div class="suas-note-art"><i></i><b></b><em></em></div><span>sandalwood</span></article>{% endif %}
      {% if desc_down contains 'cedar' %}{% assign has_notes = true %}<article class="suas-note-card note-wood"><div class="suas-note-art"><i></i><b></b><em></em></div><span>cedarwood</span></article>{% endif %}
      {% if desc_down contains 'lemon' %}{% assign has_notes = true %}<article class="suas-note-card note-lemon"><div class="suas-note-art"><i></i><b></b><em></em></div><span>lemon</span></article>{% endif %}
      {% if desc_down contains 'mint' %}{% assign has_notes = true %}<article class="suas-note-card note-mint"><div class="suas-note-art"><i></i><b></b><em></em></div><span>mint</span></article>{% endif %}
      {% unless has_notes %}
        <article class="suas-note-card note-signature"><div class="suas-note-art"><i></i><b></b><em></em></div><span>signature blend</span></article>
        <article class="suas-note-card note-cream"><div class="suas-note-art"><i></i><b></b><em></em></div><span>soft finish</span></article>
        <article class="suas-note-card note-spark"><div class="suas-note-art"><i></i><b></b><em></em></div><span>made to layer</span></article>
      {% endunless %}
    </div>
  </div>

  <div class="suas-product-lane-grid">
    <article><small>texture</small><strong>{% if product_title_down contains 'butter' or desc_down contains 'butter' %}thick + creamy{% elsif product_title_down contains 'oil' %}glossy oil{% elsif product_title_down contains 'mist' %}air-light mist{% else %}small-batch finish{% endif %}</strong></article>
    <article><small>best for</small><strong>{% if product_title_down contains 'butter' %}after shower glow{% elsif product_title_down contains 'oil' %}body layering{% elsif product_title_down contains 'candle' %}room mood{% else %}daily ritual{% endif %}</strong></article>
    <article><small>made by</small><strong>SUAS CO.</strong></article>
  </div>
</section>
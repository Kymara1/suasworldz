{% comment %}
  SUAS.OS laptop open. Shows for first visit, then again only after 45 minutes away.
{% endcomment %}
{%- if suas_boot_slot == 'head' -%}
  <script>
    (function () {
      try {
        if (window.Shopify && Shopify.designMode) return;
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var path = String(location.pathname || '');
        if (/^\/(checkouts?|cart)(\/|$)/.test(path) || path.indexOf('/checkouts/') !== -1) return;
        var force = /(?:\?|&)boot=1(?:&|$)/.test(location.search);
        var key = 'suasOsSeenAt';
        var wait = 45 * 60 * 1000;
        var now = Date.now();
        var last = parseInt(localStorage.getItem(key) || '0', 10);
        var seenLately = last > 0 && (now - last) < wait;
        if (!force && seenLately) {
          localStorage.setItem(key, String(now));
          return;
        }
        localStorage.setItem(key, String(now));
        document.documentElement.classList.add('suas-booting');
      } catch (e) {}
    })();
  </script>
  <style>
    html.suas-booting,html.suas-booting body{overflow:hidden!important}
    html.suas-booting .suas-boot{display:grid!important}
  </style>
{%- elsif suas_boot_slot == 'body' -%}
  {%- unless request.design_mode -%}
  <div class="suas-boot" id="suas-boot" hidden aria-hidden="true">
    <style>
      .suas-boot{display:none;position:fixed;inset:0;z-index:2147483646;place-items:center;background:radial-gradient(circle at 50% 18%,rgba(255,216,232,.55),transparent 36%),radial-gradient(circle at 82% 80%,rgba(217,255,120,.28),transparent 30%),linear-gradient(180deg,#1a1714 0%,#2a241f 42%,#141210 100%);font-family:Futura,'Futura PT',Arial,sans-serif;color:#fffaf5}
      .suas-boot-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(255,250,245,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(255,250,245,.06) 1px,transparent 1px);background-size:28px 28px;opacity:.45;pointer-events:none}
      .suas-boot-skip{position:absolute;top:16px;right:16px;z-index:3;min-height:34px;padding:0 14px;border:2px solid #101010;border-radius:999px;background:#d9ff78;color:#101010;box-shadow:0 3px 0 #101010;font:900 9px/1 Futura,Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase;cursor:pointer}
      .suas-boot-stage{position:relative;z-index:1;width:min(860px,92vw);perspective:1600px}
      .suas-boot-laptop{position:relative;width:100%;transform-style:preserve-3d;transform:translateY(8%) scale(.92)}
      .suas-boot-lid{position:relative;width:100%;padding-top:62%;transform-origin:50% 100%;transform:rotateX(-102deg);transform-style:preserve-3d;transition:transform 1.5s cubic-bezier(.16,1,.3,1)}
      .suas-boot.is-open .suas-boot-lid{transform:rotateX(-12deg)}
      .suas-boot-bezel{position:absolute;inset:0;border:2px solid #101010;border-radius:18px 18px 8px 8px;background:linear-gradient(180deg,#2b2723,#161412);box-shadow:0 18px 40px rgba(0,0,0,.45),inset 0 1px 0 rgba(255,255,255,.12);overflow:hidden}
      .suas-boot-cam{position:absolute;top:8px;left:50%;width:8px;height:8px;border-radius:999px;background:#3a3530;transform:translateX(-50%);box-shadow:inset 0 0 0 2px #101010}
      .suas-boot-screen{position:absolute;inset:18px 16px 14px;border:2px solid #101010;border-radius:10px;background:#070707;overflow:hidden;display:grid;place-items:center;box-shadow:inset 0 0 0 1px rgba(255,250,245,.08)}
      .suas-boot-screen:before{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(255,255,255,.08),transparent 28%);pointer-events:none;opacity:.35}
      .suas-boot-crt{position:relative;z-index:1;display:grid;justify-items:center;gap:10px;text-align:center;padding:12px;opacity:0;transform:translateY(8px)}
      .suas-boot.is-lit .suas-boot-crt{opacity:1;transform:none;transition:opacity .55s ease,transform .55s ease}
      .suas-boot-logo{width:min(112px,28vw);height:min(112px,28vw);border-radius:999px;border:2px solid #101010;box-shadow:3px 4px 0 #101010;object-fit:contain;background:#000}
      html.suas-halloween .suas-boot-logo--core{display:none}
      html.suas-halloween .suas-boot-logo--season{display:block}
      .suas-boot-logo--season{display:none}
      .suas-boot-kicker{margin:0;font:900 9px/1 Futura,Arial,sans-serif;letter-spacing:.22em;text-transform:uppercase;color:#d9ff78}
      .suas-boot-title{margin:0;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(1.8rem,6vw,3.2rem);line-height:.86;text-transform:uppercase}
      .suas-boot-tag{margin:0;font:900 10px/1 Futura,Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#ffd8e8}
      .suas-boot-base{position:relative;margin-top:-2px;height:clamp(78px,14vw,118px);border:2px solid #101010;border-radius:0 0 22px 22px;background:linear-gradient(180deg,#ece7df,#cfc6b8 55%,#b7ae9f);box-shadow:0 22px 36px rgba(0,0,0,.4);transform:rotateX(18deg);transform-origin:top center}
      .suas-boot-keys{position:absolute;left:8%;right:8%;top:14%;height:42%;border-radius:8px;background:
        repeating-linear-gradient(90deg,#101010 0 2px,transparent 2px 18px),
        repeating-linear-gradient(#f6f1e8 0 10px,transparent 10px 14px);
        opacity:.55;box-shadow:inset 0 0 0 2px rgba(16,16,16,.25)}
      .suas-boot-pad{position:absolute;left:50%;bottom:12%;width:22%;height:28%;transform:translateX(-50%);border:2px solid #101010;border-radius:10px;background:#ddd6cb}
      .suas-boot-hinge{position:absolute;left:12%;right:12%;top:-7px;height:10px;border-radius:8px;background:#101010}
      .suas-boot.is-enter .suas-boot-laptop{transform:translateY(0) scale(1.38);transition:transform .9s cubic-bezier(.16,1,.3,1)}
      .suas-boot.is-gone{opacity:0;transition:opacity .5s ease;pointer-events:none}
      @media (max-width:749px){
        .suas-boot-stage{width:min(420px,94vw)}
        .suas-boot-lid{padding-top:70%}
        .suas-boot-logo{width:84px;height:84px}
        .suas-boot.is-enter .suas-boot-laptop{transform:translateY(-4%) scale(1.55)}
      }
      @media (prefers-reduced-motion:reduce){
        .suas-boot,.suas-boot-lid,.suas-boot-crt,.suas-boot-laptop{transition:none!important}
      }
    </style>
    <div class="suas-boot-grid" aria-hidden="true"></div>
    <button class="suas-boot-skip" type="button" data-suas-boot-skip>enter suas.os</button>
    <div class="suas-boot-stage">
      <div class="suas-boot-laptop">
        <div class="suas-boot-lid">
          <div class="suas-boot-bezel">
            <i class="suas-boot-cam" aria-hidden="true"></i>
            <div class="suas-boot-screen">
              <div class="suas-boot-crt">
                <img class="suas-boot-logo suas-boot-logo--core" src="{{ 'suas-logo.png' | asset_url }}" width="112" height="112" alt="">
                <img class="suas-boot-logo suas-boot-logo--season" src="{{ 'suas-logo-halloween.png' | asset_url }}" width="112" height="112" alt="">
                <p class="suas-boot-kicker">booting</p>
                <h2 class="suas-boot-title">suas.os</h2>
                <p class="suas-boot-tag">shut up &amp; smell</p>
              </div>
            </div>
          </div>
        </div>
        <div class="suas-boot-base">
          <i class="suas-boot-hinge" aria-hidden="true"></i>
          <i class="suas-boot-keys" aria-hidden="true"></i>
          <i class="suas-boot-pad" aria-hidden="true"></i>
        </div>
      </div>
    </div>
  </div>
  <script>
    (function () {
      var root = document.getElementById('suas-boot');
      if (!root || !document.documentElement.classList.contains('suas-booting')) return;
      var done = false;
      var timers = [];
      function later(fn, ms) { timers.push(setTimeout(fn, ms)); }
      function finish() {
        if (done) return;
        done = true;
        timers.forEach(function (id) { clearTimeout(id); });
        try { localStorage.setItem('suasOsSeenAt', String(Date.now())); } catch (e) {}
        root.classList.add('is-gone');
        later(function () {
          document.documentElement.classList.remove('suas-booting');
          root.setAttribute('hidden', '');
          root.setAttribute('aria-hidden', 'true');
          root.remove();
        }, 500);
      }
      root.removeAttribute('hidden');
      root.setAttribute('aria-hidden', 'false');
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          root.classList.add('is-open');
        });
      });
      later(function () { root.classList.add('is-lit'); }, 1100);
      later(function () { root.classList.add('is-enter'); }, 2300);
      later(finish, 3400);
      var skip = root.querySelector('[data-suas-boot-skip]');
      if (skip) {
        skip.addEventListener('click', finish);
        window.setTimeout(function () { skip.focus(); }, 30);
      }
      document.addEventListener('keydown', function (event) {
        if (!document.documentElement.classList.contains('suas-booting')) return;
        if (event.key === 'Escape') {
          event.preventDefault();
          finish();
          return;
        }
        if (event.key === 'Tab') {
          timers.forEach(function (id) { clearTimeout(id); });
          timers = [];
        }
      });
    })();
  </script>
  {%- endunless -%}
{%- endif -%}

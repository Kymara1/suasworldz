{% assign suas_roll_on_booking_product = all_products['lab-session-roll-on-perfume'] %}
{% if suas_roll_on_booking_product == blank %}{% assign suas_roll_on_booking_product = all_products['lab-session-add-on-10ml-roll-on-perfume-oil'] %}{% endif %}
{% if suas_roll_on_booking_product == blank %}{% assign suas_roll_on_booking_product = all_products['lab-session-roll-on'] %}{% endif %}
<script>
  window.suasRollOnBookingProduct = {% if suas_roll_on_booking_product != blank %}{{ suas_roll_on_booking_product | json }}{% else %}null{% endif %};
</script>
<style id="suas-booking-polish">
  html body .suas-bookings-page .suas-book-hours-grid p:first-child::after {
    content: "Walk-ins welcomed when a station is open.";
    display: block;
    margin-top: 8px;
    padding: 7px 9px;
    border: 2px solid #101010;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 3px 0 #101010;
    font-size: 10px;
    line-height: 1.1;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  html body .suas-bookings-page .suas-book-badge {
    margin-bottom: 12px !important;
  }

  html body .suas-bookings-page .suas-book-option h2 {
    margin-top: 12px !important;
    line-height: .94 !important;
  }

  html body .suas-bookings-page .suas-book-tab {
    min-height: 50px !important;
    transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease, color 160ms ease;
  }

  html body .suas-bookings-page .suas-book-tab.is-on {
    background: #101010 !important;
    color: #fff !important;
    box-shadow: 0 5px 0 #ff9fc2 !important;
    transform: none;
  }

  html body .suas-bookings-page .suas-type-card {
    transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease, color 160ms ease;
  }

  html body .suas-bookings-page .suas-type-card b {
    display: unset !important;
  }

  html body .suas-bookings-page .suas-type-card.is-on {
    border-color: #101010 !important;
    background: #101010 !important;
    color: #fff !important;
    box-shadow: 0 5px 0 #ff9fc2 !important;
    transform: none;
  }

  html body .suas-bookings-page .suas-type-card.is-on b {
    color: #d9ff78 !important;
  }

  html body .suas-bookings-page .suas-type-card.is-on em,
  html body .suas-bookings-page .suas-type-card.is-on strong,
  html body .suas-bookings-page .suas-type-card.is-on small {
    color: #fff !important;
    opacity: 1 !important;
  }

  html body .suas-bookings-page .suas-plus-choice button.is-on,
  html body .suas-bookings-page .suas-time-chips button.is-on {
    background: #101010 !important;
    color: #fff !important;
    box-shadow: 0 4px 0 #ff9fc2 !important;
  }

  html body .suas-side-icon,
  html body .suas-panel-icon {
    display: inline-grid !important;
    place-items: center !important;
    font-family: Futura, Arial, sans-serif !important;
    font-size: 15px !important;
    font-weight: 900 !important;
    line-height: 1 !important;
  }

  @media (max-width: 700px) {
    html body .suas-bookings-page .suas-book-wrap {
      width: min(440px, calc(100vw - 12px)) !important;
    }

    html body .suas-bookings-page .suas-book-top,
    html body .suas-bookings-page .suas-book-hours-grid,
    html body .suas-bookings-page .suas-book-option-head,
    html body .suas-bookings-page .suas-type-grid,
    html body .suas-bookings-page .suas-book-form,
    html body .suas-bookings-page .suas-plus-choice {
      grid-template-columns: 1fr !important;
    }

    html body .suas-bookings-page .suas-book-tabs {
      position: relative;
      top: auto;
      z-index: 1;
      padding: 6px;
      border: 2px solid #101010;
      border-radius: 22px;
      background: rgba(255,255,255,.92);
      box-shadow: none;
      overflow: hidden;
    }

    html body .suas-bookings-page .suas-book-tab {
      min-height: 44px !important;
      font-size: 10px !important;
      letter-spacing: .1em !important;
      padding: 0 8px !important;
      white-space: nowrap;
      overflow: hidden;
    }

    html body .suas-bookings-page .suas-book-tab,
    html body .suas-bookings-page .suas-book-button,
    html body .suas-bookings-page .suas-type-card,
    html body .suas-bookings-page .suas-time-chips button,
    html body .suas-bookings-page .suas-plus-choice button {
      min-height: 52px !important;
    }

    html body .suas-bookings-page .suas-book-option-head {
      gap: 12px !important;
    }

    html body .suas-bookings-page .suas-seat-meter,
    html body .suas-bookings-page .suas-book-price-card {
      width: 100% !important;
    }
  }
</style>

<script id="suas-booking-polish-script">
  (function () {
    function textOf(node) {
      return (node && node.textContent || '').replace(/\s+/g, ' ').trim();
    }

    function formatMoney(cents) {
      var value = Number(cents || 0) / 100;
      return '$' + value.toFixed(2);
    }

    function cuteMenuIcons() {
      var icons = {
        'BODY': '✿',
        'HOME': '⌂',
        'SCENT PROFILE': '✧',
        'ODDITIES': '☾',
        'THE LAB': '⚗',
        'ABOUT US': '♡',
        'VISIT US': '⌖'
      };

      document.querySelectorAll('.suas-side-link, .suas-panel-link').forEach(function (link) {
        var label = textOf(link.querySelector('.suas-side-label, .suas-panel-label')).toUpperCase();
        var icon = link.querySelector('.suas-side-icon, .suas-panel-icon');
        if (icon && icons[label]) icon.textContent = icons[label];
      });
    }

    function addRollOn(root, product) {
      var selfTypes = root.querySelector('[data-self-types]');
      var selfSelect = root.querySelector('#SelfExperience');
      if (!selfTypes || !selfSelect || !product || !product.variants || !product.variants.length || /roll-on|roll on/i.test(selfTypes.textContent)) return;
      var variant = product.variants.find(function (item) { return item.available !== false; }) || product.variants[0];
      if (!variant || !variant.id) return;
      var price = formatMoney(variant.price);
      var option = document.createElement('option');
      option.value = String(variant.id);
      option.dataset.experience = 'Lab Session: Roll-On Perfume (10mL)';
      option.dataset.price = price;
      option.textContent = 'Lab Session: Roll-On Perfume (10mL)';
      selfSelect.appendChild(option);

      var label = document.createElement('label');
      label.className = 'suas-type-card';
      label.innerHTML = '<input type="radio" name="_self_type" value="' + variant.id + '" data-label="Lab Session: Roll-On Perfume (10mL)" data-price="' + price + '" data-copy="Create a portable 10mL roll-on perfume oil."><em>02</em><strong>roll-on</strong><small>The roll-on perfume experiment.</small><b>' + price + '</b>';
      var combo = Array.prototype.slice.call(selfTypes.querySelectorAll('.suas-type-card')).find(function (card) { return /combo/i.test(card.textContent); });
      if (combo) selfTypes.insertBefore(label, combo);
      else selfTypes.appendChild(label);
    }

    function ensureRollOn(root) {
      addRollOn(root, window.suasRollOnBookingProduct);
      if (/roll-on|roll on/i.test((root.querySelector('[data-self-types]') || {}).textContent || '')) return;
      if (!window.fetch) return;
      window.fetch('/products/lab-session-add-on-10ml-roll-on-perfume-oil.js', { credentials: 'same-origin' })
        .then(function (response) { return response.ok ? response.json() : null; })
        .then(function (product) { addRollOn(root, product); })
        .catch(function () {});
    }

    function polishBookings() {
      var root = document.querySelector('.suas-bookings-page');
      if (!root) return;
      ensureRollOn(root);

      root.querySelectorAll('[data-book-tabs] .suas-book-tab').forEach(function (tab) {
        tab.setAttribute('aria-pressed', tab.classList.contains('is-on') ? 'true' : 'false');
        tab.addEventListener('click', function () {
          setTimeout(function () {
            root.querySelectorAll('[data-book-tabs] .suas-book-tab').forEach(function (item) {
              item.setAttribute('aria-pressed', item.classList.contains('is-on') ? 'true' : 'false');
            });
          }, 0);
        });
      });

      var guidedVariant = root.querySelector('#GuidedVariant');
      var guidedPrice = root.querySelector('[data-guided-price]');
      var guidedPriceProperty = root.querySelector('[data-guided-price-property]');
      var guidedTypes = root.querySelector('[data-guided-types]');

      function typeKey() {
        var checked = guidedTypes && guidedTypes.querySelector('input:checked');
        return checked ? checked.value : 'perfume';
      }

      function variantKind(title) {
        var value = String(title || '').toLowerCase();
        if (value.indexOf('signature') !== -1 || value.indexOf('deluxe') !== -1 || value.indexOf('all three') !== -1 || value.indexOf('150') !== -1) return 'signature';
        if (value.indexOf('body oil') !== -1 || value.indexOf('butter') !== -1 || value.indexOf('115') !== -1 || value.indexOf('+') !== -1) return 'plus';
        return 'perfume';
      }

      function syncGuidedProductPrice() {
        if (!guidedVariant || !guidedPrice) return;
        var wanted = typeKey();
        var options = Array.prototype.slice.call(guidedVariant.options).filter(function (option) {
          return option.value && !option.disabled;
        });
        var match = options.find(function (option) {
          var kind = option.dataset.kind || variantKind(option.dataset.title || option.textContent);
          return kind === wanted;
        });
        if (!match) return;
        guidedVariant.value = match.value;
        if (match.dataset.price) {
          guidedPrice.textContent = match.dataset.price;
          if (guidedPriceProperty) guidedPriceProperty.value = match.dataset.price;
        }
      }

      if (guidedTypes) {
        guidedTypes.addEventListener('change', function () {
          setTimeout(syncGuidedProductPrice, 0);
        });
        guidedTypes.querySelectorAll('input').forEach(function (input) {
          input.addEventListener('click', function () { setTimeout(syncGuidedProductPrice, 0); });
        });
      }
      syncGuidedProductPrice();
    }

    function run() {
      cuteMenuIcons();
      polishBookings();
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
    else run();
    window.addEventListener('load', run);
    setTimeout(run, 500);
    setTimeout(run, 1500);
  })();
</script>

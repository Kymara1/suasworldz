{% comment %}
  Shared Bliss desktop + navy sheet for info/booking pages.
  Black titlebars. Round sheet. Does not recolor the rest of the shop.
{% endcomment %}
<style id="suas-os-page-chrome">
  .suas-os-page{
    --ink:#101010;
    --navy:#07162e;
    --lime:#d9ff78;
    --hot:#ff9bc4;
    --pink:#ffd8e8;
    --blue:#c9e7ff;
    --cream:#f4ecd4;
    box-sizing:border-box;
    padding:52px 14px 48px;
    min-height:calc(100vh - 36px);
    color:var(--ink);
    background:linear-gradient(180deg,#6ec4e8 0%,#9bd6ef 42%,#cfeef8 100%);
    font-family:Tahoma,Futura,Arial,sans-serif;
  }
  .suas-os-page *,.suas-os-page *::before,.suas-os-page *::after{box-sizing:border-box}
  .suas-os-sheet{
    width:min(1120px,100%);
    margin:0 auto;
    overflow:hidden;
    border:4px solid #101010;
    border-radius:32px;
    background:#0b1a36;
    box-shadow:0 22px 40px rgba(16,16,16,.28);
  }
  .suas-os-titlebar{
    display:grid;
    grid-template-columns:auto 1fr auto;
    align-items:center;
    gap:10px;
    min-height:38px;
    padding:7px 12px;
    background:#101010;
    color:#d9ff78;
  }
  .suas-os-titlebar b{
    font:900 11px/1 Tahoma,Arial,sans-serif;
    letter-spacing:.18em;
    text-align:center;
  }
  .suas-os-orb{
    width:18px;
    height:18px;
    border:1.5px solid #fff;
    border-radius:999px;
    background:radial-gradient(circle at 30% 30%,#fff,#d9ff78 42%,#101010);
  }
  .suas-os-winbtns{display:flex;gap:4px}
  .suas-os-winbtns i{
    display:block;
    width:14px;
    height:12px;
    border:0;
    background:#cdeeff;
    font-style:normal;
  }
  .suas-os-winbtns i:nth-child(2){background:#9fd4f0}
  .suas-os-winbtns i:nth-child(3){background:#ff5f57}
  .suas-os-sheet-body{padding:18px 22px 22px}
  .suas-os-page h1{
    margin:0 0 12px;
    color:var(--lime);
    font-family:'Casual Human',Futura,Arial,sans-serif;
    font-size:clamp(2.2rem,5vw,3.8rem);
    font-weight:400;
    line-height:.86;
    text-transform:uppercase;
  }
  @media(max-width:1023px){
    .suas-os-page{padding:18px 10px 36px}
  }
  .shopify-section:has(.suas-os-page){
    margin:0 !important;
    padding:0 !important;
    max-width:none !important;
  }
  .template--page:has(.suas-os-page) .layout--main-content{
    padding:0 !important;
    max-width:none !important;
    background:transparent !important;
  }
</style>

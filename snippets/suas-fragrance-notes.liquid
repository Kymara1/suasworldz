{%- comment -%}
Generated from ops/config/retail-fragrance-notes.json. Do not hand-edit.
Sets mix_1/2/3 (hero notes), suas_all_notes, suas_feel for the current product.
Use {% include "suas-fragrance-notes" %} so assigns leak into the parent.
{%- endcomment -%}
{%- liquid
  assign suas_all_notes = blank
  assign suas_feel = blank
  assign suas_has_notes = false
-%}
{%- case product.handle -%}
  {%- when 'summit-cologne' -%}
    {%- liquid
      assign mix_1 = 'lemon'
      assign mix_2 = 'mandarin'
      assign mix_3 = 'bergamot'
      assign mix_1_note = 'top'
      assign mix_2_note = 'heart'
      assign mix_3_note = 'base'
      assign suas_all_notes = 'lemon x mandarin x bergamot x juniper berries x pepper x lavender x sandalwood x vetiver x cedarwood'
      assign suas_feel = 'fresh, citrusy, woody'
      assign suas_has_notes = true
    -%}
  {%- when 'sovereign-cologne' -%}
    {%- liquid
      assign mix_1 = 'bergamot'
      assign mix_2 = 'ginger'
      assign mix_3 = 'grapefruit'
      assign mix_1_note = 'top'
      assign mix_2_note = 'heart'
      assign mix_3_note = 'base'
      assign suas_all_notes = 'bergamot x ginger x grapefruit x cardamom x cinnamon x pineapple x labdanum x vetiver x patchouli'
      assign suas_feel = 'fruity, spicy, woody'
      assign suas_has_notes = true
    -%}
  {%- when 'renegade-cologne' -%}
    {%- liquid
      assign mix_1 = 'calabrian bergamot'
      assign mix_2 = 'bourbon geranium'
      assign mix_3 = 'ambery woods'
      assign mix_1_note = 'top'
      assign mix_2_note = 'heart'
      assign mix_3_note = 'base'
      assign suas_all_notes = 'calabrian bergamot x bourbon geranium x ambery woods'
      assign suas_feel = 'fresh, aromatic, warm'
      assign suas_has_notes = true
    -%}
  {%- when 'bare-eau-de-parfum' -%}

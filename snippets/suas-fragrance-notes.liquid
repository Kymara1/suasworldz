{%- comment -%}
Generated from ops/config/retail-fragrance-notes.json. Do not hand-edit.
Render + capture in parent:
  {% capture suas_fn_pack %}{% render "suas-fragrance-notes", product: product %}{% endcapture %}
Pack format: mix1^^^mix2^^^mix3^^^all notes^^^feel
{%- endcomment -%}
{%- liquid
  assign _m1 = blank
  assign _m2 = blank
  assign _m3 = blank
  assign _all = blank
  assign _feel = blank
  case product.handle
    when 'summit-cologne'
      assign _m1 = 'lemon'
      assign _m2 = 'cedar'
      assign _m3 = 'clean air'
      assign _all = 'lemon x cedar x clean air'
      assign _feel = 'fresh, citrusy, woody'
    when 'sovereign-cologne'
      assign _m1 = 'citrus'
      assign _m2 = 'spice'
      assign _m3 = 'woods'
      assign _all = 'citrus x spice x woods'
      assign _feel = 'fruity, spicy, woody'
    when 'renegade-cologne'
      assign _m1 = 'bergamot'
      assign _m2 = 'geranium'
      assign _m3 = 'warm woods'
      assign _all = 'bergamot x geranium x warm woods'
      assign _feel = 'fresh, aromatic, warm'
    when 'caspian-cologne'
      assign _m1 = 'grapefruit'
      assign _m2 = 'marine'
      assign _m3 = 'oakmoss'
      assign _all = 'grapefruit x marine x oakmoss'
      assign _feel = 'fresh, marine, woody'
    when 'bare-eau-de-parfum'
      assign _m1 = 'clean musk'
      assign _m2 = 'soft skin'
      assign _m3 = 'powder'
      assign _all = 'clean musk x soft skin x powder'
      assign _feel = 'clean, musky, powdery'
    when 'temptress-eau-de-parfum'
      assign _m1 = 'tuberose'
      assign _m2 = 'honey'
      assign _m3 = 'spice'
      assign _all = 'tuberose x honey x spice'
      assign _feel = 'rich, spicy, floral'
    when 'after-dark-cologne'
      assign _m1 = 'vanilla'
      assign _m2 = 'ginger'
      assign _m3 = 'smoke'
      assign _all = 'vanilla x ginger x smoke'
      assign _feel = 'warm, spicy, sensual'
    when 'devotion-eau-de-parfum'
      assign _m1 = 'vanilla'
      assign _m2 = 'cacao'
      assign _m3 = 'lavender'
      assign _all = 'vanilla x cacao x lavender'
      assign _feel = 'sweet, creamy, aromatic'
    when 'shocking-ice-eau-de-parfum'
      assign _m1 = 'cool citrus'
      assign _m2 = 'clean woods'
      assign _m3 = 'soft musk'
      assign _all = 'cool citrus x clean woods x soft musk'
      assign _feel = 'icy, refreshing'
    when 'pyro-pistachio-eau-de-parfum'
      assign _m1 = 'pistachio'
      assign _m2 = 'marshmallow smoke'
      assign _m3 = 'cacao'
      assign _all = 'pistachio x marshmallow smoke x cacao'
      assign _feel = 'sweet, nutty, creamy'
    when 'gelato-eau-de-parfum'
      assign _m1 = 'pistachio cream'
      assign _m2 = 'hazelnut'
      assign _m3 = 'soft florals'
      assign _all = 'pistachio cream x hazelnut x soft florals'
      assign _feel = 'sweet, creamy, floral'
    when 'dulce-eau-de-parfum'
      assign _m1 = 'caramel'
      assign _m2 = 'vanilla'
      assign _m3 = 'brown sugar'
      assign _all = 'caramel x vanilla x brown sugar'
      assign _feel = 'sweet, bakery, creamy'
    when 'good-girl-eau-de-parfum'
      assign _m1 = 'vanilla'
      assign _m2 = 'caramel'
      assign _m3 = 'coconut'
      assign _all = 'vanilla x caramel x coconut'
      assign _feel = 'warm, sweet, tropical'
    when 'nectar-eau-de-parfum'
      assign _m1 = 'pineapple'
      assign _m2 = 'passionfruit'
      assign _m3 = 'tropical juice'
      assign _all = 'pineapple x passionfruit x tropical juice'
      assign _feel = 'juicy, fruity, tropical'
  endcase
-%}
{%- if _all != blank or _m1 != blank -%}{{ _m1 }}^^^{{ _m2 }}^^^{{ _m3 }}^^^{{ _all }}^^^{{ _feel }}{%- endif -%}

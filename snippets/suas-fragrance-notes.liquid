{%- comment -%}
Generated from ops/config/retail-fragrance-notes.json. Do not hand-edit.
Render + capture in parent:
  {% capture suas_fn_pack %}{% render "suas-fragrance-notes", product: product %}{% endcapture %}
Pack format: mix1^^^mix2^^^mix3^^^all notes^^^feel
{%- endcomment -%}
{%- liquid
  assign _m1 = blank
  assign _m2 = blank
  assign _m3 = blank
  assign _all = blank
  assign _feel = blank
  case product.handle
    when 'summit-cologne'
      assign _m1 = 'lemon'
      assign _m2 = 'mandarin'
      assign _m3 = 'bergamot'
      assign _all = 'lemon x mandarin x bergamot x juniper berries x pepper x lavender x sandalwood x vetiver x cedarwood'
      assign _feel = 'fresh, citrusy, woody'
    when 'sovereign-cologne'
      assign _m1 = 'bergamot'
      assign _m2 = 'ginger'
      assign _m3 = 'grapefruit'
      assign _all = 'bergamot x ginger x grapefruit x cardamom x cinnamon x pineapple x labdanum x vetiver x patchouli'
      assign _feel = 'fruity, spicy, woody'
    when 'renegade-cologne'
      assign _m1 = 'calabrian bergamot'
      assign _m2 = 'bourbon geranium'
      assign _m3 = 'ambery woods'
      assign _all = 'calabrian bergamot x bourbon geranium x ambery woods'
      assign _feel = 'fresh, aromatic, warm'
    when 'bare-eau-de-parfum'
      assign _m1 = 'musk'
      assign _m2 = 'aldehydes'
      assign _m3 = 'ambergris'
      assign _all = 'musk x aldehydes x ambergris x lily-of-the-valley x rose x patchouli x cedar x vetiver'
      assign _feel = 'clean, musky, powdery'
    when 'temptress-eau-de-parfum'
      assign _m1 = 'coriander'
      assign _m2 = 'tuberose'
      assign _m3 = 'opoponax'
      assign _all = 'coriander x tuberose x opoponax x honey x musk'
      assign _feel = 'rich, spicy, floral'
    when 'after-dark-cologne'
      assign _m1 = 'vanilla bourbon'
      assign _m2 = 'ginger'
      assign _m3 = 'lavandin'
      assign _all = 'vanilla bourbon x ginger x lavandin x nutmeg x smoked vetiver'
      assign _feel = 'warm, spicy, sensual'
    when 'devotion-eau-de-parfum'
      assign _m1 = 'vanilla'
      assign _m2 = 'lavender'
      assign _m3 = 'cacao'
      assign _all = 'vanilla x lavender x cacao x ginger x vanilla caviar x vanilla absolute'
      assign _feel = 'sweet, creamy, aromatic'
    when 'shocking-ice-eau-de-parfum'
      assign _m1 = 'cool'
      assign _m2 = 'icy'
      assign _m3 = 'refreshing'
      assign _all = 'cool, fresh aromatic notes'
      assign _feel = 'icy, refreshing'
    when 'pyro-pistachio-eau-de-parfum'
      assign _m1 = 'pistachio'
      assign _m2 = 'sweet'
      assign _m3 = 'nutty'
      assign _all = 'pistachio'
      assign _feel = 'sweet, nutty, creamy'
    when 'good-girl-eau-de-parfum'
      assign _m1 = 'vanilla'
      assign _m2 = 'caramel'
      assign _m3 = 'coconut'
      assign _all = 'vanilla x caramel x coconut x amber'
      assign _feel = 'warm, sweet, tropical'
    when 'nectar-eau-de-parfum'
      assign _m1 = 'pineapple'
      assign _m2 = 'passionfruit'
      assign _m3 = 'juicy'
      assign _all = 'pineapple x passionfruit'
      assign _feel = 'juicy, fruity, tropical'
  endcase
-%}
{%- if _all != blank or _m1 != blank -%}{{ _m1 }}^^^{{ _m2 }}^^^{{ _m3 }}^^^{{ _all }}^^^{{ _feel }}{%- endif -%}

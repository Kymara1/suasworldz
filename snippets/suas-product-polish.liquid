<style>
  @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman.otf' | asset_url }}) format('opentype');font-display:swap}
  @font-face{font-family:'Casual Human';src:url({{ 'CasualHuman-Bold.otf' | asset_url }}) format('opentype');font-weight:700;font-display:swap}

  .product-page--root{--suas-ink:#101010;--suas-pink:#ffd8e8;--suas-blue:#cdeeff;--suas-yellow:#fff1a8;--suas-green:#d9ff78;width:min(1120px,calc(100vw - 36px))!important;margin:clamp(18px,3vw,42px) auto!important;background:transparent!important;color:var(--suas-ink)!important}
  .product-page--top-panel,.product-page--content,.product-page--single-column{background:transparent!important;width:100%!important;max-width:100%!important;padding:0!important;margin-inline:auto!important}
  .product-page--panel-wrapper{display:grid!important;grid-template-columns:minmax(280px,520px) minmax(300px,440px)!important;gap:clamp(18px,3vw,36px)!important;align-items:start!important;justify-content:center!important;width:100%!important;max-width:100%!important;margin:0 auto!important}
  .product-page--featured-media,.product-page--featured-blocks{border:2px solid var(--suas-ink)!important;border-radius:24px!important;background:#fff!important;box-shadow:8px 10px 0 var(--suas-ink)!important;overflow:hidden!important}
  .product-page--featured-media{padding:clamp(14px,2vw,24px)!important;display:flex!important;align-items:center!important;justify-content:center!important;min-height:0!important;aspect-ratio:1/1!important}
  .product-page--featured-media img,.product-page--featured-media .image--root img{width:100%!important;height:100%!important;max-width:430px!important;max-height:430px!important;object-fit:cover!important;border-radius:18px!important;display:block!important;margin:auto!important}
  .product-page--featured-blocks{padding:clamp(16px,2.4vw,26px)!important;width:100%!important;max-width:440px!important;justify-self:start!important}
  .product-page--block{margin:0 0 12px!important}
  .product-page--heading{font-family:'Casual Human',Futura,Arial,sans-serif!important;font-weight:400!important;letter-spacing:0!important;text-transform:uppercase!important;font-size:clamp(2.15rem,4.2vw,4rem)!important;line-height:.86!important;margin:0 0 12px!important;color:var(--suas-ink)!important;overflow-wrap:anywhere!important}
  .product-page--heading .asrv-star-widget,.product-page--heading [class*='star']{display:inline-flex!important;vertical-align:middle!important;transform:scale(.78)!important;transform-origin:left center!important}
  .product-page--featured-blocks p,.product-page--featured-blocks li,.product-page--featured-blocks div:not(.product-page--heading){font-family:Futura,'Futura PT',Arial,sans-serif!important;font-size:12px!important;line-height:1.45!important;color:var(--suas-ink)!important}
  .product-price--root,.product-price--wrapper,.product-page--price{font:900 17px/1 Futura,Arial,sans-serif!important;letter-spacing:.04em!important;color:var(--suas-ink)!important;margin:10px 0!important}
  .product-page--featured-blocks button,.product-page--featured-blocks .shopify-payment-button__button,.product-page--featured-blocks [type='submit'],.product-page--featured-blocks a.button{border:2px solid var(--suas-ink)!important;border-radius:999px!important;box-shadow:0 5px 0 var(--suas-ink)!important;min-height:38px!important;font:900 10px/1 Futura,Arial,sans-serif!important;letter-spacing:.16em!important;text-transform:uppercase!important;text-decoration:none!important}
  .product-page--featured-blocks [type='submit'],.product-page--featured-blocks button[name='add']{background:var(--suas-pink)!important;color:var(--suas-ink)!important}
  .product-page--featured-blocks .shopify-payment-button__button{background:#311858!important;color:#fff!important}
  .product-page--featured-blocks button:hover,.product-page--featured-blocks .shopify-payment-button__button:hover,.product-page--featured-blocks [type='submit']:hover{transform:translateY(2px)!important;box-shadow:0 3px 0 var(--suas-ink)!important}
  .product-page--description,[data-block-type='description'],[data-block-type*='tabs_product_descriptions']{border-top:1px dashed rgba(16,16,16,.24)!important;padding-top:12px!important;margin-top:10px!important;max-height:300px!important;overflow:auto!important;scrollbar-width:thin!important}
  .product-page--description p,.product-page--description li,[data-block-type*='tabs_product_descriptions'] p,[data-block-type*='tabs_product_descriptions'] li{font-size:11.5px!important;line-height:1.5!important;font-weight:600!important}
  .product-page--media-variant{width:min(520px,100%)!important;margin:22px auto!important;border:2px solid var(--suas-ink)!important;border-radius:24px!important;background:#fff!important;box-shadow:7px 8px 0 var(--suas-ink)!important;padding:14px!important}
  .product-page--media-variant img{max-height:390px!important;object-fit:contain!important;border-radius:16px!important}

  .product-page--root + .shopify-section,.shopify-section:has([class*='aftership']),.shopify-section:has([class*='automizely']),.shopify-section:has([class*='asrv']),.shopify-section:has([id*='aftership']),.shopify-section:has([id*='automizely']){width:min(1040px,calc(100vw - 36px))!important;margin:clamp(24px,4vw,54px) auto!important;padding:0!important;background:transparent!important}
  .shopify-section:has([class*='aftership'])::before,.shopify-section:has([class*='automizely'])::before,.shopify-section:has([class*='asrv'])::before,.shopify-section:has([id*='aftership'])::before,.shopify-section:has([id*='automizely'])::before{content:'product love notes.';display:block;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(2rem,4.5vw,3.7rem);line-height:.9;text-align:center;margin:0 0 16px;color:#101010;text-transform:uppercase}
  .shopify-section:has([class*='aftership']) .shopify-app-block,.shopify-section:has([class*='automizely']) .shopify-app-block,.shopify-section:has([class*='asrv']) .shopify-app-block,.shopify-section:has([id*='aftership']) .shopify-app-block,.shopify-section:has([id*='automizely']) .shopify-app-block{border:2px solid #101010!important;border-radius:24px!important;background:linear-gradient(rgba(16,16,16,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(16,16,16,.03) 1px,transparent 1px),radial-gradient(circle at 8% 20%,rgba(255,216,232,.82),transparent 30%),radial-gradient(circle at 90% 74%,rgba(217,255,120,.42),transparent 30%),#fff!important;background-size:20px 20px,20px 20px,auto,auto,auto!important;box-shadow:7px 8px 0 #101010!important;padding:clamp(14px,2vw,22px)!important;min-height:220px!important;overflow:hidden!important}
  .shopify-section:has([class*='aftership']) iframe,.shopify-section:has([class*='automizely']) iframe,.shopify-section:has([class*='asrv']) iframe,.shopify-section:has([id*='aftership']) iframe,.shopify-section:has([id*='automizely']) iframe{width:100%!important;min-height:360px!important;border:0!important;border-radius:18px!important;background:#fff!important}

  @media(max-width:749px){
    .product-page--root{width:min(430px,calc(100vw - 16px))!important;margin:14px auto 26px!important}
    .product-page--panel-wrapper{grid-template-columns:1fr!important;gap:14px!important}
    .product-page--featured-media,.product-page--featured-blocks{border-radius:20px!important;box-shadow:5px 6px 0 #101010!important}
    .product-page--featured-media{padding:11px!important;aspect-ratio:1/1!important}.product-page--featured-media img,.product-page--featured-media .image--root img{max-width:100%!important;max-height:320px!important}
    .product-page--featured-blocks{max-width:100%!important;padding:15px!important;justify-self:stretch!important}
    .product-page--heading{font-size:clamp(1.9rem,12vw,3rem)!important;line-height:.86!important;margin-bottom:10px!important}
    .product-page--featured-blocks p,.product-page--featured-blocks li,.product-page--featured-blocks div:not(.product-page--heading){font-size:11px!important;line-height:1.38!important}
    .product-page--description,[data-block-type='description'],[data-block-type*='tabs_product_descriptions']{max-height:250px!important}
    .product-page--media-variant{width:100%!important;border-radius:20px!important;box-shadow:5px 6px 0 #101010!important;padding:10px!important;margin:16px auto!important}
    .product-page--root + .shopify-section,.shopify-section:has([class*='aftership']),.shopify-section:has([class*='automizely']),.shopify-section:has([class*='asrv']),.shopify-section:has([id*='aftership']),.shopify-section:has([id*='automizely']){width:min(430px,calc(100vw - 16px))!important;margin:20px auto!important}
    .shopify-section:has([class*='aftership'])::before,.shopify-section:has([class*='automizely'])::before,.shopify-section:has([class*='asrv'])::before,.shopify-section:has([id*='aftership'])::before,.shopify-section:has([id*='automizely'])::before{font-size:clamp(2rem,11vw,2.9rem)!important;margin-bottom:12px!important}
    .shopify-section:has([class*='aftership']) .shopify-app-block,.shopify-section:has([class*='automizely']) .shopify-app-block,.shopify-section:has([class*='asrv']) .shopify-app-block,.shopify-section:has([id*='aftership']) .shopify-app-block,.shopify-section:has([id*='automizely']) .shopify-app-block{border-radius:20px!important;box-shadow:5px 6px 0 #101010!important;padding:12px!important}
    .shopify-section:has([class*='aftership']) iframe,.shopify-section:has([class*='automizely']) iframe,.shopify-section:has([class*='asrv']) iframe,.shopify-section:has([id*='aftership']) iframe,.shopify-section:has([id*='automizely']) iframe{min-height:420px!important}
  }
</style>
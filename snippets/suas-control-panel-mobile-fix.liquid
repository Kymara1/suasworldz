<style>
  @media only screen and (max-width: 1023px) {
    body .suas-side-rail {
      overflow: visible !important;
    }

    body .suas-side-nav {
      align-items: center !important;
      padding-bottom: 8px !important;
      overflow-x: auto !important;
      overflow-y: visible !important;
    }

    body .suas-side-dropdown {
      position: static !important;
      flex: 0 0 auto !important;
      width: auto !important;
      max-width: none !important;
    }

    body .suas-side-dropdown > summary.suas-side-link {
      width: auto !important;
      min-width: 112px !important;
      max-width: none !important;
      display: inline-grid !important;
      grid-template-columns: 26px auto !important;
      gap: 8px !important;
      padding: 8px 14px 8px 9px !important;
      border-radius: 999px !important;
      white-space: nowrap !important;
    }

    body .suas-side-dropdown[open] > summary.suas-side-link {
      min-height: 42px !important;
      margin: 0 !important;
      color: #101010 !important;
      background: #ffd8e8 !important;
      box-shadow: 0 4px 0 rgba(16, 16, 16, 0.18) !important;
    }

    body .suas-side-dropdown[open] > summary .suas-side-icon {
      background: rgba(255, 255, 255, 0.62) !important;
    }

    body .suas-side-dropdown[open] .suas-panel-submenu {
      position: fixed !important;
      top: 128px !important;
      left: 14px !important;
      right: 14px !important;
      z-index: 999 !important;
      display: grid !important;
      grid-template-columns: 1fr !important;
      gap: 10px !important;
      max-height: min(58vh, 420px) !important;
      overflow-y: auto !important;
      margin: 0 !important;
      padding: 14px !important;
      border: 1px solid rgba(16, 16, 16, 0.14) !important;
      border-radius: 24px !important;
      background: rgba(255, 255, 255, 0.98) !important;
      box-shadow: 0 22px 42px -24px rgba(16, 16, 16, 0.55) !important;
      backdrop-filter: blur(16px) !important;
      -webkit-overflow-scrolling: touch !important;
    }

    body .suas-side-dropdown .suas-panel-submenu a {
      min-height: 46px !important;
      justify-content: center !important;
      text-align: center !important;
      white-space: normal !important;
      font-size: 1.12rem !important;
      line-height: 1.05 !important;
      padding: 11px 16px !important;
      border: 1px solid rgba(16, 16, 16, 0.1) !important;
      background: linear-gradient(180deg, #fff 0%, #ffe4ef 145%) !important;
      box-shadow: 0 4px 0 rgba(16, 16, 16, 0.1) !important;
    }
  }

  @media only screen and (max-width: 390px) {
    body .suas-side-dropdown[open] .suas-panel-submenu {
      top: 122px !important;
      left: 10px !important;
      right: 10px !important;
      max-height: 56vh !important;
      padding: 12px !important;
    }

    body .suas-side-dropdown .suas-panel-submenu a {
      font-size: 1rem !important;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.addEventListener('toggle', function (event) {
      var opened = event.target;
      if (!opened.matches || !opened.matches('.suas-side-dropdown[open]')) return;

      document.querySelectorAll('.suas-side-dropdown[open]').forEach(function (dropdown) {
        if (dropdown !== opened) dropdown.removeAttribute('open');
      });
    }, true);
  });
</script>

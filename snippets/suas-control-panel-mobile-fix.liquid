  body .suas-bookings-page .suas-booking-date-error{display:none!important;margin-top:8px!important;padding:9px 12px!important;border:1.5px solid #101010!important;border-radius:999px!important;background:#ffd8e8!important;color:#101010!important;font:800 11px/1.2 Futura,Arial,sans-serif!important;box-shadow:0 3px 0 rgba(16,16,16,.18)!important}
  body .suas-bookings-page .suas-booking-date-error.is-visible{display:block!important}
  @media only screen and (max-width:1023px){
    body .suas-bookings-page .suas-book-wrap{width:min(100% - 14px,760px)!important;padding:14px 0 34px!important}
    body .suas-bookings-page .suas-book-hero{grid-template-columns:1fr!important;gap:9px!important}
    body .suas-bookings-page .suas-book-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:8px!important}
    body .suas-bookings-page .suas-book-option{padding:10px!important;border-radius:16px!important}
    body .suas-bookings-page .suas-book-option h2{font-size:clamp(1rem,5vw,1.45rem)!important;line-height:.9!important}
    body .suas-bookings-page .suas-book-desc{font-size:9px!important;line-height:1.25!important}
    body .suas-bookings-page .suas-book-form{grid-template-columns:1fr!important;gap:6px!important}
    body .suas-bookings-page .suas-book-input,body .suas-bookings-page .suas-book-select{min-height:32px!important;font-size:10px!important}
    body .suas-side-rail{overflow:visible!important;padding-bottom:12px!important}
    body .suas-side-nav{display:flex!important;flex-wrap:wrap!important;align-items:flex-start!important;gap:8px!important;padding:2px 0 6px!important;overflow:visible!important}
    body .suas-side-nav>a.suas-side-link{display:none!important}
    body .suas-side-dropdown{position:relative!important;flex:1 1 calc(33.333% - 6px)!important;width:auto!important;min-width:96px!important;max-width:none!important}
    body .suas-side-dropdown>summary.suas-side-link{width:100%!important;min-width:0!important;display:grid!important;grid-template-columns:24px minmax(0,1fr)!important;gap:7px!important;padding:8px 9px!important;border-radius:999px!important;white-space:nowrap!important}
    body .suas-side-dropdown>summary .suas-side-label{overflow:hidden!important;text-overflow:ellipsis!important;white-space:nowrap!important}
    body .suas-side-dropdown[open]{flex:1 0 100%!important;order:99!important;width:100%!important;margin-top:4px!important}
    body .suas-side-dropdown[open]>summary.suas-side-link{width:fit-content!important;min-width:112px!important;min-height:40px!important;margin:0 auto 8px!important;color:#101010!important;background:#ffd8e8!important;box-shadow:0 4px 0 rgba(16,16,16,.18)!important}
    body .suas-side-dropdown[open] .suas-panel-submenu{position:static!important;display:grid!important;grid-template-columns:1fr!important;gap:8px!important;width:100%!important;max-height:48vh!important;overflow-y:auto!important;margin:0!important;padding:10px!important;border:1px solid rgba(16,16,16,.14)!important;border-radius:20px!important;background:rgba(255,255,255,.98)!important;box-shadow:0 16px 30px -22px rgba(16,16,16,.5)!important;-webkit-overflow-scrolling:touch!important}
    body .suas-side-dropdown .suas-panel-submenu a{min-height:40px!important;justify-content:center!important;text-align:center!important;white-space:normal!important;font-size:.98rem!important;line-height:1.05!important;padding:9px 12px!important;border:1px solid rgba(16,16,16,.1)!important;background:linear-gradient(180deg,#fff 0%,#ffe4ef 145%)!important;box-shadow:0 3px 0 rgba(16,16,16,.1)!important}
  }
  @media only screen and (max-width:390px){body .suas-bookings-page .suas-book-wrap{width:calc(100vw - 10px)!important}body .suas-bookings-page .suas-book-grid{gap:6px!important}body .suas-side-dropdown{min-width:90px!important}body .suas-side-dropdown[open] .suas-panel-submenu{max-height:44vh!important;padding:10px!important}body .suas-side-dropdown .suas-panel-submenu a{min-height:38px!important;font-size:.9rem!important}}
</style>
<script>
  document.addEventListener('DOMContentLoaded',function(){
    var aboutItems=[{title:'who are we',href:'/pages/about'},{title:'bookings',href:'/pages/bookings'},{title:'visit us',href:'/pages/visit-us'},{title:'contact us',href:'/pages/contact'},{title:'refund policy',href:'/policies/refund-policy'}];
    function dedupeQuickLaunch(){document.querySelectorAll('.suas-world-home .suas-launch-grid').forEach(function(grid){var seen={};Array.prototype.slice.call(grid.querySelectorAll('a')).forEach(function(link){var href=link.getAttribute('href')||'';if(seen[href])link.remove();else seen[href]=true})})}
    function addBookLabQuickLaunch(){var grid=document.querySelector('.suas-world-home .suas-launch-grid');if(!grid)return;dedupeQuickLaunch();if(grid.querySelector('a[href="/pages/bookings"]'))return;var link=document.createElement('a');link.className='suas-launch';link.href='/pages/bookings';link.style.setProperty('--launch','#d9ff78');link.innerHTML='<strong class="suas-font">book the lab</strong><span class="suas-mono">reserve</span>';grid.appendChild(link);dedupeQuickLaunch()}
    function buildMenu(items){var menu=document.createElement('div');menu.className='suas-panel-submenu';items.forEach(function(item){var child=document.createElement('a');child.href=item.href;child.textContent=item.title;menu.appendChild(child)});return menu}
    function addSideAboutMenu(){var nav=document.querySelector('.suas-side-nav');if(!nav||nav.querySelector('.suas-side-about-dropdown'))return;var details=document.createElement('details');details.className='suas-panel-dropdown suas-side-dropdown suas-side-about-dropdown';var summary=document.createElement('summary');summary.className='suas-side-link';summary.innerHTML='<span class="suas-side-icon" style="--tint: var(--suas-lav);">?</span><span class="suas-side-label">about us</span><span class="suas-side-num">08</span>';details.appendChild(summary);details.appendChild(buildMenu(aboutItems));nav.appendChild(details)}
    function addHomePanelAboutMenu(){var nav=document.querySelector('.suas-panel-nav');if(!nav||nav.querySelector('.suas-panel-about-dropdown'))return;var details=document.createElement('details');details.className='suas-panel-dropdown suas-home-panel-dropdown suas-panel-about-dropdown';var summary=document.createElement('summary');summary.className='suas-panel-link';summary.innerHTML='<span class="suas-panel-icon" style="--icon-bg: var(--violet);">?</span><span class="suas-panel-label">about us</span><span class="suas-panel-number">08</span>';details.appendChild(summary);details.appendChild(buildMenu(aboutItems));nav.appendChild(details)}
    addBookLabQuickLaunch();addSideAboutMenu();addHomePanelAboutMenu();
    document.addEventListener('toggle',function(event){var opened=event.target;if(!opened.matches||!opened.matches('.suas-side-dropdown[open]'))return;document.querySelectorAll('.suas-side-dropdown[open]').forEach(function(dropdown){if(dropdown!==opened)dropdown.removeAttribute('open')})},true);
  });
</script>

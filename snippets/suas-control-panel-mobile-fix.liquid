<script>
  document.addEventListener('DOMContentLoaded',function(){
    function cleanLabel(value){return String(value||'').toLowerCase().replace(/&amp;/g,'&').replace(/[^a-z0-9& ]+/g,' ').replace(/\b(menu|tab|category|categories|shop|launch)\b/g,'').replace(/\s+/g,' ').trim()}
    function quickKey(link){var strong=link.querySelector('strong');var raw=(strong?strong.textContent:link.textContent||'');return cleanLabel(raw)||((link.getAttribute('href')||'').replace(/\?.*$/,''))}
    function isFixedLaunch(grid){return grid&&grid.getAttribute('data-suas-fixed-launch')==='true'}
    function dedupeQuickLaunch(){document.querySelectorAll('.suas-world-home .suas-launch-grid').forEach(function(grid){if(isFixedLaunch(grid)){Array.prototype.slice.call(grid.querySelectorAll('a.suas-launch'),4).forEach(function(link){link.remove()});return}var seen={};Array.prototype.slice.call(grid.querySelectorAll('a')).forEach(function(link){var key=quickKey(link);if(seen[key])link.remove();else seen[key]=true})})}
    function ensureQuickLaunch(label,href,color,action){var grid=document.querySelector('.suas-world-home .suas-launch-grid');if(!grid||isFixedLaunch(grid))return;dedupeQuickLaunch();var exists=Array.prototype.some.call(grid.querySelectorAll('a'),function(link){return quickKey(link)===cleanLabel(label)});if(exists)return;var link=document.createElement('a');link.className='suas-launch';link.href=href;link.style.setProperty('--launch',color);link.innerHTML='<strong class="suas-font">'+label+'</strong><span class="suas-mono">'+action+'</span>';grid.appendChild(link);dedupeQuickLaunch()}
    function addBookLabQuickLaunch(){}
    function addCharmBarQuickLaunch(){}
    function itemLabel(item){var label=item.querySelector(':scope > .suas-side-label, :scope > summary > .suas-side-label, :scope > .suas-panel-label, :scope > summary > .suas-panel-label');return cleanLabel(label?label.textContent:item.getAttribute('data-suas-menu-title')||'')}
    function pruneSubmenus(){document.querySelectorAll('.suas-side-dropdown,.suas-panel-dropdown').forEach(function(dropdown){var parent=itemLabel(dropdown);var submenu=dropdown.querySelector('.suas-panel-submenu');if(!submenu)return;var hasVisit=false;Array.prototype.slice.call(submenu.querySelectorAll('a')).forEach(function(link){var child=cleanLabel(link.textContent);if(child==='visit us'||child==='visit')hasVisit=true;if(child&&parent&&child===parent)link.remove()});if(parent==='about us'&&!hasVisit){var visit=document.createElement('a');visit.href='/pages/visit-us';visit.textContent='Visit Us';submenu.appendChild(visit)}})}
    function setMobilePanelItems(){document.querySelectorAll('.suas-side-nav>a.suas-side-link,.suas-side-nav>.suas-side-dropdown').forEach(function(item){var label=itemLabel(item);if(/lab/.test(label)&&!/about/.test(label)){item.style.display='none';return}item.removeAttribute('data-suas-mobile-hidden');item.style.removeProperty('display')})}
    function dedupeControlPanel(selector){document.querySelectorAll(selector).forEach(function(nav){var seen={};Array.prototype.slice.call(nav.children).forEach(function(item){var label=itemLabel(item);var href=(item.querySelector('a[href],summary')||item).getAttribute('href')||label;if(seen[label+'|'+href])item.remove();else seen[label+'|'+href]=true})})}
    function bindHamburger(){
      var btn=document.querySelector('.suas-panel-toggle');
      var scrim=document.querySelector('.suas-panel-scrim');
      if(!btn||btn.dataset.suasBound==='true')return;
      btn.dataset.suasBound='true';
      function isOpen(){return document.documentElement.classList.contains('suas-panel-open')}
      function setOpen(next){
        document.documentElement.classList.toggle('suas-panel-open',next);
        btn.setAttribute('aria-expanded',next?'true':'false');
        btn.querySelector('.suas-panel-toggle-text').textContent=next?'close':'menu';
        if(scrim){if(next)scrim.removeAttribute('hidden');else scrim.setAttribute('hidden','')}
      }
      btn.addEventListener('click',function(){setOpen(!isOpen())});
      if(scrim)scrim.addEventListener('click',function(){setOpen(false)});
      document.addEventListener('keydown',function(event){if(event.key==='Escape')setOpen(false)});
      document.querySelectorAll('#suas-control-panel a').forEach(function(link){link.addEventListener('click',function(){setOpen(false)})});
    }
    function runFixes(){addBookLabQuickLaunch();addCharmBarQuickLaunch();dedupeControlPanel('.suas-side-nav');dedupeControlPanel('.suas-panel-nav');pruneSubmenus();setMobilePanelItems();bindHamburger()}
    runFixes();window.addEventListener('resize',setMobilePanelItems);
    document.addEventListener('toggle',function(event){var opened=event.target;if(!opened.matches||!opened.matches('.suas-side-dropdown[open]'))return;document.querySelectorAll('.suas-side-dropdown[open]').forEach(function(dropdown){if(dropdown!==opened)dropdown.removeAttribute('open')})},true);
  });
</script>

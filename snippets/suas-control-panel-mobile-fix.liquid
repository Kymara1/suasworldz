      white-space: normal !important;
      font-size: 1.05rem !important;
      line-height: 1.05 !important;
      padding: 10px 14px !important;
      border: 1px solid rgba(16, 16, 16, 0.1) !important;
      background: linear-gradient(180deg, #fff 0%, #ffe4ef 145%) !important;
      box-shadow: 0 4px 0 rgba(16, 16, 16, 0.1) !important;
    }
  }

  @media only screen and (max-width: 390px) {
    body .suas-side-dropdown {
      min-width: 90px !important;
    }

    body .suas-side-dropdown[open] .suas-panel-submenu {
      max-height: 44vh !important;
      padding: 10px !important;
    }

    body .suas-side-dropdown .suas-panel-submenu a {
      min-height: 42px !important;
      font-size: 0.96rem !important;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var aboutItems = [
      { title: 'who are we', href: '/pages/about' },
      { title: 'bookings', href: '/pages/bookings' },
      { title: 'contact us', href: '/pages/contact' },
      { title: 'refund policy', href: '/policies/refund-policy' }
    ];
    var guidedClosedDays = [0, 1, 2, 3];
    var guidedBookingMessage = 'Guided Deluxe classes are available Thursday, Friday, and Saturday only. Please choose an available class day.';
    var selfGuidedSchedule = {
      0: [{ start: '12:00', end: '17:00' }],
      4: [{ start: '12:00', end: '17:30' }],
      5: [{ start: '12:00', end: '17:30' }],
      6: [{ start: '12:00', end: '15:30' }]
    };
    var selfGuidedTimes = [
      { label: '12:00 PM', value: '12:00 PM estimated timeframe', minutes: 720 },
      { label: '1:00 PM', value: '1:00 PM estimated timeframe', minutes: 780 },
      { label: '2:00 PM', value: '2:00 PM estimated timeframe', minutes: 840 },
      { label: '3:00 PM', value: '3:00 PM estimated timeframe', minutes: 900 },
      { label: '4:00 PM', value: '4:00 PM estimated timeframe', minutes: 960 },
      { label: '5:00 PM', value: '5:00 PM estimated timeframe', minutes: 1020 }
    ];
    var selfGuidedDayMessage = 'Self-guided sessions are available Thursday, Friday, Saturday, and Sunday only.';
    var selfGuidedTimeMessage = 'Please choose an estimated self-guided time inside booking hours: Thu/Fri 12:00 PM - 5:30 PM, Sat 12:00 PM - 3:30 PM, Sun 12:00 PM - 5:00 PM.';

    function addBookLabQuickLaunch() {
      var grid = document.querySelector('.suas-world-home .suas-launch-grid');
      if (!grid || grid.querySelector('a[href="/pages/bookings"]')) return;

      var link = document.createElement('a');
      link.className = 'suas-launch';
      link.href = '/pages/bookings';
      link.style.setProperty('--launch', '#d9ff78');
      link.style.setProperty('--glow', '217,255,120');
      link.innerHTML = '<strong class="suas-font">book the lab</strong><span class="suas-mono">booking</span>';
      grid.appendChild(link);
    }

    function removeMobileQuickLaunchBodyHome() {
      var isMobileView = window.innerWidth <= 1023 || document.documentElement.clientWidth <= 1023;
      if (!isMobileView) return;

      document.querySelectorAll('.suas-world-home .suas-launch-grid > a[href="/collections/body-care"], .suas-world-home .suas-launch-grid > a[href="/collections/home-care"]').forEach(function (link) {
        link.remove();
      });
    }

    function getDateDay(value) {
      if (!value) return null;
      var parts = value.split('-').map(function (part) { return parseInt(part, 10); });
      if (parts.length !== 3 || parts.some(isNaN)) return null;
      return new Date(parts[0], parts[1] - 1, parts[2]).getDay();
    }

    function timeToMinutes(value) {
      if (!value) return null;
      var parts = value.split(':').map(function (part) { return parseInt(part, 10); });
      if (parts.length < 2 || parts.some(isNaN)) return null;
      return parts[0] * 60 + parts[1];
    }

    function isGuidedDateInput(input) {
      return input && input.name === 'properties[Class date]';
    }

    function getSelfGuidedDateInput(form) {
      return form ? form.querySelector('input[name="properties[Preferred date]"]') : null;
    }

    function getSelfGuidedTimeControls(form) {
      return form ? Array.prototype.slice.call(form.querySelectorAll('input[name="properties[Preferred time]"], select[name="properties[Preferred time]"]')) : [];
    }

    function getSelectedSelfGuidedTimeInput(form) {
      var controls = getSelfGuidedTimeControls(form);
      var select = controls.find(function (input) { return input.tagName === 'SELECT'; });
      if (select) return select;
      return controls.find(function (input) { return input.checked; }) || controls[0] || null;
    }

    function getSelfGuidedWindows(dateInput) {
      var day = getDateDay(dateInput && dateInput.value);
      return day === null ? [] : (selfGuidedSchedule[day] || []);
    }

    function getControlMinutes(input) {
      if (!input) return null;
      if (input.tagName === 'SELECT') {
        var option = input.options[input.selectedIndex];
        return option && option.dataset.minutes ? parseInt(option.dataset.minutes, 10) : null;
      }
      if (input.dataset && input.dataset.minutes) return parseInt(input.dataset.minutes, 10);
      return timeToMinutes(input.value);
    }

    function showBookingDateError(input, message) {
      var field = input.closest('.suas-book-field') || input.closest('.suas-field') || input.parentElement;
      if (!field) return;

      var error = field.querySelector('.suas-booking-date-error');
      if (!error) {
        error = document.createElement('div');
        error.className = 'suas-booking-date-error';
        error.setAttribute('role', 'alert');
        input.insertAdjacentElement('afterend', error);
      }

      error.textContent = message;
      error.classList.add('is-visible');
      window.clearTimeout(error._suasTimer);
      error._suasTimer = window.setTimeout(function () {
        error.classList.remove('is-visible');
      }, 7500);
    }

    function clearBookingDateError(input) {
      var field = input.closest('.suas-book-field') || input.closest('.suas-field') || input.parentElement;
      if (!field) return;
      var error = field.querySelector('.suas-booking-date-error');
      if (!error) return;
      error.classList.remove('is-visible');
    }

    function buildSelfGuidedTimePicker(form) {
      var timeInput = form.querySelector('input[type="time"][name="properties[Preferred time]"]');
      if (!timeInput || form.querySelector('.suas-self-time-select')) return;

      var field = timeInput.closest('.suas-book-field') || timeInput.parentElement;
      if (!field) return;

      field.classList.add('suas-estimated-time-field');
      field.setAttribute('data-wide', 'true');
      field.innerHTML = '<label class="suas-book-label">estimated arrival time</label>';

      var select = document.createElement('select');
      select.className = 'suas-book-select suas-self-time-select';
      select.name = 'properties[Preferred time]';
      select.required = true;

      var placeholder = document.createElement('option');
      placeholder.value = '';
      placeholder.textContent = 'choose estimated timeframe';
      select.appendChild(placeholder);

      selfGuidedTimes.forEach(function (slot) {
        var option = document.createElement('option');
        option.value = slot.value;
        option.textContent = slot.label + ' - estimated timeframe';
        option.dataset.minutes = slot.minutes;
        select.appendChild(option);
      });

      field.appendChild(select);
    }

    function syncSelfGuidedTimeRules(form) {
      var dateInput = getSelfGuidedDateInput(form);
      var controls = getSelfGuidedTimeControls(form);
      if (!dateInput || !controls.length) return;

      var windows = getSelfGuidedWindows(dateInput);
      controls.forEach(function (control) {
        control.required = true;
        if (control.type === 'time') {
          control.step = 900;
          if (!windows.length) {
            control.removeAttribute('min');
            control.removeAttribute('max');
            return;
          }
          control.min = windows[0].start;
          control.max = windows[0].end;
          return;
        }

        if (control.tagName === 'SELECT') {
          Array.prototype.slice.call(control.options).forEach(function (option) {
            if (!option.value) {
              option.disabled = false;
              return;
            }
            var minutes = option.dataset.minutes ? parseInt(option.dataset.minutes, 10) : null;
            var isOpen = windows.length ? windows.some(function (window) {
              return minutes >= timeToMinutes(window.start) && minutes <= timeToMinutes(window.end);
            }) : true;
            option.disabled = !isOpen;
          });

          if (control.selectedOptions.length && control.selectedOptions[0].disabled) control.value = '';
          return;
        }

        var minutes = getControlMinutes(control);
        var isOpen = windows.length ? windows.some(function (window) {
          return minutes >= timeToMinutes(window.start) && minutes <= timeToMinutes(window.end);
        }) : true;
        var slot = control.closest('.suas-slot');
        control.disabled = !isOpen;
        if (slot) slot.classList.toggle('is-full', !isOpen);
        if (!isOpen && control.checked) control.checked = false;
      });
    }

    function validateBookingDate(input, shouldClear) {
      if (!input || input.type !== 'date') return true;
      var form = input.closest('form');
      var day = getDateDay(input.value);
      if (day === null) {
        input.setCustomValidity('');
        clearBookingDateError(input);
        return true;
      }

      if (isGuidedDateInput(input)) {
        if (guidedClosedDays.indexOf(day) === -1) {
          input.setCustomValidity('');
          clearBookingDateError(input);
          return true;
        }

        input.setCustomValidity(guidedBookingMessage);
        showBookingDateError(input, guidedBookingMessage);
        input.reportValidity();
      } else {
        syncSelfGuidedTimeRules(form);
        if (selfGuidedSchedule[day]) {
          input.setCustomValidity('');
          clearBookingDateError(input);
          return true;
        }

        input.setCustomValidity(selfGuidedDayMessage);
        showBookingDateError(input, selfGuidedDayMessage);
        input.reportValidity();
      }

      if (shouldClear) {
        window.setTimeout(function () {
          input.value = '';
          input.setCustomValidity('');
          if (form) syncSelfGuidedTimeRules(form);
        }, 0);
      }
      return false;
    }

    function validateSelfGuidedTime(input, shouldClear) {
      if (!input || input.name !== 'properties[Preferred time]') return true;
      var form = input.closest('form');
      var dateInput = getSelfGuidedDateInput(form);
      if (!dateInput) return true;

      var selected = getSelectedSelfGuidedTimeInput(form);
      var windows = getSelfGuidedWindows(dateInput);
      if (!dateInput.value || !windows.length) {
        selected.setCustomValidity(selfGuidedDayMessage);
        showBookingDateError(selected, selfGuidedDayMessage);
        selected.reportValidity();
        return false;
      }

      if (!selected.value) {
        selected.setCustomValidity('Please choose an estimated self-guided booking time.');
        showBookingDateError(selected, 'Please choose an estimated self-guided booking time.');
        selected.reportValidity();
        return false;
      }

      var chosen = getControlMinutes(selected);
      if (chosen === null || isNaN(chosen)) {
        selected.setCustomValidity('Please choose an estimated self-guided booking time.');
        showBookingDateError(selected, 'Please choose an estimated self-guided booking time.');
        return false;
      }

      var isInWindow = windows.some(function (window) {
        return chosen >= timeToMinutes(window.start) && chosen <= timeToMinutes(window.end);
      });

      if (isInWindow && !selected.disabled) {
        getSelfGuidedTimeControls(form).forEach(function (control) { control.setCustomValidity(''); });
        clearBookingDateError(selected);
        return true;
      }

      selected.setCustomValidity(selfGuidedTimeMessage);
      showBookingDateError(selected, selfGuidedTimeMessage);
      selected.reportValidity();
      if (shouldClear) {
        window.setTimeout(function () {
          selected.value = '';
          selected.setCustomValidity('');
        }, 0);
      }
      return false;
    }

    function blockClosedBookingDates() {
      var page = document.querySelector('.suas-bookings-page');
      if (!page || page.dataset.closedDaysReady === 'true') return;
      page.dataset.closedDaysReady = 'true';

      page.querySelectorAll('form').forEach(function (form) {
        buildSelfGuidedTimePicker(form);
        syncSelfGuidedTimeRules(form);
      });

      page.querySelectorAll('input[type="date"]').forEach(function (input) {
        input.addEventListener('change', function () {
          validateBookingDate(input, true);
          var form = input.closest('form');
          syncSelfGuidedTimeRules(form);
          validateSelfGuidedTime(getSelectedSelfGuidedTimeInput(form), true);
        });
      });

      page.querySelectorAll('select[name="properties[Preferred time]"], input[name="properties[Preferred time]"]').forEach(function (input) {
        input.addEventListener('change', function () {
          validateSelfGuidedTime(input, true);
        });
      });

      page.querySelectorAll('form').forEach(function (form) {
        form.addEventListener('submit', function (event) {
          var datesAreOpen = true;
          form.querySelectorAll('input[type="date"]').forEach(function (input) {
            if (!validateBookingDate(input, false)) datesAreOpen = false;
          });
          var selfGuidedTime = getSelectedSelfGuidedTimeInput(form);
          if (selfGuidedTime && !validateSelfGuidedTime(selfGuidedTime, false)) datesAreOpen = false;
          if (!datesAreOpen) event.preventDefault();
        });
      });
    }

    function buildMenu(items) {
      var menu = document.createElement('div');
      menu.className = 'suas-panel-submenu';
      items.forEach(function (item) {
        var child = document.createElement('a');
        child.href = item.href;
        child.textContent = item.title;
        menu.appendChild(child);
      });
      return menu;
    }

    function addSideAboutMenu() {
      var nav = document.querySelector('.suas-side-nav');
      if (!nav || nav.querySelector('.suas-side-about-dropdown')) return;

      var details = document.createElement('details');
      details.className = 'suas-panel-dropdown suas-side-dropdown suas-side-about-dropdown';

      var summary = document.createElement('summary');
      summary.className = 'suas-side-link';
      summary.innerHTML = '<span class="suas-side-icon" style="--tint: var(--suas-lav);">?</span><span class="suas-side-label">about us</span><span class="suas-side-num">08</span>';

      details.appendChild(summary);
      details.appendChild(buildMenu(aboutItems));
      nav.appendChild(details);
    }

    function addHomePanelAboutMenu() {
      var nav = document.querySelector('.suas-panel-nav');
      if (!nav || nav.querySelector('.suas-panel-about-dropdown')) return;

      var details = document.createElement('details');
      details.className = 'suas-panel-dropdown suas-home-panel-dropdown suas-panel-about-dropdown';

      var summary = document.createElement('summary');
      summary.className = 'suas-panel-link';
      summary.innerHTML = '<span class="suas-panel-icon" style="--icon-bg: var(--violet);">?</span><span class="suas-panel-label">about us</span><span class="suas-panel-number">08</span>';

      details.appendChild(summary);
      details.appendChild(buildMenu(aboutItems));
      nav.appendChild(details);
    }

    addBookLabQuickLaunch();
    removeMobileQuickLaunchBodyHome();
    blockClosedBookingDates();
    window.addEventListener('resize', removeMobileQuickLaunchBodyHome);
    addSideAboutMenu();
    addHomePanelAboutMenu();

    document.addEventListener('toggle', function (event) {
      var opened = event.target;
      if (!opened.matches || !opened.matches('.suas-side-dropdown[open]')) return;

      document.querySelectorAll('.suas-side-dropdown[open]').forEach(function (dropdown) {
        if (dropdown !== opened) dropdown.removeAttribute('open');
      });
    }, true);
  });
</script>
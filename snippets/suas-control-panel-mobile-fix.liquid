</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var aboutItems = [
      { title: 'who are we', href: '/pages/about' },
      { title: 'bookings', href: '/pages/bookings' },
      { title: 'contact us', href: '/pages/contact' },
      { title: 'refund policy', href: '/policies/refund-policy' }
    ];
    var closedBookingDays = [0, 1, 2, 3];
    var closedBookingMessage = 'Bookings are closed Monday, Tuesday, Wednesday, and Sunday. Please choose Thursday, Friday, or Saturday.';

    function addBookLabQuickLaunch() {
      var grid = document.querySelector('.suas-world-home .suas-launch-grid');
      if (!grid || grid.querySelector('a[href="/pages/bookings"]')) return;

      var link = document.createElement('a');
      link.className = 'suas-launch';
      link.href = '/pages/bookings';
      link.style.setProperty('--launch', '#d9ff78');
      link.style.setProperty('--glow', '217,255,120');
      link.innerHTML = '<strong class="suas-font">book the lab</strong><span class="suas-mono">booking</span>';
      grid.appendChild(link);
    }

    function removeMobileQuickLaunchBodyHome() {
      var isMobileView = window.innerWidth <= 1023 || document.documentElement.clientWidth <= 1023;
      if (!isMobileView) return;

      document.querySelectorAll('.suas-world-home .suas-launch-grid > a[href="/collections/body-care"], .suas-world-home .suas-launch-grid > a[href="/collections/home-care"]').forEach(function (link) {
        link.remove();
      });
    }

    function isClosedBookingDate(value) {
      if (!value) return false;
      var parts = value.split('-').map(function (part) { return parseInt(part, 10); });
      if (parts.length !== 3 || parts.some(isNaN)) return false;
      return closedBookingDays.indexOf(new Date(parts[0], parts[1] - 1, parts[2]).getDay()) !== -1;
    }

    function showBookingDateError(input) {
      var field = input.closest('.suas-field') || input.parentElement;
      if (!field) return;

      var error = field.querySelector('.suas-booking-date-error');
      if (!error) {
        error = document.createElement('div');
        error.className = 'suas-booking-date-error';
        error.setAttribute('role', 'alert');
        input.insertAdjacentElement('afterend', error);
      }

      error.textContent = closedBookingMessage;
      error.classList.add('is-visible');
      window.clearTimeout(error._suasTimer);
      error._suasTimer = window.setTimeout(function () {
        error.classList.remove('is-visible');
      }, 6500);
    }

    function clearBookingDateError(input) {
      var field = input.closest('.suas-field') || input.parentElement;
      if (!field) return;
      var error = field.querySelector('.suas-booking-date-error');
      if (!error) return;
      error.classList.remove('is-visible');
    }

    function validateBookingDate(input, shouldClear) {
      if (!input || input.type !== 'date') return true;
      if (!isClosedBookingDate(input.value)) {
        input.setCustomValidity('');
        clearBookingDateError(input);
        return true;
      }

      input.setCustomValidity(closedBookingMessage);
      showBookingDateError(input);
      input.reportValidity();
      if (shouldClear) {
        window.setTimeout(function () {
          input.value = '';
          input.setCustomValidity('');
        }, 0);
      }
      return false;
    }

    function blockClosedBookingDates() {
      var page = document.querySelector('.suas-bookings-page');
      if (!page || page.dataset.closedDaysReady === 'true') return;
      page.dataset.closedDaysReady = 'true';

      page.querySelectorAll('input[type="date"]').forEach(function (input) {
        input.addEventListener('change', function () {
          validateBookingDate(input, true);
        });
      });

      page.querySelectorAll('form').forEach(function (form) {
        form.addEventListener('submit', function (event) {
          var datesAreOpen = true;
          form.querySelectorAll('input[type="date"]').forEach(function (input) {
            if (!validateBookingDate(input, false)) datesAreOpen = false;
          });
          if (!datesAreOpen) event.preventDefault();
        });
      });
    }

    function buildMenu(items) {
      var menu = document.createElement('div');
      menu.className = 'suas-panel-submenu';
      items.forEach(function (item) {
        var child = document.createElement('a');
        child.href = item.href;
        child.textContent = item.title;
        menu.appendChild(child);
      });
      return menu;
    }

    function addSideAboutMenu() {
      var nav = document.querySelector('.suas-side-nav');
      if (!nav || nav.querySelector('.suas-side-about-dropdown')) return;

      var details = document.createElement('details');
      details.className = 'suas-panel-dropdown suas-side-dropdown suas-side-about-dropdown';

      var summary = document.createElement('summary');
      summary.className = 'suas-side-link';
      summary.innerHTML = '<span class="suas-side-icon" style="--tint: var(--suas-lav);">?</span><span class="suas-side-label">about us</span><span class="suas-side-num">08</span>';

      details.appendChild(summary);
      details.appendChild(buildMenu(aboutItems));
      nav.appendChild(details);
    }

    function addHomePanelAboutMenu() {
      var nav = document.querySelector('.suas-panel-nav');
      if (!nav || nav.querySelector('.suas-panel-about-dropdown')) return;

      var details = document.createElement('details');
      details.className = 'suas-panel-dropdown suas-home-panel-dropdown suas-panel-about-dropdown';

      var summary = document.createElement('summary');
      summary.className = 'suas-panel-link';
      summary.innerHTML = '<span class="suas-panel-icon" style="--icon-bg: var(--violet);">?</span><span class="suas-panel-label">about us</span><span class="suas-panel-number">08</span>';

      details.appendChild(summary);
      details.appendChild(buildMenu(aboutItems));
      nav.appendChild(details);
    }

    addBookLabQuickLaunch();
    removeMobileQuickLaunchBodyHome();
    blockClosedBookingDates();
    window.addEventListener('resize', removeMobileQuickLaunchBodyHome);
    addSideAboutMenu();
    addHomePanelAboutMenu();

    document.addEventListener('toggle', function (event) {
      var opened = event.target;
      if (!opened.matches || !opened.matches('.suas-side-dropdown[open]')) return;

      document.querySelectorAll('.suas-side-dropdown[open]').forEach(function (dropdown) {
        if (dropdown !== opened) dropdown.removeAttribute('open');
      });
    }, true);
  });
</script>
<style>
  @media only screen and (max-width: 1023px) {
    body .suas-side-nav {
      align-items: flex-start !important;
      padding-bottom: 8px !important;
    }

    body .suas-side-dropdown {
      position: relative !important;
      flex: 0 0 auto !important;
      width: auto !important;
      max-width: none !important;
    }

    body .suas-side-dropdown > summary.suas-side-link {
      width: auto !important;
      min-width: 0 !important;
      max-width: none !important;
      display: inline-grid !important;
      grid-template-columns: 26px auto !important;
      gap: 7px !important;
      padding: 7px 11px 7px 8px !important;
      border-radius: 999px !important;
      white-space: nowrap !important;
    }

    body .suas-side-dropdown[open] > summary.suas-side-link {
      min-height: 40px !important;
      margin: 0 !important;
      color: #101010 !important;
      background: #ffd8e8 !important;
      box-shadow: 0 4px 0 rgba(16, 16, 16, 0.18) !important;
    }

    body .suas-side-dropdown[open] > summary .suas-side-icon {
      background: rgba(255, 255, 255, 0.55) !important;
    }

    body .suas-side-dropdown[open] .suas-panel-submenu {
      position: fixed !important;
      top: 112px !important;
      left: 10px !important;
      right: 10px !important;
      z-index: 95 !important;
      display: grid !important;
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: 8px !important;
      margin: 0 !important;
      padding: 10px !important;
      border: 1px solid rgba(16, 16, 16, 0.12) !important;
      border-radius: 20px !important;
      background: rgba(255, 255, 255, 0.97) !important;
      box-shadow: 0 18px 34px -22px rgba(16, 16, 16, 0.5) !important;
      backdrop-filter: blur(14px) !important;
    }

    body .suas-side-dropdown .suas-panel-submenu a {
      min-height: 38px !important;
      justify-content: center !important;
      text-align: center !important;
      white-space: normal !important;
      font-size: 0.9rem !important;
      line-height: 1.05 !important;
      padding: 8px 10px !important;
      background: linear-gradient(180deg, #fff 0%, #ffe4ef 140%) !important;
    }
  }

  @media only screen and (max-width: 390px) {
    body .suas-side-dropdown[open] .suas-panel-submenu {
      top: 108px !important;
      grid-template-columns: 1fr !important;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.addEventListener('toggle', function (event) {
      var opened = event.target;
      if (!opened.matches || !opened.matches('.suas-side-dropdown[open]')) return;

      document.querySelectorAll('.suas-side-dropdown[open]').forEach(function (dropdown) {
        if (dropdown !== opened) dropdown.removeAttribute('open');
      });
    }, true);
  });
</script>

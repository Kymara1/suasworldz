<script>
  document.addEventListener('DOMContentLoaded',function(){
    function cleanLabel(value){return String(value||'').toLowerCase().replace(/&amp;/g,'&').replace(/[^a-z0-9& ]+/g,' ').replace(/\b(menu|tab|category|categories|shop|launch)\b/g,'').replace(/\s+/g,' ').trim()}
    function quickKey(link){var strong=link.querySelector('strong');var raw=(strong?strong.textContent:link.textContent||'');return cleanLabel(raw)||((link.getAttribute('href')||'').replace(/\?.*$/,''))}
    function dedupeQuickLaunch(){document.querySelectorAll('.suas-world-home .suas-launch-grid').forEach(function(grid){var seen={};Array.prototype.slice.call(grid.querySelectorAll('a')).forEach(function(link){var key=quickKey(link);if(seen[key])link.remove();else seen[key]=true})})}
    function ensureQuickLaunch(label,href,color,action){var grid=document.querySelector('.suas-world-home .suas-launch-grid');if(!grid)return;dedupeQuickLaunch();var exists=Array.prototype.some.call(grid.querySelectorAll('a'),function(link){return quickKey(link)===cleanLabel(label)});if(exists)return;var link=document.createElement('a');link.className='suas-launch';link.href=href;link.style.setProperty('--launch',color);link.innerHTML='<strong class="suas-font">'+label+'</strong><span class="suas-mono">'+action+'</span>';grid.appendChild(link);dedupeQuickLaunch()}
    function addBookLabQuickLaunch(){ensureQuickLaunch('book the lab','/pages/bookings','#ff9bc4','reserve')}
    function addCharmBarQuickLaunch(){ensureQuickLaunch('the charm bar','/pages/charm-bar','#cdeeff','reserve')}
    function itemLabel(item){return cleanLabel((item.querySelector('.suas-side-label,.suas-panel-label')||item).textContent)}
    function pruneSubmenus(){document.querySelectorAll('.suas-side-dropdown,.suas-panel-dropdown').forEach(function(dropdown){var parent=itemLabel(dropdown);var submenu=dropdown.querySelector('.suas-panel-submenu');if(!submenu)return;var hasVisit=false;Array.prototype.slice.call(submenu.querySelectorAll('a')).forEach(function(link){var child=cleanLabel(link.textContent);if(child==='visit us'||child==='visit')hasVisit=true;if(child&&parent&&child===parent)link.remove()});if(parent==='about us'&&!hasVisit){var visit=document.createElement('a');visit.href='/pages/visit-us';visit.textContent='Visit Us';submenu.appendChild(visit)}})}
    function setMobilePanelItems(){var mobile=window.matchMedia('(max-width: 1023px)').matches;var keep={'body':true,'home':true,'about us':true,'the lab':true,'lab':true};document.querySelectorAll('.suas-side-nav>a.suas-side-link,.suas-side-nav>.suas-side-dropdown').forEach(function(item){var label=itemLabel(item);if(keep[label]||label.indexOf('lab')!==-1)item.setAttribute('data-suas-mobile-keep','true');else item.removeAttribute('data-suas-mobile-keep');if(mobile&&item.getAttribute('data-suas-mobile-keep')!=='true')item.setAttribute('data-suas-mobile-hidden','true');else item.removeAttribute('data-suas-mobile-hidden')})}
    function dedupeControlPanel(selector){document.querySelectorAll(selector).forEach(function(nav){var seen={};Array.prototype.slice.call(nav.children).forEach(function(item){var label=itemLabel(item);var href=(item.querySelector('a[href],summary')||item).getAttribute('href')||label;if(seen[label+'|'+href])item.remove();else seen[label+'|'+href]=true})})}
    function runFixes(){addBookLabQuickLaunch();addCharmBarQuickLaunch();dedupeControlPanel('.suas-side-nav');dedupeControlPanel('.suas-panel-nav');pruneSubmenus();setMobilePanelItems()}
    runFixes();window.addEventListener('resize',setMobilePanelItems);
    document.addEventListener('toggle',function(event){var opened=event.target;if(!opened.matches||!opened.matches('.suas-side-dropdown[open]'))return;document.querySelectorAll('.suas-side-dropdown[open]').forEach(function(dropdown){if(dropdown!==opened)dropdown.removeAttribute('open')})},true);
  });
</script>

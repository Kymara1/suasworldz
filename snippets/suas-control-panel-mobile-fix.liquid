<style>
  body .suas-world-home .suas-lab-teaser {
    grid-template-columns: 1fr !important;
  }

  body .suas-world-home .suas-hours {
    display: none !important;
  }

  body .suas-bookings-page .suas-time-grid .suas-slot input[type="radio"] {
    appearance: none !important;
    -webkit-appearance: none !important;
    width: 18px !important;
    height: 18px !important;
    flex: 0 0 18px !important;
    border: 2px solid #101010 !important;
    border-radius: 5px !important;
    background: #fff !important;
    box-shadow: inset 0 0 0 3px #fff !important;
  }

  body .suas-bookings-page .suas-time-grid .suas-slot input[type="radio"]:checked {
    background: #101010 !important;
  }

  body .suas-bookings-page .suas-time-grid .suas-slot:has(input:checked) {
    background: #fff !important;
    border-color: #101010 !important;
    box-shadow: 0 4px 0 rgba(16, 16, 16, 0.22) !important;
  }

  @media only screen and (max-width: 1023px) {
    body .suas-world-home .suas-launch-grid > a[href="/collections/body-care"],
    body .suas-world-home .suas-launch-grid > a[href="/collections/home-care"] {
      display: none !important;
    }

    body .suas-side-rail {
      overflow: visible !important;
      padding-bottom: 12px !important;
    }

    body .suas-side-nav {
      display: flex !important;
      flex-wrap: wrap !important;
      align-items: flex-start !important;
      gap: 8px !important;
      padding: 2px 0 6px !important;
      overflow-x: visible !important;
      overflow-y: visible !important;
    }

    body .suas-side-nav > a.suas-side-link {
      display: none !important;
    }

    body .suas-side-dropdown {
      position: relative !important;
      flex: 1 1 calc(33.333% - 6px) !important;
      width: auto !important;
      min-width: 96px !important;
      max-width: none !important;
    }

    body .suas-side-dropdown > summary.suas-side-link {
      width: 100% !important;
      min-width: 0 !important;
      max-width: none !important;
      display: grid !important;
      grid-template-columns: 24px minmax(0, 1fr) !important;
      gap: 7px !important;
      padding: 8px 9px !important;
      border-radius: 999px !important;
      white-space: nowrap !important;
    }

    body .suas-side-dropdown > summary .suas-side-label {
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      white-space: nowrap !important;
    }

    body .suas-side-dropdown[open] {
      flex: 1 0 100% !important;
      order: 99 !important;
      width: 100% !important;
      margin-top: 4px !important;
    }

    body .suas-side-dropdown[open] > summary.suas-side-link {
      width: fit-content !important;
      min-width: 112px !important;
      min-height: 42px !important;
      margin: 0 auto 10px !important;
      color: #101010 !important;
      background: #ffd8e8 !important;
      box-shadow: 0 4px 0 rgba(16, 16, 16, 0.18) !important;
    }

    body .suas-side-dropdown[open] > summary .suas-side-icon {
      background: rgba(255, 255, 255, 0.62) !important;
    }

    body .suas-side-dropdown[open] .suas-panel-submenu {
      position: static !important;
      z-index: auto !important;
      display: grid !important;
      grid-template-columns: 1fr !important;
      gap: 9px !important;
      width: 100% !important;
      max-height: 48vh !important;
      overflow-y: auto !important;
      margin: 0 !important;
      padding: 12px !important;
      border: 1px solid rgba(16, 16, 16, 0.14) !important;
      border-radius: 22px !important;
      background: rgba(255, 255, 255, 0.98) !important;
      box-shadow: 0 16px 30px -22px rgba(16, 16, 16, 0.5) !important;
      backdrop-filter: blur(16px) !important;
      -webkit-overflow-scrolling: touch !important;
    }

    body .suas-side-dropdown .suas-panel-submenu a {
      min-height: 44px !important;
      justify-content: center !important;
      text-align: center !important;
      white-space: normal !important;
      font-size: 1.05rem !important;
      line-height: 1.05 !important;
      padding: 10px 14px !important;
      border: 1px solid rgba(16, 16, 16, 0.1) !important;
      background: linear-gradient(180deg, #fff 0%, #ffe4ef 145%) !important;
      box-shadow: 0 4px 0 rgba(16, 16, 16, 0.1) !important;
    }
  }

  @media only screen and (max-width: 390px) {
    body .suas-side-dropdown {
      min-width: 90px !important;
    }

    body .suas-side-dropdown[open] .suas-panel-submenu {
      max-height: 44vh !important;
      padding: 10px !important;
    }

    body .suas-side-dropdown .suas-panel-submenu a {
      min-height: 42px !important;
      font-size: 0.96rem !important;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var aboutItems = [
      { title: 'who are we', href: '/pages/about' },
      { title: 'bookings', href: '/pages/bookings' },
      { title: 'contact us', href: '/pages/contact' },
      { title: 'refund policy', href: '/policies/refund-policy' }
    ];

    function addBookLabQuickLaunch() {
      var grid = document.querySelector('.suas-world-home .suas-launch-grid');
      if (!grid || grid.querySelector('a[href="/pages/bookings"]')) return;

      var link = document.createElement('a');
      link.className = 'suas-launch';
      link.href = '/pages/bookings';
      link.style.setProperty('--launch', '#d9ff78');
      link.style.setProperty('--glow', '217,255,120');
      link.innerHTML = '<strong class="suas-font">book the lab</strong><span class="suas-mono">booking</span>';
      grid.appendChild(link);
    }

    function removeMobileQuickLaunchBodyHome() {
      var isMobileView = window.innerWidth <= 1023 || document.documentElement.clientWidth <= 1023;
      if (!isMobileView) return;

      document.querySelectorAll('.suas-world-home .suas-launch-grid > a[href="/collections/body-care"], .suas-world-home .suas-launch-grid > a[href="/collections/home-care"]').forEach(function (link) {
        link.remove();
      });
    }

    function buildMenu(items) {
      var menu = document.createElement('div');
      menu.className = 'suas-panel-submenu';
      items.forEach(function (item) {
        var child = document.createElement('a');
        child.href = item.href;
        child.textContent = item.title;
        menu.appendChild(child);
      });
      return menu;
    }

    function addSideAboutMenu() {
      var nav = document.querySelector('.suas-side-nav');
      if (!nav || nav.querySelector('.suas-side-about-dropdown')) return;

      var details = document.createElement('details');
      details.className = 'suas-panel-dropdown suas-side-dropdown suas-side-about-dropdown';

      var summary = document.createElement('summary');
      summary.className = 'suas-side-link';
      summary.innerHTML = '<span class="suas-side-icon" style="--tint: var(--suas-lav);">?</span><span class="suas-side-label">about us</span><span class="suas-side-num">08</span>';

      details.appendChild(summary);
      details.appendChild(buildMenu(aboutItems));
      nav.appendChild(details);
    }

    function addHomePanelAboutMenu() {
      var nav = document.querySelector('.suas-panel-nav');
      if (!nav || nav.querySelector('.suas-panel-about-dropdown')) return;

      var details = document.createElement('details');
      details.className = 'suas-panel-dropdown suas-home-panel-dropdown suas-panel-about-dropdown';

      var summary = document.createElement('summary');
      summary.className = 'suas-panel-link';
      summary.innerHTML = '<span class="suas-panel-icon" style="--icon-bg: var(--violet);">?</span><span class="suas-panel-label">about us</span><span class="suas-panel-number">08</span>';

      details.appendChild(summary);
      details.appendChild(buildMenu(aboutItems));
      nav.appendChild(details);
    }

    addBookLabQuickLaunch();
    removeMobileQuickLaunchBodyHome();
    window.addEventListener('resize', removeMobileQuickLaunchBodyHome);
    addSideAboutMenu();
    addHomePanelAboutMenu();

    document.addEventListener('toggle', function (event) {
      var opened = event.target;
      if (!opened.matches || !opened.matches('.suas-side-dropdown[open]')) return;

      document.querySelectorAll('.suas-side-dropdown[open]').forEach(function (dropdown) {
        if (dropdown !== opened) dropdown.removeAttribute('open');
      });
    }, true);
  });
</script>
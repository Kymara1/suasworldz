<style>
  @media only screen and (max-width: 1023px) {
    body .suas-side-rail {
      overflow: visible !important;
      padding-bottom: 12px !important;
    }

    body .suas-side-nav {
      display: flex !important;
      flex-wrap: wrap !important;
      align-items: flex-start !important;
      gap: 8px !important;
      padding: 2px 0 6px !important;
      overflow-x: visible !important;
      overflow-y: visible !important;
    }

    body .suas-side-dropdown {
      position: relative !important;
      flex: 0 0 auto !important;
      width: auto !important;
      max-width: none !important;
    }

    body .suas-side-dropdown > summary.suas-side-link {
      width: auto !important;
      min-width: 112px !important;
      max-width: none !important;
      display: inline-grid !important;
      grid-template-columns: 26px auto !important;
      gap: 8px !important;
      padding: 8px 14px 8px 9px !important;
      border-radius: 999px !important;
      white-space: nowrap !important;
    }

    body .suas-side-dropdown[open] {
      flex: 1 0 100% !important;
      order: 99 !important;
      width: 100% !important;
      margin-top: 4px !important;
    }

    body .suas-side-dropdown[open] > summary.suas-side-link {
      width: auto !important;
      min-height: 42px !important;
      margin: 0 auto 10px !important;
      color: #101010 !important;
      background: #ffd8e8 !important;
      box-shadow: 0 4px 0 rgba(16, 16, 16, 0.18) !important;
    }

    body .suas-side-dropdown[open] > summary .suas-side-icon {
      background: rgba(255, 255, 255, 0.62) !important;
    }

    body .suas-side-dropdown[open] .suas-panel-submenu {
      position: static !important;
      z-index: auto !important;
      display: grid !important;
      grid-template-columns: 1fr !important;
      gap: 9px !important;
      width: 100% !important;
      max-height: 48vh !important;
      overflow-y: auto !important;
      margin: 0 !important;
      padding: 12px !important;
      border: 1px solid rgba(16, 16, 16, 0.14) !important;
      border-radius: 22px !important;
      background: rgba(255, 255, 255, 0.98) !important;
      box-shadow: 0 16px 30px -22px rgba(16, 16, 16, 0.5) !important;
      backdrop-filter: blur(16px) !important;
      -webkit-overflow-scrolling: touch !important;
    }

    body .suas-side-dropdown .suas-panel-submenu a {
      min-height: 44px !important;
      justify-content: center !important;
      text-align: center !important;
      white-space: normal !important;
      font-size: 1.05rem !important;
      line-height: 1.05 !important;
      padding: 10px 14px !important;
      border: 1px solid rgba(16, 16, 16, 0.1) !important;
      background: linear-gradient(180deg, #fff 0%, #ffe4ef 145%) !important;
      box-shadow: 0 4px 0 rgba(16, 16, 16, 0.1) !important;
    }
  }

  @media only screen and (max-width: 390px) {
    body .suas-side-dropdown[open] .suas-panel-submenu {
      max-height: 44vh !important;
      padding: 10px !important;
    }

    body .suas-side-dropdown .suas-panel-submenu a {
      min-height: 42px !important;
      font-size: 0.96rem !important;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.addEventListener('toggle', function (event) {
      var opened = event.target;
      if (!opened.matches || !opened.matches('.suas-side-dropdown[open]')) return;

      document.querySelectorAll('.suas-side-dropdown[open]').forEach(function (dropdown) {
        if (dropdown !== opened) dropdown.removeAttribute('open');
      });
    }, true);
  });
</script>

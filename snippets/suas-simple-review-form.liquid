{%- liquid
  assign scent = product.title | split: '✿' | first | strip
  assign has_legacy = false
  if product.metafields.judgeme.widget.size > 20
    assign has_legacy = true
  endif
-%}
<div class="suas-simple-review" id="suas-simple-review">
  <style>
    .suas-simple-review{margin:0 18px 18px;padding:18px;border:2px solid #101010;border-radius:22px;background:#fff;box-shadow:4px 5px 0 #101010}
    .suas-simple-review h3{margin:0 0 6px;font-family:'Casual Human',Futura,Arial,sans-serif;font-size:clamp(1.7rem,4vw,2.4rem);line-height:.88;font-weight:400;text-transform:lowercase}
    .suas-simple-review > p{margin:0 0 14px;font-size:13px;font-weight:800;line-height:1.35}
    html body.template--product .suas-review-shell-window{overflow:visible!important}
    .suas-simple-review .jdgm-widget{margin:0!important;padding:0!important;border:0!important;background:transparent!important}
    .suas-simple-review .jdgm-rev-widg{border:0!important;margin:0!important;padding:0!important;background:transparent!important;color:#101010!important}
    .suas-simple-review .jdgm-rev-widg__title{display:none!important}
    .suas-simple-review .jdgm-rev,
    .suas-simple-review .jdgm-form-wrapper,
    .suas-simple-review .jdgm-rev-widg__summary{border:2px solid #101010!important;border-radius:18px!important;background:#fff1a8!important;box-shadow:3px 4px 0 #101010!important;color:#101010!important;padding:14px!important}
    .suas-simple-review .jdgm-rev-widg__summary{background:#d9ff78!important}
    .suas-simple-review :is(.jdgm-star,.jdgm-star:before){color:#101010!important}
    .suas-simple-review :is(.jdgm-write-rev-link,.jdgm-btn,button.jdgm-btn,input[type='submit'].jdgm-btn){min-height:42px!important;border:2px solid #101010!important;border-radius:999px!important;background:#ffd8e8!important;color:#101010!important;box-shadow:0 4px 0 #101010!important;font:900 10px/1 Futura,Arial,sans-serif!important;letter-spacing:.12em!important;text-transform:uppercase!important;text-decoration:none!important}
    .suas-simple-review :is(input,textarea,select){border:1.5px solid #101010!important;border-radius:14px!important;background:#fff!important;color:#101010!important;font:800 14px/1.3 Futura,Arial,sans-serif!important}
    .suas-simple-review .jdgm-rev__author,
    .suas-simple-review .jdgm-rev__title{font-weight:900!important;letter-spacing:.06em!important;text-transform:uppercase!important;color:#101010!important}
    #aftership_reviews_carousel_v2_production,
    #aftership_reviews_all_reviews_widget_production{display:none!important}
    @media(max-width:700px){.suas-simple-review{margin:0 14px 14px}}
  </style>
  <h3>leave a review.</h3>
  <p>Write how {{ scent }} smelled on you. This goes to Judge.me, then shows on this product and the all-reviews page once it is published.</p>
  <div data-suas-judgeme-mount>
    <div style="clear:both"></div>
    <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-product-title="{{ product.title | escape }}" data-id="{{ product.id }}" data-product-id="{{ product.id }}" data-widget="review" data-auto-install="false" data-shop-reviews-count="{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}" data-entry-point="review_widget.js" data-entry-key="review-widget/main.js">
      {% if has_legacy %}
        <div class="jdgm-legacy-widget-content" style="display:none;">{{ product.metafields.judgeme.widget }}</div>
      {% endif %}
    </div>
    {% if product.metafields.judgeme.review_widget_data %}
      <script>window.jdgm=window.jdgm||{};jdgm.data=jdgm.data||{};jdgm.data.reviewWidget=jdgm.data.reviewWidget||{};jdgm.data.reviewWidget[{{ product.id }}]={{ product.metafields.judgeme.review_widget_data }}</script>
    {% endif %}
  </div>
  <script>
    (function () {
      var root = document.currentScript.closest('.suas-simple-review');
      if (!root || root.dataset.suasJudgeReady === 'true') return;
      root.dataset.suasJudgeReady = 'true';
      if (location.search.indexOf('showWriteReviews') === -1) return;
      var tries = 0;
      var timer = setInterval(function () {
        var btn = root.querySelector('.jdgm-write-rev-link');
        if (btn) {
          btn.click();
          clearInterval(timer);
        } else if (++tries > 20) {
          clearInterval(timer);
        }
      }, 400);
    })();
  </script>
</div>

{%- liquid
  assign has_legacy = false
  if product.metafields.judgeme.widget.size > 20
    assign has_legacy = true
  endif
-%}
<div class="suas-simple-review" id="suas-simple-review">
  <style>
    html body.template--product .suas-product-review-shell{width:min(640px,calc(100vw - 24px))!important;max-width:640px!important;margin:16px auto 20px!important}
    html body.template--product .suas-review-shell-window{border-radius:16px!important;box-shadow:3px 4px 0 #101010!important;overflow:visible!important}
    html body.template--product .suas-smell-winbar{min-height:28px!important;padding:4px 10px!important}
    html body.template--product .suas-review-intro{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:8px!important;padding:8px 10px 0!important}
    html body.template--product .suas-review-intro h2{margin:0!important;font-size:1.35rem!important;line-height:1!important}
    html body.template--product .suas-review-intro p,
    html body.template--product .suas-review-empty{display:none!important}
    html body.template--product .suas-review-action{display:inline-flex!important;align-items:center;justify-content:center;min-height:36px;padding:0 14px;border:2px solid #101010;border-radius:999px;background:#ffd8e8;color:#101010;box-shadow:0 3px 0 #101010;font:900 9px/1 Futura,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase;cursor:pointer}
    html body.template--product .suas-review-intro [data-suas-minimize-review]{display:none!important;background:#d9ff78!important}
    html body.template--product .suas-product-review-shell:has(.suas-simple-review.is-writing) .suas-review-intro [data-suas-write-review]{display:none!important}
    html body.template--product .suas-product-review-shell:has(.suas-simple-review.is-writing) .suas-review-intro [data-suas-minimize-review]{display:inline-flex!important}
    .suas-review-form-bar{display:none;justify-content:flex-end;margin:0 0 6px}
    .suas-simple-review.is-writing .suas-review-form-bar{display:flex}
    .suas-review-form-bar .suas-review-minimize{display:inline-flex;align-items:center;justify-content:center;min-height:28px;padding:0 12px;border:2px solid #101010;border-radius:999px;background:#d9ff78;color:#101010;box-shadow:0 2px 0 #101010;font:900 8px/1 Futura,Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase;cursor:pointer}
    html body.template--product .suas-review-app-stage{padding:0 10px 10px!important;min-height:0!important}
    html body.template--product .suas-review-app-stage .shopify-app-block{min-height:0!important;padding:0!important;border:0!important;box-shadow:none!important;background:transparent!important}
    .suas-simple-review{margin:6px 10px 10px;padding:0;border:0;background:transparent;box-shadow:none}
    .suas-simple-review .jdgm-widget,.suas-simple-review .jdgm-rev-widg{margin:0!important;padding:0!important;border:0!important;background:transparent!important;color:#101010!important}
    .suas-simple-review :is(.jdgm-rev-widg__title,.jdgm-form-wrapper h2,.jdgm-form__title,.jdgm-histogram,.jdgm-histogram-wrapper,.jdgm-rev-widg__summary,.jdgm-write-rev-link,.jdgm-cancel-rev,.jdgm-sort-dropdown,.jdgm-form__terms,.jdgm-notification,.jdgm-powered,.jdgm-branding){display:none!important}
    .suas-simple-review .jdgm-rev-widg__header{display:block!important}
    .suas-simple-review .jdgm-rev-widg__header > :not(.jdgm-form-wrapper):not(form):not(.jdgm-form){display:none!important}
    .suas-simple-review :is([class*='picture'],[class*='Picture'],[class*='media-upload'],[class*='media-uploader'],[class*='video-upload'],.jdgm-tooltip){display:none!important}
    .suas-simple-review :is(.jdgm-rev-widg__reviews,.jdgm-rev,.jdgm-rev-widg__body){display:block!important;visibility:visible!important;max-height:none!important;overflow:visible!important}
    .suas-simple-review .jdgm-legacy-widget-content{display:block!important}
    .suas-simple-review iframe[src*='judge.me'],.suas-simple-review iframe[id*='jdgm'],.suas-simple-review iframe[class*='jdgm']{display:block!important;width:100%!important;max-height:52vh!important}
    .suas-simple-review input[name*='title' i],
    .suas-simple-review [class*='review-title'],
    .suas-simple-review [class*='review_title']{display:none!important}
    .suas-simple-review .jdgm-rev{margin:0 0 8px!important;padding:8px!important;border:2px solid #101010!important;border-radius:12px!important;background:#fff1a8!important;box-shadow:2px 3px 0 #101010!important}
    .suas-simple-review .jdgm-form-wrapper,
    .suas-simple-review form.jdgm-form,
    .suas-simple-review .jdgm-form{display:none!important;margin:0!important;padding:8px!important;border:2px solid #101010!important;border-radius:12px!important;background:#fff1a8!important;box-shadow:2px 3px 0 #101010!important;gap:6px!important}
    .suas-simple-review.is-writing .jdgm-form-wrapper,
    .suas-simple-review.is-writing form.jdgm-form,
    .suas-simple-review.is-writing .jdgm-form{display:grid!important}
    .suas-simple-review .jdgm-form-wrapper > *{margin:0!important}
    .suas-simple-review :is(.jdgm-btn,button.jdgm-btn,input[type='submit'].jdgm-btn){min-height:34px!important;padding:0 12px!important;border:2px solid #101010!important;border-radius:999px!important;background:#ffd8e8!important;color:#101010!important;box-shadow:0 3px 0 #101010!important;font:900 9px/1 Futura,Arial,sans-serif!important;letter-spacing:.1em!important;text-transform:uppercase!important}
    .suas-simple-review textarea{min-height:52px!important;max-height:64px!important;height:52px!important}
    .suas-simple-review :is(input,textarea,select){min-height:36px!important;border:1.5px solid #101010!important;border-radius:10px!important;background:#fff!important;color:#101010!important;font:800 13px/1.25 Futura,Arial,sans-serif!important}
    .suas-simple-review :is(label,legend,.jdgm-form-label,.jdgm-form__label){font:900 8px/1.2 Futura,Arial,sans-serif!important;letter-spacing:.1em!important;text-transform:uppercase!important;margin:0 0 3px!important}
    .suas-simple-review :is(.jdgm-star,.jdgm-star:before){color:#101010!important;font-size:18px!important}
    .suas-simple-review :is(.jdgm-powered,.jdgm-branding,a[href*='://judge.me'],a[href*='judgeme.com']){display:none!important}
    html body.template--product :is(#aftership_reviews_carousel_v2_production,#aftership_reviews_all_reviews_widget_production){display:none!important}
    @media(max-width:749px){
      html body.template--product .suas-product-review-shell{width:min(430px,calc(100vw - 14px))!important;margin:10px auto 16px!important}
      html body.template--product .suas-review-intro{flex-wrap:nowrap!important}
      html body.template--product .suas-review-action{width:auto!important;min-height:34px!important;flex:0 0 auto}
      .suas-simple-review{margin:4px 8px 8px}
      .suas-simple-review .jdgm-rev{padding:6px 8px!important;margin:0 0 6px!important;font-size:13px!important}
      .suas-simple-review .jdgm-rev__body,.suas-simple-review .jdgm-rev p{font-size:13px!important;line-height:1.35!important;margin:0!important}
      .suas-simple-review :is(.jdgm-btn,input[type='submit'].jdgm-btn){width:100%!important}
      .suas-simple-review textarea{min-height:44px!important;max-height:52px!important;height:44px!important}
    }
  </style>
  <div class="suas-review-form-bar">
    <button class="suas-review-minimize" type="button" data-suas-minimize-review>minimize</button>
  </div>
  <div data-suas-judgeme-mount>
    <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-product-title="{{ product.title | escape }}" data-id="{{ product.id }}" data-product-id="{{ product.id }}" data-widget="review" data-auto-install="false" data-shop-reviews-count="{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}" data-entry-point="review_widget.js" data-entry-key="review-widget/main.js">
      {% if has_legacy %}
        <div class="jdgm-legacy-widget-content" style="display:none;">{{ product.metafields.judgeme.widget }}</div>
      {% endif %}
    </div>
    {% if product.metafields.judgeme.review_widget_data %}
      <script>window.jdgm=window.jdgm||{};jdgm.data=jdgm.data||{};jdgm.data.reviewWidget=jdgm.data.reviewWidget||{};jdgm.data.reviewWidget[{{ product.id }}]={{ product.metafields.judgeme.review_widget_data }}</script>
    {% endif %}
  </div>
  <script>
    (function () {
      var root = document.currentScript.closest('.suas-simple-review');
      if (!root || root.dataset.suasJudgeReady === 'true') return;
      root.dataset.suasJudgeReady = 'true';

      function formNodes() {
        return root.querySelectorAll('.jdgm-form-wrapper, form.jdgm-form, .jdgm-form, .jdgm-rev-widg form, #judgeme_product_reviews form');
      }

      function revealForms() {
        var found = false;
        formNodes().forEach(function (form) {
          form.hidden = false;
          form.removeAttribute('hidden');
          form.classList.remove('jdgm-hidden');
          form.style.setProperty('display', 'grid', 'important');
          found = true;
        });
        return found;
      }

      function openForm() {
        root.classList.add('is-writing');
        var jq = window.jdgm && (window.jdgm.jQuery || window.jdgm.$);
        var widget = document.querySelector('.jdgm-review-widget .jdgm-rev-widg, .jdgm-rev-widg');
        try {
          if (jq && typeof window.jdgm.openForm === 'function') {
            window.jdgm.openForm(jq(widget || '.jdgm-rev-widg'));
          }
        } catch (err) {}
        var btn = document.querySelector('.jdgm-write-rev-link');
        if (btn) {
          try {
            if (jq) jq(btn).trigger('click');
            else btn.click();
          } catch (err) {}
        }
        var shown = revealForms();
        if (shown) {
          var form = formNodes()[0];
          if (form) form.scrollIntoView({ behavior: 'smooth', block: 'center' });
          var field = root.querySelector('.jdgm-form-wrapper textarea, form.jdgm-form textarea, .jdgm-form textarea');
          if (field) {
            try { field.focus(); } catch (err) {}
          }
        }
        return shown;
      }

      function closeForm() {
        root.classList.remove('is-writing');
        formNodes().forEach(function (form) {
          form.style.setProperty('display', 'none', 'important');
        });
        var jq = window.jdgm && (window.jdgm.jQuery || window.jdgm.$);
        try {
          if (jq && typeof window.jdgm.closeForm === 'function') {
            window.jdgm.closeForm(jq('.jdgm-rev-widg'));
          }
        } catch (err) {}
      }

      function compactForm() {
        if (!root.classList.contains('is-writing')) return;
        root.querySelectorAll('[class*="picture"],[class*="Picture"],[class*="upload"],[class*="media-uploader"]').forEach(function (el) {
          el.style.setProperty('display', 'none', 'important');
        });
        root.querySelectorAll('span,small,em,p,label,div,li').forEach(function (el) {
          if (el.closest('.jdgm-rev')) return;
          if (el.querySelector('input,textarea,button,select,.jdgm-rev')) return;
          var t = String(el.textContent || '').replace(/\s+/g, ' ').trim().toLowerCase();
          if (!t || t.length > 900) return;
          if (/displayed publicly|john smith|picture|video \(optional\)|uses (your )?data|how we use|collect(s)? (and process|your)|personal data|privacy policy|gdpr|legitimate interest|judge\.me uses/.test(t)) {
            el.style.setProperty('display', 'none', 'important');
          }
        });
        var title = root.querySelector('input[name*="title" i], input[id*="title" i], input[placeholder*="title" i]');
        if (title) {
          if (!title.value) title.value = 'Review';
          title.style.setProperty('display', 'none', 'important');
          var lab = title.closest('label');
          if (lab) lab.style.setProperty('display', 'none', 'important');
        }
      }

      function scrub() {
        compactForm();
        document.querySelectorAll('.suas-product-review-shell p, .suas-review-app-stage p, .suas-simple-review p').forEach(function (el) {
          if (el.closest('.jdgm-rev')) return;
          if (el.querySelector('input,textarea,button,.jdgm-rev')) return;
          var t = String(el.textContent || '').replace(/\s+/g, ' ').trim();
          if (/judge\.?\s*me/i.test(t) && /data|privacy|collect|gdpr|logging into/i.test(t)) {
            el.style.setProperty('display', 'none', 'important');
          }
        });
      }

      scrub();
      var n = 0;
      var t = setInterval(function () { scrub(); if (++n > 40) clearInterval(t); }, 400);
      document.addEventListener('click', function (event) {
        var closer = event.target.closest('[data-suas-minimize-review]');
        if (closer) {
          event.preventDefault();
          event.stopPropagation();
          closeForm();
          return;
        }
        var writer = event.target.closest('[data-suas-write-review], a.suas-product-stars, a[href*="showWriteReviews"]');
        if (!writer) return;
        if (writer.matches('[data-suas-minimize-review]')) return;
        event.preventDefault();
        event.stopPropagation();
        var tries = 0;
        openForm();
        var open = setInterval(function () {
          if (openForm() || ++tries > 24) clearInterval(open);
        }, 200);
      }, true);
      if (location.search.indexOf('showWriteReviews') !== -1) {
        var tries = 0;
        var open = setInterval(function () {
          if (openForm() || ++tries > 24) clearInterval(open);
        }, 300);
      }
    })();
  </script>
</div>

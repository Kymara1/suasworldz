{%- liquid
  assign reviews = product.metafields.reviews
  assign rating_count = reviews.rating_count | default: 0 | plus: 0
  assign rating_value = 0
  assign rating_max = 5
  if reviews.rating.value != blank
    assign rating_integer = reviews.rating.value.rating | floor
    assign rating_decimal = reviews.rating.value.rating | modulo: 1 | round: 2
    assign rating_max = reviews.rating.value.scale_max | default: 5
    assign rating_value = rating_integer | plus: rating_decimal
  endif
  assign product_rating_t = 'products.star_reviews_info' | t: rating_value: rating_value, rating_max: rating_max
  assign star_href = product.url | append: '?showWriteReviews=true#suas-simple-review'
-%}
{%- if star_link -%}
<a class="suas-product-stars" href="{{ star_href }}" aria-label="{{ product_rating_t }}. Write a review">
{%- else -%}
<div class="suas-product-stars" aria-label="{{ product_rating_t }}">
{%- endif -%}
  <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}" data-auto-install="false">{{ product.metafields.judgeme.badge }}</div>
  <span class="suas-product-stars--fallback" aria-hidden="true">
    <span class="suas-star-row">☆☆☆☆☆</span>
    <span class="suas-star-count">write a review</span>
  </span>
{%- if star_link -%}
</a>
{%- else -%}
</div>
{%- endif -%}

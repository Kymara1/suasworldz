{%- liquid
  assign reviews = product.metafields.reviews
  assign rating_count = reviews.rating_count | default: 0 | plus: 0
  assign rating_value = 0
  assign rating_max = 5

  if reviews.rating.value != blank
    assign rating_integer = reviews.rating.value.rating | floor
    assign rating_decimal = reviews.rating.value.rating | modulo: 1 | round: 2
    assign rating_max = reviews.rating.value.scale_max | default: 5
    assign rating_value = rating_integer | plus: rating_decimal
  else
    assign rating_integer = 0
    assign rating_decimal = 0
  endif

  assign product_rating_t = 'products.star_reviews_info' | t: rating_value: rating_value, rating_max: rating_max
  assign total_reviews_t = 'products.total_reviews' | t
-%}

<style>
  .suas-product-stars{display:inline-flex;align-items:center;gap:6px;margin:.35rem 0 .15rem;color:#101010;font-family:Futura,'Futura PT',Arial,sans-serif;font-size:12px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}
  .suas-product-stars .jdgm-widget{display:inline-flex!important;align-items:center!important;gap:5px!important;min-height:18px!important}
  .suas-product-stars .jdgm-prev-badge{display:inline-flex!important;align-items:center!important;gap:5px!important}
  .suas-product-stars .jdgm-star,.suas-product-stars .jdgm-star:before{color:#101010!important;font-size:13px!important;letter-spacing:1px!important}
  .suas-product-stars .jdgm-prev-badge__text{color:#101010!important;font-size:9px!important;font-weight:900!important;letter-spacing:.08em!important;text-transform:uppercase!important}
  .suas-product-stars--fallback{display:inline-flex;align-items:center;gap:5px;line-height:1}
  .suas-product-stars--fallback .suas-star-row{font-size:13px;letter-spacing:1px}
  .suas-product-stars--fallback .suas-star-count{font-size:9px;color:#555}
</style>

<div class="suas-product-stars" aria-label="{{ product_rating_t }}">
  {%- if product.metafields.judgeme.badge != blank -%}
    <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}">
      {{ product.metafields.judgeme.badge }}
    </div>
  {%- elsif reviews.rating.value != blank and rating_count > 0 -%}
    <div
      class="product-rating--root"
      role="img"
      aria-label="{{ product_rating_t }}"
      style="--rating: {{ rating_integer }}; --rating-max: {{ rating_max }}; --rating-decimal: {{ rating_decimal }};"
    >
      <div class="product-rating--stars"></div>
      <span class="product-rating--count" data-item="accent-text" aria-label="{{ total_reviews_t }}">
        {{- rating_count -}}
      </span>
    </div>
  {%- else -%}
    <span class="suas-product-stars--fallback" role="img" aria-label="No reviews yet">
      <span class="suas-star-row" aria-hidden="true">☆☆☆☆☆</span>
      <span class="suas-star-count">review me</span>
    </span>
  {%- endif -%}
</div>
